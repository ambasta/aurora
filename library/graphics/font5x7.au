export module graphics.font5x7;

// Project-authored base 5x7 glyphs: A-Z, 0-9, space, colon and hyphen.
// Other bytes retain the status-page fallback; graphical consumers may extend it.
// Least-significant bit is upper left: bit (row * 5 + column).
// Binary groups run bottom-to-top, each right-to-left.
export namespace graphics {
    auto glyph_bits(u8 byte) -> u64 {
        if (byte == 'A') {
            return 0b10001'10001'10001'11111'10001'10001'01110u64;
        }
        if (byte == 'B') {
            return 0b01111'10001'10001'01111'10001'10001'01111u64;
        }
        if (byte == 'C') {
            return 0b11110'00001'00001'00001'00001'00001'11110u64;
        }
        if (byte == 'D') {
            return 0b01111'10001'10001'10001'10001'10001'01111u64;
        }
        if (byte == 'E') {
            return 0b11111'00001'00001'01111'00001'00001'11111u64;
        }
        if (byte == 'F') {
            return 0b00001'00001'00001'01111'00001'00001'11111u64;
        }
        if (byte == 'G') {
            return 0b11110'10001'10001'11101'00001'00001'11110u64;
        }
        if (byte == 'H') {
            return 0b10001'10001'10001'11111'10001'10001'10001u64;
        }
        if (byte == 'I') {
            return 0b11111'00100'00100'00100'00100'00100'11111u64;
        }
        if (byte == 'J') {
            return 0b00110'01001'01001'01000'01000'01000'11100u64;
        }
        if (byte == 'K') {
            return 0b10001'01001'00101'00011'00101'01001'10001u64;
        }
        if (byte == 'L') {
            return 0b11111'00001'00001'00001'00001'00001'00001u64;
        }
        if (byte == 'M') {
            return 0b10001'10001'10001'10101'10101'11011'10001u64;
        }
        if (byte == 'N') {
            return 0b10001'11001'11001'10101'10011'10011'10001u64;
        }
        if (byte == 'O') {
            return 0b01110'10001'10001'10001'10001'10001'01110u64;
        }
        if (byte == 'P') {
            return 0b00001'00001'00001'01111'10001'10001'01111u64;
        }
        if (byte == 'Q') {
            return 0b10110'01001'10101'10001'10001'10001'01110u64;
        }
        if (byte == 'R') {
            return 0b10001'01001'00101'01111'10001'10001'01111u64;
        }
        if (byte == 'S') {
            return 0b01111'10000'10000'01110'00001'00001'11110u64;
        }
        if (byte == 'T') {
            return 0b00100'00100'00100'00100'00100'00100'11111u64;
        }
        if (byte == 'U') {
            return 0b01110'10001'10001'10001'10001'10001'10001u64;
        }
        if (byte == 'V') {
            return 0b00100'01010'10001'10001'10001'10001'10001u64;
        }
        if (byte == 'W') {
            return 0b10001'11011'10101'10101'10001'10001'10001u64;
        }
        if (byte == 'X') {
            return 0b10001'10001'01010'00100'01010'10001'10001u64;
        }
        if (byte == 'Y') {
            return 0b00100'00100'00100'00100'01010'10001'10001u64;
        }
        if (byte == 'Z') {
            return 0b11111'00001'00010'00100'01000'10000'11111u64;
        }
        if (byte == '0') {
            return 0b01110'10001'10011'10101'11001'10001'01110u64;
        }
        if (byte == '1') {
            return 0b01110'00100'00100'00100'00100'00110'00100u64;
        }
        if (byte == '2') {
            return 0b11111'00010'00100'01000'10000'10001'01110u64;
        }
        if (byte == '3') {
            return 0b01111'10000'10000'01110'10000'10000'01111u64;
        }
        if (byte == '4') {
            return 0b01000'01000'11111'01001'01010'01100'01000u64;
        }
        if (byte == '5') {
            return 0b01111'10000'10000'01111'00001'00001'11111u64;
        }
        if (byte == '6') {
            return 0b01110'10001'10001'01111'00001'00001'01110u64;
        }
        if (byte == '7') {
            return 0b00010'00010'00010'00100'01000'10000'11111u64;
        }
        if (byte == '8') {
            return 0b01110'10001'10001'01110'10001'10001'01110u64;
        }
        if (byte == '9') {
            return 0b01110'10000'10000'11110'10001'10001'01110u64;
        }
        if (byte == ' ') {
            return 0b00000'00000'00000'00000'00000'00000'00000u64;
        }
        if (byte == ':') {
            return 0b00000'00100'00100'00000'00100'00100'00000u64;
        }
        if (byte == '-') {
            return 0b00000'00000'00000'11111'00000'00000'00000u64;
        }
        return 0b11111'01011'10001'00001'00001'00001'11111u64;
    }
}
