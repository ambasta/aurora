export module console.scratchpad_parse;
import console.line;
import console.scratchpad;

export namespace console {
    // Only a completed, undamaged editor line can yield a valid command. The
    // invalid local sentinel never crosses the copied input boundary.
    auto parse_scratchpad_command(Line64 line) -> ScratchpadCommand {
        const i64 length = line.submission_size();
        if (length == 3 && line.submission_byte(0) == 'g' && line.submission_byte(1) == 'e' && line.submission_byte(2)
            == 't') {
            return ScratchpadCommand(ScratchpadOperation::get, 0u64);
        }
        if (length == 3 && line.submission_byte(0) == 'c' && line.submission_byte(1) == 'r' && line.submission_byte(2)
            == 'c') {
            return ScratchpadCommand(ScratchpadOperation::crc, 0u64);
        }
        i64 start = 0;
        ScratchpadOperation operation = ScratchpadOperation::put;
        if (length >= 3 && line.submission_byte(0) == 'p' && line.submission_byte(1) == 'u' && line.submission_byte(2)
            == 't') {
            start = 3;
        }
        if (length >= 6 && line.submission_byte(0) == 'a' && line.submission_byte(1) == 'p' && line.submission_byte(2)
            == 'p' && line.submission_byte(3) == 'e' && line.submission_byte(4) == 'n' && line.submission_byte(5)
            == 'd') {
            start = 6;
            operation = ScratchpadOperation::append;
        }
        if (start != 0 && length <= start + 50) {
            if (length == start) {
                return ScratchpadCommand(operation, 0u64);
            }
            if (line.submission_byte(start) == ' ') {
                start = start + 1;
                ScratchpadCommand command = ScratchpadCommand(operation, u64(length - start));
                i64 index = start;
                while (index < length) {
                    if (!command.set(u64(index - start), line.submission_byte(index))) {
                        return ScratchpadCommand(ScratchpadOperation::get, 64u64);
                    }
                    index = index + 1;
                }
                return command;
            }
        }
        return ScratchpadCommand(ScratchpadOperation::get, 64u64);
    }
}
