export module console.program_session;

export namespace console {
    enum class ProgramEffect {
        invalid,
        ready,
        file_ready,
        input,
        note,
        files,
        upper,
        read_note,
        upper_note,
        file,
        peek,
        wc,
        crc,
        unknown,
        note_saved,
        file_reply,
        abort_file,
        exited,
        failed,
        run
    };

    // Copied session policy only, not Console, store or protected-run authority.
    // Phases: new, response, input, note selection, file selection, terminal.
    // Events: begin(profile), response(bool), input(action, CR), note/file result.
    // Profiles: 0 protected console, 1 file-call, 2 production with run.
    // Outcomes: 0 open, 1 exit, 2 failed.
    // Input actions retain ProgramInputAction's wire order; note/file values are
    // the existing update_note/update_files actions, not re-parsed commands.
    // Raw scalar facts are checked before use; refusal never changes the session.
    class ProgramSession {
        u64 phase;
        u64 after_cr;
        u64 profile;
        u64 outcome;
    public:
        ProgramSession() : phase(0u64), after_cr(0u64), profile(0u64), outcome(0u64) {
        }
        auto carry() const -> u64 {
            return after_cr;
        }
        auto result() const -> u64 {
            return outcome;
        }
        auto advance(u64 event, u64 value, u64 carry) -> ProgramEffect {
            const u64 begin = 0u64;
            const u64 response = 1u64;
            const u64 input = 2u64;
            const u64 note = 3u64;
            const u64 files = 4u64;
            const u64 terminal = 5u64;
            if (phase > terminal || after_cr > 1u64 || profile > 2u64 || outcome > 2u64 || event > files || (event
                != input && carry != 0u64)) {
                return ProgramEffect::invalid;
            }
            if (phase == terminal || outcome != 0u64) {
                return ProgramEffect::invalid;
            }
            if (event == begin && phase == begin && value <= 2u64 && after_cr == 0u64 && profile == 0u64) {
                profile = value;
                phase = response;
                if (profile == 1u64) {
                    return ProgramEffect::file_ready;
                }
                return ProgramEffect::ready;
            }
            if (event == response && phase == response && value <= 1u64) {
                if (value == 0u64) {
                    phase = terminal;
                    outcome = 2u64;
                    return ProgramEffect::failed;
                }
                phase = input;
                return ProgramEffect::input;
            }
            if (event == input && phase == input && value <= 4u64 && carry <= 1u64) {
                after_cr = carry;
                if (value == 4u64) {
                    phase = response;
                    if (profile == 2u64) {
                        return ProgramEffect::run;
                    }
                    return ProgramEffect::unknown;
                }
                if (value >= 2u64) {
                    phase = terminal;
                    outcome = value - 1u64;
                    if (value == 2u64) {
                        return ProgramEffect::exited;
                    }
                    return ProgramEffect::failed;
                }
                if (value == 1u64) {
                    phase = response;
                    if (profile == 1u64) {
                        return ProgramEffect::unknown;
                    }
                    return ProgramEffect::upper;
                }
                if (profile == 1u64) {
                    phase = files;
                    return ProgramEffect::files;
                }
                phase = note;
                return ProgramEffect::note;
            }
            if (event == note && phase == note && profile != 1u64 && (value <= 4u64 || (profile == 2u64 && value
                == 5u64))) {
                if (value == 0u64) {
                    phase = files;
                    return ProgramEffect::files;
                }
                phase = response;
                if (value == 5u64) {
                    return ProgramEffect::file_reply;
                }
                if (value == 1u64) {
                    return ProgramEffect::note_saved;
                }
                if (value == 4u64) {
                    return ProgramEffect::upper_note;
                }
                return ProgramEffect::read_note;
            }
            if (event == files && phase == files && value <= 7u64) {
                phase = response;
                if (value == 0u64) {
                    return ProgramEffect::unknown;
                }
                if (value == 1u64) {
                    return ProgramEffect::file_reply;
                }
                if (profile != 1u64) {
                    if (value <= 3u64 || value == 7u64) {
                        return ProgramEffect::file;
                    }
                    return ProgramEffect::abort_file;
                }
                if (value <= 3u64 || value == 7u64) {
                    return ProgramEffect::abort_file;
                }
                if (value == 4u64) {
                    return ProgramEffect::peek;
                }
                if (value == 5u64) {
                    return ProgramEffect::wc;
                }
                return ProgramEffect::crc;
            }
            return ProgramEffect::invalid;
        }
    };

    class ProgramSessionUpdate {
        ProgramSession session;
        ProgramEffect effect;
        u64 after_cr;
        u64 outcome;
    public:
        ProgramSessionUpdate(ProgramSession next, ProgramEffect action) : session(next), effect(action),
            after_cr(next.carry()), outcome(next.result()) {
        }
    };

    auto advance_program_session(ProgramSession current, u64 event, u64 value, u64 carry) -> ProgramSessionUpdate {
        ProgramSession next = current;
        const ProgramEffect effect = next.advance(event, value, carry);
        return ProgramSessionUpdate(next, effect);
    }
}
