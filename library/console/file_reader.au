export module console.file_reader;
export namespace console {
    enum class FileReadStatus {
        ready,
        byte,
        eof,
        missing,
        rejected
    };
    auto file_read_reply_valid(u64 value) -> bool {
        return value == 2u64 || value == 3u64 || ((value & 255u64) == 1u64 && (value >> 8) <= 255u64);
    }
    class FileReader {
        u64 cursor;
        u64 current;
        FileReadStatus state;
    public:
        FileReader() : cursor(0u64), current(0u64), state(FileReadStatus::ready) {
        }
        auto offset() const -> u64 {
            return cursor;
        }
        auto status() const -> FileReadStatus {
            return state;
        }
        auto value() const -> u64 {
            return current;
        }
        auto active() const -> bool {
            return state == FileReadStatus::ready || state == FileReadStatus::byte;
        }
        auto accept(bool replied, u64 value) -> bool {
            if (!active()) {
                return false;
            }
            current = 0u64;
            state = FileReadStatus::rejected;
            if (!replied || !file_read_reply_valid(value)) {
                return false;
            }
            if (value == 2u64) {
                state = FileReadStatus::eof;
                return true;
            }
            if (value == 3u64) {
                state = FileReadStatus::missing;
                return true;
            }
            if (cursor >= 49u64) {
                return false;
            }
            current = value >> 8;
            cursor = cursor + 1u64;
            state = FileReadStatus::byte;
            return true;
        }
    };
}
