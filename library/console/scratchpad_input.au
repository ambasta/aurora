export module console.scratchpad_input;
import console.input_line;
import console.line;
import console.scratchpad;
import console.scratchpad_parse;

export namespace console {
    auto read_scratchpad_input(builtin::ConsoleSession& session, bool after_cr) -> ScratchpadSubmission {
        const ScratchpadCommand empty = ScratchpadCommand(ScratchpadOperation::get, 0u64);
        bool pending_cr = after_cr;
        while (true) {
            const InputLine input = read_input_line(session, pending_cr, false);
            pending_cr = input.after_cr_pending();
            u64 carry = 0u64;
            if (pending_cr) {
                carry = 1u64;
            }
            if (input.status() == InputLineKind::requested_exit) {
                return ScratchpadSubmission(empty, ScratchpadInputAction::requested_exit, carry);
            }
            if (input.status() == InputLineKind::output_failure) {
                return ScratchpadSubmission(empty, ScratchpadInputAction::output_failure, carry);
            }
            const ScratchpadCommand command = parse_scratchpad_command(input.command_line());
            if (command.valid()) {
                // A failed delimiter must not dispatch a protected command.
                if (!input_text(session, "\r\n")) {
                    return ScratchpadSubmission(empty, ScratchpadInputAction::output_failure, carry);
                }
                return ScratchpadSubmission(command, ScratchpadInputAction::command, carry);
            }
            if (!input_text(session,
                "\r\nInvalid command. Type help; put/append accept at most 49 printable ASCII bytes.\r\naurora> ")) {
                return ScratchpadSubmission(empty, ScratchpadInputAction::output_failure, carry);
            }
        }
        return ScratchpadSubmission(empty, ScratchpadInputAction::output_failure, 0u64);
    }
}
