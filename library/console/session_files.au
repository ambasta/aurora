export module console.session_files;
import std.binary_buffer;
import std.binary;
import std.decimal;
import std.array;

export namespace console {
    enum class FileEvent {
        unknown,
        written,
        read,
        removed,
        listed,
        missing,
        invalid,
        full,
        reserved
    };

    // Copied response bytes only: no workspace view or session authority escapes.
    class FileReply {
        array<u8, 64> bytes;
        i64 length;
        FileEvent event;
    public:
        FileReply() : bytes{}, length(0), event(FileEvent::unknown) {
        }
        auto status() const -> FileEvent {
            return event;
        }
        auto size() const -> i64 {
            return length;
        }
        auto at(i64 index) const -> u8 {
            if (index < 0 || index >= length) {
                return '\0';
            }
            return bytes[index];
        }
        auto append(u8 byte) -> bool {
            if (length == 64) {
                return false;
            }
            bytes[length] = byte;
            length = length + 1;
            return true;
        }
        auto text(builtin::span<const u8> value) -> bool {
            if (value.size() > 64 - length) {
                return false;
            }
            i64 index = 0;
            while (index < value.size()) {
                append(value.at(index));
                index = index + 1;
            }
            return true;
        }
        auto select(FileEvent value) -> bool {
            event = value;
            if (value == FileEvent::removed) {
                return text("files: removed (RAM-only).");
            }
            if (value == FileEvent::missing) {
                return text("files: not found (RAM-only).");
            }
            if (value == FileEvent::invalid) {
                return text("files: invalid name or content.");
            }
            if (value == FileEvent::full) {
                return text("files: full (4 files).");
            }
            if (value == FileEvent::reserved) {
                return text("files: note is reserved.");
            }
            return true;
        }
    };

    // Four session-local records: name length, content length, name[8],
    // content[49], zero suffix. Occupancy and all records die with the session.
    class SessionFiles {
        array<std::BinaryBuffer64, 4> records;
        u64 occupied;
    public:
        SessionFiles(std::BinaryBuffer64 empty) : records{
            empty,
            empty,
            empty,
            empty
        }, occupied(0u64) {
        }

        auto submit(std::BinaryBuffer64 command, i64 count) -> FileReply {
            FileReply reply = FileReply();
            if (count < 0 || count > 64) {
                reply.select(FileEvent::invalid);
                return reply;
            }
            if (command.equal(0, count, "ls")) {
                reply.select(FileEvent::listed);
                reply.text("files:");
                i64 slot = 0;
                while (slot < 4) {
                    const std::BinaryBuffer64 record = records[slot];
                    const i64 length = i64(record.at(0));
                    if ((occupied & (1u64 << slot)) != 0u64) {
                        reply.append(' ');
                        i64 index = 0;
                        while (index < length) {
                            reply.append(record.at(2 + index));
                            index = index + 1;
                        }
                    }
                    slot = slot + 1;
                }
                if (occupied == 0u64) {
                    reply.text(" empty (RAM-only).");
                }
                return reply;
            }
            i64 start = 0;
            FileEvent action = FileEvent::unknown;
            if (command.starts_with(count, "write ")) {
                start = 6;
                action = FileEvent::written;
            }
            if (command.starts_with(count, "cat ")) {
                start = 4;
                action = FileEvent::read;
            }
            if (command.starts_with(count, "rm ")) {
                start = 3;
                action = FileEvent::removed;
            }
            if (action == FileEvent::unknown) {
                // Exact verbs and malformed ls are recognized, without accepting prefixes.
                if (command.equal(0, count, "write") || command.equal(0, count, "cat") || command.equal(0, count, "rm")
                    || command.starts_with(count, "ls ")) {
                    reply.select(FileEvent::invalid);
                }
                return reply;
            }
            i64 end = start;
            while (end < count && command.at(end) != ' ') {
                end = end + 1;
            }
            const i64 name_size = end - start;
            if (name_size < 1 || name_size > 8 || (action == FileEvent::written && end == count) || (action
                != FileEvent::written && end != count)) {
                reply.select(FileEvent::invalid);
                return reply;
            }
            i64 index = start;
            while (index < end) {
                const u8 byte = command.at(index);
                if (!((byte >= 'a' && byte <= 'z') || (byte >= 'A' && byte <= 'Z') || (byte >= '0' && byte <= '9')
                    || byte == '.' || byte == '_' || byte == '-')) {
                    reply.select(FileEvent::invalid);
                    return reply;
                }
                index = index + 1;
            }
            if (command.equal(start, name_size, ".") || command.equal(start, name_size, "..")) {
                reply.select(FileEvent::invalid);
                return reply;
            }
            i64 content_size = 0;
            if (action == FileEvent::written) {
                content_size = count - end - 1;
                if (content_size > 49) {
                    reply.select(FileEvent::invalid);
                    return reply;
                }
                index = end + 1;
                while (index < count) {
                    const u8 byte = command.at(index);
                    if (byte < ' ' || byte > '~') {
                        reply.select(FileEvent::invalid);
                        return reply;
                    }
                    index = index + 1;
                }
            }
            if (command.equal(start, name_size, "note")) {
                reply.select(FileEvent::reserved);
                return reply;
            }
            i64 found = -1;
            i64 free_slot = -1;
            i64 slot = 0;
            while (slot < 4) {
                const std::BinaryBuffer64 record = records[slot];
                const i64 length = i64(record.at(0));
                const bool present =(occupied & (1u64 << slot)) != 0u64;
                if (!present && free_slot == -1) {
                    free_slot = slot;
                }
                if (present && command.equal(start, name_size, record.bytes(2, length))) {
                    found = slot;
                }
                slot = slot + 1;
            }
            if (action == FileEvent::read) {
                if (found == -1) {
                    reply.select(FileEvent::missing);
                    return reply;
                }
                reply.select(FileEvent::read);
                const std::BinaryBuffer64 record = records[found];
                index = 0;
                while (index < i64(record.at(1))) {
                    reply.append(record.at(10 + index));
                    index = index + 1;
                }
                return reply;
            }
            if (action == FileEvent::removed && found == -1) {
                reply.select(FileEvent::missing);
                return reply;
            }
            if (action == FileEvent::written && found == -1 && free_slot == -1) {
                reply.select(FileEvent::full);
                return reply;
            }
            // Stage a complete zeroed record before committing any workspace field.
            std::BinaryBuffer64 record = std::BinaryBuffer64();
            if (action == FileEvent::removed) {
                records[found] = record;
                occupied = occupied & ~(1u64 << found);
            } else {
                record.write_u8(0, u8(name_size));
                record.write_u8(1, u8(content_size));
                index = 0;
                while (index < name_size) {
                    record.write_u8(2 + index, command.at(start + index));
                    index = index + 1;
                }
                index = 0;
                while (index < content_size) {
                    record.write_u8(10 + index, command.at(end + 1 + index));
                    index = index + 1;
                }
                if (found == -1) {
                    found = free_slot;
                }
                records[found] = record;
                occupied = occupied | (1u64 << found);
            }
            reply.select(action);
            if (action == FileEvent::written) {
                // At most 24 bytes: an eight-byte name and the bounded 0..49 count.
                reply.text("wrote ");
                index = start;
                while (index < end) {
                    reply.append(command.at(index));
                    index = index + 1;
                }
                reply.append(':');
                reply.append(' ');
                const std::DecimalEncodingResult size = std::format_decimal_i64(content_size);
                index = 0;
                while (index < size.size()) {
                    reply.append(size.byte_or(index, '\0'));
                    index = index + 1;
                }
                reply.text(" byte");
                if (content_size != 1) {
                    reply.append('s');
                }
            }
            return reply;
        }
    };
}
