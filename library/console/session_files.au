export module console.session_files;
import console.file_namespace;
import std.binary_buffer;
import std.binary;
import std.decimal;
import std.array;

export namespace console {
    // Copied response bytes only: no workspace view or session authority escapes.
    class FileReply {
        array<u8, 64> bytes;
        i64 length;
        FileEvent event;
    public:
        FileReply() : bytes{}, length(0), event(FileEvent::unknown) {
        }
        auto status() const -> FileEvent {
            return event;
        }
        auto size() const -> i64 {
            return length;
        }
        auto at(i64 index) const -> u8 {
            if (index < 0 || index >= length) {
                return '\0';
            }
            return bytes[index];
        }
        auto append(u8 byte) -> bool {
            if (length == 64) {
                return false;
            }
            bytes[length] = byte;
            length = length + 1;
            return true;
        }
        auto text(builtin::span<const u8> value) -> bool {
            if (value.size() > 64 - length) {
                return false;
            }
            i64 index = 0;
            while (index < value.size()) {
                append(value.at(index));
                index = index + 1;
            }
            return true;
        }
        auto select(FileEvent value) -> bool {
            event = value;
            if (value == FileEvent::removed) {
                return text("files: removed (RAM-only).");
            }
            if (value == FileEvent::missing) {
                return text("files: not found (RAM-only).");
            }
            if (value == FileEvent::invalid) {
                return text("files: invalid name or content.");
            }
            if (value == FileEvent::full) {
                return text("files: full (4 files).");
            }
            if (value == FileEvent::reserved) {
                return text("files: note is reserved.");
            }
            return true;
        }
    };

    // One canonical parser for the existing append grammar, shared by the local
    // store and the protected nonmutating preparation path.
    class FileAppendRequest {
        FileName name;
        FileValue suffix;
    public:
        FileAppendRequest(FileName selected, FileValue addition) : name(selected), suffix(addition) {
        }
        auto selected_name() const -> FileName {
            const FileName result = name;
            return result;
        }
        auto appended_value() const -> FileValue {
            const FileValue result = suffix;
            return result;
        }
    };
    auto file_append_request(std::BinaryBuffer64 command, i64 count) -> FileAppendRequest {
        i64 end = 7;
        if (count >= 0 && count <= 64 && command.starts_with(count, "append ")) {
            while (end < count && command.at(end) != ' ') {
                end = end + 1;
            }
            if (end < count) {
                return FileAppendRequest(file_name(command, 7, end - 7), file_value(command, end + 1, count - end - 1));
            }
        }
        const std::BinaryBuffer64 empty = std::BinaryBuffer64();
        return FileAppendRequest(FileName(empty, -1), FileValue(empty, -1));
    }

    // The ordinary console and protected namespace consumer share these typed
    // request parsers. Exactly one separator precedes content; remaining spaces
    // are bytes. A write requires that separator, including for an empty value.
    class FileWriteRequest {
        FileName name;
        FileValue value;
    public:
        FileWriteRequest(FileName selected, FileValue contents) : name(selected), value(contents) {
        }
        auto selected_name() const -> FileName {
            const FileName result = name;
            return result;
        }
        auto written_value() const -> FileValue {
            const FileValue result = value;
            return result;
        }
    };
    auto file_write_request(std::BinaryBuffer64 command, i64 count) -> FileWriteRequest {
        i64 end = 6;
        if (count >= 0 && count <= 64 && command.starts_with(count, "write ")) {
            while (end < count && command.at(end) != ' ') {
                end = end + 1;
            }
            if (end < count) {
                return FileWriteRequest(file_name(command, 6, end - 6), file_value(command, end + 1, count - end - 1));
            }
        }
        const std::BinaryBuffer64 empty = std::BinaryBuffer64();
        return FileWriteRequest(FileName(empty, -1), FileValue(empty, -1));
    }
    auto file_read_request(std::BinaryBuffer64 command, i64 count) -> FileName {
        if (count >= 0 && count <= 64 && command.starts_with(count, "cat ")) {
            return file_name(command, 4, count - 4);
        }
        const std::BinaryBuffer64 empty = std::BinaryBuffer64();
        return FileName(empty, -1);
    }

    // Shared presentation adapter for ordinary and protected write outcomes.
    auto file_write_reply(FileName name, i64 count, FileEvent event) -> FileReply {
        FileReply reply = FileReply();
        if (event == FileEvent::written && (!name.valid() || count < 0 || count > 49)) {
            reply.select(FileEvent::invalid);
            return reply;
        }
        reply.select(event);
        if (event != FileEvent::written) {
            return reply;
        }
        reply.text("wrote ");
        i64 index = 0;
        while (index < name.size()) {
            reply.append(name.at(index));
            index = index + 1;
        }
        reply.text(": ");
        i64 place = std::format_decimal_width_u64(u64(count));
        while (place > 0) {
            place = place - 1;
            reply.append(std::format_decimal_digit_at_u64(u64(count), place));
        }
        reply.text(" byte");
        if (count != 1) {
            reply.append('s');
        }
        return reply;
    }

    auto file_data_reply(FileData data) -> FileReply {
        FileReply reply = FileReply();
        reply.select(data.status());
        i64 index = 0;
        while (index < data.size()) {
            reply.append(data.at(index));
            index = index + 1;
        }
        return reply;
    }

    // Parsing and presentation only. The nested namespace is the sole store;
    // this adapter preserves the existing copied owner size and lifetime.
    class SessionFiles {
        FileNamespace namespace_files;
    public:
        SessionFiles(FileNamespace initial) : namespace_files(initial) {
        }
        auto read_file(FileName name) const -> FileReply {
            return file_data_reply(namespace_files.read_file(name));
        }
        auto write_file(FileName name, FileValue value) -> FileEvent {
            return namespace_files.write_file(name, value);
        }
        auto prepare_append(FileName name, FileValue suffix) const -> FileReply {
            return file_data_reply(namespace_files.prepare_append(name, suffix));
        }
        auto append_file(FileName name, FileValue suffix) -> FileEvent {
            return namespace_files.append_file(name, suffix);
        }
        auto copy_file(FileName source, FileName destination) -> FileReply {
            const FileOutcome outcome = namespace_files.copy_file(source, destination);
            return file_write_reply(destination, outcome.size(), outcome.status());
        }
        auto remove(FileName name) -> FileEvent {
            return namespace_files.remove(name);
        }
        auto snapshot() const -> FileNamespace {
            const FileNamespace result = namespace_files;
            return result;
        }
        auto list() const -> FileReply {
            FileReply reply = FileReply();
            reply.select(FileEvent::listed);
            reply.text("files:");
            bool any = false;
            i64 slot = 0;
            while (slot < 4) {
                const FileName name = namespace_files.name_at(slot);
                if (name.size() > 0) {
                    any = true;
                    reply.append(' ');
                    i64 index = 0;
                    while (index < name.size()) {
                        reply.append(name.at(index));
                        index = index + 1;
                    }
                }
                slot = slot + 1;
            }
            if (!any) {
                reply.text(" empty (RAM-only).");
            }
            return reply;
        }
        auto submit(std::BinaryBuffer64 command, i64 count) -> FileReply {
            FileReply reply = FileReply();
            if (count < 0 || count > 64) {
                reply.select(FileEvent::invalid);
                return reply;
            }
            if (command.equal(0, count, "ls")) {
                return list();
            }
            i64 start = 0;
            FileEvent action = FileEvent::unknown;
            const bool copying = command.starts_with(count, "copy ");
            if (command.starts_with(count, "append ")) {
                const FileAppendRequest request = file_append_request(command, count);
                const FileName name = request.selected_name();
                const FileValue suffix = request.appended_value();
                const FileEvent event = namespace_files.append_file(name, suffix);
                return file_write_reply(name, suffix.size(), event);
            }
            if (command.starts_with(count, "write ")) {
                const FileWriteRequest request = file_write_request(command, count);
                const FileName name = request.selected_name();
                const FileValue value = request.written_value();
                const FileEvent event = namespace_files.write_file(name, value);
                return file_write_reply(name, value.size(), event);
            }
            if (copying) {
                start = 5;
                action = FileEvent::written;
            }
            if (command.starts_with(count, "cat ")) {
                return file_data_reply(namespace_files.read_file(file_read_request(command, count)));
            }
            if (command.starts_with(count, "rm ")) {
                start = 3;
                action = FileEvent::removed;
            }
            if (action == FileEvent::unknown) {
                if (command.equal(0, count, "write") || command.equal(0, count, "cat") || command.equal(0, count, "rm")
                    || command.equal(0, count, "append") || command.equal(0, count, "copy")
                    || command.starts_with(count, "ls ")) {
                    reply.select(FileEvent::invalid);
                }
                return reply;
            }
            i64 end = start;
            while (end < count && command.at(end) != ' ') {
                end = end + 1;
            }
            if ((action == FileEvent::written && end == count) || (action != FileEvent::written && end != count)) {
                reply.select(FileEvent::invalid);
                return reply;
            }
            const FileName name = file_name(command, start, end - start);
            if (action == FileEvent::removed) {
                reply.select(namespace_files.remove(name));
                return reply;
            }
            if (copying) {
                const FileName destination = file_name(command, end + 1, count - end - 1);
                const FileOutcome outcome = namespace_files.copy_file(name, destination);
                return file_write_reply(destination, outcome.size(), outcome.status());
            }
            reply.select(FileEvent::invalid);
            return reply;
        }
    };
}
