export module console.protected_files;
import console.session_files;
import std.binary_buffer;
import std.binary;

// A copied selection is policy data, not authority. The protected supervisor
// retains it privately and binds it to authenticated, per-command IPC grants.
export namespace console {
    class FileSelection {
        std::BinaryBuffer64 command;
        i64 count;
        u64 revision;
        u64 replacement;
    public:
        FileSelection(std::BinaryBuffer64 read, i64 size, u64 version, u64 writable)
            : command(read), count(size), revision(version), replacement(writable) {
        }
        auto read_command() const -> std::BinaryBuffer64 {
            const std::BinaryBuffer64 result = command;
            return result;
        }
        auto size() const -> i64 {
            return count;
        }
        auto version() const -> u64 {
            return revision;
        }
        auto writable() const -> bool {
            return replacement == 1u64;
        }
    };

    // The existing four records remain the sole naming/content implementation.
    // Any successful mutation invalidates selections, even for another name.
    class ProtectedFiles {
        SessionFiles files;
        u64 revision;
    public:
        ProtectedFiles(SessionFiles initial) : files(initial), revision(1u64) {
        }
        auto submit(std::BinaryBuffer64 command, i64 count) -> FileReply {
            SessionFiles next = files;
            FileReply reply = next.submit(command, count);
            if (reply.status() == FileEvent::written || reply.status() == FileEvent::removed) {
                if (revision == 18446744073709551615u64) {
                    FileReply rejected = FileReply();
                    rejected.select(FileEvent::invalid);
                    return rejected;
                }
                files = next;
                revision = revision + 1u64;
            }
            return reply;
        }
        auto select(std::BinaryBuffer64 command, i64 count) const -> FileSelection {
            std::BinaryBuffer64 read = std::BinaryBuffer64();
            u64 writable = 0u64;
            i64 size = count;
            if (command.starts_with(count, "upper ")) {
                read.write_u8(0, 'c');
                read.write_u8(1, 'a');
                read.write_u8(2, 't');
                read.write_u8(3, ' ');
                i64 index = 6;
                while (index < count) {
                    read.write_u8(index - 2, command.at(index));
                    index = index + 1;
                }
                size = count - 2;
                writable = 1u64;
            } else {
                if (!command.starts_with(count, "cat ")) {
                    const std::BinaryBuffer64 empty = std::BinaryBuffer64();
                    return FileSelection(empty, 0, 0u64, 0u64);
                }
                i64 index = 0;
                while (index < count) {
                    read.write_u8(index, command.at(index));
                    index = index + 1;
                }
            }
            SessionFiles copied = files;
            const FileReply reply = copied.submit(read, size);
            if (reply.status() != FileEvent::read && reply.status() != FileEvent::missing) {
                const std::BinaryBuffer64 empty = std::BinaryBuffer64();
                return FileSelection(empty, 0, 0u64, 0u64);
            }
            if (reply.status() == FileEvent::missing) {
                writable = 0u64;
            }
            return FileSelection(read, size, revision, writable);
        }
        auto project(FileSelection selection) const -> FileReply {
            if (selection.version() == 0u64 || selection.version() != revision) {
                FileReply rejected = FileReply();
                rejected.select(FileEvent::invalid);
                return rejected;
            }
            SessionFiles copied = files;
            const std::BinaryBuffer64 command = selection.read_command();
            return copied.submit(command, selection.size());
        }
        auto replace(FileSelection selection, std::BinaryBuffer64 output, i64 count) -> FileReply {
            const FileReply current = project(selection);
            if (!selection.writable() || current.status() != FileEvent::read || count < 0 || count > 49) {
                FileReply rejected = FileReply();
                rejected.select(FileEvent::invalid);
                return rejected;
            }
            // Reuse the exact ordinary write validation and staged record commit.
            const std::BinaryBuffer64 read = selection.read_command();
            const i64 name_size = selection.size() - 4;
            std::BinaryBuffer64 command = std::BinaryBuffer64();
            command.write_u8(0, 'w');
            command.write_u8(1, 'r');
            command.write_u8(2, 'i');
            command.write_u8(3, 't');
            command.write_u8(4, 'e');
            command.write_u8(5, ' ');
            i64 index = 0;
            while (index < name_size) {
                command.write_u8(6 + index, read.at(4 + index));
                index = index + 1;
            }
            command.write_u8(6 + name_size, ' ');
            index = 0;
            while (index < count) {
                command.write_u8(7 + name_size + index, output.at(index));
                index = index + 1;
            }
            return submit(command, 7 + name_size + count);
        }
    };
}
