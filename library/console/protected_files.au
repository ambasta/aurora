export module console.protected_files;
import console.file_namespace;
import console.session_files;
import std.binary_buffer;
import std.binary;

// A copied selection is policy data, not authority. The protected supervisor
// retains it privately and binds it to authenticated, per-command IPC grants.
export namespace console {
    class FileSelection {
        FileName name;
        u64 revision;
        u64 replacement;
        FileValue suffix;
    public:
        FileSelection(FileName selected, u64 version, u64 writable, FileValue addition) : name(selected),
            revision(version), replacement(writable), suffix(addition) {
        }
        auto selected_name() const -> FileName {
            const FileName result = name;
            return result;
        }
        auto version() const -> u64 {
            return revision;
        }
        auto writable() const -> bool {
            return replacement == 1u64 || replacement == 2u64;
        }
        auto appending() const -> bool {
            return replacement == 2u64;
        }
        auto appended_value() const -> FileValue {
            const FileValue result = suffix;
            return result;
        }
    };

    // The existing four records remain the sole naming/content implementation.
    // Any successful mutation invalidates selections, even for another name.
    class ProtectedFiles {
        FileNamespace files;
        u64 revision;
        // Keep the constructor's copied input out of the mutation call chain.
        // The returned adapter is the one tentative namespace, not another owner.
        auto command_adapter() const -> SessionFiles {
            const FileNamespace current = files;
            const SessionFiles result = SessionFiles(current);
            return result;
        }
    public:
        ProtectedFiles(FileNamespace initial) : files(initial), revision(1u64) {
        }
        auto submit(std::BinaryBuffer64 command, i64 count) -> FileReply {
            SessionFiles next = command_adapter();
            FileReply reply = next.submit(command, count);
            if (file_mutated(reply.status())) {
                if (file_next_revision(revision) == 0u64) {
                    FileReply rejected = FileReply();
                    rejected.select(FileEvent::invalid);
                    return rejected;
                }
                const FileNamespace committed = next.snapshot();
                files = committed;
                revision = file_next_revision(revision);
            }
            return reply;
        }
        // A successful preparation exposes only the frozen prefix; no candidate
        // is assembled and the store/revision remain unchanged.
        auto prepare_append(FileAppendRequest request) const -> FileReply {
            const FileName name = request.selected_name();
            const FileValue suffix = request.appended_value();
            const FileData reply = files.prepare_append(name, suffix);
            if (reply.status() == FileEvent::read && file_next_revision(revision) == 0u64) {
                FileReply rejected = FileReply();
                rejected.select(FileEvent::invalid);
                return rejected;
            }
            return file_data_reply(reply);
        }
        auto select(std::BinaryBuffer64 command, i64 count) const -> FileSelection {
            if (command.starts_with(count, "append ")) {
                const FileAppendRequest request = file_append_request(command, count);
                const FileName name = request.selected_name();
                const FileValue suffix = request.appended_value();
                const FileReply reply = prepare_append(request);
                if (reply.status() == FileEvent::read) {
                    return FileSelection(name, revision, 2u64, suffix);
                }
                return FileSelection(name, 0u64, 0u64, suffix);
            }
            i64 start = -1;
            if (command.starts_with(count, "cat ")) {
                start = 4;
            }
            if (command.starts_with(count, "peek ")) {
                start = 5;
            }
            if (command.starts_with(count, "wc ")) {
                start = 3;
            }
            if (command.starts_with(count, "crc ")) {
                start = 4;
            }
            const bool upper = command.starts_with(count, "upper ");
            if (upper) {
                start = 6;
            }
            i64 length = -1;
            if (count >= 0 && count <= 64 && start >= 0) {
                length = count - start;
            }
            const FileName name = file_name(command, start, length);
            const FileData reply = files.read_file(name);
            u64 version = 0u64;
            u64 writable = 0u64;
            if (reply.status() == FileEvent::read || reply.status() == FileEvent::missing) {
                version = revision;
            }
            if (upper && reply.status() == FileEvent::read) {
                writable = 1u64;
            }
            const std::BinaryBuffer64 empty = std::BinaryBuffer64();
            return FileSelection(name, version, writable, FileValue(empty, 0));
        }
        auto project(FileSelection selection) const -> FileReply {
            if (selection.version() == 0u64 || selection.version() != revision) {
                FileReply rejected = FileReply();
                rejected.select(FileEvent::invalid);
                return rejected;
            }
            const FileName name = selection.selected_name();
            return file_data_reply(files.read_file(name));
        }
        auto replace(FileSelection selection, std::BinaryBuffer64 output, i64 count) -> FileReply {
            const FileReply current = project(selection);
            if (!selection.writable() || current.status() != FileEvent::read || file_next_revision(revision) == 0u64) {
                FileReply rejected = FileReply();
                rejected.select(FileEvent::invalid);
                return rejected;
            }
            const FileName name = selection.selected_name();
            const FileValue value = FileValue(output, count);
            i64 reported = value.size();
            if (selection.appending()) {
                const FileValue suffix = selection.appended_value();
                bool valid = suffix.valid() && value.valid();
                if (valid) {
                    valid = suffix.size() <= 49 - current.size() && count == current.size() + suffix.size();
                }
                i64 index = 0;
                while (valid && index < current.size()) {
                    valid = output.at(index) == current.at(index);
                    index = index + 1;
                }
                index = 0;
                while (valid && index < suffix.size()) {
                    valid = output.at(current.size() + index) == suffix.at(index);
                    index = index + 1;
                }
                index = count;
                while (valid && index < 64) {
                    valid = output.at(index) == '\0';
                    index = index + 1;
                }
                if (!valid) {
                    FileReply rejected = FileReply();
                    rejected.select(FileEvent::invalid);
                    return rejected;
                }
                reported = suffix.size();
            }
            const FileEvent event = files.write_file(name, value);
            if (event == FileEvent::written) {
                revision = file_next_revision(revision);
            }
            return file_write_reply(name, reported, event);
        }
    };
}
