export module fs.xfs_recovery_ag;
import std.binary;
import std.checksum;
import fs.xfs_geometry;
import fs.xfs_probe;
import fs.xfs_log;

export namespace fs {
    class XfsRecoveryAgRequest {
        u64 _number;
        u64 _head;
    public:
        XfsRecoveryAgRequest(u64 number, u64 head_lsn) : _number(number), _head(head_lsn) {
        }
        auto number() const -> u64 {
            return _number;
        }
        auto head_lsn() const -> u64 {
            return _head;
        }
    };
    // Header summary evidence only: neither an allocation-tree proof nor a grant.
    class XfsRecoveryAgReport {
        bool _valid;
        u64 _inodes;
        u64 _free_inodes;
        u64 _free_blocks;
        u64 _root;
    public:
        XfsRecoveryAgReport(bool valid, u64 inodes, u64 free_inodes, u64 free_blocks, u64 root) : _valid(valid),
            _inodes(inodes), _free_inodes(free_inodes), _free_blocks(free_blocks), _root(root) {
        }
        auto inobt_root() const -> u64 {
            if (_valid) {
                return _root;
            }
            return 0u64;
        }
        auto inobt_level() const -> u64 {
            if (_valid) {
                return 1u64;
            }
            return 0u64;
        }
        auto valid() const -> bool {
            return _valid;
        }
        auto inode_count() const -> u64 {
            if (_valid) {
                return _inodes;
            }
            return 0u64;
        }
        auto free_inodes() const -> u64 {
            if (_valid) {
                return _free_inodes;
            }
            return 0u64;
        }
        auto free_blocks() const -> u64 {
            if (_valid) {
                return _free_blocks;
            }
            return 0u64;
        }
    };
}
namespace fs {
    auto xra32(builtin::span<const u8> bytes, i64 at) -> u64 {
        const std::ByteReadResult word = std::read_be32(bytes, at);
        return word.value_or(0u64);
    }
    auto xra64(builtin::span<const u8> bytes, i64 at) -> u64 {
        const std::ByteReadResult word = std::read_be64(bytes, at);
        return word.value_or(0u64);
    }
    auto xra_zero(builtin::span<const u8> bytes, i64 begin, i64 end) -> bool {
        i64 at = begin;
        while (at < end) {
            if (bytes.at(at) != 0u8) {
                return false;
            }
            at = at + 1;
        }
        return true;
    }
    auto xra_crc(builtin::span<const u8> bytes, i64 offset) -> bool {
        const builtin::array<u8, 4> zero = {
            0u8,
            0u8,
            0u8,
            0u8
        };
        const std::ChecksumResult prefix = std::crc32c(bytes, 0, offset);
        const std::ChecksumResult cleared = std::crc32c_extend(prefix.value_or(4294967296u64), borrow_bytes(zero), 0,
            4);
        const std::ChecksumResult full = std::crc32c_extend(cleared.value_or(4294967296u64), bytes, offset + 4,
            bytes.size() - offset - 4);
        const std::ByteReadResult stored = std::read_le32(bytes, offset);
        return full.status() == std::ChecksumStatus::success && full.value_or(4294967296u64)
            == stored.value_or(4294967297u64);
    }
    auto xra_lsn(u64 value, u64 head, u64 sectors) -> bool {
        return value == 0u64 || (xfs_log_lsn_valid(value, sectors) && value <= head);
    }
    auto xra_root(u64 value, u64 blocks) -> bool {
        return value > 0u64 && value < blocks;
    }
    auto xra_inode(u64 value, u64 blocks) -> bool {
        return value == 4294967295u64 || (value >= 8u64 && value < blocks * 8u64);
    }
    auto xra_failure() -> XfsRecoveryAgReport {
        const XfsRecoveryAgReport result = XfsRecoveryAgReport(false, 0u64, 0u64, 0u64, 0u64);
        return result;
    }
}
export namespace fs {
    // Linux 6.12.107 v5 AG header layouts, 512-byte sectors, no rmap/reflink/
    // inobtcount, one-level allocation trees. No tree traversal is implied.
    auto inspect_xfs_recovery_ag(builtin::span<const u8> sb, builtin::span<const u8> agf, builtin::span<const u8> agi,
        XfsRecoveryAgRequest request) -> XfsRecoveryAgReport {
        if (sb.size() != 512 || agf.size() != 512 || agi.size() != 512) {
            return xra_failure();
        }
        const XfsGeometryReport geometry = inspect_xfs_v5_512_geometry(sb);
        if (geometry.status() != XfsGeometryStatus::header_geometry_consistent || !xfs_bounded_namespace_profile(sb)) {
            return xra_failure();
        }
        const u64 agcount = xra32(sb, 88);
        const u64 agblocks = xra32(sb, 84);
        const u64 total = xra64(sb, 8);
        const u64 log_sectors = xra32(sb, 96) * 8u64;
        if (request.number() >= agcount || !xfs_log_lsn_valid(request.head_lsn(), log_sectors)) {
            return xra_failure();
        }
        u64 blocks = agblocks;
        if (request.number() == agcount - 1u64) {
            blocks = total - request.number() * agblocks;
        }
        if (xra32(agf, 0) != 1480673094u64 || xra32(agi, 0) != 1480673097u64 || xra32(agf, 4) != 1u64 || xra32(agi, 4)
            != 1u64 || xra32(agf, 8) != request.number() || xra32(agi, 8) != request.number() || xra32(agf, 12)
            != blocks || xra32(agi, 12) != blocks || !xra_crc(agf, 216) || !xra_crc(agi, 312)) {
            return xra_failure();
        }
        i64 at = 0;
        while (at < 16) {
            if (agf.at(64 + at) != sb.at(32 + at) || agi.at(296 + at) != sb.at(32 + at)) {
                return xra_failure();
            }
            at = at + 1;
        }
        if (!xra_lsn(xra64(agf, 208), request.head_lsn(), log_sectors) || !xra_lsn(xra64(agi, 320), request.head_lsn(),
            log_sectors) || !xra_zero(agf, 80, 208) || !xra_zero(agf, 220, 512) || !xra_zero(agi, 316, 320)
            || !xra_zero(agi, 336, 512) || xra32(agf, 24) != 0u64 || xra32(agf, 36) != 0u64) {
            return xra_failure();
        }
        if (!xra_root(xra32(agf, 16), blocks) || !xra_root(xra32(agf, 20), blocks) || xra32(agf, 16) == xra32(agf, 20)
            || !xra_root(xra32(agi, 20), blocks) || !xra_root(xra32(agi, 328), blocks) || xra32(agi, 20) == xra32(agi,
            328) || xra32(agf, 28) != 1u64 || xra32(agf, 32) != 1u64 || xra32(agi, 24) != 1u64 || xra32(agi, 332)
            != 1u64) {
            return xra_failure();
        }
        // AGFL capacity: (512 - sizeof(xfs_agfl=36)) / 4 = 119 entries.
        const u64 first = xra32(agf, 40);
        const u64 last = xra32(agf, 44);
        const u64 flcount = xra32(agf, 48);
        const u64 free = xra32(agf, 52);
        const u64 btree = xra32(agf, 60);
        if (first >= 119u64 || last >= 119u64 || flcount > 119u64 || (first + flcount + 118u64) % 119u64 != last || free
            > blocks || xra32(agf, 56) > free || btree > blocks || free + flcount + btree > blocks) {
            return xra_failure();
        }
        const u64 inodes = xra32(agi, 16);
        const u64 unused = xra32(agi, 28);
        if (inodes > blocks * 8u64 || unused > inodes || !xra_inode(xra32(agi, 32), blocks) || !xra_inode(xra32(agi,
            36), blocks)) {
            return xra_failure();
        }
        at = 40;
        while (at < 296) {
            if (xra32(agi, at) != 4294967295u64) {
                return xra_failure();
            }
            at = at + 4;
        }
        const XfsRecoveryAgReport result = XfsRecoveryAgReport(true, inodes, unused, free + flcount + btree, xra32(agi,
            20));
        return result;
    }
}

export namespace fs {
    class XfsRecoveryInodeRequest {
        u64 _ag;
        u64 _head;
        u64 _inode;
    public:
        XfsRecoveryInodeRequest(u64 ag, u64 head_lsn, u64 local_inode) : _ag(ag), _head(head_lsn), _inode(local_inode) {
        }
        auto ag() const -> u64 {
            return _ag;
        }
        auto head_lsn() const -> u64 {
            return _head;
        }
        auto local_inode() const -> u64 {
            return _inode;
        }
    };
    class XfsRecoveryInodeReport {
        bool _valid;
        bool _allocated;
    public:
        XfsRecoveryInodeReport(bool valid, bool allocated) : _valid(valid), _allocated(allocated) {
        }
        auto valid() const -> bool {
            return _valid;
        }
        auto allocated() const -> bool {
            return _valid && _allocated;
        }
    };
    // A complete single-leaf INOBT scan binds the target to an allocated bit.
    // This is not a generic Btree reader. Caller separately binds linked root
    // names, inode identity, stable backend and supported redo transactions.
    auto inspect_xfs_recovery_inode(builtin::span<const u8> sb, builtin::span<const u8> agi,
        builtin::span<const u8> leaf, XfsRecoveryInodeRequest request) -> XfsRecoveryInodeReport {
        if (sb.size() != 512 || agi.size() != 512 || leaf.size() != 4096) {
            const XfsRecoveryInodeReport invalid = XfsRecoveryInodeReport(false, false);
            return invalid;
        }
        const XfsGeometryReport geometry = inspect_xfs_v5_512_geometry(sb);
        if (geometry.status() != XfsGeometryStatus::header_geometry_consistent || !xfs_bounded_namespace_profile(sb)) {
            const XfsRecoveryInodeReport invalid = XfsRecoveryInodeReport(false, false);
            return invalid;
        }
        const u64 agcount = xra32(sb, 88);
        const u64 agblocks = xra32(sb, 84);
        const u64 log_sectors = xra32(sb, 96) * 8u64;
        if (request.ag() >= agcount || !xfs_log_lsn_valid(request.head_lsn(), log_sectors)) {
            const XfsRecoveryInodeReport invalid = XfsRecoveryInodeReport(false, false);
            return invalid;
        }
        u64 blocks = agblocks;
        if (request.ag() == agcount - 1u64) {
            blocks = xra64(sb, 8) - request.ag() * agblocks;
        }
        const u64 root = xra32(agi, 20);
        if (xra32(agi, 0) != 1480673097u64 || xra32(agi, 4) != 1u64 || xra32(agi, 8) != request.ag() || xra32(agi, 12)
            != blocks || !xra_crc(agi, 312) || !xra_lsn(xra64(agi, 320), request.head_lsn(), log_sectors)
            || !xra_root(root, blocks) || xra32(agi, 24) != 1u64 || xra32(agi, 28) > xra32(agi, 16) || xra32(agi, 16)
            > blocks * 8u64 || !xra_zero(agi, 316, 320) || !xra_zero(agi, 336, 512)) {
            const XfsRecoveryInodeReport invalid = XfsRecoveryInodeReport(false, false);
            return invalid;
        }
        i64 at = 0;
        while (at < 16) {
            if (agi.at(296 + at) != sb.at(32 + at) || leaf.at(32 + at) != sb.at(32 + at)) {
                const XfsRecoveryInodeReport invalid = XfsRecoveryInodeReport(false, false);
                return invalid;
            }
            at = at + 1;
        }
        at = 40;
        while (at < 296) {
            if (xra32(agi, at) != 4294967295u64) {
                const XfsRecoveryInodeReport invalid = XfsRecoveryInodeReport(false, false);
                return invalid;
            }
            at = at + 4;
        }
        const std::ByteReadResult level = std::read_be16(leaf, 4);
        const std::ByteReadResult count = std::read_be16(leaf, 6);
        const u64 records = count.value_or(253u64);
        if (xra32(leaf, 0) != 1229013555u64 || level.value_or(1u64) != 0u64 || records > 252u64 || xra32(leaf, 8)
            != 4294967295u64 || xra32(leaf, 12) != 4294967295u64 || xra64(leaf, 16) != (request.ag() * agblocks + root)
            * 8u64 || !xra_lsn(xra64(leaf, 24), request.head_lsn(), log_sectors) || xra32(leaf, 48) != request.ag()
            || !xra_crc(leaf, 52)) {
            const XfsRecoveryInodeReport invalid = XfsRecoveryInodeReport(false, false);
            return invalid;
        }
        u64 seen = 0u64;
        u64 unused = 0u64;
        u64 previous_end = 0u64;
        bool allocated = false;
        u64 record = 0u64;
        while (record < records) {
            const i64 start = 56 + i64(record) * 16;
            const u64 first = xra32(leaf, start);
            const u64 freecount = xra32(leaf, start + 4);
            const u64 mask = xra64(leaf, start + 8);
            if (first < 8u64 || first % 8u64 != 0u64 || first < previous_end || first > blocks * 8u64 || blocks * 8u64
                - first < 64u64 || freecount > 64u64) {
                const XfsRecoveryInodeReport invalid = XfsRecoveryInodeReport(false, false);
                return invalid;
            }
            u64 bits = 0u64;
            i64 bit = 0;
            while (bit < 64) {
                bits = bits + ((mask >> bit) & 1u64);
                bit = bit + 1;
            }
            if (bits != freecount) {
                const XfsRecoveryInodeReport invalid = XfsRecoveryInodeReport(false, false);
                return invalid;
            }
            if (request.local_inode() >= first && request.local_inode() - first < 64u64) {
                allocated = ((mask >> i64(request.local_inode() - first)) & 1u64) == 0u64;
            }
            seen = seen + 64u64;
            unused = unused + freecount;
            previous_end = first + 64u64;
            record = record + 1u64;
        }
        const XfsRecoveryInodeReport result = XfsRecoveryInodeReport(seen == xra32(agi, 16) && unused == xra32(agi, 28),
            allocated);
        return result;
    }
}

namespace fs {
    // Mounted replacement deliberately supports the proven fixed allocation
    // shape, not a general allocation-tree walker. Full clean recovery must
    // additionally validate all AGs and their global inode-counter sums.
    auto xma_profile(builtin::span<const u8> sb, u64 head) -> bool {
        if (sb.size() != 512) {
            return false;
        }
        const XfsGeometryReport geometry = inspect_xfs_v5_512_geometry(sb);
        return geometry.status() == XfsGeometryStatus::header_geometry_consistent && xfs_bounded_namespace_profile(sb)
            && xra64(sb, 8) == 131072u64 && xra64(sb, 16) == 0u64 && xra64(sb, 24) == 0u64 && xra64(sb, 48) == 65541u64
            && xra64(sb, 56) == 96u64 && xra64(sb, 64) == 97u64 && xra64(sb, 72) == 98u64 && xra32(sb, 84) == 32768u64
            && xra32(sb, 88) == 4u64 && xra32(sb, 96) == 16384u64 && xra64(sb, 128) == 64u64 && xra64(sb, 136) == 59u64
            && xfs_log_lsn_valid(head, 131072u64);
    }
}
export namespace fs {
    // All three mounted checks are required, together with already_clean
    // all-AG recovery and exactly inode99->block9 / inode100->block20. The
    // checks alone neither assert a clean volume nor grant write authority.
    auto inspect_xfs_mounted_headers(builtin::span<const u8> sb, builtin::span<const u8> agf,
        builtin::span<const u8> agi, builtin::span<const u8> agfl, u64 head) -> bool {
        if (!xma_profile(sb, head) || agfl.size() != 512) {
            return false;
        }
        const XfsRecoveryAgRequest request = XfsRecoveryAgRequest(0u64, head);
        const XfsRecoveryAgReport report = inspect_xfs_recovery_ag(sb, agf, agi, request);
        if (!report.valid() || report.inode_count() != 64u64 || report.free_inodes() != 59u64 || xra32(agf, 16) != 1u64
            || xra32(agf, 20) != 2u64 || xra32(agi, 20) != 3u64 || xra32(agi, 328) != 4u64 || xra32(agf, 40) != 1u64
            || xra32(agf, 44) != 4u64 || xra32(agf, 48) != 4u64 || xra32(agf, 52) != 32749u64 || xra32(agf, 56)
            != 32747u64 || xra32(agf, 60) != 0u64 || xra32(agfl, 0) != 1480672844u64 || xra32(agfl, 4) != 0u64
            || !xra_lsn(xra64(agfl, 24), head, 131072u64) || !xra_crc(agfl, 32)) {
            return false;
        }
        i64 at = 0;
        while (at < 16) {
            if (agfl.at(8 + at) != sb.at(32 + at)) {
                return false;
            }
            at = at + 1;
        }
        at = 0;
        while (at < 119) {
            u64 expected = 4294967295u64;
            if (at >= 1 && at <= 4) {
                expected = u64(at) + 4u64;
            }
            if (xra32(agfl, 36 + at * 4) != expected) {
                return false;
            }
            at = at + 1;
        }
        return true;
    }
    // kind1/2: complete BNOBT/CNTBT leaves at LBAs8/16. kind3/4:
    // complete INOBT/FINOBT leaves at LBAs24/32. CRC includes all 4096 bytes.
    auto inspect_xfs_mounted_leaf(builtin::span<const u8> sb, builtin::span<const u8> leaf, u64 kind,
        u64 head) -> bool {
        if (!xma_profile(sb, head) || leaf.size() != 4096 || kind < 1u64 || kind > 4u64) {
            return false;
        }
        u64 magic = 1094857538u64;
        u64 records = 2u64;
        if (kind == 2u64) {
            magic = 1094857539u64;
        }
        if (kind == 3u64) {
            magic = 1229013555u64;
            records = 1u64;
        }
        if (kind == 4u64) {
            magic = 1179206195u64;
            records = 1u64;
        }
        const std::ByteReadResult level = std::read_be16(leaf, 4);
        const std::ByteReadResult count = std::read_be16(leaf, 6);
        if (xra32(leaf, 0) != magic || level.value_or(1u64) != 0u64 || count.value_or(0u64) != records || xra32(leaf, 8)
            != 4294967295u64 || xra32(leaf, 12) != 4294967295u64 || xra64(leaf, 16) != kind * 8u64
            || !xra_lsn(xra64(leaf, 24), head, 131072u64) || xra32(leaf, 48) != 0u64 || !xra_crc(leaf, 52)) {
            return false;
        }
        i64 at = 0;
        while (at < 16) {
            if (leaf.at(32 + at) != sb.at(32 + at)) {
                return false;
            }
            at = at + 1;
        }
        if (kind <= 2u64) {
            // Both orderings coincide for this exact pair. These complete
            // free extents exclude data9/20 and inode chunk12..19.
            if (xra32(leaf, 56) != 10u64 || xra32(leaf, 60) != 2u64 || xra32(leaf, 64) != 21u64 || xra32(leaf, 68)
                != 32747u64) {
                return false;
            }
        } else {
            // Exactly inodes96..100 allocated; remaining59 bits free. The
            // complete64-inode chunk occupies eight blocks12..19.
            if (xra32(leaf, 56) != 96u64 || xra32(leaf, 60) != 59u64 || xra64(leaf, 64) != 18446744073709551584u64) {
                return false;
            }
        }
        return xra_zero(leaf, 72, 4096);
    }
    auto inspect_xfs_mounted_empty_inode(builtin::span<const u8> sb, builtin::span<const u8> home, u64 inode,
        u64 head) -> bool {
        if (!xma_profile(sb, head) || home.size() != 512 || (inode != 97u64 && inode != 98u64)) {
            return false;
        }
        const std::ByteReadResult magic = std::read_be16(home, 0);
        const std::ByteReadResult mode = std::read_be16(home, 2);
        const std::ByteReadResult flags = std::read_be16(home, 90);
        u64 expected_flags = 0u64;
        if (inode == 97u64) {
            expected_flags = 4u64;
        }
        if (magic.value_or(0u64) != 18766u64 || mode.value_or(0u64) != 32768u64 || home.at(4) != 3u8 || home.at(5)
            != 2u8 || xra64(home, 152) != inode || !xra_crc(home, 100) || !xra_lsn(xra64(home, 112), head, 131072u64)
            || xra32(home, 16) != 1u64 || !xra_zero(home, 8, 16) || !xra_zero(home, 24, 32) || !xra_zero(home, 56, 83)
            || home.at(83) != 2u8 || flags.value_or(65536u64) != expected_flags || !xra_zero(home, 120, 144)
            || !xra_zero(home, 176, 512)) {
            return false;
        }
        i64 at = 0;
        while (at < 16) {
            if (home.at(160 + at) != sb.at(32 + at)) {
                return false;
            }
            at = at + 1;
        }
        return true;
    }
}
