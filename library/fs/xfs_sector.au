        i64 offset = 0;
        while (offset < 512) {
            const std::ByteReadResult byte = sector.read_byte(offset);
            bytes[offset] = u8(byte.value_or(0u64));
            offset = offset + 1;
        }
        const XfsGeometryReport geometry = inspect_xfs_v5_512_geometry(borrow_bytes(bytes));
        if (geometry.status() != XfsGeometryStatus::header_geometry_consistent) {
            const XfsSectorHeaderReport failure = XfsSectorHeaderReport(XfsSectorHeaderStatus::geometry_rejected,
                storage::SectorIoStatus::success, geometry);
            return failure;
        }
        const XfsGeometryFacts facts = geometry.facts();
        const XfsDataFacts data = facts.data();
        if (data.claimed_data_sectors() > source.sector_count()) {
            const XfsSectorHeaderReport failure = XfsSectorHeaderReport(XfsSectorHeaderStatus::source_too_small,
                storage::SectorIoStatus::success, geometry);
            return failure;
        }
        const XfsSectorHeaderReport result = XfsSectorHeaderReport(XfsSectorHeaderStatus::header_fits_source,
            storage::SectorIoStatus::success, geometry);
        return result;
    }
