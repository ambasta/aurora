export module storage.ram_sector;
import std.binary;
import std.binary_buffer;
import storage.sector;
import storage.block_io;

export namespace storage {
    class RamSectorDevice {
        Sector512 payload;
        bool locked;
    public:
        RamSectorDevice(Sector512 initial) : payload(initial), locked(false) {}

        auto geometry() const -> SectorGeometry {
            const SectorGeometry result = SectorGeometry(1u64, !locked);
            return result;
        }

        auto read_sector(i64 index) const -> SectorReadResult {
            if (index < 0 || index >= 1) {
                const Sector512 zero = Sector512();
                const SectorReadResult failure = SectorReadResult(SectorIoStatus::out_of_range, zero);
                return failure;
            }
            const Sector512 sector = payload;
            const SectorReadResult result = SectorReadResult(SectorIoStatus::success, sector);
            return result;
        }

        auto write_sector(i64 index, Sector512 sector) -> SectorIoStatus {
            if (index < 0 || index >= 1) {
                return SectorIoStatus::out_of_range;
            }
            if (locked) {
                return SectorIoStatus::read_only;
            }
            payload = sector;
            return SectorIoStatus::success;
        }

        auto make_read_only() -> SectorIoStatus {
            locked = true;
            return SectorIoStatus::success;
        }

        auto flush(SectorFlushMode mode) const -> SectorFlushStatus {
            if (mode == SectorFlushMode::durable) {
                return SectorFlushStatus::unsupported;
            }
            return SectorFlushStatus::volatile_complete;
        }
    };
}
