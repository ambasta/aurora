export module storage.block;

export namespace storage {
    enum class BlockStatus { success, out_of_range };

    class BlockByteResult {
        BlockStatus outcome;
        u8 payload;
    public:
        BlockByteResult(BlockStatus status, u8 value) : outcome(status), payload(value) {}

        auto status() const -> BlockStatus {
            return outcome;
        }

        auto value_or(u8 fallback) const -> u8 {
            if (outcome == BlockStatus::success) {
                return payload;
            }
            return fallback;
        }
    };

    class Block64 {
        builtin::array<u64, 8> words;
    public:
        Block64() : words{} {}

        auto size() const -> i64 {
            return 64;
        }

        auto read_byte(i64 offset) const -> BlockByteResult {
            if (offset < 0) {
                const BlockByteResult failure = BlockByteResult(BlockStatus::out_of_range, 0u8);
                return failure;
            }
            if (offset >= 64) {
                const BlockByteResult failure = BlockByteResult(BlockStatus::out_of_range, 0u8);
                return failure;
            }
            const i64 shift = (offset % 8) * 8;
            const u8 value = u8((words[offset / 8] >> shift) & 255u64);
            const BlockByteResult result = BlockByteResult(BlockStatus::success, value);
            return result;
        }

        auto write_byte(i64 offset, u8 value) -> BlockStatus {
            if (offset < 0) {
                return BlockStatus::out_of_range;
            }
            if (offset >= 64) {
                return BlockStatus::out_of_range;
            }
            const i64 slot = offset / 8;
            const i64 shift = (offset % 8) * 8;
            const u64 mask = 255u64 << shift;
            words[slot] = (words[slot] & ~mask) | (u64(value) << shift);
            return BlockStatus::success;
        }
    };

    class BlockReadResult {
        BlockStatus outcome;
        Block64 payload;
    public:
        BlockReadResult(BlockStatus status, Block64 block) : outcome(status), payload(block) {}

        auto status() const -> BlockStatus {
            return outcome;
        }

        auto block_or_zero() const -> Block64 {
            if (outcome == BlockStatus::success) {
                const Block64 result = payload;
                return result;
            }
            const Block64 zero = Block64();
            return zero;
        }
    };
}
