module storage_fields_example;
import std.binary;
import std.checksum;

auto main() -> i64 {
    const builtin::array<u8, 9> message = {
        49u8,
        50u8,
        51u8,
        52u8,
        53u8,
        54u8,
        55u8,
        56u8,
        57u8
    };
    const std::ChecksumResult checksum = std::crc32c(borrow_bytes(message), 0, 9);
    if (checksum.status() != std::ChecksumStatus::success) {
        return 1;
    }
    if (checksum.value_or(0u64) != 3808858755u64) {
        return 2;
    }
    const builtin::array<u8, 8> field = {
        0u8,
        0u8,
        0u8,
        0u8,
        0u8,
        0u8,
        0u8,
        42u8
    };
    const std::ByteReadResult value = std::read_be64(borrow_bytes(field), 0);
    if (value.status() != std::ByteReadStatus::success) {
        return 3;
    }
    return i64(value.value_or(0u64));
}
