module utf8_example;
import std.utf8;

auto test() -> i64 {
    // ASCII 'A', EURO SIGN, and GRINNING FACE are three scalars in eight bytes.
    const array<u8, 8> text = {
        u8(65),
        u8(226),
        u8(130),
        u8(172),
        u8(240),
        u8(159),
        u8(152),
        u8(128)
    };
    const std::Utf8ValidationResult valid = std::validate_utf8(borrow_bytes(text), 0, 8, true);
    if (valid.status() != std::Utf8Status::success) {
        return 1;
    }
    if (valid.scalar_count() != 3) {
        return 2;
    }
    const std::Utf8DecodeResult euro = std::decode_utf8(borrow_bytes(text), 1, 3, true);
    if (euro.scalar_or(0u64) != 8364u64) {
        return 3;
    }
    return 42;
}
