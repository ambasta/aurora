module ram_sector_record_example;
import std.binary;
import std.binary_writer;
import storage.block;
import storage.block_codec;
import storage.sector;
import storage.block_io;
import storage.ram_sector;

// A volume-header round trip through a one-sector volatile RAM device.
// This illustrates a wire format, not a filesystem mount or persistent write.
auto main() -> i64 {
    storage::RamSectorDevice device = storage::RamSectorDevice();
    const storage::SectorGeometry geometry = device.geometry();
    storage::Sector512 sector = storage::Sector512();
    std::BinaryWriter64 header = std::BinaryWriter64();
    if (header.write_be32(0, 1096110641u64) != std::ByteWriteStatus::success) {
        return 1;
    }
    if (header.write_le16(4, 1u64) != std::ByteWriteStatus::success) {
        return 2;
    }
    if (header.write_le16(6, geometry.sector_size_bytes()) != std::ByteWriteStatus::success) {
        return 3;
    }
    if (header.write_le64(8, geometry.sector_count()) != std::ByteWriteStatus::success) {
        return 4;
    }
    if (header.write_le64(16, 0u64) != std::ByteWriteStatus::success) {
        return 5;
    }
    const storage::Block64 header_block = storage::block_from_writer(header);
    if (sector.write_window(0, header_block) != storage::BlockStatus::success) {
        return 6;
    }
    std::BinaryWriter64 trailer = std::BinaryWriter64();
    if (trailer.write_be16(62, 21930u64) != std::ByteWriteStatus::success) {
        return 7;
    }
    const storage::Block64 trailer_block = storage::block_from_writer(trailer);
    if (sector.write_window(448, trailer_block) != storage::BlockStatus::success) {
        return 8;
    }
    if (device.write_sector(0, sector) != storage::SectorIoStatus::success) {
        return 9;
    }
    if (device.flush(storage::SectorFlushMode::visibility) != storage::SectorFlushStatus::volatile_complete ||
        device.flush(storage::SectorFlushMode::durable) != storage::SectorFlushStatus::unsupported) {
        return 10;
    }
    const storage::SectorReadResult saved = device.read_sector(0);
    if (saved.status() != storage::SectorIoStatus::success) {
        return 11;
    }
    const storage::Sector512 zero_sector = storage::Sector512();
    if (device.write_sector(0, zero_sector) != storage::SectorIoStatus::success) {
        return 12;
    }
    const storage::Sector512 read_sector = saved.sector_or_zero();
    const storage::BlockReadResult saved_header = read_sector.read_window(0);
    const storage::BlockReadResult saved_trailer = read_sector.read_window(448);
    if (saved_header.status() != storage::BlockStatus::success ||
        saved_trailer.status() != storage::BlockStatus::success) {
        return 13;
    }
    const storage::Block64 zero = storage::Block64();
    if (sector.write_window(0, zero) != storage::BlockStatus::success) {
        return 14;
    }
    const storage::Block64 snapshot = saved_header.block_or_zero();
    const std::BinaryWriter64 bytes = storage::writer_from_block(snapshot);
    const builtin::array<u8, 24> record = {
        bytes.at(0), bytes.at(1), bytes.at(2), bytes.at(3), bytes.at(4), bytes.at(5),
        bytes.at(6), bytes.at(7), bytes.at(8), bytes.at(9), bytes.at(10), bytes.at(11),
        bytes.at(12), bytes.at(13), bytes.at(14), bytes.at(15), bytes.at(16), bytes.at(17),
        bytes.at(18), bytes.at(19), bytes.at(20), bytes.at(21), bytes.at(22), bytes.at(23)
    };
    const std::ByteReadResult magic = std::read_be32(borrow_bytes(record), 0);
    const std::ByteReadResult version = std::read_le16(borrow_bytes(record), 4);
    const std::ByteReadResult sector_bytes = std::read_le16(borrow_bytes(record), 6);
    const std::ByteReadResult sector_count = std::read_le64(borrow_bytes(record), 8);
    const std::ByteReadResult root = std::read_le64(borrow_bytes(record), 16);
    if (magic.value_or(0u64) != 1096110641u64 || version.value_or(0u64) != 1u64 ||
        sector_bytes.value_or(0u64) != 512u64 || sector_count.value_or(0u64) != 1u64) {
        return 15;
    }
    const storage::Block64 tail = saved_trailer.block_or_zero();
    const std::BinaryWriter64 tail_bytes = storage::writer_from_block(tail);
    const builtin::array<u8, 2> signature = {tail_bytes.at(62), tail_bytes.at(63)};
    const std::ByteReadResult marker = std::read_be16(borrow_bytes(signature), 0);
    if (marker.value_or(0u64) != 21930u64 || root.value_or(1u64) != 0u64) {
        return 16;
    }
    return 42;
}
