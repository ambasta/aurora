module json_codecs_example;
import std.json;
import std.json_read;
import std.json_write;
import std.utf8;
import std.array;
import std.binary;
import std.byte_buffer;

// Hosted composition over existing storage; no new string representation.
auto json_codecs_example(builtin::ByteRegion region, i64 initial_capacity, i64 observation) -> i64 {
    const builtin::array<u8, 31> source = {
        34u8,
        65u8,
        92u8,
        117u8,
        48u8,
        48u8,
        48u8,
        48u8,
        92u8,
        110u8,
        92u8,
        47u8,
        92u8,
        34u8,
        92u8,
        92u8,
        195u8,
        169u8,
        92u8,
        117u8,
        68u8,
        56u8,
        51u8,
        68u8,
        92u8,
        117u8,
        68u8,
        69u8,
        48u8,
        48u8,
        34u8
    };
    const builtin::span<const u8> input = borrow_bytes(source);
    builtin::OwnedBytes decoded_owner = region.try_allocate(initial_capacity);
    std::ByteBuffer decoded = std::ByteBuffer(region, move(decoded_owner));
    builtin::OwnedBytes escaped_owner = region.try_allocate(initial_capacity);
    std::ByteBuffer output = std::ByteBuffer(region, move(escaped_owner));
    if (!decoded.ok() || !output.ok()) {
        return -4;
    }
    const std::JsonStringReadResult result = std::append_decoded_json_string(decoded, input, 0, input.size());
    if (result.status() != std::JsonStringReadStatus::success) {
        return -5;
    }
    {
        const builtin::span<const u8> text = decoded.bytes();
        const std::JsonStringAppendResult written = std::append_json_string(output, text, 0, text.size());
        if (written.status() != std::JsonStringAppendStatus::success) {
            return -5;
        }
    }
    // Accepted receiver-bound views expose logical bytes, never spare capacity.
    {
        const builtin::span<const u8> wire = output.bytes();
        const std::JsonResult valid = std::validate_json(wire, 0, wire.size());
        if (valid.status() != std::JsonStatus::success) {
            return -100;
        }
        const builtin::span<const u8> text = decoded.bytes();
        const std::Utf8ValidationResult utf8_valid = std::validate_utf8(text, 0, text.size(), true);
        if (utf8_valid.status() != std::Utf8Status::success) {
            return -101;
        }
    }
    if (observation == -1) {
        return decoded.size();
    }
    if (observation == -2) {
        return output.size();
    }
    if (observation < 0) {
        return 256;
    }
    if (observation < decoded.size()) {
        const std::ByteReadResult byte = decoded.read_u8(observation);
        return i64(byte.value_or(256u64));
    }
    const std::ByteReadResult byte = output.read_u8(observation - decoded.size());
    return i64(byte.value_or(256u64));
}
