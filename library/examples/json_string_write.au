module json_string_write_example;
import std.json_write;
import std.byte_buffer;
import std.binary;
import std.json;
import std.utf8_text;
import std.utf8;
import std.array;

// Compose distinct runtime-sized owners sharing one region. Build ["..."] and
// validate the small complete JSON document after the output borrow has ended.
auto json_string_write_example(builtin::ByteRegion region, i64 initial_capacity, i64 observation) -> i64 {
    builtin::OwnedBytes source = region.try_allocate(9);
    std::Utf8Text text = std::Utf8Text(region, move(source));
    const array<u8, 5> prefix = {
        65u8,
        0u8,
        10u8,
        34u8,
        92u8
    };
    const builtin::span<const u8> input = borrow_bytes(prefix);
    if (text.try_initialize(input) != std::Utf8TextStatus::success) {
        return -1;
    }
    if (text.try_append_scalar(128512u64) != std::Utf8TextStatus::success) {
        return -1;
    }
    builtin::OwnedBytes allocation = region.try_allocate(initial_capacity);
    std::ByteBuffer output = std::ByteBuffer(region, move(allocation));
    if (!output.try_append(91u8)) {
        return -2;
    }
    const std::JsonStringAppendStatus appended = std::append_json_text(output, text);
    if (appended != std::JsonStringAppendStatus::success) {
        return -3;
    }
    if (!output.try_append(93u8)) {
        return -4;
    }
    const builtin::span<const u8> document = output.bytes();
    const std::JsonResult validated = std::validate_json(document, 0, document.size());
    if (validated.status() != std::JsonStatus::success) {
        return -5;
    }
    if (observation == -1) {
        return document.size() - 2;
    }
    if (observation == -2) {
        return document.size();
    }
    const std::ByteReadResult byte = output.read_u8(observation);
    return i64(byte.value_or(256u64));
}
