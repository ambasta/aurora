module json_example;
import std.json;

auto answer() -> i64 {
    const builtin::array<u8, 11> bytes = {
        123u8,
        34u8,
        111u8,
        107u8,
        34u8,
        58u8,
        116u8,
        114u8,
        117u8,
        101u8,
        125u8
    };
    const builtin::span<const u8> input = borrow_bytes(bytes);
    const std::JsonResult result = std::validate_json(input, 0, 11);
    if (result.status() != std::JsonStatus::success || result.token_count() != 5 || result.max_depth() != 1) {
        return 0;
    }
    return 42;
}
