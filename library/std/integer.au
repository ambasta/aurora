export module std.integer;

export namespace std {
    class DivResult {
        i64 quotient;
        i64 remainder;
    public:
        DivResult(i64 numerator, i64 denominator) : quotient(numerator / denominator), remainder(numerator
            % denominator) {
        }
        auto quot() const -> i64 {
            return quotient;
        }
        auto rem() const -> i64 {
            return remainder;
        }
    };

    auto div(i64 numerator, i64 denominator) -> DivResult {
        const DivResult result = DivResult(numerator, denominator);
        return result;
    }

    auto gcd(i64 a, i64 b) -> i64 {
        i64 left = a;
        i64 right = b;
        while (right != 0) {
            const i64 remainder = left % right;
            left = right;
            right = remainder;
        }
        if (left < 0) {
            return -left;
        }
        return left;
    }

    auto lcm(i64 a, i64 b) -> i64 {
        if (a == 0) {
            return 0;
        }
        if (b == 0) {
            return 0;
        }
        const i64 factor = gcd(a, b);
        const i64 product =(a / factor) * b;
        if (product < 0) {
            return -product;
        }
        return product;
    }
}
