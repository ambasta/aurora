export module std.decimal;
import std.array;
import std.decimal_digits;

export namespace std {
    // Keep the public scalar projections available to direct std.decimal imports.
    auto format_decimal_width_u64(u64 value) -> i64 {
        return std_decimal::width_u64(value);
    }
    auto format_decimal_digit_at_u64(u64 value, i64 place) -> u8 {
        return std_decimal::digit_at_u64(value, place);
    }

    enum class DecimalStatus {
        success,
        empty,
        invalid_digit,
        out_of_range
    };

    class DecimalResult {
        DecimalStatus outcome;
        u64 value;
        i64 offset;
    public:
        DecimalResult(DecimalStatus status, u64 number, i64 position) : outcome(status), value(number),
            offset(position) {
        }

        auto status() const -> DecimalStatus {
            return outcome;
        }
        auto position() const -> i64 {
            return offset;
        }
        auto value_or(u64 fallback) const -> u64 {
            if (outcome == DecimalStatus::success) {
                return value;
            }
            return fallback;
        }
    };

    class DecimalAccumulator {
        DecimalStatus outcome;
        u64 value;
        i64 digits;
    public:
        DecimalAccumulator() : outcome(DecimalStatus::empty), value(0u64), digits(0) {
        }

        auto push_digit(u64 digit) -> DecimalStatus {
            if (outcome != DecimalStatus::empty) {
                if (outcome != DecimalStatus::success) {
                    return outcome;
                }
            }
            if (digit > 9u64) {
                outcome = DecimalStatus::invalid_digit;
                return outcome;
            }
            if (digits == 9223372036854775807) {
                outcome = DecimalStatus::out_of_range;
                return outcome;
            }
            if (value > (18446744073709551615u64 - digit) / 10u64) {
                outcome = DecimalStatus::out_of_range;
                return outcome;
            }
            value = value * 10u64 + digit;
            digits = digits + 1;
            outcome = DecimalStatus::success;
            return outcome;
        }

        auto reset() -> DecimalStatus {
            outcome = DecimalStatus::empty;
            value = 0u64;
            digits = 0;
            return outcome;
        }

        auto finish() const -> DecimalResult {
            u64 number = 0u64;
            if (outcome == DecimalStatus::success) {
                number = value;
            }
            const DecimalResult result = DecimalResult(outcome, number, digits);
            return result;
        }
    };
}

export namespace std {
    enum class DecimalEncodingStatus {
        success,
        invalid_shape
    };

    // Twenty bounds one encoded i64 or u64 mathematically; this is not a string.
    class DecimalEncodingResult {
        std::array<u8, 20> payload;
        i64 width;
    public:
        DecimalEncodingResult(std::array<u8, 20> bytes, i64 count) : payload(bytes), width(count) {
        }
        auto status() const -> DecimalEncodingStatus {
            if (width < 1 || width > 20) {
                return DecimalEncodingStatus::invalid_shape;
            }
            return DecimalEncodingStatus::success;
        }
        auto size() const -> i64 {
            if (status() != DecimalEncodingStatus::success) {
                return 0;
            }
            return width;
        }
        auto byte_or(i64 index, u8 fallback) const -> u8 {
            if (status() != DecimalEncodingStatus::success || index < 0 || index >= width) {
                return fallback;
            }
            return payload.at(index);
        }
    };
}
namespace std {
    auto decimal_encoding(u64 magnitude, bool negative) -> DecimalEncodingResult {
        std::array<u8, 20> bytes = std::array<u8, 20>();
        if (negative && magnitude > 9223372036854775808u64) {
            const DecimalEncodingResult result = DecimalEncodingResult(bytes, 0);
            return result;
        }
        u64 remaining = magnitude;
        i64 width = 0;
        bool more = true;
        while (more) {
            bytes.set(width, u8(48u64 + remaining % 10u64));
            width = width + 1;
            remaining = remaining / 10u64;
            more = remaining != 0u64;
        }
        if (negative && magnitude != 0u64) {
            bytes.set(width, 45u8);
            width = width + 1;
        }
        i64 left = 0;
        i64 right = width - 1;
        while (left < right) {
            const u8 saved = bytes.at(left);
            bytes.set(left, bytes.at(right));
            bytes.set(right, saved);
            left = left + 1;
            right = right - 1;
        }
        const DecimalEncodingResult result = DecimalEncodingResult(bytes, width);
        return result;
    }
}
export namespace std {
    auto format_decimal_u64(u64 value) -> DecimalEncodingResult {
        const DecimalEncodingResult result = decimal_encoding(value, false);
        return result;
    }
    auto format_decimal_i64(i64 value) -> DecimalEncodingResult {
        u64 magnitude = 0u64;
        const bool negative = value < 0;
        if (negative) {
            // -(MIN + 1) fits i64; the final addition occurs in u64.
            magnitude = u64(-(value + 1)) + 1u64;
        } else {
            magnitude = u64(value);
        }
        const DecimalEncodingResult result = decimal_encoding(magnitude, negative);
        return result;
    }
}
