export module std.binary;

export namespace std {
    enum class ByteReadStatus {
        success,
        out_of_range
    };

    class ByteReadResult {
        ByteReadStatus outcome;
        u64 value;
    public:
        ByteReadResult(ByteReadStatus status, u64 number) : outcome(status), value(number) {
        }
        auto status() const -> ByteReadStatus {
            return outcome;
        }
        auto value_or(u64 fallback) const -> u64 {
            if (outcome == ByteReadStatus::success) {
                return value;
            }
            return fallback;
        }
    };

    auto read_le32(builtin::span<const u8> bytes, i64 offset) -> ByteReadResult {
        if (offset < 0) {
            const ByteReadResult failure = ByteReadResult(ByteReadStatus::out_of_range, 0u64);
            return failure;
        }
        if (bytes.size() < 4) {
            const ByteReadResult failure = ByteReadResult(ByteReadStatus::out_of_range, 0u64);
            return failure;
        }
        if (offset > bytes.size() - 4) {
            const ByteReadResult failure = ByteReadResult(ByteReadStatus::out_of_range, 0u64);
            return failure;
        }
        const u64 value = u64(bytes.at(offset)) | (u64(bytes.at(offset + 1)) << 8) | (u64(bytes.at(offset + 2)) << 16)
            | (u64(bytes.at(offset + 3)) << 24);
        const ByteReadResult result = ByteReadResult(ByteReadStatus::success, value);
        return result;
    }

    auto read_be32(builtin::span<const u8> bytes, i64 offset) -> ByteReadResult {
        if (offset < 0) {
            const ByteReadResult failure = ByteReadResult(ByteReadStatus::out_of_range, 0u64);
            return failure;
        }
        if (bytes.size() < 4) {
            const ByteReadResult failure = ByteReadResult(ByteReadStatus::out_of_range, 0u64);
            return failure;
        }
        if (offset > bytes.size() - 4) {
            const ByteReadResult failure = ByteReadResult(ByteReadStatus::out_of_range, 0u64);
            return failure;
        }
        const u64 value =(u64(bytes.at(offset)) << 24) | (u64(bytes.at(offset + 1)) << 16) | (u64(bytes.at(offset + 2))
            << 8) | u64(bytes.at(offset + 3));
        const ByteReadResult result = ByteReadResult(ByteReadStatus::success, value);
        return result;
    }
    auto read_le16(builtin::span<const u8> bytes, i64 offset) -> ByteReadResult {
        if (offset < 0) {
            const ByteReadResult failure = ByteReadResult(ByteReadStatus::out_of_range, 0u64);
            return failure;
        }
        if (bytes.size() < 2) {
            const ByteReadResult failure = ByteReadResult(ByteReadStatus::out_of_range, 0u64);
            return failure;
        }
        if (offset > bytes.size() - 2) {
            const ByteReadResult failure = ByteReadResult(ByteReadStatus::out_of_range, 0u64);
            return failure;
        }
        const u64 value = u64(bytes.at(offset)) | (u64(bytes.at(offset + 1)) << 8);
        const ByteReadResult result = ByteReadResult(ByteReadStatus::success, value);
        return result;
    }

    auto read_be16(builtin::span<const u8> bytes, i64 offset) -> ByteReadResult {
        if (offset < 0) {
            const ByteReadResult failure = ByteReadResult(ByteReadStatus::out_of_range, 0u64);
            return failure;
        }
        if (bytes.size() < 2) {
            const ByteReadResult failure = ByteReadResult(ByteReadStatus::out_of_range, 0u64);
            return failure;
        }
        if (offset > bytes.size() - 2) {
            const ByteReadResult failure = ByteReadResult(ByteReadStatus::out_of_range, 0u64);
            return failure;
        }
        const u64 value =(u64(bytes.at(offset)) << 8) | u64(bytes.at(offset + 1));
        const ByteReadResult result = ByteReadResult(ByteReadStatus::success, value);
        return result;
    }

    auto read_le64(builtin::span<const u8> bytes, i64 offset) -> ByteReadResult {
        if (offset < 0) {
            const ByteReadResult failure = ByteReadResult(ByteReadStatus::out_of_range, 0u64);
            return failure;
        }
        if (bytes.size() < 8) {
            const ByteReadResult failure = ByteReadResult(ByteReadStatus::out_of_range, 0u64);
            return failure;
        }
        if (offset > bytes.size() - 8) {
            const ByteReadResult failure = ByteReadResult(ByteReadStatus::out_of_range, 0u64);
            return failure;
        }
        const u64 value = u64(bytes.at(offset)) | (u64(bytes.at(offset + 1)) << 8) | (u64(bytes.at(offset + 2)) << 16)
            | (u64(bytes.at(offset + 3)) << 24) | (u64(bytes.at(offset + 4)) << 32) | (u64(bytes.at(offset + 5)) << 40)
            | (u64(bytes.at(offset + 6)) << 48) | (u64(bytes.at(offset + 7)) << 56);
        const ByteReadResult result = ByteReadResult(ByteReadStatus::success, value);
        return result;
    }

    auto read_be64(builtin::span<const u8> bytes, i64 offset) -> ByteReadResult {
        if (offset < 0) {
            const ByteReadResult failure = ByteReadResult(ByteReadStatus::out_of_range, 0u64);
            return failure;
        }
        if (bytes.size() < 8) {
            const ByteReadResult failure = ByteReadResult(ByteReadStatus::out_of_range, 0u64);
            return failure;
        }
        if (offset > bytes.size() - 8) {
            const ByteReadResult failure = ByteReadResult(ByteReadStatus::out_of_range, 0u64);
            return failure;
        }
        const u64 value =(u64(bytes.at(offset)) << 56) | (u64(bytes.at(offset + 1)) << 48) | (u64(bytes.at(offset + 2))
            << 40) | (u64(bytes.at(offset + 3)) << 32) | (u64(bytes.at(offset + 4)) << 24) | (u64(bytes.at(offset + 5))
            << 16) | (u64(bytes.at(offset + 6)) << 8) | u64(bytes.at(offset + 7));
        const ByteReadResult result = ByteReadResult(ByteReadStatus::success, value);
        return result;
    }
}
