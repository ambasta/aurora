export module std.bit;

export namespace std {
    auto popcount(u64 value) -> i64 {
        u64 remaining = value;
        i64 count = 0;
        while (remaining != 0u64) {
            remaining = remaining & (remaining - 1u64);
            count = count + 1;
        }
        return count;
    }

    auto bit_width(u64 value) -> i64 {
        u64 remaining = value;
        i64 width = 0;
        while (remaining != 0u64) {
            remaining = remaining >> 1;
            width = width + 1;
        }
        return width;
    }

    auto has_single_bit(u64 value) -> bool {
        if (value == 0u64) {
            return false;
        }
        return (value & (value - 1u64)) == 0u64;
    }
}
