export module std.binary_buffer;
import std.binary;
import std.bytes;

export namespace std {
    enum class ByteWriteStatus { success, out_of_range, value_out_of_range };

    class BinaryBuffer64 {
        builtin::array<u8, 64> elements;
    public:
        BinaryBuffer64() : elements{} {}

        auto size() const -> i64 {
            return 64;
        }

        auto at(i64 offset) const -> u8 {
            return elements[offset];
        }

        auto starts_with(builtin::span<const u8> prefix) const -> bool {
            if (prefix.size() > 64) { return false; }
            i64 index = 0;
            while (index < prefix.size()) {
                if (elements[index] != prefix.at(index)) { return false; }
                index = index + 1;
            }
            return true;
        }

        auto read_u8(i64 offset) const -> ByteReadResult {
            if (offset < 0 || offset >= 64) {
                const ByteReadResult failure = ByteReadResult(ByteReadStatus::out_of_range, 0u64);
                return failure;
            }
            const ByteReadResult result = ByteReadResult(ByteReadStatus::success, u64(elements[offset]));
            return result;
        }

        auto write_u8(i64 offset, u8 value) -> ByteWriteStatus {
            if (offset < 0) {
                return ByteWriteStatus::out_of_range;
            }
            if (offset >= 64) {
                return ByteWriteStatus::out_of_range;
            }
            elements[offset] = value;
            return ByteWriteStatus::success;
        }

        auto write_le16(i64 offset, u64 value) -> ByteWriteStatus {
            if (offset < 0) {
                return ByteWriteStatus::out_of_range;
            }
            if (offset > 62) {
                return ByteWriteStatus::out_of_range;
            }
            const Encode16Result encoded = encode_le16(value);
            if (encoded.status() != ByteCodecStatus::success) {
                return ByteWriteStatus::value_out_of_range;
            }
            const Bytes2 bytes = encoded.bytes_or_zero();
            i64 index = 0;
            while (index < 2) {
                elements[offset + index] = bytes.at(index);
                index = index + 1;
            }
            return ByteWriteStatus::success;
        }

        auto write_be16(i64 offset, u64 value) -> ByteWriteStatus {
            if (offset < 0) {
                return ByteWriteStatus::out_of_range;
            }
            if (offset > 62) {
                return ByteWriteStatus::out_of_range;
            }
            const Encode16Result encoded = encode_be16(value);
            if (encoded.status() != ByteCodecStatus::success) {
                return ByteWriteStatus::value_out_of_range;
            }
            const Bytes2 bytes = encoded.bytes_or_zero();
            i64 index = 0;
            while (index < 2) {
                elements[offset + index] = bytes.at(index);
                index = index + 1;
            }
            return ByteWriteStatus::success;
        }

        auto write_le32(i64 offset, u64 value) -> ByteWriteStatus {
            if (offset < 0) {
                return ByteWriteStatus::out_of_range;
            }
            if (offset > 60) {
                return ByteWriteStatus::out_of_range;
            }
            const Encode32Result encoded = encode_le32(value);
            if (encoded.status() != ByteCodecStatus::success) {
                return ByteWriteStatus::value_out_of_range;
            }
            const Bytes4 bytes = encoded.bytes_or_zero();
            i64 index = 0;
            while (index < 4) {
                elements[offset + index] = bytes.at(index);
                index = index + 1;
            }
            return ByteWriteStatus::success;
        }

        auto write_be32(i64 offset, u64 value) -> ByteWriteStatus {
            if (offset < 0) {
                return ByteWriteStatus::out_of_range;
            }
            if (offset > 60) {
                return ByteWriteStatus::out_of_range;
            }
            const Encode32Result encoded = encode_be32(value);
            if (encoded.status() != ByteCodecStatus::success) {
                return ByteWriteStatus::value_out_of_range;
            }
            const Bytes4 bytes = encoded.bytes_or_zero();
            i64 index = 0;
            while (index < 4) {
                elements[offset + index] = bytes.at(index);
                index = index + 1;
            }
            return ByteWriteStatus::success;
        }

        auto write_le64(i64 offset, u64 value) -> ByteWriteStatus {
            if (offset < 0) {
                return ByteWriteStatus::out_of_range;
            }
            if (offset > 56) {
                return ByteWriteStatus::out_of_range;
            }
            const Bytes8 bytes = encode_le64(value);
            i64 index = 0;
            while (index < 8) {
                elements[offset + index] = bytes.at(index);
                index = index + 1;
            }
            return ByteWriteStatus::success;
        }

        auto write_be64(i64 offset, u64 value) -> ByteWriteStatus {
            if (offset < 0) {
                return ByteWriteStatus::out_of_range;
            }
            if (offset > 56) {
                return ByteWriteStatus::out_of_range;
            }
            const Bytes8 bytes = encode_be64(value);
            i64 index = 0;
            while (index < 8) {
                elements[offset + index] = bytes.at(index);
                index = index + 1;
            }
            return ByteWriteStatus::success;
        }
    };
}
