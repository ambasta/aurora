    auto next_json_token(builtin::span<const u8> bytes, i64 offset, i64 count) -> JsonTokenResult {
        if (offset < 0 || count < 0 || offset > bytes.size()) {
            return json_failure(JsonStatus::invalid_window, 0);
        }
        if (count > bytes.size() - offset) {
            return json_failure(JsonStatus::invalid_window, 0);
        }
        if (count > 4096) {
            return json_failure(JsonStatus::input_limit, offset);
        }
        const i64 end = offset + count;
        i64 index = offset;
        while (index < end && json_space(bytes.at(index))) {
            index = index + 1;
        }
        if (index == end) {
            const JsonTokenResult result = JsonTokenResult(JsonStatus::end_of_input, JsonTokenKind::none, end, 0, count,
                0);
            return result;
        }
        const u8 byte = bytes.at(index);
        JsonTokenKind kind = JsonTokenKind::none;
        if (byte == 123u8) {
            kind = JsonTokenKind::left_brace;
        }
        if (byte == 125u8) {
            kind = JsonTokenKind::right_brace;
        }
        if (byte == 91u8) {
            kind = JsonTokenKind::left_bracket;
        }
        if (byte == 93u8) {
            kind = JsonTokenKind::right_bracket;
        }
        if (byte == 58u8) {
            kind = JsonTokenKind::colon;
        }
        if (byte == 44u8) {
            kind = JsonTokenKind::comma;
        }
        if (kind != JsonTokenKind::none) {
            return json_success(kind, index, 1, index - offset + 1);
        }
        if (byte == 34u8) {
            return json_string(bytes, index, end, offset);
        }
        if (byte == 45u8 || json_digit(byte)) {
            return json_number(bytes, index, end, offset);
        }
        if (byte == 116u8) {
            kind = JsonTokenKind::true_value;
        }
        if (byte == 102u8) {
            kind = JsonTokenKind::false_value;
        }
        if (byte == 110u8) {
            kind = JsonTokenKind::null_value;
        }
        if (kind != JsonTokenKind::none) {
            return json_literal(bytes, index, end, offset, kind);
        }
        return json_failure(JsonStatus::invalid_byte, index);
    }
}
namespace std {
    class JsonWalkRequest {
        i64 begin;
        i64 length;
        i64 key_begin;
        i64 key_length;
        i64 element;
        u8 operation;
    public:
        JsonWalkRequest(i64 offset, i64 count, i64 key_offset, i64 key_count, i64 index, u8 mode) : begin(offset),
            length(count), key_begin(key_offset), key_length(key_count), element(index), operation(mode) {
        }
        auto offset() const -> i64 {
            return begin;
        }
        auto count() const -> i64 {
            return length;
        }
        auto key_offset() const -> i64 {
            return key_begin;
        }
        auto key_count() const -> i64 {
            return key_length;
        }
        auto index() const -> i64 {
            return element;
        }
        auto mode() const -> u8 {
            return operation;
        }
    };
    // Copied internal observations only. Neither report carries source authority.
    class JsonWalkResult {
        JsonResult validated;
        JsonLookupResult selected;
    public:
        JsonWalkResult(JsonResult document, JsonLookupResult lookup) : validated(document), selected(lookup) {
        }
        auto document() const -> JsonResult {
            const JsonResult result = validated;
            return result;
        }
        auto lookup() const -> JsonLookupResult {
            const JsonLookupResult result = selected;
            return result;
        }
    };
    auto json_lookup_failure(JsonLookupStatus status, i64 error) -> JsonLookupResult {
        const JsonLookupResult result = JsonLookupResult(status, JsonValueKind::none, 0, 0, error);
        return result;
    }
    auto json_lookup_status(JsonStatus status) -> JsonLookupStatus {
        if (status == JsonStatus::success) {
            return JsonLookupStatus::success;
        }
        if (status == JsonStatus::input_limit) {
            return JsonLookupStatus::input_limit;
        }
        if (status == JsonStatus::invalid_byte) {
            return JsonLookupStatus::invalid_byte;
        }
        if (status == JsonStatus::invalid_string) {
            return JsonLookupStatus::invalid_string;
        }
        if (status == JsonStatus::invalid_number) {
            return JsonLookupStatus::invalid_number;
        }
        if (status == JsonStatus::invalid_literal) {
            return JsonLookupStatus::invalid_literal;
        }
        if (status == JsonStatus::truncated) {
            return JsonLookupStatus::truncated;
        }
        if (status == JsonStatus::number_limit) {
            return JsonLookupStatus::number_limit;
        }
        if (status == JsonStatus::token_limit) {
            return JsonLookupStatus::token_limit;
        }
        if (status == JsonStatus::depth_limit) {
            return JsonLookupStatus::depth_limit;
        }
        if (status == JsonStatus::invalid_structure) {
            return JsonLookupStatus::invalid_structure;
        }
        return JsonLookupStatus::invalid_window;
    }
    auto json_walk_failure(JsonStatus status, i64 error, i64 tokens, i64 peak) -> JsonWalkResult {
        const JsonResult document = JsonResult(status, error, tokens, peak);
        const JsonLookupResult lookup = json_lookup_failure(json_lookup_status(status), error);
        const JsonWalkResult result = JsonWalkResult(document, lookup);
        return result;
    }
    auto json_query_failure(JsonLookupStatus status, i64 error) -> JsonWalkResult {
        const JsonResult document = JsonResult(JsonStatus::invalid_window, 0, 0, 0);
        const JsonLookupResult lookup = json_lookup_failure(status, error);
        const JsonWalkResult result = JsonWalkResult(document, lookup);
        return result;
    }
    auto json_value_kind(JsonTokenKind kind) -> JsonValueKind {
        if (kind == JsonTokenKind::left_brace) {
            return JsonValueKind::object;
        }
        if (kind == JsonTokenKind::left_bracket) {
            return JsonValueKind::array_value;
        }
        if (kind == JsonTokenKind::string) {
            return JsonValueKind::string;
        }
        if (kind == JsonTokenKind::number) {
            return JsonValueKind::number;
        }
        if (kind == JsonTokenKind::true_value) {
            return JsonValueKind::true_value;
        }
        if (kind == JsonTokenKind::false_value) {
            return JsonValueKind::false_value;
        }
        if (kind == JsonTokenKind::null_value) {
            return JsonValueKind::null_value;
        }
        return JsonValueKind::none;
    }
    // Both windows have already been validated. Each cursor advances monotonically.
    auto json_key_equal(builtin::span<const u8> bytes, i64 offset, i64 count, builtin::span<const u8> key,
        i64 key_offset, i64 key_count) -> bool {
        i64 left = offset;
        i64 right = key_offset;
        const i64 end = offset + count;
        const i64 key_end = key_offset + key_count;
        while (left < end && right < key_end) {
            const JsonScalarResult a = json_scalar(bytes, left, end);
            const Utf8DecodeResult b = decode_utf8(key, right, key_end - right, true);
            if (a.status() != JsonStatus::success || b.status() != Utf8Status::success || a.scalar_or(0u64)
                != b.scalar_or(0u64)) {
                return false;
            }
            left = left + a.consumed_bytes();
            right = right + b.width();
        }
        return left == end && right == key_end;
    }
    auto json_walk(builtin::span<const u8> bytes, builtin::span<const u8> key,
        JsonWalkRequest request) -> JsonWalkResult {
        const i64 offset = request.offset();
        const i64 count = request.count();
        const i64 key_offset = request.key_offset();
        const i64 key_count = request.key_count();
        const i64 wanted = request.index();
        const u8 mode = request.mode();
        if (offset < 0 || count < 0 || offset > bytes.size()) {
            return json_walk_failure(JsonStatus::invalid_window, 0, 0, 0);
        }
        if (count > bytes.size() - offset) {
            return json_walk_failure(JsonStatus::invalid_window, 0, 0, 0);
        }
        if (count > 4096) {
            return json_walk_failure(JsonStatus::input_limit, offset, 0, 0);
        }
        // Document bounds and cap precede selector checks; no bytes read yet.
        if (mode == 1u8) {
            if (key_offset < 0 || key_count < 0 || key_offset > key.size()) {
                return json_query_failure(JsonLookupStatus::invalid_key_window, 0);
            }
            if (key_count > key.size() - key_offset) {
                return json_query_failure(JsonLookupStatus::invalid_key_window, 0);
            }
            if (key_count > 4096) {
                return json_query_failure(JsonLookupStatus::key_limit, key_offset);
            }
            i64 query_index = key_offset;
            const i64 query_end = key_offset + key_count;
            while (query_index < query_end) {
                const Utf8DecodeResult scalar = decode_utf8(key, query_index, query_end - query_index, true);
                if (scalar.status() != Utf8Status::success) {
                    i64 error = query_index;
                    if (scalar.status() == Utf8Status::truncated) {
                        error = query_end;
                    }
                    return json_query_failure(JsonLookupStatus::invalid_key, error);
                }
                query_index = query_index + scalar.width();
            }
        }
        if (mode == 2u8 && wanted < 0) {
            return json_query_failure(JsonLookupStatus::invalid_index, 0);
        }
        // Array: 1 initial value/end, 2 required value, 3 comma/end.
        // Object: 4 initial key/end, 5 required key, 6 colon, 7 value, 8 comma/end.
        std::array<u8, 32> states = std::array<u8, 32>();
        i64 depth = 0;
        i64 peak = 0;
        i64 tokens = 0;
        i64 index = offset;
        const i64 end = offset + count;
        JsonValueKind root_kind = JsonValueKind::none;
        JsonValueKind selected_kind = JsonValueKind::none;
        i64 selected_start = 0;
        i64 selected_count = 0;
        i64 matching_keys = 0;
        i64 duplicate_offset = 0;
        i64 element_index = 0;
        bool member_matches = false;
        bool selected_open = false;
        bool root_complete = false;
        bool scanning = true;
        while (scanning) {
            const JsonTokenResult token = next_json_token(bytes, index, end - index);
            if (token.status() == JsonStatus::end_of_input) {
                if (depth != 0 || !root_complete) {
                    return json_walk_failure(JsonStatus::truncated, end, tokens, peak);
                }
                const JsonResult document = JsonResult(JsonStatus::success, 0, tokens, peak);
                JsonLookupStatus outcome = JsonLookupStatus::success;
                i64 error = 0;
                if ((mode == 1u8 && root_kind != JsonValueKind::object) || (mode == 2u8 && root_kind
                    != JsonValueKind::array_value)) {
                    outcome = JsonLookupStatus::wrong_root;
                } else {
                    if (mode == 1u8 && matching_keys == 2) {
                        outcome = JsonLookupStatus::ambiguous;
                        error = duplicate_offset;
                    } else {
                        if (selected_kind == JsonValueKind::none) {
                            outcome = JsonLookupStatus::not_found;
