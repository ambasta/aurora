                bytes.set(0, 92u8);
                bytes.set(1, 117u8);
                bytes.set(2, 48u8);
                bytes.set(3, 48u8);
                bytes.set(4, u8(48u64 + scalar / 16u64));
                const u64 last = scalar % 16u64;
                u8 digit = u8(48u64 + last);
                if (last >= 10u64) {
                    digit = u8(87u64 + last);
                }
                bytes.set(5, digit);
                width = 6;
            } else {
