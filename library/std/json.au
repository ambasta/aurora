export module std.json;
import std.utf8;
import std.array;

export namespace std {
    enum class JsonStatus {
        success,
        end_of_input,
        invalid_window,
        input_limit,
        invalid_byte,
        invalid_string,
        invalid_number,
        invalid_literal,
        truncated,
        number_limit,
        token_limit,
        depth_limit,
        invalid_structure
    };
    enum class JsonTokenKind {
        none,
        left_brace,
        right_brace,
        left_bracket,
        right_bracket,
        colon,
        comma,
        string,
        number,
        true_value,
        false_value,
        null_value
    };
    class JsonScalarResult {
        JsonStatus outcome;
        u64 scalar;
        i64 consumed;
        i64 error;
    public:
        JsonScalarResult(JsonStatus status, u64 value, i64 used, i64 position) : outcome(status), scalar(value),
            consumed(used), error(position) {
        }
        auto status() const -> JsonStatus {
            if (outcome == JsonStatus::invalid_window) {
                return outcome;
            }
            if (error < 0) {
                return JsonStatus::invalid_window;
            }
            if (outcome == JsonStatus::success) {
                if (scalar > 1114111u64 ||(scalar >= 55296u64 && scalar <= 57343u64) || consumed < 1 || consumed > 12 ||
                    error != 0) {
                    return JsonStatus::invalid_window;
                }
                return outcome;
            }
            if (scalar != 0u64 || consumed != 0) {
                return JsonStatus::invalid_window;
            }
            if (outcome == JsonStatus::end_of_input) {
                if (error != 0) {
                    return JsonStatus::invalid_window;
                }
                return outcome;
            }
            if (outcome == JsonStatus::invalid_string || outcome == JsonStatus::truncated) {
                return outcome;
            }
            return JsonStatus::invalid_window;
        }
        auto scalar_or(u64 fallback) const -> u64 {
            if (status() != JsonStatus::success) {
                return fallback;
            }
            return scalar;
        }
        auto consumed_bytes() const -> i64 {
            if (status() != JsonStatus::success) {
                return 0;
            }
            return consumed;
        }
        auto error_offset() const -> i64 {
            if (status() == JsonStatus::invalid_window) {
                return 0;
            }
            return error;
        }
    };
    enum class JsonEscapeStatus {
        success,
        invalid_scalar
    };
    class JsonEscapeResult {
        JsonEscapeStatus outcome;
        std::array<u8, 6> payload;
        i64 width;
    public:
        JsonEscapeResult(JsonEscapeStatus status, std::array<u8, 6> bytes, i64 count) : outcome(status), payload(bytes),
            width(count) {
        }
        auto status() const -> JsonEscapeStatus {
            if (outcome != JsonEscapeStatus::success || width < 1 || width > 6) {
                return JsonEscapeStatus::invalid_scalar;
            }
            return outcome;
        }
        auto size() const -> i64 {
            if (status() != JsonEscapeStatus::success) {
                return 0;
            }
            return width;
        }
        auto byte_or(i64 index, u8 fallback) const -> u8 {
            if (status() != JsonEscapeStatus::success || index < 0 || index >= width) {
                return fallback;
            }
            const std::array<u8, 6> bytes = payload;
            return bytes.at(index);
        }
    };
    class JsonTokenResult {
        JsonStatus outcome;
        JsonTokenKind category;
        i64 offset;
        i64 length;
        i64 consumed;
        i64 error;
    public:
        JsonTokenResult(JsonStatus status, JsonTokenKind kind, i64 start, i64 count, i64 used, i64 position) : outcome(
            status), category(kind), offset(start), length(count), consumed(used), error(position) {
        }
        auto status() const -> JsonStatus {
            if (outcome == JsonStatus::invalid_window) {
                return outcome;
            }
            if (offset < 0 || length < 0 || length > 4096 || consumed < 0 || consumed > 4096 || error < 0) {
                return JsonStatus::invalid_window;
            }
            if (length > 9223372036854775807 - offset) {
                return JsonStatus::invalid_window;
            }
            if (outcome == JsonStatus::success || outcome == JsonStatus::end_of_input) {
                if (error != 0 || consumed < length || consumed - length > offset) {
                    return JsonStatus::invalid_window;
                }
                if (outcome == JsonStatus::success &&(category == JsonTokenKind::none || length == 0)) {
                    return JsonStatus::invalid_window;
                }
                if (outcome == JsonStatus::end_of_input &&(category != JsonTokenKind::none || length != 0)) {
                    return JsonStatus::invalid_window;
                }
                return outcome;
            }
            if (outcome == JsonStatus::token_limit || outcome == JsonStatus::depth_limit || outcome == JsonStatus::
                invalid_structure) {
                return JsonStatus::invalid_window;
            }
            if (category != JsonTokenKind::none || offset != 0 || length != 0 || consumed != 0) {
                return JsonStatus::invalid_window;
            }
            return outcome;
        }
        auto kind() const -> JsonTokenKind {
            if (status() != JsonStatus::success) {
                return JsonTokenKind::none;
            }
            return category;
        }
        auto byte_offset() const -> i64 {
            if (status() != JsonStatus::success && status() != JsonStatus::end_of_input) {
                return 0;
            }
            return offset;
        }
        auto byte_count() const -> i64 {
            if (status() != JsonStatus::success) {
                return 0;
            }
            return length;
        }
        auto consumed_bytes() const -> i64 {
            if (status() != JsonStatus::success && status() != JsonStatus::end_of_input) {
                return 0;
            }
            return consumed;
        }
        auto error_offset() const -> i64 {
            if (status() == JsonStatus::invalid_window) {
                return 0;
            }
            return error;
        }
    };
    class JsonResult {
        JsonStatus outcome;
        i64 error;
        i64 tokens;
        i64 peak;
    public:
        JsonResult(JsonStatus status, i64 position, i64 count, i64 depth) : outcome(status), error(position), tokens(
            count), peak(depth) {
        }
        auto status() const -> JsonStatus {
            if (outcome == JsonStatus::invalid_window || outcome == JsonStatus::end_of_input) {
                return JsonStatus::invalid_window;
            }
            if (error < 0 || tokens < 0 || tokens > 1024 || peak < 0 || peak > 32) {
                return JsonStatus::invalid_window;
            }
            if (outcome == JsonStatus::success &&(error != 0 || tokens == 0)) {
                return JsonStatus::invalid_window;
            }
            return outcome;
        }
        auto error_offset() const -> i64 {
            if (status() == JsonStatus::invalid_window) {
                return 0;
            }
            return error;
        }
        auto token_count() const -> i64 {
            if (status() == JsonStatus::invalid_window) {
                return 0;
            }
            return tokens;
        }
        auto max_depth() const -> i64 {
            if (status() == JsonStatus::invalid_window) {
                return 0;
            }
            return peak;
        }
    };
}
namespace std {
    auto json_space(u8 byte) -> bool {
        return byte == 9u8 || byte == 10u8 || byte == 13u8 || byte == 32u8;
    }
    auto json_digit(u8 byte) -> bool {
        return byte >= 48u8 && byte <= 57u8;
    }
    auto json_boundary(u8 byte) -> bool {
        return json_space(byte) || byte == 123u8 || byte == 125u8 || byte == 91u8 || byte == 93u8 || byte == 58u8 ||
            byte == 44u8;
    }
    auto json_hex(u8 byte) -> i64 {
        if (byte >= 48u8 && byte <= 57u8) {
            return i64(byte) - 48;
        }
        if (byte >= 65u8 && byte <= 70u8) {
            return i64(byte) - 55;
        }
        if (byte >= 97u8 && byte <= 102u8) {
            return i64(byte) - 87;
        }
        return -1;
    }
    auto json_failure(JsonStatus status, i64 position) -> JsonTokenResult {
        const JsonTokenResult result = JsonTokenResult(status, JsonTokenKind::none, 0, 0, 0, position);
        return result;
    }
    auto json_success(JsonTokenKind kind, i64 start, i64 count, i64 consumed) -> JsonTokenResult {
        const JsonTokenResult result = JsonTokenResult(JsonStatus::success, kind, start, count, consumed, 0);
        return result;
    }
    auto json_scalar_failure(JsonStatus status, i64 position) -> JsonScalarResult {
        const JsonScalarResult result = JsonScalarResult(status, 0u64, 0, position);
        return result;
    }
    // Internal nonempty, checked-window primitive shared by scanner and scalar reader.
    auto json_scalar(builtin::span<const u8> bytes, i64 start, i64 end) -> JsonScalarResult {
        i64 index = start;
        const u8 byte = bytes.at(index);
        if (byte < 32u8 || byte == 34u8) {
            const JsonScalarResult result = json_scalar_failure(JsonStatus::invalid_string, index);
            return result;
        }
        if (byte == 92u8) {
            const i64 escape = index;
            index = index + 1;
            if (index == end) {
                const JsonScalarResult result = json_scalar_failure(JsonStatus::truncated, end);
                return result;
            }
            const u8 code = bytes.at(index);
            if (code == 34u8 || code == 92u8 || code == 47u8 || code == 98u8 || code == 102u8 || code == 110u8 || code
                == 114u8 || code == 116u8) {
                u64 value = u64(code);
                if (code == 98u8) {
                    value = 8u64;
                }
                if (code == 102u8) {
                    value = 12u64;
                }
                if (code == 110u8) {
                    value = 10u64;
                }
                if (code == 114u8) {
                    value = 13u64;
                }
                if (code == 116u8) {
                    value = 9u64;
                }
                const JsonScalarResult result = JsonScalarResult(JsonStatus::success, value, 2, 0);
                return result;
            } else {
                if (code != 117u8) {
                    const JsonScalarResult result = json_scalar_failure(JsonStatus::invalid_string, index);
                    return result;
                }
                index = index + 1;
                i64 scalar = 0;
                i64 digit = 0;
                while (digit < 4) {
                    if (index == end) {
                        const JsonScalarResult result = json_scalar_failure(JsonStatus::truncated, end);
                        return result;
                    }
                    const i64 value = json_hex(bytes.at(index));
                    if (value < 0) {
                        const JsonScalarResult result = json_scalar_failure(JsonStatus::invalid_string, index);
                        return result;
                    }
                    scalar = scalar * 16 + value;
                    index = index + 1;
                    digit = digit + 1;
                }
                if (scalar >= 56320 && scalar <= 57343) {
                    const JsonScalarResult result = json_scalar_failure(JsonStatus::invalid_string, escape);
                    return result;
                }
                if (scalar >= 55296 && scalar <= 56319) {
                    // A surrogate code unit alone is never a scalar-valid string.
                    if (index == end) {
                        const JsonScalarResult result = json_scalar_failure(JsonStatus::truncated, end);
                        return result;
                    }
                    if (bytes.at(index) != 92u8) {
                        const JsonScalarResult result = json_scalar_failure(JsonStatus::invalid_string, escape);
                        return result;
                    }
                    index = index + 1;
                    if (index == end) {
                        const JsonScalarResult result = json_scalar_failure(JsonStatus::truncated, end);
                        return result;
                    }
                    if (bytes.at(index) != 117u8) {
                        const JsonScalarResult result = json_scalar_failure(JsonStatus::invalid_string, escape);
                        return result;
                    }
                    index = index + 1;
                    i64 low = 0;
                    digit = 0;
                    while (digit < 4) {
                        if (index == end) {
                            const JsonScalarResult result = json_scalar_failure(JsonStatus::truncated, end);
                            return result;
                        }
                        const i64 value = json_hex(bytes.at(index));
                        if (value < 0) {
                            const JsonScalarResult result = json_scalar_failure(JsonStatus::invalid_string, index);
                            return result;
                        }
                        low = low * 16 + value;
                        index = index + 1;
                        digit = digit + 1;
                    }
                    if (low < 56320 || low > 57343) {
                        const JsonScalarResult result = json_scalar_failure(JsonStatus::invalid_string, escape);
                        return result;
                    }
                    scalar = 65536 +(scalar - 55296) * 1024 + low - 56320;
                }
                const JsonScalarResult result = JsonScalarResult(JsonStatus::success, u64(scalar), index - start, 0);
                return result;
            }
        } else {
            if (byte < 128u8) {
                const JsonScalarResult result = JsonScalarResult(JsonStatus::success, u64(byte), 1, 0);
                return result;
            } else {
                const Utf8DecodeResult decoded = decode_utf8(bytes, index, end - index, true);
                if (decoded.status() == Utf8Status::truncated) {
                    const JsonScalarResult result = json_scalar_failure(JsonStatus::truncated, end);
                    return result;
                }
                if (decoded.status() != Utf8Status::success) {
                    const JsonScalarResult result = json_scalar_failure(JsonStatus::invalid_string, index);
                    return result;
                }
                const JsonScalarResult result = JsonScalarResult(JsonStatus::success, decoded.scalar_or(0u64), decoded.
                    width(), 0);
                return result;
            }
        }
    }
    auto json_string(builtin::span<const u8> bytes, i64 start, i64 end, i64 request) -> JsonTokenResult {
        i64 index = start + 1;
        while (index < end) {
            if (bytes.at(index) == 34u8) {
                const JsonTokenResult result = json_success(JsonTokenKind::string, start, index - start + 1, index -
                    request + 1);
                return result;
            }
            const JsonScalarResult decoded = json_scalar(bytes, index, end);
            if (decoded.status() != JsonStatus::success) {
                const JsonTokenResult result = json_failure(decoded.status(), decoded.error_offset());
                return result;
            }
            index = index + decoded.consumed_bytes();
        }
        const JsonTokenResult result = json_failure(JsonStatus::truncated, end);
        return result;
    }
    auto json_number(builtin::span<const u8> bytes, i64 start, i64 end, i64 request) -> JsonTokenResult {
        // States: start, minus, zero, integer, dot, fraction, exponent, sign, exponent digits.
        i64 state = 0;
        i64 index = start;
        bool scanning = true;
        while (index < end && scanning) {
            const u8 byte = bytes.at(index);
            if (json_boundary(byte)) {
                scanning = false;
            } else {
                i64 next = -1;
                if (state == 0 || state == 1) {
                    if (state == 0 && byte == 45u8) {
                        next = 1;
                    }
                    if (byte == 48u8) {
                        next = 2;
                    }
                    if (byte >= 49u8 && byte <= 57u8) {
                        next = 3;
                    }
                }
                if (state == 2 || state == 3) {
                    if (state == 3 && json_digit(byte)) {
                        next = 3;
                    }
                    if (byte == 46u8) {
                        next = 4;
                    }
                    if (byte == 101u8 || byte == 69u8) {
                        next = 6;
                    }
                }
                if (state == 4 || state == 5) {
                    if (json_digit(byte)) {
                        next = 5;
                    }
                    if (state == 5 &&(byte == 101u8 || byte == 69u8)) {
                        next = 6;
                    }
                }
                if (state == 6 || state == 7 || state == 8) {
                    if (json_digit(byte)) {
                        next = 8;
                    }
                    if (state == 6 &&(byte == 43u8 || byte == 45u8)) {
                        next = 7;
                    }
                }
                if (next < 0) {
                    const JsonTokenResult result = json_failure(JsonStatus::invalid_number, index);
                    return result;
                }
                if (index - start == 128) {
                    const JsonTokenResult result = json_failure(JsonStatus::number_limit, index);
                    return result;
                }
                state = next;
                index = index + 1;
            }
        }
        if (state != 2 && state != 3 && state != 5 && state != 8) {
            const JsonTokenResult result = json_failure(JsonStatus::invalid_number, index);
            return result;
        }
        const JsonTokenResult result = json_success(JsonTokenKind::number, start, index - start, index - request);
        return result;
    }
    auto json_literal(builtin::span<const u8> bytes, i64 start, i64 end, i64 request, JsonTokenKind kind) ->
        JsonTokenResult {
        i64 width = 4;
        if (kind == JsonTokenKind::false_value) {
            width = 5;
        }
        i64 index = 0;
        while (index < width) {
            if (index == end - start) {
                const JsonTokenResult result = json_failure(JsonStatus::truncated, end);
                return result;
            }
            u8 expected = 0u8;
            if (kind == JsonTokenKind::true_value) {
                if (index == 0) {
                    expected = 116u8;
                }
                if (index == 1) {
                    expected = 114u8;
                }
                if (index == 2) {
                    expected = 117u8;
                }
                if (index == 3) {
                    expected = 101u8;
                }
            }
            if (kind == JsonTokenKind::false_value) {
                if (index == 0) {
                    expected = 102u8;
                }
                if (index == 1) {
                    expected = 97u8;
                }
                if (index == 2) {
                    expected = 108u8;
                }
                if (index == 3) {
                    expected = 115u8;
                }
                if (index == 4) {
                    expected = 101u8;
                }
            }
            if (kind == JsonTokenKind::null_value) {
                if (index == 0) {
                    expected = 110u8;
                }
                if (index == 1) {
                    expected = 117u8;
                }
                if (index == 2 || index == 3) {
                    expected = 108u8;
                }
            }
            if (bytes.at(start + index) != expected) {
                const JsonTokenResult result = json_failure(JsonStatus::invalid_literal, start + index);
                return result;
            }
            index = index + 1;
        }
        if (width < end - start && !json_boundary(bytes.at(start + width))) {
            const JsonTokenResult result = json_failure(JsonStatus::invalid_literal, start + width);
            return result;
        }
        const JsonTokenResult result = json_success(kind, start, width, start - request + width);
        return result;
    }
}
export namespace std {
    auto decode_json_string_scalar(builtin::span<const u8> bytes, i64 offset, i64 count) -> JsonScalarResult {
        if (offset < 0 || count < 0 || offset > bytes.size()) {
            const JsonScalarResult result = json_scalar_failure(JsonStatus::invalid_window, 0);
            return result;
        }
        if (count > bytes.size() - offset) {
            const JsonScalarResult result = json_scalar_failure(JsonStatus::invalid_window, 0);
            return result;
        }
        if (count == 0) {
            const JsonScalarResult result = json_scalar_failure(JsonStatus::end_of_input, 0);
            return result;
        }
        const JsonScalarResult result = json_scalar(bytes, offset, offset + count);
        return result;
    }
    auto escape_json_scalar(u64 scalar) -> JsonEscapeResult {
        std::array<u8, 6> bytes = std::array<u8, 6>();
        const Utf8EncodeResult encoded = encode_utf8(scalar);
        if (encoded.status() != Utf8EncodeStatus::success) {
            const JsonEscapeResult result = JsonEscapeResult(JsonEscapeStatus::invalid_scalar, bytes, 0);
            return result;
        }
        i64 width = 0;
        u8 short_code = 0u8;
        if (scalar == 34u64) {
            short_code = 34u8;
        }
        if (scalar == 92u64) {
            short_code = 92u8;
        }
        if (scalar == 8u64) {
            short_code = 98u8;
        }
        if (scalar == 12u64) {
            short_code = 102u8;
        }
        if (scalar == 10u64) {
            short_code = 110u8;
        }
        if (scalar == 13u64) {
            short_code = 114u8;
        }
        if (scalar == 9u64) {
            short_code = 116u8;
        }
        if (short_code != 0u8) {
            bytes.set(0, 92u8);
            bytes.set(1, short_code);
            width = 2;
        } else {
            if (scalar < 32u64) {
                bytes.set(0, 92u8);
                bytes.set(1, 117u8);
                bytes.set(2, 48u8);
                bytes.set(3, 48u8);
                bytes.set(4, u8(48u64 + scalar / 16u64));
                const u64 last = scalar % 16u64;
                u8 digit = u8(48u64 + last);
                if (last >= 10u64) {
                    digit = u8(87u64 + last);
                }
                bytes.set(5, digit);
                width = 6;
            } else {
                width = encoded.size();
                i64 index = 0;
                while (index < width) {
                    bytes.set(index, encoded.byte_or(index, 0u8));
                    index = index + 1;
                }
            }
        }
        const JsonEscapeResult result = JsonEscapeResult(JsonEscapeStatus::success, bytes, width);
        return result;
    }
    auto next_json_token(builtin::span<const u8> bytes, i64 offset, i64 count) -> JsonTokenResult {
        if (offset < 0 || count < 0 || offset > bytes.size()) {
            const JsonTokenResult result = json_failure(JsonStatus::invalid_window, 0);
            return result;
        }
        if (count > bytes.size() - offset) {
            const JsonTokenResult result = json_failure(JsonStatus::invalid_window, 0);
            return result;
        }
        if (count > 4096) {
            const JsonTokenResult result = json_failure(JsonStatus::input_limit, offset);
            return result;
        }
        const i64 end = offset + count;
        i64 index = offset;
        while (index < end && json_space(bytes.at(index))) {
            index = index + 1;
        }
        if (index == end) {
            const JsonTokenResult result = JsonTokenResult(JsonStatus::end_of_input, JsonTokenKind::none, end, 0, count,
                0);
            return result;
        }
        const u8 byte = bytes.at(index);
        JsonTokenKind kind = JsonTokenKind::none;
        if (byte == 123u8) {
            kind = JsonTokenKind::left_brace;
        }
        if (byte == 125u8) {
            kind = JsonTokenKind::right_brace;
        }
        if (byte == 91u8) {
            kind = JsonTokenKind::left_bracket;
        }
        if (byte == 93u8) {
            kind = JsonTokenKind::right_bracket;
        }
        if (byte == 58u8) {
            kind = JsonTokenKind::colon;
        }
        if (byte == 44u8) {
            kind = JsonTokenKind::comma;
        }
        if (kind != JsonTokenKind::none) {
            const JsonTokenResult result = json_success(kind, index, 1, index - offset + 1);
            return result;
        }
        if (byte == 34u8) {
            const JsonTokenResult result = json_string(bytes, index, end, offset);
            return result;
        }
        if (byte == 45u8 || json_digit(byte)) {
            const JsonTokenResult result = json_number(bytes, index, end, offset);
            return result;
        }
        if (byte == 116u8) {
            kind = JsonTokenKind::true_value;
        }
        if (byte == 102u8) {
            kind = JsonTokenKind::false_value;
        }
        if (byte == 110u8) {
            kind = JsonTokenKind::null_value;
        }
        if (kind != JsonTokenKind::none) {
            const JsonTokenResult result = json_literal(bytes, index, end, offset, kind);
            return result;
        }
        const JsonTokenResult result = json_failure(JsonStatus::invalid_byte, index);
        return result;
    }
    auto validate_json(builtin::span<const u8> bytes, i64 offset, i64 count) -> JsonResult {
        if (offset < 0 || count < 0 || offset > bytes.size()) {
            const JsonResult result = JsonResult(JsonStatus::invalid_window, 0, 0, 0);
            return result;
        }
        if (count > bytes.size() - offset) {
            const JsonResult result = JsonResult(JsonStatus::invalid_window, 0, 0, 0);
            return result;
        }
        if (count > 4096) {
            const JsonResult result = JsonResult(JsonStatus::input_limit, offset, 0, 0);
            return result;
        }
        // Array: 1 initial value/end, 2 required value, 3 comma/end.
        // Object: 4 initial key/end, 5 required key, 6 colon, 7 value, 8 comma/end.
        std::array<u8, 32> states = std::array<u8, 32>();
        i64 depth = 0;
        i64 peak = 0;
        i64 tokens = 0;
        i64 index = offset;
        const i64 end = offset + count;
        bool root_complete = false;
        bool scanning = true;
        while (scanning) {
            const JsonTokenResult token = next_json_token(bytes, index, end - index);
            if (token.status() == JsonStatus::end_of_input) {
                if (depth != 0 || !root_complete) {
                    const JsonResult result = JsonResult(JsonStatus::truncated, end, tokens, peak);
                    return result;
                }
                const JsonResult result = JsonResult(JsonStatus::success, 0, tokens, peak);
                return result;
            }
            if (token.status() != JsonStatus::success) {
                const JsonResult result = JsonResult(token.status(), token.error_offset(), tokens, peak);
                return result;
            }
            if (tokens == 1024) {
                const JsonResult result = JsonResult(JsonStatus::token_limit, token.byte_offset(), tokens, peak);
                return result;
            }
            tokens = tokens + 1;
            index = index + token.consumed_bytes();
            const JsonTokenKind kind = token.kind();
            bool value = false;
            bool valid = true;
            if (depth == 0) {
                if (root_complete) {
                    valid = false;
                } else {
                    value = true;
                    root_complete = true;
                }
            } else {
                const u8 state = states.at(depth - 1);
                if (state == 1u8 || state == 2u8) {
                    if (state == 1u8 && kind == JsonTokenKind::right_bracket) {
                        depth = depth - 1;
                    } else {
                        value = true;
                        states.set(depth - 1, 3u8);
                    }
                }
                if (state == 3u8) {
                    if (kind == JsonTokenKind::right_bracket) {
                        depth = depth - 1;
                    } else {
                        if (kind == JsonTokenKind::comma) {
                            states.set(depth - 1, 2u8);
                        } else {
                            valid = false;
                        }
                    }
                }
                if (state == 4u8 || state == 5u8) {
                    if (state == 4u8 && kind == JsonTokenKind::right_brace) {
                        depth = depth - 1;
                    } else {
                        if (kind == JsonTokenKind::string) {
                            states.set(depth - 1, 6u8);
                        } else {
                            valid = false;
                        }
                    }
                }
                if (state == 6u8) {
                    if (kind == JsonTokenKind::colon) {
                        states.set(depth - 1, 7u8);
                    } else {
                        valid = false;
                    }
                }
                if (state == 7u8) {
                    value = true;
                    states.set(depth - 1, 8u8);
                }
                if (state == 8u8) {
                    if (kind == JsonTokenKind::right_brace) {
                        depth = depth - 1;
                    } else {
                        if (kind == JsonTokenKind::comma) {
                            states.set(depth - 1, 5u8);
                        } else {
                            valid = false;
                        }
                    }
                }
            }
            if (value) {
                if (kind == JsonTokenKind::left_brace || kind == JsonTokenKind::left_bracket) {
                    if (depth == 32) {
                        const JsonResult result = JsonResult(JsonStatus::depth_limit, token.byte_offset(), tokens, peak)
                            ;
                        return result;
                    }
                    u8 state = 1u8;
                    if (kind == JsonTokenKind::left_brace) {
                        state = 4u8;
                    }
                    states.set(depth, state);
                    depth = depth + 1;
                    if (depth > peak) {
                        peak = depth;
                    }
                } else {
                    if (kind != JsonTokenKind::string && kind != JsonTokenKind::number && kind != JsonTokenKind::
                        true_value && kind != JsonTokenKind::false_value && kind != JsonTokenKind::null_value) {
                        valid = false;
                    }
                }
            }
            if (!valid) {
                const JsonResult result = JsonResult(JsonStatus::invalid_structure, token.byte_offset(), tokens, peak);
                return result;
            }
        }
        // The language conservatively treats every while as possibly zero-trip.
        const JsonResult result = JsonResult(JsonStatus::truncated, end, tokens, peak);
        return result;
    }
}
