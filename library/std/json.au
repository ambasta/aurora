                    if (member_matches) {
                        matching_keys = matching_keys + 1;
                        if (matching_keys == 2) {
                            duplicate_offset = token.byte_offset();
                        }
                    }
                }
            }
            bool value = false;
            bool valid = true;
            if (depth == 0) {
                if (root_complete) {
                    valid = false;
                } else {
                    value = true;
                    root_complete = true;
                }
            } else {
                const u8 state = states.at(depth - 1);
                if (state == 1u8 || state == 2u8) {
                    if (state == 1u8 && kind == JsonTokenKind::right_bracket) {
                        depth = depth - 1;
                    } else {
                        value = true;
                        states.set(depth - 1, 3u8);
                    }
                }
                if (state == 3u8) {
                    if (kind == JsonTokenKind::right_bracket) {
                        depth = depth - 1;
                    } else {
                        if (kind == JsonTokenKind::comma) {
                            states.set(depth - 1, 2u8);
                        } else {
                            valid = false;
                        }
                    }
                }
                if (state == 4u8 || state == 5u8) {
                    if (state == 4u8 && kind == JsonTokenKind::right_brace) {
                        depth = depth - 1;
                    } else {
                        if (kind == JsonTokenKind::string) {
                            states.set(depth - 1, 6u8);
                        } else {
                            valid = false;
                        }
                    }
                }
                if (state == 6u8) {
                    if (kind == JsonTokenKind::colon) {
                        states.set(depth - 1, 7u8);
                    } else {
                        valid = false;
                    }
                }
                if (state == 7u8) {
                    value = true;
                    states.set(depth - 1, 8u8);
                }
                if (state == 8u8) {
                    if (kind == JsonTokenKind::right_brace) {
                        depth = depth - 1;
                    } else {
                        if (kind == JsonTokenKind::comma) {
                            states.set(depth - 1, 5u8);
                        } else {
                            valid = false;
                        }
                    }
                }
            }
            if (value) {
                if (kind == JsonTokenKind::left_brace || kind == JsonTokenKind::left_bracket) {
                    if (depth == 32) {
                        return json_walk_failure(JsonStatus::depth_limit, token.byte_offset(), tokens, peak);
                    }
                    u8 state = 1u8;
                    if (kind == JsonTokenKind::left_brace) {
                        state = 4u8;
                    }
                    states.set(depth, state);
                    depth = depth + 1;
                    if (depth > peak) {
                        peak = depth;
                    }
                } else {
                    if (kind != JsonTokenKind::string && kind != JsonTokenKind::number && kind
                        != JsonTokenKind::true_value && kind != JsonTokenKind::false_value && kind
                        != JsonTokenKind::null_value) {
                        valid = false;
                    }
                }
            }
            if (!valid) {
                return json_walk_failure(JsonStatus::invalid_structure, token.byte_offset(), tokens, peak);
            }
            if (selected_open && before_depth == 2 && depth == 1) {
                selected_count = index - selected_start;
                selected_open = false;
            }
            if (value && before_depth == 1) {
                bool select = false;
                if (mode == 1u8 && before_state == 7u8 && member_matches && matching_keys == 1) {
                    select = true;
                }
                if (mode == 2u8 && (before_state == 1u8 || before_state == 2u8)) {
                    if (element_index == wanted) {
                        select = true;
                    }
                    element_index = element_index + 1;
                }
