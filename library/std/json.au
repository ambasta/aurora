        u8 short_code = 0u8;
        if (scalar == 34u64) {
            short_code = 34u8;
        }
        if (scalar == 92u64) {
            short_code = 92u8;
        }
        if (scalar == 8u64) {
            short_code = 98u8;
        }
        if (scalar == 12u64) {
            short_code = 102u8;
        }
        if (scalar == 10u64) {
            short_code = 110u8;
        }
        if (scalar == 13u64) {
            short_code = 114u8;
        }
        if (scalar == 9u64) {
            short_code = 116u8;
        }
        if (short_code != 0u8) {
            bytes.set(0, 92u8);
            bytes.set(1, short_code);
            width = 2;
        } else {
