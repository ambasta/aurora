export namespace std {
    auto validate_json(builtin::span<const u8> bytes, i64 offset, i64 count) -> JsonResult {
        const JsonWalkRequest request = JsonWalkRequest(offset, count, 0, 0, 0, 0u8);
        const JsonWalkResult walked = json_walk(bytes, bytes, request);
        return walked.document();
    }
    auto lookup_json_member(builtin::span<const u8> bytes, i64 offset, i64 count, builtin::span<const u8> key,
        i64 key_offset, i64 key_count) -> JsonLookupResult {
        const JsonWalkRequest request = JsonWalkRequest(offset, count, key_offset, key_count, 0, 1u8);
        const JsonWalkResult walked = json_walk(bytes, key, request);
        return walked.lookup();
    }
    auto lookup_json_element(builtin::span<const u8> bytes, i64 offset, i64 count, i64 index) -> JsonLookupResult {
        const JsonWalkRequest request = JsonWalkRequest(offset, count, 0, 0, index, 2u8);
        const JsonWalkResult walked = json_walk(bytes, bytes, request);
        return walked.lookup();
    }
}
