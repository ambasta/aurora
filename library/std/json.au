        if (negative) {
            limit = 9223372036854775808u64;
        }
        if (value > limit) {
            const JsonI64Result result = JsonI64Result(JsonIntegerStatus::out_of_range, 0, offset);
            return result;
        }
        if (negative && value == 9223372036854775808u64) {
            const JsonI64Result result = JsonI64Result(JsonIntegerStatus::success, -9223372036854775808, 0);
            return result;
        }
        i64 number = i64(value);
        if (negative) {
            number = -number;
        }
        const JsonI64Result result = JsonI64Result(JsonIntegerStatus::success, number, 0);
        return result;
    }

    auto decode_json_string_scalar(builtin::span<const u8> bytes, i64 offset, i64 count) -> JsonScalarResult {
        if (offset < 0 || count < 0 || offset > bytes.size()) {
            return json_scalar_failure(JsonStatus::invalid_window, 0);
        }
        if (count > bytes.size() - offset) {
            return json_scalar_failure(JsonStatus::invalid_window, 0);
        }
        if (count == 0) {
            return json_scalar_failure(JsonStatus::end_of_input, 0);
        }
        return json_scalar(bytes, offset, offset + count);
    }
    auto escape_json_scalar(u64 scalar) -> JsonEscapeResult {
