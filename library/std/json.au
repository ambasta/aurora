            }
            if (token.status() != JsonStatus::success) {
                return json_walk_failure(token.status(), token.error_offset(), tokens, peak);
            }
            if (tokens == 1024) {
                return json_walk_failure(JsonStatus::token_limit, token.byte_offset(), tokens, peak);
            }
            tokens = tokens + 1;
            index = index + token.consumed_bytes();
            const JsonTokenKind kind = token.kind();
            // Selection observes the old grammar state, before parent advancement.
            const i64 before_depth = depth;
            u8 before_state = 0u8;
            if (depth > 0) {
                before_state = states.at(depth - 1);
            }
            if (depth == 0 && !root_complete) {
                root_kind = json_value_kind(kind);
            }
            if (mode == 1u8 && depth == 1 && (before_state == 4u8 || before_state == 5u8) && kind
                == JsonTokenKind::string) {
                member_matches = false;
                if (matching_keys < 2) {
                    member_matches = json_key_equal(bytes, token.byte_offset() + 1, token.byte_count() - 2, key,
