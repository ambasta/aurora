                if (outcome != JsonLookupStatus::success) {
                    const JsonLookupResult lookup = json_lookup_failure(outcome, error);
                    const JsonWalkResult result = JsonWalkResult(document, lookup);
                    return result;
                }
                const JsonLookupResult found = JsonLookupResult(outcome, selected_kind, selected_start, selected_count,
