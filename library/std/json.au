export module std.json;
import std.utf8;
import std.array;
import std.decimal;

export namespace std {
    enum class JsonStatus {
        success,
        end_of_input,
        invalid_window,
        input_limit,
        invalid_byte,
        invalid_string,
        invalid_number,
        invalid_literal,
        truncated,
        number_limit,
        token_limit,
        depth_limit,
        invalid_structure
    };
    enum class JsonTokenKind {
        none,
        left_brace,
        right_brace,
        left_bracket,
        right_bracket,
        colon,
        comma,
        string,
        number,
        true_value,
        false_value,
        null_value
    };
    enum class JsonIntegerStatus {
        success,
        invalid_window,
        invalid_number,
        number_limit,
        unsupported_number_form,
        out_of_range
    };
    class JsonI64Result {
        JsonIntegerStatus outcome;
        i64 number;
        i64 error;
    public:
        JsonI64Result(JsonIntegerStatus status, i64 value, i64 position) : outcome(status), number(value),
            error(position) {
        }
        auto status() const -> JsonIntegerStatus {
            if (outcome == JsonIntegerStatus::invalid_window || error < 0) {
                return JsonIntegerStatus::invalid_window;
            }
            if (outcome == JsonIntegerStatus::success) {
                if (error != 0) {
                    return JsonIntegerStatus::invalid_window;
                }
                return outcome;
            }
            if (number != 0) {
                return JsonIntegerStatus::invalid_window;
            }
            return outcome;
        }
        auto value_or(i64 fallback) const -> i64 {
            if (status() != JsonIntegerStatus::success) {
                return fallback;
            }
            return number;
        }
        auto error_offset() const -> i64 {
            if (status() == JsonIntegerStatus::invalid_window) {
                return 0;
            }
            return error;
        }
    };
    class JsonU64Result {
        JsonIntegerStatus outcome;
        u64 number;
        i64 error;
    public:
        JsonU64Result(JsonIntegerStatus status, u64 value, i64 position) : outcome(status), number(value),
            error(position) {
        }
        auto status() const -> JsonIntegerStatus {
            if (outcome == JsonIntegerStatus::invalid_window || error < 0) {
                return JsonIntegerStatus::invalid_window;
            }
            if (outcome == JsonIntegerStatus::success) {
                if (error != 0) {
                    return JsonIntegerStatus::invalid_window;
                }
                return outcome;
            }
            if (number != 0u64) {
                return JsonIntegerStatus::invalid_window;
            }
            return outcome;
        }
        auto value_or(u64 fallback) const -> u64 {
            if (status() != JsonIntegerStatus::success) {
                return fallback;
            }
            return number;
        }
        auto error_offset() const -> i64 {
            if (status() == JsonIntegerStatus::invalid_window) {
                return 0;
            }
            return error;
        }
    };
    enum class JsonLookupStatus {
        success,
        invalid_window,
        input_limit,
        invalid_byte,
        invalid_string,
        invalid_number,
        invalid_literal,
        truncated,
        number_limit,
        token_limit,
        depth_limit,
        invalid_structure,
        invalid_key_window,
        key_limit,
        invalid_key,
        invalid_index,
        wrong_root,
        not_found,
        ambiguous
    };
    enum class JsonValueKind {
        none,
        object,
        array_value,
        string,
        number,
        true_value,
        false_value,
        null_value
    };
    class JsonLookupResult {
        JsonLookupStatus outcome;
        JsonValueKind category;
        i64 offset;
        i64 length;
        i64 error;
    public:
        JsonLookupResult(JsonLookupStatus status, JsonValueKind kind, i64 start, i64 count,
            i64 position) : outcome(status), category(kind), offset(start), length(count), error(position) {
        }
        auto status() const -> JsonLookupStatus {
            if (outcome == JsonLookupStatus::invalid_window) {
                return outcome;
            }
            if (offset < 0 || length < 0 || length > 4096 || error < 0) {
                return JsonLookupStatus::invalid_window;
            }
            if (length > 9223372036854775807 - offset) {
                return JsonLookupStatus::invalid_window;
            }
            if (outcome == JsonLookupStatus::success) {
                if (error != 0 || length == 0 || category == JsonValueKind::none) {
                    return JsonLookupStatus::invalid_window;
                }
                if ((category == JsonValueKind::object || category == JsonValueKind::array_value || category
                    == JsonValueKind::string) && length < 2) {
                    return JsonLookupStatus::invalid_window;
                }
                if (category == JsonValueKind::number && length > 128) {
                    return JsonLookupStatus::invalid_window;
                }
                if ((category == JsonValueKind::true_value || category == JsonValueKind::null_value) && length != 4) {
                    return JsonLookupStatus::invalid_window;
                }
                if (category == JsonValueKind::false_value && length != 5) {
                    return JsonLookupStatus::invalid_window;
                }
                return outcome;
            }
            if (category != JsonValueKind::none || offset != 0 || length != 0) {
                return JsonLookupStatus::invalid_window;
            }
            if ((outcome == JsonLookupStatus::invalid_key_window || outcome == JsonLookupStatus::invalid_index
                || outcome == JsonLookupStatus::wrong_root || outcome == JsonLookupStatus::not_found) && error != 0) {
                return JsonLookupStatus::invalid_window;
            }
            return outcome;
        }
        auto kind() const -> JsonValueKind {
            if (status() != JsonLookupStatus::success) {
                return JsonValueKind::none;
            }
            return category;
        }
        auto byte_offset() const -> i64 {
            if (status() != JsonLookupStatus::success) {
                return 0;
            }
            return offset;
        }
        auto byte_count() const -> i64 {
            if (status() != JsonLookupStatus::success) {
                return 0;
            }
            return length;
        }
        auto error_offset() const -> i64 {
            if (status() == JsonLookupStatus::invalid_window) {
                return 0;
            }
            return error;
        }
    };
    class JsonScalarResult {
        JsonStatus outcome;
        u64 scalar;
        i64 consumed;
        i64 error;
    public:
        JsonScalarResult(JsonStatus status, u64 value, i64 used, i64 position) : outcome(status), scalar(value),
            consumed(used), error(position) {
        }
        auto status() const -> JsonStatus {
            if (outcome == JsonStatus::invalid_window) {
                return outcome;
            }
            if (error < 0) {
                return JsonStatus::invalid_window;
            }
            if (outcome == JsonStatus::success) {
                if (scalar > 1114111u64 || (scalar >= 55296u64 && scalar <= 57343u64) || consumed < 1 || consumed > 12
                    || error != 0) {
                    return JsonStatus::invalid_window;
                }
                return outcome;
            }
            if (scalar != 0u64 || consumed != 0) {
                return JsonStatus::invalid_window;
            }
            if (outcome == JsonStatus::end_of_input) {
                if (error != 0) {
                    return JsonStatus::invalid_window;
                }
                return outcome;
            }
            if (outcome == JsonStatus::invalid_string || outcome == JsonStatus::truncated) {
                return outcome;
            }
            return JsonStatus::invalid_window;
        }
        auto scalar_or(u64 fallback) const -> u64 {
            if (status() != JsonStatus::success) {
                return fallback;
            }
            return scalar;
        }
        auto consumed_bytes() const -> i64 {
            if (status() != JsonStatus::success) {
                return 0;
            }
            return consumed;
        }
        auto error_offset() const -> i64 {
            if (status() == JsonStatus::invalid_window) {
                return 0;
            }
            return error;
        }
    };
    enum class JsonEscapeStatus {
        success,
        invalid_scalar
    };
    class JsonEscapeResult {
        JsonEscapeStatus outcome;
        std::array<u8, 6> payload;
        i64 width;
    public:
        JsonEscapeResult(JsonEscapeStatus status, std::array<u8, 6> bytes, i64 count) : outcome(status), payload(bytes),
            width(count) {
        }
        auto status() const -> JsonEscapeStatus {
            if (outcome != JsonEscapeStatus::success || width < 1 || width > 6) {
                return JsonEscapeStatus::invalid_scalar;
            }
            return outcome;
        }
        auto size() const -> i64 {
            if (status() != JsonEscapeStatus::success) {
                return 0;
            }
            return width;
        }
        auto byte_or(i64 index, u8 fallback) const -> u8 {
            if (status() != JsonEscapeStatus::success || index < 0 || index >= width) {
                return fallback;
            }
            const std::array<u8, 6> bytes = payload;
            return bytes.at(index);
        }
    };
    class JsonTokenResult {
        JsonStatus outcome;
        JsonTokenKind category;
        i64 offset;
        i64 length;
        i64 consumed;
        i64 error;
    public:
        JsonTokenResult(JsonStatus status, JsonTokenKind kind, i64 start, i64 count, i64 used,
            i64 position) : outcome(status), category(kind), offset(start), length(count), consumed(used),
            error(position) {
        }
        auto status() const -> JsonStatus {
            if (outcome == JsonStatus::invalid_window) {
                return outcome;
            }
            if (offset < 0 || length < 0 || length > 4096 || consumed < 0 || consumed > 4096 || error < 0) {
                return JsonStatus::invalid_window;
            }
            if (length > 9223372036854775807 - offset) {
                return JsonStatus::invalid_window;
            }
            if (outcome == JsonStatus::success || outcome == JsonStatus::end_of_input) {
                if (error != 0 || consumed < length || consumed - length > offset) {
                    return JsonStatus::invalid_window;
                }
                if (outcome == JsonStatus::success && (category == JsonTokenKind::none || length == 0)) {
                    return JsonStatus::invalid_window;
                }
                if (outcome == JsonStatus::end_of_input && (category != JsonTokenKind::none || length != 0)) {
                    return JsonStatus::invalid_window;
                }
                return outcome;
            }
            if (outcome == JsonStatus::token_limit || outcome == JsonStatus::depth_limit || outcome
                == JsonStatus::invalid_structure) {
                return JsonStatus::invalid_window;
            }
            if (category != JsonTokenKind::none || offset != 0 || length != 0 || consumed != 0) {
                return JsonStatus::invalid_window;
            }
            return outcome;
        }
        auto kind() const -> JsonTokenKind {
            if (status() != JsonStatus::success) {
                return JsonTokenKind::none;
            }
            return category;
        }
        auto byte_offset() const -> i64 {
            if (status() != JsonStatus::success && status() != JsonStatus::end_of_input) {
                return 0;
            }
            return offset;
        }
        auto byte_count() const -> i64 {
            if (status() != JsonStatus::success) {
                return 0;
            }
            return length;
        }
        auto consumed_bytes() const -> i64 {
            if (status() != JsonStatus::success && status() != JsonStatus::end_of_input) {
                return 0;
            }
            return consumed;
        }
        auto error_offset() const -> i64 {
            if (status() == JsonStatus::invalid_window) {
                return 0;
            }
            return error;
        }
    };
    class JsonResult {
        JsonStatus outcome;
        i64 error;
        i64 tokens;
        i64 peak;
    public:
        JsonResult(JsonStatus status, i64 position, i64 count, i64 depth) : outcome(status), error(position),
            tokens(count), peak(depth) {
        }
        auto status() const -> JsonStatus {
            if (outcome == JsonStatus::invalid_window || outcome == JsonStatus::end_of_input) {
                return JsonStatus::invalid_window;
            }
            if (error < 0 || tokens < 0 || tokens > 1024 || peak < 0 || peak > 32) {
                return JsonStatus::invalid_window;
            }
            if (outcome == JsonStatus::success && (error != 0 || tokens == 0)) {
                return JsonStatus::invalid_window;
            }
            return outcome;
        }
        auto error_offset() const -> i64 {
            if (status() == JsonStatus::invalid_window) {
                return 0;
            }
            return error;
        }
        auto token_count() const -> i64 {
            if (status() == JsonStatus::invalid_window) {
                return 0;
            }
            return tokens;
        }
        auto max_depth() const -> i64 {
            if (status() == JsonStatus::invalid_window) {
                return 0;
            }
            return peak;
        }
    };
}
namespace std {
    auto json_space(u8 byte) -> bool {
        return byte == 9u8 || byte == 10u8 || byte == 13u8 || byte == 32u8;
    }
    auto json_digit(u8 byte) -> bool {
        return byte >= 48u8 && byte <= 57u8;
    }
    auto json_boundary(u8 byte) -> bool {
        return json_space(byte) || byte == 123u8 || byte == 125u8 || byte == 91u8 || byte == 93u8 || byte == 58u8
            || byte == 44u8;
    }
    auto json_hex(u8 byte) -> i64 {
        if (byte >= 48u8 && byte <= 57u8) {
            return i64(byte) - 48;
        }
        if (byte >= 65u8 && byte <= 70u8) {
            return i64(byte) - 55;
        }
        if (byte >= 97u8 && byte <= 102u8) {
            return i64(byte) - 87;
        }
        return -1;
    }
    auto json_failure(JsonStatus status, i64 position) -> JsonTokenResult {
        const JsonTokenResult result = JsonTokenResult(status, JsonTokenKind::none, 0, 0, 0, position);
        return result;
    }
    auto json_success(JsonTokenKind kind, i64 start, i64 count, i64 consumed) -> JsonTokenResult {
        const JsonTokenResult result = JsonTokenResult(JsonStatus::success, kind, start, count, consumed, 0);
        return result;
    }
    auto json_scalar_failure(JsonStatus status, i64 position) -> JsonScalarResult {
        const JsonScalarResult result = JsonScalarResult(status, 0u64, 0, position);
        return result;
    }
    // Internal nonempty, checked-window primitive shared by scanner and scalar reader.
    auto json_scalar(builtin::span<const u8> bytes, i64 start, i64 end) -> JsonScalarResult {
        i64 index = start;
        const u8 byte = bytes.at(index);
        if (byte < 32u8 || byte == 34u8) {
            return json_scalar_failure(JsonStatus::invalid_string, index);
        }
        if (byte == 92u8) {
            const i64 escape = index;
            index = index + 1;
            if (index == end) {
                return json_scalar_failure(JsonStatus::truncated, end);
            }
            const u8 code = bytes.at(index);
            if (code == 34u8 || code == 92u8 || code == 47u8 || code == 98u8 || code == 102u8 || code == 110u8 || code
                == 114u8 || code == 116u8) {
                u64 value = u64(code);
                if (code == 98u8) {
                    value = 8u64;
                }
                if (code == 102u8) {
                    value = 12u64;
                }
                if (code == 110u8) {
                    value = 10u64;
                }
                if (code == 114u8) {
                    value = 13u64;
                }
                if (code == 116u8) {
                    value = 9u64;
                }
                const JsonScalarResult result = JsonScalarResult(JsonStatus::success, value, 2, 0);
                return result;
            } else {
                if (code != 117u8) {
                    return json_scalar_failure(JsonStatus::invalid_string, index);
                }
                index = index + 1;
                i64 scalar = 0;
                i64 digit = 0;
                while (digit < 4) {
                    if (index == end) {
                        return json_scalar_failure(JsonStatus::truncated, end);
                    }
                    const i64 value = json_hex(bytes.at(index));
                    if (value < 0) {
                        return json_scalar_failure(JsonStatus::invalid_string, index);
                    }
                    scalar = scalar * 16 + value;
                    index = index + 1;
                    digit = digit + 1;
                }
                if (scalar >= 56320 && scalar <= 57343) {
                    return json_scalar_failure(JsonStatus::invalid_string, escape);
                }
                if (scalar >= 55296 && scalar <= 56319) {
                    // A surrogate code unit alone is never a scalar-valid string.
                    if (index == end) {
                        return json_scalar_failure(JsonStatus::truncated, end);
                    }
                    if (bytes.at(index) != 92u8) {
                        return json_scalar_failure(JsonStatus::invalid_string, escape);
                    }
                    index = index + 1;
                    if (index == end) {
                        return json_scalar_failure(JsonStatus::truncated, end);
                    }
                    if (bytes.at(index) != 117u8) {
                        return json_scalar_failure(JsonStatus::invalid_string, escape);
                    }
                    index = index + 1;
                    i64 low = 0;
                    digit = 0;
                    while (digit < 4) {
                        if (index == end) {
                            return json_scalar_failure(JsonStatus::truncated, end);
                        }
                        const i64 value = json_hex(bytes.at(index));
                        if (value < 0) {
                            return json_scalar_failure(JsonStatus::invalid_string, index);
                        }
                        low = low * 16 + value;
                        index = index + 1;
                        digit = digit + 1;
                    }
                    if (low < 56320 || low > 57343) {
                        return json_scalar_failure(JsonStatus::invalid_string, escape);
                    }
                    scalar = 65536 + (scalar - 55296) * 1024 + low - 56320;
                }
                const JsonScalarResult result = JsonScalarResult(JsonStatus::success, u64(scalar), index - start, 0);
                return result;
            }
        } else {
            if (byte < 128u8) {
                const JsonScalarResult result = JsonScalarResult(JsonStatus::success, u64(byte), 1, 0);
                return result;
            } else {
                const Utf8DecodeResult decoded = decode_utf8(bytes, index, end - index, true);
                if (decoded.status() == Utf8Status::truncated) {
                    return json_scalar_failure(JsonStatus::truncated, end);
                }
                if (decoded.status() != Utf8Status::success) {
                    return json_scalar_failure(JsonStatus::invalid_string, index);
                }
                const JsonScalarResult result = JsonScalarResult(JsonStatus::success, decoded.scalar_or(0u64),
                    decoded.width(), 0);
                return result;
            }
        }
    }
    auto json_string(builtin::span<const u8> bytes, i64 start, i64 end, i64 request) -> JsonTokenResult {
        i64 index = start + 1;
        while (index < end) {
            if (bytes.at(index) == 34u8) {
                return json_success(JsonTokenKind::string, start, index - start + 1, index - request + 1);
            }
            const JsonScalarResult decoded = json_scalar(bytes, index, end);
            if (decoded.status() != JsonStatus::success) {
                return json_failure(decoded.status(), decoded.error_offset());
            }
            index = index + decoded.consumed_bytes();
        }
        return json_failure(JsonStatus::truncated, end);
    }
    auto json_number(builtin::span<const u8> bytes, i64 start, i64 end, i64 request) -> JsonTokenResult {
        // States: start, minus, zero, integer, dot, fraction, exponent, sign, exponent digits.
        i64 state = 0;
        i64 index = start;
        bool scanning = true;
        while (index < end && scanning) {
            const u8 byte = bytes.at(index);
            if (json_boundary(byte)) {
                scanning = false;
            } else {
                i64 next = -1;
                if (state == 0 || state == 1) {
                    if (state == 0 && byte == 45u8) {
                        next = 1;
                    }
                    if (byte == 48u8) {
                        next = 2;
                    }
                    if (byte >= 49u8 && byte <= 57u8) {
                        next = 3;
                    }
                }
                if (state == 2 || state == 3) {
                    if (state == 3 && json_digit(byte)) {
                        next = 3;
                    }
                    if (byte == 46u8) {
                        next = 4;
                    }
                    if (byte == 101u8 || byte == 69u8) {
                        next = 6;
                    }
                }
                if (state == 4 || state == 5) {
                    if (json_digit(byte)) {
                        next = 5;
                    }
                    if (state == 5 && (byte == 101u8 || byte == 69u8)) {
                        next = 6;
                    }
                }
                if (state == 6 || state == 7 || state == 8) {
                    if (json_digit(byte)) {
                        next = 8;
                    }
                    if (state == 6 && (byte == 43u8 || byte == 45u8)) {
                        next = 7;
                    }
                }
                if (next < 0) {
                    return json_failure(JsonStatus::invalid_number, index);
                }
                if (index - start == 128) {
                    return json_failure(JsonStatus::number_limit, index);
                }
                state = next;
                index = index + 1;
            }
        }
        if (state != 2 && state != 3 && state != 5 && state != 8) {
            return json_failure(JsonStatus::invalid_number, index);
        }
        return json_success(JsonTokenKind::number, start, index - start, index - request);
    }
    // Validate the actual exact spelling before inspecting form or range. Copied
    // token coordinates never certify these source bytes or bypass revalidation.
    auto json_integer_magnitude(builtin::span<const u8> bytes, i64 offset, i64 count) -> JsonU64Result {
        if (offset < 0 || count < 0 || offset > bytes.size()) {
            const JsonU64Result result = JsonU64Result(JsonIntegerStatus::invalid_window, 0u64, 0);
            return result;
        }
        if (count > bytes.size() - offset) {
            const JsonU64Result result = JsonU64Result(JsonIntegerStatus::invalid_window, 0u64, 0);
            return result;
        }
        const i64 end = offset + count;
        const JsonTokenResult token = json_number(bytes, offset, end, offset);
        if (token.status() != JsonStatus::success) {
            JsonIntegerStatus status = JsonIntegerStatus::invalid_number;
            if (token.status() == JsonStatus::number_limit) {
                status = JsonIntegerStatus::number_limit;
            }
            const JsonU64Result result = JsonU64Result(status, 0u64, token.error_offset());
            return result;
        }
        if (token.byte_count() != count) {
            const JsonU64Result result = JsonU64Result(JsonIntegerStatus::invalid_number, 0u64, offset
                + token.byte_count());
            return result;
        }
        i64 index = offset;
        while (index < end) {
            const u8 byte = bytes.at(index);
            if (byte == 46u8 || byte == 101u8 || byte == 69u8) {
                const JsonU64Result result = JsonU64Result(JsonIntegerStatus::unsupported_number_form, 0u64, offset);
                return result;
            }
            index = index + 1;
        }
        DecimalAccumulator accumulator = DecimalAccumulator();
        index = offset;
        if (bytes.at(index) == 45u8) {
            index = index + 1;
        }
        while (index < end) {
            const DecimalStatus pushed = accumulator.push_digit(u64(bytes.at(index)) - 48u64);
            if (pushed != DecimalStatus::success) {
                const JsonU64Result result = JsonU64Result(JsonIntegerStatus::out_of_range, 0u64, offset);
                return result;
            }
            index = index + 1;
        }
        const DecimalResult magnitude = accumulator.finish();
        const JsonU64Result result = JsonU64Result(JsonIntegerStatus::success, magnitude.value_or(0u64), 0);
        return result;
    }
    auto json_literal(builtin::span<const u8> bytes, i64 start, i64 end, i64 request,
        JsonTokenKind kind) -> JsonTokenResult {
        i64 width = 4;
        if (kind == JsonTokenKind::false_value) {
            width = 5;
        }
        i64 index = 0;
        while (index < width) {
            if (index == end - start) {
                return json_failure(JsonStatus::truncated, end);
            }
            u8 expected = 0u8;
            if (kind == JsonTokenKind::true_value) {
                if (index == 0) {
                    expected = 116u8;
                }
                if (index == 1) {
                    expected = 114u8;
                }
                if (index == 2) {
                    expected = 117u8;
                }
                if (index == 3) {
                    expected = 101u8;
                }
            }
            if (kind == JsonTokenKind::false_value) {
                if (index == 0) {
                    expected = 102u8;
                }
                if (index == 1) {
                    expected = 97u8;
                }
                if (index == 2) {
                    expected = 108u8;
                }
                if (index == 3) {
                    expected = 115u8;
                }
                if (index == 4) {
                    expected = 101u8;
                }
            }
            if (kind == JsonTokenKind::null_value) {
                if (index == 0) {
                    expected = 110u8;
                }
                if (index == 1) {
                    expected = 117u8;
                }
                if (index == 2 || index == 3) {
                    expected = 108u8;
                }
            }
            if (bytes.at(start + index) != expected) {
                return json_failure(JsonStatus::invalid_literal, start + index);
            }
            index = index + 1;
        }
        if (width < end - start && !json_boundary(bytes.at(start + width))) {
            return json_failure(JsonStatus::invalid_literal, start + width);
        }
        return json_success(kind, start, width, start - request + width);
    }
}
export namespace std {
    auto parse_json_u64(builtin::span<const u8> bytes, i64 offset, i64 count) -> JsonU64Result {
        const JsonU64Result magnitude = json_integer_magnitude(bytes, offset, count);
        if (magnitude.status() != JsonIntegerStatus::success) {
            return magnitude;
        }
        if (bytes.at(offset) == 45u8 && magnitude.value_or(0u64) != 0u64) {
            const JsonU64Result result = JsonU64Result(JsonIntegerStatus::out_of_range, 0u64, offset);
            return result;
        }
        return magnitude;
    }
    auto parse_json_i64(builtin::span<const u8> bytes, i64 offset, i64 count) -> JsonI64Result {
        const JsonU64Result magnitude = json_integer_magnitude(bytes, offset, count);
        if (magnitude.status() != JsonIntegerStatus::success) {
            const JsonI64Result result = JsonI64Result(magnitude.status(), 0, magnitude.error_offset());
            return result;
        }
        const u64 value = magnitude.value_or(0u64);
        const bool negative = bytes.at(offset) == 45u8;
