# Memory decisions for `kernel-process events` (kernel/uefi/process.md#memory).
# STATE is NEXT CHARGED QUOTA COUNT, RECORD is FIRST RESERVED PAGES. The memory
# area is [0x400000000000, 0x600000000000); a mapping of P pages at F is
# charged P plus one table per 2 MiB, 1 GiB and 512 GiB slot it touches.
#
# Reservation: the next power of two of the pages at the bump address, one
# unmapped page after it.
map 0x400000000000 2100 10000 0 4096
map 0x400000000000 2100 10000 0 12288
map 0x400000000000 2100 10000 0 0x1000000
map 0x400000002000 2104 10000 1 4096
# Straddling a 2 MiB and a 1 GiB boundary: two tables of each lower level.
map 0x4000001ff000 2100 10000 0 8192
map 0x40003ffff000 2100 10000 0 8192
# The area's last reservation fits exactly; one page later it does not.
map 0x5fffffffd000 2100 10000 0 4096
map 0x5fffffffe000 2100 10000 0 4096
map 0x5ffffffff000 2100 10000 0 4096
map 0x400000000000 2100 0x100000000 0 0x400000000000
# Quota: the charge must fit in what is left (4 GiB: 2^20 pages, 2048 page
# tables, 4 directories and a pointer table).
map 0x400000000000 2100 2104 0 4096
map 0x400000000000 2100 2103 0 4096
map 0x400000000000 0 0x100804 0 0x100000000
map 0x400000000000 0 0x100805 0 0x100000000
# Lengths: whole pages, nonzero, at most 64 TiB.
map 0x400000000000 2100 10000 0 0
map 0x400000000000 2100 10000 0 4097
map 0x400000000000 2100 10000 0 0x400000001000
# Records: at most 16384 live mappings.
map 0x400000000000 2100 10000 16383 4096
map 0x400000000000 2100 10000 16384 4096
# Malformed states: charge above quota, bump outside the area or unaligned,
# too many records.
map 0x400000000000 10001 10000 0 4096
map 0x3ffffffff000 2100 10000 0 4096
map 0x600000001000 2100 10000 0 4096
map 0x400000000800 2100 10000 0 4096
map 0x400000000000 2100 10000 16385 4096
#
# Growth and shrinking in place, within the reservation.
remap 0x400000005000 2106 10000 1 0x400000000000 4 3 12288 16384
remap 0x400000005000 2106 10000 1 0x400000000000 4 3 12288 4096
remap 0x400000005000 2106 10000 1 0x400000000000 4 3 12288 12288
remap 0x400000005000 2106 2106 1 0x400000000000 4 3 12288 16384
remap 0x400000005000 2106 2106 1 0x400000000000 4 3 12288 4096
# Outgrowing the reservation moves to a fresh one (the entries move, no bytes
# are copied); while they move, the new range's tables exist beside the old
# ones, so the move needs room for both.
remap 0x400000005000 2106 10000 1 0x400000000000 4 3 12288 20480
remap 0x400000005000 2106 2107 1 0x400000000000 4 3 12288 20480
remap 0x400000005000 2106 2108 1 0x400000000000 4 3 12288 20480
remap 0x400000005000 2106 2109 1 0x400000000000 4 3 12288 20480
remap 0x5fffffffc000 2106 10000 1 0x5ffffffe0000 4 3 12288 20480
# Misuse: a length the mapping does not have, an invalid new length, records
# the supervisor could not have kept.
remap 0x400000005000 2106 10000 1 0x400000000000 4 3 8192 16384
remap 0x400000005000 2106 10000 1 0x400000000000 4 3 12288 0
remap 0x400000005000 2106 10000 1 0x400000000000 4 3 12288 4095
remap 0x400000005000 2106 10000 1 0x400000000000 2 3 12288 16384
remap 0x400000005000 2106 10000 1 0x400000000000 3 3 12288 16384
remap 0x400000005000 2106 10000 1 0x400000000000 4 0 0 16384
remap 0x400000005000 2106 10000 1 0x400000005000 1 1 4096 8192
remap 0x400000005000 2106 10000 1 0x400000002000 4 3 12288 16384
remap 0x400000005000 2106 10000 1 0x3ffffffff000 1 1 4096 8192
remap 0x400000005000 5 10000 1 0x400000000000 4 3 12288 16384
#
# Release: the mapping's whole charge comes back.
unmap 0x400000005000 2106 10000 1 0x400000000000 4 3 12288
unmap 0x400000005000 2106 10000 1 0x400000000000 4 3 4096
unmap 0x400000005000 2106 10000 1 0x400000000000 4 3 16384
unmap 0x400000005000 2106 10000 1 0x400000005000 4 3 12288
unmap 0x400000005000 2105 10000 1 0x400000000000 4 3 12288
#
# Records by base and committed faults: a user read (4) or write (6) of an
# absent page inside a mapping's pages, not its reservation's slack.
find 0x400000000000 0x400000000000 4 3 0x400000005000 8 5
find 0x400000005000 0x400000000000 4 3 0x400000005000 8 5
find 0x400000001000 0x400000000000 4 3 0x400000005000 8 5
find 0x3ffffffff000 0x400000000000 4 3 0x400000005000 8 5
find 0x400000000000
fault 0x400000002fff 6 0x400000000000 4 3 0x400000005000 8 5
fault 0x400000000000 4 0x400000000000 4 3 0x400000005000 8 5
fault 0x400000009fff 6 0x400000000000 4 3 0x400000005000 8 5
fault 0x400000003000 6 0x400000000000 4 3 0x400000005000 8 5
fault 0x40000000a000 6 0x400000000000 4 3 0x400000005000 8 5
fault 0x3fffffffffff 6 0x400000000000 4 3 0x400000005000 8 5
fault 0x400000000000 7 0x400000000000 4 3 0x400000005000 8 5
fault 0x400000000000 2 0x400000000000 4 3 0x400000005000 8 5
fault 0x400000000000 0x14 0x400000000000 4 3 0x400000005000 8 5
fault 0x400000000000 0xe 0x400000000000 4 3 0x400000005000 8 5
fault 0x400000000000 0x26 0x400000000000 4 3 0x400000005000 8 5
fault 0x400000000000 6
#
# The kernel calls: map(bytes), remap(base, bytes, new bytes), unmap(base,
# bytes); whole-page lengths up to 64 TiB, a page of the area as base.
call 4 4096 0 0
call 4 0x400000000000 0 0
call 4 0 0 0
call 4 4097 0 0
call 4 0x400000001000 0 0
call 5 0x400000000000 4096 8192
call 5 0x5ffffffff000 4096 4096
call 5 0x400000000001 4096 8192
call 5 0x3ffffffff000 4096 8192
call 5 0x600000000000 4096 8192
call 5 0x400000000000 0 8192
call 5 0x400000000000 4096 0
call 6 0x400000000000 4096 0
call 6 0x400000000000 0 0
call 6 0x400000000000 100 0
call 15 0 0 0

# Actual copied-scalar snapshot policy bridge; numeric observations are not capabilities.
# ordinary
snapshot_leaf 0x8000000000002003 0x2000 0x400003 0x400000 0 0x100000
# accessed
snapshot_leaf 0x8000000000002023 0x2000 0x400003 0x400000 0 0x100000
# dirty
snapshot_leaf 0x8000000000002043 0x2000 0x400003 0x400000 0 0x100000
# accessed and dirty
snapshot_leaf 0x8000000000002063 0x2000 0x400003 0x400000 0 0x100000
# last slot
snapshot_leaf 0x8000000000002003 0x2000 0x5ff003 0x400000 0x1ff 0x100000
# highest aligned prefix, no carry
snapshot_leaf 0x8000000000002003 0x2000 0xfffffffffffff003 0xffffffffffe00000 0x1ff 0x100000
# highest physical address page
snapshot_leaf 0x800ffffffffff003 0xffffffffff000 0x400003 0x400000 0 0x10000000000000
# not present
snapshot_leaf 0x8000000000002002 0x2000 0x400003 0x400000 0 0x100000
# read only
snapshot_leaf 0x8000000000002001 0x2000 0x400003 0x400000 0 0x100000
# executable
snapshot_leaf 0x2003 0x2000 0x400003 0x400000 0 0x100000
# user
snapshot_leaf 0x8000000000002007 0x2000 0x400003 0x400000 0 0x100000
# huge
snapshot_leaf 0x8000000000002083 0x2000 0x400003 0x400000 0 0x100000
# global
snapshot_leaf 0x8000000000002103 0x2000 0x400003 0x400000 0 0x100000
# reserved high bit
snapshot_leaf 0x8010000000002003 0x2000 0x400003 0x400000 0 0x100000
# physical mismatch
snapshot_leaf 0x8000000000002003 0x3000 0x400003 0x400000 0 0x100000
# unaligned physical
snapshot_leaf 0x8000000000002003 0x2001 0x400003 0x400000 0 0x100000
# zero physical
snapshot_leaf 0x8000000000000003 0 0x400003 0x400000 0 0x100000
# physical equals limit
snapshot_leaf 0x8000000000002003 0x2000 0x400003 0x400000 0 0x2000
# zero limit
snapshot_leaf 0x8000000000002003 0x2000 0x400003 0x400000 0 0
# misaligned prefix
snapshot_leaf 0x8000000000002003 0x2000 0x401003 0x401000 0 0x100000
# slot 512
snapshot_leaf 0x8000000000002003 0x2000 0x600003 0x400000 0x200 0x100000
# slot maximum short circuits shift
snapshot_leaf 0x8000000000002003 0x2000 0x400003 0x400000 0xffffffffffffffff 0x100000
# wrong mapping tag
snapshot_leaf 0x8000000000002003 0x2000 0x400001 0x400000 0 0x100000
# wrong mapping slot
snapshot_leaf 0x8000000000002003 0x2000 0x401003 0x400000 0 0x100000
