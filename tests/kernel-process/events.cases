# Process events for `kernel-process events`: `trap VECTOR ERROR RIP CS RFLAGS
# RSP SS CR2 OPCODE` classifies a copied interrupt frame (OPCODE is the two
# bytes at RIP, first byte low, or 0x10000 when they are not executable) and
# `call OPERATION A B C` decodes a kernel call. A user frame has CS 0x1b, SS
# 0x23, RIP below 2^47, RFLAGS with IF and bit 1 and only CPL 3 bits.
# The stack's guard page is [0x7ffffe7ff000, 0x7ffffe800000).
trap 64 0 0x401000 0x1b 0x202 0x7fffff000000 0x23 0 0x10000
trap 131 0 0x401000 0x1b 0x246 0x7fffff000000 0x23 0 0x10000
trap 6 0 0x401000 0x1b 0x202 0x7fffff000000 0x23 0 0x050f
trap 6 0 0x401000 0x1b 0x202 0x7fffff000000 0x23 0 0x340f
trap 6 0 0x401000 0x1b 0x202 0x7fffff000000 0x23 0 0x0b0f
trap 6 0 0x401000 0x1b 0x202 0x7fffff000000 0x23 0 0x10000
trap 14 6 0x401000 0x1b 0x202 0x7ffffe7ffff8 0x23 0x7ffffe7ffff8 0x10000
trap 14 6 0x401000 0x1b 0x202 0x7ffffe7ff000 0x23 0x7ffffe7ff000 0x10000
trap 14 6 0x401000 0x1b 0x202 0x7ffffe7fefff 0x23 0x7ffffe7feff8 0x10000
trap 14 6 0x401000 0x1b 0x202 0x7ffffe800000 0x23 0x7ffffe800000 0x10000
trap 14 4 0x401000 0x1b 0x202 0x7fffff000000 0x23 0 0x10000
trap 13 0 0x401000 0x1b 0x202 0x7fffff000000 0x23 0 0x10000
trap 12 0 0x401000 0x1b 0x202 0x7fffff000000 0x23 0 0x10000
trap 11 0 0x401000 0x1b 0x202 0x7fffff000000 0x23 0 0x10000
trap 0 0 0x401000 0x1b 0x202 0x7fffff000000 0x23 0 0x10000
trap 1 0 0x401000 0x1b 0x302 0x7fffff000000 0x23 0 0x10000
trap 3 0 0x401000 0x1b 0x202 0x7fffff000000 0x23 0 0x10000
trap 4 0 0x401000 0x1b 0x202 0x7fffff000000 0x23 0 0x10000
trap 5 0 0x401000 0x1b 0x202 0x7fffff000000 0x23 0 0x10000
trap 7 0 0x401000 0x1b 0x202 0x7fffff000000 0x23 0 0x10000
trap 16 0 0x401000 0x1b 0x202 0x7fffff000000 0x23 0 0x10000
trap 17 0 0x401000 0x1b 0x202 0x7fffff000000 0x23 0 0x10000
trap 19 0 0x401000 0x1b 0x202 0x7fffff000000 0x23 0 0x10000
# Not program faults: NMI, double fault, machine check, reserved and others.
trap 2 0 0x401000 0x1b 0x202 0x7fffff000000 0x23 0 0x10000
trap 8 0 0x401000 0x1b 0x202 0x7fffff000000 0x23 0 0x10000
trap 18 0 0x401000 0x1b 0x202 0x7fffff000000 0x23 0 0x10000
trap 21 0 0x401000 0x1b 0x202 0x7fffff000000 0x23 0 0x10000
trap 255 0 0x401000 0x1b 0x202 0x7fffff000000 0x23 0 0x10000
# Frames that are not a user frame stop the machine.
trap 14 0 0x401000 0x08 0x202 0x7fffff000000 0x23 0 0x10000
trap 14 0 0x401000 0x1b 0x202 0x7fffff000000 0x10 0 0x10000
trap 14 0 0x800000000000 0x1b 0x202 0x7fffff000000 0x23 0 0x10000
trap 14 0 0x401000 0x1b 0x2 0x7fffff000000 0x23 0 0x10000
trap 14 0 0x401000 0x1b 0x200 0x7fffff000000 0x23 0 0x10000
trap 14 0 0x401000 0x1b 0x3202 0x7fffff000000 0x23 0 0x10000
trap 14 0 0x401000 0x1b 0x20202 0x7fffff000000 0x23 0 0x10000
trap 14 0 0x401000 0x1b 0x254fd7 0x7fffff000000 0x23 0 0x10000
trap 14 0 0x401000 0x1b 0x254fdf 0x7fffff000000 0x23 0 0x10000
# Kernel calls: 1 exit(status), 2 print(stream, buffer, length), 3
# read(file, offset, chunk).
call 1 0 0 0
call 1 255 0 0
call 1 256 0 0
call 2 1 0x7ffffe800000 4096
call 2 2 0x7ffffe800000 65536
call 2 2 0x7ffffe800000 65537
call 2 0 0x7ffffe800000 1
call 2 3 0x7ffffe800000 1
call 3 1 0 0x7ffffe800000
call 3 0xffffffffffffffff 0xffffffffffffffff 0
call 0 0 0 0
call 4 0 0 0
call 0xffffffffffffffff 0 0 0
# File calls (`call OPERATION A B C D`, D the result record): 7
# open_directory, 8 open_beneath, 9 open_file and 11 create_output (handle,
# path, length up to 64 KiB, record); 10 close, 12 write(output, buffer,
# length up to 64 KiB), 13 commit and 14 discard. Only open_beneath names a
# handle with a path; unused arguments are ignored; 15 is unknown.
call 7 0 0x7ffffe800000 4 0x7ffffe801000
call 7 65 0x7ffffe800000 4 0x7ffffe801000
call 8 65 0x7ffffe800000 65536 0x7ffffe801000
call 8 65 0x7ffffe800000 65537 0x7ffffe801000
call 9 0 0x7ffffe800000 4096 0
call 11 0 0x7ffffe800000 10 0x7ffffe801000
call 10 66 0x7ffffe800000 7 9
call 12 97 0x7ffffe800000 65536 0x7ffffe801000
call 12 97 0x7ffffe800000 65537 0
call 13 97 0 0 0
call 14 0xffffffffffffffff 0 0 0
call 15 0 0 0 0

# Foreground input scalar protocol: no grant or native wait simulated here.
input 100 0 0 0 1 65
input 100 0 7 0 1 4
input 100 1 7 0 3 0
input 100 1 0 0 1 65
input 100 0 7 0 1 3
input 100 2 0 0 1 65
input 100 0 0 0 0 40
input 60 0 0 0 0 60
input 100 0 3 0 2 0
input 100 0 3 0 4 0
input 100 0 0 1 1 10
input 100 0 0 1 1 65
input 100 0 503 0 1 65
input 100 0 504 0 3 0

