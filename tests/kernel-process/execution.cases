output_resume prepare:loaded:exited:1 advance:output:unavailable:0 output:success advance:retired:exited:8 finish:complete:success
output_failure prepare:loaded:exited:1 advance:output:unavailable:0 output:failed finish:output_failed:success
request_resume prepare:loaded:exited:1 advance:request:unavailable:0 request:ready advance:retired:exited:9 finish:complete:success
request_cancelled prepare:loaded:exited:1 advance:request:unavailable:0 request:cancelled finish:cancelled:success
service_lost prepare:loaded:exited:1 advance:request:unavailable:0 request:service_lost finish:service_lost:success
multiple_effects prepare:loaded:exited:1 advance:output:unavailable:0 output:success advance:request:unavailable:0 request:ready advance:parked:unavailable:0 advance:retired:exited:13 finish:complete:success
