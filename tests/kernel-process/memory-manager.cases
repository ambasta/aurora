# Real source owner over bounded hosted physical effects, not a second policy model.
case lifecycle 1024
prepare 0 16 128 7
region 0 4194304 1 5
live 0
verify 0
map 0 1
map 0 65536
commit 0 0
verify 0
remap 0 65536 32768
verify 0
remap 0 32768 131072
verify 0
unmap 0 65536
unmap 0 131072
verify 0
audit
retire 0
audit
end

