# Modeled finite-generation boundary: only valid free-record generations are
# advanced. Source allocation/release performs every retirement and rollback.
case staged-rollback-generation-boundary 60
prepare 0 16 0 7
region 0 4194304 1 5
live 0
generation-boundary
map 0 65536
commit 0 0
unmap 0 65536
map 0 65536
commit 0 0
unmap 0 65536
map 0 65536
commit-rollback 0 0
verify 0
audit
unmap 0 65536
retire 0
end

