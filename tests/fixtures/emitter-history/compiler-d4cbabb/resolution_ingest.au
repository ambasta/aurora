export module aurora.compiler.resolution_ingest;
import aurora.compiler.lexer;
import aurora.compiler.resolution_kinds;
import aurora.compiler.resolution_rows;
import aurora.compiler.resolution_arena;
import aurora.compiler.syntax_arena;
import aurora.compiler.lowering_kinds;
import aurora.compiler.lowering_errors;
import aurora.compiler.lowering_storage;

// Ingest copies one parsed module into Session rows and projects every token
// coordinate to a source reference.
namespace compiler_resolver {
    auto translate_index(Session& session, i64 base, i64 count, i64 index) -> i64 {
        if (index == -1) {
            return -1;
        }
        if (base < 0 || count < 0 || index < 0 || index >= count || index > 9223372036854775807 - base) {
            return session.fail_storage(StorageStatus::invalid);
        }
        return base + index;
    }
    auto request_source(Session& session, i64 row, i64 slot, i64 ordinal, i64 half) -> bool {
        if (ordinal == -1 && half == 0) {
            return true;
        }
        if (ordinal < 0 || (half != 0 && half != 1)) {
            session.fail_storage(StorageStatus::invalid);
            return false;
        }
        const WorkRow request = WorkRow(ordinal, row, slot, half, -1, -1);
        return session.append_work(request) >= 0;
    }
    auto source_requests(Session& session, i64 begin, i64 end) -> bool {
        if (session.work_count() != 0 || begin < 0 || end < begin || end > session.syntax_count()) {
            session.fail_storage(StorageStatus::invalid);
            return false;
        }
        i64 at = begin;
        while (at < end && session.good()) {
            const SyntaxRow row = session.syntax(at);
            if (row.kind() == SyntaxTag::expression) {
                request_source(session, at, 0, row.word(0), 0);
                request_source(session, at, 4, row.word(4), 0);
                request_source(session, at, 5, row.word(5), 0);
            } else {
                if (row.kind() == SyntaxTag::edge) {
                    request_source(session, at, 4, row.word(4), 0);
                } else {
                    if (row.kind() == SyntaxTag::type) {
                        request_source(session, at, 0, row.word(0), 0);
                        request_source(session, at, 1, row.word(1), 0);
                        if (row.word(2) < 0) {
                            session.fail_storage(StorageStatus::invalid);
                        } else {
                            request_source(session, at, 2, row.word(2) / 2, row.word(2) % 2);
                        }
                        request_source(session, at, 5, row.word(5), 0);
                    } else {
                        if (row.kind() != SyntaxTag::declaration) {
                            session.fail_storage(StorageStatus::invalid);
                        } else {
                            request_source(session, at, 0, row.word(0), 0);
                            request_source(session, at, 1, row.word(1), 0);
                            request_source(session, at, 6, row.word(6), 0);
                            request_source(session, at, 10, row.word(10), 0);
                        }
                    }
                }
            }
            at = at + 1;
        }
        return session.good();
    }
    // Publishes one requested half of a token from its half-0 reference row; half
    // 1 starts one byte later, at the second '>' of a split '>>'.
    auto make_reference(Session& session, MetaRow token_row, i64 half) -> i64 {
        MetaRow row = token_row;
        row.set_word(1, token_row.word(1) + half);
        row.set_word(4, token_row.word(4) + half);
        row.set_word(6, half);
        return session.append_meta(row);
    }
    // Requests occupy the first n scratch rows. Row n + o then records, for token
    // ordinal o, whether half 0 and half 1 were requested (words 0 and 1) and the
    // references made for them (words 2 and 3). References are made in (ordinal,
    // half) order during one token scan, so a module's references are one sorted
    // metadata range. Index keys (9, module, -1) and (9, module, -2) hold its
    // bounds for ingested_reference; the range needs no per-reference index row.
    auto project_sources(Session& session, i64 module_id) -> bool {
        const i64 requests = session.work_count();
        const MetaRow source = session.meta(module_id);
        if (source.kind() != MetaTag::module_source) {
            session.fail_storage(StorageStatus::invalid);
            session.truncate_work(0);
            return false;
        }
        // Every token spans at least one byte, so a valid ordinal never exceeds the
        // module length; a larger one would be past the end of input.
        i64 last = -1;
        i64 request = 0;
        while (request < requests && session.good()) {
            const WorkRow item = session.work(request);
            const i64 half = item.word(3);
            if (item.word(0) < 0 || item.word(0) > source.word(1) || half < 0 || half > 1) {
                session.fail_storage(StorageStatus::invalid);
            }
            if (item.word(0) > last) {
                last = item.word(0);
            }
            request = request + 1;
        }
        i64 ordinal = 0;
        while (ordinal <= last && session.good()) {
            session.append_work(WorkRow(0, 0, -1, -1, -1, -1));
            ordinal = ordinal + 1;
        }
        request = 0;
        while (request < requests && session.good()) {
            const WorkRow item = session.work(request);
            const i64 slot = requests + item.word(0);
            WorkRow marks = session.work(slot);
            if (marks.word(item.word(3)) == 0) {
                marks.set_word(item.word(3), 1);
                session.set_work(slot, marks);
            }
            request = request + 1;
        }
        const i64 first_reference = session.meta_count();
        i64 offset = 0;
        i64 line = 1;
        i64 line_start = 0;
        ordinal = 0;
        bool complete = last < 0;
        while (!complete && session.good()) {
            const compiler_lexer::Cursor cursor = compiler_lexer::Cursor(offset, line, line_start);
            const compiler_lexer::Lexeme token = session.scan(module_id, cursor);
            if (token.kind() == compiler_lexer::Event::token || token.kind() == compiler_lexer::Event::end_of_input) {
                const i64 slot = requests + ordinal;
                const WorkRow marks = session.work(slot);
                i64 first = -1;
                i64 second = -1;
                if (token.kind() == compiler_lexer::Event::end_of_input && ordinal != last) {
                    session.fail_storage(StorageStatus::invalid);
                }
                if (marks.word(0) != 0 || marks.word(1) != 0) {
                    MetaRow token_row = MetaRow(MetaTag::source_reference);
                    token_row.set_word(0, module_id);
                    token_row.set_word(1, source.word(0) + offset);
                    token_row.set_word(2, source.word(0) + token.next_offset());
                    token_row.set_word(3, line);
                    token_row.set_word(4, offset - line_start + 1);
                    token_row.set_word(5, ordinal);
                    token_row.set_word(6, 0);
                    token_row.set_word(7, token.next_line());
                    token_row.set_word(8, token.next_offset() - token.next_line_start() + 1);
                    token_row.set_word(9, 0);
                    if (marks.word(0) != 0) {
                        first = make_reference(session, token_row, 0);
                    }
                    if (marks.word(1) != 0 && session.good()) {
                        if (token.kind() != compiler_lexer::Event::token || token.next_offset() - offset != 2
                            || session.source_byte(source.word(0) + offset) != '>' || session.source_byte(source.word(0)
                            + offset + 1) != '>') {
                            session.fail_storage(StorageStatus::invalid);
                        } else {
                            second = make_reference(session, token_row, 1);
                        }
                    }
                    if (session.good()) {
                        session.set_work(slot, WorkRow(marks.word(0), marks.word(1), first, second, -1, -1));
                    }
                }
                if (token.kind() == compiler_lexer::Event::end_of_input || ordinal == last) {
                    complete = true;
                } else {
                    ordinal = ordinal + 1;
                }
            } else {
                if (token.kind() != compiler_lexer::Event::whitespace && token.kind()
                    != compiler_lexer::Event::line_comment) {
                    session.fail_storage(StorageStatus::invalid);
                }
            }
            if (session.good() && token.kind() != compiler_lexer::Event::end_of_input && (token.next_offset() <= offset
                || token.next_offset() > source.word(1))) {
                session.fail_storage(StorageStatus::invalid);
            }
            offset = token.next_offset();
            line = token.next_line();
            line_start = token.next_line_start();
        }
        const i64 end_reference = session.meta_count();
        if (session.good() && (session.index_insert(9, module_id, -1, 0, 0, first_reference) != first_reference
            || session.index_insert(9, module_id, -2, 0, 0, end_reference) != end_reference)) {
            session.fail_storage(StorageStatus::invalid);
        }
        request = 0;
        while (request < requests && session.good()) {
            const WorkRow item = session.work(request);
            const WorkRow marks = session.work(requests + item.word(0));
            const i64 reference_row = marks.word(2 + item.word(3));
            SyntaxRow row = session.syntax(item.word(1));
            if (row.word(11) != module_id || !row.set_word(item.word(2), reference_row)
                || !session.set_syntax(item.word(1), row)) {
                session.fail_storage(StorageStatus::invalid);
            }
            request = request + 1;
        }
        session.truncate_work(0);
        return session.good();
    }
}

export namespace compiler_resolver {
    // Both owning inputs are transferred into distinct generated argument slots.
    // Every return transfers Session and normally drops parsed, including failure.
    auto ingest(builtin::ByteRegion region, Session session, compiler_parser::AstArena parsed, i64 module_id,
        i64 root) -> Session {
        if (!session.good()) {
            return move(session);
        }
        if (module_id < 0 || module_id >= session.module_count() || module_id != session.module_count() - 1
            || !parsed.ok() || parsed.stack_size() != 0 || session.work_count() != 0) {
            session.fail_storage(StorageStatus::invalid);
            return move(session);
        }
        MetaRow module_row = session.meta(module_id);
        const i64 expressions = parsed.size();
        const i64 edges = parsed.arguments();
        const i64 types = parsed.types();
        const i64 declarations = parsed.syntax_size();
        const i64 bytes = module_row.word(1);
        if (module_row.kind() != MetaTag::module_source || module_row.word(10) != -1 || bytes < 0 || bytes > 1048576
            || module_row.word(0) < 0 || module_row.word(0) > session.source_size() || bytes > session.source_size()
            - module_row.word(0) || expressions < 0 || edges < 0 || types < 0 || declarations < 1 || expressions > bytes
            || edges > bytes || types > bytes || declarations > bytes || root < 0 || root >= declarations) {
            session.fail_storage(StorageStatus::invalid);
            return move(session);
        }
        const compiler_parser::SyntaxNode parsed_root = parsed.syntax_at(root);
        if (parsed_root.kind() != compiler_parser::SyntaxKind::module_definition || parsed_root.previous() != -1) {
            session.fail_storage(StorageStatus::invalid);
            return move(session);
        }
        const i64 total = expressions + edges + types + declarations;
        const i64 first = session.syntax_count();
        if (total > 9223372036854775807 - first) {
            session.fail_storage(StorageStatus::invalid);
            return move(session);
        }
        const i64 expression_base = first;
        const i64 edge_base = first + expressions;
        const i64 type_base = edge_base + edges;
        const i64 declaration_base = type_base + types;
        module_row.set_word(2, expression_base);
        module_row.set_word(3, expressions);
        module_row.set_word(4, edge_base);
        module_row.set_word(5, edges);
        module_row.set_word(6, type_base);
        module_row.set_word(7, types);
        module_row.set_word(8, declaration_base);
        module_row.set_word(9, declarations);
        if (!session.set_meta(module_id, module_row)) {
            return move(session);
        }
        i64 at = 0;
        while (at < expressions && session.good()) {
            const compiler_parser::AstNode node = parsed.at(at);
            SyntaxRow row = SyntaxRow(SyntaxTag::expression);
            row.set_expression_kind(node.kind());
            row.set_word(0, node.token());
            row.set_word(3, node.depth());
            row.set_word(4, node.last());
            row.set_word(5, node.close());
            row.set_word(11, module_id);
            if (node.token() < 0 || node.last() < node.token() || node.close() < node.last() || node.depth() < 1
                || node.depth() > 128 || node.kind() == compiler_parser::NodeKind::invalid) {
                session.fail_storage(StorageStatus::invalid);
            } else {
                if (node.kind() == compiler_parser::NodeKind::literal || node.kind()
                    == compiler_parser::NodeKind::name) {
                    if (node.first() != -1 || node.second() != -1) {
                        session.fail_storage(StorageStatus::invalid);
                    }
                } else {
                    if (node.kind() == compiler_parser::NodeKind::unary || node.kind()
                        == compiler_parser::NodeKind::member) {
                        if (node.first() < 0 || node.first() >= at || node.second() != -1) {
                            session.fail_storage(StorageStatus::invalid);
                        }
                        row.set_word(1, translate_index(session, expression_base, expressions, node.first()));
                    } else {
                        if (node.kind() == compiler_parser::NodeKind::binary || node.kind()
                            == compiler_parser::NodeKind::index) {
                            if (node.first() < 0 || node.first() >= at || node.second() < 0 || node.second() >= at) {
                                session.fail_storage(StorageStatus::invalid);
                            }
                            row.set_word(1, translate_index(session, expression_base, expressions, node.first()));
                            row.set_word(2, translate_index(session, expression_base, expressions, node.second()));
                        } else {
                            if (node.kind() != compiler_parser::NodeKind::call && node.kind()
                                != compiler_parser::NodeKind::method_call && node.kind()
                                != compiler_parser::NodeKind::array_literal && node.kind()
                                != compiler_parser::NodeKind::construct && node.kind()
                                != compiler_parser::NodeKind::array_zero) {
                                session.fail_storage(StorageStatus::invalid);
                            }
                            if (node.second() < 0 || node.second() > edges || (node.first() == -1 && node.second() != 0)
                                || (node.first() >= 0 && node.second() == 0)) {
                                session.fail_storage(StorageStatus::invalid);
                            }
                            row.set_word(1, translate_index(session, edge_base, edges, node.first()));
                            row.set_word(2, node.second());
                        }
                    }
                }
            }
            if (session.good() && session.append_syntax(row) != expression_base + at) {
                session.fail_storage(StorageStatus::invalid);
            }
            at = at + 1;
        }
        at = 0;
        while (at < edges && session.good()) {
            const compiler_parser::ChildEdge node = parsed.edge(at);
            SyntaxRow row = SyntaxRow(SyntaxTag::edge);
            if (node.child() < 0 || node.child() >= expressions || node.previous() < -1 || node.previous() >= at
                || node.count() < 1 || node.count() > edges || node.depth() < 1 || node.depth() > 128 || node.field()
                < -1 || (node.previous() == -1 && node.count() != 1)) {
                session.fail_storage(StorageStatus::invalid);
            }
            row.set_word(0, translate_index(session, expression_base, expressions, node.child()));
            row.set_word(1, translate_index(session, edge_base, edges, node.previous()));
            row.set_word(2, node.count());
            row.set_word(3, node.depth());
            row.set_word(4, node.field());
            row.set_word(11, module_id);
            if (session.good() && session.append_syntax(row) != edge_base + at) {
                session.fail_storage(StorageStatus::invalid);
            }
            at = at + 1;
        }
        at = 0;
        while (at < types && session.good()) {
            const compiler_parser::TypeSyntax node = parsed.type_at(at);
            SyntaxRow row = SyntaxRow(SyntaxTag::type);
            if (node.kind() == compiler_parser::TypeKind::invalid || node.token() < 0 || node.last() < node.token()
                || node.last() > 4611686018427387903 || node.close() < node.last() * 2 || node.first() < -1
                || node.first() >= at || node.second() < -1 || node.second() >= at || (node.first() == -1
                && node.second() != -1) || (node.first() >= 0 && node.first() == node.second()) || node.owner() < -1
                || node.role() < 0 || node.role() > 3 || (node.owner() == -1 && node.role() != 0) || (node.owner() >= 0
                && node.role() == 0)) {
                session.fail_storage(StorageStatus::invalid);
            }
            row.set_type_kind(node.kind());
            row.set_word(0, node.token());
            row.set_word(1, node.last());
            row.set_word(2, node.close());
            row.set_word(3, translate_index(session, type_base, types, node.first()));
            row.set_word(4, translate_index(session, type_base, types, node.second()));
            row.set_word(5, node.owner());
            row.set_word(6, node.role());
            row.set_word(11, module_id);
            if (session.good() && session.append_syntax(row) != type_base + at) {
                session.fail_storage(StorageStatus::invalid);
            }
            at = at + 1;
        }
        at = 0;
        while (at < declarations && session.good()) {
            const compiler_parser::SyntaxNode node = parsed.syntax_at(at);
            SyntaxRow row = SyntaxRow(SyntaxTag::declaration);
            if (node.kind() == compiler_parser::SyntaxKind::invalid || node.token() < 0 || node.end() <= node.token()
                || node.previous() < -1 || node.previous() >= at || node.body() < -1 || node.body() >= at
                || node.other() < -1 || node.other() >= at || node.binding() < -1 || node.borrow_site() < -1
                || node.mutable_binding() < 0 || node.mutable_binding() > 1) {
                session.fail_storage(StorageStatus::invalid);
            }
            row.set_declaration_kind(node.kind());
            row.set_word(0, node.token());
            row.set_word(1, node.end());
            row.set_word(2, translate_index(session, declaration_base, declarations, node.previous()));
            row.set_word(3, translate_index(session, expression_base, expressions, node.expression()));
            row.set_word(4, translate_index(session, expression_base, expressions, node.target()));
            row.set_word(5, translate_index(session, type_base, types, node.type()));
            row.set_word(6, node.binding());
            if (node.kind() == compiler_parser::SyntaxKind::import_name) {
                row.set_word(6, node.end() - 1);
            }
            row.set_word(7, translate_index(session, declaration_base, declarations, node.body()));
            row.set_word(8, translate_index(session, declaration_base, declarations, node.other()));
            row.set_word(9, node.mutable_binding());
            row.set_word(10, node.borrow_site());
            row.set_word(11, module_id);
            if (session.good() && session.append_syntax(row) != declaration_base + at) {
                session.fail_storage(StorageStatus::invalid);
            }
            at = at + 1;
        }
        if (!session.good() || session.syntax_count() != first + total || !source_requests(session, first, first
            + total) || !project_sources(session, module_id)) {
            session.truncate_work(0);
            return move(session);
        }
        module_row.set_word(10, declaration_base + root);
        module_row.set_kind(MetaTag::module_unit);
        session.set_meta(module_id, module_row);
        return move(session);
    }
}
