export module aurora.compiler.ir_verification_errors;

// Private production verifier error/status support.
// Exact dynamic verifier diagnostics. Admission diagnostics remain independently owned.
export namespace compiler_ir_verification {
    enum class VerificationStatus {
        pending,
        success,
        allocation,
        invalid
    };
    enum class VerificationErrorFirst {
        none,
        //: invalid hosted IR verification workspace
        internal,
        //: hosted IR verification allocation failed
        allocation,
