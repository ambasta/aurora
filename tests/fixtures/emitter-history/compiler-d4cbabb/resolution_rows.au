export module aurora.compiler.resolution_rows;
import aurora.compiler.resolution_kinds;
import aurora.compiler.syntax_arena;

// Copied rows of one resolution Session. Pointer-free; every index is checked by Session.
//
// Source-row words (all optional indices use -1):
// expression: token, first, second, depth, last, close, attached-type, role, ..., source-module.
// edge: child, previous, count, depth, field-token, ..., source-module.
// type: token, last, half-close, first, second, owner-token, role, ..., source-module.
// declaration: token, end, previous, expression, target, type, binding, body,
//              other, qualifier, borrow-token, source-module.
// Import binding additionally projects its final name token. Ingest translates
// every child/list index to a Session row and each token to a source-reference.
//
// Metadata words owned here:
// module slot 0..63: source-start/length, four base/count pairs, root, module-id,
//                   graph-order, module-scope, root-flag.
// source-reference: module-id, begin/end bytes, begin line/column, ordinal/half,
//                   end line/column, synthetic-origin (zero for real modules).
// Immutable linkage references use module -1 and word 9 = owning symbol; only
// their begin/end range is observable, never a diagnostic token coordinate.
// atom: source-start/length/reference. prefix: parent/atom/depth.
// index: domain, four keys, value, left/right/parent/height.
// import: defining-module, target-module, syntax, exact-name-reference, next.
// Remaining metadata variants belong to resolver.au's semantic ledger.
export namespace compiler_resolver {
    enum class StorageStatus {
        none,
        allocation,
        invalid,
        limit
    };
    enum class SyntaxTag {
        invalid,
        expression,
        edge,
        type,
        declaration
    };
    enum class MetaTag {
        invalid,
        module_source,
        module_unit,
        source_reference,
        atom,
        prefix,
        import_name,
        symbol,
        overload,
        concrete_type,
        instance,
        signature,
        public_type,
        authority,
        visibility,
        request,
        link,
        context
    };
    // A copied linkage-only view. Invalid selectors return size -1; offset equal
    // to the name length returns an empty chunk. No source address escapes.
    class LinkageChunk {
        builtin::array<u8, 512> payload;
        i64 byteCount;
    public:
        LinkageChunk() : payload{}, byteCount(0) {
        }
        auto size() const -> i64 {
            return byteCount;
        }
        auto at(i64 index) const -> u8 {
            return payload[index];
        }
        auto append(u8 value) -> bool {
            if (byteCount >= 512) {
                return false;
            }
            payload[byteCount] = value;
            byteCount = byteCount + 1;
            return true;
        }
        auto invalidate() -> bool {
            byteCount = -1;
            return false;
        }
    };
    class SyntaxRow {
        SyntaxTag tag;
        compiler_parser::NodeKind expression_tag;
        compiler_parser::TypeKind type_tag;
        compiler_parser::SyntaxKind declaration_tag;
        i64 value0;
        i64 value1;
        i64 value2;
        i64 value3;
        i64 value4;
        i64 value5;
        i64 value6;
        i64 value7;
        i64 value8;
        i64 value9;
        i64 value10;
        i64 value11;
    public:
        SyntaxRow(SyntaxTag kind) : tag(kind), expression_tag(compiler_parser::NodeKind::invalid),
            type_tag(compiler_parser::TypeKind::invalid), declaration_tag(compiler_parser::SyntaxKind::invalid),
            value0(-1), value1(-1), value2(-1), value3(-1), value4(-1), value5(-1), value6(-1), value7(-1), value8(-1),
            value9(-1), value10(-1), value11(-1) {
        }
        auto kind() const -> SyntaxTag {
            return tag;
        }
        auto set_kind(SyntaxTag kind) -> bool {
            tag = kind;
            return true;
        }
        auto expression_kind() const -> compiler_parser::NodeKind {
            return expression_tag;
        }
        auto set_expression_kind(compiler_parser::NodeKind kind) -> bool {
            expression_tag = kind;
            return true;
        }
        auto type_kind() const -> compiler_parser::TypeKind {
            return type_tag;
        }
        auto set_type_kind(compiler_parser::TypeKind kind) -> bool {
            type_tag = kind;
            return true;
        }
        auto declaration_kind() const -> compiler_parser::SyntaxKind {
            return declaration_tag;
        }
        auto set_declaration_kind(compiler_parser::SyntaxKind kind) -> bool {
            declaration_tag = kind;
            return true;
        }
        auto word(i64 slot) const -> i64 {
            if (slot == 0) {
                return value0;
            }
            if (slot == 1) {
                return value1;
            }
            if (slot == 2) {
                return value2;
            }
            if (slot == 3) {
                return value3;
            }
            if (slot == 4) {
                return value4;
            }
            if (slot == 5) {
                return value5;
            }
            if (slot == 6) {
                return value6;
            }
            if (slot == 7) {
                return value7;
            }
            if (slot == 8) {
                return value8;
            }
            if (slot == 9) {
                return value9;
            }
            if (slot == 10) {
                return value10;
            }
            if (slot == 11) {
                return value11;
            }
            return -1;
        }
        auto set_word(i64 slot, i64 value) -> bool {
            if (slot == 0) {
                value0 = value;
                return true;
            }
            if (slot == 1) {
                value1 = value;
                return true;
            }
            if (slot == 2) {
                value2 = value;
                return true;
            }
            if (slot == 3) {
                value3 = value;
                return true;
            }
            if (slot == 4) {
                value4 = value;
                return true;
            }
            if (slot == 5) {
                value5 = value;
                return true;
            }
            if (slot == 6) {
                value6 = value;
                return true;
            }
            if (slot == 7) {
                value7 = value;
                return true;
            }
            if (slot == 8) {
                value8 = value;
                return true;
            }
            if (slot == 9) {
                value9 = value;
                return true;
            }
            if (slot == 10) {
                value10 = value;
                return true;
            }
            if (slot == 11) {
                value11 = value;
                return true;
            }
            return false;
        }
    };
    class MetaRow {
        MetaTag tag;
        ResolvedTypeKind concrete_tag;
        DeclarationKind declaration_tag;
        NativeMode native_tag;
        i64 value0;
        i64 value1;
        i64 value2;
        i64 value3;
        i64 value4;
        i64 value5;
        i64 value6;
        i64 value7;
        i64 value8;
        i64 value9;
        i64 value10;
        i64 value11;
        i64 value12;
        i64 value13;
        i64 value14;
    public:
        MetaRow(MetaTag kind) : tag(kind), concrete_tag(ResolvedTypeKind::invalid),
            declaration_tag(DeclarationKind::invalid), native_tag(NativeMode::invalid), value0(-1), value1(-1),
            value2(-1), value3(-1), value4(-1), value5(-1), value6(-1), value7(-1), value8(-1), value9(-1), value10(-1),
            value11(-1), value12(-1), value13(-1), value14(-1) {
