        }
        auto set_native_mode(NativeMode kind) -> bool {
            native_tag = kind;
            return true;
        }
        auto set_kind(MetaTag kind) -> bool {
            tag = kind;
            return true;
        }
        // Atom keys use checked source-byte ordering in Session; other domains use these scalar keys.
        auto word(i64 slot) const -> i64 {
            if (slot == 0) {
                return value0;
            }
            if (slot == 1) {
                return value1;
            }
            if (slot == 2) {
                return value2;
            }
            if (slot == 3) {
                return value3;
            }
            if (slot == 4) {
                return value4;
            }
            if (slot == 5) {
                return value5;
            }
            if (slot == 6) {
                return value6;
            }
            if (slot == 7) {
                return value7;
            }
            if (slot == 8) {
                return value8;
            }
            if (slot == 9) {
                return value9;
            }
            if (slot == 10) {
                return value10;
            }
            if (slot == 11) {
                return value11;
            }
            if (slot == 12) {
                return value12;
            }
            if (slot == 13) {
                return value13;
            }
            if (slot == 14) {
                return value14;
            }
            return -1;
        }
        auto set_word(i64 slot, i64 value) -> bool {
            if (slot == 0) {
                value0 = value;
                return true;
            }
            if (slot == 1) {
                value1 = value;
                return true;
            }
            if (slot == 2) {
                value2 = value;
                return true;
            }
            if (slot == 3) {
                value3 = value;
                return true;
            }
            if (slot == 4) {
                value4 = value;
                return true;
            }
            if (slot == 5) {
                value5 = value;
                return true;
            }
            if (slot == 6) {
                value6 = value;
                return true;
            }
            if (slot == 7) {
                value7 = value;
                return true;
            }
            if (slot == 8) {
                value8 = value;
                return true;
            }
            if (slot == 9) {
                value9 = value;
                return true;
            }
            if (slot == 10) {
                value10 = value;
                return true;
            }
            if (slot == 11) {
                value11 = value;
                return true;
            }
            if (slot == 12) {
                value12 = value;
                return true;
            }
            if (slot == 13) {
                value13 = value;
                return true;
            }
            if (slot == 14) {
                value14 = value;
                return true;
            }
            return false;
        }
    };
    class IndexRow {
        i64 domain;
        i64 key0;
        i64 key1;
        i64 key2;
        i64 key3;
        i64 payload;
        i64 left;
        i64 right;
        i64 parent;
        i64 height;
        i64 chain;
        i64 bucket;
    public:
        IndexRow(i64 kind, i64 first, i64 second, i64 third, i64 fourth, i64 value) : domain(kind), key0(first),
            key1(second), key2(third), key3(fourth), payload(value), left(-1), right(-1), parent(-1), height(1),
            chain(-1), bucket(-1) {
        }
        auto key_domain() const -> i64 {
            return domain;
        }
        auto first_key() const -> i64 {
            return key0;
        }
        auto second_key() const -> i64 {
            return key1;
        }
        auto third_key() const -> i64 {
            return key2;
        }
        auto fourth_key() const -> i64 {
            return key3;
        }
        auto value() const -> i64 {
            return payload;
        }
        auto left_child() const -> i64 {
            return left;
        }
        auto right_child() const -> i64 {
            return right;
        }
        auto parent_node() const -> i64 {
            return parent;
        }
        auto tree_height() const -> i64 {
            return height;
        }
        auto set_value(i64 value) -> bool {
            payload = value;
            return true;
        }
        auto set_left(i64 value) -> bool {
            left = value;
            return true;
        }
        auto set_right(i64 value) -> bool {
            right = value;
            return true;
        }
        auto set_parent(i64 value) -> bool {
            parent = value;
            return true;
        }
        auto set_height(i64 value) -> bool {
            height = value;
            return true;
        }
        // Next node whose key hashes to the same bucket, and, in row b, the first
        // node of bucket b.
        auto chain_next() const -> i64 {
            return chain;
        }
        auto set_chain(i64 value) -> bool {
            chain = value;
            return true;
        }
        auto bucket_head() const -> i64 {
            return bucket;
        }
        auto set_bucket(i64 value) -> bool {
            bucket = value;
            return true;
        }
        auto key_order(i64 wanted, i64 first, i64 second, i64 third, i64 fourth) const -> i64 {
            if (wanted < domain) {
                return -1;
            }
            if (wanted > domain) {
                return 1;
            }
            if (first < key0) {
                return -1;
            }
            if (first > key0) {
                return 1;
            }
            if (second < key1) {
                return -1;
            }
            if (second > key1) {
                return 1;
            }
            if (third < key2) {
                return -1;
            }
            if (third > key2) {
                return 1;
            }
            if (fourth < key3) {
                return -1;
            }
            if (fourth > key3) {
                return 1;
            }
            return 0;
        }
    };

    class ResolvedRow {
        ResolvedOperation operation_tag;
        i64 value0;
        i64 value1;
        i64 value2;
        i64 value3;
        i64 value4;
        i64 value5;
        i64 value6;
