module blocks_entry_probe;
import aurora.blocks;
import aurora.memory;
import storage.block_io;
import storage.sector;
import std.binary_buffer;
import std.binary;

auto read_pair(builtin::ServeSession& session, builtin::ReadOnlyBlocks& volumes, builtin::ByteRegion region,
    u64 lba) -> storage::SectorReadResult {
    builtin::OwnedBytes local = region.try_allocate(1);
    if (local.ok()) {
        local.set(0, 7u8);
    }
    const storage::SectorReadResult result = blocks::read_sector(volumes, 0u64, lba);
    return result;
}
auto main(builtin::ServeSession& session, builtin::ReadOnlyBlocks& volumes, builtin::ByteRegion region,
    builtin::span<const u8> arguments) -> builtin::HostExit {
    const storage::SectorReadResult result = read_pair(session, volumes, region, 0u64);
    if (blocks::sector_count(volumes, 0u64) == 0u64 && blocks::volume_generation(volumes, 0u64) == 0u64
        && result.status() == storage::SectorIoStatus::invalid_source) {
        return builtin::HostExit::success;
    }
    return builtin::HostExit::failure;
}
