module host_files_probe;
import aurora.host;

// The HostFiles test driver. Its arguments are a script of operations, each
// one word followed by its operands; every operation prints one line,
// "ORDINAL OPERATION STATUS [VALUE]". An id operand is @N, the id the Nth
// operation returned, or a decimal literal, so stale, forged and foreign ids
// are ordinary data. A device and inode identity prints as a label #L: #0 for
// none, else the order in which the identity was first seen.
//
//   dir PATH            open_directory (prints the identity)
//   open DIR PATH       open_beneath (prints the size and identity)
//   file PATH           open_file (prints the size and identity)
//   close ID            close
//   churn DIR PATH N    open_beneath and close N times (prints the count done)
//   read FILE OFFSET    read (prints the count and the bytes)
//   create PATH         create_output (prints the destination and directory identities)
//   write OUT TEXT      write
//   fill OUT KIB        write KIB KiB of 'x', stopping at the first failure
//   commit OUT          commit
//   discard OUT         discard
//   print TEXT          print to stdout; eprint TEXT prints to stderr
//   exit success|failure|usage

class Word {
    i64 first;
    i64 length;
public:
    Word(i64 begin, i64 count) : first(begin), length(count) {
    }
    auto begin() const -> i64 {
        return first;
    }
    auto count() const -> i64 {
        return length;
    }
};

auto argument(builtin::span<const u8> arguments, i64 index) -> Word {
    i64 at = 0;
    i64 begin = 0;
    i64 ordinal = 0;
    while (at < arguments.size()) {
        if (arguments.at(at) == 0u8) {
            if (ordinal == index) {
                const Word result = Word(begin, at - begin);
                return result;
            }
            ordinal = ordinal + 1;
            begin = at + 1;
        }
        at = at + 1;
    }
    const Word missing = Word(-1, 0);
    return missing;
}

auto is(builtin::span<const u8> word, builtin::span<const u8> text) -> bool {
    if (word.size() != text.size()) {
        return false;
    }
    i64 at = 0;
    while (at < word.size()) {
        if (word.at(at) != text.at(at)) {
            return false;
        }
        at = at + 1;
    }
    return true;
}

auto number(builtin::span<const u8> word, i64 first) -> u64 {
    u64 value = 0u64;
    i64 at = first;
    while (at < word.size() && word.at(at) >= '0' && word.at(at) <= '9') {
        value = value * 10u64 + u64(word.at(at) - '0');
        at = at + 1;
    }
    return value;
}

auto decimal(builtin::HostFiles& files, u64 value) -> builtin::HostStatus {
    array<u8, 21> digits = "000000000000000000000";
    i64 at = 20;
    digits[20] = ' ';
    u64 rest = value;
    while (at == 20 || rest > 0u64) {
        at = at - 1;
        digits[at] = u8(48u64 + rest % 10u64);
        rest = rest / 10u64;
    }
    const builtin::span<const u8> all = borrow_bytes(digits);
    const builtin::span<const u8> text = all.subspan(at, 21 - at);
    return files.print(builtin::HostStream::stdout, text);
}

auto status(builtin::HostFiles& files, builtin::HostStatus value) -> builtin::HostStatus {
    if (value == builtin::HostStatus::success) {
        return files.print(builtin::HostStream::stdout, "success");
    }
    if (value == builtin::HostStatus::invalid_handle) {
        return files.print(builtin::HostStream::stdout, "invalid_handle");
    }
    if (value == builtin::HostStatus::not_found) {
        return files.print(builtin::HostStream::stdout, "not_found");
    }
    if (value == builtin::HostStatus::denied) {
        return files.print(builtin::HostStream::stdout, "denied");
    }
    if (value == builtin::HostStatus::escape) {
        return files.print(builtin::HostStream::stdout, "escape");
    }
    if (value == builtin::HostStatus::not_regular) {
        return files.print(builtin::HostStream::stdout, "not_regular");
    }
    if (value == builtin::HostStatus::exhausted) {
        return files.print(builtin::HostStream::stdout, "exhausted");
    }
    if (value == builtin::HostStatus::too_large) {
        return files.print(builtin::HostStream::stdout, "too_large");
    }
    if (value == builtin::HostStatus::invalid_path) {
        return files.print(builtin::HostStream::stdout, "invalid_path");
    }
    return files.print(builtin::HostStream::stdout, "failed");
}

// Begins an output line: "ORDINAL OPERATION STATUS ".
auto report(builtin::HostFiles& files, i64 ordinal, builtin::span<const u8> operation,
    builtin::HostStatus value) -> builtin::HostStatus {
    decimal(files, u64(ordinal));
    files.print(builtin::HostStream::stdout, operation);
    files.print(builtin::HostStream::stdout, " ");
    status(files, value);
    return files.print(builtin::HostStream::stdout, " ");
}

auto chunk_line(builtin::HostFiles& files, u64 file, u64 offset) -> builtin::HostStatus {
    const builtin::HostChunk chunk = files.read(file, offset);
    status(files, chunk.status);
    files.print(builtin::HostStream::stdout, " ");
    decimal(files, chunk.count);
    const array<u8, 504> bytes = chunk.bytes;
    const builtin::span<const u8> all = borrow_bytes(bytes);
    i64 shown = i64(chunk.count);
    if (shown > 32) {
        shown = 32;
    }
    const builtin::span<const u8> part = all.subspan(0, shown);
    return files.print(builtin::HostStream::stdout, part);
}

auto fill(builtin::HostFiles& files, u64 output, u64 kibibytes) -> builtin::HostStatus {
    const array<u8, 64> block = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx";
    const builtin::span<const u8> bytes = borrow_bytes(block);
    u64 written = 0u64;
    while (written < kibibytes * 16u64) {
        const builtin::HostStatus result = files.write(output, bytes);
        if (result != builtin::HostStatus::success) {
            return result;
        }
        written = written + 1u64;
    }
    return builtin::HostStatus::success;
}

// The operation ordinal an @N operand names, or -1 for a literal.
auto reference(builtin::span<const u8> word) -> i64 {
    if (word.size() > 1 && word.at(0) == '@') {
        const u64 ordinal = number(word, 1);
        if (ordinal < 32u64) {
            return i64(ordinal);
        }
        return 0;
    }
    return -1;
}

// Opens and closes a file beneath a directory count times; the status of the
// first failure, or success, and the number of rounds completed.
auto churn(builtin::HostFiles& files, u64 directory, builtin::span<const u8> path, u64 count) -> builtin::HostStatus {
    u64 done = 0u64;
    builtin::HostStatus result = builtin::HostStatus::success;
    while (result == builtin::HostStatus::success && done < count) {
        const builtin::HostFileResult file = files.open_beneath(directory, path);
        result = file.status;
        if (result == builtin::HostStatus::success) {
            result = files.close(file.id);
            done = done + 1u64;
        }
    }
    files.print(builtin::HostStream::stdout, "churn ");
    status(files, result);
    files.print(builtin::HostStream::stdout, " ");
    return decimal(files, done);
}

auto label(builtin::HostFiles& files, i64 value) -> builtin::HostStatus {
    files.print(builtin::HostStream::stdout, "#");
    return decimal(files, u64(value));
}

auto main(builtin::HostFiles& files, builtin::span<const u8> arguments) -> builtin::HostExit {
    array<u64, 32> devices = {
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64
    };
    array<u64, 32> inodes = {
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64
    };
    i64 seen = 0;
    array<u64, 32> ids = {
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64
    };
    i64 index = 1;
    i64 ordinal = 1;
    i64 begin = 0;
    while (begin >= 0 && ordinal < 32) {
        const Word head = argument(arguments, index);
        const Word first = argument(arguments, index + 1);
        const Word second = argument(arguments, index + 2);
        begin = head.begin();
        if (begin >= 0) {
            const builtin::span<const u8> operation = arguments.subspan(head.begin(), head.count());
            i64 one_begin = 0;
            i64 one_count = 0;
            i64 two_begin = 0;
            i64 two_count = 0;
            if (first.begin() >= 0) {
                one_begin = first.begin();
                one_count = first.count();
            }
            if (second.begin() >= 0) {
                two_begin = second.begin();
                two_count = second.count();
            }
            const builtin::span<const u8> one = arguments.subspan(one_begin, one_count);
            const builtin::span<const u8> two = arguments.subspan(two_begin, two_count);
            i64 used = 2;
            i64 identities = 0;
            u64 first_device = 0u64;
            u64 first_inode = 0u64;
            u64 second_device = 0u64;
            u64 second_inode = 0u64;
            u64 id = number(one, 0);
            const i64 named = reference(one);
            if (named >= 0) {
                id = ids[named];
            }
            if (is(operation, "dir")) {
                const builtin::HostDirectoryResult result = files.open_directory(one);
                report(files, ordinal, operation, result.status);
                ids[ordinal] = result.id;
                identities = 1;
                first_device = result.device;
                first_inode = result.inode;
            }
            if (is(operation, "open")) {
                const builtin::HostFileResult result = files.open_beneath(id, two);
                report(files, ordinal, operation, result.status);
                decimal(files, result.size);
                ids[ordinal] = result.id;
                used = 3;
                identities = 1;
                first_device = result.device;
                first_inode = result.inode;
            }
            if (is(operation, "file")) {
                const builtin::HostFileResult result = files.open_file(one);
                report(files, ordinal, operation, result.status);
                decimal(files, result.size);
                ids[ordinal] = result.id;
                identities = 1;
                first_device = result.device;
                first_inode = result.inode;
            }
            if (is(operation, "close")) {
                const builtin::HostStatus result = files.close(id);
                report(files, ordinal, operation, result);
            }
            if (is(operation, "churn")) {
                const Word third = argument(arguments, index + 3);
                u64 rounds = 0u64;
                if (third.begin() >= 0) {
                    rounds = number(arguments.subspan(third.begin(), third.count()), 0);
                }
                decimal(files, u64(ordinal));
                churn(files, id, two, rounds);
                used = 4;
            }
            if (is(operation, "read")) {
                decimal(files, u64(ordinal));
                files.print(builtin::HostStream::stdout, "read ");
                chunk_line(files, id, number(two, 0));
                used = 3;
            }
            if (is(operation, "create")) {
                const builtin::HostOutputResult result = files.create_output(one);
                report(files, ordinal, operation, result.status);
                ids[ordinal] = result.id;
                identities = 2;
                first_device = result.device;
                first_inode = result.inode;
                second_device = result.directory_device;
                second_inode = result.directory_inode;
            }
            if (is(operation, "write")) {
                const builtin::HostStatus result = files.write(id, two);
                report(files, ordinal, operation, result);
                used = 3;
            }
            if (is(operation, "fill")) {
                const builtin::HostStatus result = fill(files, id, number(two, 0));
                report(files, ordinal, operation, result);
                used = 3;
            }
            if (is(operation, "commit")) {
                const builtin::HostStatus result = files.commit(id);
                report(files, ordinal, operation, result);
            }
            if (is(operation, "discard")) {
                const builtin::HostStatus result = files.discard(id);
                report(files, ordinal, operation, result);
            }
            if (is(operation, "print")) {
                const builtin::HostStatus result = files.print(builtin::HostStream::stdout, one);
                report(files, ordinal, operation, result);
            }
            if (is(operation, "eprint")) {
                const builtin::HostStatus result = files.print(builtin::HostStream::stderr, one);
                report(files, ordinal, operation, result);
            }
            if (is(operation, "exit")) {
                if (is(one, "failure")) {
                    return builtin::HostExit::failure;
                }
                if (is(one, "usage")) {
                    return builtin::HostExit::usage;
                }
                return builtin::HostExit::success;
            }
            i64 printed = 0;
            while (printed < identities) {
                u64 device = first_device;
                u64 inode = first_inode;
                if (printed == 1) {
                    device = second_device;
                    inode = second_inode;
                }
                i64 found = 0;
                if (device != 0u64 || inode != 0u64) {
                    i64 at = 0;
                    while (at < seen && found == 0) {
                        if (devices[at] == device && inodes[at] == inode) {
                            found = at + 1;
                        }
                        at = at + 1;
                    }
                    if (found == 0 && seen < 32) {
                        devices[seen] = device;
                        inodes[seen] = inode;
                        seen = seen + 1;
                        found = seen;
                    }
                }
                label(files, found);
                printed = printed + 1;
            }
            files.print(builtin::HostStream::stdout, "\n");
            index = index + used;
            ordinal = ordinal + 1;
        }
    }
    return builtin::HostExit::success;
}
