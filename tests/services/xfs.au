auto check_mounted_output(builtin::ByteRegion region) -> bool {
    service::XfsOutput output = service::XfsOutput(region);
    if (!output.available() || !output.begin(40u64) || output.committable(40u64) || output.append(41u64, "x")
        || !output.append(40u64, "x")) {
        return false;
    }
    if (output.exceeds_limit(4095u64) || !output.exceeds_limit(4096u64) || !output.committable(40u64)) {
        return false;
    }
    output.clear();
    if (!output.available() || !output.begin(41u64)) {
        return false;
    }
    u64 at = 0u64;
    while (at < 4096u64) {
        if (!output.append(41u64, "x")) {
            return false;
        }
        at = at + 1u64;
    }
    if (!output.committable(41u64) || !output.exceeds_limit(1u64) || output.append(41u64, "x")
        || output.committable(41u64) || output.consume(41u64)) {
        return false;
    }
    output.clear();
    if (!output.begin(42u64) || !output.append(42u64, "new") || !output.consume(42u64) || output.consume(42u64)
        || output.append(42u64, "x")) {
        return false;
    }
    output.clear();
    return !output.available() && !output.begin(43u64);
}

