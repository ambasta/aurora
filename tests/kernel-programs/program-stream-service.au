module program_stream_service;
auto aurora_user_main(i64 phase, i64 value, i64 ordinal) -> i64 {
    if (phase == 5) { i64 toggle = 0; while (true) { toggle = 1 - toggle; } }
    if (phase == 4) { const array<i64, 2> items = {1, 2}; return items[10]; }
    if (phase != 1 || ordinal < 0 || ordinal >= 64 || value < 32 || value > 126) { return -1; }
    return value;
}
