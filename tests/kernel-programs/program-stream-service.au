module program_stream_service;
import kernel.note_read;
auto aurora_user_main(i64 phase, i64 value, i64 ordinal, kernel::NoteRead64 note, kernel::NoteRead64 suffix) -> i64 {
    if (phase == 5) {
        i64 toggle = 0;
        while (true) {
            toggle = 1 - toggle;
        }
    }
    if (phase == 4) {
        const array<i64, 2> items = {
            1,
            2
        };
        return items[10];
    }
    if (phase == 11) {
        if (value != 1 || ordinal < 0 || ordinal > 53) {
            return 4;
        }
        if (note.size() < 0) {
            return 3;
        }
        if (ordinal == note.size()) {
            return 2;
        }
        if (ordinal > note.size()) {
            return 4;
        }
        return i64(1u64 | (u64(note.at(ordinal)) << 8));
    }
    if (phase != 1 || ordinal < 0 || ordinal >= 64 || value < 32 || value > 126) {
        return -1;
    }
    return value;
}

// The command starts only after offset zero has a delivered Mailbox ticket.
// These copied inputs carry no authority over the supervisor's saved files.
auto append_producer(builtin::ServeSession& session, i64 phase, i64 probe, i64 offset,
    kernel::NoteRead64 note, kernel::NoteRead64 suffix) -> i64 {
    if (phase != 17 || offset != 0 || note.size() < 0 || note.size() > 49 || suffix.size() < 0
        || suffix.size() > 49 - note.size()) {
        return 0;
    }
    if (probe == 24) {
        return 0;
    }
    // Construct exactly once before the first exchange. The candidate and
    // cursor remain live until this producer's terminal park and retirement.
    const i64 length = note.size() + suffix.size();
    kernel::NoteRead64 candidate = kernel::NoteRead64(length);
    append_probe(probe, 22, 23);
    i64 index = 0;
    while (index < length) {
        u8 byte = '\0';
        if (index < note.size()) {
            byte = note.at(index);
        } else {
            byte = suffix.at(index - note.size());
        }
        if (byte < ' ' || byte > '~') {
            return 0;
        }
        candidate.set(index, byte);
        index = index + 1;
    }
    i64 cursor = 0;
    bool terminal = false;
    while (!terminal) {
        if (cursor == 1) {
            append_probe(probe, 4, 5);
        }
        u64 reply = 2u64;
        if (cursor == candidate.size()) {
            // EOF is a terminal park, never a cleanup request or return.
            terminal = true;
        } else {
            reply = 1u64 | (u64(candidate.at(cursor)) << 8);
        }
        const builtin::ServeRequest request = session.exchange(reply);
        if (terminal || request.status != builtin::ServeStatus::request || request.value != u64(cursor + 1)) {
            return 0;
        }
        cursor = cursor + 1;
    }
    return 0;
}

auto append_probe(i64 probe, i64 fault, i64 budget) -> bool {
    if (probe == fault) {
        const array<i64, 2> items = {1, 2};
        return items[10] == 0;
    }
    if (probe == budget) {
        i64 toggle = 0;
        while (true) {
            toggle = 1 - toggle;
        }
    }
    return true;
}
