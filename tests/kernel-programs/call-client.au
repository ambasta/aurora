module call_client;
auto invoke(builtin::CallSession& session, u64 request) -> builtin::CallResult {
    const u64 local = request + 2u64;
    const builtin::CallResult result = session.call(request);
    if (local != request + 2u64) {
        const builtin::CallResult failure = builtin::CallResult{
            .status = builtin::CallStatus::rejected,
            .value = 0u64
        };
        return failure;
    }
    return result;
}
auto aurora_user_main(builtin::CallSession& session, u64 phase, u64 seed, u64 ordinal) -> u64 {
    const array<u64, 3> live = {
        seed,
        17u64,
        23u64
    };
    u64 steps = 0u64;
    u64 checksum = seed;
    while (steps < 250000u64) {
        checksum = seed - checksum;
        steps = steps + 1u64;
    }
    const builtin::CallResult result = invoke(session, live[0]);
    if (checksum != seed || live[0] != seed || live[1] != 17u64 || live[2] != 23u64 || ordinal != 0u64) {
        return 1u64;
    }
    if (phase == 1u64) {
        if (result.status != builtin::CallStatus::cancelled || result.value != 0u64) {
            return 2u64;
        }
    } else {
        if (result.status != builtin::CallStatus::replied || (result.value & 255u64) != 1u64 || (result.value >> 8)
            != 1210602228u64) {
            return 3u64;
        }
    }
    const builtin::CallResult again = session.call(99u64);
    if (again.status != builtin::CallStatus::rejected || again.value != 0u64) {
        return 4u64;
    }
    if (phase == 8u64) {
        while (true) {
            checksum = seed - checksum;
        }
    }
    return live[1] + live[2] + (result.value >> 8);
}
