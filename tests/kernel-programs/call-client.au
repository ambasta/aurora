module call_client;
import console.file_calls;
auto aurora_user_main(builtin::CallSession& session, u64 operation, u64 seed, u64 ordinal) -> u64 {
    if (operation == 32u64 || operation == 48u64) {
        return console::read_file(session, operation == 48u64);
    }
    const builtin::CallResult reply = console::read_once(session, seed, ordinal);
    if (reply.status != builtin::CallStatus::replied) {
        return 40u64;
    }
    return 40u64 + reply.value;
}
