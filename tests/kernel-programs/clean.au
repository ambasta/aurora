module user_clean;
import std.numeric;
import std.utility;
import std.array;

auto aurora_user_main() -> i64 {
    const array<i64, 4> values = {10, 20, 5, 7};
    i64 index = 0;
    i64 sum = 0;
    while (index < len(values)) {
        sum = sum + values[index];
        index = index + 1;
    }
    const std::MinMax bounds = std::minmax(sum, 0);
    const std::Accumulator initial = std::Accumulator(0);
    const std::pair<std::MinMax, std::Accumulator> nested =
        std::pair<std::MinMax, std::Accumulator>(bounds, initial);
    const std::pair<std::MinMax, std::Accumulator> copied = nested;
    const std::MinMax limits = copied.first;
    std::Accumulator accumulator = copied.second;
    const i64 changed = accumulator.add(limits.max());
    const std::Accumulator original = nested.second;
    if (original.value() != 0) { return 0; }
    const std::pair<i64, u64> result = std::pair<i64, u64>(changed, 0u64);
    std::array<i64, 2> output = std::array<i64, 2>();
    output.set(0, result.first);
    return output.at(0);
}
