module user_clean;
import std.numeric;
import std.utility;
import std.array;

enum class CleanStatus { ready };
class CleanResult {
private:
    CleanStatus state;
    i64 amount;
public:
    CleanResult(i64 number) : state(CleanStatus::ready), amount(number) {}
    auto status() const -> CleanStatus { return state; }
    auto snapshot() const -> std::MinMax {
        const std::MinMax value = std::minmax(amount, 0);
        return value;
    }
};

auto aurora_user_main() -> i64 {
    const array<i64, 4> values = {10, 20, 5, 7};
    i64 index = 0;
    i64 sum = 0;
    while (index < len(values)) {
        sum = sum + values[index];
        index = index + 1;
    }
    const CleanResult source = CleanResult(sum);
    if (source.status() != CleanStatus::ready) { return 0; }
    const std::MinMax bounds = source.snapshot();
    const std::Accumulator initial = std::Accumulator(0);
    const std::pair<std::MinMax, std::Accumulator> nested =
        std::pair<std::MinMax, std::Accumulator>(bounds, initial);
    const std::pair<std::MinMax, std::Accumulator> copied = nested;
    const std::MinMax limits = copied.first;
    std::Accumulator accumulator = copied.second;
    const i64 changed = accumulator.add(limits.max());
    const std::Accumulator original = nested.second;
    if (original.value() != 0) { return 0; }
    const std::pair<i64, u64> result = std::pair<i64, u64>(changed, 0u64);
    static_assert(size_of(std::array<u8, 2>) == 2);
    std::array<u8, 2> output = std::array<u8, 2>();
    output.set(1, 255u8);
    output.set(0, u8(result.first));
    if (output.at(1) != 255u8) { return 0; }
    return i64(output.at(0));
}
