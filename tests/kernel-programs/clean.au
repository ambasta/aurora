module user_clean;
import std.numeric;
import std.utility;
import std.array;

auto aurora_user_main() -> i64 {
    const array<i64, 4> values = {10, 20, 5, 7};
    i64 index = 0;
    i64 sum = 0;
    while (index < len(values)) {
        sum = sum + values[index];
        index = index + 1;
    }
    const std::MinMax bounds = std::minmax(sum, 0);
    const std::pair<i64, u64> result = std::pair<i64, u64>(bounds.max(), 0u64);
    std::array<i64, 2> output = std::array<i64, 2>();
    output.set(0, result.first);
    return output.at(0);
}
