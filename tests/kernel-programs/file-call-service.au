module file_call_service;
import kernel.note_read;
// One offset in an immutable command-selected copy. No name, store or write grant.
auto aurora_user_main(i64 phase, i64 offset, i64 reserved, kernel::NoteRead64 file) -> i64 {
    if (phase == 5) {
        while (true) {
        }
    }
    if (phase == 4) {
        const array<i64, 2> items = {
            1,
            2
        };
        return items[10];
    }
    if (phase != 11 || reserved != 0 || offset < 0 || offset > 49) {
        return 4;
    }
    if (file.size() < 0) {
        return 3;
    }
    if (offset == file.size()) {
        return 2;
    }
    if (offset > file.size()) {
        return 4;
    }
    return i64(1u64 | (u64(file.at(offset)) << 8));
}
