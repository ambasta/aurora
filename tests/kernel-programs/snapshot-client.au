module snapshot_client;

// Every call is a fresh launch. Only the copied absolute offset crosses calls.
auto aurora_user_main(u64 phase, u64 value, u64 offset) -> u64 {
    if (phase == 0u64) { return 1u64; }
    if (phase == 6u64) { return 99u64; }
    if (phase == 3u64 && value == 0u64) { return 18446744073709551614u64; }
    if (phase == 7u64 && value == 3u64) { return 18446744073709551615u64; }
    if (phase == 2u64) {
        if (offset < 64u64) {
            const u64 expected = ((offset * 53u64 + 7u64) % 256u64) << 8;
            if (value == (1u64 | expected)) { return offset + 1u64; }
        } else {
            if ((offset == 64u64 && value == 2u64) || (offset > 64u64 && value == 4u64)) {
                return 18446744073709551615u64;
            }
        }
    }
    return 18446744073709551613u64;
}
