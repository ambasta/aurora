module kernel_process_execution;
import kernel.execution_session;

// Component-only cancellation selection observes the real owning operation.
// It cannot copy its state separately, extract the lease or mutate its phase.
auto process_cancel_command(builtin::ExecutionEffects& effects, u64 point) -> kernel::ExecutionResult {
    builtin::ExecutionLease lease = effects.prepare();
    kernel::CommandExecution command = kernel::CommandExecution(move(lease));
    bool cancellation_sent = false;
    if (point == 0u64) {
        command.cancel();
        cancellation_sent = true;
    }
    while (command.active()) {
        const bool was_request = command.awaiting_request();
        const bool was_output = command.awaiting_output();
        command.advance();
        if (was_output && (!command.active() || command.awaiting_request())) {
            // Failed delivery requests cancellation inside the owning operation.
            cancellation_sent = true;
        }
        bool should_cancel = false;
        if (!cancellation_sent) {
            if (point == 1u64 && !was_request && command.awaiting_request()) {
                should_cancel = true;
            }
            if (point == 2u64 && was_request && command.awaiting_request()) {
                should_cancel = true;
            }
            if (point == 3u64 && !was_request && !was_output && !command.active()) {
                should_cancel = true;
            }
            if (point == 4u64 && command.awaiting_output()) {
                should_cancel = true;
            }
        }
        if (should_cancel) {
            command.cancel();
            cancellation_sent = true;
        }
    }
    if (point == 3u64 && !cancellation_sent) {
        command.cancel();
    }
    const kernel::ExecutionResult result = move(command).finish();
    return result;
}
