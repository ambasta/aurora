module seed_semantics;
import aurora.host;
import aurora.memory;

// aurora-seed's semantics case: each line is one observation of the subset
// the compiler is written in, as aurorac's compiled program prints it too.

enum class Shade {
    light,
    dark
};

class Pair {
public:
    i64 left;
    u64 right;
};

class Node {
    Shade shade;
    i64 weight;
public:
    Node(Shade kind, i64 value) : shade(kind), weight(value) {
    }
    auto dark() const -> bool {
        return shade == Shade::dark;
    }
    auto value() const -> i64 {
        return weight;
    }
    auto grow(i64 by) -> i64 {
        weight = weight + by;
        return weight;
    }
};

// A move-only class: its owners move with it and drop with its binding.
class Store {
    builtin::OwnedBytes bytes;
    builtin::OwnedValues<Node> nodes;
    i64 used;
public:
    Store(builtin::ByteRegion region, i64 size, Node fill) : bytes(region.try_allocate(size)),
        nodes(region.try_allocate(1, fill)), used(0) {
    }
    auto push(Node node) -> bool {
        if (used == nodes.size() && !nodes.try_resize(2 * used, node)) {
            return false;
        }
        const bool stored = nodes.set(used, node);
        used = used + 1;
        return stored;
    }
    auto total() const -> i64 {
        const builtin::span<const Node> all = borrow_values(nodes);
        i64 sum = 0;
        i64 at = 0;
        while (at < used) {
            const Node node = all.at(at);
            if (node.dark()) {
                sum = sum + node.value();
            }
            at = at + 1;
        }
        return sum;
    }
    auto fill(u8 value) -> i64 {
        i64 at = 0;
        while (bytes.set(at, value)) {
            at = at + 1;
        }
        return at;
    }
    auto text() const -> builtin::span<const u8> {
        const builtin::span<const u8> all = borrow_bytes(bytes);
        const builtin::span<const u8> middle = all.subspan(1, all.size() - 2);
        return middle;
    }
};

auto number(builtin::HostFiles& files, builtin::span<const u8> name, i64 value) -> bool {
    array<u8, 21> digits = "000000000000000000000";
    i64 at = 21;
    u64 rest = 0u64;
    if (value < 0) {
        rest = u64(-(value + 1)) + 1u64;
    } else {
        rest = u64(value);
    }
    while (at == 21 || rest > 0u64) {
        at = at - 1;
        digits[at] = u8(48u64 + rest % 10u64);
        rest = rest / 10u64;
    }
    if (value < 0) {
        at = at - 1;
        digits[at] = '-';
    }
    const builtin::span<const u8> all = borrow_bytes(digits);
    const builtin::span<const u8> text = all.subspan(at, 21 - at);
    files.print(builtin::HostStream::stdout, name);
    files.print(builtin::HostStream::stdout, " ");
    files.print(builtin::HostStream::stdout, text);
    files.print(builtin::HostStream::stdout, "\n");
    return true;
}

auto consume(builtin::ByteRegion region, Store store) -> i64 {
    return store.total();
}

auto main(builtin::HostFiles& files, builtin::ByteRegion region,
    builtin::span<const u8> arguments) -> builtin::HostExit {
    number(files, "divide", -85 / 2);
    number(files, "remainder", -85 % 2);
    number(files, "minimum", -9223372036854775807 - 1);
    number(files, "shift", i64(0b1011u64 << 60 >> 58));
    number(files, "mask", i64((~0u64 ^ 255u64) & 4095u64 | 1u64));
    number(files, "byte", i64(u8(200) + 55u8) - i64(~'A'));
    const Pair pair = Pair{
        .left = -3,
        .right = 9u64
    };
    number(files, "pair", pair.left * i64(pair.right));
    Node node = Node(Shade::dark, 5);
    Node copy = node;
    node.grow(10);
    number(files, "copy", copy.value() * 100 + node.value());
    array<u8, 4> letters = "abcd";
    letters[3] = letters[2] + 1u8;
    number(files, "array", i64(letters[3]));
    const Node fill = Node(Shade::light, 0);
    Store store = Store(region, 6, fill);
    number(files, "fill", store.fill('x'));
    {
        const builtin::span<const u8> text = store.text();
        number(files, "view", text.size() * 1000 + i64(text.at(0)));
    }
    i64 at = 0;
    while (at < 5) {
        Shade shade = Shade::light;
        if (at % 2 == 1) {
            shade = Shade::dark;
        }
        const Node item = Node(shade, at);
        store.push(item);
        at = at + 1;
    }
    number(files, "dark", consume(region, move(store)));
    builtin::OwnedBytes bytes = region.try_allocate(-1);
    number(files, "failed", bytes.size() + 10 * i64(u64(1u8 + 1u8)));
    if (!bytes.ok() && !bytes.try_resize(4)) {
        files.print(builtin::HostStream::stdout, "inert\n");
    }
    return builtin::HostExit::success;
}
