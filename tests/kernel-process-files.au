module kernel_process_files_reference;
import kernel.process_files;
import kernel.boot_volume;

// Test-only wrappers for the existing native reference adapter. The actual
// guest namespace and handle tables are owned by services/service/files.au.
auto process_file_open(builtin::span<const u8> volume, builtin::span<const u8> overlay, builtin::span<const u8> table,
    builtin::span<const u8> path, u64 operation, u64 directory) -> kernel::FileOpen {
    const kernel::FileOpen opened = kernel::file_open(volume, overlay, table, path, operation, directory);
    return opened;
}

auto process_file_create(builtin::span<const u8> volume, builtin::span<const u8> overlay, builtin::span<const u8> table,
    builtin::span<const u8> path) -> kernel::FileCreate {
    const kernel::FileCreate created = kernel::file_create(volume, overlay, table, path);
    return created;
}

auto process_file_read(builtin::span<const u8> table, u64 id, u64 offset) -> kernel::FileRead {
    const kernel::FileRead read = kernel::file_read(table, id, offset);
    return read;
}

auto process_file_close(builtin::span<const u8> overlay, builtin::span<const u8> table, u64 id) -> kernel::FileChange {
    const kernel::FileChange closed = kernel::file_close(overlay, table, id);
    return closed;
}

auto process_file_write(builtin::span<const u8> table, u64 id, u64 bytes, u64 charged,
    u64 quota) -> kernel::FileChange {
    const kernel::FileChange written = kernel::file_write(table, id, bytes, charged, quota);
    return written;
}

auto process_file_commit(builtin::span<const u8> volume, builtin::span<const u8> overlay, builtin::span<const u8> table,
    u64 id) -> kernel::FileChange {
    const kernel::FileChange committed = kernel::file_commit(volume, overlay, table, id);
    return committed;
}

auto process_file_discard(builtin::span<const u8> table, u64 id) -> kernel::FileChange {
    const kernel::FileChange discarded = kernel::file_discard(table, id);
    return discarded;
}

// The bytes of directory (first, depth)'s path in its first entry's name,
// + 1, or 0 when that name is not that deep (an exported path's directory).
auto process_directory_prefix(builtin::span<const u8> volume, u64 first, u64 depth) -> u64 {
    if (first > 4096u64 || depth > 255u64) {
        return 0u64;
    }
    const i64 prefix = kernel::directory_prefix(volume, first, depth);
    if (prefix < 0) {
        return 0u64;
    }
    return u64(prefix) + 1u64;
}
