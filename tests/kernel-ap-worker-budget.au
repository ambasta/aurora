module kernel_ap_worker_budget;
import kernel.ap_worker;

// Test-only bulk exercise of the actual policy. Limits and private state are
// unchanged; there is no production test hook and no per-observation C bridge.
auto ap_worker_budget_case(bool terminal) -> bool {
    kernel::ApWorkerOwner owner = kernel::ApWorkerOwner();
    if (!owner.begin_start(1u64, 7u64) || !owner.startup_sent(1u64, 7u64) || !owner.ready(1u64, 7u64)
        || !owner.reserve(4096, 0) || !owner.published(7u64, 1u64)) {
        return false;
    }
    const kernel::ApWorkerObservation pending = kernel::ApWorkerObservation(1u64, 7u64, 1u64, 0, 1u64);
    const kernel::ApWorkerObservation complete = kernel::ApWorkerObservation(1u64, 7u64, 1u64, 0, 0u64);
    u64 attempt = 1u64;
    while (attempt < 50000000u64) {
        const u64 ordinal = owner.reserve_observation(7u64, 1u64);
        if (ordinal != attempt || !owner.observe(pending, ordinal, 0u64)) {
            return false;
        }
        attempt = attempt + 1u64;
    }
    if (owner.attempts() != 49999999u64 || owner.ticks() != 3579546u64 || owner.reserve_observation(7u64, 1u64)
        != 50000000u64 || owner.attempts() != 50000000u64 || owner.reserve_observation(7u64, 1u64) != 0u64) {
        return false;
    }
    if (terminal) {
        if (!owner.observe(complete, 50000000u64, 3579546u64) || owner.stage()
            != kernel::ApWorkerStage::completion_selected || owner.result() != 0 || !owner.acknowledged(7u64, 1u64)
            || !owner.reserve(0, 1) || owner.attempts() != 0u64 || owner.ticks() != 3579546u64 || !owner.published(7u64,
            2u64) || owner.reserve_observation(7u64, 2u64) != 50000001u64) {
            return false;
        }
        return true;
    }
    if (owner.observe(pending, 50000000u64, 0u64) || owner.stage() != kernel::ApWorkerStage::failed || owner.attempts()
        != 50000000u64 || owner.reserve_observation(7u64, 1u64) != 0u64 || owner.observe(complete, 50000000u64, 0u64)
        || owner.acknowledged(7u64, 1u64) || owner.reserve(0, 0) || owner.begin_start(1u64, 8u64)) {
        return false;
    }
    return owner.stage() == kernel::ApWorkerStage::failed && owner.jobs() == 1u64 && owner.used() == 0u64;
}
