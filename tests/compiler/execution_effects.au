module execution_effects_probe;

auto execution_consume(builtin::ExecutionEffects& effects) -> u64 {
    builtin::ExecutionLease initial = effects.prepare();
    builtin::ExecutionLease lease = move(initial);
    const builtin::ExecutionPrep prepared = lease.preparation();
    u64 result = 42u64;
    if (prepared.state != builtin::ExecPrepared::loaded || (prepared.status != builtin::ExecStatus::exited
        && prepared.status != builtin::ExecStatus::cancelled)) {
        result = 1u64;
    }
    const builtin::ExecutionStep step = lease.advance();
    if (step.state != builtin::ExecStep::output || (step.status != builtin::ExecStatus::exited && step.status
        != builtin::ExecStatus::cancelled) || step.value != 18446744073709551615u64) {
        result = 2u64;
    }
    if (lease.output() != builtin::ExecEffect::success) {
        result = 3u64;
    }
    builtin::ExecRequest requested = lease.request();
    while (requested == builtin::ExecRequest::pending) {
        requested = lease.request();
    }
    if (requested != builtin::ExecRequest::ready && requested != builtin::ExecRequest::cancel_requested) {
        result = 4u64;
    }
    const builtin::ExecCancel cancelled = lease.cancel();
    if (cancelled != builtin::ExecCancel::settled && cancelled != builtin::ExecCancel::draining && cancelled
        != builtin::ExecCancel::service_lost) {
        result = 5u64;
    }
    if (lease.finish(builtin::ExecFinish::cancel_requested) != builtin::ExecEffect::success) {
        result = 6u64;
    }
    return result;
}
auto execution_entry(builtin::ExecutionEffects& effects) -> u64 {
    return execution_consume(effects);
}
