module endpoint_native_probe;
import aurora.endpoint;

auto endpoint_entry(builtin::ServeSession& session, builtin::span<const u8> reply) -> u64 {
    const endpoint::Message message = endpoint::exchange(session, reply);
    if (message.status() == builtin::ServeStatus::cancelled) {
        if (message.source() != 0u64 || message.transaction() != 0u64 || message.count() != 0u64) {
            return 1u64;
        }
        return 42u64;
    }
    if (message.source() == 12u64) {
        return u64(endpoint::byte(session, message.count()));
    }
    if (message.source() == 13u64) {
        return u64(endpoint::byte(session, 65536u64));
    }
    if (message.source() == 14u64) {
        return u64(endpoint::byte(session, 18446744073709551615u64));
    }
    if (message.source() != 7u64 || message.transaction() != 91u64 || message.count() != 3u64 || endpoint::byte(session,
        0u64) != 'x' || endpoint::byte(session, 2u64) != 'z') {
        return 2u64;
    }
    return 42u64;
}

// The native adapter supplies raw reports to the actual Aurora-target read.
auto input_entry(builtin::InputStream& input) -> u64 {
    const builtin::InputChunk chunk = input.read();
    const array<u8, 504> bytes = chunk.bytes;
    if (chunk.status == builtin::InputStatus::data) {
        if (chunk.count != 1u64 && chunk.count != 504u64) {
            return 1u64;
        }
        u64 index = 0u64;
        while (index < chunk.count) {
            if (bytes[i64(index)] != 'x') {
                return 2u64;
            }
            index = index + 1u64;
        }
    } else {
        if (chunk.status != builtin::InputStatus::eof && chunk.status != builtin::InputStatus::cancelled && chunk.status
            != builtin::InputStatus::unavailable) {
            return 3u64;
        }
        if (chunk.count != 0u64) {
            return 4u64;
        }
    }
    return 42u64;
}
