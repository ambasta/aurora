// Test-only lifecycle and metadata admission transport. This complete narrow
// graph links without the production frontend graph or private native Metadata.
export namespace compiler_initialization_fixture {
    auto metadata_flag_masks() -> compiler_ir_metadata::FlagMasks {
        const compiler_ir_metadata::FlagMasks result = compiler_ir_metadata::flag_masks();
        return result;
    }
    auto metadata_create(builtin::ByteRegion region) -> compiler_ir_metadata::MetadataStore {
        compiler_ir_metadata::MetadataStore result = compiler_ir_metadata::create(region);
        return move(result);
    }
    auto metadata_initialize(compiler_ir_metadata::MetadataStore& store, compiler_ir_metadata::InputCounts counts,
        i64 callableCount, i64 slotCount, i64 instructionBegin) -> bool {
        return store.initialize(counts, callableCount, slotCount, instructionBegin);
    }
    auto metadata_release(builtin::ByteRegion region, compiler_ir_metadata::MetadataStore store) -> i64 {
        return compiler_ir_metadata::release(region, move(store));
    }
    auto metadata_allocated(const compiler_ir_metadata::MetadataStore& store) -> bool {
        return store.allocated();
    }
    auto metadata_run(compiler_ir_metadata::MetadataStore& store) -> compiler_ir_metadata::MetadataStatus {
        return compiler_ir_metadata::run(store);
    }
    auto metadata_error(const compiler_ir_metadata::MetadataStore& store) -> compiler_ir_metadata::MetadataError {
        return store.error();
    }
    auto verification_create(builtin::ByteRegion region) -> compiler_ir_verification::VerificationWorkspace {
        compiler_ir_verification::VerificationWorkspace result = compiler_ir_verification::create(region);
        return move(result);
    }
    auto verification_report(const compiler_ir_verification::VerificationWorkspace& workspace) ->
        compiler_ir_verification::VerificationReport {
        const compiler_ir_verification::VerificationReport result = workspace.report();
        return result;
    }
    auto verification_release(builtin::ByteRegion region,
        compiler_ir_verification::VerificationWorkspace workspace) -> i64 {
        return compiler_ir_verification::release(region, move(workspace));
    }
}
