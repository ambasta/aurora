// Test-only observation roots. All operations borrow the current eleven-owner
// verifier workspace and, when needed, the real source-admitted metadata store.
// No owner descriptor, stored word or native expected state enters this module.
export namespace compiler_initialization_probe {
    auto allocated(const compiler_ir_verification::VerificationWorkspace& workspace) -> bool {
        return workspace.allocated();
    }
