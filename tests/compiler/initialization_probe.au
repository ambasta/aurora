    auto restore_facts(compiler_ir_verification::VerificationWorkspace& workspace, i64 count) -> bool {
        if (count < 0 || count == 9223372036854775807 || !workspace.prepare_verification(0, 2, count + 1)) {
            return false;
        }
        i64 at = 0;
        while (at < count) {
            compiler_ir_verification::FactRow fact = compiler_ir_verification::empty_fact();
            fact.set_kind(compiler_ir_verification::FactKind::object);
            fact.set_key(at);
            if (at == 0) {
                fact.set_kind(compiler_ir_verification::FactKind::owned_object);
            }
            if (at == 1) {
                fact.set_kind(compiler_ir_verification::FactKind::owned_field);
                fact.set_key(0);
                fact.set_field(0);
            }
            if (at == 2) {
                fact.set_kind(compiler_ir_verification::FactKind::owned_object);
            }
            if (at == 3 || at == 4) {
                fact.set_kind(compiler_ir_verification::FactKind::owned_field);
                fact.set_key(2);
                fact.set_field(at - 3);
            }
            if (!workspace.fact_set(fact)) {
                return false;
            }
            at = at + 1;
        }
        if (!workspace.validate_current_facts() || !workspace.retain_state(0)) {
            return false;
        }
        const i64 epoch = workspace.begin_visit_epoch();
        at = 0;
        while (at < count) {
            if (!workspace.mark_fact(at, epoch) || !workspace.fact_marked(at, epoch)) {
                return false;
            }
            at = at + 1;
        }
        // Same-key replacement changes payload without changing its position,
        // count or traversal mark; restoring it must leave the retained row alone.
        if (count > 0) {
            const i64 middle = count / 2;
            const compiler_ir_verification::FactRow original = workspace.fact_at(middle);
            compiler_ir_verification::FactRow replacement = original;
            replacement.set_site(1);
            if (!workspace.fact_set(replacement)) {
                return false;
            }
            const compiler_ir_verification::FactRow observed = workspace.fact_at(middle);
            if (workspace.fact_count() != count || workspace.fact_index(original.kind(), original.key(),
                original.field()) != middle || !observed.same(replacement) || !workspace.fact_marked(middle, epoch)
                || !workspace.fact_set(original) || !workspace.fact_marked(middle, epoch)
                || !workspace.validate_current_facts()) {
                return false;
            }
        }
        // Erasing the owner also removes its field. Surviving marks must follow
        // their facts while both ranges close before the second snapshot.
        compiler_ir_verification::FactRow extra = compiler_ir_verification::empty_fact();
        extra.set_kind(compiler_ir_verification::FactKind::object);
        extra.set_key(count + 1);
        if (!workspace.fact_erase(compiler_ir_verification::FactKind::owned_object, 0, -1) || !workspace.fact_set(extra)
            || workspace.fact_key_marked(compiler_ir_verification::FactKind::object, count + 1, -1, epoch)
            || !workspace.mark_fact_key(compiler_ir_verification::FactKind::object, count + 1, -1, epoch)
            || !workspace.validate_current_facts()) {
            return false;
        }
        i64 changed_count = count + 1;
        if (count > 0) {
            changed_count = changed_count - 1;
        }
        if (count > 1) {
            changed_count = changed_count - 1;
        }
        if (workspace.fact_count() != changed_count) {
            return false;
        }
        at = 0;
        while (at < changed_count) {
            if (!workspace.fact_marked(at, epoch)) {
                return false;
            }
            at = at + 1;
        }
        if (!workspace.retain_state(1)) {
            return false;
        }
        i64 pass = 0;
        while (pass < 3) {
            i64 snapshot = 0;
            i64 expected = count;
            if (pass == 2) {
                snapshot = 1;
                expected = changed_count;
            }
            if (!workspace.load_state(snapshot) || !workspace.validate_current_facts()
                || !workspace.same_facts(snapshot, compiler_ir_verification::FactKind::object)
                || !workspace.same_facts(snapshot, compiler_ir_verification::FactKind::owned_object)
                || !workspace.same_facts(snapshot, compiler_ir_verification::FactKind::owned_field)) {
                return false;
            }
            if (workspace.fact_count() != expected) {
                return false;
            }
            at = 0;
            while (at < expected) {
                const compiler_ir_verification::FactRow row = workspace.fact_at(at);
                i64 next = at + 1;
                if (next == expected) {
                    next = -1;
                }
                if (workspace.fact_marked(at, epoch) || workspace.fact_index(row.kind(), row.key(), row.field()) != at
                    || workspace.next_fact(at) != next) {
                    return false;
                }
                if (at > 0) {
                    const compiler_ir_verification::FactRow previous = workspace.fact_at(at - 1);
                    if (compiler_ir_verification::compare_fact_key(previous.kind(), previous.key(), previous.field(),
                        row) >= 0) {
                        return false;
                    }
                }
                at = at + 1;
            }
            // Erase and reinsert the front, midpoint and end of a freshly
            // restored prefix. Moves preserve surviving marks; reinsertion does
            // not revive the erased row's mark, including owner-field cascades.
            i64 shift = 0;
            while (pass == 0 && count > 0 && shift < 3) {
                if (!workspace.load_state(0)) {
                    return false;
                }
                i64 selected = 0;
                if (shift == 1) {
                    selected = count / 2;
                }
                if (shift == 2) {
                    selected = count - 1;
                }
                const compiler_ir_verification::FactRow removed = workspace.fact_at(selected);
                i64 erased = 1;
                at = 0;
                while (at < count) {
                    const compiler_ir_verification::FactRow row = workspace.fact_at(at);
                    if (removed.kind() == compiler_ir_verification::FactKind::owned_object && row.kind()
                        == compiler_ir_verification::FactKind::owned_field && row.key() == removed.key()) {
                        erased = erased + 1;
                    }
                    if (!workspace.mark_fact(at, epoch)) {
                        return false;
                    }
                    at = at + 1;
                }
                if (!workspace.fact_erase(removed.kind(), removed.key(), removed.field()) || workspace.fact_count()
                    != count - erased || workspace.fact_index(removed.kind(), removed.key(), removed.field()) != -1
                    || !workspace.validate_current_facts()) {
                    return false;
                }
                at = 0;
                while (at < count - erased) {
                    if (!workspace.fact_marked(at, epoch)) {
                        return false;
                    }
                    at = at + 1;
                }
                if (!workspace.fact_set(removed) || workspace.fact_count() != count - erased + 1
                    || !workspace.validate_current_facts() || workspace.fact_key_marked(removed.kind(), removed.key(),
                    removed.field(), epoch)) {
                    return false;
                }
                at = 0;
                while (at < count - erased + 1) {
                    const compiler_ir_verification::FactRow row = workspace.fact_at(at);
                    if (!row.same(removed) && !workspace.fact_marked(at, epoch)) {
                        return false;
                    }
                    at = at + 1;
                }
                shift = shift + 1;
            }
            pass = pass + 1;
        }
        return workspace.good();
    }
    auto initialize(compiler_ir_verification::VerificationWorkspace& workspace,
        const compiler_ir_metadata::MetadataStore& metadata,
        i64 callable) -> compiler_ir_verification::InitializationStatus {
        return compiler_ir_initialization::initialize(workspace, metadata, callable);
