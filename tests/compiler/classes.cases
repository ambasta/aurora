# Fixed classes.py cases; the format is native_runner.Suite.load's.
@case public aggregate method
module app; class Pair {public:i64 x;i64 y;auto sum() const -> i64{return x+y;}}; auto test() -> i64 {Pair p = Pair{.x=20,.y=22};return p.sum();}
@case bool receiver field canonical
module app; class Flag {bool value;public:Flag(bool v):value(v){}auto get() const -> bool{return value;}}; auto test() -> i64 {Flag f=Flag(true);if(f.get()){return 42;}return 0;}
@case six scalar method arguments
module app; class Six {i64 value;public:Six(i64 x):value(x){}auto sum(i64 a,i64 b,i64 c,i64 d,i64 e,i64 f)->i64{return value+a+b+c+d+e+f;}}; auto test() -> i64 {Six x=Six(1);return x.sum(1,2,3,4,5,26);}
@case private public reflection count
module app; ${COUNTER} auto test() -> i64 {Counter c=Counter(42);static_assert(field_count(Counter)==0);return reflect_field_count(type_id(Counter))+c.get();}
@case imported helper lexical identity
module app; import counters; auto checked_add(i64 x)->i64{return 999;}auto test()->i64{Counter c=Counter(40);return c.add(2);}
@module counters
export module counters; export ${COUNTER}
@case freestanding accumulator library
module app; import std.numeric; auto test() -> i64 { std::Accumulator sum=std::Accumulator(0);i64 n=0;while(n<7){sum.add(n);n=n+1;}return sum.value()*2; }
@case accumulator private state
@error private class field
module app; import std.numeric; auto test() -> i64 { std::Accumulator sum=std::Accumulator(42);return sum.total; }
@case accumulator checked overflow
@trap overflow
module app; import std.numeric; auto test() -> i64 { std::Accumulator sum=std::Accumulator(9223372036854775807);return sum.add(1); }
@case loop-local const aggregate lifetimes
module app; class Point{public:i64 value;}; auto test() -> i64 {i64 n=0;i64 total=0;while(n<2){const Point p=Point{.value=21};total=total+p.value;n=n+1;}return total;}
@case branch constructor lifetimes
module app; ${COUNTER} auto test() -> i64 {i64 total=0;if(true){Counter c=Counter(20);total=c.add(1);}else{Counter c=Counter(0);total=c.get();}Counter c=Counter(total);return c.add(total);}
@case six argument nested receiver calls
module app; class Six {i64 value;public:Six(i64 x):value(x){}auto sum(i64 a,i64 b,i64 c,i64 d,i64 e,i64 f)->i64{return value+a+b+c+d+e+f;}};auto id(i64 x)->i64{return x;} auto test() -> i64 {Six x=Six(1);return 1+x.sum(id(1),id(2),id(3),id(4),id(5),id(25));}
@case constructor multiple declaration-order fields
module app; class Pair {i64 a;i64 b;public:Pair(i64 x,i64 y):b(y),a(x){}auto sum() const -> i64{return a+b;}}; auto test() -> i64 {Pair p=Pair(20,22);return p.sum();}
@case method caller owner lifetime preserved
module app; ${COUNTER} auto test() -> i64 {own<i64> n=own(20);Counter c=Counter(read(n));{const ref<i64> r=borrow(n);c.add(read(r));}own<i64> moved=move(n);return c.get()+read(moved)-18;}
@case method private fields of independent same-class local
module app; class Counter {i64 value;public:Counter(i64 x):value(x){}auto get() const -> i64{Counter other=Counter(40);other.value=other.value+2;return other.value;}}; auto test() -> i64 {Counter c=Counter(0);return c.get();}
@case const method cannot mutate const local
@error mutable class local
module app; class Counter {i64 value;public:Counter(i64 x):value(x){}auto get() const -> i64{const Counter other=Counter(40);other.value=42;return other.value;}}; auto test() -> i64 {Counter c=Counter(0);return c.get();}
@case pure scalar recursion preserved
module app; ${COUNTER}auto sum(i64 n)->i64{if(n==0){return 0;}return n+sum(n-1);} auto test() -> i64 {Counter c=Counter(sum(6));return c.doubled();}
@case constructor return type rejected
@error constructor cannot have a return type
module app; class Wrong {public:auto Wrong()->i64{return 42;}}; auto test() -> i64 {return 42;}

# Retained lifecycle authority uses the existing native-origin owner contract.
@prelude EXECUTION_HEAD
class Lifecycle {
    builtin::ExecutionAuthority authority;
    array<u64, 32> state;
public:
    Lifecycle(builtin::ExecutionAuthority input) : authority(move(input)), state{} {}
@prelude EXECUTION_FINISH
    auto finish() && -> bool { return authority.finish(); }
};
@case execution observation exact copied layout
module app; auto test() -> i64 {
    static_assert(size_of(builtin::ExecutionObservation) == 64);
    static_assert(field_count(builtin::ExecutionObservation) == 8);
    return 42;
}
@case execution authority cannot mint
@error
module app; auto test() -> i64 { builtin::ExecutionAuthority input = builtin::ExecutionAuthority(); return 42; }
@case execution authority cannot copy constructor input
@error
module app; class Lifecycle { builtin::ExecutionAuthority authority; public:
Lifecycle(builtin::ExecutionAuthority input) : authority(input) {} };
auto test() -> i64 { return 42; }
@case execution authority cannot mix resident capability
@error
module app; class Lifecycle { builtin::ExecutionAuthority authority; builtin::ResidentSlot slot; public:
Lifecycle(builtin::ExecutionAuthority input, builtin::ResidentSlot other) : authority(move(input)), slot(move(other)) {} };
auto test() -> i64 { return 42; }
@case execution authority rejects wrong native input
@error
module app; class Lifecycle { builtin::ExecutionAuthority authority; public:
Lifecycle(builtin::ResidentSlot input) : authority(move(input)) {} };
auto test() -> i64 { return 42; }
@case execution authority cannot escape result
@error
module app; auto escape() -> builtin::ExecutionAuthority { return 0u64; } auto test() -> i64 { return 42; }
@case execution authority cannot escape parameter
@error
module app; auto escape(builtin::ExecutionAuthority input) -> u64 { return 0u64; } auto test() -> i64 { return 42; }
@case execution authority field remains private
@error
module app; class Lifecycle { public: builtin::ExecutionAuthority authority;
Lifecycle(builtin::ExecutionAuthority input) : authority(move(input)) {} };
auto test() -> i64 { return 42; }
@case execution authority cannot finalize through borrowed receiver
@error
module app; ${EXECUTION_HEAD} auto stop() -> bool { return authority.finish(); } ${EXECUTION_FINISH}
auto test() -> i64 { return 42; }
@case execution authority consuming return must discharge
@error
module app; ${EXECUTION_HEAD} auto finish() && -> bool { return false; } };
auto test() -> i64 { return 42; }
@case execution authority consuming field cannot be used twice
@error
module app; ${EXECUTION_HEAD} auto finish() && -> bool { authority.finish(); return authority.finish(); } };
auto test() -> i64 { return 42; }
@case execution authority requires unsigned slot
@error
module app; ${EXECUTION_HEAD}
auto run() -> builtin::ExecutionObservation { const builtin::ExecutionObservation event = authority.activate(0); return event; }
${EXECUTION_FINISH} auto test() -> i64 { return 42; }
@prelude EXECUTION_BYTE_HEAD
class Lifecycle {
    builtin::ExecutionAuthority authority;
    array<u8, 32> state;
public:
    Lifecycle(builtin::ExecutionAuthority input) : authority(move(input)), state{} {}
@case execution effect rejects live sibling span
@error
module app; ${EXECUTION_BYTE_HEAD}
auto run() -> u64 { const builtin::span<const u8> view = borrow_bytes(state);
const builtin::ExecutionObservation event = authority.activate(0u64); return u64(view.at(0)) + event.event; }
${EXECUTION_FINISH} auto test() -> i64 { return 42; }
@case execution consume rejects live sibling span
@error
module app; ${EXECUTION_BYTE_HEAD}
auto finish() && -> bool { const builtin::span<const u8> view = borrow_bytes(state); return authority.finish(); } };
auto test() -> i64 { return 42; }

@case command and resident lifecycle modules compose without nominal collision
module app;
import kernel.execution_session;
import kernel.execution_lifecycle;
auto test() -> i64 {
    static_assert(size_of(kernel::ExecutionResult) == 16);
    static_assert(size_of(kernel::LifecycleResult) == 24);
    static_assert(type_id(kernel::ExecutionResult) != type_id(kernel::LifecycleResult));
    const kernel::ExecutionResult command = kernel::ExecutionResult(builtin::ExecStatus::exited, 40u64);
    const kernel::LifecycleResult lifecycle = kernel::LifecycleResult(6u64, 2u64, 1u64);
    return i64(command.value() + lifecycle.detail);
}
@module kernel.execution_session
${EXECUTION_SESSION_MODULE}
@module kernel.execution_lifecycle
${EXECUTION_LIFECYCLE_MODULE}

@case service invalidation does not discharge consuming finish
@error
module app; ${EXECUTION_HEAD}
auto finish() && -> bool { return authority.invalidate_service(0u64); } };
auto test() -> i64 { return 42; }
@case service invalidation rejects live sibling span
@error
module app; ${EXECUTION_BYTE_HEAD}
auto invalidate() -> bool { const builtin::span<const u8> view = borrow_bytes(state);
return authority.invalidate_service(0u64); }
${EXECUTION_FINISH} auto test() -> i64 { return 42; }

@case typed directory entry copies a complete scalar array and preserves nominal kind
module app;
auto test()->i64 {
    array<u8,256> source = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx";
    const builtin::HostDirectoryEntry entry = builtin::HostDirectoryEntry{
        .status=builtin::HostStatus::success,.kind=builtin::HostEntryKind::regular,.count=255u64,.bytes=source};
    source[0]=0u8;
    source[255]=0u8;
    array<u8,256> saved=entry.bytes;
    if(saved[0]!='x'||saved[255]!='x'||entry.kind!=builtin::HostEntryKind::regular||entry.count!=255u64){return 0;}
    saved[1]=0u8;
    const array<u8,256> again=entry.bytes;
    static_assert(size_of(builtin::HostDirectoryEntry)==280);
    if(again[1]!='x'){return 0;}
    return 42;
}
@case designated array field preserves later initializer evaluation
module app;
class Counter {u64 count;public:Counter():count(0u64){}auto next()->u64{count=count+1u64;return count;}auto get()const->u64{return count;}};
auto test()->i64 {
    const array<u8,256> source="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
    Counter counter=Counter();
    const builtin::HostDirectoryEntry entry=builtin::HostDirectoryEntry{
        .bytes=source,.count=counter.next(),.kind=builtin::HostEntryKind::unknown,.status=builtin::HostStatus::success};
    const array<u8,256> saved=entry.bytes;
    if(counter.get()!=1u64||entry.count!=1u64||saved[255]!='a'){return 0;}
    return 42;
}
@case designated directory array rejects a wrong length
@error
module app;auto test()->i64{const array<u8,1> source="a";const builtin::HostDirectoryEntry entry=builtin::HostDirectoryEntry{.status=builtin::HostStatus::success,.kind=builtin::HostEntryKind::regular,.count=1u64,.bytes=source};return 42;}
@case directory entry kind keeps nominal identity
@error
module app;auto test()->i64{const array<u8,256> source="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";const builtin::HostDirectoryEntry entry=builtin::HostDirectoryEntry{.status=builtin::HostStatus::success,.kind=1u64,.count=1u64,.bytes=source};return 42;}

@case designated byte array temporary ends before sibling branch return
module app;
auto choose(bool first)->builtin::HostDirectoryEntry {
    const array<u8,256> source="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx";
    if(first){const builtin::HostDirectoryEntry entry=builtin::HostDirectoryEntry{
        .status=builtin::HostStatus::success,.kind=builtin::HostEntryKind::regular,.count=1u64,.bytes=source};return entry;}
    const builtin::HostDirectoryEntry entry=builtin::HostDirectoryEntry{
        .status=builtin::HostStatus::success,.kind=builtin::HostEntryKind::unknown,.count=2u64,.bytes=source};return entry;
}
auto test()->i64{const builtin::HostDirectoryEntry left=choose(true);const builtin::HostDirectoryEntry right=choose(false);const array<u8,256> a=left.bytes;const array<u8,256> b=right.bytes;if(left.count!=1u64||right.count!=2u64||a[0]!='x'||b[255]!='x'){return 0;}return 42;}

@case copied HostChunk array can initialize a complete designated value
module app;
auto clone(builtin::HostChunk source)->builtin::HostChunk{
    const array<u8,504> bytes=source.bytes;
    const builtin::HostChunk result=builtin::HostChunk{.status=source.status,.count=source.count,.bytes=bytes};
    return result;
}
auto test()->i64{
    array<u8,504> bytes="";
    const builtin::HostChunk original=builtin::HostChunk{.status=builtin::HostStatus::success,.count=504u64,.bytes=bytes};
    const builtin::HostChunk copied=clone(original);
    bytes[503]=0u8;
    const array<u8,504> saved=copied.bytes;
    static_assert(size_of(builtin::HostChunk)==520);
    if(copied.status!=builtin::HostStatus::success||copied.count!=504u64||saved[0]!='z'||saved[503]!='z'){return 0;}
    return 42;
}
