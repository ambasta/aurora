# Fixed class_arrays.py cases; the format is native_runner.Suite.load's.
@prelude PACKED
class Packed{u8 a;u8 b;u8 c;public:Packed(u8 x,u8 y,u8 z):a(x),b(y),c(z){}auto code()const->i64{return i64(a)*65536+i64(b)*256+i64(c);}};
@case local projections are independent of initializer and array copies
module app;${LEAF}auto test()->i64{${SETUP}const array<Leaf,2> saved=items;first.set(0);second.set(0);Leaf extracted=items[0];extracted.set(99);items[0]=second;const Leaf a=saved[0];const Leaf b=saved[1];const Leaf changed=items[0];if(changed.get()!=0||extracted.get()!=99){return 0;}return a.get()+b.get();}
@case replacement copies a complete named readonly argument
module app;${LEAF}auto consume(Leaf value)->i64{return value.get();}auto test()->i64{${SETUP}const Leaf replacement=Leaf(42);items[1]=replacement;const Leaf result=items[1];return consume(result);}
@case index is evaluated once for read and store
module app;${LEAF}class Counter{i64 value;public:Counter():value(0){}auto next()->i64{const i64 old=value;value=value+1;return old;}auto count()const->i64{return value;}};auto test()->i64{${SETUP}Counter counter=Counter();const Leaf a=items[counter.next()];items[counter.next()]=first;const Leaf b=items[1];if(counter.count()!=2||a.get()!=7||b.get()!=7){return 0;}return 42;}
@case store snapshots named source after index effects
@expect 8
module app;${LEAF}auto test()->i64{${SETUP}items[first.set(1)]=first;first.set(9);const Leaf a=items[0];const Leaf b=items[1];return a.get()+b.get();}
@case loops branches and shadowing retain independent storage
module app;${LEAF}auto test()->i64{${SETUP}Leaf replacement=Leaf(21);i64 i=0;while(i<len(items)){if(i==0){items[i]=replacement;}else{items[i]=replacement;}i=i+1;}{const array<Leaf,2> items=items;const Leaf first=items[0];if(first.get()!=21){return 0;}}const Leaf a=items[0];const Leaf b=items[1];return a.get()+b.get();}
@case private array constructor and copied containing class boundaries
module app;${LEAF}${HOLDER}auto identity(Holder value)->Holder{return value;}auto test()->i64{Leaf first=Leaf(7);Leaf second=Leaf(35);Holder original=Holder(first,second);const Holder saved=identity(original);Leaf replacement=Leaf(99);original.set(0,replacement);replacement.set(0);Leaf extracted=original.at(0);extracted.set(0);const Leaf stored=original.at(0);if(stored.get()!=99){return 0;}return saved.sum();}
@case constructor snapshots class parameters before later mutation
module app;${LEAF}class Snapshot{array<Leaf,2> items;i64 code;public:Snapshot(Leaf source,i64 marker):items{source,source},code(marker){}auto get()const->i64{const Leaf value=items[1];return value.get();}auto marker()const->i64{return code;}};auto test()->i64{Leaf source=Leaf(7);Snapshot saved=Snapshot(source,source.set(42));if(source.get()!=42||saved.get()!=7){return 0;}return saved.marker();}
@case private field read and replacement evaluate sibling indices once
module app;${LEAF}class Indexed{array<Leaf,2> items;i64 index;public:Indexed(Leaf source):items{source,source},index(0){}auto next()->i64{const i64 old=index;index=index+1;return old;}auto exercise(Leaf replacement)->i64{const Leaf old=items[next()];items[next()]=replacement;const Leaf result=items[1];if(index!=2||old.get()!=7){return 0;}return result.get();}};auto test()->i64{Leaf source=Leaf(7);Leaf next=Leaf(42);Indexed items=Indexed(source);return items.exercise(next);}
@case three byte class stride has no rounded gaps or overcopy
module app;${PACKED}auto test()->i64{Packed a=Packed(1u8,2u8,3u8);Packed b=Packed(4u8,5u8,6u8);Packed c=Packed(7u8,8u8,9u8);array<Packed,3> items={a,b,c};const array<Packed,3> saved=items;items[1]=a;static_assert(size_of(array<Packed,3>)==9);const Packed first=items[0];const Packed middle=items[1];const Packed last=items[2];const Packed old=saved[1];if(first.code()!=66051||middle.code()!=66051||last.code()!=460809||old.code()!=263430){return 0;}return 42;}
@case private three byte elements preserve adjacent padded sentinels
module app;${PACKED}class PackedHolder{u8 before;array<Packed,3> items;u64 after;public:PackedHolder(Packed source):before(197u8),items{source,source,source},after(18446744073709551615u64){}auto set(Packed source)->i64{items[1]=source;return 0;}auto code()const->i64{const Packed value=items[1];return value.code();}auto intact()const->bool{return before==197u8&&after==18446744073709551615u64;}};auto test()->i64{Packed a=Packed(1u8,2u8,3u8);Packed b=Packed(4u8,5u8,6u8);PackedHolder holder=PackedHolder(a);const PackedHolder saved=holder;holder.set(b);if(holder.code()!=263430||saved.code()!=66051||!holder.intact()||!saved.intact()){return 0;}return 42;}
@case empty class array private field carries logical initialization
module app;${EMPTY}class EmptyHolder{array<Empty,2> values;public:EmptyHolder(Empty a):values{a,a}{}auto at(i64 i)const->Empty{const Empty result=values[i];return result;}};auto test()->i64{Empty source=Empty();EmptyHolder value=EmptyHolder(source);const EmptyHolder copied=value;const Empty result=copied.at(1);return result.answer();}
@case three class levels plus array reach exact containment depth four
module app;class One{public:i64 value;One():value(42){} };class Two{public:One child;Two(One source):child(source){} };class Three{public:Two child;Three(Two source):child(source){} };auto test()->i64{One one=One();Two two=Two(one);Three source=Three(two);array<Three,1> items={source};const Three a=items[0];const Two b=a.child;const One result=b.child;return result.value;}
@case concrete nested template array identity normalizes capacity spelling
module app;import std.utility;auto test()->i64{std::pair<i64,u8> inner=std::pair<i64,u8>(40,2u8);std::pair<std::pair<i64,u8>,u8> source=std::pair<std::pair<i64,u8>,u8>(inner,0u8);array<std::pair<std::pair<i64,u8>,u8>,02> items={source,source};const array<std::pair<std::pair<i64,u8>,u8>,2> saved=items;const std::pair<std::pair<i64,u8>,u8> outer=saved[1];const std::pair<i64,u8> result=outer.first;return result.first+i64(result.second);}
@case fixed class elements inside scalar class template stay concrete
module app;${LEAF}template<Scalar T>class Fixed{array<Leaf,2> items;public:Fixed(Leaf source):items{source,source}{}auto at(i64 i)const->Leaf{const Leaf result=items[i];return result;}};auto test()->i64{Leaf source=Leaf(42);Fixed<i64> fixed=Fixed<i64>(source);const Leaf value=fixed.at(1);return value.get();}
@case fixed concrete array element survives function template substitution
module app;${LEAF}template<Scalar T>auto fixed(T number)->i64{Leaf source=Leaf(number);array<Leaf,1> items={source};const Leaf result=items[0];return result.get();}auto test()->i64{return fixed<i64>(42);}
@case private imported element type stays private
@error
module app;import secret;auto test()->i64{array<Secret,1> values={};return 42;}
@module secret
export module secret;class Secret{};
@case same layout specialization is not an exact element
@error
module app;import std.utility;auto test()->i64{std::pair<i64,u64> first=std::pair<i64,u64>(1,2u64);std::pair<u64,i64> other=std::pair<u64,i64>(2u64,1);array<std::pair<i64,u64>,1> values={other};return 42;}
@case std array Scalar wrapper still rejects copied classes
@error
module app;import std.array;${LEAF}auto test()->i64{std::array<Leaf,2> values=std::array<Leaf,2>();return 42;}
@case Value class template substitution cannot create class element storage
@error
module app;${LEAF}template<Value T>class Generic{array<T,2> items;public:Generic():items{}{} };auto test()->i64{Generic<Leaf> values=Generic<Leaf>();return 42;}
@case Value function substitution cannot create class element storage
@error
module app;${LEAF}template<Value T>auto generic(T source)->i64{array<T,1> values={source};return 42;}auto test()->i64{Leaf source=Leaf(42);return generic<Leaf>(source);}
@case empty payload local still requires complete named initializers
@error
module app;${EMPTY}auto test()->i64{array<Empty,64> values={};return 42;}
@case empty payload field cannot use implicit zero initialization
@error
module app;${EMPTY}class Holder{array<Empty,2> values;public:Holder():values{}{} };auto test()->i64{return 42;}
@case scalar field nonempty braces remain unsupported
@error
module app;class Holder{array<i64,2> values;public:Holder():values{1,2}{} };auto test()->i64{return 42;}
@case private field inaccessible externally
@error
module app;${LEAF}${HOLDER}auto test()->i64{Leaf source=Leaf(42);Holder holder=Holder(source,source);const Leaf value=holder.items[0];return value.get();}
@case valid class-array reflection preserves nominal identity and canonical extent
module app;${LEAF}class Other { i64 value; public: Other(i64 n):value(n){} };auto test()->i64{if (size_of(array<Leaf,2>) != 16 || field_count(array<Leaf,2>) != 0) { return 0; }if (type_id(array<Leaf,02>) != type_id(array<Leaf,2>)) { return 1; }if (type_id(array<Leaf,2>) == type_id(array<Other,2>)) { return 2; } return 42;}
