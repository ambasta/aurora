; CHECK: probe_scalar:
; CHECK-NEXT:     pushq %rbp
; CHECK-NEXT:     movq %rsp, %rbp
; CHECK-PROBES: 32
; CHECK-NEXT:     movq %r10, -24(%rbp)
; CHECK-NEXT:     movq %r11, -32(%rbp)
; RUN: emit
; CHECK-DAG: .Laurora_bounds_trap:\n    ud2\n
; CHECK-DAG: .Laurora_overflow_trap:\n    ud2\n
; CHECK-DAG: .Laurora_division_zero_trap:\n    ud2\n
; CHECK-DAG: .Laurora_shift_count_trap:\n    ud2\n
; RUN: stack-facts
; CHECK-JSON: functions.probe_scalar.local_bytes 48
; CHECK-JSON: functions.probe_scalar.calls {}
; CHECK-JSON: functions.probe_scalar.copied_record null
layout Box [i64]
function probe_scalar
  result i64
  params [(class Box)]
  frame 16
  receiver Box true true
  slot 8 i64
  object 8 Box false
    BindObjectParameter 0 8 Box
    Load 8
    ReceiverStore
    Constant
    Return
end

