; CASE: resource call, hidden allocation and cleanup facts
; RUN: emit
; CHECK: resource_caller:
; CHECK-NEXT:     pushq %rbp
; CHECK-NEXT:     movq %rsp, %rbp
; CHECK-PROBES: [[#CALLER:]] 48..
; CHECK: resource_callee:
; CHECK-NEXT:     pushq %rbp
; CHECK-NEXT:     movq %rsp, %rbp
; CHECK-PROBES: [[#CALLEE:]] 48..
; RUN: stack-facts
; CHECK-JSON: functions.resource_caller.copied_record null
; CHECK-JSON: functions.resource_callee.copied_record null
; CHECK: "resource_callee":{"local_bytes":[[#CALLEE_LOCAL:]],"calls":{"__au_runtime_bytes_drop":[[#CALLEE_DROP:]]},
; CHECK: "resource_caller":{"local_bytes":[[#LOCAL:]],"calls":{"__au_runtime_bytes_allocate":[[#ALLOCATE:]],"__au_runtime_bytes_drop":[[#DROP:]],"resource_callee":[[#CALL:]]},
; CHECK-RANGE: [[#CALLEE_DROP]] [[#CALLEE+16]]..[[#CALLEE_LOCAL]]
; CHECK-RANGE: [[#ALLOCATE]] [[#CALLER+16]]..[[#LOCAL]]
; CHECK-RANGE: [[#DROP]] [[#CALLER+16]]..[[#LOCAL]]
; CHECK-RANGE: [[#CALL]] [[#CALLER+16]]..[[#LOCAL]]
; CHECK-RANGE: [[#CALLEE_DROP%16]] 0..0
; CHECK-RANGE: [[#ALLOCATE%16]] 0..0
; CHECK-RANGE: [[#DROP%16]] 0..0
; CHECK-RANGE: [[#CALL%16]] 0..0
function resource_caller
  result i64
  params [region]
  frame 48
  region 8
  bytes 40 true
    BindRegionParameter 0 8
    BeginBytes 40
    Constant 1
    AllocateBytes 8 40
    ResourceCall resource_callee 8 [0 40]
    EndBytes 40
    Constant 42
    Return
end
function resource_callee
  result i64
  params [region bytes]
  frame 48
  region 8
  bytes 40 true
    BindRegionParameter 0 8
    BindBytesParameter 1 40
    BytesLength 40
    EndBytes 40
    Return
end
