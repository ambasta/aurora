; CASE: packed call facts and outgoing record probes odd=0
; RUN: emit
; CHECK: probe_target:
; CHECK-NEXT:     pushq %rbp
; CHECK-NEXT:     movq %rsp, %rbp
; CHECK-PROBES: [[#TARGET:]] 16..
; CHECK: probe_caller:
; CHECK-NEXT:     pushq %rbp
; CHECK-NEXT:     movq %rsp, %rbp
; CHECK-PROBES: [[#RES:]] 32..
; CHECK:     subq $[[#RECORD:]], %rsp
; CHECK-NEXT:     orq $0, (%rsp)
; CHECK-NEXT: {{^(?!    subq \$)}}
; CHECK-RANGE: [[#RECORD]] 8..
; CHECK-RANGE: [[#RECORD%16]] 0..0
; CHECK-DAG: {{^    (movq %rsp|leaq [0-9]+\(%rsp\)), %r11$}}
; CHECK-DAG: {{^    leaq -?[0-9]+\(%rbp\), %r10$}}
; CHECK-NEXT:     call probe_target
; CHECK-NEXT:     addq $[[#RECORD]], %rsp
; RUN: stack-facts
; CHECK-JSON: functions.probe_target.copied_record {"parameter_bytes":[8],"result_bytes":8}
; CHECK-JSON: functions.probe_target.local_bytes [[#TARGET+16]]
; CHECK: "probe_caller":{"local_bytes":[[#LOCAL:]],"calls":{"probe_target":[[#CALL:]]}
; CHECK-RANGE: [[#CALL]] [[#RES+16+RECORD]]..[[#LOCAL]]
; CHECK-RANGE: [[#CALL%16]] 0..0
layout Box [i64]
function probe_target
  result (class Box)
  params [(class Box)]
  frame 16
  slot 8 i64
  object 8 Box false
    BindObjectParameter 0 8 Box
    ReturnObject 8
end
function probe_caller
  result i64
  params [(class Box)]
  frame 32
  slot 8 i64
  slot 16 i64
  object 8 Box false
  object 16 Box false
    BindObjectParameter 0 8 Box
    BeginObject 16
    AggregateCall probe_target [8] 16
    Load 16
    Return
end

; CASE: packed call facts and outgoing record probes odd=1
; BASE: packed call facts and outgoing record probes odd=0
; RUN: emit
; CHECK: probe_target:
; CHECK-NEXT:     pushq %rbp
; CHECK-NEXT:     movq %rsp, %rbp
; CHECK-PROBES: [[#TARGET:]] 16..
; CHECK: probe_caller:
; CHECK-NEXT:     pushq %rbp
; CHECK-NEXT:     movq %rsp, %rbp
; CHECK-PROBES: [[#RES:]] 32..
; CHECK:     subq $[[#RECORD:]], %rsp
; CHECK-NEXT:     orq $0, (%rsp)
; CHECK-NEXT: {{^(?!    subq \$)}}
; CHECK-RANGE: [[#RECORD]] 8..
; CHECK-RANGE: [[#RECORD%16]] 0..0
; CHECK-DAG: {{^    (movq %rsp|leaq [0-9]+\(%rsp\)), %r11$}}
; CHECK-DAG: {{^    leaq -?[0-9]+\(%rbp\), %r10$}}
; CHECK-NEXT:     subq $[[#PAD:]], %rsp
; CHECK-NEXT:     call probe_target
; CHECK-NEXT:     addq $[[#PAD]], %rsp
; CHECK-NEXT:     addq $[[#RECORD]], %rsp
; CHECK: addq {{%r[a-z0-9]+}}, {{%r[a-z0-9]+}}\n    jo .Laurora_overflow_trap\n
; RUN: stack-facts
; CHECK-JSON: functions.probe_target.copied_record {"parameter_bytes":[8],"result_bytes":8}
; CHECK-JSON: functions.probe_target.local_bytes [[#TARGET+16]]
; CHECK: "probe_caller":{"local_bytes":[[#LOCAL:]],"calls":{"probe_target":[[#CALL:]]}
; CHECK-RANGE: [[#CALL]] [[#RES+16+8+RECORD]]..[[#LOCAL]]
; CHECK-RANGE: [[#CALL%16]] 0..0
@@ -20,0 +21,2 @@
+    Constant 1
+    Push
@@ -22,0 +25 @@
+    BinaryValue
