; CASE: copied record facts: empty class
; RUN: stack-facts
; CHECK-JSON: functions.probe_scalar.copied_record null
layout Box []
function probe_scalar
  result (class Box)
  params [(class Box)]
  frame 32
  object 32 Box false
    BindObjectParameter 0 32 Box
    ReturnObject 32
end

; CASE: copied record facts: one u8
; BASE: copied record facts: empty class
; RUN: stack-facts
; CHECK-JSON: functions.probe_scalar.copied_record null
@@ -1 +1 @@
-layout Box []
+layout Box [u8]
@@ -5,0 +6 @@
+  slot 32 u8

