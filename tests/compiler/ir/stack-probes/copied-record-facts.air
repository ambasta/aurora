+  slot 32 i64

; CASE: copied record facts: eight u8 leaves
; RUN: stack-facts
; CHECK-JSON: functions.probe_scalar.copied_record {"parameter_bytes":[8],"result_bytes":8}
layout Box [u8*8]
function probe_scalar
  result (class Box)
  params [(class Box)]
  frame 32
  slot 25 u8
  slot 26 u8
  slot 27 u8
  slot 28 u8
  slot 29 u8
  slot 30 u8
  slot 31 u8
  slot 32 u8
  object 32 Box false
    BindObjectParameter 0 32 Box
    ReturnObject 32
end

