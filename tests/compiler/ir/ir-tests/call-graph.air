; CASE: transitive graph retention preserves order and stable callable IDs
; RUN: metadata
; CHECK: callable [[#LEAF:]] leaf 
; CHECK: callable [[#LEAF+1]] unused 
; CHECK: callable [[#LEAF+2]] bridge 
; CHECK: callable [[#LEAF+3]] root 
; CHECK: callable [[#LEAF+4]] other_root 
; CHECK: {{^retained leaf bridge root other_root$}}
; CHECK: code bridge {{[0-9]+}} id [[#BRIDGE:]] 
; CHECK: body root [[#LEAF+3]]
; CHECK-NEXT: code root 0 id [[#ROOT:]] 
; CHECK-SAME: {{: Call bridge$}}
; CHECK-RANGE: [[#ROOT]] [[#BRIDGE+1]]..
; CHECK-NEXT: code root 1 id [[#ROOT+1]] 
; CHECK-SAME: {{: Call bridge$}}
; CHECK-NEXT: code root 2 id [[#ROOT+2]] 
; CHECK-NEXT: body other_root [[#LEAF+4]]
; RUN: abi-facts
; RUN: abi-facts
; ABI: function unused ignored_pruned_function ignored_member
; CHECK-RUN-EQUAL: 2
; RUN: metadata
; CHECK-NOT: {{^callable 5 }}
views [(0 []) (1 [])]
function leaf
  result i64
  frame 0
  scope 1
    Constant 42
    Return
end
function unused
  result i64
  frame 0
  scope 1
    Constant 42
    Return
end
function bridge
  result i64
  frame 0
  scope 1
    Call leaf
    Return
end
function root
  result i64
  frame 0
    Call bridge
    Call bridge
    Return
    Jump 1
    Label 1
end
function other_root
  result i64
  frame 0
    Constant 42
    Return
end

