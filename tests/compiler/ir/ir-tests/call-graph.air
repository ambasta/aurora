; CASE: unused acyclic receiver component is pruned
; RUN: metadata
; CHECK: {{^retained root$}}

layout Pair [i64 bool]
views [(0 []) (1 [])]
function test
  result i64
  frame 16
  scope 1
  slot 8 bool
  slot 16 i64
  object 16 Pair false
    BeginObject 16
    Constant 42
    Push
    Constant 1 bool
    Push
    MethodCall construct_pair 16
    MethodCall relay_pair 16
    Return
end
function construct_pair
  result i64
  params [i64 bool]
  frame 16
  scope 1
  receiver Pair true true
  slot 8 i64
  slot 16 bool
    BindParameter 0 8
    BindParameter 1 16 bool
    Load 8
    ReceiverStore
    Load 16 bool
    ReceiverStore 1 bool
    Constant
    Return
end
function get_pair
  result i64
  frame 0
  scope 1
  receiver Pair false false
    ReceiverLoad
    Return
end
function relay_pair
  result i64
  frame 0
  scope 1
  receiver Pair false false
    MethodCall get_pair
    Return
end
function root
  result i64
  frame 0
    Constant 42
    Return
end

; CASE: unused imported receiver cycle is checked before pruning
; BASE: unused acyclic receiver component is pruned
; RUN: verify
; EXPECT-ERROR: invalid typed IR: recursive receiver call cycle
@@ -41 +41 @@
-    ReceiverLoad
+    MethodCall relay_pair

; CASE: service forwarding retains scalar descendants and permits unrelated scalar cycles
; RUN: metadata
; CHECK: {{^retained leaf service_helper service_root$}}

views [(0 []) (1 [])]
function leaf
  result i64
  frame 0
  scope 1
    Constant 42
    Return
end
function cycle_a
  result i64
  frame 0
  scope 1
    Call cycle_b
    Return
end
function service_helper
  result i64
  params [console]
  frame 16
  scope 1
  service 16
    BindServiceParameter 0 16
    Call leaf
    Return
end
function cycle_b
  result i64
  frame 0
  scope 1
    Call cycle_a
    Return
end
function service_root
  result i64
  params [console]
  frame 16
  service 16
    BindServiceParameter 0 16
    AcquireServiceLoan 1 16
    ServiceCall service_helper 1 0 [0]
    ReleaseServiceLoan 1
    Return
end

