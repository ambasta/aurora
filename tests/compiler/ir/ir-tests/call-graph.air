; CASE: unused imported call mode precedes earlier dynamic state: plain call cannot target receiver function
; RUN: verify
; EXPECT-ERROR: plain call cannot target receiver function
layout CallReceiver [i64]
views [(0 []) (1 [])]
function leaf
  result i64
  frame 0
  scope 1
    Pop
    Return
end
function unused
  result i64
  frame 0
  scope 1
    Call receiver_target
    Return
end
function bridge
  result i64
  frame 0
  scope 1
    Call leaf
    Return
end
function root
  result i64
  frame 0
    Call bridge
    Call bridge
    Return
    Jump 1
    Label 1
end
function other_root
  result i64
  frame 0
    Constant 42
    Return
end
function receiver_target
  result i64
  frame 0
  scope 1
  receiver CallReceiver false false
    ReceiverLoad
    Return
end

