; CASE: source entry copied exact empty root
; RUN: verify
; EXPECT-ERROR: object parameter requires exact object slot
layout Empty []
function test
  result i64
  frame 16
  object 8 Empty false
  object 16 Empty false
    BeginObject 8
    InitializeEmptyObject 8
    BeginObject 16
    AggregateCall copy_empty [8] 16
    Constant 42
    Return
end
function copy_empty
  result (class Empty)
  params [(class Empty)]
  frame 16
  object 8 Empty false
    BindObjectParameter 0 16 Empty
    ReturnObject 8
end
function make_empty
  result (class Empty)
  frame 16
  object 8 Empty false
    BeginObject 8
    InitializeEmptyObject 8
    ReturnObject 8
end

