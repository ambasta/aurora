; CASE: all-body CFG normalization precedes entry admission with stable instruction IDs
; RUN: metadata
; CHECK-NOT: {{^body }}
; CHECK: body test {{[0-9]+$}}
; CHECK-NEXT: code test 0 
; CHECK-NEXT: code test 1 
; CHECK-NEXT: code test 2 
; CHECK-NEXT: code test 3 id [[#TEST:]] 
; CHECK-NEXT: body entry_parameters {{[0-9]+$}}
; CHECK-NEXT: code entry_parameters 0 id [[#FIRST:]] 
; CHECK-SAME: : BindParameter 0 
; CHECK-RANGE: [[#FIRST]] [[#TEST+1]]..
; CHECK-NEXT: code entry_parameters 1 id [[#FIRST+1]] 
; CHECK-SAME: : BindParameter 1 
; CHECK-NEXT: code entry_parameters 2 id [[#FIRST+2]] target 3 
; CHECK-NEXT: code entry_parameters 3 id [[#JOIN:]] 
; CHECK-RANGE: [[#JOIN]] [[#FIRST+4]]..
; CHECK-NEXT: code entry_parameters 4 
; CHECK-NEXT: code entry_parameters 5 
; CHECK-NOT: code entry_parameters 6 
function test
  result i64
  frame 16
  slot 8 i64
    Constant 42
    Store 8
    Load 8
    Return
    Jump 7
    Label 7
end
function entry_parameters
  result i64
  params [i64 i64]
  frame 16
  slot 8 i64
  slot 16 i64
    BindParameter 0 8
    BindParameter 1 16
    Jump 7
    Label 6
    Jump 7
    Label 7
    Load 8
    Return
end

