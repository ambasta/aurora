; CASE: u64 nominal receiver construction and forwarding
; RUN: emit
layout Pair [u64 bool]
function test
  result u64
  frame 16
  slot 8 bool
  slot 16 u64
  object 16 Pair false
    BeginObject 16
    Constant -1 u64
    Push
    Constant 1 bool
    Push
    MethodCall construct_pair 16
    MethodCall relay_pair 16
    Return
end
function construct_pair
  result i64
  params [u64 bool]
  frame 16
  receiver Pair true true
  slot 8 u64
  slot 16 bool
    BindParameter 0 8 u64
    BindParameter 1 16 bool
    Load 8 u64
    ReceiverStore 0 u64
    Load 16 bool
    ReceiverStore 1 bool
    Constant
    Return
end
function get_pair
  result u64
  frame 0
  receiver Pair false false
    ReceiverLoad 0 u64
    Return
end
function relay_pair
  result u64
  frame 0
  receiver Pair false false
    MethodCall get_pair
    Return
end

