; CHECK-NOT: __au_reflect_s1_size
; CHECK-NOT: __au_reflect_s2_field_count
; CHECK-NOT: __au_reflect_s2_size
; CHECK-NOT: __au_reflect_s63_field_count
; CHECK-NOT: __au_reflect_s63_size
; CHECK-NOT: aurora_reflect_field_count

