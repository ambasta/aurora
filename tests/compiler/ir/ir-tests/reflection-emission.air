; CASE: referenced reflection retains referenced helper bodies and facts
; RUN: emit
; RUN: emit referenced
; CHECK-RUN-EQUAL: 1 aurora_reflect_size:\n|.size aurora_reflect_size,
; CHECK-RUN-EQUAL: 1 __au_reflect_s1_field_count:\n|.size __au_reflect_s1_field_count,
; CHECK-NOT: aurora_reflect_field_count:\n
; CHECK-NOT: __au_reflect_s1_size:\n
; CHECK-NOT: __au_reflect_s2_size:\n
; CHECK-NOT: __au_reflect_s2_field_count:\n
; RUN: stack-facts referenced
; CHECK-JSON-COUNT: functions 4
; CHECK-JSON-NOT: functions.test.calls.aurora_reflect_size <missing>
; CHECK-JSON-NOT: functions.scoped.calls.__au_reflect_s1_field_count <missing>
; CHECK-JSON: functions.aurora_reflect_field_count <missing>
; CHECK-JSON: functions.__au_reflect_s1_size <missing>
; CHECK-JSON: functions.__au_reflect_s2_size <missing>
; CHECK-JSON: functions.__au_reflect_s2_field_count <missing>
descriptor 1 8 0
descriptor 100 16 1
descriptor 101 0 0
views [(0 [1 100 101]) (1 [1 100]) (2 [101])]
function test
  result i64
  frame 16
  slot 8 i64
    Constant 100
    MetadataQuery
    Store 8
    Call scoped
    Load 8
    Return
end
function scoped
  result i64
  frame 16
  scope 1
  slot 8 i64
    Constant 100
    MetadataQuery PublicFieldCount 1
    Return
end
function unused
  result i64
  frame 16
  scope 2
  slot 8 i64
    Constant 101
    MetadataQuery Size 2
    Return
end

; CASE: query-free closed output retains no reflection helpers
; RUN: emit referenced
; CHECK-NOT: aurora_reflect_
; RUN: stack-facts referenced
; CHECK-JSON-COUNT: functions 1
function test
  result i64
  frame 16
  slot 8 i64
    Constant 42
    Store 8
    Load 8
    Return
end

; CASE: unreferenced invalid query still rejects
; BASE: referenced reflection retains referenced helper bodies and facts
; RUN: verify
; EXPECT-ERROR: changes defining-module scope
@@ -31 +31 @@
-    MetadataQuery Size 2
+    MetadataQuery Size 1

; CASE: sparse reflection views exceed code length
; RUN: emit
