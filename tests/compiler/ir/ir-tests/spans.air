    BindParameter 0 56
    BeginArray 8
    Constant 11 u8
    Store 8 u8
    Constant 128 u8
    Store 7 u8
    Constant 255 u8
    Store 6 u8
    BorrowSpan 8 256
    Load 56
    Push
    AggregateCall span_forward [0 0] 0 [256 0]
    EndSpan 256
    EndArray 8
    Return
end
function span_mixed_callee
  result (class SpanPacket)
  params [u8 span (class SpanPacket) i64 span bool]
  frame 640
  slot 1 u8
