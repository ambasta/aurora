function span_read
  result u8
  params [span i64]
  frame 640
  slot 8 i64
  span 256
    BindSpanParameter 0 256
    BindParameter 1 8
    Load 8
    SpanLoad 256
    EndSpan 256
    Return
end
function span_forward
  result u8
  params [span i64]
  frame 640
  slot 8 i64
  span 256
  span 320
    BindSpanParameter 0 256
    BindParameter 1 8
    ReborrowSpan 256 320
    Load 8
    Push
    AggregateCall span_read [0 0] 0 [320 0]
    EndSpan 320
    EndSpan 256
    Return
end
function span_dynamic
  result u8
  params [i64]
  frame 640
  slot 6 u8
  slot 7 u8
  slot 8 u8
  slot 56 i64
