; CASE: span signatures are local and bounds precede pointer and payload loads
; BASE: readonly span forwarding and six mixed argument positions
; RUN: emit
; CHECK-DAG: .local span_read\n
; CHECK-DAG: .local span_forward\n
; CHECK-DAG: .local span_mixed_callee\n
; CHECK-DAG: .local span_mixed_forward\n
; RUN: emit
; CHECK: {{^    cmpq -[0-9]+\(%rbp\), %r[a-z0-9]+$}}
; CHECK-NEXT: jae .Laurora_bounds_trap
; CHECK-NOT: movzbq
; CHECK: {{^    movq -[0-9]+\(%rbp\), }}[[POINTER:%r[a-z0-9]+]]
; CHECK-NEXT: movzbq ([[POINTER]],{{%r[a-z0-9]+}},1), {{%r[a-z0-9]+}}
