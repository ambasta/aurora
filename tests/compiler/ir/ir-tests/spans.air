    Push
    Load 96 bool
    Push
    AggregateCall span_mixed_callee [0 0 56 0*3] 128 [0 448 0 0 512 0]
    EndSpan 512
    EndSpan 448
    EndSpan 384
    EndSpan 256
    ReturnObject 128
end
