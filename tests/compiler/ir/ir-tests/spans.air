; CASE: readonly local byte span and reborrow
; RUN: emit
function span_local
  result u8
  frame 640
  slot 6 u8
  slot 7 u8
  slot 8 u8
  array 8 3
  span 256
  span 320
    BeginArray 8
    Constant 11 u8
    Store 8 u8
    Constant 128 u8
    Store 7 u8
    Constant 255 u8
    Store 6 u8
    BorrowSpan 8 256
    ReborrowSpan 256 320
    Constant 1
    SpanLoad 320
    EndSpan 320
    EndSpan 256
    EndArray 8
    Return
end

; CASE: frame array and span observations
; BASE: readonly local byte span and reborrow
; RUN: metadata
; CHECK: callable 0 span_local scope {{[0-9]+}} result {{[^ ]+}} frame 640
; CHECK: slot span_local 6 u8
; CHECK-NOT: array span_local
; CHECK: array span_local 8 3
; CHECK-NEXT: span span_local 256
; CHECK-NEXT: span span_local 320
; CHECK-NOT: {{^(span|bytes) span_local }}
; CHECK: origin span_local

; CASE: readonly span forwarding and six mixed argument positions
; RUN: emit
layout SpanPacket [u8 i64 u8]
function span_local
  result u8
  frame 640
  slot 6 u8
  slot 7 u8
  slot 8 u8
  array 8 3
  span 256
  span 320
    BeginArray 8
    Constant 11 u8
    Store 8 u8
    Constant 128 u8
    Store 7 u8
    Constant 255 u8
    Store 6 u8
    BorrowSpan 8 256
    ReborrowSpan 256 320
    Constant 1
    SpanLoad 320
    EndSpan 320
    EndSpan 256
    EndArray 8
    Return
end
