    BindSpanParameter 1 256
    BindObjectParameter 2 56 SpanPacket
    BindParameter 3 64
    BindSpanParameter 4 384
    BindParameter 5 96 bool
    BeginObject 128
    Constant
    Push
    AggregateCall span_forward [0 0] 0 [256 0]
    Convert u8
    Push
    Load 48
    BinaryValue
    Push
    Load 64
    BinaryValue
    Push
    Constant 2
    Push
    AggregateCall span_forward [0 0] 0 [384 0]
    Convert u8
    BinaryValue
    Store 136
    Load 96 bool
    BranchFalse 1
    Load 136
    Push
    Constant 1
    BinaryValue
    Store 136
    Label 1
    Load 136
    Store 120
    Load 1 u8
    Store 128 u8
    Load 40 u8
    Store 112 u8
    EndSpan 384
    EndSpan 256
    ReturnObject 128
end
function span_mixed_forward
  result (class SpanPacket)
  params [u8 span (class SpanPacket) i64 span bool]
  frame 640
  slot 1 u8
  slot 40 u8
  slot 48 i64
  slot 56 u8
  slot 64 i64
