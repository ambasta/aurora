  object 16 Pair false
  object 32 Pair false
  object 48 Pair false
    BeginObject 16
    Constant 12 u8
    Store 16 u8
    Constant 1 bool
    Store 8 bool
    BeginObject 32
    Constant 20 u8
    Store 32 u8
    Constant 0 bool
    Store 24 bool
    Constant 10 u8
    Push
    Constant 1 bool
    Push
    BeginObject 48
    AggregateCall copy_pair [16 0 32 0] 48
    Load 48 u8
    Return
end
function copy_pair
  result (class Pair)
  params [(class Pair) u8 (class Pair) bool]
  frame 64
  slot 8 bool
  slot 16 u8
  slot 24 u8
  slot 32 bool
  slot 40 u8
  slot 48 bool
  slot 56 bool
  slot 64 u8
  object 16 Pair false
  object 40 Pair false
  object 64 Pair false
    BindObjectParameter 0 16 Pair
    BindParameter 1 24 u8
    BindObjectParameter 2 40 Pair
    BindParameter 3 48 bool
    BeginObject 64
    Load 16 u8
    Push
    Load 24 u8
    BinaryValue CheckedAdd u8
    Push
    Load 40 u8
    BinaryValue CheckedAdd u8
    Store 64 u8
    Load 48 bool
    Store 56 bool
    ReturnObject 64
end

