; CASE: u8 receiver construction and forwarding
; RUN: emit
layout Pair [u8 bool]
function byte_receiver
  result u8
  frame 16
  slot 8 bool
  slot 16 u8
  object 16 Pair false
    BeginObject 16
    Constant 255 u8
    Push
    Constant 1 bool
    Push
    MethodCall construct_pair 16
    MethodCall relay_pair 16
    Return
end
function construct_pair
  result i64
  params [u8 bool]
  frame 16
  receiver Pair true true
  slot 8 u8
  slot 16 bool
    BindParameter 0 8 u8
    BindParameter 1 16 bool
    Load 8 u8
    ReceiverStore 0 u8
    Load 16 bool
    ReceiverStore 1 bool
    Constant
    Return
end
function get_pair
  result u8
  frame 0
  receiver Pair false false
    ReceiverLoad 0 u8
    Return
end
function relay_pair
  result u8
  frame 0
  receiver Pair false false
    MethodCall get_pair
    Return
end

