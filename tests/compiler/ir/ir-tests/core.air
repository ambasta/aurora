function construct_pair
  result i64
  params [i64 bool]
  frame 16
  receiver Pair true true
  slot 8 i64
  slot 16 bool
    BindParameter 0 8
    BindParameter 1 16 bool
    Load 8
    ReceiverStore
    Load 16 bool
    ReceiverStore 1 bool
    Constant
    Return
end
function get_pair
  result i64
  frame 0
  receiver Pair false false
    ReceiverLoad
    Return
end
function relay_pair
  result i64
  frame 0
  receiver Pair false false
    MethodCall get_pair
    Return
end

