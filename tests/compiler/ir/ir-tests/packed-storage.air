; CASE: canonical mixed/nested/empty/tiny class byte layout
; BASE: packed bytes preserve composed receiver/results and tiny aggregate
; RUN: metadata
; CHECK-DAG: {{^}}class Empty storage [] [] 8 8 8
; CHECK-DAG: {{^}}class Leaf storage [0 8 9 16] [0 8 16 24] 24 8 24
; CHECK-DAG: {{^}}class Outer storage [0 8 16 17 24] [0 8 32] 32 8 32
; CHECK-DAG: {{^}}class Tiny storage [0 1 2] [0] 3 1 8
; RUN: metadata
; CHECK: {{^(?:class .*\n){3}class .*}}
; CHECK-NEXT: {{^(?!class )}}

; CASE: explicit canonical class storage metadata
; BASE: packed bytes preserve composed receiver/results and tiny aggregate
; RUN: emit
@@ -8,0 +9,4 @@
+storage Empty [] [] 8 8 8
+storage Leaf [0 8 9 16] [{0,8}*4] 24 8 24
+storage Outer [{0,8}*3 17 24] [0 8 32] 32 8 32
+storage Tiny [{0,1}*3] [0] 3 1 8

; CASE: forged class physical extent Empty
; BASE: packed bytes preserve composed receiver/results and tiny aggregate
; RUN: verify
; EXPECT-ERROR: noncanonical class storage metadata
@@ -8,0 +9,4 @@
+storage Empty [] [] 9 8 8
+storage Leaf [0 8 9 16] [{0,8}*4] 24 8 24
+storage Outer [{0,8}*3 17 24] [0 8 32] 32 8 32
+storage Tiny [{0,1}*3] [0] 3 1 8

; CASE: forged class physical extent Empty #2
; BASE: packed bytes preserve composed receiver/results and tiny aggregate
; RUN: verify
; EXPECT-ERROR: noncanonical class storage metadata
@@ -8,0 +9,4 @@
+storage Empty [] [] 8 9 8
+storage Leaf [0 8 9 16] [{0,8}*4] 24 8 24
+storage Outer [{0,8}*3 17 24] [0 8 32] 32 8 32
+storage Tiny [{0,1}*3] [0] 3 1 8

; CASE: forged class physical extent Empty #3
; BASE: packed bytes preserve composed receiver/results and tiny aggregate
; RUN: verify
; EXPECT-ERROR: noncanonical class storage metadata
@@ -8,0 +9,4 @@
+storage Empty [] [] 8 8 9
