; CASE: absent storage origins in scalar and empty frames
; RUN: metadata
; CHECK-DAG: origin test 1 object - byte -
; CHECK-DAG: origin test 8 object - byte -
; CHECK-DAG: origin test 16 object - byte -
; CHECK-DAG: origin empty_frame 1 object - byte -
; CHECK-DAG: origin empty_frame 8 object - byte -
; CHECK-DAG: origin empty_frame 16 object - byte -
function test
  result i64
  frame 16
  slot 8 i64
    Constant 42
    Store 8
    Load 8
    Return
end
function empty_frame
  result i64
  frame 16
    Constant 42
    Return
end

; CASE: absent storage origins reject later-kind groups
; RUN: metadata
; CHECK-DAG: origin span_local 6 object - byte 8
; CHECK-DAG: origin span_local 8 object - byte 8
; CHECK-DAG: origin span_local 9 object - byte -
; CHECK-DAG: origin span_local 256 object - byte -
function span_local
  result u8
  frame 640
  slot 6 u8
  slot 7 u8
  slot 8 u8
  array 8 3
  span 256
  span 320
    BeginArray 8
    Constant 11 u8
    Store 8 u8
    Constant 128 u8
    Store 7 u8
    Constant 255 u8
    Store 6 u8
    BorrowSpan 8 256
    ReborrowSpan 256 320
    Constant 1
    SpanLoad 320
    EndSpan 320
    EndSpan 256
    EndArray 8
    Return
end

; CASE: exact packed object leaf origins exclude padding and empty reservations
; RUN: metadata
; CHECK-DAG: origin packed_result_array 40 object 40 byte -
; CHECK-DAG: origin packed_result_array 32 object 40 byte -
; CHECK-DAG: origin packed_result_array 31 object 40 byte -
; CHECK-DAG: origin packed_result_array 24 object 40 byte -
; CHECK-DAG: origin packed_result_array 112 object 112 byte -
; CHECK-DAG: origin packed_result_array 104 object 112 byte -
; CHECK-DAG: origin packed_result_array 96 object 112 byte -
; CHECK-DAG: origin packed_result_array 95 object 112 byte -
; CHECK-DAG: origin packed_result_array 88 object 112 byte -
; CHECK-DAG: origin packed_result_array 184 object 184 byte -
; CHECK-DAG: origin packed_result_array 176 object 184 byte -
; CHECK-DAG: origin packed_result_array 175 object 184 byte -
; CHECK-DAG: origin packed_result_array 168 object 184 byte -
; CHECK-DAG: origin packed_result_array -2147483648 object - byte -
; CHECK-DAG: origin packed_result_array -1 object - byte -
; CHECK-DAG: origin packed_result_array 0 object - byte -
; CHECK-DAG: origin packed_result_array 1 object - byte -
; CHECK-DAG: origin packed_result_array 8 object - byte -
; CHECK-DAG: origin packed_result_array 23 object - byte -
; CHECK-DAG: origin packed_result_array 25 object - byte -
; CHECK-DAG: origin packed_result_array 30 object - byte -
; CHECK-DAG: origin packed_result_array 33 object - byte -
; CHECK-DAG: origin packed_result_array 39 object - byte -
; CHECK-DAG: origin packed_result_array 80 object - byte -
; CHECK-DAG: origin packed_result_array 94 object - byte -
; CHECK-DAG: origin packed_result_array 97 object - byte -
; CHECK-DAG: origin packed_result_array 174 object - byte -
; CHECK-DAG: origin packed_result_array 192 object - byte -
; CHECK-DAG: origin packed_result_array 193 object - byte -
; CHECK-DAG: origin packed_result_array 2147483647 object - byte -
; CHECK-DAG: origin packed_tiny_roundtrip 8 object 8 byte -
; CHECK-DAG: origin packed_tiny_roundtrip 7 object 8 byte -
; CHECK-DAG: origin packed_tiny_roundtrip 6 object 8 byte -
; CHECK-DAG: origin packed_tiny_roundtrip 16 object 16 byte -
; CHECK-DAG: origin packed_tiny_roundtrip 15 object 16 byte -
; CHECK-DAG: origin packed_tiny_roundtrip 14 object 16 byte -
; CHECK-DAG: origin packed_tiny_roundtrip 1 object - 
; CHECK-DAG: origin packed_tiny_roundtrip 5 object - 
; CHECK-DAG: origin packed_tiny_roundtrip 9 object - 
; CHECK-DAG: origin packed_tiny_roundtrip 13 object - 
; CHECK-DAG: origin packed_tiny_roundtrip 17 object - 
layout Empty []
layout Leaf [(enum Mode) u8 u8 bool]
layout Outer [i64 (enum Mode) u8 u8 bool]
layout Tiny [u8*3]
fields Empty []
fields Leaf [((enum Mode) 0 1 false) (u8 1 2 true) (bool 3 1 false) ((class Empty) 4 0 false)]
fields Outer [(i64 0 1 false) ((class Leaf) 1 4 false) ((class Empty) 5 0 false)]
fields Tiny [(u8 0 3 true)]
enum Mode 2
enum OtherMode 2
function packed_result_array
  result u8
  frame 192
repeat 3
  slot {24,32} bool
  slot {31,32} u8
  slot {32,32} u8
  slot {40,32} (enum Mode)
endrepeat
  slot 112 i64
  slot 128 bool
  slot 135 u8
  slot 136 u8
  slot 144 (enum Mode)
  slot 152 i64
  slot 168 bool
  slot 175 u8
  slot 176 u8
  slot 184 (enum Mode)
  object 8 Empty false
  object 40 Leaf true
  object 72 Leaf false
  object 112 Outer false
  object 152 Outer false
  object 184 Leaf true
  object 192 Empty false
    BeginObject 8
    InitializeEmptyObject 8
    BeginObject 40
    EnumConstant (enum Mode) 1
    Push
    Constant 1 bool
    Push
    MethodCall construct_leaf 40 [0 0 8]
    Constant
    Push
    Constant 11 u8
    Push
    MethodCall set_leaf 40
    Constant 1
    Push
    Constant 42 u8
    Push
    MethodCall set_leaf 40
    BeginObject 72
    CopyObject 40 72
    Constant 1
    Push
    Constant 99 u8
    Push
    MethodCall set_leaf 40
    BeginObject 112
    Constant 7
    Push
    Constant 5
    Push
    MethodCall construct_outer 112 [0 72 8 0]
    BeginObject 152
    Constant 5
    Push
    EnumConstant (enum Mode) 1
    Push
    MethodCall snapshot_outer 112 [] 152
    BeginObject 184
    ObjectFieldCopy 152 1 184
    Load 175 u8
    Return
end
function construct_leaf
  result i64
  params [(enum Mode) bool (class Empty)]
  frame 32
  receiver Leaf true true
  slot 8 (enum Mode)
  slot 16 bool
  object 24 Empty false
    BindParameter 0 8 (enum Mode)
    BindParameter 1 16 bool
    BindObjectParameter 2 24 Empty
    Load 8 (enum Mode)
    ReceiverStore 0 (enum Mode)
    Load 16 bool
    ReceiverStore 2 bool
    ReceiverArrayZero 1
    InitializeObjectField 0 3 24
    Constant
    Return
end
function construct_outer
  result i64
