; CASE: exact byte origins exclude scalars, descriptors and invalid offsets
; BASE: absent storage origins reject later-kind groups
; RUN: metadata
; CHECK-DAG: origin span_local 8 object - byte 8
; CHECK-DAG: origin span_local 7 object - byte 8
; CHECK-DAG: origin span_local 6 object - byte 8
; CHECK-DAG: origin span_local 5 object - byte 5
; CHECK-DAG: origin span_local 4 object - byte 5
; CHECK-DAG: origin span_local -2147483648 object - byte -
; CHECK-DAG: origin span_local -1 object - byte -
; CHECK-DAG: origin span_local 0 object - byte -
; CHECK-DAG: origin span_local 3 object - byte -
; CHECK-DAG: origin span_local 9 object - byte -
; CHECK-DAG: origin span_local 33 object - byte -
; CHECK-DAG: origin span_local 39 object - byte -
; CHECK-DAG: origin span_local 41 object - byte -
; CHECK-DAG: origin span_local 48 object - byte -
; CHECK-DAG: origin span_local 65 object - byte -
; CHECK-DAG: origin span_local 71 object - byte -
; CHECK-DAG: origin span_local 72 object - byte -
; CHECK-DAG: origin span_local 256 object - byte -
; CHECK-DAG: origin span_local 320 object - byte -
; CHECK-DAG: origin span_local 640 object - byte -
; CHECK-DAG: origin span_local 641 object - byte -
; CHECK-DAG: origin span_local 2147483647 object - byte -
; CHECK-DAG: origin span_local 40 object 72 byte -
@@ -0,0 +1,2 @@
+layout DescriptorAndByte [u8]
+fields DescriptorAndByte [(bytes 0 0 false) (u8 0 1 false)]
@@ -3,0 +6,3 @@
+  slot 3 u8
+  slot 4 u8
