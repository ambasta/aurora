; CASE: compact copies preserve registers and report transient stack peak
; BASE: 64-field value boundary accepted
; RUN: emit
; CHECK: test:
; CHECK-NEXT:     pushq %rbp
; CHECK-NEXT:     movq %rsp, %rbp
; CHECK-PROBES: [[#TEST:]] 1024..
; CHECK:     subq $[[#RECORD:]], %rsp
; CHECK-NEXT:     orq $0, (%rsp)
; CHECK-RANGE: [[#RECORD]] 512..
; CHECK-NEXT: {{^    leaq 0\(%rsp\), %r[a-z0-9]+$}}
; CHECK-DAG:     pushq %rsi
; CHECK-DAG:     pushq %rdi
; CHECK-DAG:     pushq %rcx
; CHECK: rep movsb
; CHECK-DAG:     popq %rcx
; CHECK-DAG:     popq %rdi
; CHECK-DAG:     popq %rsi
; CHECK: call copy_empty
; CHECK: copy_empty:
; CHECK-NEXT:     pushq %rbp
; CHECK-NEXT:     movq %rsp, %rbp
; CHECK-PROBES: [[#COPY:]] 512..
; CHECK-DAG:     pushq %rsi
; CHECK-DAG:     pushq %rdi
; CHECK-DAG:     pushq %rcx
; CHECK: rep movsb
; CHECK-DAG:     popq %rcx
; CHECK-DAG:     popq %rdi
; CHECK-DAG:     popq %rsi
; CHECK: .size copy_empty,
; RUN: stack-facts
; CHECK-JSON: functions.copy_empty.copied_record {"parameter_bytes":[512],"result_bytes":512}
; CHECK-JSON-RANGE: functions.copy_empty.local_bytes [[#COPY+16+8]]..
; CHECK-JSON-RANGE: functions.test.calls.copy_empty [[#TEST+16+RECORD]]..
; CHECK: "test":{"local_bytes":[[#LOCAL:]],"calls":{"copy_empty":[[#CALL:]]},
; CHECK-RANGE: [[#LOCAL]] [[#TEST+16+RECORD+8]]..
; CHECK-RANGE: [[#CALL%16]] 0..0

; CASE: aggregate edge cannot conceal receiver recursion
; RUN: verify
; EXPECT-ERROR: recursive receiver call cycle
layout Pair [i64 bool]
function test
  result i64
  frame 16
  slot 8 bool
  slot 16 i64
  object 16 Pair false
    BeginObject 16
    Constant 42
    Push
    Constant 1 bool
    Push
    MethodCall construct_pair 16
    MethodCall relay_pair 16
    Return
end
function construct_pair
  result i64
  params [i64 bool]
  frame 16
  receiver Pair true true
  slot 8 i64
  slot 16 bool
    BindParameter 0 8
    BindParameter 1 16 bool
    Load 8
    ReceiverStore
    Load 16 bool
    ReceiverStore 1 bool
    Constant
    Return
end
function get_pair
  result i64
  frame 16
  receiver Pair false false
  slot 8 bool
  slot 16 i64
  object 16 Pair false
    BeginObject 16
    ReceiverLoad
    Store 16
    ReceiverLoad 1 bool
    Store 8 bool
    AggregateCall value_bridge [16]
    Return
end
function relay_pair
  result i64
  frame 0
  receiver Pair false false
    MethodCall get_pair
    Return
end
function value_bridge
  result i64
  params [(class Pair)]
  frame 16
  slot 8 bool
  slot 16 i64
  object 16 Pair false
    BindObjectParameter 0 16 Pair
    MethodCall get_pair 16
    Return
end

