; CASE: plain complete local and forwarded roots
; RUN: emit
; RUN: stack-facts
layout Plain [i64]
fields Plain [(i64 0 1 false)]
storage Plain [0] [0] 8 8 8
function plain_entry
  result i64
  params [(class Plain)]
  frame 32
  slot 8 i64
  slot 16 i64
  slot 24 i64
  object 8 Plain false
  object 16 Plain true
  object 24 Plain false
    BindObjectParameter 0 8 Plain
    BeginObject 16
    CopyObject 8 16
    EndObject 8
    AcquireObjectLoan 1 16 true
    BorrowedCall plain_forward [(16 1 -1)]
    ReleaseObjectLoan 1
    BeginObject 24
    CopyObject 16 24
    AcquireObjectLoan 2 24
    BorrowedCall plain_read [(24 2 -1)]
    ReleaseObjectLoan 2
    EndObject 24
    EndObject 16
    Return
end
function plain_forward
  result i64
  params [(class Plain)]
  frame 0
  roots 1
  rootmut 1
    AcquireObjectLoan 1 0 true
    BorrowedCall plain_mutate [(0 1 -1)]
    ReleaseObjectLoan 1
    Return
end
function plain_mutate
  result i64
  params [(class Plain)]
  frame 0
  roots 1
  rootmut 1
    MethodCall plain_write
    Return
end
function plain_read
  result i64
  params [(class Plain)]
  frame 0
  roots 1
  rootmut 0
    MethodCall plain_get
    Return
end
function plain_write
  result i64
  frame 0
  receiver Plain true false
    Constant 41
    ReceiverStore 0
    ReceiverLoad 0
    Return
end
function plain_get
  result i64
  frame 0
  receiver Plain false false
    ReceiverLoad 0
    Return
end
function plain_snapshot
  result i64
  params [(class Plain)]
  frame 16
  slot 8 i64
  object 8 Plain false
    BindObjectParameter 0 8 Plain
    Load 8
    EndObject 8
    Return
end

