layout Child [u8 u64]
layout Holder [u8 u8 u64 u8]
layout Other [u8 u64]
fields Holder [(u8 0 1 false) ((class Child) 1 2 false) (u8 3 1 false)]
storage Child [0 8] [0 8] 16 8 16
storage Holder [{0,8}*4] [0 8 24] 32 8 32
storage Other [0 8] [0 8] 16 8 16
function local_entry
  result u64
  params [(class Holder) (class Child)]
  frame 128
repeat 5
  slot {8,24} u8
  slot {16,24} u64
  slot {24,24} u8
endrepeat
  slot 128 u8
  object 32 Holder false
  object 48 Child false
  object 80 Holder true
  object 96 Child false
  object 128 Holder false
