  receiver Child true false
  slot 8 u8
  slot 16 u64
  slot 24 u8
  slot 32 u8
  slot 40 u64
  slot 56 u64
  slot 64 u8
  object 32 Holder false
  object 64 Child false
    BindObjectParameter 0 32 Holder
    BindParameter 1 40 u64
    BindObjectParameter 2 64 Child
    Load 40 u64
    ReceiverStore 1 u64
    ReturnObject 64
end

