    BindObjectParameter 1 48 Child
    BeginObject 80
    CopyObject 32 80
    AssignObjectField 80 1 48
    Constant 42 u64
    Push
    MethodCall set_word 80 [] 0 1
    Return
end
function set_word
  result u64
  params [u64]
  frame 16
  receiver Child true false
  slot 8 u64
    BindParameter 0 8 u64
    Load 8 u64
    ReceiverStore 1 u64
    ReceiverLoad 1 u64
    Return
end
function copy_child
  result (class Child)
  params [u64]
