    Push
    Constant 255 u8
    MutableSpanStore 56
    EndSpan 56
    Return
end
function sink
  result bool
  params [30]
  frame 64
  span 56
  spanvalues 56 (30)
    BindMutableSpanParameter 0 56
    Constant 1 bool
    EndSpan 56
    Return
end

; CASE: mutable invocation cannot call unparameterized source helper
; RUN: verify
; EXPECT-ERROR: span argument or result element type mismatch
function write_byte
  result bool
  params [30]
  frame 112
  span 56
  spanvalues 56 (30)
  span 112
