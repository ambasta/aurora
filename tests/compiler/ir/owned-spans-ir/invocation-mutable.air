; Metadata kind 30 is the distinct invocation-only mutable byte view.
; Constructed directly: frontend lowering never runs for these cases.

; CASE: invocation mutable parameter checked byte store
; RUN: verify
; EXPECT-OK
; RUN: abi-facts
; ABI: function write_byte write_byte
; CHECK-JSON: functions.write_byte.parameter_bytes 56
; CHECK-JSON: functions.write_byte.parameters [{"offset":0,"bytes":56,"kind":"mutable_span"}]
; CHECK-JSON: functions.write_byte.result {"bytes":8,"kind":"bool"}
; RUN: emit
function write_byte
  result bool
  params [30]
  frame 112
  span 56
  spanvalues 56 (30)
  span 112
  spanvalues 112 (30)
    BindMutableSpanParameter 0 56
    Constant 0 i64
    Push
    Constant 255 u8
    MutableSpanStore 56
    EndSpan 56
    Return
end

; CASE: readonly parameter cannot mint writable authority
; RUN: verify
; EXPECT-ERROR: span parameter bindings must form the entry prefix
function write_byte
  result bool
  params [span]
  frame 112
  span 56
  spanvalues 56 (30)
  span 112
  spanvalues 112 (30)
    BindMutableSpanParameter 0 56
    Constant 0 i64
    Push
    Constant 255 u8
    MutableSpanStore 56
    EndSpan 56
    Return
end

; CASE: mutable bind requires declared parameter
; RUN: verify
; EXPECT-ERROR: span parameter bindings must form the entry prefix
function write_byte
  result bool
  params [30]
  frame 112
  span 56
  spanvalues 56 (30)
  span 112
  spanvalues 112 (30)
    BindMutableSpanParameter 1 56
    Constant 0 i64
    Push
    Constant 255 u8
    MutableSpanStore 56
    EndSpan 56
    Return
end

; CASE: mutable bind rejects spill interior
; RUN: verify
; EXPECT-ERROR: span parameter requires exact typed spill
function write_byte
  result bool
  params [30]
  frame 112
  span 56
  spanvalues 56 (30)
  span 112
  spanvalues 112 (30)
    BindMutableSpanParameter 0 55
    Constant 0 i64
    Push
    Constant 255 u8
    MutableSpanStore 56
    EndSpan 56
    Return
end

; CASE: readonly annotation cannot authorize mutable bind
; RUN: verify
; EXPECT-ERROR: span parameter type mismatch
function write_byte
  result bool
  params [30]
  frame 112
  span 56
  spanvalues 56 (28)
  span 112
  spanvalues 112 (30)
    BindMutableSpanParameter 0 56
    Constant 0 i64
    Push
    Constant 255 u8
    MutableSpanStore 56
    EndSpan 56
    Return
end

; CASE: same mutable invocation parameter cannot bind twice
; RUN: verify
; EXPECT-ERROR: parameter binding outside entry prefix
function write_byte
  result bool
  params [30]
  frame 112
  span 56
  spanvalues 56 (30)
  span 112
  spanvalues 112 (30)
    BindMutableSpanParameter 0 56
    BindMutableSpanParameter 0 112
    Constant 0 i64
    Push
    Constant 255 u8
    MutableSpanStore 56
    EndSpan 56
    Return
end

