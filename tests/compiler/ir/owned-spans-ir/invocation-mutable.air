end

; CASE: mutable invocation cannot carry an object companion
; RUN: verify
; EXPECT-ERROR: span argument or result element type mismatch
layout Plain [i64]
fields Plain [(i64 0 1 false)]
storage Plain [0] [0] 8 8 8
function object_companion
  result bool
  params [30 (class Plain)]
  frame 64
  span 56
  spanvalues 56 (30)
  object 64 Plain false
  slot 64 i64
    BindMutableSpanParameter 0 56
    BindObjectParameter 1 64 Plain
    Constant 1 bool
    EndObject 64
    EndSpan 56
    Return
end

; CASE: scalar store cannot overwrite descriptor interior
; RUN: verify
; EXPECT-ERROR: slot type/layout mismatch
function overwrite_descriptor
  result bool
  params [30]
  frame 64
  span 56
  spanvalues 56 (30)
    BindMutableSpanParameter 0 56
    Constant 255 u8
    Store 16 u8
    Constant 1 bool
    EndSpan 56
    Return
