    BindMutableSpanParameter 0 56
    Call sink
    Constant 0 i64
    Push
    Constant 255 u8
    MutableSpanStore 56
    EndSpan 56
    Return
end
function sink
  result bool
  frame 0
    Constant 1 bool
    Return
end

; CASE: ordinary shared span may accompany an implicit borrowed class root
; RUN: verify
; EXPECT-OK
layout Plain [i64]
fields Plain [(i64 0 1 false)]
storage Plain [0] [0] 8 8 8
function borrowed_leaf
  result bool
  params [(class Plain) span]
  roots 1
  rootmut 0
  frame 64
  span 56
    BindSpanParameter 0 56
    Constant 1 bool
    EndSpan 56
    Return
end

; CASE: mutable invocation may not carry even an unused implicit class root
; RUN: verify
; EXPECT-ERROR: span argument or result element type mismatch
layout Plain [i64]
fields Plain [(i64 0 1 false)]
storage Plain [0] [0] 8 8 8
function borrowed_leaf
  result bool
  params [(class Plain) 30]
  roots 1
  rootmut 0
  frame 64
  span 56
  spanvalues 56 (30)
    BindMutableSpanParameter 0 56
    Constant 1 bool
    EndSpan 56
    Return
end

