; CASE: retained operands: blocks=16
; RUN: metrics
; CHECK-JSON: metrics.snapshots 17
; CHECK-JSON: metrics.peakOperandDepth 64
; CHECK-JSON: metrics.peakRetainedOperandFacts 1024
function resource
  result i64
  frame 0
    Constant 1
repeat 64
    Push
endrepeat
    Label
repeat 15
    Label {1,1}
endrepeat
repeat 64
    Pop
endrepeat
    Return
end

; CASE: retained operands: blocks=64
; BASE: retained operands: blocks=16
; RUN: metrics
; CHECK-JSON: metrics.snapshots 65
; CHECK-JSON: metrics.peakOperandDepth 64
; CHECK-JSON: metrics.peakRetainedOperandFacts 4096
@@ -9 +9 @@
-repeat 15
+repeat 63

