; CASE: real verifier operand cap 0
; RUN: verify
; EXPECT-ERROR: operand retention limit
function resource
  result i64
  frame 0
    Constant 1
repeat 64
    Push
endrepeat
    Label
repeat 4095
    Label {1,1}
endrepeat
repeat 63
    Pop
endrepeat
    Label 4096
    Pop
    Return
end

; CASE: real verifier operand cap 1
; BASE: real verifier operand cap 0
; RUN: metrics
; CHECK: "outcome":"rejected"
; CHECK: operand retention limit
; CHECK-JSON: metrics.snapshots 4097
; CHECK-JSON: metrics.peakOperandDepth 64
; CHECK-JSON: metrics.peakRetainedOperandFacts 262144
; CHECK-JSON: metrics.peakRetainedValueFacts 262144
; CHECK-JSON: metrics.peakRetainedInitializationPayloadBytes 0

; CASE: exact retained state accounting
; RUN: metrics
; CHECK-JSON: metrics.snapshots 65536
; CHECK-JSON: metrics.peakRetainedOperandFacts 0
; CHECK-JSON: metrics.peakRetainedInitializationPayloadBytes 0
function resource
  result i64
  frame 0
    Constant 1
    Label
repeat 65534
    Label {1,1}
endrepeat
    Return
end

; CASE: real verifier state cap 0
; BASE: exact retained state accounting
; RUN: verify
; EXPECT-ERROR: state retention limit
@@ -6 +6 @@
-repeat 65534
+repeat 65535

