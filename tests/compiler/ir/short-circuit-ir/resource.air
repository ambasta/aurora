+repeat 65535

; CASE: straight-line stack is not retained
; RUN: metrics
; CHECK-JSON: metrics.snapshots 1
; CHECK-JSON: metrics.peakOperandDepth 4096
; CHECK-JSON: metrics.peakRetainedOperandFacts 0
function resource
  result i64
  frame 0
    Constant 1
repeat 4096
    Push
endrepeat
repeat 4096
    Pop
endrepeat
    Return
end

; CASE: worklist revisit does not recharge retained operands
; RUN: metrics
; CHECK-JSON: metrics.snapshots 4
; CHECK-JSON: metrics.peakRetainedOperandFacts 192
function resource
  result i64
  frame 16
  slot 8 i64
    Constant 1
repeat 64
    Push
endrepeat
    Constant 1 bool
    BranchFalse 1
    Constant 7
    Store 8
    Jump 2
    Label 1
    Jump 2
    Label 2
repeat 64
    Pop
endrepeat
    Return
end
