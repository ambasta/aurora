; BASE: exact retained state accounting
; RUN: metrics
; CHECK: "outcome":"rejected"
; CHECK: state retention limit
; CHECK-JSON: metrics.snapshots 65536
; CHECK-JSON: metrics.peakOperandDepth 0
; CHECK-JSON: metrics.peakRetainedOperandFacts 0
; CHECK-JSON: metrics.peakRetainedValueFacts 0
; CHECK-JSON: metrics.peakRetainedInitializationPayloadBytes 0
@@ -6 +6 @@
