; CASE: real verifier operand cap 0
; RUN: verify
; EXPECT-ERROR: operand retention limit
function resource
  result i64
  frame 0
    Constant 1
repeat 64
    Push
endrepeat
    Label
repeat 4095
    Label {1,1}
endrepeat
repeat 63
    Pop
endrepeat
    Label 4096
    Pop
    Return
end

