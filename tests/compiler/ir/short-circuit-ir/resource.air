; CASE: retained operands: blocks=16
; RUN: metrics
; CHECK: "snapshots":[[#SNAPSHOTS:]],"peakOperandDepth":[[#DEPTH:]],"peakRetainedOperandFacts":[[#FACTS:]],
; CHECK-RANGE: [[#FACTS-(SNAPSHOTS-1)*DEPTH]] 0..0
function resource
  result i64
  frame 0
    Constant 1
repeat 64
    Push
endrepeat
    Label
repeat 15
    Label {1,1}
endrepeat
repeat 64
    Pop
endrepeat
    Return
end

