; CASE: straight-line stack is not retained
; RUN: metrics
; CHECK-JSON-RANGE: metrics.peakOperandDepth 1..
; CHECK-JSON: metrics.peakRetainedOperandFacts 0
function resource
  result i64
  frame 0
    Constant 1
repeat 4096
    Push
endrepeat
repeat 4096
    Pop
endrepeat
    Return
end

; CASE: worklist revisit does not recharge retained operands
; RUN: metrics
; CHECK: "snapshots":[[#SNAPSHOTS:]],"peakOperandDepth":[[#DEPTH:]],"peakRetainedOperandFacts":[[#FACTS:]],
; CHECK-RANGE: [[#FACTS]] 1..[[#(SNAPSHOTS-1)*DEPTH]]
function resource
  result i64
  frame 16
  slot 8 i64
    Constant 1
repeat 64
    Push
endrepeat
    Constant 1 bool
    BranchFalse 1
    Constant 7
    Store 8
    Jump 2
    Label 1
    Jump 2
    Label 2
repeat 64
    Pop
endrepeat
    Return
end
