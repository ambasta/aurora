; CASE: new object lifetime clears must and may facts
; RUN: emit
layout ByteBox [u8]
function direct
  result i64
  frame 16
  slot 8 u8
  object 8 ByteBox false
    BeginObject 8
    Constant 1 u8
    Store 8 u8
    EndObject 8
    BeginObject 8
    Constant 2 u8
    Store 8 u8
    EndObject 8
    Constant
    Return
end

; CASE: new object lifetime cannot read old initialized leaf
; BASE: new object lifetime clears must and may facts
; RUN: verify
; EXPECT-ERROR: load before initialization
@@ -12,2 +12 @@
-    Constant 2 u8
-    Store 8 u8
+    Load 8 u8

; CASE: initialization-only backedge revisits immutable write
; RUN: verify
; EXPECT-ERROR: write to initialized const object field
layout ByteBox [u8]
function direct
  result i64
  frame 16
  slot 8 u8
  object 8 ByteBox false
    BeginObject 8
    Label 1
    Constant 1 u8
    Store 8 u8
    Constant 1 bool
    BranchFalse 2
    Jump 1
    Label 2
    EndObject 8
    Constant
    Return
end

; CASE: zero scalar domain still needs logical object completion
; RUN: verify
; EXPECT-ERROR: empty object not completely initialized
layout Empty []
function direct
  result (class Empty)
  frame 16
  object 8 Empty false
    BeginObject 8
    Constant 1 bool
    BranchFalse 1
    InitializeEmptyObject 8
    Label 1
    ReturnObject 8
end

