; CASE: new array lifetime cannot read old initialized element
; RUN: verify
; EXPECT-ERROR: load before initialization
function direct
  result i64
  frame 16
  slot 8 u8
  array 8 1
    BeginArray 8
    Constant 1 u8
    Store 8 u8
    EndArray 8
    BeginArray 8
    Load 8 u8
    EndArray 8
    Constant
    Return
end

; CASE: first missing element precedes later inactive object
; RUN: verify
; EXPECT-ERROR: array element not initialized
layout WordBox [i64]
function direct
  result i64
  frame 16
  slot 8 i64
  slot 16 i64
  object 8 WordBox true
  object 16 WordBox true
    BeginObject 16
    Constant
    BoundsGuard 16 2
    EndObject 16
    Return
end

; CASE: inactive missing element reports its lifetime first
