storage Other [{0,8}*3] [{0,8}*3] 24 8 24
storage Record [{0,8}*3] [{0,8}*3] 24 8 24
storage ValuesBox [] [0] 32 8 32
function view
  result (spanof Record)
  frame 64
  receiver ValuesBox false false
  spanfield 0
  span 56
  spanvalues 56 Record
    BorrowOwnedSpan 0 0 56
    ReturnSpan 56
end

