; CASE: typed span borrows a typed owner, narrows a window and copies an element
; RUN: verify
; EXPECT-OK
layout ByteBox []
layout Other [u8 u64 u8]
layout Record [u8 u64 u8]
fields ByteBox [(bytes 0 0 false)]
fields Other [(u8 0 1 false) (u64 1 1 false) (u8 2 1 false)]
fields Record [(u8 0 1 false) (u64 1 1 false) (u8 2 1 false)]
storage ByteBox [] [0] 32 8 32
storage Other [{0,8}*3] [{0,8}*3] 24 8 24
storage Record [{0,8}*3] [{0,8}*3] 24 8 24
function typed_span
  result i64
  params [region]
  frame 240
  slot 160 u8
  slot 168 u64
  slot 176 u8
  slot 184 u8
  slot 192 u64
  slot 200 u8
  slot 216 u8
  slot 224 u64
  slot 232 u8
  object 176 Record false
  object 200 Record false
  object 232 Record true
  span 96
  span 152
  region 8
  bytes 40 true
  values 40 Record
  spanvalues 96 Record
  spanvalues 152 Record
    BindRegionParameter 0 8
    BeginObject 232
    Constant 7 u8
    Store 232 u8
    Constant 42 u64
    Store 224 u64
    Constant 9 u8
    Store 216 u8
    BeginObject 200
    CopyObject 232 200
    EndObject 232
    BeginBytes 40
    Constant 2
    AllocateValues 8 40 200
    EndObject 200
    BorrowOwnedSpan 40 -1 96
    Constant 1
    Push
    Constant 1
    Subspan 96 152
    BeginObject 176
    Constant
    SpanValuesLoad 152 176
    EndObject 176
    SpanLength 96
    EndSpan 152
    EndSpan 96
    EndBytes 40
    Return
end

