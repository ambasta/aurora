; CASE: literal 512-byte Block and 513-leaf 520-byte Report
; RUN: emit
layout Block [u8*512]
layout Report [u64 u8*512]
fields Block [(u8 0 512 true)]
fields Report [(u64 0 1 false) ((class Block) 1 512 false)]
storage Block [{0,1}*512] [0] 512 1 512
storage Report [0 {8,1}*512] [0 8] 520 8 520
function entry
  result i64
  frame 0
    Constant 42
    Return
end

; CASE: closed Status enum plus Block copied Report
; RUN: emit
layout Block [u8*512]
layout Report [(enum Status) u8*512]
fields Block [(u8 0 512 true)]
fields Report [((enum Status) 0 1 false) ((class Block) 1 512 false)]
storage Block [{0,1}*512] [0] 512 1 512
storage Report [0 {8,1}*512] [0 8] 520 8 520
enum Status 2
function entry
  result (class Report)
  params [(class Report)]
  frame 528
repeat 512
  slot {1,1} u8
endrepeat
  slot 520 (enum Status)
  object 520 Report false
    BindObjectParameter 0 520 Report
    ReturnObject 520
end

; CASE: closed Report status slot cannot become u64
; BASE: closed Status enum plus Block copied Report
; RUN: verify
; EXPECT-ERROR: object field slot type/layout mismatch
@@ -15 +15 @@
-  slot 520 (enum Status)
+  slot 520 u64

; CASE: forged canonical offset
; BASE: literal 512-byte Block and 513-leaf 520-byte Report
; RUN: verify
; EXPECT-ERROR: noncanonical class storage metadata
@@ -6 +6 @@
-storage Report [0 {8,1}*512] [0 8] 520 8 520
+storage Report [0 {8,1}*511 518] [0 8] 520 8 520

; CASE: forged canonical extent
; BASE: literal 512-byte Block and 513-leaf 520-byte Report
; RUN: verify
; EXPECT-ERROR: noncanonical class storage metadata
@@ -6 +6 @@
-storage Report [0 {8,1}*512] [0 8] 520 8 520
+storage Report [0 {8,1}*512] [0 8] 519 8 520

; CASE: forged canonical reservation
; BASE: literal 512-byte Block and 513-leaf 520-byte Report
; RUN: verify
; EXPECT-ERROR: noncanonical class storage metadata
@@ -6 +6 @@
