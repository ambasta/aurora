layout Empty []
layout Only []
layout Pair []
layout Parcel [u8 u64 u8]
fields Copy [(u8 0 1 false) (u64 1 1 false)]
fields Empty []
fields Only [(bytes 0 0 false)]
fields Pair [(bytes 0 0 false) (bytes 0 0 false)]
fields Parcel [(u8 0 1 false) (bytes 1 0 false) (u64 1 1 false) (bytes 2 0 false) (u8 2 1 false)]
storage Copy [0 8] [0 8] 16 8 16
storage Empty [] [] 8 8 8
storage Only [] [0] 32 8 32
storage Pair [] [0 32] 64 8 64
storage Parcel [{0,40}*3] [0 8 40 48 80] 88 8 88
function owning_only
  result i64
  params [region (class Only)]
  frame 416
  object 96 Only true
  object 184 Only false
  region 8
  region 416
  bytes 304 true
  bytes 336 true
    BindRegionParameter 0 8
    BindOwnedObjectParameter 1 96 Only
    BeginObject 184
    MoveObject 96 184
    EndObject 96
    BytesLength 184 0
    EndObject 184
    Return
end

