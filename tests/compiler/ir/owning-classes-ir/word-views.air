; CASE: word view exact scalar origin through readonly helper and reborrow
; RUN: verify
; EXPECT-OK
; RUN: emit
; CHECK: __au_runtime_owned_words_borrow_span
layout WordOwner []
fields WordOwner [((26 __au_owned_words) 0 0 false)]
storage WordOwner [] [0] 16 16 16
function words_constructor
  result i64
  params [(26 __au_owned_words)]
  frame 16
  receiver WordOwner true true
  service_resource 16 __au_owned_words true
    BindRetainedResourceParameter 0 16 3
    InitializeBytesField 0 0 16
    Constant
    Return
end
function word_helper
  result u64
  params [(28)]
  frame 64
  slot 64 u64
  span 56
  spanvalues 56 (28)
    BindSpanParameter 0 56
    Constant 0
    SpanWordLoad 56
    Store 64 u64
    EndSpan 56
    Load 64 u64
    Return
end
function words_read
  result u64
  params []
  frame 128
  receiver WordOwner false false
  slot 120 u64
  span 56
  span 112
  spanvalues 56 (28)
  spanvalues 112 (28)
    BorrowWordsSpan 0 0 56
    ReborrowSpan 56 112
    AggregateCall word_helper [0] 0 [112]
    Store 120 u64
    EndSpan 112
    EndSpan 56
    Load 120 u64
    Return
end

