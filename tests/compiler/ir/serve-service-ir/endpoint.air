function region_caller
  result u64
  params [serve region]
  frame 32
  service 16
  region 24
    BindServiceParameter 0 16 Serve
    BindRegionParameter 1 24
    AcquireServiceLoan 1 16 Serve
    ServiceCall region_helper 1 0 [0 0] Serve [] [] 24
    ReleaseServiceLoan 1 Serve
    Return
end
function region_helper
  result u64
  params [serve region]
  frame 32
  service 16
  region 24
    BindServiceParameter 0 16 Serve
    BindRegionParameter 1 24
    Constant 42 u64
    Return
end

