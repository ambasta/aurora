; CASE: block pair region forwarding
; RUN: verify aurora
; RUN: abi-facts aurora
; ABI: function pair_caller pair_caller
; ABI: function pair_helper pair_helper
; CHECK-DAG: "type_name":"builtin::ReadOnlyBlock"
; CHECK-DAG: "type_name":"builtin::ByteRegion"
function pair_caller
  result u64
  params [serve 23 region]
  frame 48
  service 16
  service 32
  region 40
    BindServiceParameter 0 16 Serve
    BindServiceParameter 1 32 7
    BindRegionParameter 2 40
    AcquireServiceLoan 1 16 Serve
    AcquireServiceLoan 2 32 7
    ServiceCall pair_helper 2 0 [0 0 0] 7 [(1 Serve)] [] 40
    ReleaseServiceLoan 2 7
    ReleaseServiceLoan 1 Serve
    Return
end
function pair_helper
  result u64
  params [23 serve region]
  frame 48
  service 16
  service 32
  region 40
    BindServiceParameter 0 16 7
    BindServiceParameter 1 32 Serve
    BindRegionParameter 2 40
    Constant 42 u64
    Return
end

; CASE: block pair rejects missing authenticated region
; BASE: block pair region forwarding
; RUN: verify aurora
; EXPECT-ERROR: region requires exact typed spill
@@ -13 +13 @@
-    ServiceCall pair_helper 2 0 [0 0 0] 7 [(1 Serve)] [] 40
+    ServiceCall pair_helper 2 0 [0 0 0] 7 [(1 Serve)]

; CASE: block pair rejects forged region
; BASE: block pair region forwarding
; RUN: verify aurora
; EXPECT-ERROR: region requires exact typed spill
@@ -13 +13 @@
-    ServiceCall pair_helper 2 0 [0 0 0] 7 [(1 Serve)] [] 40
+    ServiceCall pair_helper 2 0 [0 0 0] 7 [(1 Serve)] [] 32

; CASE: block pair rejects wrong capability loan
; BASE: block pair region forwarding
; RUN: verify aurora
; EXPECT-ERROR: service helper requires an unused loan with exact provenance
@@ -13 +13 @@
-    ServiceCall pair_helper 2 0 [0 0 0] 7 [(1 Serve)] [] 40
+    ServiceCall pair_helper 1 0 [0 0 0] 7 [(2 Serve)] [] 40

