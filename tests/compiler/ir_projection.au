}
auto name_index(builtin::ByteRegion region, i64 mode) -> i64 {
    compiler_projection::Plan plan = compiler_projection::Plan(region);
    builtin::OwnedBytes table = region.try_allocate(637);
    if (!table.ok() || !plan.begin(3, 7, 0, 1)) {
        return 100;
    }
    i64 at = 0;
    while (at < 637) {
        if (!table.set(at, 0u8)) {
            return 100;
        }
        at = at + 1;
    }
    if (!table.set(0, 7u8)) {
