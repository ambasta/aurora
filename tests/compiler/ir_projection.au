            return 100;
        }
        at = at + 1;
    }
    at = 0;
    while (at < 7) {
        if (!plan.request(3, at)) {
            return 100;
        }
        i64 field = 0;
        while (field < 10) {
            i64 value = 0;
            if (field == 0) {
                value = 3;
            }
            if (field == 1) {
                value = at;
            }
            if (field == 3) {
                value = begins[at];
            }
            if (field == 4) {
                value = lengths[at];
            }
            i64 byte = 0;
            while (byte < 8) {
                if (!table.set(8 + at * 80 + field * 8 + byte, u8((u64(value) >> (byte * 8)) & 255u64))) {
                    return 100;
                }
                byte = byte + 1;
            }
            field = field + 1;
        }
        at = at + 1;
    }
    const builtin::span<const u8> input = borrow_bytes(table);
    i64 functions = 0;
    i64 capacity = 1;
    if (mode >= 47) {
        functions = 1;
        capacity = 2;
    }
    if (!plan.finish() || !plan.bind(input) || !plan.seal_domains() || !plan.begin_order(capacity, functions)) {
        return 100;
    }
    const compiler_projection::TextRange carrier = plan.carrier_name(2, 3);
    if (carrier.begin < 0) {
        return 100;
    }
    i64 flags = 1;
    if (mode >= 46) {
        flags = 3;
    }
    const compiler_projection::OrderRow ordered = compiler_projection::OrderRow(-1, 0, 0, carrier.begin, carrier.count,
        flags);
    if (plan.owned(0) || plan.node_count() != 0) {
        return 46;
    }
    if (!plan.put_order(plan.class_begin(), ordered)) {
        return 100;
    }
    if (mode >= 47 && !plan.put_order(plan.lookup_begin(), ordered)) {
        return 100;
    }
    if (mode == 48) {
        if (plan.put_order(plan.lookup_begin() + 1, ordered) || plan.status() != -1) {
            return 47;
        }
        return 0;
    }
    if (mode == 49) {
        if (plan.order_complete(1, 0) || plan.status() != -1) {
            return 48;
        }
        return 0;
    }
    if (!plan.order_complete(1, functions) || !plan.begin_measure()) {
        return 100;
    }
    if (mode == 45) {
        const compiler_projection::TextRange absent = compiler_projection::TextRange(619, 4);
        const compiler_projection::TextRange rejected = plan.text(absent);
        if (rejected.begin >= 0 || plan.status() != -1) {
            return 41;
        }
        return 0;
    }
    const array<i64, 7> sequence = {
        5,
        4,
        2,
        3,
        1,
        0,
        6
    };
    const array<i64, 7> offsets = {
        0,
        1,
        9,
        9,
        14,
        39,
        64
    };
    i64 pass = 0;
    while (pass < 2) {
        at = 0;
        while (at < 7) {
            const i64 id = sequence[at];
            const compiler_projection::TextRange original = plan.identity_name(3, id);
            const compiler_projection::TextRange result = plan.text(original);
