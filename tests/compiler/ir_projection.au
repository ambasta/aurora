        const i64 begin = session.operand_count();
        at = 16;
        while (at < 18) {
            const compiler_lowering::OperandRow reference = compiler_lowering::OperandRow(
                compiler_lowering::OperandRole::OutputRowId, at, 0u64, 0, 0);
            if (session.append_operand(reference) < 0) {
                return -1;
            }
            at = at + 1;
        }
        const compiler_lowering::OperandRow list = compiler_lowering::OperandRow(role, 0, 0u64, begin, 2);
        if (!session.set_operand(root.operand_begin() + slot, list)) {
            return -1;
        }
    }
    if (!session.seal_projection(stamp)) {
        return -1;
    }
    if (mode == 42) {
        return 14;
