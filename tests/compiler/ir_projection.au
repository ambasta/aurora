        while (at < size / 8) {
            i64 value = 0;
            if (at == 0) {
                value = count;
            } else {
                const i64 field =(at - 1) % 10;
                const compiler_projection::Identity identity = plan.identity((at - 1) / 10);
                if (field == 0) {
                    value = identity.domain;
