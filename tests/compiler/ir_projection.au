// These fixtures drive private pending states directly; they do not replace
// graph validation or claim that an empty module passes semantic admission.
auto prepare(compiler_projection::Plan& plan, builtin::span<const u8> table, i64 types) -> bool {
    if (!plan.begin(0, 0, 0, 1) || !plan.finish() || !plan.bind(table) || !plan.seal_domains() || !plan.begin_order(0,
        0) || !plan.order_complete(0, 0) || !plan.begin_measure()) {
        return false;
    }
    if (plan.reserve(1, types) != 0 || !plan.mark_instructions() || !plan.begin_fill() || plan.reserve(1, types) != 0
        || !plan.mark_instructions()) {
        return false;
    }
    return plan.complete_fill();
}
auto record(compiler_resolver::Session& session, compiler_lowering::RecordKind kind) -> i64 {
    const i64 begin = session.operand_count();
    i64 at = 0;
    bool complete = false;
    while (!complete && at < 32) {
        const compiler_projection::GraphShape shape = compiler_projection::graph_shape(kind, at);
        if (shape.mode == 14) {
            complete = true;
        } else {
            if (shape.mode == 0) {
                return -1;
            }
            i64 value = 0;
            if (shape.role == compiler_lowering::OperandRole::SupportedServiceGroups) {
                value = 62;
            }
            const compiler_lowering::OperandRow operand = compiler_lowering::OperandRow(shape.role, value, 0u64, 0, 0);
            if (session.append_operand(operand) < 0) {
                return -1;
            }
            at = at + 1;
        }
    }
    if (!complete) {
        return -1;
    }
    const compiler_lowering::OutputRow row = compiler_lowering::OutputRow(kind,
        compiler_lowering::InstructionForm::Label, begin, at);
    return session.append_output(row);
}
auto seed(compiler_resolver::Session& session, i64 mode, i64 stamp) -> i64 {
    if (!session.reserve_diagnostic_payload() || record(session, compiler_lowering::RecordKind::Configuration) != 1) {
        return -1;
