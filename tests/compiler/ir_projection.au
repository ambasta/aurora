    i64 at = 2;
    while (at < 14) {
        compiler_lowering::RecordKind kind = compiler_lowering::RecordKind::ScalarContract;
        if (at >= 9) {
            kind = compiler_lowering::RecordKind::ServiceContract;
        }
        if (record(session, kind) != at) {
            return -1;
        }
        at = at + 1;
    }
    if (record(session, compiler_lowering::RecordKind::InitialLayoutOrder) != 14 || record(session,
        compiler_lowering::RecordKind::Module) != 15) {
