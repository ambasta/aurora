    const compiler_lowering::OutputRow root = session.view_output(15);
    if (mode >= 33 && mode <= 36) {
        if (record(session, compiler_lowering::RecordKind::UnreadLocal) != 16) {
            return -1;
        }
        if (mode == 35 && record(session, compiler_lowering::RecordKind::UnreadLocal) != 17) {
            return -1;
        }
        const i64 begin = session.operand_count();
        const compiler_lowering::OperandRow reference = compiler_lowering::OperandRow(
            compiler_lowering::OperandRole::OutputRowId, 16, 0u64, 0, 0);
        if (session.append_operand(reference) < 0) {
            return -1;
        }
        i64 count = 1;
        if (mode == 33) {
            count = 2;
            if (session.append_operand(reference) < 0) {
                return -1;
            }
        }
        const compiler_lowering::OperandRow list = compiler_lowering::OperandRow(
            compiler_lowering::OperandRole::LintDiagnostics, 0, 0u64, begin, count);
        if (!session.set_operand(root.operand_begin() + 6, list)) {
            return -1;
        }
        if (mode == 34) {
            const compiler_lowering::OutputRow overlap = compiler_lowering::OutputRow(
                compiler_lowering::RecordKind::UnreadLocal, compiler_lowering::InstructionForm::Label, 3, 1);
            if (!session.set_output(16, overlap)) {
                return -1;
            }
        }
        if (mode == 36) {
            const compiler_lowering::OutputRow child = session.view_output(16);
            const compiler_lowering::OutputRow wrong = compiler_lowering::OutputRow(
                compiler_lowering::RecordKind::DescriptorView, compiler_lowering::InstructionForm::Label,
                child.operand_begin(), child.operand_count());
            if (!session.set_output(16, wrong)) {
                return -1;
            }
        }
    }
    // Empty slices may share the one-past-end boundary without claiming storage.
    if (mode == 37) {
        at = 0;
        while (at < root.operand_count()) {
            const compiler_lowering::OperandRow prior = session.view_operand(root.operand_begin() + at);
            const compiler_lowering::OperandRow empty = compiler_lowering::OperandRow(prior.role(), 0, 0u64,
                session.operand_count(), 0);
            if (!session.set_operand(root.operand_begin() + at, empty)) {
                return -1;
            }
            at = at + 1;
        }
    }
    if (mode == 38 || mode == 39) {
        const i64 begin = session.operand_count();
        const compiler_lowering::OperandRow label = compiler_lowering::OperandRow(
            compiler_lowering::OperandRole::LabelId, 0, 0u64, 0, 0);
        if (session.append_operand(label) < 0) {
            return -1;
        }
        const compiler_lowering::OutputRow row = compiler_lowering::OutputRow(
            compiler_lowering::RecordKind::Instruction, compiler_lowering::InstructionForm::Label, begin, 1);
        const i64 id = session.append_output(row);
        if (id < 0 || (mode == 38 && !session.discard_instruction(id))) {
            return -1;
        }
    }
    if (mode == 40 || mode == 41) {
        compiler_lowering::RecordKind kind = compiler_lowering::RecordKind::Descriptor;
        compiler_lowering::OperandRole role = compiler_lowering::OperandRole::Descriptors;
        i64 slot = 3;
        if (mode == 41) {
            kind = compiler_lowering::RecordKind::EnumCases;
            role = compiler_lowering::OperandRole::Enumerations;
            slot = 5;
