                if (field == 3) {
                    value = size;
                }
            }
            const u64 bits = compiler_projection::word_bits(value);
            i64 byte = 0;
            while (byte < 8) {
                if (!table.set(at * 8 + byte, u8((bits >> (byte * 8)) & 255u64))) {
                    return 100;
                }
                byte = byte + 1;
            }
            at = at + 1;
        }
        const builtin::span<const u8> input = borrow_bytes(table);
        if (!plan.bind(input)) {
            return 100;
