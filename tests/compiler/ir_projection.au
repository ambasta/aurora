    if (mode == 44 && (plan.index_strings() || plan.status() != -1)) {
        return 52;
    }
    if (mode == 46 && (plan.sift_order(0, 0, 0, true) || plan.status() != -1)) {
        return 53;
    }
    if (mode == 47 && (plan.swap_order(0, 0) || plan.status() != -1)) {
        return 54;
    }
    return 0;
}
auto entry(builtin::ByteRegion region, i64 mode, i64 flag) -> i64 {
