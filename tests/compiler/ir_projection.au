            return 100;
        }
        if (pass == 0 && !plan.begin_fill()) {
            return 100;
        }
        pass = pass + 1;
    }
    if (!plan.complete_fill()) {
        return 100;
    }
    if (plan.integer(1, 0, 7) != 123 || plan.integer(13, 0, 0) != 456) {
        return 44;
    }
