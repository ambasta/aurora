    if (retired_name.begin != -1 || retired_order.row != -1) {
        return 51;
    }
    const array<u8, 78> expected = "zalphabetalphaabcdefghijklmnopqrstuvwxBabcdefghijklmnopqrstuvwxA@array:alpha:3";
    at = 0;
    while (at < 78) {
