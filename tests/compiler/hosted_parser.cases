fn
__au_name
x
'x'
'\n'
-1 + ~2 * !false
a || b && c | d ^ e & f == g != h < i <= j > k >= l << m >> n + o - p * q / r % s
(a + b) * (c - d)
(a)
1 + 2
f()
f(1, 2)
name.member
name.at(1)
one::two
a[1]
f(g(1), h(2, 3)) + object.at(index + 1)
Box(42)
move(value)
one :: two(1, other.run()).field[2].at(3)
((a)).field
(a + b)[(i)]
a[one::index(f(1))].method().field
builtin::borrow_bytes(value)
one::array(1)
object.size_of()
ns::size_of(i64)
-object.at(1) + f(2)
f(a[1], b.member)
size_of(i64)
type_id(array<u8,2>)
field_count(Box)
f(size_of(i64))
f("text")
ns::f("", "é😀", "\0\xff")
object.write("\"\\\n")
"left" == "right"
("text")[0]
(x + 1) * 2
-x + ns::value
ns::Mode::ready
ns::make(x, a[2]).field
object.at(index + 1)
f("a\0\xff", a[one::index(f(1))])
{1,2}
{{1,2},{3,4}}
{f(), object.at(2), a[0]}
{Box{.value=1}, ns::Box{}, {}}
{Box{.value=type_id(array<u8,2>)}}
one :: two::Box{.last=3,.first=1,.middle=2}
Box{.value={1,2}[0]}
{1,size_of(i64)}
Box{.first=1,.second=type_id(array<u8,2>)}
f({1,field_count(Box)})
{Box{.value=f(size_of(i64))}}
f<i64>(1)
x<y<z>>(a)
f<a<b<c>>>(0)
ns :: make<Pair<i64, u8>>(1)
{f<i64>(1),2}
Box{.first=f<a<b<c>>>(0),.second={x<y<z>>(a)}}
f({Box<i64>{.value=1},2})
{1,f<a<b<c>>(0)}
f<A<B<C<D<i64>>>>>()
size_of(A<B<C<D<i64>>>>)
A<B<C<D<E<i64>>>>>{}
{}
{1}
{1,2,3}
{{}, {1, {2}}, f(3, {4,5})}
{1,2}[0]
({1,2}).field
{}.size()
ns::Box{}
