@cases program-root
@step program
module templates; auto f()->i64{if(f<T)>(0)){return 1;}return 0;}
module hooks; auto f()->i64 { i64 x = 1+2; const i64 y = 3; x = x+y; x+1; static_assert(true && !false); if(x>0){x=x-1;}else{x=0;} while(x<4){x=x+1;} return x*2; }
module fallback; auto f()->i64 { i64 x=f(1); x=f(2); if(f(1)){return f(2);} while(f(0)){x=f(3);} static_assert(f(1)); return x<y<z>>(a); }

