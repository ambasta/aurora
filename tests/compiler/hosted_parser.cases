# ---- Whole-module lowering diagnostics keep the original failed-session source.
@cases resolve
@step resolve
export module fail;namespace ns {class Hidden{public:i64 value;};export auto expose(Hidden value)->i64{return 0;}}
export module fail;namespace ns {enum class Hidden{one};export auto expose(Hidden value)->i64{return 0;}}
module fail;namespace ns {enum class E{one};}auto answer()->i64{return ns::E::one;}
module fail;class C{public:i64 value;};auto answer()->i64{const C value=C{.value=1};return value.missing;}

