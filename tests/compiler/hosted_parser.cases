# Template-dependent roots in function and class templates, whole and direct.
@case typed-context function
@step program
@step expr at=^1 types=T,U fn
@step expr at=^2 types=T,U fn
export module context; template<Value T,Value U> auto f(T x,U y)->i64 {const Pair<T,U> p=‸Pair<T,U>(x,y); return ‸size_of(T)+type_id(U);}
@case typed-context class-capacity
@step program
@step expr stop=constructor_braces at=^1 types=T caps=N
@step expr at=^2 types=T caps=N
export module context; template<Scalar T,i64 N> class C { array<T,N> data; public: C():‸data{size_of(T)}{} auto f()->i64{return ‸size_of(array<T,N>);} };
@case typed-context class-value
@step program
@step expr stop=close_parenthesis at=^1 types=T
@step expr at=^2 types=T
export module context; template<Value T> class C { i64 value; public: C():value(‸size_of(T)){} auto f()->i64{return ‸field_count(T);} };
@case typed-context statements
@step program
@step expr stop=close_parenthesis at=^1 types=T fn
@step expr at=^2 types=T fn
@step expr stop=close_parenthesis at=^3 types=T fn
@step expr stop=assignment at=^4 types=T fn
@step expr at=^5 types=T fn
@step expr stop=close_parenthesis at=^6 types=T fn
export module context; template<Value T> auto f(T x)->i64 { if(‸type_id(T)){return ‸g<T>(x);} while(‸size_of(T)){‸x=‸g<T>(x);} static_assert(‸size_of(T)>0); return 0;}
@cases typed-context
@step program
export module context; template<Value T> class C { public: auto f()->i64{return g<T>();} };
export module context; template<Value T> class C { public: auto f()->i64{return size_of(Box<i64>);} };
export module context; template<Value T> auto f(T x)->i64{return g<Box<T>>(x);}
export module context; template<Value T> auto f(T x)->i64{return g<T<i64>>(x);}
export module context; template<Value T> auto f(T x)->i64{return size_of(builtin::OwnedValues<T>);}

# ---- Bodies.
@cases body
@step body
{}
{{}}
{i64 x=1;const u8 y=2u8;return x;}
{x=1;obj.field=2;a[0]=3;f();}
{if(true){return 1;}else{while(false){return 2;}}}
{static_assert(1);{return (2);}}
{array<u8,2> bytes={1u8,2u8};return bytes[0];}
{Box<Box<i64>> value=Box<Box<i64>>{};return size_of(Box<Box<i64>>);}
{1;if(true){2;}else{}3;while(false){}4;}
