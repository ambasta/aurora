# Fixed nested_values.py cases; the format is native_runner.Suite.load's.
@case injected self snapshot and substituted class result copies
module app;import std.utility;import std.array;${BOX}auto test()->i64{std::array<u8,3> source=std::array<u8,3>();source.set(2,40u8);Box<std::array<u8,3>> inner=Box<std::array<u8,3>>(source);Box<Box<std::array<u8,3>>> outer=Box<Box<std::array<u8,3>>>(inner);const Box<Box<std::array<u8,3>>> saved=outer.snapshot();Box<std::array<u8,3>> extracted=saved.get();std::array<u8,3> changed=extracted.get();changed.set(2,2u8);const Box<std::array<u8,3>> preserved=saved.item;const std::array<u8,3> bytes=preserved.item;return i64(bytes.at(2))+i64(changed.at(2));}
@case ordinary class private nested specialized field and method result
module app;import std.utility;import std.array;class Holder{std::pair<std::array<u8,3>,u8> value;public:Holder(std::pair<std::array<u8,3>,u8> source):value(source){}auto copy()const->std::pair<std::array<u8,3>,u8>{const std::pair<std::array<u8,3>,u8> result=value;return result;}};auto test()->i64{std::array<u8,3> source=std::array<u8,3>();source.set(2,40u8);std::pair<std::array<u8,3>,u8> pair=std::pair<std::array<u8,3>,u8>(source,2u8);Holder holder=Holder(pair);const std::pair<std::array<u8,3>,u8> result=holder.copy();const std::array<u8,3> bytes=result.first;return i64(bytes.at(2))+i64(result.second);}
@case empty nested descendants survive complete copy and method result
module app;import std.utility;import std.array;class Empty{public:Empty(){}auto answer()const->i64{return 42;}};${BOX}auto test()->i64{Empty empty=Empty();Box<Empty> one=Box<Empty>(empty);Box<Box<Empty>> two=Box<Box<Empty>>(one);const Box<Box<Empty>> saved=two.snapshot();const Box<Empty> inner=saved.get();const Empty copy=inner.get();static_assert(field_count(Box<Box<Empty>>)==1);return copy.answer();}
@case adjacent and spaced closers canonicalize in all type positions
module app;import std.utility;import std.array;auto identity(std::pair< std::pair<i64,u8>,u8 > value)->std::pair<std::pair<i64,u8>,u8>{return value;}auto test()->i64{std::pair<i64,u8> inner=std::pair<i64,u8>(40,2u8);std::pair<std::pair<i64,u8>,u8> value=std::pair<std::pair<i64,u8>,u8>(inner,0u8);const std::pair< std::pair< i64, u8 >, u8 > copied=identity(value);const std::pair<i64,u8> result=copied.first;static_assert(type_id(std::array<u8,03>)==type_id(std::array<u8,3>));static_assert(type_id(std::pair<std::array<u8,03>,u8>)==type_id(std::pair<std::array<u8,3>,u8>));return result.first+i64(result.second);}
# Snapshot side effects are scalar expressions after the named class input.
@case left-to-right constructor snapshot before later array mutation
module app;import std.utility;import std.array;auto test()->i64{std::array<u8,1> source=std::array<u8,1>();source.set(0,20u8);std::pair<std::array<u8,1>,u8> value=std::pair<std::array<u8,1>,u8>(source,source.set(0,22u8));const std::array<u8,1> copy=value.first;return i64(copy.at(0))+i64(value.second);}
@case left-to-right ordinary function snapshot before later mutation
module app;import std.utility;import std.array;class Snapshot{std::pair<std::array<u8,1>,u8> item;u8 count;public:Snapshot(std::pair<std::array<u8,1>,u8> input,u8 n):item(input),count(n){}auto bump()->u8{count=count+2u8;return count;}auto get()const->u8{return count;}};auto consume(Snapshot value,u8 extra)->i64{return i64(value.get())+i64(extra);}auto test()->i64{std::array<u8,1> source=std::array<u8,1>();source.set(0,20u8);std::pair<std::array<u8,1>,u8> value=std::pair<std::array<u8,1>,u8>(source,20u8);Snapshot snapshot=Snapshot(value,20u8);return consume(snapshot,snapshot.bump());}
@case four template ids and exactly four containment levels
module app;${LEAF}${BOX}auto test()->i64{u8 value0=42u8;Box<u8> value1=Box<u8>(value0);Box<Box<u8>> value2=Box<Box<u8>>(value1);Box<Box<Box<u8>>> value3=Box<Box<Box<u8>>>(value2);Box<Box<Box<Box<u8>>>> value4=Box<Box<Box<Box<u8>>>>(value3);const Box<Box<Box<u8>>> copy3=value4.item;const Box<Box<u8>> copy2=copy3.item;const Box<u8> copy1=copy2.item;const u8 copy0=copy1.item;return i64(copy0);}
@case four template ids plus named class exceeds containment depth
@error depth
@error four
@error 4
module app;${LEAF}${BOX}auto test()->i64{Leaf value0=Leaf(42u8);Box<Leaf> value1=Box<Leaf>(value0);Box<Box<Leaf>> value2=Box<Box<Leaf>>(value1);Box<Box<Box<Leaf>>> value3=Box<Box<Box<Leaf>>>(value2);Box<Box<Box<Box<Leaf>>>> value4=Box<Box<Box<Box<Leaf>>>>(value3);return 42;}
@case nested class method parameters make independent snapshots
module app;import std.utility;import std.array;class Receiver{public:Receiver(){}auto consume(std::pair<std::array<u8,3>,u8> value)const->i64{const std::array<u8,3> bytes=value.first;return i64(bytes.at(2))+i64(value.second);}};auto test()->i64{std::array<u8,3> bytes=std::array<u8,3>();bytes.set(2,40u8);std::pair<std::array<u8,3>,u8> source=std::pair<std::array<u8,3>,u8>(bytes,2u8);Receiver receiver=Receiver();return receiver.consume(source);}
@case nested type expressions do not change ordinary comparison parsing
module app;import std.utility;import std.array;auto test()->i64{std::pair<i64,u8> inner=std::pair<i64,u8>(40,2u8);std::pair<std::pair<i64,u8>,u8> value=std::pair<std::pair<i64,u8>,u8>(inner,0u8);const std::pair<i64,u8> copy=value.first;if(copy.first>=40){if(copy.first>39){if(copy.first<41){if(copy.first<=40){return 42;}}}}return 0;}
