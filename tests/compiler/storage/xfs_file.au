// Test driver for fs.xfs_file: one record per case, observed one u64 slot at a time.
// operation 0: plan_xfs_v5_512_file_sector; slots 0..9 report, 10 repeat/copy check
// operation 1: read_xfs_v5_512_file_sector; slot 0 status, 1..64 sector words, 65 check
// operation 2: fabricated XfsFileReport with the selected status, plus layout facts
// operation 3: fabricated XfsFileSector with the selected kind
// operation 4: entry 0 of the real root directory, then that file's first sector
module xfs_file_driver;
import std.binary;
import std.binary_buffer;
import storage.sector;
import storage.block_io;
import storage.sector_window;
import fs.xfs_root;
import fs.xfs_file;

auto io_status(storage::SectorIoStatus value) -> u64 {
    if (value == storage::SectorIoStatus::success) { return 0u64; }
    if (value == storage::SectorIoStatus::out_of_range) { return 1u64; }
    if (value == storage::SectorIoStatus::read_only) { return 2u64; }
    if (value == storage::SectorIoStatus::invalid_source) { return 3u64; }
    return 999u64;
}

// Bytes 8*word..8*word+7 of a copied sector; a failed byte read yields 2^64-1.
auto sector_word(storage::Sector512 sector, i64 word) -> u64 {
    u64 value = 0u64;
    i64 index = 7;
    while (index >= 0) {
        const std::ByteReadResult byte = sector.read_byte(word * 8 + index);
        if (byte.status() != std::ByteReadStatus::success) { return 18446744073709551615u64; }
        value = (value << 8) | byte.value_or(0u64);
        index = index - 1;
    }
    return value;
}

auto file_status(fs::XfsFileStatus value) -> u64 {
    if (value == fs::XfsFileStatus::ready) { return 0u64; }
    if (value == fs::XfsFileStatus::end) { return 1u64; }
    if (value == fs::XfsFileStatus::invalid_index) { return 2u64; }
    if (value == fs::XfsFileStatus::geometry_rejected) { return 3u64; }
    if (value == fs::XfsFileStatus::source_too_small) { return 4u64; }
    if (value == fs::XfsFileStatus::unsupported_profile) { return 5u64; }
    if (value == fs::XfsFileStatus::invalid_inode) { return 6u64; }
    if (value == fs::XfsFileStatus::invalid_extent) { return 7u64; }
    return 999u64;
}

auto file_issue(fs::XfsFileIssue value) -> u64 {
    if (value == fs::XfsFileIssue::none) { return 0u64; }
    if (value == fs::XfsFileIssue::geometry) { return 1u64; }
    if (value == fs::XfsFileIssue::capacity) { return 2u64; }
    if (value == fs::XfsFileIssue::inode_size) { return 3u64; }
    if (value == fs::XfsFileIssue::inode_address) { return 4u64; }
    if (value == fs::XfsFileIssue::inode_length) { return 5u64; }
    if (value == fs::XfsFileIssue::magic) { return 6u64; }
    if (value == fs::XfsFileIssue::version) { return 7u64; }
    if (value == fs::XfsFileIssue::checksum) { return 8u64; }
    if (value == fs::XfsFileIssue::identity) { return 9u64; }
    if (value == fs::XfsFileIssue::flags) { return 10u64; }
    if (value == fs::XfsFileIssue::core) { return 11u64; }
    if (value == fs::XfsFileIssue::extent_count) { return 12u64; }
    if (value == fs::XfsFileIssue::file_size) { return 13u64; }
    if (value == fs::XfsFileIssue::file_type) { return 14u64; }
    if (value == fs::XfsFileIssue::file_format) { return 15u64; }
    if (value == fs::XfsFileIssue::attribute_fork) { return 16u64; }
    if (value == fs::XfsFileIssue::extent_hints) { return 17u64; }
    if (value == fs::XfsFileIssue::file_offset) { return 18u64; }
    if (value == fs::XfsFileIssue::block_count) { return 19u64; }
    if (value == fs::XfsFileIssue::trailing_allocation) { return 20u64; }
    if (value == fs::XfsFileIssue::extent_address) { return 21u64; }
    if (value == fs::XfsFileIssue::sector_index) { return 22u64; }
    return 999u64;
}

auto sector_kind(fs::XfsFileSectorKind value) -> u64 {
    if (value == fs::XfsFileSectorKind::none) { return 0u64; }
    if (value == fs::XfsFileSectorKind::written) { return 1u64; }
    if (value == fs::XfsFileSectorKind::hole) { return 2u64; }
    if (value == fs::XfsFileSectorKind::unwritten) { return 3u64; }
    return 999u64;
}

auto selected_status(i64 code) -> fs::XfsFileStatus {
    if (code == 0) { return fs::XfsFileStatus::ready; }
    if (code == 1) { return fs::XfsFileStatus::end; }
    if (code == 2) { return fs::XfsFileStatus::invalid_index; }
    if (code == 3) { return fs::XfsFileStatus::geometry_rejected; }
    if (code == 4) { return fs::XfsFileStatus::source_too_small; }
    if (code == 5) { return fs::XfsFileStatus::unsupported_profile; }
    if (code == 6) { return fs::XfsFileStatus::invalid_inode; }
    return fs::XfsFileStatus::invalid_extent;
}

auto selected_kind(i64 code) -> fs::XfsFileSectorKind {
    if (code == 0) { return fs::XfsFileSectorKind::none; }
    if (code == 1) { return fs::XfsFileSectorKind::written; }
    if (code == 2) { return fs::XfsFileSectorKind::hole; }
    return fs::XfsFileSectorKind::unwritten;
}

// Slots 0..1 status/issue, 2..6 facts, 7..9 sector coordinate.
auto plan_slot(fs::XfsFileReport report, i64 slot) -> u64 {
    const fs::XfsFileFacts facts = report.facts();
    const fs::XfsFileSector coordinate = report.sector();
    if (slot == 0) { return file_status(report.status()); }
    if (slot == 1) { return file_issue(report.issue()); }
    if (slot == 2) { return facts.inode_number(); }
    if (slot == 3) { return facts.inode_lba(); }
    if (slot == 4) { return facts.size_bytes(); }
    if (slot == 5) { return facts.extent_count(); }
    if (slot == 6) { return facts.allocated_blocks(); }
    if (slot == 7) { return sector_kind(coordinate.kind()); }
    if (slot == 8) { return coordinate.source_lba(); }
    return coordinate.valid_bytes();
}

auto read_slot(storage::SectorReadResult read, i64 slot) -> u64 {
    if (slot == 0) { return io_status(read.status()); }
    return sector_word(read.sector_or_zero(), slot - 1);
}

class FileInput {
    builtin::array<u8, 512> sb0;
    builtin::array<u8, 512> sb1;
    builtin::array<u8, 512> inode0;
    builtin::array<u8, 512> inode1;
    builtin::array<u8, 512> root0;
    builtin::array<u8, 512> window0;
    builtin::array<u8, 512> window1;
    builtin::array<u8, 512> window2;
    builtin::array<u8, 512> window3;
    builtin::array<u8, 512> window4;
    builtin::array<u8, 512> window5;
    builtin::array<u8, 512> window6;
    builtin::array<u8, 512> window7;
    i64 sb_length;
    i64 inode_length;
    i64 window_offset;
    i64 window_length;
    u64 capacity;
    u64 number;
    i64 index;
    u64 base;
    i64 operation;
    i64 selector;
public:
    FileInput() : sb0{}, sb1{}, inode0{}, inode1{}, root0{}, window0{}, window1{}, window2{}, window3{}, window4{},
        window5{}, window6{}, window7{}, sb_length(0), inode_length(0), window_offset(0), window_length(0),
        capacity(0u64), number(0u64), index(0), base(0u64), operation(0), selector(0) {
    }

    auto sb_at(i64 offset) const -> u8 {
        if (offset < 512) { return sb0[offset]; }
        return sb1[offset - 512];
    }

    auto inode_at(i64 offset) const -> u8 {
        if (offset < 512) { return inode0[offset]; }
        return inode1[offset - 512];
    }

    auto window_at(i64 offset) const -> u8 {
        if (offset < 512) { return window0[offset]; }
        if (offset < 1024) { return window1[offset - 512]; }
        if (offset < 1536) { return window2[offset - 1024]; }
        if (offset < 2048) { return window3[offset - 1536]; }
        if (offset < 2560) { return window4[offset - 2048]; }
        if (offset < 3072) { return window5[offset - 2560]; }
        if (offset < 3584) { return window6[offset - 3072]; }
        return window7[offset - 3584];
    }

    auto plan_file(builtin::span<const u8> sb, builtin::span<const u8> inode) const -> fs::XfsFileReport {
        const storage::SectorGeometry source = storage::SectorGeometry(capacity, false);
        const fs::XfsFileRequest request = fs::XfsFileRequest(number, index);
        const fs::XfsFileReport report = fs::plan_xfs_v5_512_file_sector(source, sb, inode, request);
        return report;
    }

    // The copied result outlives the local window array that backed its view.
