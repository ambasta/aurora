    }

    auto entry(i64 slot) const -> u64 {
        if (operation == 0) { return buffer_ops(slot); }
        if (operation == 1) { return sector_ops(slot); }
        if (operation == 2) {
            const storage::SectorReadResult report = window_read();
            if (slot == 0) { return io_status(report.status()); }
            return sector_word(report.sector_or_zero(), slot - 1);
        }
        if (operation == 3) { return codec(slot); }
        return scenario(slot);
    }
