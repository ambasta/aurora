        };
        i64 at = 0;
        while (at < 4096) {
            bytes[at] = data_at(at);
            at = at + 1;
        }
        if (constant == 1) {
            const builtin::array<u8, 4096> frozen = bytes;
            const builtin::span<const u8> owner = borrow_bytes(frozen);
            const builtin::span<const u8> whole = owner.subspan(0, length2);
            const storage::SectorReadResult result = storage::read_sector_window(whole.subspan(offset, length), base,
                requested);
            return result;
        }
        const builtin::span<const u8> owner = borrow_bytes(bytes);
        const builtin::span<const u8> whole = owner.subspan(0, length2);
        const storage::SectorReadResult result = storage::read_sector_window(whole.subspan(offset, length), base,
            requested);
        return result;
    }

    // Slots: encode status, encoded bytes (little-endian packed), same-order decode,
    // opposite-order decode, then the decode of the independent bytes in data[0..width).
    auto codec(i64 slot) const -> u64 {
        if (width == 2) {
            std::Bytes2 input = std::Bytes2();
            input.set(0, data_at(0));
            input.set(1, data_at(1));
            if (big_endian == 0) {
                const std::Encode16Result report = std::encode_le16(value);
                const std::Bytes2 bytes = report.bytes_or_zero();
                if (slot == 0) { return codec_status(report.status()); }
                if (slot == 1) { return bytes2_word(bytes); }
                if (slot == 2) { return std::decode_le16(bytes); }
                if (slot == 3) { return std::decode_be16(bytes); }
                return std::decode_le16(input);
            }
            const std::Encode16Result report = std::encode_be16(value);
            const std::Bytes2 bytes = report.bytes_or_zero();
            if (slot == 0) { return codec_status(report.status()); }
            if (slot == 1) { return bytes2_word(bytes); }
            if (slot == 2) { return std::decode_be16(bytes); }
            if (slot == 3) { return std::decode_le16(bytes); }
            return std::decode_be16(input);
        }
        if (width == 4) {
            std::Bytes4 input = std::Bytes4();
            i64 at = 0;
            while (at < 4) {
                input.set(at, data_at(at));
                at = at + 1;
            }
            if (big_endian == 0) {
                const std::Encode32Result report = std::encode_le32(value);
                const std::Bytes4 bytes = report.bytes_or_zero();
                if (slot == 0) { return codec_status(report.status()); }
                if (slot == 1) { return bytes4_word(bytes); }
                if (slot == 2) { return std::decode_le32(bytes); }
                if (slot == 3) { return std::decode_be32(bytes); }
                return std::decode_le32(input);
            }
            const std::Encode32Result report = std::encode_be32(value);
            const std::Bytes4 bytes = report.bytes_or_zero();
            if (slot == 0) { return codec_status(report.status()); }
            if (slot == 1) { return bytes4_word(bytes); }
            if (slot == 2) { return std::decode_be32(bytes); }
            if (slot == 3) { return std::decode_le32(bytes); }
            return std::decode_be32(input);
        }
        std::Bytes8 input = std::Bytes8();
        i64 at = 0;
        while (at < 8) {
            input.set(at, data_at(at));
            at = at + 1;
        }
        if (big_endian == 0) {
            const std::Bytes8 bytes = std::encode_le64(value);
            if (slot == 0) { return 0u64; }
            if (slot == 1) { return bytes8_word(bytes); }
            if (slot == 2) { return std::decode_le64(bytes); }
            if (slot == 3) { return std::decode_be64(bytes); }
            return std::decode_le64(input);
        }
        const std::Bytes8 bytes = std::encode_be64(value);
        if (slot == 0) { return 0u64; }
        if (slot == 1) { return bytes8_word(bytes); }
        if (slot == 2) { return std::decode_be64(bytes); }
        if (slot == 3) { return std::decode_le64(bytes); }
        return std::decode_be64(input);
    }

    // A BinaryBuffer64 encoding at `offset` read back through std.binary.
    auto buffer_interop() const -> u64 {
        const i64 at = op_offset(0);
        const bool big = op_byte(0, 2) == 1u8;
        if (written_status(width, big, at, op_u64(0, 16), op_byte(0, 4)) != std::ByteWriteStatus::success) {
            return 1u64;
        }
        const std::BinaryBuffer64 buffer = written_buffer(width, big, at, op_u64(0, 16), op_byte(0, 4));
        builtin::array<u8, 8> wire = {0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8};
        i64 index = 0;
        while (index < width) {
            wire[index] = buffer.at(at + index);
            index = index + 1;
        }
        const builtin::span<const u8> all = borrow_bytes(wire);
        const builtin::span<const u8> view = all.subspan(0, width);
        const std::ByteReadResult read = read_wire(view, width, big_endian);
        if (read.status() != std::ByteReadStatus::success) { return 2u64; }
        return read.value_or(0u64);
    }

    // An encoded 64-byte record written into the seeded sector at `offset`, then
    // decoded from copied wire bytes; slot 1.. are the 64 sector words.
    auto sector_codec(i64 slot) const -> u64 {
        storage::Sector512 sector = seeded_sector();
        const bool big = op_byte(0, 2) == 1u8;
        if (written_status(width, big, op_offset(0), op_u64(0, 16), op_byte(0, 4)) != std::ByteWriteStatus::success) {
            return 1u64;
        }
        std::BinaryBuffer64 writer = written_buffer(width, big, op_offset(0), op_u64(0, 16), op_byte(0, 4));
        const std::BinaryBuffer64 block = writer;
        if (sector.write_record(offset, block) != std::ByteWriteStatus::success) { return 2u64; }
        writer.write_u8(63, 0u8);
        if (slot > 0) { return sector_word(sector, slot - 1); }
        const storage::RecordReadResult report = sector.read_record(offset);
        if (report.status() != std::ByteReadStatus::success) { return 3u64; }
        const std::BinaryBuffer64 snapshot = report.record_or_zero();
        const std::BinaryBuffer64 returned = snapshot;
        builtin::array<u8, 8> wire = {0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8};
        i64 index = 0;
        while (index < width) {
            wire[index] = returned.at(64 - width + index);
            index = index + 1;
        }
        const builtin::span<const u8> all = borrow_bytes(wire);
        const builtin::span<const u8> view = all.subspan(0, width);
        const std::ByteReadResult read = read_wire(view, width, big_endian);
        if (read.status() != std::ByteReadStatus::success) { return 4u64; }
        return read.value_or(0u64);
    }

    // Each scenario returns 42 (or its observed value) after checking its copies.
    auto scenario(i64 slot) const -> u64 {
        if (selector == 0) { return layout_slot(slot); }
        if (selector == 1) { return wrapper_last(offset); }
        if (selector == 2) {
            const Small small = Small{.first = 200u8, .second = 255u8};
            const Empty empty = Empty();
            const Nested original = Nested(1u8, small, empty, 42u64);
            const Nested copy = identity_nested(original);
            Small projected = copy.small;
            projected.second = 0u8;
            const Small preserved = original.small;
            if (preserved.second != 255u8) { return 0u64; }
            return copy.last;
        }
        if (selector == 3) {
            std::BinaryBuffer64 original = std::BinaryBuffer64();
            original.write_be16(62, 4660u64);
            std::BinaryBuffer64 copy = identity_buffer(original);
            original.write_u8(62, 255u8);
            copy.write_u8(63, 0u8);
            if (original.at(63) != 52u8 || copy.at(62) != 18u8) { return 0u64; }
            return 42u64;
        }
        if (selector == 4) { return buffer_interop(); }
        if (selector == 5) {
            const std::ByteReadResult byte = std::ByteReadResult(std::ByteReadStatus::out_of_range, 255u64);
            if (byte.status() != std::ByteReadStatus::out_of_range || byte.value_or(0u64) != 0u64) { return 0u64; }
            return byte.value_or(18446744073709551615u64);
        }
        if (selector == 6) {
            std::BinaryBuffer64 buffer = seeded_buffer();
            buffer.write_u8(63, 255u8);
            const std::ByteReadResult report = buffer.read_u8(63);
            const std::ByteReadResult copied = identity_read(report);
            buffer.write_u8(63, 0u8);
            if (report.value_or(0u64) != 255u64 || copied.value_or(0u64) != 255u64) { return 0u64; }
            if (buffer.at(63) != 0u8) { return 1u64; }
            return 42u64;
        }
        if (selector == 7) {
            std::BinaryBuffer64 buffer = seeded_buffer();
            std::BinaryBuffer64 copied = identity_buffer(buffer);
            std::BinaryBuffer64 changed = copied;
            buffer.write_u8(0, 0u8);
            copied.write_u8(63, 0u8);
            changed.write_u8(31, 255u8);
            i64 index = 0;
            while (index < 64) {
                u8 original = data_at(index);
                if (buffer.at(index) != original && index != 0) { return 1u64; }
                if (copied.at(index) != original && index != 63) { return 2u64; }
                if (changed.at(index) != original && index != 31) { return 3u64; }
                index = index + 1;
            }
            if (buffer.at(0) != 0u8 || copied.at(63) != 0u8 || changed.at(31) != 255u8) { return 4u64; }
            return 42u64;
        }
        if (selector == 8) {
            std::BinaryBuffer64 buffer = std::BinaryBuffer64();
            buffer.write_be16(0, 4660u64);
            buffer.write_le64(56, 9223372036854775850u64);
            std::BinaryBuffer64 copied = buffer;
            const builtin::array<u8, 2> header = {copied.at(0), copied.at(1)};
            const builtin::array<u8, 8> trailer = {copied.at(56), copied.at(57), copied.at(58), copied.at(59),
                copied.at(60), copied.at(61), copied.at(62), copied.at(63)};
            buffer.write_u8(0, 0u8);
            copied.write_u8(63, 0u8);
            const std::ByteReadResult first = std::read_be16(borrow_bytes(header), 0);
            const std::ByteReadResult last = std::read_le64(borrow_bytes(trailer), 0);
            if (first.value_or(0u64) != 4660u64 || last.value_or(0u64) != 9223372036854775850u64) { return 0u64; }
            if (buffer.at(0) != 0u8 || buffer.at(1) != 52u8 || copied.at(0) != 18u8 || copied.at(63) != 0u8) {
                return 1u64;
            }
            return 42u64;
        }
        if (selector == 9) {
            // Whole-sector argument and return copies stay independent of later writes.
            storage::Sector512 sector = seeded_sector();
            storage::Sector512 copy = changed_copy(sector);
            sector.write_byte(0, 0u8);
            const storage::Sector512 snapshot = copy;
            copy.write_byte(256, 0u8);
            i64 index = 0;
            while (index < 512) {
                const u8 original = data_at(index);
                const std::ByteReadResult kept = snapshot.read_byte(index);
                const std::ByteReadResult current = sector.read_byte(index);
                u64 want = u64(original);
                if (index == 511) { want = 255u64; }
                if (kept.value_or(999u64) != want) { return 1u64; }
                want = u64(original);
                if (index == 0) { want = 0u64; }
                if (current.value_or(999u64) != want) { return 2u64; }
                index = index + 1;
            }
            return 42u64;
        }
        if (selector == 10) {
            storage::Sector512 sector = seeded_sector();
            const std::ByteReadResult saved = sector.read_byte(511);
            sector.write_byte(511, 0u8);
            return saved.value_or(0u64);
        }
        if (selector == 11) {
            // A copied record report and its extracted record survive sector mutation.
            storage::Sector512 sector = seeded_sector();
            const storage::RecordReadResult report = sector.read_record(offset);
            const storage::RecordReadResult saved = identity_record(report);
            if (saved.status() != std::ByteReadStatus::success) { return 0u64; }
            const std::BinaryBuffer64 zero = std::BinaryBuffer64();
            sector.write_record(offset, zero);
            std::BinaryBuffer64 changed = saved.record_or_zero();
            changed.write_u8(0, 0u8);
            changed.write_u8(63, 0u8);
            const std::BinaryBuffer64 snapshot = saved.record_or_zero();
            i64 index = 0;
            while (index < 512) {
                const std::ByteReadResult byte = sector.read_byte(index);
                u64 want = u64(data_at(index));
                if (index >= offset && index < offset + 64) {
