            storage::Sector512 sector = seeded_sector();
            std::BinaryBuffer64 input = pattern(0);
            if (sector.write_record(448, input) != std::ByteWriteStatus::success) { return 0u64; }
            input.write_u8(0, 0u8);
            input.write_u8(63, 0u8);
            i64 index = 0;
            while (index < 512) {
                const std::ByteReadResult byte = sector.read_byte(index);
                u64 want = u64(data_at(index));
                if (index >= 448) { want = u64(data_at(512 + index - 448)); }
                if (byte.value_or(999u64) != want) { return 1u64; }
