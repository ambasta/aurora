// Test driver for std.bytes, std.binary_buffer, storage.sector and storage.sector_window.
// operation 0: operation list on a BinaryBuffer64 seeded from data[0..64)
// operation 1: operation list on a Sector512 seeded from data[0..512)
// operation 2: read_sector_window over data[offset, offset + length) of a length2-byte owner
// operation 3: std.bytes encode/decode of value (width 2, 4 or 8 bytes)
// operation 4: fixed scenario `selector`; slot 0 is its result
// Operation lists hold 24-byte entries in ops0/ops1: kind, width, big-endian flag, pattern
// index, u8 value, then the i64 offset and u64 value little-endian at bytes 8 and 16.
// Each entry yields its status words and, when dump is set, the complete object bytes.
module byte_storage_driver;
import std.array;
import std.binary;
import std.binary_buffer;
import std.bytes;
import storage.sector;
import storage.block_io;
import storage.sector_window;

auto io_status(storage::SectorIoStatus value) -> u64 {
    if (value == storage::SectorIoStatus::success) { return 0u64; }
    if (value == storage::SectorIoStatus::out_of_range) { return 1u64; }
    if (value == storage::SectorIoStatus::read_only) { return 2u64; }
    if (value == storage::SectorIoStatus::invalid_source) { return 3u64; }
    return 999u64;
}

auto read_status(std::ByteReadStatus value) -> u64 {
    if (value == std::ByteReadStatus::success) { return 0u64; }
    if (value == std::ByteReadStatus::out_of_range) { return 1u64; }
    return 999u64;
}

auto write_status(std::ByteWriteStatus value) -> u64 {
    if (value == std::ByteWriteStatus::success) { return 0u64; }
    if (value == std::ByteWriteStatus::out_of_range) { return 1u64; }
    if (value == std::ByteWriteStatus::value_out_of_range) { return 2u64; }
    return 999u64;
}

// Bytes 8*word..8*word+7 of a copied sector; a failed byte read yields 2^64-1.
auto sector_word(storage::Sector512 sector, i64 word) -> u64 {
    u64 value = 0u64;
    i64 index = 7;
    while (index >= 0) {
        const std::ByteReadResult byte = sector.read_byte(word * 8 + index);
        if (byte.status() != std::ByteReadStatus::success) { return 18446744073709551615u64; }
        value = (value << 8) | byte.value_or(0u64);
        index = index - 1;
    }
    return value;
}

auto codec_status(std::ByteCodecStatus value) -> u64 {
    if (value == std::ByteCodecStatus::success) { return 0u64; }
    if (value == std::ByteCodecStatus::out_of_range) { return 1u64; }
    return 999u64;
}

auto buffer_word(std::BinaryBuffer64 buffer, i64 word) -> u64 {
    u64 value = 0u64;
    i64 index = 7;
    while (index >= 0) {
        value = (value << 8) | u64(buffer.at(word * 8 + index));
        index = index - 1;
    }
    return value;
}

auto bytes2_word(std::Bytes2 bytes) -> u64 {
    return u64(bytes.at(0)) | (u64(bytes.at(1)) << 8);
}

auto bytes4_word(std::Bytes4 bytes) -> u64 {
    return u64(bytes.at(0)) | (u64(bytes.at(1)) << 8) | (u64(bytes.at(2)) << 16) | (u64(bytes.at(3)) << 24);
}

auto bytes8_word(std::Bytes8 bytes) -> u64 {
    u64 value = 0u64;
    i64 index = 7;
    while (index >= 0) {
        value = (value << 8) | u64(bytes.at(index));
        index = index - 1;
    }
    return value;
}

class Empty {
public:
    Empty() {
    }
};

class Small {
public:
    u8 first;
    u8 second;
};

class Mixed {
public:
    u8 first;
    u64 wide;
    bool flag;
    u8 last;
};

class Nested {
public:
    u8 first;
    Small small;
    Empty empty;
    u64 last;
    Nested(u8 f, Small s, Empty e, u64 l) : first(f), small(s), empty(e), last(l) {
    }
};

auto identity_nested(Nested value) -> Nested {
    return value;
}

auto identity_buffer(std::BinaryBuffer64 buffer) -> std::BinaryBuffer64 {
    return buffer;
}

auto identity_read(std::ByteReadResult report) -> std::ByteReadResult {
    return report;
}

auto identity_record(storage::RecordReadResult report) -> storage::RecordReadResult {
    return report;
}

auto identity_sector(storage::Sector512 sector) -> storage::Sector512 {
    return sector;
}

auto identity_window(storage::SectorReadResult report) -> storage::SectorReadResult {
    return report;
}

auto identity_bytes2(std::Bytes2 value) -> std::Bytes2 {
    return value;
}

auto identity_bytes8(std::Bytes8 value) -> std::Bytes8 {
    return value;
}

auto changed_copy(storage::Sector512 input) -> storage::Sector512 {
    storage::Sector512 result = input;
    result.write_byte(511, 255u8);
    return result;
}

// Fixed layout and representation facts, one per slot.
auto layout_slot(i64 slot) -> u64 {
    static_assert(size_of(builtin::array<u8, 1>) == 1);
    static_assert(size_of(builtin::array<u8, 3>) == 3);
    static_assert(size_of(builtin::array<u8, 4>) == 4);
    static_assert(size_of(builtin::array<u8, 7>) == 7);
    static_assert(size_of(builtin::array<u8, 8>) == 8);
    static_assert(size_of(builtin::array<u8, 9>) == 9);
    static_assert(size_of(builtin::array<u8, 64>) == 64);
    static_assert(size_of(std::array<u8, 1>) == 1);
    static_assert(size_of(std::array<u8, 3>) == 3);
    static_assert(size_of(std::array<u8, 4>) == 4);
    static_assert(size_of(std::array<u8, 7>) == 7);
    static_assert(size_of(std::array<u8, 8>) == 8);
    static_assert(size_of(std::array<u8, 9>) == 9);
    static_assert(size_of(std::array<u8, 64>) == 64);
    static_assert(size_of(std::Bytes2) == 2);
    static_assert(size_of(std::Bytes4) == 4);
    static_assert(size_of(std::Bytes8) == 8);
    static_assert(size_of(std::Encode16Result) == 16);
    static_assert(size_of(std::Encode32Result) == 16);
    static_assert(field_count(std::Bytes2) == 0);
    static_assert(field_count(std::Bytes4) == 0);
    static_assert(field_count(std::Bytes8) == 0);
    static_assert(size_of(Small) == 2);
    static_assert(size_of(Mixed) == 32);
    static_assert(size_of(Nested) == 16);
    static_assert(size_of(Empty) == 8);
    if (slot == 0) { return u64(reflect_size(type_id(std::array<u8, 1>))); }
    if (slot == 1) { return u64(reflect_size(type_id(std::array<u8, 3>))); }
    if (slot == 2) { return u64(reflect_size(type_id(std::array<u8, 4>))); }
    if (slot == 3) { return u64(reflect_size(type_id(std::array<u8, 7>))); }
    if (slot == 4) { return u64(reflect_size(type_id(std::array<u8, 8>))); }
    if (slot == 5) { return u64(reflect_size(type_id(std::array<u8, 9>))); }
    if (slot == 6) { return u64(reflect_size(type_id(std::array<u8, 64>))); }
    if (slot == 7) { return u64(reflect_size(type_id(std::Bytes2))); }
    if (slot == 8) { return u64(reflect_size(type_id(std::Bytes4))); }
    if (slot == 9) { return u64(reflect_size(type_id(std::Bytes8))); }
    if (slot == 10) { return u64(size_of(std::BinaryBuffer64)); }
    if (slot == 11) { return u64(size_of(storage::Sector512)); }
    if (slot == 12) { return u64(size_of(storage::RecordReadResult)); }
    if (slot == 13) { return u64(size_of(storage::SectorReadResult)); }
    const std::BinaryBuffer64 buffer = std::BinaryBuffer64();
    if (slot == 14) { return u64(buffer.size()); }
    const storage::Sector512 sector = storage::Sector512();
    return u64(sector.size());
}

// std::array copies at capacity N keep their final element independent.
auto wrapper_last(i64 capacity) -> u64 {
    if (capacity == 1) {
        std::array<u8, 1> bytes = std::array<u8, 1>();
        bytes.set(0, 255u8);
        const std::array<u8, 1> copy = bytes;
        bytes.set(0, 0u8);
        return u64(copy.at(0));
    }
    if (capacity == 3) {
        std::array<u8, 3> bytes = std::array<u8, 3>();
        bytes.set(2, 255u8);
        const std::array<u8, 3> copy = bytes;
        bytes.set(2, 0u8);
        return u64(copy.at(2));
    }
    if (capacity == 4) {
        std::array<u8, 4> bytes = std::array<u8, 4>();
        bytes.set(3, 255u8);
        const std::array<u8, 4> copy = bytes;
        bytes.set(3, 0u8);
        return u64(copy.at(3));
    }
    if (capacity == 7) {
        std::array<u8, 7> bytes = std::array<u8, 7>();
        bytes.set(6, 255u8);
        const std::array<u8, 7> copy = bytes;
        bytes.set(6, 0u8);
        return u64(copy.at(6));
    }
    if (capacity == 8) {
        std::array<u8, 8> bytes = std::array<u8, 8>();
        bytes.set(7, 255u8);
        const std::array<u8, 8> copy = bytes;
        bytes.set(7, 0u8);
        return u64(copy.at(7));
    }
    if (capacity == 9) {
        std::array<u8, 9> bytes = std::array<u8, 9>();
        bytes.set(8, 255u8);
        const std::array<u8, 9> copy = bytes;
        bytes.set(8, 0u8);
        return u64(copy.at(8));
    }
    std::array<u8, 64> bytes = std::array<u8, 64>();
    bytes.set(63, 255u8);
    const std::array<u8, 64> copy = bytes;
    bytes.set(63, 0u8);
    return u64(copy.at(63));
}

// A fresh buffer after one write of `bytes` width; the status helper repeats it.
auto written_buffer(i64 bytes, bool big, i64 at, u64 number, u8 byte) -> std::BinaryBuffer64 {
    std::BinaryBuffer64 buffer = std::BinaryBuffer64();
    if (bytes == 1) { buffer.write_u8(at, byte); }
    if (bytes == 2 && !big) { buffer.write_le16(at, number); }
    if (bytes == 2 && big) { buffer.write_be16(at, number); }
    if (bytes == 4 && !big) { buffer.write_le32(at, number); }
    if (bytes == 4 && big) { buffer.write_be32(at, number); }
    if (bytes == 8 && !big) { buffer.write_le64(at, number); }
    if (bytes == 8 && big) { buffer.write_be64(at, number); }
    return buffer;
}

auto written_status(i64 bytes, bool big, i64 at, u64 number, u8 byte) -> std::ByteWriteStatus {
    std::BinaryBuffer64 buffer = std::BinaryBuffer64();
    if (bytes == 1) { return buffer.write_u8(at, byte); }
    if (bytes == 2 && !big) { return buffer.write_le16(at, number); }
    if (bytes == 2) { return buffer.write_be16(at, number); }
    if (bytes == 4 && !big) { return buffer.write_le32(at, number); }
    if (bytes == 4) { return buffer.write_be32(at, number); }
    if (!big) { return buffer.write_le64(at, number); }
    return buffer.write_be64(at, number);
}

auto read_wire(builtin::span<const u8> view, i64 width, i64 big_endian) -> std::ByteReadResult {
    if (width == 2 && big_endian == 0) { return std::read_le16(view, 0); }
    if (width == 2) { return std::read_be16(view, 0); }
    if (width == 4 && big_endian == 0) { return std::read_le32(view, 0); }
    if (width == 4) { return std::read_be32(view, 0); }
    if (big_endian == 0) { return std::read_le64(view, 0); }
    return std::read_be64(view, 0);
}

class ByteInput {
    builtin::array<u8, 512> data0;
    builtin::array<u8, 512> data1;
    builtin::array<u8, 512> data2;
    builtin::array<u8, 512> data3;
    builtin::array<u8, 512> data4;
    builtin::array<u8, 512> data5;
    builtin::array<u8, 512> data6;
    builtin::array<u8, 512> data7;
    builtin::array<u8, 512> ops0;
    builtin::array<u8, 512> ops1;
    i64 operation;
    i64 selector;
    i64 op_count;
    i64 seeded;
    i64 dump;
    i64 width;
    i64 big_endian;
    i64 offset;
    i64 length;
    i64 length2;
    i64 constant;
    u64 value;
    u64 base;
    i64 requested;
public:
    ByteInput() : data0{}, data1{}, data2{}, data3{}, data4{}, data5{}, data6{}, data7{}, ops0{}, ops1{},
        operation(0), selector(0), op_count(0), seeded(0), dump(0), width(0), big_endian(0), offset(0), length(0),
        length2(0), constant(0), value(0u64), base(0u64), requested(0) {
    }

    auto data_at(i64 index) const -> u8 {
        if (index < 512) { return data0[index]; }
        if (index < 1024) { return data1[index - 512]; }
        if (index < 1536) { return data2[index - 1024]; }
        if (index < 2048) { return data3[index - 1536]; }
        if (index < 2560) { return data4[index - 2048]; }
        if (index < 3072) { return data5[index - 2560]; }
        if (index < 3584) { return data6[index - 3072]; }
        return data7[index - 3584];
    }

    auto op_byte(i64 entry, i64 field) const -> u8 {
        const i64 index = entry * 24 + field;
        if (index < 512) { return ops0[index]; }
        return ops1[index - 512];
    }

    auto op_u64(i64 entry, i64 field) const -> u64 {
        u64 result = 0u64;
        i64 index = 7;
        while (index >= 0) {
            result = (result << 8) | u64(op_byte(entry, field + index));
            index = index - 1;
        }
        return result;
    }

    // Two's complement without a checked conversion of values above 2^63-1.
    auto op_offset(i64 entry) const -> i64 {
        const u64 raw = op_u64(entry, 8);
        if (raw < 9223372036854775808u64) { return i64(raw); }
        return 0 - i64(18446744073709551615u64 - raw) - 1;
    }

    // Pattern k is the 64-byte record at data[512 + 64k).
    auto pattern(i64 index) const -> std::BinaryBuffer64 {
        std::BinaryBuffer64 record = std::BinaryBuffer64();
        i64 at = 0;
        while (at < 64) {
            record.write_u8(at, data_at(512 + index * 64 + at));
            at = at + 1;
        }
        return record;
    }

    auto seeded_buffer() const -> std::BinaryBuffer64 {
        std::BinaryBuffer64 buffer = std::BinaryBuffer64();
        if (seeded == 1) {
            i64 at = 0;
            while (at < 64) {
                buffer.write_u8(at, data_at(at));
                at = at + 1;
            }
        }
        return buffer;
    }

    auto seeded_sector() const -> storage::Sector512 {
        storage::Sector512 sector = storage::Sector512();
        if (seeded == 1) {
            i64 at = 0;
            while (at < 512) {
                sector.write_byte(at, data_at(at));
                at = at + 1;
            }
        }
        return sector;
    }

    // Kinds 1 write, 2 read_u8, 3 at(): 1, 3 and 1 words; dumps add 8 words.
    auto buffer_ops(i64 slot) const -> u64 {
        std::BinaryBuffer64 buffer = seeded_buffer();
        i64 produced = 0;
        i64 entry = 0;
        while (entry < op_count) {
            const u8 kind = op_byte(entry, 0);
            const i64 at = op_offset(entry);
            if (kind == 1u8) {
                const i64 bytes = i64(op_byte(entry, 1));
                const bool big = op_byte(entry, 2) == 1u8;
                const u64 number = op_u64(entry, 16);
                std::ByteWriteStatus status = std::ByteWriteStatus::success;
                if (bytes == 1) { status = buffer.write_u8(at, op_byte(entry, 4)); }
                if (bytes == 2 && !big) { status = buffer.write_le16(at, number); }
                if (bytes == 2 && big) { status = buffer.write_be16(at, number); }
                if (bytes == 4 && !big) { status = buffer.write_le32(at, number); }
                if (bytes == 4 && big) { status = buffer.write_be32(at, number); }
                if (bytes == 8 && !big) { status = buffer.write_le64(at, number); }
                if (bytes == 8 && big) { status = buffer.write_be64(at, number); }
                if (slot == produced) { return write_status(status); }
                produced = produced + 1;
            }
            if (kind == 2u8) {
                const std::ByteReadResult read = buffer.read_u8(at);
                if (slot == produced) { return read_status(read.status()); }
                if (slot == produced + 1) { return read.value_or(42u64); }
                if (slot == produced + 2) { return read.value_or(18446744073709551615u64); }
                produced = produced + 3;
            }
            if (kind == 3u8) {
                const std::BinaryBuffer64 frozen = buffer;
                const u8 byte = frozen.at(at);
                if (slot == produced) { return u64(byte); }
                produced = produced + 1;
            }
            if (dump == 1 || entry == op_count - 1) {
                if (slot < produced + 8) { return buffer_word(buffer, slot - produced); }
                produced = produced + 8;
            }
            entry = entry + 1;
        }
        if (op_count == 0 && slot < 8) { return buffer_word(buffer, slot); }
        return 999u64;
    }

    // Kinds 4 write_byte, 5 read_byte, 6 write_record, 7 read_record: 1, 3, 1 and 9 words;
    // dumps add 64 words.
    auto sector_ops(i64 slot) const -> u64 {
        storage::Sector512 sector = seeded_sector();
        i64 produced = 0;
        i64 entry = 0;
        while (entry < op_count) {
            const u8 kind = op_byte(entry, 0);
            const i64 at = op_offset(entry);
            if (kind == 4u8) {
                const u64 status = write_status(sector.write_byte(at, op_byte(entry, 4)));
                if (slot == produced) { return status; }
                produced = produced + 1;
            }
            if (kind == 5u8) {
                const std::ByteReadResult read = sector.read_byte(at);
                if (slot == produced) { return read_status(read.status()); }
                if (slot == produced + 1) { return read.value_or(42u64); }
                if (slot == produced + 2) { return read.value_or(18446744073709551615u64); }
                produced = produced + 3;
            }
            if (kind == 6u8) {
                const u64 status = write_status(sector.write_record(at, pattern(i64(op_byte(entry, 3)))));
                if (slot == produced) { return status; }
                produced = produced + 1;
            }
            if (kind == 7u8) {
                const storage::RecordReadResult read = sector.read_record(at);
                if (slot == produced) { return read_status(read.status()); }
                if (slot < produced + 9) { return buffer_word(read.record_or_zero(), slot - produced - 1); }
                produced = produced + 9;
            }
            if (dump == 1 || entry == op_count - 1) {
                if (slot < produced + 64) { return sector_word(sector, slot - produced); }
                produced = produced + 64;
            }
            entry = entry + 1;
        }
        if (op_count == 0 && slot < 64) { return sector_word(sector, slot); }
        return 999u64;
    }

    auto window_read() const -> storage::SectorReadResult {
        builtin::array<u8, 4096> bytes = {
            0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
            0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
            0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
            0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
            0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
            0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
            0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
            0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
            0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
            0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
            0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
            0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
            0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
            0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
            0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
            0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
            0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
            0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
