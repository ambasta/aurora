    // The last slot (10 lookup, 11 entry) is 1 when a repeated call agrees with a copy.
    auto entry(i64 slot) const -> u64 {
        if (operation == 2 || operation == 3) { return fabricated(slot); }
        if (operation == 0 || operation == 4) {
            const fs::XfsRootReport report = lookup_report();
            if (slot < 10) { return lookup_slot(report, slot); }
            const fs::XfsRootReport copy = report;
            const fs::XfsRootReport again = lookup_report();
            i64 check = 0;
            while (check < 10) {
                if (lookup_slot(copy, check) != lookup_slot(again, check)) { return 900u64 + u64(check); }
                check = check + 1;
            }
            return 1u64;
        }
        const fs::XfsRootEntryReport report = entry_report();
        if (slot < 11) { return entry_slot(report, slot); }
        const fs::XfsRootEntryReport copy = report;
        const fs::XfsRootEntryReport again = entry_report();
        i64 check = 0;
        while (check < 11) {
            if (entry_slot(copy, check) != entry_slot(again, check)) { return 900u64 + u64(check); }
            check = check + 1;
        }
        return 1u64;
    }
