// Test driver for fs.xfs_root: one record per case, observed one u64 slot at a time.
// operation 0: lookup_xfs_v5_512_root(superblock, inode, query)
// operation 1: entry_at_xfs_v5_512_root(superblock, inode, index)
// operation 2: fabricated XfsRootReport with the selected status
// operation 3: fabricated XfsRootEntryReport with the selected status
// operations 4/5: parameterized directory lookup/index with expected inode/parent
module xfs_root_driver;
import fs.xfs_root;

auto lookup_status(fs::XfsRootStatus value) -> u64 {
    if (value == fs::XfsRootStatus::found) { return 0u64; }
    if (value == fs::XfsRootStatus::not_found) { return 1u64; }
    if (value == fs::XfsRootStatus::geometry_rejected) { return 2u64; }
    if (value == fs::XfsRootStatus::unsupported_profile) { return 3u64; }
    if (value == fs::XfsRootStatus::invalid_query) { return 4u64; }
    if (value == fs::XfsRootStatus::invalid_inode) { return 5u64; }
    if (value == fs::XfsRootStatus::invalid_directory) { return 6u64; }
    return 999u64;
}

auto entry_status(fs::XfsRootEntryStatus value) -> u64 {
    if (value == fs::XfsRootEntryStatus::found) { return 0u64; }
    if (value == fs::XfsRootEntryStatus::end) { return 1u64; }
    if (value == fs::XfsRootEntryStatus::invalid_index) { return 2u64; }
    if (value == fs::XfsRootEntryStatus::geometry_rejected) { return 3u64; }
    if (value == fs::XfsRootEntryStatus::unsupported_profile) { return 4u64; }
    if (value == fs::XfsRootEntryStatus::invalid_inode) { return 5u64; }
    if (value == fs::XfsRootEntryStatus::invalid_directory) { return 6u64; }
    return 999u64;
}

auto issue_code(fs::XfsRootIssue value) -> u64 {
    if (value == fs::XfsRootIssue::none) { return 0u64; }
    if (value == fs::XfsRootIssue::geometry) { return 1u64; }
    if (value == fs::XfsRootIssue::inode_size) { return 2u64; }
    if (value == fs::XfsRootIssue::directory_block) { return 3u64; }
    if (value == fs::XfsRootIssue::root_address) { return 4u64; }
    if (value == fs::XfsRootIssue::inode_length) { return 5u64; }
    if (value == fs::XfsRootIssue::query_name) { return 6u64; }
    if (value == fs::XfsRootIssue::magic) { return 7u64; }
    if (value == fs::XfsRootIssue::version) { return 8u64; }
    if (value == fs::XfsRootIssue::checksum) { return 9u64; }
    if (value == fs::XfsRootIssue::identity) { return 10u64; }
    if (value == fs::XfsRootIssue::flags2) { return 11u64; }
    if (value == fs::XfsRootIssue::core) { return 12u64; }
    if (value == fs::XfsRootIssue::payload_size) { return 13u64; }
    if (value == fs::XfsRootIssue::inode_width) { return 14u64; }
    if (value == fs::XfsRootIssue::entry_count) { return 15u64; }
    if (value == fs::XfsRootIssue::parent) { return 16u64; }
    if (value == fs::XfsRootIssue::entry_bounds) { return 17u64; }
    if (value == fs::XfsRootIssue::entry_name) { return 18u64; }
    if (value == fs::XfsRootIssue::file_type) { return 19u64; }
    if (value == fs::XfsRootIssue::entry_inode) { return 20u64; }
    if (value == fs::XfsRootIssue::saved_offset) { return 21u64; }
    if (value == fs::XfsRootIssue::duplicate_name) { return 22u64; }
    if (value == fs::XfsRootIssue::trailing_bytes) { return 23u64; }
    if (value == fs::XfsRootIssue::block_footprint) { return 24u64; }
    if (value == fs::XfsRootIssue::entry_index) { return 25u64; }
    return 999u64;
}

auto selected_lookup_status(i64 code) -> fs::XfsRootStatus {
    if (code == 0) { return fs::XfsRootStatus::found; }
    if (code == 1) { return fs::XfsRootStatus::not_found; }
    if (code == 2) { return fs::XfsRootStatus::geometry_rejected; }
    if (code == 3) { return fs::XfsRootStatus::unsupported_profile; }
    if (code == 4) { return fs::XfsRootStatus::invalid_query; }
    if (code == 5) { return fs::XfsRootStatus::invalid_inode; }
    return fs::XfsRootStatus::invalid_directory;
}

auto selected_entry_status(i64 code) -> fs::XfsRootEntryStatus {
    if (code == 0) { return fs::XfsRootEntryStatus::found; }
    if (code == 1) { return fs::XfsRootEntryStatus::end; }
    if (code == 2) { return fs::XfsRootEntryStatus::invalid_index; }
    if (code == 3) { return fs::XfsRootEntryStatus::geometry_rejected; }
    if (code == 4) { return fs::XfsRootEntryStatus::unsupported_profile; }
    if (code == 5) { return fs::XfsRootEntryStatus::invalid_inode; }
    return fs::XfsRootEntryStatus::invalid_directory;
}

// Slots 0..1 status/issue, 2 found, 3..7 facts, 8..9 match.
auto lookup_slot(fs::XfsRootReport report, i64 slot) -> u64 {
    const fs::XfsRootFacts facts = report.facts();
    const fs::XfsRootMatch match = report.match();
    if (slot == 0) { return lookup_status(report.status()); }
    if (slot == 1) { return issue_code(report.issue()); }
    if (slot == 2) {
        if (report.found()) { return 1u64; }
        return 0u64;
    }
    if (slot == 3) { return facts.root_inode(); }
    if (slot == 4) { return facts.inode_offset_bytes(); }
    if (slot == 5) { return facts.parent_inode(); }
    if (slot == 6) { return facts.entry_count(); }
    if (slot == 7) { return facts.payload_bytes(); }
    if (slot == 8) { return match.inode_number(); }
    return match.file_type();
}

// Slots 0..1 status/issue, 2..6 facts, 7..10 entry.
auto entry_slot(fs::XfsRootEntryReport report, i64 slot) -> u64 {
    const fs::XfsRootFacts facts = report.facts();
    const fs::XfsRootEntry entry = report.entry();
    if (slot == 0) { return entry_status(report.status()); }
    if (slot == 1) { return issue_code(report.issue()); }
    if (slot == 2) { return facts.root_inode(); }
    if (slot == 3) { return facts.inode_offset_bytes(); }
    if (slot == 4) { return facts.parent_inode(); }
    if (slot == 5) { return facts.entry_count(); }
    if (slot == 6) { return facts.payload_bytes(); }
    if (slot == 7) { return entry.inode_number(); }
    if (slot == 8) { return entry.file_type(); }
    if (slot == 9) { return entry.name_offset_bytes(); }
    return entry.name_length_bytes();
}

class RootInput {
    builtin::array<u8, 512> sb0;
    builtin::array<u8, 512> sb1;
    builtin::array<u8, 512> inode0;
    builtin::array<u8, 512> inode1;
    builtin::array<u8, 512> query0;
    i64 sb_length;
    i64 inode_length;
    i64 query_length;
    i64 operation;
    i64 index;
    i64 status;
    u64 expected_inode;
    u64 expected_parent;
public:
    RootInput() : sb0{}, sb1{}, inode0{}, inode1{}, query0{}, sb_length(0), inode_length(0), query_length(0),
        operation(0), index(0), status(0), expected_inode(0u64), expected_parent(0u64) {
    }

    auto sb_at(i64 offset) const -> u8 {
        if (offset < 512) { return sb0[offset]; }
        return sb1[offset - 512];
    }

    auto inode_at(i64 offset) const -> u8 {
        if (offset < 512) { return inode0[offset]; }
        return inode1[offset - 512];
    }

    auto fabricated(i64 slot) const -> u64 {
        if (operation == 2) {
            const fs::XfsRootFacts facts = fs::XfsRootFacts(9223372036854775808u64, 18446744073709551615u64, 3u64,
                4u64, 5u64);
            const fs::XfsRootMatch match = fs::XfsRootMatch(6u64, 7u64);
            const fs::XfsRootReport report = fs::XfsRootReport(selected_lookup_status(status), fs::XfsRootIssue::none,
                facts, match);
            const fs::XfsRootReport copy = report;
            if (slot == 10) { return u64(size_of(fs::XfsRootFacts)); }
            if (slot == 11) { return u64(size_of(fs::XfsRootMatch)); }
            if (slot == 12) { return u64(size_of(fs::XfsRootReport)); }
            if (slot == 13) { return u64(field_count(fs::XfsRootReport)); }
            return lookup_slot(copy, slot);
        }
        const fs::XfsRootFacts facts = fs::XfsRootFacts(1u64, 2u64, 3u64, 4u64, 5u64);
        const fs::XfsRootEntry entry = fs::XfsRootEntry(6u64, 7u64, 8u64, 9u64);
        const fs::XfsRootEntryReport report = fs::XfsRootEntryReport(selected_entry_status(status),
            fs::XfsRootIssue::none, facts, entry);
        const fs::XfsRootEntryReport copy = report;
        if (slot == 11) { return u64(size_of(fs::XfsRootEntry)); }
        if (slot == 12) { return u64(size_of(fs::XfsRootEntryReport)); }
        if (slot == 13) { return u64(field_count(fs::XfsRootEntryReport)); }
        return entry_slot(copy, slot);
    }

    // The copied report outlives the local owner arrays that backed its views.
