// Test driver for std.binary readers and std.checksum CRC32C over owned byte views.
// operation 0: read_{le,be}{16,32,64}(bytes, offset); status, value_or(0), value_or(max)
// operation 1: crc32c(bytes, offset, count) or crc32c_extend(previous, ...); same three slots
// operation 2: crc32c(bytes, 0, offset) continued by crc32c_extend over the rest; four slots
// operation 3: fabricated ByteReadResult or ChecksumResult with the selected status
module storage_binary_driver;
import std.binary;
import std.checksum;

auto read_status(std::ByteReadStatus value) -> u64 {
    if (value == std::ByteReadStatus::success) { return 0u64; }
    if (value == std::ByteReadStatus::out_of_range) { return 1u64; }
    return 999u64;
}

auto checksum_status(std::ChecksumStatus value) -> u64 {
    if (value == std::ChecksumStatus::success) { return 0u64; }
    if (value == std::ChecksumStatus::out_of_range) { return 1u64; }
    if (value == std::ChecksumStatus::invalid_previous) { return 2u64; }
    return 999u64;
}

auto read_slot(std::ByteReadResult result, i64 slot) -> u64 {
    if (slot == 0) { return read_status(result.status()); }
    if (slot == 1) { return result.value_or(0u64); }
    return result.value_or(18446744073709551615u64);
}

auto checksum_slot(std::ChecksumResult result, i64 slot) -> u64 {
    if (slot == 0) { return checksum_status(result.status()); }
    if (slot == 1) { return result.value_or(0u64); }
    return result.value_or(18446744073709551615u64);
}

class BinaryInput {
    builtin::array<u8, 512> data0;
    builtin::array<u8, 512> data1;
    builtin::array<u8, 512> data2;
    builtin::array<u8, 512> data3;
    builtin::array<u8, 512> data4;
    builtin::array<u8, 512> data5;
    builtin::array<u8, 512> data6;
    builtin::array<u8, 512> data7;
    i64 length;
    i64 operation;
    i64 width;
    i64 big_endian;
    i64 offset;
    i64 count;
    u64 previous;
    i64 extend;
    i64 selector;
public:
    BinaryInput() : data0{}, data1{}, data2{}, data3{}, data4{}, data5{}, data6{}, data7{}, length(0), operation(0),
        width(0), big_endian(0), offset(0), count(0), previous(0u64), extend(0), selector(0) {
    }

    auto data_at(i64 index) const -> u8 {
        if (index < 512) { return data0[index]; }
        if (index < 1024) { return data1[index - 512]; }
        if (index < 1536) { return data2[index - 1024]; }
        if (index < 2048) { return data3[index - 1536]; }
        if (index < 2560) { return data4[index - 2048]; }
        if (index < 3072) { return data5[index - 2560]; }
        if (index < 3584) { return data6[index - 3072]; }
        return data7[index - 3584];
    }

    auto read_value(builtin::span<const u8> view) const -> std::ByteReadResult {
        if (width == 2 && big_endian == 0) { return std::read_le16(view, offset); }
        if (width == 2) { return std::read_be16(view, offset); }
        if (width == 4 && big_endian == 0) { return std::read_le32(view, offset); }
        if (width == 4) { return std::read_be32(view, offset); }
        if (big_endian == 0) { return std::read_le64(view, offset); }
        return std::read_be64(view, offset);
    }

    auto observe_view(builtin::span<const u8> view, i64 slot) const -> u64 {
        if (operation == 0) { return read_slot(read_value(view), slot); }
        if (operation == 1) {
            if (extend == 1) { return checksum_slot(std::crc32c_extend(previous, view, offset, count), slot); }
            return checksum_slot(std::crc32c(view, offset, count), slot);
        }
        const std::ChecksumResult first = std::crc32c(view, 0, offset);
        if (slot < 2) { return checksum_slot(first, slot); }
        const std::ChecksumResult next = std::crc32c_extend(first.value_or(18446744073709551615u64), view, offset,
            view.size() - offset);
        return checksum_slot(next, slot - 2);
    }

    auto entry(i64 slot) const -> u64 {
        if (operation == 3) {
            if (selector == 0) {
                const std::ByteReadResult read = std::ByteReadResult(std::ByteReadStatus::out_of_range,
                    18446744073709551615u64);
                const std::ByteReadResult copy = read;
                return read_slot(copy, slot);
            }
            std::ChecksumStatus status = std::ChecksumStatus::out_of_range;
            if (selector == 2) { status = std::ChecksumStatus::invalid_previous; }
            const std::ChecksumResult result = std::ChecksumResult(status, 18446744073709551615u64);
            const std::ChecksumResult copy = result;
            return checksum_slot(copy, slot);
        }
