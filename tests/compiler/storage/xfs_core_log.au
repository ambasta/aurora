auto status(fs::XfsCoreLogStatus value) -> u64 {
    if (value == fs::XfsCoreLogStatus::ready) { return 0u64; }
    if (value == fs::XfsCoreLogStatus::invalid_record) { return 1u64; }
    if (value == fs::XfsCoreLogStatus::unsupported_transaction) { return 2u64; }
    if (value == fs::XfsCoreLogStatus::invalid_index) { return 3u64; }
    return 999u64;
}
