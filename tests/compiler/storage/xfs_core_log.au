        const builtin::span<const u8> body = borrow_bytes(payload);
        const fs::XfsCoreLogResult result = fs::decode_xfs_core_log(head.subspan(0, header_length), body.subspan(0, payload_length), index);
        if (slot == 0) { return status(result.status()); }
        if (slot == 1) { return result.item_count(); }
        if (slot == 2) { return result.transaction_id(); }
        if (slot == 3) { return result.inode_number(); }
        if (slot == 4) { return result.buffer_lba(); }
        if (slot == 5) { return result.buffer_sectors(); }
        if (slot == 6) { return result.inode_offset(); }
        const storage::Sector512 core = result.core_or_zero();
        u64 word = 0u64;
        i64 at = 7;
        while (at >= 0) {
            const std::ByteReadResult byte = core.read_byte((slot - 7) * 8 + at);
            word = (word << 8) | byte.value_or(0u64);
            at = at - 1;
        }
        return word;
    }
