// Test driver for fs.xfs_probe, fs.xfs_geometry and fs.xfs_sector.
// operation 0: inspect_xfs_v5_512_geometry(header); slots 0..41 report, 42 repeat/probe check
// operation 1: fabricated XfsGeometryReport with the selected status; slots 0..41
// operation 2: size, reflected size and field counts of the ten report types; 40 slots
// operation 3: report detached from its owner by a function return; slots 0..41, 42..43 AG facts
// operation 4: probe_xfs_v5_512(header); status and four masks
// operation 5: inspect_xfs_v5_512_sector over a copied 512-byte read result; 68 slots
// operation 6: fabricated XfsSectorHeaderReport around the inspected header; 71 slots
module xfs_geometry_driver;
import std.binary;
import std.binary_buffer;
import storage.sector;
import storage.block_io;
import fs.xfs_probe;
import fs.xfs_geometry;
import fs.xfs_sector;

auto io_status(storage::SectorIoStatus value) -> u64 {
    if (value == storage::SectorIoStatus::success) { return 0u64; }
    if (value == storage::SectorIoStatus::out_of_range) { return 1u64; }
    if (value == storage::SectorIoStatus::read_only) { return 2u64; }
    if (value == storage::SectorIoStatus::invalid_source) { return 3u64; }
    return 999u64;
}

auto selected_io_status(i64 code) -> storage::SectorIoStatus {
    if (code == 0) { return storage::SectorIoStatus::success; }
    if (code == 1) { return storage::SectorIoStatus::out_of_range; }
    if (code == 2) { return storage::SectorIoStatus::read_only; }
    return storage::SectorIoStatus::invalid_source;
}

auto geometry_status(fs::XfsGeometryStatus value) -> u64 {
    if (value == fs::XfsGeometryStatus::probe_rejected) { return 0u64; }
    if (value == fs::XfsGeometryStatus::unsupported_feature_profile) { return 1u64; }
    if (value == fs::XfsGeometryStatus::unsupported_layout) { return 2u64; }
    if (value == fs::XfsGeometryStatus::offline_state_indicated) { return 3u64; }
    if (value == fs::XfsGeometryStatus::inconsistent_header) { return 4u64; }
    if (value == fs::XfsGeometryStatus::size_unrepresentable) { return 5u64; }
    if (value == fs::XfsGeometryStatus::header_geometry_consistent) { return 6u64; }
    return 999u64;
}

auto geometry_issue(fs::XfsGeometryIssue value) -> u64 {
    if (value == fs::XfsGeometryIssue::none) { return 0u64; }
    if (value == fs::XfsGeometryIssue::legacy_required_bits) { return 1u64; }
    if (value == fs::XfsGeometryIssue::legacy_excluded_bits) { return 2u64; }
    if (value == fs::XfsGeometryIssue::features2_required_bits) { return 3u64; }
    if (value == fs::XfsGeometryIssue::features2_excluded_bits) { return 4u64; }
    if (value == fs::XfsGeometryIssue::extended_feature_masks) { return 5u64; }
    if (value == fs::XfsGeometryIssue::features2_mirror) { return 6u64; }
    if (value == fs::XfsGeometryIssue::needs_repair) { return 7u64; }
    if (value == fs::XfsGeometryIssue::offline_operation) { return 8u64; }
    if (value == fs::XfsGeometryIssue::realtime) { return 9u64; }
    if (value == fs::XfsGeometryIssue::external_log) { return 10u64; }
    if (value == fs::XfsGeometryIssue::striping) { return 11u64; }
    if (value == fs::XfsGeometryIssue::quota_or_misc_flags) { return 12u64; }
    if (value == fs::XfsGeometryIssue::block_geometry) { return 13u64; }
    if (value == fs::XfsGeometryIssue::inode_geometry) { return 14u64; }
    if (value == fs::XfsGeometryIssue::directory_geometry) { return 15u64; }
    if (value == fs::XfsGeometryIssue::ag_geometry) { return 16u64; }
    if (value == fs::XfsGeometryIssue::data_byte_size) { return 17u64; }
    if (value == fs::XfsGeometryIssue::realtime_zero_geometry) { return 18u64; }
    if (value == fs::XfsGeometryIssue::inode_alignment) { return 19u64; }
    if (value == fs::XfsGeometryIssue::log_geometry) { return 20u64; }
    if (value == fs::XfsGeometryIssue::misc_geometry) { return 21u64; }
    return 999u64;
}

auto probe_status(fs::XfsProbeStatus value) -> u64 {
    if (value == fs::XfsProbeStatus::wrong_length) { return 0u64; }
    if (value == fs::XfsProbeStatus::unrecognized) { return 1u64; }
    if (value == fs::XfsProbeStatus::unsupported_profile) { return 2u64; }
    if (value == fs::XfsProbeStatus::checksum_mismatch) { return 3u64; }
    if (value == fs::XfsProbeStatus::header_integrity_valid) { return 4u64; }
    return 999u64;
}

auto sector_status(fs::XfsSectorHeaderStatus value) -> u64 {
    if (value == fs::XfsSectorHeaderStatus::read_failed) { return 0u64; }
    if (value == fs::XfsSectorHeaderStatus::geometry_rejected) { return 1u64; }
    if (value == fs::XfsSectorHeaderStatus::source_too_small) { return 2u64; }
    if (value == fs::XfsSectorHeaderStatus::header_fits_source) { return 3u64; }
    return 999u64;
}

auto selected_geometry_status(i64 code) -> fs::XfsGeometryStatus {
    if (code == 0) { return fs::XfsGeometryStatus::probe_rejected; }
    if (code == 1) { return fs::XfsGeometryStatus::unsupported_feature_profile; }
    if (code == 2) { return fs::XfsGeometryStatus::unsupported_layout; }
    if (code == 3) { return fs::XfsGeometryStatus::offline_state_indicated; }
    if (code == 4) { return fs::XfsGeometryStatus::inconsistent_header; }
    if (code == 5) { return fs::XfsGeometryStatus::size_unrepresentable; }
    return fs::XfsGeometryStatus::header_geometry_consistent;
}

auto selected_sector_status(i64 code) -> fs::XfsSectorHeaderStatus {
    if (code == 0) { return fs::XfsSectorHeaderStatus::read_failed; }
    if (code == 1) { return fs::XfsSectorHeaderStatus::geometry_rejected; }
    if (code == 2) { return fs::XfsSectorHeaderStatus::source_too_small; }
    return fs::XfsSectorHeaderStatus::header_fits_source;
}

// Facts 0..23 in schema order: blocks, inodes, data, AGs, log.
auto fact_slot(fs::XfsGeometryFacts facts, i64 slot) -> u64 {
    const fs::XfsBlockFacts blocks = facts.blocks();
    const fs::XfsInodeFacts inodes = facts.inodes();
    const fs::XfsDataFacts data = facts.data();
    const fs::XfsAgFacts ags = facts.ags();
    const fs::XfsLogFacts log = facts.log();
    if (slot == 0) { return blocks.block_bytes(); }
    if (slot == 1) { return blocks.sector_bytes(); }
    if (slot == 2) { return blocks.block_log(); }
    if (slot == 3) { return blocks.sector_log(); }
    if (slot == 4) { return blocks.directory_block_bytes(); }
    if (slot == 5) { return blocks.effective_log_sector_bytes(); }
    if (slot == 6) { return inodes.inode_bytes(); }
    if (slot == 7) { return inodes.inodes_per_block(); }
    if (slot == 8) { return inodes.inode_log(); }
    if (slot == 9) { return inodes.inodes_per_block_log(); }
    if (slot == 10) { return data.data_blocks(); }
    if (slot == 11) { return data.claimed_data_bytes(); }
    if (slot == 12) { return data.claimed_data_sectors(); }
    if (slot == 13) { return ags.ag_block_log(); }
    if (slot == 14) { return ags.ag_blocks(); }
    if (slot == 15) { return ags.ag_count(); }
    if (slot == 16) { return ags.ag_bytes(); }
    if (slot == 17) { return ags.last_ag_blocks(); }
    if (slot == 18) { return ags.last_ag_start_bytes(); }
    if (slot == 19) { return log.log_start_encoded(); }
    if (slot == 20) { return log.log_ag(); }
    if (slot == 21) { return log.log_ag_block(); }
    if (slot == 22) { return log.log_start_bytes(); }
    return log.log_bytes();
}

// Slots 0..2 status/issue/probe status, 3..6 probe masks, 7..9 raw words,
// 10..13 unsupported masks, 14..17 unknown masks, 18..41 facts.
auto geometry_slot(fs::XfsGeometryReport report, i64 slot) -> u64 {
    const fs::XfsProbeResult probe = report.probe();
    const fs::XfsHeaderObservations raw = report.raw();
    const fs::XfsFeatureDiagnostics masks = report.masks();
    const fs::XfsFeatureMasks unsupported = masks.unsupported();
    const fs::XfsFeatureMasks unknown = masks.unknown();
    if (slot == 0) { return geometry_status(report.status()); }
    if (slot == 1) { return geometry_issue(report.issue()); }
    if (slot == 2) { return probe_status(probe.status()); }
    if (slot == 3) { return probe.features_compat(); }
    if (slot == 4) { return probe.features_ro_compat(); }
    if (slot == 5) { return probe.features_incompat(); }
    if (slot == 6) { return probe.features_log_incompat(); }
    if (slot == 7) { return raw.versionnum(); }
    if (slot == 8) { return raw.features2(); }
    if (slot == 9) { return raw.bad_features2(); }
    if (slot == 10) { return unsupported.compat(); }
    if (slot == 11) { return unsupported.ro_compat(); }
    if (slot == 12) { return unsupported.incompat(); }
    if (slot == 13) { return unsupported.log_incompat(); }
    if (slot == 14) { return unknown.compat(); }
    if (slot == 15) { return unknown.ro_compat(); }
    if (slot == 16) { return unknown.incompat(); }
    if (slot == 17) { return unknown.log_incompat(); }
    return fact_slot(report.facts(), slot - 18);
}

// Slots 0..1 sector/io status, 2..43 copied geometry, 44..67 admitted facts.
auto sector_slot(fs::XfsSectorHeaderReport report, i64 slot) -> u64 {
    if (slot == 0) { return sector_status(report.status()); }
    if (slot == 1) { return io_status(report.io_status()); }
    if (slot < 44) { return geometry_slot(report.geometry_or_empty(), slot - 2); }
    return fact_slot(report.facts(), slot - 44);
}

auto fabricated_geometry(fs::XfsGeometryStatus status) -> fs::XfsGeometryReport {
    const fs::XfsBlockFacts blocks = fs::XfsBlockFacts(9223372036854775825u64, 9223372036854841362u64,
        9223372036854906899u64, 9223372036854972436u64, 9223372036855037973u64, 9223372036855103510u64);
    const fs::XfsInodeFacts inodes = fs::XfsInodeFacts(9223372036855169047u64, 9223372036855234584u64,
        9223372036855300121u64, 9223372036855365658u64);
    const fs::XfsDataFacts data = fs::XfsDataFacts(9223372036855431195u64, 9223372036855496732u64,
        9223372036855562269u64);
    const fs::XfsAgFacts ags = fs::XfsAgFacts(9223372036855627806u64, 9223372036855693343u64, 9223372036855758880u64,
        9223372036855824417u64, 9223372036855889954u64, 9223372036855955491u64);
    const fs::XfsLogFacts log = fs::XfsLogFacts(9223372036856021028u64, 9223372036856086565u64,
        9223372036856152102u64, 9223372036856217639u64, 9223372036856283176u64);
    const fs::XfsGeometryFacts facts = fs::XfsGeometryFacts(blocks, inodes, data, ags, log);
    const fs::XfsProbeResult probe = fs::XfsProbeResult(fs::XfsProbeStatus::checksum_mismatch, 1u64, 2u64, 3u64,
        4u64);
    const fs::XfsHeaderObservations raw = fs::XfsHeaderObservations(5u64, 6u64, 7u64);
    const fs::XfsFeatureMasks unsupported = fs::XfsFeatureMasks(8u64, 9u64, 10u64, 11u64);
    const fs::XfsFeatureMasks unknown = fs::XfsFeatureMasks(12u64, 13u64, 14u64, 15u64);
    const fs::XfsFeatureDiagnostics masks = fs::XfsFeatureDiagnostics(unsupported, unknown);
    const fs::XfsGeometryReport report = fs::XfsGeometryReport(status, fs::XfsGeometryIssue::none, probe, raw, masks,
        facts);
    return report;
}

auto layout_slot(i64 slot) -> u64 {
    if (slot == 0) { return u64(size_of(fs::XfsBlockFacts)); }
    if (slot == 1) { return u64(reflect_size(type_id(fs::XfsBlockFacts))); }
    if (slot == 2) { return u64(field_count(fs::XfsBlockFacts)); }
    if (slot == 3) { return u64(reflect_field_count(type_id(fs::XfsBlockFacts))); }
    if (slot == 4) { return u64(size_of(fs::XfsInodeFacts)); }
    if (slot == 5) { return u64(reflect_size(type_id(fs::XfsInodeFacts))); }
    if (slot == 6) { return u64(field_count(fs::XfsInodeFacts)); }
    if (slot == 7) { return u64(reflect_field_count(type_id(fs::XfsInodeFacts))); }
    if (slot == 8) { return u64(size_of(fs::XfsDataFacts)); }
    if (slot == 9) { return u64(reflect_size(type_id(fs::XfsDataFacts))); }
    if (slot == 10) { return u64(field_count(fs::XfsDataFacts)); }
    if (slot == 11) { return u64(reflect_field_count(type_id(fs::XfsDataFacts))); }
    if (slot == 12) { return u64(size_of(fs::XfsAgFacts)); }
    if (slot == 13) { return u64(reflect_size(type_id(fs::XfsAgFacts))); }
    if (slot == 14) { return u64(field_count(fs::XfsAgFacts)); }
    if (slot == 15) { return u64(reflect_field_count(type_id(fs::XfsAgFacts))); }
    if (slot == 16) { return u64(size_of(fs::XfsLogFacts)); }
    if (slot == 17) { return u64(reflect_size(type_id(fs::XfsLogFacts))); }
    if (slot == 18) { return u64(field_count(fs::XfsLogFacts)); }
    if (slot == 19) { return u64(reflect_field_count(type_id(fs::XfsLogFacts))); }
    if (slot == 20) { return u64(size_of(fs::XfsGeometryFacts)); }
    if (slot == 21) { return u64(reflect_size(type_id(fs::XfsGeometryFacts))); }
    if (slot == 22) { return u64(field_count(fs::XfsGeometryFacts)); }
    if (slot == 23) { return u64(reflect_field_count(type_id(fs::XfsGeometryFacts))); }
    if (slot == 24) { return u64(size_of(fs::XfsHeaderObservations)); }
    if (slot == 25) { return u64(reflect_size(type_id(fs::XfsHeaderObservations))); }
    if (slot == 26) { return u64(field_count(fs::XfsHeaderObservations)); }
    if (slot == 27) { return u64(reflect_field_count(type_id(fs::XfsHeaderObservations))); }
    if (slot == 28) { return u64(size_of(fs::XfsFeatureMasks)); }
    if (slot == 29) { return u64(reflect_size(type_id(fs::XfsFeatureMasks))); }
    if (slot == 30) { return u64(field_count(fs::XfsFeatureMasks)); }
    if (slot == 31) { return u64(reflect_field_count(type_id(fs::XfsFeatureMasks))); }
    if (slot == 32) { return u64(size_of(fs::XfsFeatureDiagnostics)); }
    if (slot == 33) { return u64(reflect_size(type_id(fs::XfsFeatureDiagnostics))); }
    if (slot == 34) { return u64(field_count(fs::XfsFeatureDiagnostics)); }
    if (slot == 35) { return u64(reflect_field_count(type_id(fs::XfsFeatureDiagnostics))); }
    if (slot == 36) { return u64(size_of(fs::XfsGeometryReport)); }
    if (slot == 37) { return u64(reflect_size(type_id(fs::XfsGeometryReport))); }
    if (slot == 38) { return u64(field_count(fs::XfsGeometryReport)); }
    return u64(reflect_field_count(type_id(fs::XfsGeometryReport)));
}

class HeaderInput {
    builtin::array<u8, 512> header0;
    builtin::array<u8, 512> header1;
    builtin::array<u8, 512> header2;
    builtin::array<u8, 512> header3;
    builtin::array<u8, 512> header4;
    builtin::array<u8, 512> header5;
    builtin::array<u8, 512> header6;
    builtin::array<u8, 512> header7;
    i64 length;
    i64 operation;
    i64 selector;
    i64 io;
    u64 count;
    i64 writable;
public:
    HeaderInput() : header0{}, header1{}, header2{}, header3{}, header4{}, header5{}, header6{}, header7{},
        length(0), operation(0), selector(0), io(0), count(0u64), writable(0) {
    }

    auto header_at(i64 offset) const -> u8 {
        if (offset < 512) { return header0[offset]; }
        if (offset < 1024) { return header1[offset - 512]; }
        if (offset < 1536) { return header2[offset - 1024]; }
        if (offset < 2048) { return header3[offset - 1536]; }
        if (offset < 2560) { return header4[offset - 2048]; }
        if (offset < 3072) { return header5[offset - 2560]; }
        if (offset < 3584) { return header6[offset - 3072]; }
        return header7[offset - 3584];
    }

    // The copied report outlives the local owner array that backed its view.
    auto inspected() const -> fs::XfsGeometryReport {
        builtin::array<u8, 1024> bytes = {
            0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
