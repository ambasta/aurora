    // The first 512 header bytes travel as a copied sector read result.
    auto sector_read() const -> storage::SectorReadResult {
        storage::Sector512 sector = storage::Sector512();
        i64 at = 0;
        while (at < 512) {
            sector.write_byte(at, header0[at]);
            at = at + 1;
        }
        const storage::SectorReadResult read = storage::SectorReadResult(selected_io_status(io), sector);
        sector.write_byte(0, 0u8);
        sector.write_byte(511, 0u8);
        return read;
    }

    auto sector_report() const -> fs::XfsSectorHeaderReport {
        if (operation == 6) {
            const fs::XfsSectorHeaderReport fabricated = fs::XfsSectorHeaderReport(selected_sector_status(selector),
                selected_io_status(io), fs::inspect_xfs_v5_512_geometry(borrow_bytes(header0)));
            return fabricated;
        }
        const storage::SectorGeometry source = storage::SectorGeometry(count, writable == 1);
        const fs::XfsSectorHeaderReport report = fs::inspect_xfs_v5_512_sector(source, sector_read());
        return report;
    }

    auto entry(i64 slot) const -> u64 {
        if (operation == 1) { return geometry_slot(fabricated_geometry(selected_geometry_status(selector)), slot); }
        if (operation == 2) { return layout_slot(slot); }
        if (operation == 3) {
            const fs::XfsGeometryReport retained = detached(0);
            const fs::XfsGeometryReport copy = retained;
            const fs::XfsGeometryReport other = detached(512);
            if (slot < 42) { return geometry_slot(copy, slot); }
            if (slot == 42) { return geometry_slot(other, 32); }
            return geometry_slot(retained, 32);
        }
        if (operation == 4) {
            const fs::XfsProbeResult probe = probed();
            if (slot == 0) { return probe_status(probe.status()); }
            if (slot == 1) { return probe.features_compat(); }
            if (slot == 2) { return probe.features_ro_compat(); }
            if (slot == 3) { return probe.features_incompat(); }
            return probe.features_log_incompat();
        }
        if (operation >= 5) {
            const fs::XfsSectorHeaderReport report = sector_report();
            const fs::XfsSectorHeaderReport copy = report;
            if (slot < 68) { return sector_slot(copy, slot); }
            if (slot == 68) { return u64(size_of(fs::XfsSectorHeaderReport)); }
            if (slot == 69) { return u64(size_of(fs::XfsSectorHeaderStatus)); }
            return u64(field_count(fs::XfsSectorHeaderReport));
        }
        const fs::XfsGeometryReport report = inspected();
        if (slot < 42) { return geometry_slot(report, slot); }
        // A repeated inspection and a direct probe of the same view agree with the report.
        const fs::XfsGeometryReport repeated = inspected();
        const fs::XfsProbeResult direct = probed();
        const fs::XfsProbeResult probe = report.probe();
        if (probe.status() != direct.status() || probe.features_compat() != direct.features_compat()
            || probe.features_ro_compat() != direct.features_ro_compat()
            || probe.features_incompat() != direct.features_incompat()
            || probe.features_log_incompat() != direct.features_log_incompat()) {
            return 173u64;
        }
        i64 check = 0;
        while (check < 42) {
            if (geometry_slot(report, check) != geometry_slot(repeated, check)) { return 900u64 + u64(check); }
            check = check + 1;
        }
        return 1u64;
    }
};
