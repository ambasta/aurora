# Fixed function_overloads.py cases; the format is native_runner.Suite.load's.
@prelude HELPERS_MODULE
export module helpers;namespace api{auto pick(i64 n)->i64{return n;}export auto pick(u8 n)->i64{return pick(i64(n));}}
@case class temporary selects copied overload
module app;${COUNTER}auto pick(Counter c)->i64{return c.get();}auto pick(i64 c)->i64{return c;}auto test()->i64{return pick(Counter(42));}
@case zero through six parameters
module app;auto pick()->i64{return 21;}auto pick(i64 a,i64 b,i64 c,i64 d,i64 e,i64 f)->i64{return a+b+c+d+e+f;}auto test()->i64{return pick()+pick(1,2,3,4,5,6);}
@case nested exact selection
module app;auto inc(i64 x)->i64{return x+1;}auto inc(u8 x)->u8{return x;}auto pick(i64 x)->i64{return x;}auto pick(u8 x)->i64{return 0;}auto test()->i64{return pick(inc(41));}
@case scalar arguments evaluate once left to right
module app;${COUNTER}auto pick(i64 a,i64 b,i64 c)->i64{if(a==1){if(b==11){if(c==111){return 42;}}}return 0;}auto pick(u8 a,u8 b,u8 c)->i64{return 1;}auto test()->i64{Counter c=Counter(0);return pick(c.add(1),c.add(10),c.add(100));}
@case class snapshot before later mutation
module app;${COUNTER}auto pick(Counter c,i64 v)->i64{if(c.get()==41){return v;}return 0;}auto pick(i64 c,i64 v)->i64{return 0;}auto test()->i64{Counter c=Counter(41);return pick(c,c.add(1));}
@case class snapshot after earlier mutation
module app;${COUNTER}auto pick(i64 v,Counter c)->i64{if(c.get()==42){return v;}return 0;}auto pick(i64 v,i64 c)->i64{return 0;}auto test()->i64{Counter c=Counter(41);return pick(c.add(1),c);}
@case copied class results
module app;${COUNTER}auto pick(Counter c)->Counter{return c;}auto pick(i64 c)->i64{return c;}auto test()->i64{Counter c=Counter(42);Counter result=pick(c);c.add(1);return result.get();}
@case result type irrelevant but distinct arguments
module app;${COUNTER}auto pick(i64 n)->Counter{const Counter c=Counter(n);return c;}auto pick(u8 n)->bool{return true;}auto test()->i64{Counter c=pick(42);return c.get();}
@case nominal enums
module app;enum class A{ready};enum class B{ready};auto pick(A x)->i64{return 0;}auto pick(B x)->i64{return 42;}auto test()->i64{return pick(B::ready);}
@case nominal empty classes
module app;class A{public:A(){}};class B{public:B(){}};auto pick(A x)->i64{return 0;}auto pick(B x)->i64{return 42;}auto test()->i64{B b=B();return pick(b);}
@case readonly span and scalar dispatch
module app;auto pick(builtin::span<const u8> a)->i64{return i64(a.at(0));}auto pick(i64 x)->i64{return x;}auto test()->i64{array<u8,1> a={42u8};return pick(borrow_bytes(a));}
@case readonly span reborrow cleanup
module app;auto pick(builtin::span<const u8> a)->i64{return i64(a.at(0));}auto pick(i64 x)->i64{return x;}auto test()->i64{array<u8,1> a={41u8};{const builtin::span<const u8> b=borrow_bytes(a);pick(b);}a[0]=42u8;return pick(borrow_bytes(a));}
@case ordinary calls in generic body
module app;auto pick(i64 x)->i64{return 0;}auto pick(u8 x)->i64{return i64(x);}template<Scalar T>auto relay(T x)->i64{return pick(x);}auto test()->i64{return relay<u8>(42u8);}
@case ordinary overload calls explicit generic result
module app;auto pick(i64 x)->i64{return 0;}auto pick(u8 x)->i64{return i64(x);}template<Scalar T>auto identity(T x)->T{return x;}auto test()->i64{return pick(identity<u8>(42u8));}
@case constructor initializer uses overload
module app;${COUNTER}auto pick(i64 x)->i64{return 0;}auto pick(u8 x)->i64{return i64(x)+2;}auto test()->i64{Counter c=Counter(pick(40u8));return c.get();}
@case ordinary overload call from method
module app;auto pick(i64 x)->i64{return x;}auto pick(u8 x)->i64{return 0;}class Box{public:Box(){}auto run()const->i64{return pick(42);}};auto test()->i64{Box b=Box();return b.run();}
@case private overload available to defining body
module app;import helpers;auto test()->i64{return api::pick(42u8);}
@module helpers
${HELPERS_MODULE}
@case private overload unavailable to importer
@error no exact
module app;import helpers;auto test()->i64{return api::pick(42);}
@module helpers
${HELPERS_MODULE}
@case unused cross-module overload collision
@error ambiguous
module app;import left;import right;auto test()->i64{return 42;}
@module left
export module left;export auto pick(i64 n)->i64{return n;}
@module right
export module right;export auto pick(u8 n)->i64{return i64(n);}
@case nested argument overflow exact trap
@trap overflow
module app;auto pick(i64 n)->i64{return n;}auto pick(u8 n)->i64{return i64(n);}auto test()->i64{return pick(9223372036854775807+1);}
@case nested argument bounds exact trap
@trap bounds
module app;auto pick(i64 n)->i64{return n;}auto pick(u8 n)->i64{return i64(n);}auto test()->i64{array<i64,1> a={42};return pick(a[1]);}
