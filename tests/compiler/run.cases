# Fixed run.py cases; the format is native_runner.Suite.load's.
@case nested functions
module test; auto inc(i64 x) -> i64 { return x + 1; } auto test() -> i64 { return 2 * inc(20); }
@case six argument ABI
module test; auto sum(i64 a,i64 b,i64 c,i64 d,i64 e,i64 f) -> i64 { return a+b+c+d+e+f; } auto id(i64 x) -> i64 { return x; } auto test() -> i64 { return 1 + sum(id(1),2,3,4,5,id(26)); }
@case bool function
module test; auto yes(i64 x) -> bool { return x == 42; } auto test() -> i64 { if (yes(42)) { return 42; } else { return 0; } }
@case reflection dynamic
module test; auto inspect(i64 id) -> i64 { return reflect_size(id); } auto test() -> i64 { return inspect(type_id(i64)) + 34; }
@case class runtime dynamic id
@expect 18
module test; class Point { public: i64 x; i64 y; }; auto inspect(i64 id) -> i64 { return reflect_size(id) + reflect_field_count(id); } auto test() -> i64 { return inspect(type_id(Point)); }
@case class bool field
module test; class Flag { public: bool enabled; i64 value; }; auto test() -> i64 { Flag f = Flag { .value = 42, .enabled = false }; f.enabled = true; if (f.enabled) { return f.value; } return 0; }
@case empty class
@expect 8
module test; class Empty { public:}; auto test() -> i64 { const Empty e = Empty {}; const Empty f = e; static_assert(field_count(Empty) == 0); return size_of(Empty); }
@case classes declared after function
module test; auto test() -> i64 { const Pair p = Pair { .x = 42 }; return p.x; } class Pair { public: i64 x; };
@case class call fields
module test; class Point { public: i64 x; i64 y; }; auto id(i64 x) -> i64 { return x; } auto test() -> i64 { const Point p = Point { .y = id(22), .x = id(20) }; return p.x + p.y; }
@case multiple class type IDs
@expect 24
module test; class A { public: i64 x; }; class B { public: i64 x; i64 y; }; auto test() -> i64 { static_assert(type_id(A) != type_id(B)); return reflect_size(type_id(A)) + reflect_size(type_id(B)); }
@case class duplicate declaration
@error duplicate or reserved class
module test; class A { public:}; class A { public:}; auto test() -> i64 { return 0; }
@case class duplicate fields
@error duplicate class field
module test; class A { public: i64 x; bool x; }; auto test() -> i64 { return 0; }
@case class owned field rejected
@error class fields require
module test; class A { public: own<i64> x; }; auto test() -> i64 { return 0; }
@case class unknown nested field rejected
@error unknown nominal type
module test; class A { public: Point x; }; auto test() -> i64 { return 0; }
@case class reserved name
@error duplicate or reserved class
module test; class i64 { public:}; auto test() -> i64 { return 0; }
@case class function name collision
@error duplicate or reserved function
module test; class A { public:}; auto A() -> i64 { return 0; }
@case class wrong copy type
@error expected B
module test; class A { public: i64 x; }; class B { public: i64 x; }; auto test() -> i64 { const A a = A { .x = 1 }; const B b = a; return 0; }
@case class parameter value copy
module test; class A { public:i64 value;}; auto get(A a)->i64{return a.value;} auto test()->i64{A a=A{.value=42};return get(a);}
@case class return requires named local
@error complete local name
module test; class A { public:}; auto test() -> A { return A {}; }
@case private class construction rejected
@error class construction requires public fields
module test; class Secret { i64 value; }; auto test() -> i64 { const Secret s = Secret{.value = 42}; return 0; }
@case explicit private class construction rejected
@error class construction requires public fields
module test; class Secret { public: i64 x; private: i64 y; }; auto test() -> i64 { const Secret s = Secret{.x = 1, .y = 2}; return 0; }
@case private metadata hides field count
@expect 1
module test; class Secret { i64 value; public: bool visible; }; auto test() -> i64 { static_assert(field_count(Secret) == 1); return reflect_field_count(type_id(Secret)); }
# Loop state analysis accounts for zero iterations and every continuing backedge.
@case while sum
module test; auto test() -> i64 { i64 i = 0; i64 sum = 0; while (i < 7) { sum = sum + i; i = i + 1; } return sum * 2; }
@case nested while
module test; auto test() -> i64 { i64 i = 0; i64 sum = 0; while (i < 6) { i64 j = 0; while (j < 7) { sum = sum + 1; j = j + 1; } i = i + 1; } return sum; }
@case while local ownership
module test; auto test() -> i64 { i64 i = 0; i64 sum = 0; while (i < 2) { own<i64> a = own(21); own<i64> b = move(a); sum = sum + read(b); i = i + 1; } return sum; }
@case while mutable borrowing
module test; auto test() -> i64 { own<i64> a = own(0); i64 i = 0; while (i < 6) { mutref<i64> r = borrow_mut(a); write(r, read(r) + 7); i = i + 1; } return read(a); }
@case while existing borrow
module test; auto test() -> i64 { own<i64> a = own(0); mutref<i64> r = borrow_mut(a); i64 i = 0; while (i < 6) { write(r, read(r) + 7); i = i + 1; } return read(r); }
@case while branch returning move
module test; auto test() -> i64 { own<i64> a = own(42); i64 i = 0; while (i < 2) { if (i == 1) { own<i64> b = move(a); return read(b); } i = i + 1; } return read(a); }
# Arrays have value semantics, checked indexes, and no reference escape surface.
@case array load
module test; auto test() -> i64 { const array<i64, 3> values = {10, 20, 12}; return values[0] + values[1] + values[2]; }
@case array copy independent
module test; auto test() -> i64 { array<i64, 2> values = {20, 22}; const array<i64, 2> snapshot = values; values[0] = 100; return snapshot[0] + snapshot[1]; }
@case array sum loop
module test; auto test() -> i64 { const array<i64, 4> values = {10, 20, 5, 7}; i64 i = 0; i64 sum = 0; while (i < len(values)) { sum = sum + values[i]; i = i + 1; } return sum; }
@case array bool storage
module test; auto test() -> i64 { array<bool, 3> values = {false, true, false}; values[0] = true; if (values[0] == values[1]) { return 42; } return 0; }
@case array reflection
module test; auto test() -> i64 { const array<bool, 3> values = {true, false, true}; static_assert(size_of(array<bool, 3>) == 24); static_assert(type_id(array<bool, 3>) != type_id(array<i64, 3>)); return reflect_size(type_id(array<bool, 3>)) + 18; }
@case array calls initialization
module test; auto id(i64 value) -> i64 { return value; } auto test() -> i64 { const array<i64, 3> values = {id(10), id(20), id(12)}; return values[0] + values[1] + values[2]; }
@case array index exactly once
module test; auto test() -> i64 { own<i64> counter = own(0); mutref<i64> r = borrow_mut(counter); const array<i64, 3> values = {0, 41, 0}; return values[write(r, read(r) + 1)] + read(r); }
@case array assignment index before rhs
module test; auto test() -> i64 { own<i64> counter = own(0); mutref<i64> r = borrow_mut(counter); array<i64, 3> values = {0, 0, 0}; values[write(r, 1)] = write(r, 42); return values[1]; }
@case array initializer written order
module test; auto test() -> i64 { own<i64> counter = own(0); mutref<i64> r = borrow_mut(counter); const array<i64, 2> values = {write(r, 20), write(r, read(r) + 2)}; return values[0] + values[1]; }
@case array bounds before RHS
@trap bounds
module test; auto spin() -> i64 { while (true) {} return 0; } auto test() -> i64 { array<i64, 1> values = {42}; values[1] = spin(); return 42; }
@case array parameter deferred
@error only scalar function parameters
module test; auto test(array<i64, 1> a) -> i64 { return 0; }
@case class public array field rejected
@error array fields must be private
module test; class A { public: array<i64, 1> a; }; auto test() -> i64 { return 0; }
@case array reserved class name
@error reserved builtin storage name
module test; class array {}; auto test() -> i64 { return 0; }
