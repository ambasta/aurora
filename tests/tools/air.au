        auto repeat_block(i64 begin, i64 close, i64 end, i64 line, i64 count) -> bool {
            const i64 first = tokenSize;
            i64 at = begin;
            i64 at_number = line;
            while (at < close && good()) {
                const i64 stop = line_end(at, end);
                at_line(at_number);
                tokenize(at, stop, at_number, true);
                at = stop + 1;
                at_number = at_number + 1;
            }
            const i64 size = tokenSize - first;
            if (count == 0) {
                tokenSize = first;
                return good();
            }
            i64 repetition = 1;
            while (repetition < count && good()) {
                i64 index = 0;
                while (index < size && good()) {
                    add_token(spelled(token_at(first + index), repetition * size, repetition));
                    index = index + 1;
                }
                repetition = repetition + 1;
            }
            i64 index = 0;
            while (index < size && good()) {
                set_token(first + index, spelled(token_at(first + index), 0, 0));
                index = index + 1;
            }
            return good();
        }
        auto lines_between(i64 begin, i64 end) const -> i64 {
            i64 count = 0;
            i64 at = begin;
            while (at < end) {
                if (text.at(at) == '\n') {
                    count = count + 1;
                }
                at = at + 1;
            }
            return count;
        }
        // Copies one module and tokenizes every line, expanding repeat blocks:
        // "repeat N" ... "endrepeat" spells its lines N times, each {a,s} in
        // repetition i as a + s * i.
        auto load(builtin::span<const u8> source) -> bool {
            const i64 begin = textSize;
            if (!put_text(source)) {
                return false;
            }
            const i64 end = textSize;
            i64 at = begin;
            i64 line = 1;
            while (at <= end && good()) {
                const i64 stop = line_end(at, end);
                at_line(line);
                if (keyword_is(at, stop, "endrepeat")) {
                    return fail();
                }
                if (keyword_is(at, stop, "repeat")) {
                    const i64 mark = tokenSize;
                    if (!tokenize(at, stop, line, false) || nodes(mark) != 2) {
                        return fail();
                    }
                    const i64 count = integer(mark + 1);
                    tokenSize = mark;
                    const i64 close = block_end(stop + 1, end);
                    if (!good() || count < 0 || count > 16777216 || close < 0) {
                        return fail();
                    }
                    repeat_block(stop + 1, close, end, line + 1, count);
                    const i64 after = line_end(close, end) + 1;
                    line = line + lines_between(at, after);
                    at = after;
                } else {
                    process(at, stop, line);
                    at = stop + 1;
                    line = line + 1;
                }
            }
            abiTokens = tokenSize;
            return good();
        }
        // ABI declaration lines follow the module's tokens.
        auto load_abi(builtin::span<const u8> source) -> bool {
            const i64 begin = textSize;
            if (!put_text(source)) {
                return false;
            }
            const i64 end = textSize;
            i64 at = begin;
            while (at < end && good()) {
                const i64 stop = line_end(at, end);
                tokenize(at, stop, 0, false);
                at = stop + 1;
            }
            return good();
        }
        auto abi_begin() const -> i64 {
            return abiTokens;
        }

        // ---- declarations
        auto line_end_token(i64 line) const -> i64 {
            i64 at = line;
            while (kind(at) != 6) {
                at = next(at);
            }
            return at;
        }
        auto header(i64 function, i64 field) const -> i64 {
            return line_at(function_at(function) + field);
        }
        auto set_header(i64 field, i64 line) -> bool {
            if (functionSize == 0) {
                return fail();
            }
            return set_line(function_at(functionSize - 1) + field, line);
        }
        auto slot_line(i64 line, i64 ordinal, i64 expected) -> bool {
            if (!arity(line, expected, expected)) {
                return false;
            }
            const i64 offset = integer(node(line, 1));
            return add_entry(5, (functionSize - 1) * 16 + ordinal, -1, offset, line);
        }
        auto slot_arity(i64 ordinal) const -> i64 {
            if (ordinal == 1) {
                return 4;
            }
            if (ordinal >= 3 && ordinal <= 5) {
                return 2;
            }
            return 3;
        }
        // One line inside a function: 1 handled, 2 its end, 0 a failure.
        auto function_line(i64 line) -> i64 {
            const i64 found = cache_code(line);
            if (found >= 0 && found < 85) {
                if (!add_line(line)) {
                    return 0;
                }
                return 1;
            }
            if (found == 85) {
                if (!arity(line, 1, 1)) {
                    return 0;
                }
                return 2;
            }
            i64 field = 0;
            if (found >= 86 && found <= 93) {
                field = found - 85;
            }
            if (field != 0) {
                i64 maximum = 2;
                i64 minimum = 2;
                if (field == 5) {
                    minimum = 4;
                    maximum = 5;
                }
                if (!arity(line, minimum, maximum) || !set_header(field, line)) {
                    return 0;
                }
                return 1;
            }
            i64 ordinal = -1;
            if (found >= 94 && found <= 102) {
                ordinal = found - 94;
            }
            if (ordinal < 0 || !slot_line(line, ordinal, slot_arity(ordinal))) {
                fail();
                return 0;
            }
            return 1;
        }
        auto declaration(i64 line, i64 expected, i64 number) -> bool {
            return arity(line, expected, expected) && name(node(line, 1)) && add_entry(0, 0, node(line, 1), number,
                line);
        }
        auto module_line(i64 line) -> bool {
            const i64 found = cache_code(line);
            if (found == 103) {
                if (!arity(line, 2, 2) || !name(node(line, 1)) || !add_entry(6, 0, node(line, 1), functionSize, line)
                    || !add_function() || !add_line(node(line, 1))) {
                    return false;
                }
                i64 field = 1;
                while (field < 9) {
                    add_line(-1);
                    field = field + 1;
                }
                return good();
            }
            if (found == 104) {
                return declaration(line, 3, 0);
            }
            if (found == 105) {
                return declaration(line, 3, 1);
            }
            if (found == 106) {
                return declaration(line, 7, 2);
            }
            if (found == 107) {
                return declaration(line, 2, 3);
            }
            if (found == 108) {
                return arity(line, 4, 4) && add_entry(1, 0, -1, integer(node(line, 1)), line);
            }
            if (found == 109) {
                viewsLine = line;
                return arity(line, 2, 2);
            }
            if (found == 110) {
                return arity(line, 3, 3) && name(node(line, 1)) && add_entry(4, 0, node(line, 1), 0, line);
            }
            return fail();
        }
        // The last views line replaces the default single empty scope-zero view.
        auto view_entries() -> bool {
            if (viewsLine < 0) {
                return add_entry(2, 0, -1, 0, -1);
            }
            const i64 list = node(viewsLine, 1);
            const i64 count = items(list, 2);
            i64 at = 0;
            i64 view = list + 1;
            while (at < count && good()) {
                if (items(view, 3) != 2) {
                    return fail();
                }
                const i64 scope = integer(item(view, 0));
                const i64 identities = item(view, 1);
                add_entry(2, 0, -1, scope, viewsLine);
                const i64 size = items(identities, 2);
                i64 index = 0;
                i64 identity = identities + 1;
                while (index < size && good()) {
                    add_entry(3, scope, -1, integer(identity), viewsLine);
                    identity = next(identity);
                    index = index + 1;
                }
                view = next(view);
                at = at + 1;
            }
            return good();
        }
        auto structure() -> bool {
            bool inside = false;
            i64 at = 0;
            while (at < abiTokens && good()) {
                const i64 stop = line_end_token(at);
                const Token end_token = token_at(stop);
                at_line(end_token.extra());
                if (stop != at) {
                    if (kind(at) != 0) {
                        return fail();
                    }
                    if (inside) {
                        const i64 handled = function_line(at);
                        if (handled == 0) {
                            return fail();
                        }
                        inside = handled != 2;
                    } else {
                        if (!module_line(at)) {
                            return false;
                        }
                        inside = code(at) == 103;
                    }
                }
                at = stop + 1;
            }
            if (inside) {
                return fail();
            }
            return view_entries() && sort_entries();
        }
        // Entry order: category, group, name bytes, number, insertion.
        auto compare_names(i64 left, i64 right) const -> i64 {
            i64 a_first = 0;
            i64 a_count = 0;
            i64 b_first = 0;
            i64 b_count = 0;
            if (left >= 0) {
                const Token a = token_at(left);
                a_first = a.first();
                a_count = a.count();
            }
            if (right >= 0) {
                const Token b = token_at(right);
                b_first = b.first();
                b_count = b.count();
            }
            i64 at = 0;
            while (at < a_count && at < b_count) {
                const u8 x = text.at(a_first + at);
                const u8 y = text.at(b_first + at);
                if (x < y) {
                    return -1;
                }
                if (x > y) {
                    return 1;
                }
                at = at + 1;
            }
            if (a_count < b_count) {
                return -1;
            }
            if (a_count > b_count) {
                return 1;
            }
            return 0;
        }
        // -1, 0 or 1 by every key except insertion order.
        auto compare_keys(Entry left, Entry right) const -> i64 {
            if (left.category() != right.category()) {
                if (left.category() < right.category()) {
                    return -1;
                }
                return 1;
            }
            if (left.group() != right.group()) {
                if (left.group() < right.group()) {
                    return -1;
                }
                return 1;
            }
            const i64 names = compare_names(left.name(), right.name());
            if (names != 0) {
                return names;
            }
            if (left.number() != right.number()) {
                if (left.number() < right.number()) {
                    return -1;
                }
                return 1;
            }
            return 0;
        }
        auto before(i64 left, i64 right) const -> bool {
            const Entry a = entries.at(left);
            const Entry b = entries.at(right);
            const i64 keys = compare_keys(a, b);
            return keys < 0 || (keys == 0 && a.sequence() < b.sequence());
        }
        auto swap_entries(i64 left, i64 right) -> bool {
            const Entry a = entries.at(left);
            const Entry b = entries.at(right);
            entries.set(left, b);
            entries.set(right, a);
            return true;
        }
        // Heapsort of entries [base, base + count).
        auto sift(i64 base, i64 root, i64 count) -> bool {
            i64 parent = root;
            bool sifting = true;
            while (sifting) {
                const i64 child = parent * 2 + 1;
                sifting = child < count;
                if (sifting) {
                    i64 larger = child;
                    if (child + 1 < count && before(base + child, base + child + 1)) {
                        larger = child + 1;
                    }
                    sifting = before(base + parent, base + larger);
                    if (sifting) {
                        swap_entries(base + parent, base + larger);
                        parent = larger;
                    }
                }
            }
            return true;
        }
        auto sort_range(i64 base, i64 count) -> bool {
            i64 at = 1;
            bool sorted = true;
            while (sorted && at < count) {
                sorted = !before(base + at, base + at - 1);
                at = at + 1;
            }
            if (sorted) {
                return good();
            }
            at = count / 2;
            while (at > 0) {
                at = at - 1;
                sift(base, at, count);
            }
            i64 end = count;
            while (end > 1) {
                end = end - 1;
                swap_entries(base, base + end);
                sift(base, 0, end);
            }
            return good();
        }
        // Groups entries by category, keeping insertion order, then sorts
        // only the out-of-order categories; rejects duplicate declarations
        // (visible IDs and same-named callables may repeat).
        auto sort_entries() -> bool {
            if (grouped.size() < entrySize) {
                const Entry fill = Entry(-1, 0, -1, 0, 0, -1);
                if (!grouped.try_resize(entrySize, fill)) {
                    return fail();
                }
            }
            i64 placed = 0;
            i64 category = 0;
            while (category < 7) {
                i64 at = 0;
                while (at < entrySize) {
                    const Entry value = entries.at(at);
                    if (value.category() == category) {
                        grouped.set(placed, value);
                        placed = placed + 1;
                    }
                    at = at + 1;
                }
                category = category + 1;
            }
            if (placed != entrySize) {
                return fail();
            }
            i64 at = 0;
            while (at < entrySize) {
                const Entry value = grouped.at(at);
                entries.set(at, value);
                at = at + 1;
            }
            at = 0;
            while (at < entrySize && good()) {
                const Entry first = entries.at(at);
                i64 end = at + 1;
                bool same = true;
                while (same && end < entrySize) {
                    const Entry next_entry = entries.at(end);
                    same = next_entry.category() == first.category();
                    if (same) {
                        end = end + 1;
                    }
                }
                sort_range(at, end - at);
                at = end;
            }
            at = 1;
            while (at < entrySize) {
                const Entry previous = entries.at(at - 1);
                const Entry current = entries.at(at);
                if (current.category() != 3 && current.category() != 6 && compare_keys(previous, current) == 0) {
                    if (current.token() >= 0) {
                        const Token stop = token_at(line_end_token(current.token()));
                        at_line(stop.extra());
                    }
                    return fail();
                }
                at = at + 1;
            }
            return good();
        }

        // ---- types
        // One key of a type tuple: the parsed element kind, length or
        // parameter/argument extent, or 0 for keys that do not reach metadata.
        auto type_key(i64 field) -> i64 {
            const Token value = token_at(field + 1);
            if (is(field, "display") || is(field, "eparam") || is(field, "lparam")) {
                name(field + 1);
                return value.count();
            }
            if (is(field, "resolved")) {
                return boolean(field + 1);
            }
            if (is(field, "elem")) {
                return type_kind(field + 1);
            }
            if (is(field, "len")) {
                return integer(field + 1);
            }
            if (is(field, "targs")) {
                return items(field + 1, 2);
            }
            fail();
            return 0;
        }
        // A type node with its name as a range of this text: a kind word, or
        // (kind [name] key=value...).
        auto parse_type(i64 token, i64 nominal) -> compiler_ir_metadata::RawTypeRow {
            if (nominal >= 0) {
                return named_type(nominal, token);
            }
            i64 type_kind_value = 0;
            i64 name_first = 0;
            i64 name_count = 0;
            i64 element = 0;
            i64 length = 0;
            i64 element_parameter = 0;
            i64 length_parameter = 0;
            i64 arguments = 0;
            if (token >= 0 && kind(token) == 0) {
                type_kind_value = type_kind(token);
            }
            if (token >= 0 && kind(token) != 0) {
                const i64 count = items(token, 3);
                if (count < 1 || count > 16) {
                    fail();
                }
                type_kind_value = type_kind(token + 1);
                i64 at = 1;
                i64 field = next(token + 1);
                while (at < count && good()) {
                    if (kind(field) != 5) {
                        const Token spelled = token_at(field);
                        if (at != 1 || !name(field)) {
                            fail();
                        }
                        name_first = spelled.first();
                        name_count = spelled.count();
                    } else {
                        const i64 value = type_key(field);
                        if (is(field, "elem")) {
                            element = value;
                        }
                        if (is(field, "len")) {
                            length = value;
                        }
                        if (is(field, "eparam")) {
                            element_parameter = value;
                        }
                        if (is(field, "lparam")) {
                            length_parameter = value;
                        }
                        if (is(field, "targs")) {
                            arguments = value;
                        }
                    }
                    field = next(field);
                    at = at + 1;
                }
            }
            const compiler_ir_metadata::RawTypeTail tail = compiler_ir_metadata::RawTypeTail(element, length,
                u64(element_parameter), u64(length_parameter), u64(arguments));
            const compiler_ir_metadata::RawTypeRow result = compiler_ir_metadata::RawTypeRow(type_kind_value,
                compiler_ir_metadata::ByteRange(name_first, name_count), tail);
            return result;
        }
        // A nominal type of one kind, spelled by a name node.
        auto named_type(i64 type_kind_value, i64 token) -> compiler_ir_metadata::RawTypeRow {
            name(token);
            const Token spelled = token_at(token);
            const compiler_ir_metadata::RawTypeTail tail = compiler_ir_metadata::RawTypeTail(0, 0, 0u64, 0u64, 0u64);
            const compiler_ir_metadata::RawTypeRow result = compiler_ir_metadata::RawTypeRow(type_kind_value,
                compiler_ir_metadata::ByteRange(spelled.first(), spelled.count()), tail);
            return result;
        }

        // ---- store positions
        // Position counters: 0 bytes, 1 types, 2 classes, 3 fields, 4 leaves,
        // 5 storage, 6 indices, 7 descriptors, 8 views, 9 enums, 10 callables,
        // 11 slots, 12 instructions, 13 operands, 14 literals, 15 bodies.
        auto reset(bool fill) -> bool {
            fillingValue = fill;
            byteCount = 0;
            typeCount = 0;
            classCount = 0;
            fieldCount = 0;
            leafCount = 0;
            storageCount = 0;
            indexCount = 0;
            descriptorCount = 0;
            viewCount = 0;
            enumCount = 0;
            callableCount = 0;
            slotCount = 0;
            instructionBegin = 0;
            instructionCount = 0;
            operandCount = 0;
            literalCount = 0;
            bodyCount = 0;
            return good();
        }
        auto count(i64 pool) const -> i64 {
            if (pool == 0) {
                return byteCount;
            }
            if (pool == 1) {
                return typeCount;
            }
            if (pool == 2) {
                return classCount;
            }
            if (pool == 3) {
                return fieldCount;
            }
            if (pool == 4) {
                return leafCount;
            }
            if (pool == 5) {
                return storageCount;
            }
            if (pool == 6) {
                return indexCount;
            }
            if (pool == 7) {
                return descriptorCount;
            }
            if (pool == 8) {
                return viewCount;
            }
            if (pool == 9) {
                return enumCount;
            }
            if (pool == 10) {
                return callableCount;
            }
            if (pool == 11) {
                return slotCount;
            }
            if (pool == 12) {
                return instructionCount;
            }
            if (pool == 13) {
                return operandCount;
            }
            if (pool == 14) {
                return literalCount;
            }
            return bodyCount;
        }
        auto advance(i64 pool, i64 amount) -> bool {
            if (amount < 0 || count(pool) > 9223372036854775807 - amount) {
                return fail();
            }
            if (pool == 0) {
                byteCount = byteCount + amount;
            }
            if (pool == 1) {
                typeCount = typeCount + amount;
            }
            if (pool == 2) {
                classCount = classCount + amount;
            }
            if (pool == 3) {
                fieldCount = fieldCount + amount;
            }
            if (pool == 4) {
                leafCount = leafCount + amount;
            }
            if (pool == 5) {
                storageCount = storageCount + amount;
            }
            if (pool == 6) {
                indexCount = indexCount + amount;
            }
            if (pool == 7) {
                descriptorCount = descriptorCount + amount;
            }
            if (pool == 8) {
                viewCount = viewCount + amount;
            }
            if (pool == 9) {
                enumCount = enumCount + amount;
            }
            if (pool == 10) {
                callableCount = callableCount + amount;
            }
            if (pool == 11) {
                slotCount = slotCount + amount;
            }
            if (pool == 12) {
                instructionCount = instructionCount + amount;
            }
            if (pool == 13) {
                operandCount = operandCount + amount;
            }
            if (pool == 14) {
                literalCount = literalCount + amount;
            }
            if (pool == 15) {
                bodyCount = bodyCount + amount;
            }
            return good();
        }
        auto set_operands(i64 value) -> bool {
            operandCount = value;
            return good();
        }
        auto begin_instructions() -> bool {
            instructionBegin = typeCount;
            return good();
        }
        auto instruction_begin() const -> i64 {
            return instructionBegin;
        }
        auto input_counts() const -> compiler_ir_metadata::InputCounts {
            const compiler_ir_metadata::InputCounts result = compiler_ir_metadata::InputCounts(
                compiler_ir_metadata::CoreCounts(byteCount, typeCount, classCount, fieldCount, leafCount),
                compiler_ir_metadata::MapCounts(storageCount, indexCount, descriptorCount, viewCount, enumCount));
            return result;
        }
    };
    auto create(builtin::ByteRegion region) -> Reader {
        Reader result = Reader(region);
        return move(result);
    }
    auto release(builtin::ByteRegion region, Reader reader) -> i64 {
        return 0;
    }

    // ---- the pending stores, measured (fill false) and then filled in one walk
    // Copies reader text [first, first + count) to the metadata bytes; returns
    // its position, or -1.
    auto text_range(Reader& reader, compiler_ir_metadata::MetadataStore& metadata, i64 first, i64 count,
        bool fill) -> i64 {
        const i64 begin = reader.count(0);
        i64 at = 0;
        while (fill && at < count) {
            const i64 value = reader.byte_at(first + at);
            if (value < 0 || !metadata.ingress_byte(begin + at, u8(value))) {
                reader.fail();
                return -1;
            }
            at = at + 1;
        }
        if (!reader.advance(0, count)) {
            return -1;
        }
        return begin;
    }
    auto token_text(Reader& reader, compiler_ir_metadata::MetadataStore& metadata, i64 token, bool fill) -> i64 {
        const Token value = reader.token_at(token);
        if (token < 0) {
            return text_range(reader, metadata, 0, 0, fill);
        }
        return text_range(reader, metadata, value.first(), value.count(), fill);
    }
    auto token_size(const Reader& reader, i64 token) -> i64 {
        if (token < 0) {
            return 0;
        }
        const Token value = reader.token_at(token);
        return value.count();
    }
    // One type row at position: the type node at token, or with nominal >= 0
    // the type of that kind named by token. Every type takes the next type count.
    auto emit_type(Reader& reader, compiler_ir_metadata::MetadataStore& metadata, i64 token, i64 nominal, i64 position,
        bool fill) -> bool {
        const compiler_ir_metadata::RawTypeRow parsed = reader.parse_type(token, nominal);
        const compiler_ir_metadata::ByteRange spelled = parsed.name();
        const i64 begin = text_range(reader, metadata, spelled.begin(), spelled.count(), fill);
        const compiler_ir_metadata::RawTypeRow row = compiler_ir_metadata::RawTypeRow(parsed.kind(),
            compiler_ir_metadata::ByteRange(begin, spelled.count()), parsed.tail());
        if (!reader.good() || (fill && !metadata.ingress_type(position, row))) {
            return reader.fail();
        }
        return reader.advance(1, 1);
    }
    // Index rows for the integers of a list node; returns the first position.
    auto copy_indices(Reader& reader, compiler_ir_metadata::MetadataStore& metadata, i64 list, bool fill) -> i64 {
        const i64 begin = reader.count(6);
        const i64 size = reader.items(list, 2);
        i64 at = 0;
        i64 item = list + 1;
        while (at < size && reader.good()) {
            const compiler_ir_metadata::IndexRow row = compiler_ir_metadata::IndexRow(reader.integer(item));
            item = reader.next(item);
            if (fill && !metadata.ingress_index(reader.count(6), row)) {
                reader.fail();
            }
            reader.advance(6, 1);
            at = at + 1;
        }
        return begin;
    }
    auto emit_leaves(Reader& reader, compiler_ir_metadata::MetadataStore& metadata, i64 line, bool fill) -> bool {
        const i64 list = reader.node(line, 2);
        const i64 size = reader.items(list, 2);
        i64 at = 0;
        i64 leaf = list + 1;
        while (at < size && reader.good()) {
            const i64 position = reader.count(4);
            emit_type(reader, metadata, leaf, -1, position, fill);
            reader.advance(4, 1);
            leaf = reader.next(leaf);
            at = at + 1;
        }
        return reader.good();
    }
    // Field types follow every class's leaf types.
    auto emit_fields(Reader& reader, compiler_ir_metadata::MetadataStore& metadata, i64 line, bool fill) -> bool {
        const i64 list = reader.node(line, 2);
        const i64 size = reader.items(list, 2);
        i64 leaves = 0;
        if (fill) {
            leaves = metadata.leaf_count();
        }
        i64 at = 0;
        i64 field = list + 1;
        while (at < size && reader.good()) {
            const i64 values = reader.items(field, 3);
            if (values < 4 || values > 5) {
                return reader.fail();
            }
            const i64 type = leaves + reader.count(3);
            const i64 field_type = field + 1;
            const i64 first = reader.next(field_type);
            const i64 length = reader.next(first);
            const i64 flag = reader.next(length);
            emit_type(reader, metadata, field_type, -1, type, fill);
            i64 elements = 1;
            if (values == 5) {
                elements = reader.integer(reader.next(flag));
            }
            const compiler_ir_metadata::FieldRow row = compiler_ir_metadata::FieldRow(type, reader.integer(first),
                reader.integer(length), reader.boolean(flag), elements);
            if (reader.good() && fill && !metadata.ingress_field(reader.count(3), row)) {
                reader.fail();
            }
            reader.advance(3, 1);
            field = reader.next(field);
            at = at + 1;
        }
        return reader.good();
    }
    auto emit_storage(Reader& reader, compiler_ir_metadata::MetadataStore& metadata, i64 line, bool fill) -> bool {
        const i64 leaf_list = reader.node(line, 2);
        const i64 field_list = reader.node(line, 3);
        const i64 leaves = copy_indices(reader, metadata, leaf_list, fill);
        const i64 fields = copy_indices(reader, metadata, field_list, fill);
        const compiler_ir_metadata::StorageRow row = compiler_ir_metadata::StorageRow(compiler_ir_metadata::IndexRange(
            leaves, reader.items(reader.node(line, 2), 2)), compiler_ir_metadata::IndexRange(fields,
            reader.items(reader.node(line, 3), 2)),
            compiler_ir_metadata::PhysicalExtent(reader.integer(reader.node(line, 4)), reader.integer(reader.node(line,
            5)), reader.integer(reader.node(line, 6))));
        if (reader.good() && fill && !metadata.ingress_storage(reader.count(5), row)) {
            reader.fail();
        }
        return reader.advance(5, 1);
    }
    // One class per name of a layout, fields, storage or carrier declaration,
    // in name order; entries [at, end) are its declarations.
    auto emit_class(Reader& reader, compiler_ir_metadata::MetadataStore& metadata, i64 at, i64 end, bool fill) -> bool {
        const compiler_ir_metadata::FlagMasks masks = compiler_ir_metadata::flag_masks();
        const Entry first = reader.entry_at(at);
        const i64 name = first.name();
        const i64 begin = token_text(reader, metadata, name, fill);
        const i64 leaves = reader.count(4);
        const i64 fields = reader.count(3);
        i64 storage = -1;
        u64 membership = 0u64;
        i64 index = at;
        while (index < end && reader.good()) {
            const Entry declaration = reader.entry_at(index);
            const i64 line = declaration.token();
            reader.at_token(line);
            if (declaration.number() == 0) {
                membership = membership | masks.class_layout();
                emit_leaves(reader, metadata, line, fill);
            }
            if (declaration.number() == 1) {
                membership = membership | masks.class_fields();
                emit_fields(reader, metadata, line, fill);
            }
            if (declaration.number() == 2) {
                membership = membership | masks.class_storage();
                storage = reader.count(5);
                emit_storage(reader, metadata, line, fill);
            }
            if (declaration.number() == 3) {
                membership = membership | masks.class_array_carrier();
            }
            index = index + 1;
        }
        const compiler_ir_metadata::ClassRow row = compiler_ir_metadata::ClassRow(compiler_ir_metadata::ByteRange(begin,
            token_size(reader, name)), compiler_ir_metadata::IndexRange(leaves, reader.count(4) - leaves),
            compiler_ir_metadata::IndexRange(fields, reader.count(3) - fields), storage, membership);
        if (reader.good() && fill && !metadata.ingress_class(reader.count(2), row)) {
            reader.fail();
        }
        return reader.advance(2, 1);
    }
    auto emit_classes(Reader& reader, compiler_ir_metadata::MetadataStore& metadata, bool fill) -> bool {
        i64 at = 0;
        while (at < reader.entry_count() && reader.good()) {
            const Entry first = reader.entry_at(at);
            i64 end = at + 1;
            bool same = first.category() == 0;
            while (same && end < reader.entry_count()) {
                const Entry next = reader.entry_at(end);
                same = next.category() == 0 && reader.compare_names(first.name(), next.name()) == 0;
                if (same) {
                    end = end + 1;
                }
            }
            if (first.category() == 0) {
                emit_class(reader, metadata, at, end, fill);
            }
            at = end;
        }
        return reader.good();
    }
    auto emit_tables(Reader& reader, compiler_ir_metadata::MetadataStore& metadata, bool fill) -> bool {
        i64 at = 0;
        i64 identities = 0;
        bool seeking = true;
        while (seeking && identities < reader.entry_count()) {
            const Entry entry = reader.entry_at(identities);
            seeking = entry.category() < 3;
            if (seeking) {
                identities = identities + 1;
            }
        }
        while (at < reader.entry_count() && reader.good()) {
            const Entry entry = reader.entry_at(at);
            const i64 line = entry.token();
            reader.at_token(line);
            if (entry.category() == 1) {
                const compiler_ir_metadata::DescriptorRow row = compiler_ir_metadata::DescriptorRow(entry.number(),
                    reader.integer(reader.node(line, 2)), reader.integer(reader.node(line, 3)));
                if (reader.good() && fill && !metadata.ingress_descriptor(reader.count(7), row)) {
                    reader.fail();
                }
                reader.advance(7, 1);
            }
            if (entry.category() == 2) {
                // Visible descriptor IDs are sorted and unique.
                const i64 begin = reader.count(6);
                bool seen = false;
                i64 last = 0;
                bool scanning = true;
                while (scanning && identities < reader.entry_count()) {
                    const Entry visible = reader.entry_at(identities);
                    scanning = visible.category() == 3 && visible.group() <= entry.number();
                    if (scanning && visible.group() == entry.number() && (!seen || visible.number() != last)) {
                        const compiler_ir_metadata::IndexRow row = compiler_ir_metadata::IndexRow(visible.number());
                        if (fill && !metadata.ingress_index(reader.count(6), row)) {
                            reader.fail();
                        }
                        reader.advance(6, 1);
                        seen = true;
                        last = visible.number();
                    }
                    if (scanning) {
                        identities = identities + 1;
                    }
                }
                const compiler_ir_metadata::ViewRow row = compiler_ir_metadata::ViewRow(entry.number(),
                    compiler_ir_metadata::IndexRange(begin, reader.count(6) - begin));
                if (fill && !metadata.ingress_view(reader.count(8), row)) {
                    reader.fail();
                }
                reader.advance(8, 1);
            }
            if (entry.category() == 4) {
                const i64 begin = token_text(reader, metadata, entry.name(), fill);
                const compiler_ir_metadata::EnumRow row = compiler_ir_metadata::EnumRow(compiler_ir_metadata::ByteRange(
                    begin, token_size(reader, entry.name())), reader.integer(reader.node(line, 2)));
                if (reader.good() && fill && !metadata.ingress_enum(reader.count(9), row)) {
                    reader.fail();
                }
                reader.advance(9, 1);
            }
            at = at + 1;
        }
        return reader.good();
    }
    auto slot_kind(i64 ordinal) -> i64 {
        if (ordinal == 8) {
            return 27;
        }
        return 10 + ordinal;
    }
    auto emit_slot(Reader& reader, compiler_ir_metadata::MetadataStore& metadata, i64 index, bool fill) -> bool {
        const Entry entry = reader.entry_at(index);
        const i64 ordinal = entry.group() % 16;
        const i64 line = entry.token();
        reader.at_token(line);
        i64 type = 0;
        i64 length = 0;
        i64 mutable_value = 0;
        if (ordinal == 0 || ordinal == 1 || ordinal == 7 || ordinal == 8) {
            type = reader.count(1);
            i64 nominal = -1;
            if (ordinal == 1) {
                nominal = 5;
            }
            if (ordinal == 7) {
                nominal = 17;
            }
            if (ordinal == 8) {
                nominal = 21;
            }
            const i64 spelled = reader.node(line, 2);
            emit_type(reader, metadata, spelled, nominal, type, fill);
        }
        if (ordinal == 1) {
            mutable_value = reader.boolean(reader.node(line, 3));
        }
        if (ordinal == 2) {
            length = reader.integer(reader.node(line, 2));
        }
        if (ordinal == 6) {
            mutable_value = reader.boolean(reader.node(line, 2));
        }
        const compiler_ir_metadata::SlotRow row = compiler_ir_metadata::SlotRow(slot_kind(ordinal), entry.number(),
            type, length, mutable_value);
        if (reader.good() && fill && !metadata.ingress_slot(reader.count(11), row)) {
            reader.fail();
        }
        return reader.advance(11, 1);
    }
    // A function header value, or zero when the line is absent.
    auto header_integer(Reader& reader, i64 function, i64 field) -> i64 {
        const i64 line = reader.header(function, field);
        if (line < 0) {
            return 0;
        }
        reader.at_token(line);
        return reader.integer(reader.node(line, 1));
    }
    // One callable: its name, result and parameter types, then its frame slots
    // in kind and offset order (entries from slot), then its receiver.
    auto emit_callable(Reader& reader, compiler_ir_metadata::MetadataStore& metadata, i64 function, i64 slot,
        bool fill) -> i64 {
        const compiler_ir_metadata::FlagMasks masks = compiler_ir_metadata::flag_masks();
        const i64 name = reader.header(function, 0);
        reader.at_token(name);
        const i64 begin = token_text(reader, metadata, name, fill);
        const i64 types = reader.count(1);
        i64 result = -1;
        if (reader.header(function, 1) >= 0) {
            reader.at_token(reader.header(function, 1));
            result = reader.node(reader.header(function, 1), 1);
        }
        emit_type(reader, metadata, result, -1, types, fill);
        i64 parameters = 0;
        if (reader.header(function, 2) >= 0) {
            reader.at_token(reader.header(function, 2));
            const i64 list = reader.node(reader.header(function, 2), 1);
            parameters = reader.items(list, 2);
            i64 at = 0;
            i64 parameter = list + 1;
            while (at < parameters && reader.good()) {
                const i64 position = reader.count(1);
                emit_type(reader, metadata, parameter, -1, position, fill);
                parameter = reader.next(parameter);
                at = at + 1;
            }
        }
        const i64 slots = reader.count(11);
        i64 cursor = slot;
        bool scanning = true;
        while (scanning && cursor < reader.entry_count() && reader.good()) {
            const Entry entry = reader.entry_at(cursor);
            scanning = entry.category() == 5 && entry.group() < (function + 1) * 16;
            if (scanning) {
                emit_slot(reader, metadata, cursor, fill);
                cursor = cursor + 1;
            }
        }
        u64 flags = 0u64;
        i64 receiver_begin = 0;
        i64 receiver_count = 0;
        u64 receiver_flags = 0u64;
        const i64 receiver = reader.header(function, 5);
        if (receiver >= 0) {
            reader.at_token(receiver);
            flags = flags | masks.callable_receiver();
            const i64 receiver_name = reader.node(receiver, 1);
            receiver_begin = token_text(reader, metadata, receiver_name, fill);
            receiver_count = token_size(reader, receiver_name);
            reader.name(reader.node(receiver, 1));
            if (reader.boolean(reader.node(receiver, 2)) == 1) {
                receiver_flags = receiver_flags | masks.receiver_mutable();
            }
            if (reader.boolean(reader.node(receiver, 3)) == 1) {
                receiver_flags = receiver_flags | masks.receiver_constructor();
            }
            if (reader.nodes(receiver) == 4 || reader.boolean(reader.node(receiver, 4)) == 1) {
                receiver_flags = receiver_flags | masks.receiver_public();
            }
        }
        i64 span = 0;
        if (reader.header(function, 8) >= 0) {
            flags = flags | masks.callable_span_summary();
            span = header_integer(reader, function, 8);
        }
        const compiler_ir_metadata::CallableRow row = compiler_ir_metadata::CallableRow(compiler_ir_metadata::ByteRange(
            begin, token_size(reader, name)), compiler_ir_metadata::IndexRange(types, 1 + parameters),
            header_integer(reader, function, 4),
            compiler_ir_metadata::ReceiverShape(compiler_ir_metadata::ByteRange(receiver_begin, receiver_count),
            receiver_flags), compiler_ir_metadata::CallableOptions(flags, span, header_integer(reader, function, 3),
            header_integer(reader, function, 6), header_integer(reader, function, 7)),
            compiler_ir_metadata::IndexRange(slots, reader.count(11) - slots));
        if (reader.good() && fill && !metadata.ingress_callable(reader.count(10), row)) {
            reader.fail();
        }
        reader.advance(10, 1);
        return cursor;
    }
    auto emit_callables(Reader& reader, compiler_ir_metadata::MetadataStore& metadata, bool fill) -> bool {
        i64 slot = 0;
        bool seeking = true;
        while (seeking && slot < reader.entry_count()) {
            const Entry entry = reader.entry_at(slot);
            seeking = entry.category() < 5;
            if (seeking) {
                slot = slot + 1;
            }
        }
        i64 function = 0;
        while (function < reader.function_count() && reader.good()) {
            slot = emit_callable(reader, metadata, function, slot, fill);
            function = function + 1;
        }
        // The name-sorted callable ID index ends the index rows.
        i64 at = 0;
        while (at < reader.entry_count() && reader.good()) {
            const Entry entry = reader.entry_at(at);
            if (entry.category() == 6) {
                const compiler_ir_metadata::IndexRow row = compiler_ir_metadata::IndexRow(entry.number());
                if (fill && !metadata.ingress_index(reader.count(6), row)) {
                    reader.fail();
                }
                reader.advance(6, 1);
            }
            at = at + 1;
        }
        return reader.begin_instructions();
    }
    auto put_value(Reader& reader, compiler_ir_instructions::InstructionStore& instructions, i64 index, i64 role,
        i64 value) -> bool {
        const compiler_ir_instructions::RawOperandRow row = compiler_ir_instructions::RawOperandRow(role, value, 0u64,
            0, 0);
        if (reader.filling() && !instructions.ingress_operand(index, row)) {
            return reader.fail();
        }
        return reader.good();
    }
    auto put_unsigned(Reader& reader, compiler_ir_instructions::InstructionStore& instructions, i64 index,
        u64 value) -> bool {
        const compiler_ir_instructions::RawOperandRow row = compiler_ir_instructions::RawOperandRow(11, 0, value, 0, 0);
        if (reader.filling() && !instructions.ingress_operand(index, row)) {
            return reader.fail();
        }
        return reader.good();
    }
    auto put_slice(Reader& reader, compiler_ir_instructions::InstructionStore& instructions, i64 index, i64 role,
        i64 begin, i64 count) -> bool {
        const compiler_ir_instructions::RawOperandRow row = compiler_ir_instructions::RawOperandRow(role, 0, 0u64,
            begin, count);
        if (reader.filling() && !instructions.ingress_operand(index, row)) {
            return reader.fail();
        }
        return reader.good();
    }
    // A nested list after the prefix: offsets (width 1), service arguments
    // (width 2) or borrowed roots (width 3). Returns the rows written.
    auto put_list(Reader& reader, compiler_ir_instructions::InstructionStore& instructions, i64 list, i64 width,
        i64 begin, bool fill) -> i64 {
        if (list < 0) {
            return 0;
        }
        const i64 size = reader.items(list, 2);
        i64 at = 0;
        i64 entry = list + 1;
        while (at < size && reader.good()) {
            const i64 base = begin + at * width;
            if (width == 1) {
                const i64 offset = reader.integer(entry);
                put_value(reader, instructions, base, 2, offset);
            } else {
                if (reader.items(entry, 3) != width) {
                    reader.fail();
                }
                if (width == 2) {
                    const i64 loan = reader.integer(reader.item(entry, 0));
                    const i64 service = reader.operation(reader.item(entry, 1), 0);
                    put_value(reader, instructions, base, 79, loan);
                    put_value(reader, instructions, base + 1, 3, service);
                } else {
                    const i64 root = reader.integer(reader.item(entry, 0));
                    const i64 loan = reader.integer(reader.item(entry, 1));
                    const i64 field = reader.integer(reader.item(entry, 2));
                    put_value(reader, instructions, base, 38, root);
                    put_value(reader, instructions, base + 1, 4, loan);
                    put_value(reader, instructions, base + 2, 23, field);
                }
            }
            entry = reader.next(entry);
            at = at + 1;
        }
        return size * width;
    }
    auto type_operand(Reader& reader, compiler_ir_metadata::MetadataStore& metadata,
        compiler_ir_instructions::InstructionStore& instructions, i64 token, i64 index, i64 role) -> bool {
        const i64 position = reader.count(1);
        const bool fill = reader.filling();
        return emit_type(reader, metadata, token, -1, position, fill) && put_value(reader, instructions, index, role,
            position);
    }
    // One instruction line, by its form's codec; omitted trailing operands keep
    // their defaults.
    auto emit_instruction(Reader& reader, compiler_ir_metadata::MetadataStore& metadata,
        compiler_ir_instructions::InstructionStore& instructions, i64 line, bool fill) -> bool {
        const i64 form = reader.form(line);
        const Token codec = reader.codec_at(form);
        const i64 begin = reader.count(13);
        const i64 prefix = codec.extra();
        i64 nested = 0;
        i64 written = 0;
        i64 unary = 0;
        i64 binary = 0;
        i64 comparison = 0;
        i64 query = 0;
        i64 operand = reader.next(line);
        i64 at = 0;
        while (at < codec.count() && reader.good()) {
            const Token field = reader.word_at(codec.first() + at);
            const i64 letter = field.kind();
            const i64 role = field.first();
            const i64 token = operand;
            const bool present = reader.kind(token) != 6;
            i64 value = 0;
            if (present) {
                operand = reader.next(operand);
            }
            const i64 index = begin + written;
            if (letter == i64('i') || letter == i64('j') || letter == i64('b') || letter == i64('m') || letter
                == i64('k') || letter == i64('o')) {
                if (letter == i64('j')) {
                    value = -1;
                }
                if (present && (letter == i64('i') || letter == i64('j') || letter == i64('m'))) {
                    value = reader.integer(token);
                }
                if (present && letter == i64('b')) {
                    value = reader.boolean(token);
                }
                if (present && letter == i64('k')) {
                    value = reader.operation(token, 0);
                }
                if (present && letter == i64('o')) {
                    value = reader.operation(token, 1);
                }
                i64 spelled = role;
                if (letter == i64('m')) {
                    spelled = 28;
                }
                if (letter == i64('k')) {
                    spelled = 3;
                }
                if (letter == i64('o')) {
                    spelled = 5;
                }
                put_value(reader, instructions, index, spelled, value);
                written = written + 1;
            }
            if (letter == i64('t')) {
                i64 type = -1;
                if (present) {
                    type = token;
                }
                type_operand(reader, metadata, instructions, type, index, role);
                written = written + 1;
            }
            if (letter == i64('c') || letter == i64('n')) {
                i64 name = -1;
                if (present && reader.name(token)) {
                    name = token;
                }
                const i64 first = token_text(reader, metadata, name, fill);
                i64 spelled = 100;
                if (letter == i64('n')) {
                    spelled = 101;
                }
                const i64 size = token_size(reader, name);
                put_slice(reader, instructions, index, spelled, first, size);
                written = written + 1;
            }
            if (letter == i64('l') || letter == i64('s') || letter == i64('r')) {
                i64 list = -1;
                if (present) {
                    list = token;
                }
                i64 width = 1;
                i64 spelled = role;
                if (letter == i64('s')) {
                    width = 2;
                    spelled = 9;
                }
                if (letter == i64('r')) {
                    width = 3;
                    spelled = 102;
                }
                const i64 rows = put_list(reader, instructions, list, width, begin + prefix + nested, fill);
                put_slice(reader, instructions, index, spelled, begin + prefix + nested, rows);
                nested = nested + rows;
                written = written + 1;
            }
            if (letter == i64('x')) {
                const i64 literal = reader.count(14);
                i64 size = 0;
                if (present) {
                    const Token bytes = reader.token_at(token);
                    if (bytes.kind() != 1) {
                        reader.fail();
                    }
                    size = bytes.count();
                    i64 byte = 0;
                    while (fill && byte < size && reader.good()) {
                        if (!instructions.ingress_literal(literal + byte, u8(reader.byte_at(bytes.first() + byte)))) {
                            reader.fail();
                        }
                        byte = byte + 1;
                    }
                }
                put_slice(reader, instructions, index, 33, literal, size);
                reader.advance(14, size);
                written = written + 1;
            }
            if (letter == i64('v')) {
                if (present) {
                    value = reader.integer(token);
                }
                const i64 type = operand;
                i64 type_token = -1;
                i64 type_kind = 0;
                if (reader.kind(type) != 6) {
                    operand = reader.next(operand);
                    type_token = type;
                    const compiler_ir_metadata::RawTypeRow parsed = reader.parse_type(type, -1);
                    type_kind = parsed.kind();
                }
                if (type_kind == 7) {
                    put_unsigned(reader, instructions, index, bits(value));
                } else {
                    put_value(reader, instructions, index, 10, value);
                }
                type_operand(reader, metadata, instructions, type_token, index + 1, 12);
                written = written + 2;
            }
            if (present && letter == i64('u')) {
                unary = reader.operation(token, 2);
            }
            if (present && letter == i64('y')) {
                binary = reader.operation(token, 3);
            }
            if (present && letter == i64('p')) {
                comparison = reader.operation(token, 4);
            }
            if (present && letter == i64('q')) {
                query = reader.operation(token, 5);
            }
            at = at + 1;
        }
        if (reader.kind(operand) != 6 || written != prefix) {
            return reader.fail();
        }
        compiler_ir_instructions::RawInstructionRow row = compiler_ir_instructions::RawInstructionRow(1, form, begin,
            prefix);
        row.set_raw_operations(unary, binary, comparison, query);
        const i64 id = reader.count(12);
        const compiler_ir_instructions::CodeRow code = compiler_ir_instructions::CodeRow(id + 1, -1, 0u64, 0);
        if (reader.good() && fill && (!instructions.ingress_instruction(id, row) || !instructions.ingress_code(id,
            code))) {
            reader.fail();
        }
        return reader.advance(12, 1) && reader.set_operands(begin + prefix + nested);
    }
    auto emit_bodies(Reader& reader, compiler_ir_metadata::MetadataStore& metadata,
        compiler_ir_instructions::InstructionStore& instructions, bool fill) -> bool {
        i64 function = 0;
        while (function < reader.function_count() && reader.good()) {
            const i64 begin = reader.count(12);
            i64 line = reader.function_at(function) + 9;
            while (line < reader.function_end(function) && reader.good()) {
                const i64 code = reader.line_at(line);
                const Token end_token = reader.token_at(reader.line_end_token(code));
                reader.at_line(end_token.extra());
                emit_instruction(reader, metadata, instructions, code, fill);
                line = line + 1;
            }
            const i64 size = reader.count(12) - begin;
            const compiler_ir_instructions::BodyRow body = compiler_ir_instructions::BodyRow(begin, size, size, 0);
            if (reader.good() && fill && !instructions.ingress_body(reader.count(15), body)) {
                reader.fail();
            }
            reader.advance(15, 1);
            function = function + 1;
        }
        return reader.good();
    }
    // Measures (fill false) or fills both pending stores, in the order the
    // projection would: classes, descriptors, views, enums, callables with
    // their frames, the callable name index, then every body.
    auto emit(Reader& reader, compiler_ir_metadata::MetadataStore& metadata,
        compiler_ir_instructions::InstructionStore& instructions, bool fill) -> bool {
        return reader.reset(fill) && emit_classes(reader, metadata, fill) && emit_tables(reader, metadata, fill)
            && emit_callables(reader, metadata, fill) && emit_bodies(reader, metadata, instructions, fill);
    }
    // The metadata name at a sorted position: 0 classes, 1 enums, 2 the callable name index.
    auto sorted_name(const compiler_ir_metadata::MetadataStore& metadata, i64 category,
        i64 position) -> compiler_ir_metadata::ByteRange {
        if (category == 0) {
            const compiler_ir_metadata::ClassRow row = metadata.class_at(position);
            return row.name();
        }
        if (category == 1) {
            const compiler_ir_metadata::EnumRow row = metadata.enum_at(position);
            return row.name();
        }
        const compiler_ir_metadata::IndexRow id = metadata.index_at(metadata.input_index_count()
            - metadata.callable_count() + position);
        const compiler_ir_metadata::CallableRow row = metadata.callable_at(id.value());
        return row.name();
    }
    // Compares the sorted metadata name at position with reader text [first, first + count).
    auto compare_symbol(const Reader& reader, const compiler_ir_metadata::MetadataStore& metadata, i64 category,
        i64 position, i64 first, i64 count) -> i64 {
        const compiler_ir_metadata::ByteRange name = sorted_name(metadata, category, position);
        i64 at = 0;
        while (at < name.count() && at < count) {
            const i64 left = metadata.byte_at(name.begin() + at);
            const i64 right = reader.byte_at(first + at);
            if (left < right) {
                return -1;
            }
            if (left > right) {
                return 1;
            }
            at = at + 1;
        }
        if (name.count() < count) {
            return -1;
        }
        if (name.count() > count) {
            return 1;
        }
        return 0;
    }
    // The first sorted position spelled by reader text [first, first + count), or -1.
    auto symbol_position(const Reader& reader, const compiler_ir_metadata::MetadataStore& metadata, i64 category,
        i64 first, i64 count) -> i64 {
        i64 size = metadata.callable_count();
        if (category == 0) {
            size = metadata.class_count();
        }
        if (category == 1) {
            size = metadata.enum_count();
        }
        i64 low = 0;
        i64 high = size;
        while (low < high) {
            const i64 middle = low + (high - low) / 2;
            if (compare_symbol(reader, metadata, category, middle, first, count) < 0) {
                low = middle + 1;
            } else {
                high = middle;
            }
        }
        if (low < size && compare_symbol(reader, metadata, category, low, first, count) == 0) {
            return low;
        }
        return -1;
    }
    // ABI declarations ("function|record|enum SYMBOL SOURCE-NAME [MEMBER...]")
    // in category and metadata name order, as the source pipeline gathers them.
    auto declare(Reader& reader, const compiler_ir_metadata::MetadataStore& metadata,
        compiler_pipeline::Declarations& declarations) -> bool {
        i64 category = 0;
        while (category < 3 && reader.good() && declarations.ok()) {
            i64 at = reader.abi_begin();
            while (at < reader.token_count() && reader.good()) {
                const i64 stop = reader.line_end_token(at);
                const bool selected = (category == 0 && reader.is(at, "record")) || (category == 1 && reader.is(at,
                    "enum")) || (category == 2 && reader.is(at, "function"));
                if (selected && reader.nodes(at) < 3) {
                    return reader.fail();
                }
                if (selected) {
                    const Token symbol = reader.token_at(reader.node(at, 1));
                    const i64 key = symbol_position(reader, metadata, category, symbol.first(), symbol.count());
                    if (key < 0 && category != 2) {
                        return reader.fail();
                    }
                    if (key >= 0 && !declarations.push(at, key)) {
                        return reader.fail();
                    }
                }
                at = stop + 1;
            }
            declarations.sort_work();
            i64 last = -1;
            i64 item = 0;
            while (item < declarations.work_count() && reader.good()) {
                const compiler_pipeline::Declared declared = declarations.work_at(item);
                const i64 line = declared.symbol();
                if (declared.key() > last) {
                    const i64 identity = compiler_pipeline::identity(metadata, category, declared.key());
                    i64 member = -1;
                    i64 field = 2;
                    while (field < reader.nodes(line) && (category != 2 || field == 2)) {
                        const Token spelled = reader.token_at(reader.node(line, field));
                        const i64 begin = declarations.text_size();
                        i64 byte = 0;
                        while (byte < spelled.count()) {
                            declarations.byte(u8(reader.byte_at(spelled.first() + byte)));
                            byte = byte + 1;
                        }
                        declarations.row(category, identity, member, begin);
                        member = member + 1;
                        field = field + 1;
                    }
                    last = declared.key();
                }
                item = item + 1;
            }
            declarations.clear_work();
            category = category + 1;
        }
        return reader.good() && declarations.ok();
    }
    // A reader holding the spellings, ready to load one module.
    auto start(builtin::ByteRegion region) -> Reader {
        Reader reader = create(region);
        compiler_ir_listing::Listing table = compiler_ir_listing::create(region);
        const bool spelled = table.ok() && compiler_ir_listing::spellings(table) && table.byte(' ') && codec(table)
            && enumerators(table) && keywords(table);
        if (!spelled || !reader.allocated() || !reader.load_words(table.view())) {
            reader.fail();
        }
        return move(reader);
    }
    // Reads one module and its ABI declaration lines.
    auto read_module(Reader& reader, builtin::span<const u8> source, builtin::span<const u8> abi) -> bool {
        return reader.load(source) && reader.load_abi(abi) && reader.structure();
    }
    // Measures the pending stores; the first source line the reader rejects, or 0.
    auto check(builtin::ByteRegion region, Reader reader) -> compiler_ir_metadata::IndexRow {
        i64 line = reader.failed_line();
        if (reader.good()) {
            compiler_ir_metadata::MetadataStore empty_metadata = compiler_ir_metadata::create(region);
            empty_metadata.initialize(compiler_pipeline::zero_counts(), 0, 0, 0);
            compiler_ir_instructions::InstructionStore empty_instructions = compiler_ir_instructions::create(region, 0,
                0, 0, 0);
            line = 0;
            if (!emit(reader, empty_metadata, empty_instructions, false)) {
                line = reader.failed_line();
            }
        }
        const compiler_ir_metadata::IndexRow result = compiler_ir_metadata::IndexRow(line);
        return result;
    }
    // The module's metadata alone, measured and filled for source admission.
    auto metadata(builtin::ByteRegion region, Reader input) -> compiler_ir_metadata::MetadataStore {
        Reader reader = move(input);
        compiler_ir_metadata::MetadataStore result = compiler_ir_metadata::create(region);
        compiler_ir_metadata::MetadataStore empty_metadata = compiler_ir_metadata::create(region);
        empty_metadata.initialize(compiler_pipeline::zero_counts(), 0, 0, 0);
        compiler_ir_instructions::InstructionStore empty_instructions = compiler_ir_instructions::create(region, 0, 0,
            0, 0);
        bool filled = false;
        if (reader.good() && emit(reader, empty_metadata, empty_instructions, false)
            && result.initialize(reader.input_counts(), reader.count(10), reader.count(11),
            reader.instruction_begin())) {
            compiler_ir_instructions::InstructionStore instructions = compiler_ir_instructions::create(region,
                reader.count(12), reader.count(13), reader.count(14), reader.count(15));
            filled = instructions.allocated() && emit(reader, result, instructions, true);
        }
        if (!filled && result.status() == compiler_ir_metadata::MetadataStatus::pending) {
            result.reject(compiler_ir_metadata::MetadataError::integrity);
        }
        return move(result);
    }
    // One read module through the compiler's own pipeline stages. A module the
    // reader rejects stops at Stage::projection; check() names its line.
    auto run(builtin::ByteRegion region, Reader input, u64 options) -> compiler_pipeline::Result {
        Reader reader = move(input);
        compiler_pipeline::Result result = compiler_pipeline::create(region);
        compiler_pipeline::Declarations declarations = compiler_pipeline::Declarations(region);
        if (!result.allocated() || !declarations.ok() || !reader.allocated()) {
            result.stop(compiler_pipeline::Stage::allocation);
            return move(result);
        }
        if (!reader.good()) {
            result.stop(compiler_pipeline::Stage::projection);
            return move(result);
        }
        compiler_ir_metadata::MetadataStore empty_metadata = compiler_ir_metadata::create(region);
        empty_metadata.initialize(compiler_pipeline::zero_counts(), 0, 0, 0);
        compiler_ir_instructions::InstructionStore empty_instructions = compiler_ir_instructions::create(region, 0, 0,
            0, 0);
        const bool measured = emit(reader, empty_metadata, empty_instructions, false);
        compiler_ir_metadata::release(region, move(empty_metadata));
        compiler_ir_instructions::release(region, move(empty_instructions));
        if (!measured) {
            result.stop(compiler_pipeline::Stage::projection);
            return move(result);
        }
        compiler_ir_metadata::MetadataStore metadata = compiler_ir_metadata::create(region);
        const bool initialized = metadata.initialize(reader.input_counts(), reader.count(10), reader.count(11),
            reader.instruction_begin());
        if (!initialized && metadata.status() != compiler_ir_metadata::MetadataStatus::allocation) {
            result.stop(compiler_pipeline::Stage::metadata_transport);
            return move(result);
        }
        if (!metadata.allocated()) {
            result.stop(compiler_pipeline::Stage::metadata_allocation);
            return move(result);
        }
        compiler_ir_instructions::InstructionStore instructions = compiler_ir_instructions::create(region,
            reader.count(12), reader.count(13), reader.count(14), reader.count(15));
        if (!instructions.allocated()) {
            result.stop(compiler_pipeline::Stage::instruction_allocation);
            return move(result);
        }
        if (!emit(reader, metadata, instructions, true)) {
            result.stop(compiler_pipeline::Stage::projection);
            return move(result);
        }
        if (!compiler_pipeline::admit_metadata(result, metadata)) {
            return move(result);
        }
        if (compiler_pipeline::selected(options, compiler_pipeline::abi_option()) && !declare(reader, metadata,
            declarations)) {
            result.stop(compiler_pipeline::Stage::declarations);
            return move(result);
        }
        release(region, move(reader));
        compiler_pipeline::Result finished = compiler_pipeline::stages(region, move(result), move(metadata),
            move(instructions), move(declarations), options);
        return move(finished);
    }
}
