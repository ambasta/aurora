                            expand_template(at, item_end, copy_index);
                            copy_index = copy_index + 1;
                        }
                        if (!braces) {
                            copy(at, last);
                        }
                        at = last;
                        plain = false;
                    } else {
                        if (item_end > at && value != '[' && value != '(') {
                            copy(at, item_end);
                            at = item_end;
                            plain = false;
                        }
                    }
