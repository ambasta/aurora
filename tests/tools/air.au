        auto word_token(i64 begin, i64 end, bool templated) -> i64 {
            i64 at = begin;
            bool braces = false;
            if (text.at(at) == '"') {
                at = string_token(at, end);
                const Token decoded = token_at(tokenSize - 1);
                i64 scan = 0;
                while (templated && scan < decoded.count()) {
                    if (text.at(decoded.first() + scan) == '{') {
                        braces = true;
                    }
                    scan = scan + 1;
                }
            } else {
                while (at < end && !delimiter(i64(text.at(at)))) {
                    if (text.at(at) == '{') {
                        braces = true;
                    }
                    at = at + 1;
                }
                const Token word = Token(0, begin, at - begin, 0);
                add_token(word);
            }
            if (templated && braces) {
                const Token spelled = token_at(tokenSize - 1);
                const Token marked = Token(spelled.kind(), spelled.first(), spelled.count(), -1);
                set_token(tokenSize - 1, marked);
            }
            const i64 after = skip_space(at, end);
            if (good() && after < end && text.at(after) == '=') {
                const Token key = token_at(tokenSize - 1);
                const Token marked = Token(5, key.first(), key.count(), key.kind());
                set_token(tokenSize - 1, marked);
                at = skip_space(after + 1, end);
                if (at >= end || text.at(at) == ']' || text.at(at) == ')' || text.at(at) == '=' || text.at(at) == '*'
