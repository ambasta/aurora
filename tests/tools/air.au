        auto tokenize(i64 begin, i64 end, i64 line, bool templated) -> bool {
            clear_stack();
            i64 item = -1;
            bool keyed = false;
            i64 at = skip_space(begin, end);
            while (at < end && good()) {
                const u8 value = text.at(at);
                if (value == ';') {
                    at = end;
                } else {
                    if (value == '[' || value == '(') {
                        if (!keyed) {
                            item = tokenSize;
                        }
                        keyed = false;
                        push(item);
                        open_bracket(at, value);
                        item = -1;
                        at = at + 1;
                    } else {
                        if (value == ']' || value == ')') {
                            close_bracket(at, value);
                            item = pop();
                            at = at + 1;
                        } else {
                            if (value == '*') {
                                at = repeat_item(at, end, item);
                            } else {
                                if (value == '=') {
                                    return fail();
                                }
                                if (!keyed) {
                                    item = tokenSize;
                                }
                                at = word_token(at, end, templated);
                                keyed = kind(tokenSize - 1) == 5;
                            }
                        }
                    }
                    at = skip_space(at, end);
                }
            }
            if (stackSize != 0) {
                return fail();
            }
            const Token stop = Token(6, 0, 0, line);
            return add_token(stop);
