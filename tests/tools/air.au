            if (escape == 't') {
                return 9;
            }
            if (escape == '"' || escape == '\\') {
                return i64(escape);
            }
            return -1;
        }
        // A quoted string decoded at the end of text as a string token; the
        // position after its closing quote.
        auto string_token(i64 begin, i64 end) -> i64 {
            const i64 first = textSize;
            i64 at = begin + 1;
            bool open = true;
            while (open && good()) {
                if (at >= end) {
                    fail();
                    return end;
                }
                const u8 value = text.at(at);
                at = at + 1;
                if (value == '"') {
                    open = false;
                }
                if (open && value != '\\') {
                    put(value);
                }
                if (open && value == '\\') {
                    if (at >= end) {
                        fail();
                        return end;
                    }
                    const u8 escape = text.at(at);
                    at = at + 1;
                    const i64 simple = escaped(escape);
                    if (simple >= 0) {
                        put(u8(simple));
                    } else {
                        if (escape != 'x' || at + 2 > end || hex_value(i64(text.at(at))) < 0 || hex_value(i64(text.at(at
                            + 1))) < 0) {
                            fail();
                            return end;
                        }
                        put(u8(hex_value(i64(text.at(at))) * 16 + hex_value(i64(text.at(at + 1)))));
                        at = at + 2;
                    }
                }
            }
            const Token value = Token(1, first, textSize - first, 0);
            add_token(value);
            return at;
        }
        auto open_bracket(i64 at, u8 value) -> bool {
            i64 bracket = 2;
            if (value == '(') {
                bracket = 3;
            }
            const Token open = Token(bracket, at, 1, -1);
            return push(tokenSize) && add_token(open);
        }
        auto close_bracket(i64 at, u8 value) -> bool {
            const i64 opened = pop();
            const Token open = token_at(opened);
            if (opened < 0 || (value == ']' && open.kind() != 2) || (value == ')' && open.kind() != 3)) {
                return fail();
            }
            const Token closed = Token(open.kind(), open.first(), 1, tokenSize);
            const Token close = Token(4, at, 1, opened);
            return set_token(opened, closed) && add_token(close);
        }
        // A word or string node, a key when '=' follows; the position after it.
