export module aurora.tests.air;
import aurora.compiler.lexer;
import aurora.compiler.syntax_arena;
import aurora.compiler.resolution_kinds;
import aurora.compiler.resolution_rows;
import aurora.compiler.lowering_errors;
import aurora.compiler.lowering_kinds;
import aurora.compiler.lowering_storage;
import aurora.compiler.resolution_arena;
import aurora.compiler.ir_graph;
import aurora.compiler.ir_metadata_storage;
import aurora.compiler.ir_metadata;
import aurora.compiler.ir_instruction_storage;
import aurora.compiler.ir_instructions;
import aurora.compiler.ir_verification_errors;
import aurora.compiler.ir_verification_storage;
import aurora.compiler.x86_object_storage;
import aurora.compiler.x86_storage;
import aurora.compiler.ir_listing;
import aurora.compiler.pipeline_declarations;
import aurora.compiler.pipeline;
import aurora.compiler.diagnostics;

// Textual IR (.air) modules, read straight into the pending metadata and
// instruction stores lowering's projection fills, then run through the
// compiler's own admission, verification, call graph, publication and
// emission (compiler_pipeline::stages). The format is described in
// tests/compiler/ir/README.md. The reader checks syntax only: hostile values
// reach source admission unchanged, so malformed modules can be written down.
export namespace compiler_air {
    // Token kinds: 0 word, 1 decoded string, 2 '[', 3 '(', 4 closing bracket,
    // 5 a key (its value is the next node), 6 end of line. Extra: an opening
    // bracket's closing token and a closing bracket's opening one; an end of
    // line's source line; a key's own kind; a word's cached line code or type
    // kind plus one, or -1 for an {a,s} spelling in a repeat block.
    class Token {
        i64 kindValue;
        i64 firstValue;
        i64 countValue;
        i64 extraValue;
    public:
        Token(i64 kind, i64 first, i64 count, i64 extra) : kindValue(kind), firstValue(first), countValue(count),
            extraValue(extra) {
        }
        auto kind() const -> i64 {
            return kindValue;
        }
        auto first() const -> i64 {
            return firstValue;
        }
        auto count() const -> i64 {
            return countValue;
        }
        auto extra() const -> i64 {
            return extraValue;
        }
    };
    // A sortable declaration. Categories: 0 class declarations (number: layout,
    // fields, storage, carrier), 1 descriptors, 2 views, 3 visible descriptor
    // IDs (group: scope), 4 enums, 5 frame slots (group: function * 16 + slot
    // ordinal), 6 the callable name index (sequence: callable ID).
    class Entry {
        i64 categoryValue;
        i64 groupValue;
        i64 nameValue;
        i64 numberValue;
        i64 sequenceValue;
        i64 tokenValue;
    public:
        Entry(i64 category, i64 group, i64 name, i64 number, i64 sequence, i64 token) : categoryValue(category),
            groupValue(group), nameValue(name), numberValue(number), sequenceValue(sequence), tokenValue(token) {
        }
        auto category() const -> i64 {
            return categoryValue;
        }
        auto group() const -> i64 {
            return groupValue;
        }
        auto name() const -> i64 {
            return nameValue;
        }
        auto number() const -> i64 {
            return numberValue;
        }
        auto sequence() const -> i64 {
            return sequenceValue;
        }
        auto token() const -> i64 {
            return tokenValue;
        }
    };
    auto token_pool(builtin::ByteRegion region) -> builtin::OwnedValues<Token> {
        const Token fill = Token(-1, 0, 0, 0);
        builtin::OwnedValues<Token> result = region.try_allocate(0, fill);
        return move(result);
    }
    auto entry_pool(builtin::ByteRegion region) -> builtin::OwnedValues<Entry> {
        const Entry fill = Entry(-1, 0, -1, 0, 0, -1);
        builtin::OwnedValues<Entry> result = region.try_allocate(0, fill);
        return move(result);
    }
    auto index_pool(builtin::ByteRegion region) -> builtin::OwnedValues<compiler_ir_metadata::IndexRow> {
        const compiler_ir_metadata::IndexRow fill = compiler_ir_metadata::IndexRow(-1);
        builtin::OwnedValues<compiler_ir_metadata::IndexRow> result = region.try_allocate(0, fill);
        return move(result);
    }
    auto grown(i64 size) -> i64 {
        if (size < 64) {
            return 64;
        }
        return size * 2;
    }
    // The two's-complement bits of a signed constant, for unsigned payloads.
    auto bits(i64 value) -> u64 {
        if (value >= 0) {
            return u64(value);
        }
        return u64(value + 9223372036854775807 + 1) + 9223372036854775808u64;
    }
    auto space(i64 value) -> bool {
        return value == 32 || value == 9 || value == 13;
    }
    // Bytes that end a word: space, tab, CR, brackets, quote, ';', '=' and '*'.
    auto delimiter(i64 value) -> bool {
        return space(value) || value == i64('[') || value == i64(']') || value == i64('(') || value == i64(')') || value
            == i64('"') || value == i64(';') || value == i64('=') || value == i64('*');
    }
    auto digit(i64 value) -> bool {
        return value >= i64('0') && value <= i64('9');
    }
    auto hex_value(i64 value) -> i64 {
        if (digit(value)) {
            return value - 48;
        }
        if (value >= i64('a') && value <= i64('f')) {
            return value - 87;
        }
        if (value >= i64('A') && value <= i64('F')) {
            return value - 55;
        }
        return -1;
    }
    // Every operand of each instruction form, in compiler_lowering::InstructionForm
    // order. i/j: integer (j defaults to -1), b: boolean, t: type, l: offset
    // list, each with its compiler_lowering::OperandRole ordinal; c: callee,
    // n: class name, m: module scope, k: service kind, o: service operation,
    // s: service arguments, r: borrowed roots, x: literal bytes, v: typed
    // constant, u/y/p/q: unary, binary, comparison or query operation.
    auto codec(compiler_ir_listing::Listing& out) -> bool {
        return out.word("i1,i2,k i4,i2,k i4,k i2,o,i6,k c,i4,i6,l8,k,s,l21,i34 v t12,i13 i2,t12 i2,t12 - - u,t14 ")
            && out.word("y,t14 t15,t16 p,t14 i2,i17,t18 i2,i17,t18 i2,i17,t18 i19,t20 c c,l21,i6,l8 i2 i2 i2 ")
            && out.word("i22,i6 i22,i23,i6 i24,i23,i22 i24,i23,i22 i24,i23,l25 i24,i23 i24,i23,i6 i24,i23,i22 ")
            && out.word("i23,t12 i23,t12 i23 i23 i23 i23 c,i26,l21,i6,j27,l8 q,m i29 i30 i30 - i2 i1,i2,t12 ")
            && out.word("i1,i2,n i2 i2 i32,i6 i23,i6 x,i6 i2,i23,i6 i2 i22,i6 i22,i6 i2 i2 i2 i1,i2 i2 i34,i6 ")
            && out.word("i34,i6,i35 i2,i23,i6 i2,i23,i36 i2,i23,i35 i22,i6 i2,j23 i2,j23 i2,j23 i2,j23 i2,j23 i2 ")
            && out.word("i1,i2 i1,i2 c,i34,l37,i6,i26 i2 i24,i23,i22 i22,i6 i1,i2,n i2 i4,i38,b39,j23 i4 ")
            && out.word("c,r,l21,i6,l8 i2,i6 ");
    }
    // Enumerator spellings: service kinds, service operations, then the unary,
    // binary, comparison and query operations.
    auto enumerators(compiler_ir_listing::Listing& out) -> bool {
        return out.word("Console Display IommuEvent Call Port Serve ")
            && out.word("Next Put Pixel IommuPoll IommuAcknowledge Call PortRead8 PortWrite8 ServeExchange ")
            && out.word("CheckedNegate LogicalNot BitNot ")
            && out.word("CheckedAdd CheckedSubtract CheckedMultiply CheckedDivide CheckedRemainder BitAnd BitOr ")
            && out.word("BitXor ShiftLeft ShiftRight Equal NotEqual Less Greater LessEqual GreaterEqual ")
            && out.word("Size PublicFieldCount ");
    }
    // Line keywords: end, the function header fields, the frame slot kinds, then
    // the module declarations. A line's code is its form, or 85 + its keyword.
    auto keywords(compiler_ir_listing::Listing& out) -> bool {
        return out.word("end result params frame scope receiver roots rootmut spanfield ")
            && out.word("slot object array span service region bytes values spanvalues ")
            && out.word("function layout fields storage carrier descriptor views enum ");
    }
    // The first word of each enumeration in enumerators() and its size.
    auto enumeration_first(i64 table) -> i64 {
        if (table == 0) {
            return 0;
        }
        if (table == 1) {
            return 6;
        }
        if (table == 2) {
            return 15;
        }
        if (table == 3) {
            return 18;
        }
        if (table == 4) {
            return 28;
        }
        return 34;
    }
    auto enumeration_size(i64 table) -> i64 {
        if (table == 0) {
            return 6;
        }
        if (table == 1) {
            return 9;
        }
        if (table == 2) {
            return 3;
        }
        if (table == 3) {
            return 10;
        }
        if (table == 4) {
            return 6;
        }
        return 2;
    }

    class Reader {
        builtin::OwnedBytes text;
        builtin::OwnedValues<Token> tokens;
        builtin::OwnedValues<Entry> entries;
        builtin::OwnedValues<Entry> grouped;
        // Per function: its name token, then the lines of result, params, frame,
        // scope, receiver, roots, rootmut and spanfield (or -1), then its code lines.
        builtin::OwnedValues<compiler_ir_metadata::IndexRow> lines;
        builtin::OwnedValues<compiler_ir_metadata::IndexRow> functions;
        // The tokenizer's open brackets, and the list nesting of item expansion.
        builtin::OwnedValues<compiler_ir_metadata::IndexRow> stack;
        // Spellings: words 0..84 forms, 85..106 type kinds, 107..191 codecs
        // (compiled: their fields follow the sorted line words), 192..227
        // enumerators, 228..253 line keywords, 254..364 forms and keywords in
        // name order (extra: the line code), then the codec fields.
        builtin::OwnedValues<Token> words;
        i64 textSize;
        i64 tokenSize;
        i64 entrySize;
        i64 lineSize;
        i64 functionSize;
        i64 stackSize;
        i64 wordSize;
        i64 abiTokens;
        i64 viewsLine;
        i64 sourceLine;
        i64 failedLine;
        bool valid;
        // Positions of the store being measured or filled.
        i64 byteCount;
        i64 typeCount;
        i64 classCount;
        i64 fieldCount;
        i64 leafCount;
        i64 storageCount;
        i64 indexCount;
        i64 descriptorCount;
        i64 viewCount;
        i64 enumCount;
        i64 callableCount;
        i64 slotCount;
        i64 instructionBegin;
        i64 instructionCount;
        i64 operandCount;
        i64 literalCount;
        i64 bodyCount;
        bool fillingValue;
    public:
        Reader(builtin::ByteRegion region) : text(region.try_allocate(0)), tokens(token_pool(region)),
            entries(entry_pool(region)), grouped(entry_pool(region)), lines(index_pool(region)),
            functions(index_pool(region)), stack(index_pool(region)), words(token_pool(region)), textSize(0),
            tokenSize(0), entrySize(0), lineSize(0), functionSize(0), stackSize(0), wordSize(0), abiTokens(0),
            viewsLine(-1), sourceLine(0), failedLine(0), valid(true), byteCount(0), typeCount(0), classCount(0),
            fieldCount(0), leafCount(0), storageCount(0), indexCount(0), descriptorCount(0), viewCount(0), enumCount(0),
            callableCount(0), slotCount(0), instructionBegin(0), instructionCount(0), operandCount(0), literalCount(0),
            bodyCount(0), fillingValue(false) {
        }
        auto filling() const -> bool {
            return fillingValue;
        }
        auto allocated() const -> bool {
            return text.ok() && tokens.ok() && entries.ok() && grouped.ok() && lines.ok() && functions.ok()
                && stack.ok() && words.ok();
        }
        // Owners stay allocated after start: every failed growth fails the reader.
        auto good() const -> bool {
            return valid;
        }
        // Sticky: the first failure keeps its source line.
        auto fail() -> bool {
            if (valid) {
                failedLine = sourceLine;
                if (failedLine < 1) {
                    failedLine = 1;
                }
            }
            valid = false;
            return false;
        }
        auto failed_line() const -> i64 {
            return failedLine;
        }
        auto at_line(i64 line) -> bool {
            sourceLine = line;
            return good();
        }
        // Later failures name the source line holding token.
        auto at_token(i64 token) -> bool {
            if (token < 0) {
                return good();
            }
            const Token end_token = token_at(line_end_token(token));
            return at_line(end_token.extra());
        }

        // ---- owned pools
        auto put(u8 value) -> bool {
            if (!good()) {
                return false;
            }
            if (textSize == text.size() && !text.try_resize(grown(textSize))) {
                return fail();
            }
            text.set(textSize, value);
            textSize = textSize + 1;
            return true;
        }
        auto put_text(builtin::span<const u8> value) -> bool {
            i64 at = 0;
            while (at < value.size()) {
                if (!put(value.at(at))) {
                    return false;
                }
                at = at + 1;
            }
            return good();
        }
        auto copy(i64 begin, i64 end) -> bool {
            i64 at = begin;
            while (at < end) {
                if (!put(text.at(at))) {
                    return false;
                }
                at = at + 1;
            }
            return good();
        }
        auto put_number(i64 value) -> bool {
            if (value < 0) {
                if (!put('-')) {
                    return false;
                }
                const u64 magnitude = u64(-(value + 1)) + 1u64;
                return put_natural(magnitude);
            }
            return put_natural(u64(value));
        }
        auto put_natural(u64 value) -> bool {
            u64 place = 1u64;
            while (value / place >= 10u64) {
                place = place * 10u64;
            }
            while (place > 0u64) {
                if (!put(u8(48u64 + value / place % 10u64))) {
                    return false;
                }
                place = place / 10u64;
            }
            return true;
        }
        auto byte_at(i64 at) const -> i64 {
            if (at < 0 || at >= textSize) {
                return -1;
            }
            return i64(text.at(at));
        }
        auto text_size() const -> i64 {
            return textSize;
        }
        auto view(i64 first, i64 count) const -> builtin::span<const u8> {
            const builtin::span<const u8> all = borrow_bytes(text);
            if (first < 0 || count < 0 || first > textSize || count > textSize - first) {
                const builtin::span<const u8> empty = all.subspan(0, 0);
                return empty;
            }
            const builtin::span<const u8> result = all.subspan(first, count);
            return result;
        }
        auto add_token(Token value) -> bool {
            if (!good()) {
                return false;
            }
            if (tokenSize == tokens.size()) {
                const Token fill = Token(-1, 0, 0, 0);
                if (!tokens.try_resize(grown(tokenSize), fill)) {
                    return fail();
                }
            }
            tokens.set(tokenSize, value);
            tokenSize = tokenSize + 1;
            return true;
        }
        auto set_token(i64 index, Token value) -> bool {
            if (index < 0 || index >= tokenSize) {
                return fail();
            }
            tokens.set(index, value);
            return good();
        }
        auto token_at(i64 index) const -> Token {
            if (index < 0 || index >= tokenSize) {
                const Token invalid = Token(6, 0, 0, 0);
                return invalid;
            }
            const Token result = tokens.at(index);
            return result;
        }
        auto token_count() const -> i64 {
            return tokenSize;
        }
        auto kind(i64 index) const -> i64 {
            const Token value = token_at(index);
            return value.kind();
        }
        auto add_entry(i64 category, i64 group, i64 name, i64 number, i64 token) -> bool {
            if (!good()) {
                return false;
            }
            if (entrySize == entries.size()) {
                const Entry fill = Entry(-1, 0, -1, 0, 0, -1);
                if (!entries.try_resize(grown(entrySize), fill)) {
                    return fail();
                }
            }
            const Entry value = Entry(category, group, name, number, entrySize, token);
            entries.set(entrySize, value);
            entrySize = entrySize + 1;
            return true;
        }
        auto entry_at(i64 index) const -> Entry {
            const Entry result = entries.at(index);
            return result;
        }
        auto entry_count() const -> i64 {
            return entrySize;
        }
        auto add_line(i64 value) -> bool {
            if (!good()) {
                return false;
            }
            if (lineSize == lines.size()) {
                const compiler_ir_metadata::IndexRow fill = compiler_ir_metadata::IndexRow(-1);
                if (!lines.try_resize(grown(lineSize), fill)) {
                    return fail();
                }
            }
            const compiler_ir_metadata::IndexRow row = compiler_ir_metadata::IndexRow(value);
            lines.set(lineSize, row);
            lineSize = lineSize + 1;
            return true;
        }
        auto set_line(i64 index, i64 value) -> bool {
            if (index < 0 || index >= lineSize) {
                return fail();
            }
            const compiler_ir_metadata::IndexRow row = compiler_ir_metadata::IndexRow(value);
            lines.set(index, row);
            return good();
        }
        auto line_at(i64 index) const -> i64 {
            if (index < 0 || index >= lineSize) {
                return -1;
            }
            const compiler_ir_metadata::IndexRow row = lines.at(index);
            return row.value();
        }
        auto add_function() -> bool {
            if (!good()) {
                return false;
            }
            if (functionSize == functions.size()) {
                const compiler_ir_metadata::IndexRow fill = compiler_ir_metadata::IndexRow(-1);
                if (!functions.try_resize(grown(functionSize), fill)) {
                    return fail();
                }
            }
            const compiler_ir_metadata::IndexRow row = compiler_ir_metadata::IndexRow(lineSize);
            functions.set(functionSize, row);
            functionSize = functionSize + 1;
            return true;
        }
        auto function_count() const -> i64 {
            return functionSize;
        }
        // The first lines index of a function's header.
        auto function_at(i64 index) const -> i64 {
            const compiler_ir_metadata::IndexRow row = functions.at(index);
            return row.value();
        }
        auto function_end(i64 index) const -> i64 {
            if (index + 1 >= functionSize) {
                return lineSize;
            }
            return function_at(index + 1);
        }
        auto push(i64 value) -> bool {
            if (!good()) {
                return false;
            }
            if (stackSize == stack.size()) {
                const compiler_ir_metadata::IndexRow fill = compiler_ir_metadata::IndexRow(-1);
                if (!stack.try_resize(grown(stackSize), fill)) {
                    return fail();
                }
            }
            const compiler_ir_metadata::IndexRow row = compiler_ir_metadata::IndexRow(value);
            stack.set(stackSize, row);
            stackSize = stackSize + 1;
            return true;
        }
        auto pop() -> i64 {
            if (stackSize == 0) {
                fail();
                return -1;
            }
            stackSize = stackSize - 1;
            const compiler_ir_metadata::IndexRow row = stack.at(stackSize);
            return row.value();
        }
        auto top() const -> i64 {
            if (stackSize == 0) {
                return -1;
            }
            const compiler_ir_metadata::IndexRow row = stack.at(stackSize - 1);
            return row.value();
        }
        auto clear_stack() -> bool {
            stackSize = 0;
            return good();
        }

        // ---- spellings
        // Splits text [begin, textSize) at spaces into words.
        auto add_words(i64 begin) -> bool {
            i64 at = begin;
            while (at < textSize) {
                const i64 first = at;
                while (at < textSize && text.at(at) != ' ') {
                    at = at + 1;
                }
                if (at > first) {
                    if (wordSize == words.size()) {
                        const Token fill = Token(-1, 0, 0, 0);
                        if (!words.try_resize(grown(wordSize), fill)) {
                            return fail();
                        }
                    }
                    const Token value = Token(0, first, at - first, 0);
                    words.set(wordSize, value);
                    wordSize = wordSize + 1;
                }
                at = at + 1;
            }
            return good();
        }
        auto word_at(i64 index) const -> Token {
            if (index < 0 || index >= wordSize) {
                const Token invalid = Token(-1, 0, 0, 0);
                return invalid;
            }
            const Token result = words.at(index);
            return result;
        }
        auto words_ready() const -> bool {
            return wordSize == 254;
        }
        // A word or key spelled exactly expected.
        auto is(i64 token, builtin::span<const u8> expected) const -> bool {
            const Token value = token_at(token);
            if ((value.kind() != 0 && value.kind() != 5) || value.count() != expected.size()) {
                return false;
            }
            i64 at = 0;
            while (at < value.count()) {
                if (text.at(value.first() + at) != expected.at(at)) {
                    return false;
                }
                at = at + 1;
            }
            return true;
        }
        // The word index in [first, first + count) spelled by token, or -1.
        auto lookup(i64 token, i64 first, i64 count) const -> i64 {
            const Token spelled = token_at(token);
            if (spelled.kind() != 0 && spelled.kind() != 1) {
                return -1;
            }
            i64 at = 0;
            while (at < count) {
                const Token value = word_at(first + at);
                if (value.count() == spelled.count() && compare_text(value.first(), value.count(), spelled.first(),
                    spelled.count()) == 0) {
                    return at;
                }
                at = at + 1;
            }
            return -1;
        }
        // Bytewise order of two text ranges.
        auto compare_text(i64 left, i64 left_count, i64 right, i64 right_count) const -> i64 {
            const builtin::span<const u8> all = borrow_bytes(text);
            i64 at = 0;
            while (at < left_count && at < right_count) {
                const u8 x = all.at(left + at);
                const u8 y = all.at(right + at);
                if (x < y) {
                    return -1;
                }
                if (x > y) {
                    return 1;
                }
                at = at + 1;
            }
            if (left_count < right_count) {
                return -1;
            }
            if (left_count > right_count) {
                return 1;
            }
            return 0;
        }
        // Forms and line keywords in name order follow the other words; extra
        // is the line code.
        auto sort_forms() -> bool {
            i64 form = 0;
            while (form < 85 + 26 && good()) {
                i64 spelled = form;
                if (form >= 85) {
                    spelled = 228 + form - 85;
                }
                const Token value = word_at(spelled);
                const Token sorted = Token(0, value.first(), value.count(), form);
                if (wordSize == words.size()) {
                    const Token fill = Token(-1, 0, 0, 0);
                    if (!words.try_resize(grown(wordSize), fill)) {
                        return fail();
                    }
                }
                i64 at = wordSize;
                bool shifting = true;
                while (shifting && at > 254) {
                    const Token previous = words.at(at - 1);
                    shifting = compare_text(previous.first(), previous.count(), value.first(), value.count()) > 0;
                    if (shifting) {
                        words.set(at, previous);
                        at = at - 1;
                    }
                }
                words.set(at, sorted);
                wordSize = wordSize + 1;
                form = form + 1;
            }
            return good();
        }
        // A line's form or 85 + its keyword (see keywords()), or -1.
        auto code(i64 token) const -> i64 {
            const Token value = token_at(token);
            if (value.kind() != 0) {
                return -1;
            }
            if (value.extra() > 0) {
                return value.extra() - 1;
            }
            i64 low = 254;
            i64 high = 254 + 111;
            while (low < high) {
                const i64 middle = low + (high - low) / 2;
                const Token candidate = word_at(middle);
                if (compare_text(candidate.first(), candidate.count(), value.first(), value.count()) < 0) {
                    low = middle + 1;
                } else {
                    high = middle;
                }
            }
            const Token found = word_at(low);
            if (low < 254 + 111 && compare_text(found.first(), found.count(), value.first(), value.count()) == 0) {
                return found.extra();
            }
            return -1;
        }
        // Caches a line's code in its keyword token.
        auto cache_code(i64 token) -> i64 {
            const i64 found = code(token);
            const Token keyword = token_at(token);
            if (found >= 0 && keyword.extra() == 0) {
                const Token cached = Token(0, keyword.first(), keyword.count(), found + 1);
                set_token(token, cached);
            }
            return found;
        }
        // An instruction line's form, or -1.
        auto form(i64 token) const -> i64 {
            const i64 found = code(token);
            if (found >= 85) {
                return -1;
            }
            return found;
        }
        // Each codec word becomes its fields (kind: letter, first: role) after
        // the sorted words, with the word holding their range and prefix size.
        auto compile_codecs() -> bool {
            i64 form = 0;
            while (form < 85 && good()) {
                const Token codec = word_at(107 + form);
                const i64 begin = wordSize;
                i64 prefix = 0;
                i64 at = 0;
                while (at < codec.count() && good()) {
                    const i64 letter = i64(text.at(codec.first() + at));
                    i64 role = 0;
                    at = at + 1;
                    while (at < codec.count() && digit(i64(text.at(codec.first() + at)))) {
                        role = role * 10 + i64(text.at(codec.first() + at)) - 48;
                        at = at + 1;
                    }
                    at = at + 1;
                    if (letter != i64('-')) {
                        if (letter == i64('v')) {
                            prefix = prefix + 2;
                        }
                        if (letter != i64('v') && letter != i64('u') && letter != i64('y') && letter != i64('p')
                            && letter != i64('q')) {
                            prefix = prefix + 1;
                        }
                        if (wordSize == words.size()) {
                            const Token fill = Token(-1, 0, 0, 0);
                            if (!words.try_resize(grown(wordSize), fill)) {
                                return fail();
                            }
                        }
                        const Token field = Token(letter, role, 0, 0);
                        words.set(wordSize, field);
                        wordSize = wordSize + 1;
                    }
                }
                const Token compiled = Token(0, begin, wordSize - begin, prefix);
                words.set(107 + form, compiled);
                form = form + 1;
            }
            return good();
        }
        auto codec_at(i64 form) const -> Token {
            return word_at(107 + form);
        }

        // ---- values
        auto integer(i64 token) -> i64 {
            const Token value = token_at(token);
            if (value.kind() != 0 || value.count() == 0) {
                fail();
                return 0;
            }
            i64 at = value.first();
            const i64 end = value.first() + value.count();
            bool negative = false;
            if (text.at(at) == '-') {
                negative = true;
                at = at + 1;
            }
            if (at == end) {
                fail();
                return 0;
            }
            // Accumulate negatively so the minimum i64 is representable.
            i64 result = 0;
            while (at < end) {
                const i64 next = i64(text.at(at));
                if (!digit(next) || result < -922337203685477580 || (result == -922337203685477580 && next - 48 > 8)) {
                    fail();
                    return 0;
                }
                result = result * 10 - (next - 48);
                at = at + 1;
            }
            if (!negative) {
                if (result == -9223372036854775807 - 1) {
                    fail();
                    return 0;
                }
                return -result;
            }
            return result;
        }
        auto boolean(i64 token) -> i64 {
            if (is(token, "true") || is(token, "1")) {
                return 1;
            }
            if (is(token, "false") || is(token, "0")) {
                return 0;
            }
            fail();
            return 0;
        }
        // A spelled enumerator of one table, or any integer.
        auto enumerator(i64 token, i64 first, i64 count) -> i64 {
            const Token value = token_at(token);
            if (value.kind() != 0 || value.count() == 0) {
                fail();
                return 0;
            }
            const i64 found = lookup(token, first, count);
            if (found >= 0) {
                return found;
            }
            const i64 lead = i64(text.at(value.first()));
            if (lead == i64('-') || digit(lead)) {
                return integer(token);
            }
            fail();
            return 0;
        }
        // A type kind word or integer, cached in the word once spelled.
        auto type_kind(i64 token) -> i64 {
            const Token value = token_at(token);
            if (value.kind() == 0 && value.extra() > 0) {
                return value.extra() - 1;
            }
            const i64 found = lookup(token, 85, 22);
            if (value.kind() == 0 && found >= 0) {
                const Token cached = Token(0, value.first(), value.count(), found + 1);
                set_token(token, cached);
                return found;
            }
            return enumerator(token, 85, 22);
        }
        auto operation(i64 token, i64 table) -> i64 {
            return enumerator(token, 192 + enumeration_first(table), enumeration_size(table));
        }
        // A word or string node.
        auto name(i64 token) -> bool {
            const i64 value = kind(token);
            if (value != 0 && value != 1) {
                return fail();
            }
            return true;
        }
        // The token after the node starting at token.
        auto next(i64 token) const -> i64 {
            i64 at = token;
            while (kind(at) == 5) {
                at = at + 1;
            }
            const Token value = token_at(at);
            if (value.kind() == 2 || value.kind() == 3) {
                return value.extra() + 1;
            }
            return at + 1;
        }
        // Nodes of a line starting at token.
        auto nodes(i64 token) const -> i64 {
            i64 count = 0;
            i64 at = token;
            while (kind(at) != 6) {
                at = next(at);
                count = count + 1;
            }
            return count;
        }
        auto node(i64 line, i64 ordinal) const -> i64 {
            i64 at = line;
            i64 count = 0;
            while (count < ordinal && kind(at) != 6) {
                at = next(at);
                count = count + 1;
            }
            return at;
        }
        auto arity(i64 line, i64 minimum, i64 maximum) -> bool {
            const i64 count = nodes(line);
            if (count < minimum || count > maximum) {
                return fail();
            }
            return true;
        }
        // Items of a list (2) or tuple (3) node.
        auto items(i64 token, i64 bracket) -> i64 {
            const Token value = token_at(token);
            if (value.kind() != bracket) {
                fail();
                return 0;
            }
            i64 count = 0;
            i64 at = token + 1;
            while (at < value.extra()) {
                at = next(at);
                count = count + 1;
            }
            return count;
        }
        auto item(i64 token, i64 ordinal) const -> i64 {
            i64 at = token + 1;
            i64 count = 0;
            while (count < ordinal) {
                at = next(at);
                count = count + 1;
            }
            return at;
        }

        // ---- text expansion
        auto keyword_is(i64 begin, i64 end, builtin::span<const u8> expected) const -> bool {
            i64 at = begin;
            while (at < end && (text.at(at) == ' ' || text.at(at) == '\t')) {
                at = at + 1;
            }
            i64 stop = at;
            while (stop < end && text.at(stop) != ' ' && text.at(stop) != '\t' && text.at(stop) != '\r' && text.at(stop)
                != ';') {
                stop = stop + 1;
            }
            if (stop - at != expected.size()) {
                return false;
            }
            i64 index = 0;
            while (index < expected.size()) {
                if (text.at(at + index) != expected.at(index)) {
                    return false;
                }
                index = index + 1;
            }
            return true;
        }
        auto line_end(i64 begin, i64 end) const -> i64 {
            i64 at = begin;
            while (at < end && text.at(at) != '\n') {
                at = at + 1;
            }
            return at;
        }
        // A decimal field of a {start,step} template.
        auto template_number(i64 begin, i64 end) -> i64 {
            i64 at = begin;
            bool negative = false;
            if (at < end && text.at(at) == '-') {
                negative = true;
                at = at + 1;
            }
            if (at == end) {
                fail();
                return 0;
            }
            // Accumulated negatively: -9223372036854775808 has no positive counterpart.
            i64 result = 0;
            while (at < end) {
                const i64 next_digit = i64(text.at(at));
                const bool last = result == -922337203685477580 && next_digit > 56;
                if (!digit(next_digit) || result < -922337203685477580 || last) {
                    fail();
                    return 0;
                }
                result = result * 10 - (next_digit - 48);
                at = at + 1;
            }
            if (negative) {
                return result;
            }
            if (result == -9223372036854775807 - 1) {
                fail();
                return 0;
            }
            return -result;
        }
        // Appends [begin, end) with each {a,s} spelled as a + s * index.
        auto expand_template(i64 begin, i64 end, i64 index) -> bool {
            i64 at = begin;
            while (at < end && good()) {
                if (text.at(at) != '{') {
                    put(text.at(at));
                    at = at + 1;
                } else {
                    i64 comma = at;
                    while (comma < end && text.at(comma) != ',') {
                        comma = comma + 1;
                    }
                    i64 close = at;
                    while (close < end && text.at(close) != '}') {
                        close = close + 1;
                    }
                    if (close == end || comma == end || comma > close) {
                        return fail();
                    }
                    const i64 start = template_number(at + 1, comma);
                    const i64 step = template_number(comma + 1, close);
                    if (index != 0 && (step > 9223372036854775807 / index || step < -9223372036854775807 / index)) {
                        return fail();
                    }
                    const i64 offset = step * index;
                    if ((offset > 0 && start > 9223372036854775807 - offset) || (offset < 0 && start
                        < -9223372036854775807 - 1 - offset)) {
                        return fail();
                    }
                    put_number(start + offset);
                    at = close + 1;
                }
            }
            return good();
        }
        auto string_end(i64 begin, i64 end) const -> i64 {
            i64 at = begin + 1;
            while (at < end && text.at(at) != '"') {
                if (text.at(at) == '\\') {
                    at = at + 1;
                }
                at = at + 1;
            }
            if (at >= end) {
                return -1;
            }
            return at + 1;
        }
        auto skip_space(i64 begin, i64 end) const -> i64 {
            i64 at = begin;
            while (at < end && space(i64(text.at(at)))) {
                at = at + 1;
            }
            return at;
        }
        auto bracket_end(i64 begin, i64 end) const -> i64 {
            i64 depth = 0;
            i64 at = begin;
            while (at < end) {
                const u8 value = text.at(at);
                if (value == '"') {
                    at = string_end(at, end);
                    if (at < 0) {
                        return -1;
                    }
                } else {
                    if (value == '[' || value == '(') {
                        depth = depth + 1;
                    }
                    if (value == ']' || value == ')') {
                        depth = depth - 1;
                        if (depth == 0) {
                            return at + 1;
                        }
                    }
                    at = at + 1;
                }
            }
            return -1;
        }
        // The end of the node starting at begin, a key's value included, or -1.
        auto node_end(i64 begin, i64 end) const -> i64 {
            i64 at = begin;
            while (at < end) {
                const u8 first = text.at(at);
                if (first == '[' || first == '(') {
                    return bracket_end(at, end);
                }
                if (first == '"') {
                    at = string_end(at, end);
                    if (at < 0) {
                        return -1;
                    }
                } else {
                    while (at < end && !delimiter(i64(text.at(at)))) {
                        at = at + 1;
                    }
                }
                const i64 after = skip_space(at, end);
                if (after >= end || text.at(after) != '=') {
                    return at;
                }
                at = skip_space(after + 1, end);
            }
            return -1;
        }
        // Spells each repeated list item with {a,s} templates (ITEM*N) as N
        // copies, outermost first: copy i spells a + s * i, so a template
        // belongs to the outermost repetition around it. Other repeated items
        // stay for the tokenizer to copy. Appends the expanded line; returns 1
        // when a spelled copy repeats again, 0 when done.
        auto expand_items(i64 begin, i64 end) -> i64 {
            clear_stack();
            i64 again = 0;
            i64 at = begin;
            while (at < end && good()) {
                const u8 value = text.at(at);
                bool plain = true;
                if (value == '"') {
                    const i64 close = string_end(at, end);
                    if (close < 0) {
                        copy(at, end);
                        at = end;
                    } else {
                        copy(at, close);
                        at = close;
                    }
                    plain = false;
                }
                if (plain && value == ';') {
                    copy(at, end);
                    at = end;
                    plain = false;
                }
                if (plain && top() == 2 && !space(i64(value)) && value != ']' && value != ')') {
                    const i64 item_end = node_end(at, end);
                    if (item_end < 0) {
                        fail();
                        return -1;
                    }
                    const i64 star = skip_space(item_end, end);
                    if (item_end > at && star < end && text.at(star) == '*') {
                        i64 last = star + 1;
                        while (last < end && digit(i64(text.at(last)))) {
                            last = last + 1;
                        }
                        if (last == star + 1) {
                            fail();
                            return -1;
                        }
                        const i64 count = template_number(star + 1, last);
                        if (count < 1 || count > 1048576) {
                            fail();
                            return -1;
                        }
                        bool braces = false;
                        bool nested = false;
                        i64 scan = at;
                        while (scan < item_end) {
                            if (text.at(scan) == '{') {
                                braces = true;
                            }
                            if (text.at(scan) == '*') {
                                nested = true;
                            }
                            scan = scan + 1;
                        }
                        if (braces && nested) {
                            again = 1;
