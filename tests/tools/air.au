        auto has_brace(i64 begin, i64 end) const -> bool {
            i64 at = begin;
            while (at < end) {
                if (text.at(at) == '{') {
                    return true;
                }
                at = at + 1;
            }
            return false;
        }
        auto has_star(i64 begin, i64 end) const -> bool {
            i64 at = begin;
            while (at < end) {
                if (text.at(at) == '*') {
                    return true;
                }
                at = at + 1;
            }
            return false;
        }
        auto process(i64 begin, i64 end, i64 line) -> bool {
            at_line(line);
            i64 first = begin;
            i64 last = end;
            bool repeating = has_star(begin, end) && has_brace(begin, end);
            while (repeating && good()) {
                const i64 expanded = textSize;
                repeating = expand_items(first, last) == 1;
                first = expanded;
                last = textSize;
            }
            return tokenize(first, last, line, false);
        }
        // Copies the spellings and splits them into words.
        auto load_words(builtin::span<const u8> spellings) -> bool {
            const i64 first = textSize;
            return put_text(spellings) && add_words(first) && words_ready() && sort_forms() && compile_codecs();
        }
        // The line after a repeat block's "endrepeat", or -1.
        auto block_end(i64 begin, i64 end) const -> i64 {
            i64 at = begin;
            while (at <= end) {
                const i64 stop = line_end(at, end);
                if (keyword_is(at, stop, "endrepeat")) {
                    return at;
                }
                if (keyword_is(at, stop, "repeat")) {
                    return -1;
                }
                at = stop + 1;
            }
            return -1;
        }
        // A block token for one repetition: a marked {a,s} spelling becomes
        // its own word or string spelling a + s * repetition.
        auto spelled(Token value, i64 shift, i64 repetition) -> Token {
            if ((value.kind() == 0 || value.kind() == 1) && value.extra() == -1) {
                const i64 first = textSize;
                expand_template(value.first(), value.first() + value.count(), repetition);
                const Token result = Token(value.kind(), first, textSize - first, 0);
                return result;
