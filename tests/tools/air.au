        auto repeat_tokens(i64 first, i64 count) -> bool {
            const i64 size = tokenSize - first;
            i64 copy_index = 1;
            while (copy_index < count && good()) {
                i64 at = 0;
                while (at < size && good()) {
                    add_token(copied(token_at(first + at), copy_index * size));
                    at = at + 1;
                }
                copy_index = copy_index + 1;
            }
            return good();
        }
        // ITEM*N at position at, after the item starting at token item in a
        // list: N copies of its tokens. Returns the position after N.
        auto repeat_item(i64 at, i64 end, i64 item) -> i64 {
            i64 last = at + 1;
            while (last < end && digit(i64(text.at(last)))) {
                last = last + 1;
            }
            const i64 count = template_number(at + 1, last);
            if (last == at + 1 || count < 1 || count > 1048576 || item < 0 || stackSize < 2 || kind(top()) != 2) {
                fail();
                return end;
            }
            repeat_tokens(item, count);
            return last;
