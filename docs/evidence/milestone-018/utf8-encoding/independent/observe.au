module encode_independent_review;
import std.utf8;
import std.array;
auto observe(u64 scalar) -> u64 {
    const std::Utf8EncodeResult report = std::encode_utf8(scalar);
    const std::array<u8,4> data = report.bytes_or_zero();
    const i64 width = report.size();
    u64 state = 0u64;
    if (report.status() == std::Utf8EncodeStatus::invalid_scalar) { state = 1u64; }
    if (width < 0) { return 9223372036854775809u64; }
    if (width > 4) { return 9223372036854775810u64; }
    if (report.byte_or(-9223372036854775808, 37u8) != 37u8) { return 9223372036854775811u64; }
    if (report.byte_or(9223372036854775807, 38u8) != 38u8) { return 9223372036854775812u64; }
    if (report.byte_or(-1, 39u8) != 39u8) { return 9223372036854775813u64; }
    if (report.byte_or(width, 40u8) != 40u8) { return 9223372036854775814u64; }
    i64 index = 0;
    while (index < 4) {
        if (index < width) {
            if (report.byte_or(index, 255u8) != data.at(index)) { return 9223372036854775815u64; }
        } else {
            if (report.byte_or(index, 254u8) != 254u8) { return 9223372036854775816u64; }
            if (data.at(index) != 0u8) { return 9223372036854775817u64; }
        }
        index = index + 1;
    }
    return u64(data.at(0)) + u64(data.at(1))*256u64 + u64(data.at(2))*65536u64
        + u64(data.at(3))*16777216u64 + u64(width)*4294967296u64 + state*1099511627776u64;
}
