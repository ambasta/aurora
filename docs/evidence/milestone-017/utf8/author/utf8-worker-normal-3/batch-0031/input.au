module utf8_test;import std.utf8;
auto both(bool a,bool b)->bool{if(a){return b;}return false;}
auto either(bool a,bool b)->bool{if(a){return true;}return b;}

auto utf8_case_0()->u64{const std::Utf8DecodeResult report=std::Utf8DecodeResult(std::Utf8Status::truncated,1114112u64,0);return report.scalar_or(18446744073709551614u64);}

auto utf8_case_1()->u64{const std::Utf8DecodeResult report=std::Utf8DecodeResult(std::Utf8Status::truncated,18446744073709551615u64,0);return report.scalar_or(18446744073709551614u64);}

auto utf8_case_2()->u64{const std::Utf8DecodeResult report=std::Utf8DecodeResult(std::Utf8Status::need_more,0u64,0);return report.scalar_or(18446744073709551614u64);}

auto utf8_case_3()->u64{const std::Utf8DecodeResult report=std::Utf8DecodeResult(std::Utf8Status::need_more,55295u64,0);return report.scalar_or(18446744073709551614u64);}

auto utf8_case_4()->u64{const std::Utf8DecodeResult report=std::Utf8DecodeResult(std::Utf8Status::need_more,55296u64,0);return report.scalar_or(18446744073709551614u64);}

auto utf8_case_5()->u64{const std::Utf8DecodeResult report=std::Utf8DecodeResult(std::Utf8Status::need_more,57343u64,0);return report.scalar_or(18446744073709551614u64);}

auto utf8_case_6()->u64{const std::Utf8DecodeResult report=std::Utf8DecodeResult(std::Utf8Status::need_more,57344u64,0);return report.scalar_or(18446744073709551614u64);}

auto utf8_case_7()->u64{const std::Utf8DecodeResult report=std::Utf8DecodeResult(std::Utf8Status::need_more,1114111u64,0);return report.scalar_or(18446744073709551614u64);}

auto utf8_case_8()->u64{const std::Utf8DecodeResult report=std::Utf8DecodeResult(std::Utf8Status::need_more,1114112u64,0);return report.scalar_or(18446744073709551614u64);}

auto utf8_case_9()->u64{const std::Utf8DecodeResult report=std::Utf8DecodeResult(std::Utf8Status::need_more,18446744073709551615u64,0);return report.scalar_or(18446744073709551614u64);}

auto utf8_case_10()->u64{
        builtin::array<u8,4> bytes={240u8,159u8,153u8,130u8};
        std::Utf8DecodeResult saved=std::Utf8DecodeResult(std::Utf8Status::end_of_input,0u64,0);
        {const builtin::span<const u8> view=borrow_bytes(bytes);
          const std::Utf8DecodeResult original=std::decode_utf8(view,0,4,true);saved=original;
          const std::Utf8ValidationResult valid=std::validate_utf8(view,0,4,true);
          if(either(valid.prefix_bytes()!=4,valid.scalar_count()!=1)){return 1u64;}
          if(either(either(view.at(0)!=240u8,view.at(1)!=159u8),either(view.at(2)!=153u8,view.at(3)!=130u8))){return 2u64;}
        }
        bytes[0]=65u8;bytes[1]=0u8;bytes[2]=0u8;bytes[3]=0u8;
        const std::Utf8DecodeResult copy=saved;
        saved=std::Utf8DecodeResult(std::Utf8Status::invalid_sequence,42u64,0);
        if(either(copy.status()!=std::Utf8Status::success,copy.width()!=4)){return 3u64;}
        return copy.scalar_or(0u64);
    }

auto utf8_case_11()->u64{
        std::Utf8ValidationResult original=std::Utf8ValidationResult(std::Utf8Status::success,-9223372036854775808,9223372036854775807);
        const std::Utf8ValidationResult copy=original;
        original=std::Utf8ValidationResult(std::Utf8Status::out_of_range,0,0);
        if(copy.status()!=std::Utf8Status::success){return 1u64;}
        if(either(copy.prefix_bytes()!=-9223372036854775808,copy.scalar_count()!=9223372036854775807)){return 2u64;}
        return 11914855783004569770u64;
    }
