module utf8_test;import std.utf8;
auto both(bool a,bool b)->bool{if(a){return b;}return false;}
auto either(bool a,bool b)->bool{if(a){return true;}return b;}

auto utf8_case_0()->u64{const std::Utf8DecodeResult report=std::Utf8DecodeResult(std::Utf8Status::success,55296u64,0);return report.scalar_or(18446744073709551614u64);}

