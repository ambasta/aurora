module utf8_test;import std.utf8;
auto both(bool a,bool b)->bool{if(a){return b;}return false;}
auto either(bool a,bool b)->bool{if(a){return true;}return b;}

auto utf8_case_0()->u64{const builtin::array<u8,4> bytes={255u8,194u8,162u8,255u8};const builtin::span<const u8> view=borrow_bytes(bytes);const std::Utf8DecodeResult d=std::decode_utf8(view,-1,1,false);if(d.status()!=std::Utf8Status::out_of_range){return 1u64;}if(d.width()!=0){return 2u64;}if(d.scalar_or(18446744073709551615u64)!=18446744073709551615u64){return 3u64;}const std::Utf8ValidationResult v=std::validate_utf8(view,-1,1,false);if(v.status()!=std::Utf8Status::out_of_range){return 4u64;}if(v.prefix_bytes()!=0){return 5u64;}if(v.scalar_count()!=0){return 6u64;}return 11914855783004569770u64;}

