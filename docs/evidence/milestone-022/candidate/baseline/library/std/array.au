export module std.array;

export namespace std {
    template <Scalar T, i64 N>
    class array {
        builtin::array<T, N> elements;
    public:
        array() : elements{} {}

        auto size() const -> i64 {
            return N;
        }

        auto at(i64 index) const -> T {
            return elements[index];
        }

        auto set(i64 index, T value) -> T {
            elements[index] = value;
            return value;
        }
    };
}
