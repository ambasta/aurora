module review;class Box{i64 n;public:Box(i64 v):n(v){}auto get()const->i64{return n;}auto add(i64 v)->i64{n=n+v;return n;}auto take(Box a,i64 n,Box b)const->i64{return a.get()+b.get()+n;}auto copied(Box a)const->Box{return a;}};class Holder{i64 n;auto inner(Box a,i64 add)->Box{n=n+add;const Box result=Box(a.get()+n);return result;}public:Holder(i64 v):n(v){}auto outer(Box a)->Box{const Box result=inner(a,a.take(a,0,a)-41);return result;}};auto answer()->i64{Box source=Box(21);Holder receiver=Holder(20);Box result=receiver.outer(source);return result.get();}