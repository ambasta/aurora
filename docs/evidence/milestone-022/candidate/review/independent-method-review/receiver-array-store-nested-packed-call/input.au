module review;class Box{i64 n;public:Box(i64 v):n(v){}auto get()const->i64{return n;}auto add(i64 v)->i64{n=n+v;return n;}auto take(Box a,i64 n,Box b)const->i64{return a.get()+b.get()+n;}auto copied(Box a)const->Box{return a;}};class Array{builtin::array<i64,2> a;public:Array():a{}{}auto update(Box source)->i64{a[1]=2+source.take(source,0,source);return a[1];}};auto answer()->i64{Box source=Box(20);Array object=Array();return object.update(source);}