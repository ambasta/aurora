module review;class Box{i64 n;public:Box(i64 v):n(v){}auto get()const->i64{return n;}auto add(i64 v)->i64{n=n+v;return n;}auto take(Box a,i64 n,Box b)const->i64{return a.get()+b.get()+n;}auto copied(Box a)const->Box{return a;}};class Mixer{public:Mixer(){}auto scalar(Box a)const->i64{return 6+a.get();}auto mix(i64 x,Box a,i64 y,Box b,i64 z,Box c)const->i64{return x+a.get()+y+b.get()+z+c.get()+3;}};auto answer()->i64{Box a=Box(3);Box b=Box(6);Mixer m=Mixer();return 1+(2+m.mix(7,a,m.scalar(a),b,8,a));}