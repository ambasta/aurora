module review;class Box{i64 n;public:Box(i64 v):n(v){}auto get()const->i64{return n;}auto add(i64 v)->i64{n=n+v;return n;}auto take(Box a,i64 n,Box b)const->i64{return a.get()+b.get()+n;}auto copied(Box a)const->Box{return a;}};class Holder{i64 n;auto bump()->i64{n=n+1;return n;}auto inner(Box a,i64 captured)const->i64{return a.get()+captured+n-19;}public:Holder(i64 v):n(v){}auto outer(Box a)->i64{return inner(a,bump());}};auto answer()->i64{Box source=Box(19);Holder receiver=Holder(20);return receiver.outer(source);}