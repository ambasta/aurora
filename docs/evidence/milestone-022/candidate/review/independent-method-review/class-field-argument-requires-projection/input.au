module review;class Box{i64 n;public:Box(i64 v):n(v){}auto get()const->i64{return n;}auto add(i64 v)->i64{n=n+v;return n;}auto take(Box a,i64 n,Box b)const->i64{return a.get()+b.get()+n;}auto copied(Box a)const->Box{return a;}};class Wrapper{public:Box value;Wrapper(Box b):value(b){}};auto answer()->i64{Box b=Box(42);Wrapper w=Wrapper(b);return b.take(w.value,0,b);}