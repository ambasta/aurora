module app;import std.array;enum class Status{ready,failed};enum class Other{ready,failed};class Empty{public:Empty(){}auto answer()const->i64{return 42;}};class Packet{public:u8 head;std::array<u8,3> data;Status state;Empty zero;u8 tail;Packet(u8 h,std::array<u8,3> b,Status s,Empty e,u8 t):head(h),data(b),state(s),zero(e),tail(t){} };class Receiver{public:Receiver(){}auto copy(Packet value)const->Packet{return value;}};auto test()->i64{std::array<u8,3> bytes=std::array<u8,3>();bytes.set(0,255u8);bytes.set(2,40u8);Empty empty=Empty();Packet source=Packet(7u8,bytes,Status::ready,empty,2u8);Receiver receiver=Receiver();Packet result=receiver.copy(source);bytes.set(2,0u8);std::array<u8,3> changed=result.data;changed.set(2,1u8);const std::array<u8,3> saved=result.data;if(saved.at(0)!=255u8){return 1;}if(result.state!=Status::ready){return 2;}if(result.head!=7u8){return 3;}const Empty zero=result.zero;if(zero.answer()!=42){return 4;}return i64(saved.at(2))+i64(result.tail);}