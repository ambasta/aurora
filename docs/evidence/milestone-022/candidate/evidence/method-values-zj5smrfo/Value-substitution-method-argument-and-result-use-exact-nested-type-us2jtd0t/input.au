module app;class Counter{
    i64 value;
public:
    Counter(i64 n):value(n){}
    auto get()const->i64{return value;}
    auto set(i64 n)->i64{value=n;return value;}
    auto add(i64 n)->i64{value=value+n;return value;}
    auto read(Counter source)const->i64{return source.get();}
    auto copy(Counter source)const->Counter{return source;}
    auto replace(Counter source)->Counter{
        const Counter old=Counter(value);value=source.get();return old;
    }
};template<Value T>class Box{T item;public:Box(T n):item(n){}auto copy(T source)const->T{return source;}};auto test()->i64{Counter source=Counter(42);Box<Counter> receiver=Box<Counter>(source);Counter result=receiver.copy(source);source.set(99);return result.get();}