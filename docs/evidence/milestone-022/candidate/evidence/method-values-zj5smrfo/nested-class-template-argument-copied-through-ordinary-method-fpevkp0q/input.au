module app;import std.array;import std.utility;class Receiver{public:Receiver(){}auto copy(std::pair<std::array<u8,3>,u8> value)const->std::pair<std::array<u8,3>,u8>{return value;}};auto test()->i64{std::array<u8,3> bytes=std::array<u8,3>();bytes.set(2,40u8);std::pair<std::array<u8,3>,u8> source=std::pair<std::array<u8,3>,u8>(bytes,2u8);Receiver receiver=Receiver();const std::pair<std::array<u8,3>,u8> result=receiver.copy(source);const std::array<u8,3> saved=result.first;return i64(saved.at(2))+i64(result.second);}