+
+
+def boundary_cases(suite):
+    for levels in (3, 4, 5):
+        concrete = "i64"
+        for _ in range(levels):
+            concrete = f"Tag<{concrete}>"
+        source = p(f"static_assert(size_of({concrete})==8);{concrete} value={concrete}();return 42;",
