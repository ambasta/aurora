        auto get_charged(u64 slot) const -> u64 {
            builtin::require(slot < 2u64);
            if (slot == 0u64) {
                return slot0_charged;
            }
            return slot1_charged;
        }
        auto set_charged(u64 slot, u64 value) -> bool {
            builtin::require(slot < 2u64);
            if (slot == 0u64) {
                slot0_charged = value;
            } else {
                slot1_charged = value;
            }
            return true;
        }
        auto get_quota(u64 slot) const -> u64 {
            builtin::require(slot < 2u64);
            if (slot == 0u64) {
                return slot0_quota;
            }
            return slot1_quota;
        }
        auto set_quota(u64 slot, u64 value) -> bool {
            builtin::require(slot < 2u64);
            if (slot == 0u64) {
                slot0_quota = value;
            } else {
                slot1_quota = value;
            }
            return true;
        }
        auto get_count(u64 slot) const -> u64 {
            builtin::require(slot < 2u64);
            if (slot == 0u64) {
                return slot0_count;
            }
            return slot1_count;
        }
        auto set_count(u64 slot, u64 value) -> bool {
            builtin::require(slot < 2u64);
            if (slot == 0u64) {
                slot0_count = value;
            } else {
                slot1_count = value;
            }
            return true;
        }
        auto get_region_count(u64 slot) const -> u64 {
            builtin::require(slot < 2u64);
            if (slot == 0u64) {
                return slot0_region_count;
            }
            return slot1_region_count;
        }
        auto set_region_count(u64 slot, u64 value) -> bool {
            builtin::require(slot < 2u64);
            if (slot == 0u64) {
                slot0_region_count = value;
            } else {
                slot1_region_count = value;
            }
            return true;
        }
        auto state(u64 slot) const -> MemoryState {
            const MemoryState value = MemoryState{
                .next = get_next(slot),
                .charged = get_charged(slot),
                .quota = get_quota(slot),
                .count = get_count(slot)
            };
            return value;
        }
        auto record_at(u64 slot, u64 index) const -> MemoryRecord {
            builtin::require(slot < 2u64 && index < 16384u64);
            const u64 at = record_word(slot, index);
            const MemoryRecord value = MemoryRecord{
                .first = reservation_words.at(at),
                .reserved = reservation_words.at(at + 1u64),
                .pages = reservation_words.at(at + 2u64)
            };
            return value;
        }
        auto set_record(u64 slot, u64 index, MemoryRecord value) -> bool {
            builtin::require(slot < 2u64 && index < 16384u64);
            const u64 at = record_word(slot, index);
            builtin::require(reservation_words.set(at, value.first));
            builtin::require(reservation_words.set(at + 1u64, value.reserved));
            builtin::require(reservation_words.set(at + 2u64, value.pages));
            return true;
        }
        auto region_at(u64 slot, u64 index) const -> ProcessRegion {
            builtin::require(slot < 2u64 && index < 10u64);
            const u64 at = region_word(slot, index);
            const ProcessRegion value = ProcessRegion{
                .kind = reservation_words.at(at),
                .first = reservation_words.at(at + 1u64),
                .pages = reservation_words.at(at + 2u64),
                .flags = reservation_words.at(at + 3u64),
                .vaddr = reservation_words.at(at + 4u64),
                .offset = reservation_words.at(at + 5u64),
                .bytes = reservation_words.at(at + 6u64)
            };
            return value;
        }
        auto set_region(u64 slot, u64 index, ProcessRegion value) -> bool {
            builtin::require(slot < 2u64 && index < 10u64);
            const u64 at = region_word(slot, index);
            builtin::require(reservation_words.set(at, value.kind));
            builtin::require(reservation_words.set(at + 1u64, value.first));
            builtin::require(reservation_words.set(at + 2u64, value.pages));
            builtin::require(reservation_words.set(at + 3u64, value.flags));
