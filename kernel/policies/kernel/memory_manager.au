    public:
        auto remap_memory(u64 slot, u64 epoch, u64 base, u64 bytes, u64 target) -> MemoryResult {
            builtin::require(require_slot(slot, epoch) && get_phase(slot) == 2u64 && accounted(slot));
            const MemoryResult refused = MemoryResult(1u64, 0u64);
            const u64 found = find_record(slot, base);
            if (found == 0u64) {
                return refused;
            }
            const MemoryRecord record = record_at(slot, found - 1u64);
            const MemoryDecision decided = memory_remap(state(slot), record, bytes, target);
            if (decided.verdict == MemoryVerdict::length) {
                return refused;
