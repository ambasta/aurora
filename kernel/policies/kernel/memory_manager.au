export module kernel.memory_manager;
import kernel.frame_allocator;
import kernel.frames;
import kernel.process_space;
import kernel.process_memory;

// One retained owner for allocation, page-table descriptors, both fixed
// reservation catalogs and the loader snapshot. Hardware effects are synchronous
// and authenticated against this exact bank set; scalar tickets are not authority.
export namespace kernel {
    class MemoryResult {
    public:
        u64 outcome;
        u64 value;
        MemoryResult(u64 decision, u64 result) : outcome(decision), value(result) {
        }
    };
    class MemoryEntry {
    public:
        u64 table;
        u64 slot;
        bool valid;
        MemoryEntry(u64 physical, u64 position, bool admitted) : table(physical), slot(position), valid(admitted) {
        }
    };
    class MemoryCursor {
    public:
        u64 ticket;
        u64 prefix;
        u64 next;
        u64 end;
        u64 parent;
        u64 level;
        MemoryCursor(u64 frame, u64 first, u64 position, u64 limit, u64 link, u64 depth) : ticket(frame), prefix(first),
            next(position), end(limit), parent(link), level(depth) {
        }
    };
    class MemoryWalk {
    public:
        bool valid;
        u64 tables;
        u64 leaves;
        u64 heap;
        u64 heap_tables;
        u64 shared;
        MemoryWalk(bool admitted, u64 table_count, u64 leaf_count, u64 heap_count, u64 heap_table_count,
            u64 shared_count) : valid(admitted), tables(table_count), leaves(leaf_count), heap(heap_count),
            heap_tables(heap_table_count), shared(shared_count) {
        }
    };
    class MemoryManager {
        builtin::OwnedWords words;
        builtin::OwnedWords mapping_words;
        builtin::OwnedWords reservation_words;
        builtin::OwnedWords scratch_words;
        builtin::MappingAuthority authority;
        u64 head;
        u64 free_count;
        u64 allocated_count;
        u64 reserved_count;
        u64 owner0;
        u64 count0;
        u64 owner1;
        u64 count1;
        bool initialized;
        bool poison;
        u64 slot0_owner;
        u64 slot0_epoch;
        u64 slot0_phase;
        u64 slot0_root_ticket;
        u64 slot0_tables;
        u64 slot0_leaves;
        u64 slot0_heap;
        u64 slot0_heap_tables;
        u64 slot0_next;
        u64 slot0_charged;
        u64 slot0_quota;
        u64 slot0_count;
        u64 slot0_region_count;
        u64 slot1_owner;
        u64 slot1_epoch;
        u64 slot1_phase;
        u64 slot1_root_ticket;
        u64 slot1_tables;
        u64 slot1_leaves;
        u64 slot1_heap;
        u64 slot1_heap_tables;
        u64 slot1_next;
        u64 slot1_charged;
        u64 slot1_quota;
        u64 slot1_count;
        u64 slot1_region_count;
        u64 snapshot_owner;
        u64 snapshot_epoch;
        u64 snapshot_phase;
        u64 snapshot_directory_ticket;
        u64 snapshot_bytes;
        u64 snapshot_held;
        u64 shared_slots;
        u64 shared_slot0;
        u64 shared_slot1;
        u64 shared_entry0;
        u64 shared_entry1;
        u64 shared_reserved_first;
        u64 shared_reserved_end;
        u64 staged_count;
        u64 active_slot;
        u64 operation;

        auto owner_slot(u64 owner) const -> u64 {
            if (owner0 == owner) {
                return 0u64;
            }
            if (owner1 == owner) {
                return 1u64;
            }
            return 2u64;
        }
        auto held_by(u64 slot) const -> u64 {
            if (slot == 0u64) {
                return count0;
            }
            if (slot == 1u64) {
                return count1;
            }
            return 0u64;
        }
    public:
        MemoryManager(builtin::OwnedWords input, builtin::OwnedWords mapping, builtin::OwnedWords reservations,
            builtin::OwnedWords scratch, builtin::MappingAuthority effects) : words(move(input)),
            mapping_words(move(mapping)), reservation_words(move(reservations)), scratch_words(move(scratch)),
            authority(move(effects)), head(0u64), free_count(0u64), allocated_count(0u64), reserved_count(0u64),
            owner0(0u64), count0(0u64), owner1(0u64), count1(0u64), initialized(false), poison(false),
            slot0_owner(0u64), slot0_epoch(0u64), slot0_phase(0u64), slot0_root_ticket(0u64), slot0_tables(0u64),
            slot0_leaves(0u64), slot0_heap(0u64), slot0_heap_tables(0u64), slot0_next(0u64), slot0_charged(0u64),
            slot0_quota(0u64), slot0_count(0u64), slot0_region_count(0u64), slot1_owner(0u64), slot1_epoch(0u64),
            slot1_phase(0u64), slot1_root_ticket(0u64), slot1_tables(0u64), slot1_leaves(0u64), slot1_heap(0u64),
            slot1_heap_tables(0u64), slot1_next(0u64), slot1_charged(0u64), slot1_quota(0u64), slot1_count(0u64),
            slot1_region_count(0u64), snapshot_owner(0u64), snapshot_epoch(0u64), snapshot_phase(0u64),
            snapshot_directory_ticket(0u64), snapshot_bytes(0u64), snapshot_held(0u64), shared_slots(0u64),
            shared_slot0(0u64), shared_slot1(0u64), shared_entry0(0u64), shared_entry1(0u64),
            shared_reserved_first(0u64), shared_reserved_end(0u64), staged_count(0u64), active_slot(0u64),
            operation(0u64) {
        }
        // Called only during unpublished boot admission. Every refusal occurs
        // before the first write; the fixed backing cannot fail after admission.
        auto initialize_frames(u64 tables, u64 metadata) -> bool {
            const u64 size = words.size();
            if (initialized || poison || size == 0u64 || size > 4294967295u64 || tables >= size || metadata >= size
                - tables) {
                return false;
            }
            u64 index = 0u64;
            while (index < size) {
                if (words.at(index) != 0u64) {
                    return false;
                }
                index = index + 1u64;
            }
            const u64 reserved = tables + metadata;
            index = 0u64;
            while (index < reserved) {
                u64 owner = 2u64;
                if (index < tables) {
                    owner = 1u64;
                }
                const u64 next = frame_transition(FrameOperation::initialize_kernel, 0u64, owner, 0u64, 0u64);
                builtin::require(next == frame_record(frame_kernel(), 0u64, owner));
                builtin::require(words.set(index, next));
                index = index + 1u64;
            }
            u64 next_head = 0u64;
            index = size;
            while (index > reserved) {
                const u64 next = frame_transition(FrameOperation::initialize_free, 0u64, 0u64, 0u64, next_head);
                builtin::require(next == frame_record(frame_free(), 0u64, next_head));
                builtin::require(words.set(index - 1u64, next));
                next_head = index;
                index = index - 1u64;
            }
            reserved_count = reserved;
            head = next_head;
            free_count = size - reserved;
            initialized = true;
            return true;
        }
        auto allocate(u64 owner) -> FrameAllocation {
            const FrameAllocation refused = FrameAllocation(0u64, 0u64, false);
            if (!initialized || poison || head == 0u64) {
                return refused;
            }
            u64 slot = owner_slot(owner);
            if (slot == 2u64) {
                if (count0 == 0u64) {
                    slot = 0u64;
                } else {
                    if (count1 == 0u64) {
                        slot = 1u64;
                    }
                }
            }
            if (slot == 2u64) {
                return refused;
            }
            const u64 size = words.size();
            const u64 index = head - 1u64;
            if (index >= size) {
                poison = true;
                return refused;
            }
            const u64 old = words.at(index);
            const u64 next_head = old >> 32;
            if ((old & 15u64) != frame_free() || next_head > size) {
                poison = true;
                return refused;
            }
            const u64 next = frame_transition(FrameOperation::allocate, old, owner, 0u64, 0u64);
            if ((next & 15u64) == 0u64) {
                return refused;
            }
            const u64 current = (old >> 4) & generation_limit();
            const u64 held = held_by(slot);
            if (next != frame_record(frame_allocated(), current, owner) || free_count == 0u64 || allocated_count >= size
                || held >= size || held > allocated_count) {
                poison = true;
                return refused;
            }
            // All denial and arithmetic checks precede this single record store.
            const u64 next_free = free_count - 1u64;
            const u64 next_allocated = allocated_count + 1u64;
            const u64 next_held = held + 1u64;
            builtin::require(words.set(index, next));
            head = next_head;
            free_count = next_free;
            allocated_count = next_allocated;
            if (slot == 0u64) {
                owner0 = owner;
                count0 = next_held;
            } else {
                owner1 = owner;
                count1 = next_held;
            }
            const FrameAllocation result = FrameAllocation(index, current, true);
            return result;
        }
        auto release(u64 index, u64 generation, u64 owner) -> u64 {
            if (!initialized || poison) {
                return 64u64;
            }
            const u64 size = words.size();
            if (index >= size) {
                return 65u64;
            }
            const u64 old = words.at(index);
            const u64 next = frame_transition(FrameOperation::release, old, owner, generation, head);
            if ((next & 15u64) == 0u64) {
                return next >> 4;
            }
            const u64 slot = owner_slot(owner);
            const u64 held = held_by(slot);
            const u64 kind = next & 15u64;
            const bool reusable = kind == frame_free();
            if ((!reusable && kind != frame_retired()) || (reusable && (next >> 32) != head) || (!reusable && (next
                >> 32) != 0u64) || slot == 2u64 || held == 0u64 || allocated_count == 0u64 || held > allocated_count
                || (reusable && free_count >= size)) {
                poison = true;
                return 64u64;
            }
            const u64 next_allocated = allocated_count - 1u64;
            const u64 next_held = held - 1u64;
            u64 next_free = free_count;
            if (reusable) {
                next_free = free_count + 1u64;
            }
            builtin::require(words.set(index, next));
            allocated_count = next_allocated;
            if (slot == 0u64) {
                count0 = next_held;
                if (next_held == 0u64) {
                    owner0 = 0u64;
                }
            } else {
                count1 = next_held;
                if (next_held == 0u64) {
                    owner1 = 0u64;
                }
            }
            if (reusable) {
                head = index + 1u64;
                free_count = next_free;
            }
            return 0u64;
        }
        auto record(u64 index) const -> u64 {
            if (index >= words.size()) {
                return 0u64;
            }
            return words.at(index);
        }
        auto frames() const -> u64 {
            return words.size();
        }
        auto reserved() const -> u64 {
            return reserved_count;
        }
        auto free() const -> u64 {
            return free_count;
        }
        auto allocated() const -> u64 {
            return allocated_count;
        }
        auto owner_allocated(u64 owner) const -> u64 {
            const u64 slot = owner_slot(owner);
            return held_by(slot);
        }
        auto poisoned() const -> bool {
            return poison;
        }
        auto audit() const -> FrameAudit {
            FrameAudit result = FrameAudit(false, 0u64, 0u64, 0u64, 0u64);
            if (!initialized || poison) {
                return result;
            }
            const u64 free_state = frame_free();
            const u64 allocated_state = frame_allocated();
            const u64 kernel_state = frame_kernel();
            const u64 retired_state = frame_retired();
            u64 counted0 = 0u64;
            u64 counted1 = 0u64;
            u64 index = 0u64;
            const builtin::span<const u64> records = borrow_words(words);
            const u64 size = u64(records.size());
            while (index < size) {
                const u64 value = records.at(i64(index));
                const u64 kind = value & 15u64;
                const u64 holder = value >> 32;
                if ((kind == kernel_state) != (index < reserved_count)) {
                    return result;
                }
                if (kind == free_state) {
                    // record_valid accepts every free encoding. Its remaining
                    // link constraint is this checked extent; do not repeat
                    // nonfree classification and source calls for each free word.
                    result.free = result.free + 1u64;
                    if (holder > size) {
                        return result;
                    }
                } else {
                    if (kind == allocated_state) {
                        result.allocated = result.allocated + 1u64;
                        const u64 slot = owner_slot(holder);
                        if (slot == 2u64) {
                            return result;
                        }
                        if (slot == 0u64) {
                            counted0 = counted0 + 1u64;
                        } else {
                            counted1 = counted1 + 1u64;
                        }
                    }
                    if (kind == kernel_state) {
                        result.kernel = result.kernel + 1u64;
                    }
                    if (kind == retired_state) {
                        result.retired = result.retired + 1u64;
                    }
                    if (!record_valid(value)) {
                        return result;
                    }
                }
                index = index + 1u64;
            }
            if (counted0 != count0 || counted1 != count1 || ((count0 == 0u64) != (owner0 == 0u64)) || ((count1 == 0u64)
                != (owner1 == 0u64))) {
                return result;
            }
            u64 walked = 0u64;
            u64 link = head;
            while (link != 0u64) {
                if (walked > result.free || link > size) {
                    return result;
                }
                const u64 value = records.at(i64(link - 1u64));
                if ((value & 15u64) != free_state) {
                    return result;
                }
                link = value >> 32;
                walked = walked + 1u64;
            }
            result.consistent = walked == result.free && result.free == free_count && result.allocated
                == allocated_count && result.kernel == reserved_count;
            return result;
        }
    private:
        // Literal layout facts are emitted independently from policy algorithms.
        // Admission recomputes the partition and verifies disjoint physical banks.
        auto layout_slot_count() const -> u64 {
            return 2u64;
        }
        auto layout_record_count() const -> u64 {
            return 16384u64;
        }
        auto layout_record_stride() const -> u64 {
            return 3u64;
        }
        auto layout_region_count() const -> u64 {
            return 10u64;
        }
        auto layout_region_stride() const -> u64 {
            return 7u64;
        }
        auto layout_shared_count() const -> u64 {
            return 256u64;
        }
        auto layout_stage_count() const -> u64 {
            return 19u64;
        }
        auto layout_stage_stride() const -> u64 {
            return 2u64;
        }
        auto layout_tail_words() const -> u64 {
            return 512u64;
        }
        auto layout_scratch_words() const -> u64 {
            return 512u64;
        }
        auto record_bank_words() const -> u64 {
            return layout_slot_count() * layout_record_count() * layout_record_stride();
        }
        auto reservation_extent() const -> u64 {
            return record_bank_words() + layout_tail_words();
        }
        auto record_word(u64 slot, u64 index) const -> u64 {
            builtin::require(slot < layout_slot_count() && index < layout_record_count());
            return (slot * layout_record_count() + index) * layout_record_stride();
        }
        auto region_word(u64 slot, u64 index) const -> u64 {
            builtin::require(slot < layout_slot_count() && index < layout_region_count());
            return record_bank_words() + (slot * layout_region_count() + index) * layout_region_stride();
        }
        auto shared_word(u64 index) const -> u64 {
            builtin::require(index < layout_shared_count());
            return record_bank_words() + layout_slot_count() * layout_region_count() * layout_region_stride() + index;
        }
        auto staged_word(u64 index, u64 field) const -> u64 {
            builtin::require(index < layout_stage_count() && field < layout_stage_stride());
            return record_bank_words() + layout_slot_count() * layout_region_count() * layout_region_stride()
                + layout_shared_count() + index * layout_stage_stride() + field;
        }
        auto require_slot(u64 slot, u64 epoch) const -> bool {
            return slot < 2u64 && get_epoch(slot) == epoch && epoch != 0u64 && get_phase(slot) != 0u64;
        }
        auto get_owner(u64 slot) const -> u64 {
            builtin::require(slot < 2u64);
            if (slot == 0u64) {
                return slot0_owner;
            }
            return slot1_owner;
        }
        auto set_owner(u64 slot, u64 value) -> bool {
            builtin::require(slot < 2u64);
            if (slot == 0u64) {
                slot0_owner = value;
            } else {
                slot1_owner = value;
            }
            return true;
        }
        auto get_epoch(u64 slot) const -> u64 {
            builtin::require(slot < 2u64);
            if (slot == 0u64) {
                return slot0_epoch;
            }
            return slot1_epoch;
        }
        auto set_epoch(u64 slot, u64 value) -> bool {
            builtin::require(slot < 2u64);
            if (slot == 0u64) {
                slot0_epoch = value;
            } else {
                slot1_epoch = value;
            }
            return true;
        }
        auto get_phase(u64 slot) const -> u64 {
            builtin::require(slot < 2u64);
            if (slot == 0u64) {
                return slot0_phase;
            }
            return slot1_phase;
        }
        auto set_phase(u64 slot, u64 value) -> bool {
            builtin::require(slot < 2u64);
            if (slot == 0u64) {
                slot0_phase = value;
            } else {
                slot1_phase = value;
            }
            return true;
        }
        auto get_root_ticket(u64 slot) const -> u64 {
            builtin::require(slot < 2u64);
            if (slot == 0u64) {
                return slot0_root_ticket;
            }
            return slot1_root_ticket;
        }
        auto set_root_ticket(u64 slot, u64 value) -> bool {
            builtin::require(slot < 2u64);
            if (slot == 0u64) {
                slot0_root_ticket = value;
            } else {
                slot1_root_ticket = value;
            }
            return true;
        }
        auto get_tables(u64 slot) const -> u64 {
            builtin::require(slot < 2u64);
            if (slot == 0u64) {
                return slot0_tables;
            }
            return slot1_tables;
        }
        auto set_tables(u64 slot, u64 value) -> bool {
            builtin::require(slot < 2u64);
            if (slot == 0u64) {
                slot0_tables = value;
            } else {
                slot1_tables = value;
            }
            return true;
        }
        auto get_leaves(u64 slot) const -> u64 {
            builtin::require(slot < 2u64);
            if (slot == 0u64) {
                return slot0_leaves;
            }
            return slot1_leaves;
        }
        auto set_leaves(u64 slot, u64 value) -> bool {
            builtin::require(slot < 2u64);
            if (slot == 0u64) {
                slot0_leaves = value;
            } else {
                slot1_leaves = value;
            }
            return true;
        }
        auto get_heap(u64 slot) const -> u64 {
            builtin::require(slot < 2u64);
            if (slot == 0u64) {
                return slot0_heap;
            }
            return slot1_heap;
        }
        auto set_heap(u64 slot, u64 value) -> bool {
            builtin::require(slot < 2u64);
            if (slot == 0u64) {
                slot0_heap = value;
            } else {
                slot1_heap = value;
            }
            return true;
        }
        auto get_heap_tables(u64 slot) const -> u64 {
            builtin::require(slot < 2u64);
            if (slot == 0u64) {
                return slot0_heap_tables;
            }
            return slot1_heap_tables;
        }
        auto set_heap_tables(u64 slot, u64 value) -> bool {
            builtin::require(slot < 2u64);
            if (slot == 0u64) {
                slot0_heap_tables = value;
            } else {
