export module kernel.snapshot;

// A copied value only. No storage/runtime graph or source authority is imported.
export namespace kernel {
    class Snapshot64 {
        array<u8, 64> bytes;
    public:
        Snapshot64() : bytes{} {
        }

        // This view is tied to the copied value, never to producer storage.
        auto view() const -> builtin::span<const u8> {
            return borrow_bytes(bytes);
        }

        auto at(i64 offset) const -> u8 {
            return bytes[offset];
        }

        auto set(i64 offset, u8 value) -> bool {
            if (offset < 0 || offset >= 64) {
                return false;
            }
            bytes[offset] = value;
            return true;
        }
    };
}
