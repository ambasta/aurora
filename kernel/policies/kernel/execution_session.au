export module kernel.execution_session;

export namespace kernel {
    class ExecutionResult {
        builtin::ExecStatus outcome;
        u64 result_value;
    public:
        ExecutionResult(builtin::ExecStatus status, u64 value) : outcome(status), result_value(value) {
        }
        auto status() const -> builtin::ExecStatus {
            return outcome;
        }
        auto value() const -> u64 {
            return result_value;
        }
    };

    // Command sequencing only. This ordinary local value is not an affine
    // child handle: execution authority stays in the exclusive effects loan.
    // Resident budgets, trap frames and the persistent service stay native.
    class ExecutionSession {
        bool running;
        bool close_owed;
        builtin::ExecStatus outcome;
        u64 result_value;
        builtin::ExecFinish disposition;
    public:
        ExecutionSession(builtin::ExecutionPrep prepared) : running(prepared.state == builtin::ExecPrepared::loaded),
            close_owed(prepared.finish_required), outcome(prepared.status), result_value(0u64),
            disposition(builtin::ExecFinish::complete) {
        }
        auto active() const -> bool {
            return running;
        }
        auto finish_required() const -> bool {
            return close_owed;
        }
        auto finish_kind() const -> builtin::ExecFinish {
            return disposition;
        }
        auto retired(builtin::ExecutionStep step) -> bool {
            outcome = step.status;
            result_value = step.value;
            running = false;
            return true;
        }
        auto output_failed() -> bool {
            outcome = builtin::ExecStatus::output_failed;
            result_value = 0u64;
            disposition = builtin::ExecFinish::output_failed;
            running = false;
            return true;
        }
        auto requested(builtin::ExecRequest result) -> bool {
            if (result == builtin::ExecRequest::cancelled) {
                outcome = builtin::ExecStatus::watchdog;
                result_value = 0u64;
                disposition = builtin::ExecFinish::cancelled;
                running = false;
            }
            if (result == builtin::ExecRequest::service_lost) {
                outcome = builtin::ExecStatus::unavailable;
                result_value = 0u64;
                disposition = builtin::ExecFinish::service_lost;
                running = false;
            }
            return true;
        }
        auto finished(builtin::ExecEffect result) -> bool {
            close_owed = false;
            if (result == builtin::ExecEffect::failed) {
                outcome = builtin::ExecStatus::unavailable;
                result_value = 0u64;
            }
            return true;
        }
        auto result() const -> ExecutionResult {
            const ExecutionResult result = ExecutionResult(outcome, result_value);
            return result;
        }
    };

    // The retained session spans each synchronous effect. No service reference
    // escapes, and no native callback borrows or mutates this source state.
    auto execute_command(builtin::ExecutionEffects& effects) -> ExecutionResult {
        const builtin::ExecutionPrep prepared = effects.prepare();
        ExecutionSession session = ExecutionSession(prepared);
        while (session.active()) {
            const builtin::ExecutionStep step = effects.advance();
            if (step.state == builtin::ExecStep::retired) {
                session.retired(step);
            }
            if (step.state == builtin::ExecStep::output) {
                const builtin::ExecEffect output = effects.output();
                if (output == builtin::ExecEffect::failed) {
                    session.output_failed();
                }
            }
            if (step.state == builtin::ExecStep::request) {
                const builtin::ExecRequest requested = effects.request();
                session.requested(requested);
            }
        }
        if (session.finish_required()) {
            const builtin::ExecFinish disposition = session.finish_kind();
            const builtin::ExecEffect finished = effects.finish(disposition);
            session.finished(finished);
        }
        const ExecutionResult result = session.result();
        return result;
    }
}
