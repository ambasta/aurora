export module kernel.execution_session;

export namespace kernel {
    class ExecutionResult {
        builtin::ExecStatus outcome;
        u64 result_value;
    public:
        ExecutionResult(builtin::ExecStatus status, u64 value) : outcome(status), result_value(value) {
        }
        auto status() const -> builtin::ExecStatus {
            return outcome;
        }
        auto value() const -> u64 {
            return result_value;
        }
    };

    enum class ExecutionPhase {
        client,
        request,
        output,
        cancelling,
        terminal
    };

    auto prepared_phase(builtin::ExecPrepared prepared) -> ExecutionPhase {
        if (prepared == builtin::ExecPrepared::loaded) {
            return ExecutionPhase::client;
        }
        return ExecutionPhase::terminal;
    }

    // The operation owns its lease and sequencing together, including refusal
    // and close obligations without a live child. It cannot outlive its issuer.
    class CommandExecution {
        builtin::ExecutionLease lease;
        ExecutionPhase phase;
        builtin::ExecStatus outcome;
        u64 result_value;
        builtin::ExecFinish disposition;
        auto requested(builtin::ExecRequest result) -> bool {
            if (result == builtin::ExecRequest::ready && phase != ExecutionPhase::cancelling) {
                phase = ExecutionPhase::client;
            }
            // A pending observation preserves the request phase. Only the
            // source loop chooses another bounded service progress effect.
            if (result == builtin::ExecRequest::cancelled) {
                if (outcome != builtin::ExecStatus::output_failed) {
                    outcome = builtin::ExecStatus::watchdog;
                    result_value = 0u64;
                    disposition = builtin::ExecFinish::cancelled;
                }
                phase = ExecutionPhase::terminal;
            }
            if (result == builtin::ExecRequest::cancel_requested) {
                if (outcome != builtin::ExecStatus::output_failed) {
                    outcome = builtin::ExecStatus::cancelled;
                    result_value = 0u64;
                    disposition = builtin::ExecFinish::cancel_requested;
                }
                phase = ExecutionPhase::terminal;
            }
            if (result == builtin::ExecRequest::service_lost) {
                outcome = builtin::ExecStatus::unavailable;
                result_value = 0u64;
                disposition = builtin::ExecFinish::service_lost;
                phase = ExecutionPhase::terminal;
            }
            return true;
        }
        auto cancelled(builtin::ExecCancel result) -> bool {
            if (result == builtin::ExecCancel::draining) {
                phase = ExecutionPhase::cancelling;
            }
            if (result == builtin::ExecCancel::settled && phase != ExecutionPhase::terminal) {
                outcome = builtin::ExecStatus::cancelled;
                result_value = 0u64;
                disposition = builtin::ExecFinish::cancel_requested;
                phase = ExecutionPhase::terminal;
            }
            if (result == builtin::ExecCancel::service_lost) {
                outcome = builtin::ExecStatus::unavailable;
                result_value = 0u64;
                disposition = builtin::ExecFinish::service_lost;
                phase = ExecutionPhase::terminal;
            }
            return true;
        }
    public:
        CommandExecution(builtin::ExecutionLease input) : lease(move(input)), phase(ExecutionPhase::terminal),
            outcome(builtin::ExecStatus::unavailable), result_value(0u64), disposition(builtin::ExecFinish::complete) {
            const builtin::ExecutionPrep prepared = lease.preparation();
            phase = prepared_phase(prepared.state);
            outcome = prepared.status;
        }
        auto active() const -> bool {
            return phase != ExecutionPhase::terminal;
        }
        auto awaiting_request() const -> bool {
            return phase == ExecutionPhase::request || phase == ExecutionPhase::cancelling;
        }
        auto awaiting_output() const -> bool {
            return phase == ExecutionPhase::output;
        }
        auto cancel() -> bool {
            const builtin::ExecCancel result = lease.cancel();
            cancelled(result);
            return active();
        }
        // One bounded progress turn. Output stays observable until a later
        // turn, so explicit cancellation can withdraw it before delivery.
        auto advance() -> bool {
            if (phase == ExecutionPhase::terminal) {
                return false;
            }
            if (awaiting_request()) {
                const builtin::ExecRequest requested_result = lease.request();
                requested(requested_result);
            } else {
                if (phase == ExecutionPhase::output) {
                    const builtin::ExecEffect delivered = lease.output();
                    if (delivered == builtin::ExecEffect::failed) {
                        outcome = builtin::ExecStatus::output_failed;
                        result_value = 0u64;
                        disposition = builtin::ExecFinish::output_failed;
                        phase = ExecutionPhase::terminal;
                        cancel();
                    } else {
                        phase = ExecutionPhase::client;
                    }
                } else {
                    const builtin::ExecutionStep step = lease.advance();
                    if (step.state == builtin::ExecStep::retired) {
                        outcome = step.status;
                        result_value = step.value;
                        phase = ExecutionPhase::terminal;
                    }
                    if (step.state == builtin::ExecStep::output) {
                        phase = ExecutionPhase::output;
                    }
                    if (step.state == builtin::ExecStep::request) {
                        phase = ExecutionPhase::request;
                    }
                }
            }
            return active();
        }
        // Consumption is explicit and in place. The caller must visibly drain
        // dispatched requests first; this terminal operation never hides a wait.
        auto finish() && -> ExecutionResult {
            builtin::ExecStatus status = outcome;
            u64 value = result_value;
            const builtin::ExecFinish finish_disposition = disposition;
            const builtin::ExecEffect finished = lease.finish(finish_disposition);
            if (finished == builtin::ExecEffect::failed) {
                status = builtin::ExecStatus::unavailable;
                value = 0u64;
            }
            const ExecutionResult result = ExecutionResult(status, value);
            return result;
        }
    };

    auto execute_command(builtin::ExecutionEffects& effects) -> ExecutionResult {
        builtin::ExecutionLease lease = effects.prepare();
        CommandExecution command = CommandExecution(move(lease));
        while (command.active()) {
            command.advance();
        }
        const ExecutionResult result = move(command).finish();
        return result;
    }
}
