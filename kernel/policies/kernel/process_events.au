export module kernel.process_events;
import kernel.process_memory;
import kernel.process_space;

// Kernel entries from a running process (kernel/uefi/process.md#entries): the
// classification of a copied CPU frame and the decoding of a kernel call. The
// supervisor copies the frame and registers; the decisions carry no address,
// mapping or authority. A frame this policy does not verify as the process's
// own user frame is kernel: the machine stops.
export namespace kernel {
    enum class TrapClass {
        kernel,
        timer,
        call,
        system_call,
        invalid_opcode,
        stack_guard,
        page_fault,
        protection,
        divide,
        debug,
        breakpoint,
        overflow,
        bound,
        fpu,
        alignment,
        simd
    };

    // The interrupt frame and the two instruction bytes at its RIP (opcode,
    // first byte in bits 0..7, or above 65535 when they are not executable).
    class ProcessTrap {
    public:
        u64 vector;
        u64 error;
        u64 rip;
        u64 cs;
        u64 flags;
        u64 rsp;
        u64 ss;
        u64 cr2;
        u64 opcode;
    };

    enum class CallAction {
        invalid,
        exit,
        print,
        read,
        map,
        remap,
        unmap,
        open_directory,
        open_beneath,
        open_file,
        close,
        create_output,
        write,
        commit,
        discard
    };

    // A decoded kernel call: exit with value, print length bytes at base to
    // stream value (1 stdout, 2 stderr), read file value at offset length
    // into the 504 bytes at base, a memory call
    // (kernel/uefi/process.md#memory): map length bytes, remap the mapping at
    // base from value bytes to length bytes, unmap length bytes at base, or a
    // file call (kernel/uefi/process.md#files) on handle value with length
    // bytes (a path or data) at base and its 48-byte result record at record.
    class KernelCall {
        CallAction _action;
        u64 _value;
        u64 _length;
        u64 _base;
        u64 _record;
    public:
        KernelCall(CallAction action, u64 value, u64 length, u64 base, u64 record) : _action(action), _value(value),
            _length(length), _base(base), _record(record) {
        }
        auto action() const -> CallAction {
            return _action;
        }
    };

    // User code 0x1b and data 0x23; RFLAGS with IF and bit 1 set, IOPL 0 and
    // only the bits CPL 3 can change (arithmetic, TF, DF, NT, RF, AC, ID).
    auto user_frame(ProcessTrap trap) -> bool {
        const u64 allowed = 2445271u64;
        return trap.cs == 27u64 && trap.ss == 35u64 && trap.rip < 140737488355328u64 && (trap.flags & 514u64) == 514u64
            && (trap.flags & ~allowed) == 0u64;
    }

    auto process_trap(ProcessTrap trap) -> TrapClass {
        if (!user_frame(trap)) {
            return TrapClass::kernel;
        }
        const u64 vector = trap.vector;
        if (vector == 64u64) {
            return TrapClass::timer;
        }
        if (vector == 131u64) {
            return TrapClass::call;
        }
        if (vector == 6u64) {
            // SYSCALL (0f 05) and SYSENTER (0f 34) are not enabled for processes.
            if (trap.opcode == 1295u64 || trap.opcode == 13327u64) {
                return TrapClass::system_call;
            }
            return TrapClass::invalid_opcode;
        }
        if (vector == 14u64) {
            if (trap.cr2 >= stack_guard() && trap.cr2 < stack_bottom()) {
                return TrapClass::stack_guard;
            }
            return TrapClass::page_fault;
        }
        if (vector == 11u64 || vector == 12u64 || vector == 13u64) {
            return TrapClass::protection;
        }
        if (vector == 0u64) {
            return TrapClass::divide;
        }
        if (vector == 1u64) {
            return TrapClass::debug;
        }
        if (vector == 3u64) {
            return TrapClass::breakpoint;
        }
        if (vector == 4u64) {
            return TrapClass::overflow;
        }
        if (vector == 5u64) {
            return TrapClass::bound;
        }
        if (vector == 7u64 || vector == 16u64) {
            return TrapClass::fpu;
        }
        if (vector == 17u64) {
            return TrapClass::alignment;
        }
        if (vector == 19u64) {
            return TrapClass::simd;
        }
        // NMI, double fault, machine check and the rest are not program faults.
        return TrapClass::kernel;
    }

    // A mapping's base: a page of the memory area.
    auto memory_base_address(u64 base) -> bool {
        return base >= memory_base() && base < memory_limit() && base % 4096u64 == 0u64;
    }

    // Operation 1 exit(status 0..255), 2 print(stream, buffer, length up to
    // 64 KiB), 3 read(file, offset, chunk); 4 map(bytes), 5 remap(base,
    // bytes, new bytes) and 6 unmap(base, bytes), with whole-page lengths up
    // to 64 TiB and a base in the memory area; the file calls 7
    // open_directory, 8 open_beneath, 9 open_file and 11 create_output
    // (handle, path, length up to 64 KiB, record), 10 close(handle), 12
    // write(output, buffer, length up to 64 KiB), 13 commit(output) and 14
    // discard(output); arguments an operation does not use are ignored.
    // Anything else is invalid.
    auto process_call(u64 operation, u64 first, u64 second, u64 third, u64 fourth) -> KernelCall {
        const KernelCall invalid = KernelCall(CallAction::invalid, 0u64, 0u64, 0u64, 0u64);
        if (operation == 1u64) {
            if (first > 255u64) {
                return invalid;
            }
            const KernelCall exit = KernelCall(CallAction::exit, first, 0u64, 0u64, 0u64);
            return exit;
        }
        if (operation == 2u64) {
            if ((first != 1u64 && first != 2u64) || third > arguments_limit()) {
                return invalid;
            }
            const KernelCall print = KernelCall(CallAction::print, first, third, second, 0u64);
            return print;
        }
        if (operation == 3u64) {
            const KernelCall read = KernelCall(CallAction::read, first, second, third, 0u64);
            return read;
        }
        if (operation == 4u64 && memory_length(first)) {
            const KernelCall map = KernelCall(CallAction::map, 0u64, first, 0u64, 0u64);
            return map;
        }
        if (operation == 5u64 && memory_base_address(first) && memory_length(second) && memory_length(third)) {
            const KernelCall remap = KernelCall(CallAction::remap, second, third, first, 0u64);
            return remap;
        }
        if (operation == 6u64 && memory_base_address(first) && memory_length(second)) {
            const KernelCall unmap = KernelCall(CallAction::unmap, 0u64, second, first, 0u64);
            return unmap;
        }
        if ((operation == 7u64 || operation == 9u64 || operation == 11u64) && third <= arguments_limit()) {
            CallAction action = CallAction::open_directory;
            if (operation == 9u64) {
                action = CallAction::open_file;
            }
            if (operation == 11u64) {
                action = CallAction::create_output;
            }
            const KernelCall path = KernelCall(action, 0u64, third, second, fourth);
            return path;
        }
        if (operation == 8u64 && third <= arguments_limit()) {
            const KernelCall beneath = KernelCall(CallAction::open_beneath, first, third, second, fourth);
            return beneath;
        }
        if (operation == 12u64 && third <= arguments_limit()) {
            const KernelCall write = KernelCall(CallAction::write, first, third, second, 0u64);
            return write;
        }
        if (operation == 10u64 || operation == 13u64 || operation == 14u64) {
            CallAction action = CallAction::close;
            if (operation == 13u64) {
                action = CallAction::commit;
            }
            if (operation == 14u64) {
                action = CallAction::discard;
            }
            const KernelCall handle = KernelCall(action, first, 0u64, 0u64, 0u64);
            return handle;
        }
        return invalid;
    }
}
