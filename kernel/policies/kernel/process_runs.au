export module kernel.process_runs;
import std.binary;

// A run list (kernel/uefi/process.md#run-lists): an ordinary boot-volume entry
// naming the programs one boot runs in order, each with its argument block and
// watchdog budget and frame quota. One canonical little-endian layout: a
// 16-byte header (magic "AURORUNS", version 2, count 1..64), then per run a
// 24-byte record (ticks 1..128, path bytes 1..255, argument bytes 1..65536,
// flags 0..15, then the memory quota in frames, 0 for every free frame), the
// path, the arguments (NUL-terminated words, so the last byte is zero) and
// zero padding to 8 bytes, ending exactly at the end of the entry. Flag 8
// makes each of the run's ticks 128 times longer, for runs of minutes; the
// others are process-image fixtures: 1 faults the kernel during the run's
// first kernel call, 2 checks that the load walk rejects edited tables, 4
// walks the whole space after every memory call and commit. Admission
// returns the first violated rule.
export namespace kernel {
    enum class RunsVerdict {
        valid,
        truncated,
        magic,
        version,
        count,
        ticks,
        path,
        arguments,
        flags,
        padding,
        trailing
    };

    // The index-th run of an admitted list: offsets are within the list.
    class RunEntry {
    public:
        u64 found;
        u64 ticks;
        u64 flags;
        u64 quota;
        u64 path;
        u64 path_bytes;
        u64 arguments;
        u64 argument_bytes;
    };

    // "AURORUNS" little-endian.
    auto runs_magic() -> u64 {
        return 6002829165337924929u64;
    }

    auto runs_word(builtin::span<const u8> runs, i64 offset) -> u64 {
        const std::ByteReadResult word = std::read_le64(runs, offset);
        return word.value_or(18446744073709551615u64);
    }

    auto runs_half(builtin::span<const u8> runs, i64 offset) -> u64 {
        const std::ByteReadResult half = std::read_le32(runs, offset);
        return half.value_or(18446744073709551615u64);
    }

    // The bytes of one record and its payload, padded to 8; the fields are
    // bounded first.
    auto record_bytes(u64 path, u64 arguments) -> i64 {
        const i64 used = 24 + i64(path) + i64(arguments);
        return (used + 7) / 8 * 8;
    }

    // The verdict of the record at offset, whose 24 bytes are present.
    auto run_record(builtin::span<const u8> runs, i64 offset) -> RunsVerdict {
        const u64 ticks = runs_half(runs, offset);
        const u64 path = runs_half(runs, offset + 4);
        const u64 arguments = runs_half(runs, offset + 8);
        const u64 flags = runs_half(runs, offset + 12);
        if (ticks == 0u64 || ticks > 128u64) {
            return RunsVerdict::ticks;
        }
        if (path == 0u64 || path > 255u64) {
            return RunsVerdict::path;
        }
        if (arguments == 0u64 || arguments > 65536u64) {
            return RunsVerdict::arguments;
        }
        if (flags > 15u64) {
            return RunsVerdict::flags;
        }
        if (i64(path) + i64(arguments) > runs.size() - offset - 24) {
            return RunsVerdict::truncated;
        }
        const i64 last = offset + 24 + i64(path) + i64(arguments) - 1;
        if (runs.at(last) != 0u8) {
            return RunsVerdict::arguments;
        }
        const i64 end = offset + record_bytes(path, arguments);
        if (end > runs.size()) {
            return RunsVerdict::truncated;
        }
        i64 at = last + 1;
        while (at < end) {
            if (runs.at(at) != 0u8) {
                return RunsVerdict::padding;
            }
            at = at + 1;
        }
        return RunsVerdict::valid;
    }

    auto runs_admit(builtin::span<const u8> runs) -> RunsVerdict {
        if (runs.size() < 16) {
            return RunsVerdict::truncated;
        }
        if (runs_word(runs, 0) != runs_magic()) {
            return RunsVerdict::magic;
        }
        if (runs_half(runs, 8) != 2u64) {
            return RunsVerdict::version;
        }
        const u64 count = runs_half(runs, 12);
        if (count == 0u64 || count > 64u64) {
            return RunsVerdict::count;
        }
        i64 offset = 16;
        i64 index = 0;
        while (index < i64(count)) {
            if (runs.size() - offset < 24) {
                return RunsVerdict::truncated;
            }
            const RunsVerdict record = run_record(runs, offset);
            if (record != RunsVerdict::valid) {
                return record;
            }
            offset = offset + record_bytes(runs_half(runs, offset + 4), runs_half(runs, offset + 8));
            index = index + 1;
        }
        if (offset != runs.size()) {
            return RunsVerdict::trailing;
        }
        return RunsVerdict::valid;
    }

    auto run_entry(builtin::span<const u8> runs, i64 index) -> RunEntry {
        const RunEntry absent = RunEntry{
            .found = 0u64,
            .ticks = 0u64,
            .flags = 0u64,
            .quota = 0u64,
            .path = 0u64,
            .path_bytes = 0u64,
            .arguments = 0u64,
            .argument_bytes = 0u64
        };
        if (index < 0 || runs_admit(runs) != RunsVerdict::valid || u64(index) >= runs_half(runs, 12)) {
            return absent;
        }
        i64 offset = 16;
        i64 at = 0;
        while (at < index) {
            offset = offset + record_bytes(runs_half(runs, offset + 4), runs_half(runs, offset + 8));
            at = at + 1;
        }
        const u64 path = runs_half(runs, offset + 4);
        const RunEntry entry = RunEntry{
            .found = 1u64,
            .ticks = runs_half(runs, offset),
            .flags = runs_half(runs, offset + 12),
            .quota = runs_word(runs, offset + 16),
            .path = u64(offset + 24),
            .path_bytes = path,
            .arguments = u64(offset + 24) + path,
            .argument_bytes = runs_half(runs, offset + 8)
        };
        return entry;
    }
}
