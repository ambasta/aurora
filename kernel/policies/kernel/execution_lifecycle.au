export module kernel.execution_lifecycle;

export namespace kernel {
    class LifecycleResult {
    public:
        u64 event;
        u64 detail;
        u64 generation;
        LifecycleResult(u64 selected, u64 value, u64 incarnation) : event(selected), detail(value),
            generation(incarnation) {
        }
    };

    // Two fixed flat slots. The private authority is nonmintable/noncopyable;
    // native storage and field effects authenticate this exact retained root.
    // Each slot: phase, generation, MM epoch/root, service, initial/saved frame
    // identity, entry mode, primary event/detail, exhaustion, pending operation,
    // selected terminal event/detail, and two reserved zero words.
    class ExecutionOwner {
        builtin::ExecutionAuthority authority;
        array<u64, 32> state;

        auto same(i64 at, builtin::ExecutionObservation observed) const -> bool {
            return observed.epoch == state[at + 2] && observed.root == state[at + 3] && observed.service == state[at
                + 4] && observed.initial == state[at + 5] && observed.saved == state[at + 6] && observed.exhausted
                <= 1u64;
        }
        auto accept(u64 slot, builtin::ExecutionObservation observed) -> LifecycleResult {
            const i64 at = i64(slot) * 16;
            builtin::require(same(at, observed));
            u64 selected = observed.event;
            u64 terminal_detail = observed.detail;
            if (observed.event == 14u64) {
                // Native reports authenticated facts, never a selected reason.
                const u64 evidence = observed.detail;
                builtin::require(evidence != 0u64 && evidence < 32u64 && observed.exhausted == 0u64);
                builtin::require((evidence & 2u64) == 0u64 || (evidence & 8u64) != 0u64);
                builtin::require((evidence & 4u64) == 0u64 || (evidence & 10u64) == 10u64);
                if ((evidence & 16u64) != 0u64) {
                    builtin::require((evidence & 7u64) == 0u64);
                } else {
                    if (state[at] == 1u64) {
                        // An admitted command may be cancelled before entry.
                        builtin::require(evidence == 10u64 && state[at + 11] == 0u64);
                    } else {
                        builtin::require(state[at] == 3u64);
                        if ((evidence & 1u64) != 0u64) {
                            builtin::require(state[at + 11] == 5u64);
                        } else {
                            if ((evidence & 2u64) == 0u64) {
                                builtin::require(state[at + 11] == 4u64);
                            }
                        }
                    }
                }
                terminal_detail = 0u64;
                if ((evidence & 16u64) != 0u64) {
                    selected = 12u64;
                } else {
                    if ((evidence & 1u64) != 0u64) {
                        selected = 9u64;
                        terminal_detail = 2u64;
                    } else {
                        builtin::require((evidence & 8u64) != 0u64);
                        selected = 10u64;
                        if ((evidence & 2u64) != 0u64 && (evidence & 4u64) == 0u64) {
                            selected = 11u64;
                        }
                    }
                }
            } else {
                builtin::require(observed.event >= 2u64 && observed.event <= 8u64);
                // Stop accounting can exhaust even after a fault/invalid call.
                if (observed.exhausted != 0u64) {
                    selected = 10u64;
                    terminal_detail = 0u64;
                }
            }
            state[at + 8] = observed.event;
            state[at + 9] = observed.detail;
            state[at + 10] = observed.exhausted;
            if (selected >= 2u64 && selected <= 5u64) {
                state[at + 11] = 0u64;
                if (selected != 2u64) {
                    state[at + 11] = selected;
                }
                state[at] = 3u64;
                return LifecycleResult(selected, observed.detail, state[at + 1]);
            }
            // Revocation precedes all seal/abandon/release/scrub effects.
            state[at + 12] = selected;
            state[at + 13] = terminal_detail;
            state[at] = 4u64;
            builtin::require(authority.retire(slot));
            const LifecycleResult result = LifecycleResult(selected, terminal_detail, state[at + 1]);
            i64 word = 2;
            while (word < 16) {
                state[at + word] = 0u64;
                word = word + 1;
            }
            // Empty is published only after complete physical role cleanup.
            state[at] = 0u64;
            return result;
        }
    public:
        ExecutionOwner(builtin::ExecutionAuthority input) : authority(move(input)), state{} {
        }
        auto can_prepare(u64 slot) const -> bool {
            if (slot >= 2u64) {
                return false;
            }
            const i64 at = i64(slot) * 16;
            return state[at] == 0u64 && state[at + 1] != 18446744073709551615u64;
        }
        auto prepare(u64 slot) -> bool {
            if (!can_prepare(slot)) {
                return false;
            }
            const i64 at = i64(slot) * 16;
            const builtin::ExecutionObservation observed = authority.prepare(slot);
            if (observed.event != 1u64 || observed.detail != 0u64 || observed.exhausted != 0u64 || observed.epoch
                == 0u64 || observed.root == 0u64 || observed.initial == 0u64 || observed.saved == 0u64) {
                return false;
            }
            state[at + 1] = state[at + 1] + 1u64;
            state[at + 2] = observed.epoch;
            state[at + 3] = observed.root;
            state[at + 4] = observed.service;
            state[at + 5] = observed.initial;
            state[at + 6] = observed.saved;
            state[at] = 1u64;
            return true;
        }
        auto execute(u64 slot) -> LifecycleResult {
            if (slot >= 2u64) {
                return LifecycleResult(0u64, 0u64, 0u64);
            }
            const i64 at = i64(slot) * 16;
            if ((state[at] != 1u64 && state[at] != 3u64) || state[at + 11] != 0u64) {
                return LifecycleResult(0u64, 0u64, state[at + 1]);
            }
            state[at + 7] = 0u64;
            if (state[at] == 3u64) {
                state[at + 7] = 1u64;
            }
            state[at] = 2u64;
            const builtin::ExecutionObservation observed = authority.activate(slot);
            builtin::require(observed.event >= 2u64 && observed.event <= 8u64);
            return accept(slot, observed);
        }
        auto force(u64 slot) -> LifecycleResult {
            if (slot >= 2u64) {
                return LifecycleResult(0u64, 0u64, 0u64);
            }
            const i64 at = i64(slot) * 16;
            if (state[at] != 1u64 && state[at] != 3u64) {
                return LifecycleResult(0u64, 0u64, state[at + 1]);
            }
            const builtin::ExecutionObservation observed = authority.force(slot);
            if (observed.event != 14u64) {
                return LifecycleResult(0u64, 0u64, state[at + 1]);
            }
            return accept(slot, observed);
        }
        auto complete(u64 slot) -> bool {
            if (slot >= 2u64) {
                return false;
            }
            const i64 at = i64(slot) * 16;
            if (state[at] != 3u64 || state[at + 11] < 3u64 || state[at + 11] > 5u64) {
                return false;
            }
            const builtin::ExecutionObservation observed = authority.complete(slot);
            builtin::require(same(at, observed) && observed.event == 13u64 && observed.detail == 0u64
                && observed.exhausted == 0u64);
            state[at + 11] = 0u64;
            return true;
        }
        auto phase(u64 slot) const -> u64 {
            if (slot >= 2u64) {
                return 5u64;
            }
            return state[i64(slot) * 16];
        }
        auto pending(u64 slot) const -> u64 {
            if (slot >= 2u64) {
                return 0u64;
            }
            return state[i64(slot) * 16 + 11];
        }
        auto generation(u64 slot) const -> u64 {
            if (slot >= 2u64) {
                return 0u64;
            }
            return state[i64(slot) * 16 + 1];
        }
        auto finish() && -> bool {
            // A consuming entry cannot silently abandon an owned slot.
            builtin::require(state[0] == 0u64 && state[16] == 0u64);
            return authority.finish();
        }
    };
}
