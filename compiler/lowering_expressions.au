export module aurora.compiler.lowering_expressions;
import aurora.compiler.lexer;
import aurora.compiler.lowering_values;
import aurora.compiler.lowering_common;
import aurora.compiler.lowering_types;
import aurora.compiler.lowering_configuration;
import aurora.compiler.lowering_storage;
import aurora.compiler.lowering_kinds;
import aurora.compiler.lowering_errors;
import aurora.compiler.resolver;
import aurora.compiler.resolution_arena;
import aurora.compiler.resolution_rows;
import aurora.compiler.resolution_kinds;
import aurora.compiler.syntax_arena;
import aurora.compiler.lowering_frames;
import aurora.compiler.lowering_calls;

// Indexing, construction, names, scalar builtins and expression dispatch.
export namespace compiler_lowering {
    class IndexedStorage {
        i64 rootId;
        i64 fieldId;
        i64 typeId;
    public:
        IndexedStorage(i64 root, i64 field, i64 type) : rootId(root), fieldId(field), typeId(type) {
        }
        auto root() const -> i64 {
            return rootId;
        }
        auto field() const -> i64 {
            return fieldId;
        }
        auto type() const -> i64 {
            return typeId;
        }
    };
    auto resolve_index(compiler_resolver::Session& session, i64 node) -> IndexedStorage {
        const i64 target = compiler_resolver::sw(session, node, 1);
        const compiler_resolver::SyntaxRow target_row = session.syntax(target);
        const i64 source = source_ref(session, node);
        if (target_row.expression_kind() != compiler_parser::NodeKind::name) {
            fail(session, LoweringError::indexing_requires_local_or_private_receiver_field, source);
            return IndexedStorage(-1, -1, -1);
        }
        const i64 name = source_ref(session, target);
        i64 root = -2;
        i64 field = -1;
        i64 type = -1;
        if (lookup_local(session, name) < 0) {
            field = implicit_field(session, name);
        }
        if (field >= 0) {
            if (!no_exclusive_object_loan(session, -2, source)) {
                return IndexedStorage(-1, -1, -1);
            }
            const i64 staged_nominal_92 = body_receiver_nominal(session);
            type = field_type(session, staged_nominal_92, field);
        } else {
            root = named_source(session, target);
            type = local_type(session, root);
        }
        if (value_kind(session, type) != compiler_resolver::ResolvedTypeKind::array_value) {
            fail(session, LoweringError::indexing_requires_local_or_receiver_field, source);
        }
        return IndexedStorage(root, field, type);
    }
    auto index_guard(compiler_resolver::Session& session, IndexedStorage storage) -> bool {
        if (is_class_array(session, storage.type())) {
            i64 offset = 0;
            i64 field = storage.field();
            if (storage.root() >= 0) {
                offset = local_offset(session, storage.root());
                field = 0;
            }
            emit_ClassArrayBoundsGuard(session, offset, field);
        } else {
            if (storage.field() >= 0) {
                emit_ReceiverBoundsGuard(session, storage.field());
            } else {
                const i64 staged_a0_93 = local_offset(session, storage.root());
                const i64 staged_a1_94 = compiler_resolver::mw(session, storage.type(), 3);
                const i64 staged_a2_95 = compiler_resolver::mw(session, storage.type(), 2);
                emit_BoundsGuard(session, staged_a0_93, staged_a1_94, staged_a2_95);
            }
        }
        return session.good();
    }
    auto begin_index(compiler_resolver::Session& session, i64 frame_id) -> bool {
        ContinuationRow frame = session.continuation(frame_id);
        const IndexedStorage storage = resolve_index(session, frame.syntax_node());
        frame.set_call(-1, storage.root(), storage.field(), 0);
        frame.set_cleanup_cursor(storage.type());
        frame.set_phase(ContinuationPhase::child);
        session.set_continuation(frame_id, frame);
        const i64 staged_node_96 = compiler_resolver::sw(session, frame.syntax_node(), 2);
        return push_expression(session, staged_node_96, -1, -1);
    }
    auto finish_index(compiler_resolver::Session& session, i64 frame_id) -> bool {
        const ContinuationRow frame = session.continuation(frame_id);
        const i64 source = source_ref(session, frame.syntax_node());
        const i64 staged_want_97 = scalar_id(session, compiler_resolver::ResolvedTypeKind::i64_value);
        match_type(session, frame.child_type_id(), staged_want_97, source);
        const IndexedStorage storage = IndexedStorage(frame.capability_root_local(), frame.receiver_field_index(),
            frame.cleanup_cursor());
        if (!no_exclusive_object_loan(session, storage.root(), source)) {
            return false;
        }
        index_guard(session, storage);
        const i64 element = compiler_resolver::mw(session, storage.type(), 2);
        if (is_class_array(session, storage.type())) {
            if (frame.output_mark() < 0) {
                return fail(session, LoweringError::class_array_copy_requires_typed_initializer, source);
            }
            match_type(session, element, frame.output_mark(), source);
            const i64 destination = expression_destination(session, frame, element, -1);
            i64 offset = 0;
            i64 field = storage.field();
            if (storage.root() >= 0) {
                offset = local_offset(session, storage.root());
                field = 0;
            }
            const i64 staged_a2_98 = local_offset(session, destination);
            emit_ClassArrayCopy(session, offset, field, staged_a2_98);
            return finish_expression(session, element, destination);
        }
        if (frame.output_mark() >= 0 && value_kind(session, frame.output_mark())
            == compiler_resolver::ResolvedTypeKind::class_value) {
            return fail(session, LoweringError::class_projection_requires_copied_array, source);
        }
        if (storage.field() >= 0) {
            emit_ReceiverIndexLoad(session, storage.field());
        } else {
            const i64 staged_a0_99 = local_offset(session, storage.root());
            const i64 staged_a1_100 = compiler_resolver::mw(session, storage.type(), 3);
            emit_IndexLoad(session, staged_a0_99, staged_a1_100, element);
        }
        return finish_expression(session, element, -1);
    }
    auto begin_class(compiler_resolver::Session& session, i64 frame_id) -> bool {
        ContinuationRow frame = session.continuation(frame_id);
        const i64 node = frame.syntax_node();
        const i64 type = frame.output_mark();
        const i64 definition = class_row(session, type);
        if (definition < 0) {
            return fail_type(session, LoweringError::unknown_class_type, frame.operand_mark(), type);
        }
        const i64 reference = source_ref(session, node);
        const compiler_resolver::SyntaxRow syntax = session.syntax(node);
        const bool argument = argument_use(session, frame_id);
        if (syntax.expression_kind() == compiler_parser::NodeKind::name && (argument || lookup_local(session, reference)
            >= 0)) {
            const i64 original = named_source(session, node);
            const i64 staged_got_101 = local_type(session, original);
            match_type(session, staged_got_101, type, reference);
            const i64 staged_type_102 = local_type(session, original);
            if (owning_type(session, staged_type_102)) {
                return fail(session, LoweringError::owning_class_copy, reference);
            }
            const LocalRow original_binding = session.local(original);
            if (original_binding.borrowed_object()) {
                return fail(session, LoweringError::borrowed_object_ownership_transfer, reference);
            }
            const i64 destination = expression_destination(session, frame, type, -1);
            const i64 staged_a0_103 = local_offset(session, original);
            const i64 staged_a1_104 = local_offset(session, destination);
            emit_CopyObject(session, staged_a0_103, staged_a1_104);
            return finish_expression(session, type, destination);
        }
        if (is_constructor_expression(session, node) || is_method_expression(session, node)
            || is_host_operation(session, node)) {
            return begin_call(session, frame_id);
        }
        if (syntax.expression_kind() == compiler_parser::NodeKind::call) {
            if (owning_type(session, type) && session.source_equal(reference, "move")) {
                const i64 original = moved_source(session, node, type);
                const LocalRow owner = session.local(original);
                const i64 destination = expression_destination(session, frame, type, owner.owner_id());
                emit_move(session, original, destination);
                return finish_expression(session, type, destination);
            }
            const compiler_resolver::ResolvedRow resolved = session.resolved(node);
            if (resolved.word(1) < 0 && resolved.word(4) < 0) {
                if (argument) {
                    return fail(session, LoweringError::class_argument_requires_complete_local, reference);
                }
                return fail(session, LoweringError::class_initializer_requires_class_result, reference);
            }
            return begin_call(session, frame_id);
        }
        if (argument) {
            const ContinuationRow parent = session.continuation(frame_id - 1);
            if (is_constructor_expression(session, parent.syntax_node())) {
                return fail(session, LoweringError::ownership_operation_requires_local, reference);
            }
            return fail(session, LoweringError::class_argument_requires_complete_local, reference);
        }
        if (syntax.expression_kind() == compiler_parser::NodeKind::index) {
            return begin_index(session, frame_id);
        }
        if (syntax.expression_kind() == compiler_parser::NodeKind::member || syntax.expression_kind()
            == compiler_parser::NodeKind::name) {
            i64 original = 0;
            i64 field = -1;
            i64 nominal = body_receiver_nominal(session);
            if (syntax.expression_kind() == compiler_parser::NodeKind::member) {
                const compiler_resolver::SyntaxRow target = session.syntax(syntax.word(1));
                if (target.expression_kind() != compiler_parser::NodeKind::name) {
                    return fail(session, LoweringError::class_projection_requires_named_receiver, reference);
                }
                const i64 local_id = named_source(session, syntax.word(1));
                const LocalRow local = session.local(local_id);
                if (local.borrowed_object()) {
                    return fail(session, LoweringError::borrowed_object_field_projection, reference);
                }
                original = local.offset();
                nominal = compiler_resolver::mw(session, local.concrete_type_id(), 1);
                field = checked_field(session, local.concrete_type_id(), reference, false);
            } else {
                field = implicit_field(session, reference);
                if (!no_exclusive_object_loan(session, -2, reference)) {
                    return false;
                }
                if (field < 0) {
                    return fail(session, LoweringError::class_projection_requires_class_field, reference);
                }
            }
            const i64 actual = field_type(session, nominal, field);
            match_type(session, actual, type, reference);
            if (owning_type(session, actual)) {
                return fail(session, LoweringError::owning_field_extraction, reference);
            }
            const i64 destination = expression_destination(session, frame, type, -1);
            const i64 staged_a2_105 = local_offset(session, destination);
            emit_ObjectFieldCopy(session, original, field, staged_a2_105);
            return finish_expression(session, type, destination);
        }
        const i64 nominal = compiler_resolver::mw(session, type, 1);
        if (constructor_symbol(session, nominal) >= 0) {
            return fail(session, LoweringError::constructor_class_designated_initialization, reference);
        }
        i64 field = 0;
        while (field < field_total(session, nominal)) {
            if (!field_public(session, nominal, field)) {
                return fail(session, LoweringError::private_class_construction_requires_constructor,
                    frame.operand_mark());
            }
            field = field + 1;
        }
        if (syntax.expression_kind() != compiler_parser::NodeKind::construct) {
            return fail(session, LoweringError::class_initializer_requires_fields_or_copy, reference);
        }
        const i64 staged_got_106 = compiler_resolver::rw(session, node, 2);
        match_type(session, staged_got_106, type, reference);
        const i64 first = ordered_first(session, syntax.word(1), 1);
        frame.set_cursor(first);
        frame.set_phase(ContinuationPhase::argument);
        session.set_continuation(frame_id, frame);
        if (first < 0) {
            return finish_designated(session, frame_id);
        }
        return advance_designated(session, frame_id);
    }
    auto advance_designated(compiler_resolver::Session& session, i64 frame_id) -> bool {
        const ContinuationRow frame = session.continuation(frame_id);
        const i64 field_source = compiler_resolver::sw(session, frame.cursor(), 4);
        const i64 field = checked_field(session, frame.output_mark(), field_source, true);
        if (session.index(116, body_function(session), frame.syntax_node(), field, 0) >= 0) {
            const OperandRow absent = scalar(OperandRole::NoDiagnosticValue, 0);
            return fail_synthetic(session, LoweringError::duplicate_field_initializer, field_source, absent, absent);
        }
        session.index_insert(116, body_function(session), frame.syntax_node(), field, 0, 0);
        const i64 staged_node_107 = compiler_resolver::sw(session, frame.cursor(), 0);
        return push_expression(session, staged_node_107, -1, -1);
    }
    auto finish_designated(compiler_resolver::Session& session, i64 frame_id) -> bool {
        const ContinuationRow frame = session.continuation(frame_id);
        const i64 type = frame.output_mark();
        const i64 nominal = compiler_resolver::mw(session, type, 1);
        const i64 count = compiler_resolver::sw(session, frame.syntax_node(), 2);
        if (count != field_total(session, nominal)) {
            const i64 staged_source_108 = source_ref(session, frame.syntax_node());
            return fail(session, LoweringError::incomplete_class_field_initialization, staged_source_108);
        }
        const i64 destination = expression_destination(session, frame, type, -1);
        if (count == 0) {
            const i64 staged_a0_109 = local_offset(session, destination);
            emit_InitializeEmptyObject(session, staged_a0_109);
        }
        i64 edge = compiler_resolver::sw(session, frame.syntax_node(), 1);
        while (edge >= 0 && session.good()) {
            const i64 field_source = compiler_resolver::sw(session, edge, 4);
            const i64 field = checked_field(session, type, field_source, true);
            emit_Pop(session);
            const i64 staged_a0_110 = local_offset(session, destination) - field_displacement(session, type, field);
            const i64 staged_a1_111 = field_type(session, nominal, field);
            emit_Store(session, staged_a0_110, staged_a1_111);
            edge = compiler_resolver::sw(session, edge, 1);
        }
        return finish_expression(session, type, destination);
    }
    auto step_designated(compiler_resolver::Session& session, i64 frame_id) -> bool {
        ContinuationRow frame = session.continuation(frame_id);
        const i64 field_source = compiler_resolver::sw(session, frame.cursor(), 4);
        const i64 field = checked_field(session, frame.output_mark(), field_source, true);
        const i64 nominal = compiler_resolver::mw(session, frame.output_mark(), 1);
        const i64 expected = field_type(session, nominal, field);
        if (frame.child_type_id() != expected) {
            const OperandRow wanted = scalar(OperandRole::DiagnosticTypeId, expected);
            const OperandRow got = scalar(OperandRole::DiagnosticTypeId, frame.child_type_id());
            return fail_synthetic(session, LoweringError::type_mismatch, field_source, wanted, got);
        }
        emit_Push(session);
        const i64 last = compiler_resolver::sw(session, frame.syntax_node(), 1);
        frame.set_cursor(ordered_next(session, last, frame.cursor(), 1));
        session.set_continuation(frame_id, frame);
        if (frame.cursor() < 0) {
            return finish_designated(session, frame_id);
        }
        return advance_designated(session, frame_id);
    }
    auto reflected_value(compiler_resolver::Session& session, i64 node) -> i64 {
        const i64 type = compiler_resolver::rw(session, node, 2);
        const i64 source = source_ref(session, node);
        if (is_class_array(session, type)) {
            class_carrier(session, type, source);
        }
        const compiler_resolver::ResolvedTypeKind kind = value_kind(session, type);
        if (is_span(session, type)) {
            return error(session, LoweringError::reflection_span_capability, source);
        }
        if (compiler_resolver::resource_kind(kind) || compiler_resolver::service_kind(kind)) {
            return error(session, LoweringError::reflection_resource_capability, source);
        }
        if (session.source_equal(source, "type_id")) {
            return reflection_id(session, type, source);
        }
        if (session.source_equal(source, "field_count")) {
            return resolved_field_count(session, type, source);
        }
        return type_size(session, type, source);
    }
    auto emit_name_expression(compiler_resolver::Session& session, i64 frame_id) -> bool {
        const ContinuationRow frame = session.continuation(frame_id);
        const i64 source = source_ref(session, frame.syntax_node());
        if (lookup_local(session, source) < 0) {
            const i64 field = implicit_field(session, source);
            if (field >= 0) {
                if (!no_exclusive_object_loan(session, -2, source)) {
                    return false;
                }
                const i64 staged_nominal_112 = body_receiver_nominal(session);
                const i64 type = field_type(session, staged_nominal_112, field);
                const compiler_resolver::ResolvedTypeKind kind = value_kind(session, type);
                if (kind == compiler_resolver::ResolvedTypeKind::array_value || kind
                    == compiler_resolver::ResolvedTypeKind::class_value || compiler_resolver::resource_kind(kind)) {
                    return fail(session, LoweringError::aggregate_field_requires_projection_or_indexing, source);
                }
                emit_ReceiverLoad(session, field, type);
                return finish_expression(session, type, -1);
            }
        }
        const i64 id = named_source(session, frame.syntax_node());
        const LocalRow local = session.local(id);
        const i64 type = local.concrete_type_id();
        const compiler_resolver::ResolvedTypeKind kind = value_kind(session, type);
        if (kind == compiler_resolver::ResolvedTypeKind::class_value && argument_use(session, frame_id)) {
            const i64 snapshot = copied_snapshot(session, id, source);
            return finish_expression(session, type, snapshot);
        }
        if (kind == compiler_resolver::ResolvedTypeKind::array_value) {
            return fail(session, LoweringError::array_value_requires_initializer_or_indexing, source);
        }
        if (kind == compiler_resolver::ResolvedTypeKind::class_value) {
            return fail(session, LoweringError::class_value_requires_initializer_or_field_access, source);
        }
        if (compiler_resolver::service_kind(kind)) {
            return fail(session, LoweringError::service_capability_not_value, source);
        }
        if (!compiler_resolver::scalar_value_kind(kind)) {
            return fail(session, LoweringError::implicit_owned_value_copy, source);
        }
        // Keep the legacy diagnostic precedence: the generic non-scalar guard
        // above wins for spans before this intentionally narrower check.
        if (is_span(session, type)) {
            return fail(session, LoweringError::span_capability_not_scalar, source);
        }
        const i64 staged_a1_113 = payload_type(session, type);
        emit_Load(session, local.offset(), staged_a1_113);
        return finish_expression(session, type, -1);
    }
    auto emit_member_expression(compiler_resolver::Session& session, i64 frame_id) -> bool {
        const ContinuationRow frame = session.continuation(frame_id);
        const i64 source = source_ref(session, frame.syntax_node());
        const i64 receiver = compiler_resolver::sw(session, frame.syntax_node(), 1);
        const compiler_resolver::SyntaxRow syntax = session.syntax(receiver);
        if (syntax.expression_kind() != compiler_parser::NodeKind::name) {
            return fail(session, LoweringError::field_access_requires_class_local, source);
        }
        const i64 id = named_source(session, receiver);
        const LocalRow local = session.local(id);
        if (local.borrowed_object()) {
            return fail(session, LoweringError::borrowed_object_field_access, source);
        }
        const i64 field = checked_field(session, local.concrete_type_id(), source, false);
        const i64 staged_nominal_114 = compiler_resolver::mw(session, local.concrete_type_id(), 1);
        const i64 type = field_type(session, staged_nominal_114, field);
        const compiler_resolver::ResolvedTypeKind kind = value_kind(session, type);
        if (kind == compiler_resolver::ResolvedTypeKind::array_value || kind
            == compiler_resolver::ResolvedTypeKind::class_value || compiler_resolver::resource_kind(kind)) {
            return fail(session, LoweringError::aggregate_field_requires_projection_or_indexing, source);
        }
        const i64 staged_a0_115 = local.offset() - field_displacement(session, local.concrete_type_id(), field);
        emit_Load(session, staged_a0_115, type);
        return finish_expression(session, type, -1);
    }
    auto begin_scalar_builtin(compiler_resolver::Session& session, i64 frame_id) -> bool {
        ContinuationRow frame = session.continuation(frame_id);
        const i64 node = frame.syntax_node();
        const i64 source = source_ref(session, node);
        const i64 integer = scalar_id(session, compiler_resolver::ResolvedTypeKind::i64_value);
        if (session.source_equal(source, "size_of") || session.source_equal(source, "type_id")
            || session.source_equal(source, "field_count")) {
            const i64 staged_number_116 = reflected_value(session, node);
            emit_signed(session, staged_number_116, integer);
            return finish_expression(session, integer, -1);
        }
        if (session.source_equal(source, "len")) {
            require_arity(session, node, 1);
            const i64 target = expression_argument(session, node, 0);
            const compiler_resolver::SyntaxRow syntax = session.syntax(target);
            if (syntax.expression_kind() != compiler_parser::NodeKind::name) {
                return fail(session, LoweringError::len_requires_local_or_receiver_array, source);
            }
            const i64 name = source_ref(session, target);
            i64 field = -1;
            i64 type = -1;
            if (lookup_local(session, name) < 0) {
                field = implicit_field(session, name);
            }
            if (field >= 0) {
                if (!no_exclusive_object_loan(session, -2, source)) {
                    return false;
                }
                const i64 staged_nominal_117 = body_receiver_nominal(session);
                type = field_type(session, staged_nominal_117, field);
            } else {
                const i64 staged_id_118 = named_source(session, target);
                type = local_type(session, staged_id_118);
            }
            if (value_kind(session, type) != compiler_resolver::ResolvedTypeKind::array_value) {
                return fail(session, LoweringError::len_requires_local_or_receiver_array, source);
            }
            const i64 staged_number_119 = compiler_resolver::mw(session, type, 3);
            emit_signed(session, staged_number_119, integer);
            return finish_expression(session, integer, -1);
        }
        if (session.source_equal(source, "read")) {
            require_arity(session, node, 1);
            const i64 staged_expression_120 = expression_argument(session, node, 0);
            i64 id = named_source(session, staged_expression_120);
            const LocalRow local = session.local(id);
            const SnapshotRow state = local.state();
            const compiler_resolver::ResolvedTypeKind kind = value_kind(session, local.concrete_type_id());
            if (kind != compiler_resolver::ResolvedTypeKind::owner && kind
                != compiler_resolver::ResolvedTypeKind::reference && kind
                != compiler_resolver::ResolvedTypeKind::mutable_reference) {
                return fail(session, LoweringError::read_requires_ownership_reference, source);
            }
            if (kind == compiler_resolver::ResolvedTypeKind::owner && state.exclusive()) {
                return fail(session, LoweringError::owner_exclusively_borrowed, source);
            }
            if (kind != compiler_resolver::ResolvedTypeKind::owner) {
                id = local.owner_id();
            }
            const i64 staged_a0_121 = local_offset(session, id);
            const i64 staged_type_122 = local_type(session, id);
            const i64 staged_a1_123 = payload_type(session, staged_type_122);
            emit_Load(session, staged_a0_121, staged_a1_123);
            return finish_expression(session, integer, -1);
        }
        if (session.source_equal(source, "write")) {
            require_arity(session, node, 2);
            const i64 staged_expression_124 = expression_argument(session, node, 0);
            const i64 id = named_source(session, staged_expression_124);
            const LocalRow local = session.local(id);
            const i64 staged_want_125 = scalar_id(session, compiler_resolver::ResolvedTypeKind::mutable_reference);
            match_type(session, local.concrete_type_id(), staged_want_125, source);
            if (!local.mutable_value()) {
                return fail(session, LoweringError::write_requires_mutable_reference, source);
            }
            frame.set_call(-1, local.owner_id(), -1, 0);
            frame.set_phase(ContinuationPhase::child);
            session.set_continuation(frame_id, frame);
            const i64 staged_node_126 = expression_argument(session, node, 1);
            return push_expression(session, staged_node_126, -1, -1);
        }
        if (session.source_equal(source, "u64") || session.source_equal(source, "u8") || session.source_equal(source,
            "i64") || session.source_equal(source, "reflect_size") || session.source_equal(source,
            "reflect_field_count")) {
            require_arity(session, node, 1);
            frame.set_phase(ContinuationPhase::child);
            session.set_continuation(frame_id, frame);
            const i64 staged_node_127 = expression_argument(session, node, 0);
            return push_expression(session, staged_node_127, -1, -1);
        }
        if (session.source_equal(source, "borrow_bytes")) {
            return fail(session, LoweringError::borrow_bytes_requires_span_binding_or_argument, source);
        }
        if (session.source_equal(source, "borrow_values")) {
            return fail(session, LoweringError::borrow_values_requires_span_binding_or_argument, source);
        }
        if (session.source_equal(source, "own") || session.source_equal(source, "move") || session.source_equal(source,
            "borrow") || session.source_equal(source, "borrow_mut")) {
            return fail(session, LoweringError::ownership_constructor_requires_typed_initializer, source);
        }
        return begin_call(session, frame_id);
    }
    auto finish_scalar_builtin(compiler_resolver::Session& session, i64 frame_id) -> bool {
        const ContinuationRow frame = session.continuation(frame_id);
        const i64 source = source_ref(session, frame.syntax_node());
        const i64 integer = scalar_id(session, compiler_resolver::ResolvedTypeKind::i64_value);
        i64 result = integer;
        if (session.source_equal(source, "write")) {
            match_type(session, frame.child_type_id(), integer, source);
            const i64 staged_a0_128 = local_offset(session, frame.capability_root_local());
            emit_Store(session, staged_a0_128, integer);
        } else {
            if (session.source_equal(source, "reflect_size") || session.source_equal(source, "reflect_field_count")) {
                match_type(session, frame.child_type_id(), integer, source);
                const i64 begin = session.operand_count();
                const i64 staged_row_129 = body_function(session);
                const i64 unit = compiler_resolver::mw(session, staged_row_129, 1);
                const i64 staged_value_130 = compiler_resolver::mw(session, unit, 13);
                put(session, OperandRole::ModuleScope, staged_value_130);
                OutputRow row = OutputRow(RecordKind::Instruction, InstructionForm::MetadataQuery, begin, 1);
                Query query = Query::Size;
                if (session.source_equal(source, "reflect_field_count")) {
                    query = Query::PublicFieldCount;
                }
                row.set_query(query);
                session.append_output(row);
            } else {
                if (session.source_equal(source, "u64")) {
                    result = scalar_id(session, compiler_resolver::ResolvedTypeKind::u64_value);
                }
                if (session.source_equal(source, "u8")) {
                    result = scalar_id(session, compiler_resolver::ResolvedTypeKind::u8_value);
                }
                const compiler_resolver::ResolvedTypeKind kind = value_kind(session, frame.child_type_id());
                if ((kind != compiler_resolver::ResolvedTypeKind::i64_value && kind
                    != compiler_resolver::ResolvedTypeKind::u64_value && kind
                    != compiler_resolver::ResolvedTypeKind::u8_value) || frame.child_type_id() == result) {
                    return fail(session, LoweringError::integer_conversion_types, source);
                }
                emit_Convert(session, frame.child_type_id(), result);
            }
        }
        return finish_expression(session, result, -1);
    }
    auto begin_service_resource(compiler_resolver::Session& session, i64 frame_id) -> bool {
        const ContinuationRow frame = session.continuation(frame_id);
        const i64 node = frame.syntax_node();
        const i64 source = source_ref(session, node);
        if (retained_resource(session, frame.output_mark())) {
            return fail(session, LoweringError::ownership_constructor_type, source);
        }
        if (frame.scope_head() < 0) {
            return fail(session, LoweringError::ownership_constructor_requires_typed_initializer, source);
        }
        const compiler_resolver::SyntaxRow syntax = session.syntax(node);
        if (syntax.expression_kind() == compiler_parser::NodeKind::call && session.source_equal(source, "move")) {
            const i64 original = moved_source(session, node, frame.output_mark());
            const LocalRow owner = session.local(original);
            const i64 destination = expression_destination(session, frame, frame.output_mark(), owner.owner_id());
            const i64 target = local_offset(session, destination);
            const i64 resource = service_resource_kind(session, frame.output_mark());
            emit_MoveServiceResource(session, owner.offset(), target, resource);
            set_live(session, original, false, false);
            return finish_expression(session, frame.output_mark(), destination);
        }
        if (syntax.expression_kind() == compiler_parser::NodeKind::method_call) {
            return begin_call(session, frame_id);
        }
        return fail(session, LoweringError::ownership_constructor_type, source);
    }
    auto begin_owned_storage(compiler_resolver::Session& session, i64 frame_id) -> bool {
        const ContinuationRow frame = session.continuation(frame_id);
        const i64 node = frame.syntax_node();
        const i64 reference = source_ref(session, node);
        const compiler_resolver::SyntaxRow syntax = session.syntax(node);
        if (syntax.expression_kind() == compiler_parser::NodeKind::call && session.source_equal(reference, "move")) {
            const i64 original = moved_source(session, node, frame.output_mark());
            const LocalRow owner = session.local(original);
            const i64 destination = expression_destination(session, frame, frame.output_mark(), owner.owner_id());
            const i64 staged_a1_131 = local_offset(session, destination);
            emit_MoveBytes(session, owner.offset(), staged_a1_131);
            const SnapshotRow state = owner.state();
            set_live(session, original, false, state.resource_active());
            return finish_expression(session, frame.output_mark(), destination);
        }
        if (syntax.expression_kind() == compiler_parser::NodeKind::method_call && session.source_equal(reference,
            "try_allocate")) {
            i64 count = 2;
            if (value_kind(session, frame.output_mark()) == compiler_resolver::ResolvedTypeKind::owned_values) {
                count = 3;
            }
            require_arity(session, node, count);
            const i64 staged_expression_132 = expression_argument(session, node, 0);
            const i64 region = named_source(session, staged_expression_132);
            const i64 region_type = scalar_id(session, compiler_resolver::ResolvedTypeKind::byte_region);
            const i64 staged_got_133 = local_type(session, region);
            match_type(session, staged_got_133, region_type, reference);
            ContinuationRow allocation = session.continuation(frame_id);
            allocation.set_call(-1, region, -1, count - 1);
            allocation.set_cleanup_cursor(region_type);
            allocation.set_phase(ContinuationPhase::argument);
            session.set_continuation(frame_id, allocation);
            return advance_call(session, frame_id);
        }
        const compiler_resolver::ResolvedRow resolved = session.resolved(node);
        bool resource_call = syntax.expression_kind() == compiler_parser::NodeKind::call && resolved.word(4) < 0
            && resolved.word(1) >= 0 && signature_count(session, resolved.word(1)) > 0;
        if (resource_call) {
            const i64 first_type = argument_type(session, resolved.word(1), 0);
            resource_call = value_kind(session, first_type) == compiler_resolver::ResolvedTypeKind::byte_region;
        }
        if (resource_call) {
            return begin_call(session, frame_id);
        }
        const ContinuationRow parent = session.continuation(frame_id - 1);
        if (parent.kind() == ContinuationKind::function && body_constructor(session)) {
            return fail(session, LoweringError::owning_transfer_requires_move, reference);
        }
        return fail(session, LoweringError::owned_bytes_initializer, reference);
    }
    auto begin_expression(compiler_resolver::Session& session, i64 frame_id) -> bool {
        ContinuationRow frame = session.continuation(frame_id);
        const i64 node = frame.syntax_node();
        const compiler_resolver::SyntaxRow syntax = session.syntax(node);
        const compiler_resolver::ResolvedRow resolved = session.resolved(node);
        const i64 source = source_ref(session, node);
        if (frame.output_mark() >= 0) {
            const compiler_resolver::ResolvedTypeKind expected = value_kind(session, frame.output_mark());
            if (is_span(session, frame.output_mark())) {
                return begin_span(session, frame_id);
            }
            if (expected == compiler_resolver::ResolvedTypeKind::array_value) {
                return begin_array(session, frame_id);
            }
            if (expected == compiler_resolver::ResolvedTypeKind::class_value) {
                return begin_class(session, frame_id);
            }
            if (is_service_resource(session, frame.output_mark())) {
                return begin_service_resource(session, frame_id);
            }
            if (is_owner_storage(session, frame.output_mark())) {
                return begin_owned_storage(session, frame_id);
            }
        }
        if (resolved.operation() == compiler_resolver::ResolvedOperation::enum_case) {
            const i64 type = resolved.word(2);
            const i64 ordinal = resolved.word(3);
            bool invalid_case = value_kind(session, type) != compiler_resolver::ResolvedTypeKind::enum_value || ordinal
                < 0;
            if (!invalid_case) {
                const i64 nominal = compiler_resolver::mw(session, type, 1);
                invalid_case = ordinal >= enum_case_count(session, nominal);
            }
            if (invalid_case) {
                return fail(session, LoweringError::unknown_enum_case, source);
            }
            emit_EnumConstant(session, type, ordinal);
            return finish_expression(session, type, -1);
        }
        if (syntax.expression_kind() == compiler_parser::NodeKind::literal || resolved.operation()
            == compiler_resolver::ResolvedOperation::capacity_constant) {
            const compiler_resolver::MetaRow token = session.meta(source);
            if (session.source_byte(token.word(1)) == '"' && resolved.operation()
                != compiler_resolver::ResolvedOperation::capacity_constant) {
                return fail(session, LoweringError::byte_string_requires_typed_array_initializer, source);
            }
            const LiteralValue literal = decode_literal(session, node);
            emit_literal(session, literal);
            return finish_expression(session, literal.type(), -1);
        }
        if (is_method_expression(session, node) || is_host_operation(session, node)) {
            return begin_call(session, frame_id);
        }
        if (is_constructor_expression(session, node)) {
            if (argument_use(session, frame_id)) {
                return begin_call(session, frame_id);
            }
            return fail(session, LoweringError::class_construction_requires_typed_initializer, source);
        }
        if (syntax.expression_kind() == compiler_parser::NodeKind::name) {
            return emit_name_expression(session, frame_id);
        }
        if (syntax.expression_kind() == compiler_parser::NodeKind::member) {
            return emit_member_expression(session, frame_id);
        }
        if (syntax.expression_kind() == compiler_parser::NodeKind::index) {
            return begin_index(session, frame_id);
        }
        if (syntax.expression_kind() == compiler_parser::NodeKind::array_literal) {
            return fail(session, LoweringError::array_literal_requires_typed_initializer, source);
        }
        if (syntax.expression_kind() == compiler_parser::NodeKind::construct) {
            return fail(session, LoweringError::class_construction_requires_typed_initializer, source);
        }
        if (syntax.expression_kind() == compiler_parser::NodeKind::unary) {
            if (session.source_equal(source, "-")) {
                const i64 child = syntax.word(1);
                const compiler_resolver::SyntaxRow child_row = session.syntax(child);
                if (child_row.expression_kind() == compiler_parser::NodeKind::literal) {
                    const LiteralValue magnitude = negative_literal_magnitude(session, child, source);
                    if (magnitude.valid() && magnitude.unsigned_value() == 9223372036854775808u64) {
                        const i64 type = scalar_id(session, compiler_resolver::ResolvedTypeKind::i64_value);
                        emit_signed(session, -9223372036854775807 - 1, type);
                        return finish_expression(session, type, -1);
                    }
                }
            }
            frame.set_phase(ContinuationPhase::child);
            session.set_continuation(frame_id, frame);
            return push_expression(session, syntax.word(1), -1, -1);
        }
        if (syntax.expression_kind() == compiler_parser::NodeKind::binary) {
            frame.set_phase(ContinuationPhase::child);
            session.set_continuation(frame_id, frame);
            return push_expression(session, syntax.word(1), -1, -1);
        }
        if (syntax.expression_kind() == compiler_parser::NodeKind::call) {
            return begin_scalar_builtin(session, frame_id);
        }
        return fail(session, LoweringError::invalid_expression, source);
    }
    auto step_expression(compiler_resolver::Session& session, i64 frame_id) -> bool {
        ContinuationRow frame = session.continuation(frame_id);
        if (frame.phase() == ContinuationPhase::start) {
            return begin_expression(session, frame_id);
        }
        const i64 node = frame.syntax_node();
        const compiler_resolver::SyntaxRow syntax = session.syntax(node);
        const i64 source = source_ref(session, node);
        if (frame.output_mark() >= 0 && value_kind(session, frame.output_mark())
            == compiler_resolver::ResolvedTypeKind::array_value) {
            return step_array(session, frame_id);
        }
        if (syntax.expression_kind() == compiler_parser::NodeKind::construct) {
            return step_designated(session, frame_id);
        }
        if (syntax.expression_kind() == compiler_parser::NodeKind::index) {
            return finish_index(session, frame_id);
        }
        if (syntax.expression_kind() == compiler_parser::NodeKind::unary) {
            unary_instruction(session, node, frame.child_type_id());
            return finish_expression(session, frame.child_type_id(), -1);
        }
        if (syntax.expression_kind() == compiler_parser::NodeKind::binary) {
            const i64 boolean = scalar_id(session, compiler_resolver::ResolvedTypeKind::bool_value);
            const bool logical = session.source_equal(source, "&&") || session.source_equal(source, "||");
            if (frame.phase() == ContinuationPhase::child) {
                if (logical) {
                    match_type(session, frame.child_type_id(), boolean, source);
                    const i64 prefix = session.local_count();
                    const i64 base = session.capture_locals(prefix);
                    frame.set_scope(frame.scope_head(), prefix);
                    frame.set_snapshots(base, -1);
                    const i64 done = body_fresh_label(session);
                    i64 right = -1;
                    if (session.source_equal(source, "&&")) {
                        emit_BranchFalse(session, done);
                    } else {
                        right = body_fresh_label(session);
                        emit_BranchFalse(session, right);
                        emit_Jump(session, done);
                        emit_Label(session, right);
                    }
                    frame.set_labels(done, right);
                } else {
                    frame.set_cleanup_cursor(frame.child_type_id());
                    emit_Push(session);
                }
                frame.set_phase(ContinuationPhase::logical_right);
                session.set_continuation(frame_id, frame);
                return push_expression(session, syntax.word(2), -1, -1);
            }
            if (logical) {
                match_type(session, frame.child_type_id(), boolean, source);
                join_prefix(session, frame.incoming_snapshot_base(), frame.local_prefix_length(), source, true);
                session.truncate_snapshots(frame.incoming_snapshot_base());
                emit_Label(session, frame.first_label());
                return finish_expression(session, boolean, -1);
            }
            const i64 result = binary_instruction(session, node, frame.cleanup_cursor(), frame.child_type_id());
            return finish_expression(session, result, -1);
        }
        if (syntax.expression_kind() == compiler_parser::NodeKind::method_call && session.source_equal(source,
            "subspan") && frame.output_mark() >= 0 && is_span(session, frame.output_mark())) {
            return step_subspan(session, frame_id);
        }
        if (frame.phase() == ContinuationPhase::argument) {
            return collect_call_argument(session, frame_id);
        }
        return finish_scalar_builtin(session, frame_id);
    }
}
