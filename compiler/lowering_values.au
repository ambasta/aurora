// Source-semantic value, frame, lifetime and snapshot primitives. The function
// root is continuation zero. Its frame reservation and loan counter are
// monotonic; its label counter is carried between functions by the caller.
export namespace compiler_lowering {
    auto emit_BindServiceParameter(compiler_resolver::Session& session, i64 a0, i64 a1, i64 a2) -> i64 {
        const i64 begin = session.operand_count();
        put(session, OperandRole::Index, a0);
        put(session, OperandRole::Offset, a1);
        put(session, OperandRole::ServiceKindId, a2);
        return emit(session, InstructionForm::BindServiceParameter, begin);
    }
