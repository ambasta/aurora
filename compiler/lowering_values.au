    auto is_owner_storage(compiler_resolver::Session& session, i64 type) -> bool {
        const compiler_resolver::ResolvedTypeKind kind = value_kind(session, type);
        return kind == compiler_resolver::ResolvedTypeKind::owned_bytes || kind
            == compiler_resolver::ResolvedTypeKind::owned_values;
    }
    auto is_class_array(compiler_resolver::Session& session, i64 type) -> bool {
        if (value_kind(session, type) != compiler_resolver::ResolvedTypeKind::array_value) {
            return false;
        }
        const i64 staged_type_1 = compiler_resolver::mw(session, type, 2);
        return value_kind(session, staged_type_1) == compiler_resolver::ResolvedTypeKind::class_value;
    }
    auto is_byte_array(compiler_resolver::Session& session, i64 type) -> bool {
        if (value_kind(session, type) != compiler_resolver::ResolvedTypeKind::array_value) {
            return false;
        }
        const i64 staged_type_2 = compiler_resolver::mw(session, type, 2);
        return value_kind(session, staged_type_2) == compiler_resolver::ResolvedTypeKind::u8_value;
    }
    auto is_resource_owner(compiler_resolver::Session& session, i64 type) -> bool {
        return is_owner_storage(session, type) || owning_type(session, type);
    }
    auto scalar_width(compiler_resolver::Session& session, i64 type) -> i64 {
        const compiler_resolver::ResolvedTypeKind kind = value_kind(session, type);
        if (kind == compiler_resolver::ResolvedTypeKind::u8_value) {
            return 1;
        }
        return 8;
    }
    auto payload_type(compiler_resolver::Session& session, i64 type) -> i64 {
        if (value_kind(session, type) == compiler_resolver::ResolvedTypeKind::owner) {
            return scalar_id(session, compiler_resolver::ResolvedTypeKind::i64_value);
        }
        return type;
    }
    auto source_ref(compiler_resolver::Session& session, i64 syntax) -> i64 {
        i64 current = syntax;
        i64 reference = -1;
        bool indexed = true;
        while (indexed) {
            const compiler_resolver::SyntaxRow row = session.syntax(current);
            indexed = row.expression_kind() == compiler_parser::NodeKind::index;
            if (indexed) {
                current = row.word(1);
            } else {
                if ((row.expression_kind() == compiler_parser::NodeKind::name || row.expression_kind()
                    == compiler_parser::NodeKind::call || row.expression_kind() == compiler_parser::NodeKind::construct)
                    && row.word(4) >= 0 && row.word(4) != row.word(0)) {
                    reference = compiler_resolver::name_range(session, row.word(0), row.word(4));
                } else {
                    reference = row.word(0);
                }
            }
        }
        return reference;
    }
    auto spelling(compiler_resolver::Session& session, i64 reference, builtin::span<const u8> text) -> bool {
        return session.source_equal(reference, text);
    }
    auto expression_spelling(compiler_resolver::Session& session, i64 node, builtin::span<const u8> text) -> bool {
        const i64 staged_reference_3 = source_ref(session, node);
        return spelling(session, staged_reference_3, text);
    }
    auto match_type(compiler_resolver::Session& session, i64 got, i64 want, i64 source) -> bool {
        if (got == want) {
            return session.good();
        }
        const OperandRow expected = scalar(OperandRole::DiagnosticTypeId, want);
        const OperandRow actual = scalar(OperandRole::DiagnosticTypeId, got);
        return fail_pair(session, LoweringError::type_mismatch, source, expected, actual);
    }
    auto emit_signed(compiler_resolver::Session& session, i64 number, i64 type) -> i64 {
        const i64 begin = session.operand_count();
        put(session, OperandRole::SignedConstant, number);
        put(session, OperandRole::TypeId, type);
        return emit(session, InstructionForm::Constant, begin);
    }
    auto emit_unsigned(compiler_resolver::Session& session, u64 number, i64 type) -> i64 {
        const i64 begin = session.operand_count();
        const OperandRow number_operand = unsigned_operand(OperandRole::UnsignedConstant, number);
        session.append_operand(number_operand);
        put(session, OperandRole::TypeId, type);
        return emit(session, InstructionForm::Constant, begin);
    }
    auto body_function(compiler_resolver::Session& session) -> i64 {
        const ContinuationRow root = session.continuation(0);
        return root.syntax_node();
    }
    auto body_result_type(compiler_resolver::Session& session) -> i64 {
        const ContinuationRow root = session.continuation(0);
        return root.then_snapshot_base();
    }
    auto body_fresh_label(compiler_resolver::Session& session) -> i64 {
        ContinuationRow root = session.continuation(0);
        const i64 result = root.first_label();
        root.set_labels(result + 1, root.second_label());
        session.set_continuation(0, root);
        return result;
    }
    auto body_fresh_loan(compiler_resolver::Session& session) -> i64 {
        ContinuationRow root = session.continuation(0);
        const i64 result = root.incoming_snapshot_base();
        root.set_snapshots(result + 1, root.then_snapshot_base());
        session.set_continuation(0, root);
        return result;
    }
    auto active_scope(compiler_resolver::Session& session) -> i64 {
        i64 at = session.continuation_count();
        while (at > 0) {
            at = at - 1;
            const ContinuationRow frame = session.continuation(at);
            if (frame.kind() == ContinuationKind::block || frame.kind() == ContinuationKind::function) {
                return at;
            }
        }
        return session.fail_storage(compiler_resolver::StorageStatus::invalid);
    }
    auto scope_identity(ContinuationRow scope) -> i64 {
        if (scope.kind() == ContinuationKind::function) {
            return 0;
        }
        return scope.syntax_node() + 1;
    }
    auto lookup_local(compiler_resolver::Session& session, i64 name) -> i64 {
        const i64 atom = compiler_resolver::intern_atom(session, name);
        const i64 function = body_function(session);
        i64 at = session.continuation_count();
        while (at > 0 && session.good()) {
            at = at - 1;
            const ContinuationRow scope = session.continuation(at);
            if (scope.kind() == ContinuationKind::block || scope.kind() == ContinuationKind::function) {
                const i64 found = session.index(110, function, scope_identity(scope), atom, 0);
                if (found >= 0) {
                    return found;
                }
            }
        }
        return -1;
    }
    auto find_local(compiler_resolver::Session& session, i64 name) -> i64 {
        const i64 result = lookup_local(session, name);
        if (result < 0) {
            const OperandRow value = scalar(OperandRole::DiagnosticNameId, name);
            const OperandRow absent = scalar(OperandRole::NoDiagnosticValue, 0);
            fail_pair(session, LoweringError::unknown_local, name, value, absent);
        }
        return result;
    }
    auto named_source(compiler_resolver::Session& session, i64 expression) -> i64 {
        const compiler_resolver::SyntaxRow syntax = session.syntax(expression);
        if (syntax.expression_kind() != compiler_parser::NodeKind::name) {
            const i64 staged_source_4 = source_ref(session, expression);
            return error(session, LoweringError::ownership_operation_requires_local, staged_source_4);
        }
        const i64 reference = source_ref(session, expression);
        const i64 id = find_local(session, reference);
        if (!session.good()) {
            return -1;
        }
        const LocalRow row = session.local(id);
        const SnapshotRow state = row.state();
        if (!state.live()) {
            const OperandRow value = scalar(OperandRole::DiagnosticNameId, reference);
            const OperandRow absent = scalar(OperandRole::NoDiagnosticValue, 0);
            fail_pair(session, LoweringError::use_after_move, reference, value, absent);
            return -1;
        }
        if (state.object_exclusive()) {
            return error(session, LoweringError::owning_object_exclusively_borrowed, reference);
        }
        session.mark_local_read(id);
        return id;
    }
    auto local_offset(compiler_resolver::Session& session, i64 id) -> i64 {
        const LocalRow row = session.local(id);
        return row.offset();
    }
    auto local_type(compiler_resolver::Session& session, i64 id) -> i64 {
        const LocalRow row = session.local(id);
        return row.concrete_type_id();
    }
    auto set_live(compiler_resolver::Session& session, i64 id, bool live, bool active) -> bool {
        const LocalRow row = session.local(id);
        const SnapshotRow old = row.state();
        const SnapshotRow changed = SnapshotRow(old.shared_count(), old.object_shared_count(), live, old.exclusive(),
            active, old.object_exclusive());
        return session.set_local_state(id, changed);
    }
    auto change_shared(compiler_resolver::Session& session, i64 id, i64 difference) -> bool {
        const LocalRow row = session.local(id);
        const SnapshotRow old = row.state();
        const SnapshotRow changed = SnapshotRow(old.shared_count() + difference, old.object_shared_count(), old.live(),
            old.exclusive(), old.resource_active(), old.object_exclusive());
        return session.set_local_state(id, changed);
    }
    auto set_exclusive(compiler_resolver::Session& session, i64 id, bool exclusive) -> bool {
        const LocalRow row = session.local(id);
        const SnapshotRow old = row.state();
        const SnapshotRow changed = SnapshotRow(old.shared_count(), old.object_shared_count(), old.live(), exclusive,
            old.resource_active(), old.object_exclusive());
        return session.set_local_state(id, changed);
    }
    // Implicit receivers retain their emitted root selector 0 and source sentinel
    // -2. Their authority lives in an ordinary hidden LocalRow, so branch/loop
    // captures and joins preserve exactly the same loan facts as named roots.
    auto object_loan_local(compiler_resolver::Session& session, i64 root) -> i64 {
        if (root == -2) {
            const ContinuationRow function = session.continuation(0);
            return function.capability_root_local();
        }
        return root;
    }
    auto object_root_offset(compiler_resolver::Session& session, i64 root) -> i64 {
        if (root == -2) {
            return 0;
        }
        return local_offset(session, root);
    }
    auto no_exclusive_object_loan(compiler_resolver::Session& session, i64 root, i64 source) -> bool {
        const i64 id = object_loan_local(session, root);
        if (id >= 0) {
            const LocalRow local = session.local(id);
            const SnapshotRow state = local.state();
            if (state.object_exclusive()) {
                return fail(session, LoweringError::owning_object_exclusively_borrowed, source);
            }
        }
        return session.good();
    }
    auto change_object_loan(compiler_resolver::Session& session, i64 root, i64 shared, bool exclusive) -> bool {
        const i64 id = object_loan_local(session, root);
        const LocalRow row = session.local(id);
        const SnapshotRow old = row.state();
        const SnapshotRow changed = SnapshotRow(old.shared_count(), old.object_shared_count() + shared, old.live(),
            old.exclusive(), old.resource_active(), exclusive);
        return session.set_local_state(id, changed);
    }
    auto no_object_loan(compiler_resolver::Session& session, i64 root, i64 source) -> bool {
        const i64 id = object_loan_local(session, root);
        if (id >= 0) {
            const LocalRow local = session.local(id);
            const SnapshotRow state = local.state();
            if (state.object_shared_count() != 0 || state.object_exclusive()) {
                return fail(session, LoweringError::owning_object_mutation_while_borrowed, source);
            }
        }
        return session.good();
    }
    auto no_span_borrow(compiler_resolver::Session& session, i64 root, i64 field, i64 source) -> bool {
        if (!no_object_loan(session, root, source)) {
            return false;
        }
        i64 at = 0;
        while (at < session.local_count()) {
            const LocalRow local = session.local(at);
            const SnapshotRow state = local.state();
            const bool same_root =(root == -2 && local.span_origin_kind() == SpanOriginKind::receiver) || (root >= 0
                && local.span_origin_kind() == SpanOriginKind::local && local.origin_local_id() == root);
            if (state.live() && is_span(session, local.concrete_type_id()) && same_root && (field < 0
                || local.span_field_index() == field)) {
                return fail(session, LoweringError::owner_mutation_while_span_live, source);
            }
            at = at + 1;
        }
        return session.good();
    }
    // Each request freezes origin and lint facts before append_local publishes
    // the row. In particular a branch capture cannot see a half-set origin.
    class LocalRequest {
        i64 nameRef;
        i64 typeId;
        i64 sourceRef;
        bool mutableValue;
        bool bindValue;
        bool beginValue;
        i64 ownerId;
        SpanOriginKind originKind;
        i64 originId;
        i64 fieldId;
        bool temporaryParent;
        bool borrowedValue;
        bool lintValue;
        i64 borrowedRoot;
    public:
        LocalRequest(i64 name, i64 type, i64 source, bool mutable_value, bool bind, bool begin) : nameRef(name),
            typeId(type), sourceRef(source), mutableValue(mutable_value), bindValue(bind), beginValue(begin),
            ownerId(-1), originKind(SpanOriginKind::none), originId(-1), fieldId(-1), temporaryParent(false),
            borrowedValue(false), lintValue(false), borrowedRoot(0) {
        }
        auto name() const -> i64 {
            return nameRef;
        }
        auto type() const -> i64 {
            return typeId;
        }
        auto source() const -> i64 {
            return sourceRef;
        }
        auto mutable_value() const -> bool {
            return mutableValue;
        }
        auto bind() const -> bool {
            return bindValue;
        }
        auto begin() const -> bool {
            return beginValue;
        }
        auto owner() const -> i64 {
            return ownerId;
        }
        auto origin() const -> SpanOriginKind {
            return originKind;
        }
        auto origin_id() const -> i64 {
            return originId;
        }
        auto field() const -> i64 {
            return fieldId;
        }
        auto temporary() const -> bool {
            return temporaryParent;
        }
        auto borrowed() const -> bool {
            return borrowedValue;
        }
        auto lint() const -> bool {
            return lintValue;
        }
        auto borrowed_root() const -> i64 {
            return borrowedRoot;
        }
        auto set_borrowed_root(i64 selector) -> bool {
            borrowedRoot = selector;
            return true;
        }
        auto set_origin(i64 owner, SpanOriginKind kind, i64 origin, i64 field, bool temporary) -> bool {
            ownerId = owner;
            originKind = kind;
            originId = origin;
            fieldId = field;
            temporaryParent = temporary;
            return true;
        }
        auto set_flags(bool borrowed, bool lint) -> bool {
            borrowedValue = borrowed;
            lintValue = lint;
            return true;
        }
    };
    auto scalar_slot(compiler_resolver::Session& session, i64 offset, i64 type) -> i64 {
        const i64 begin = session.operand_count();
        put(session, OperandRole::Offset, offset);
        put(session, OperandRole::TypeId, type);
        return emit_record(session, RecordKind::ScalarSlot, begin);
    }
    auto local_slot(compiler_resolver::Session& session, RecordKind kind, i64 offset) -> i64 {
        const i64 begin = session.operand_count();
        put(session, OperandRole::Offset, offset);
        return emit_record(session, kind, begin);
    }
    auto add_local(compiler_resolver::Session& session, LocalRequest request) -> i64 {
        const i64 scope_index = active_scope(session);
        ContinuationRow scope = session.continuation(scope_index);
        const i64 scope_id = scope_identity(scope);
        i64 atom = -1;
        if (request.bind()) {
            atom = compiler_resolver::intern_atom(session, request.name());
            if (session.index(110, body_function(session), scope_id, atom, 0) >= 0) {
                const OperandRow name = scalar(OperandRole::DiagnosticNameId, request.name());
                const OperandRow absent = scalar(OperandRole::NoDiagnosticValue, 0);
                fail_pair(session, LoweringError::duplicate_local, request.source(), name, absent);
                return -1;
            }
        }
        const i64 type = request.type();
        const compiler_resolver::ResolvedTypeKind kind = value_kind(session, type);
        i64 words = 1;
        if (request.borrowed()) {
            words = 0;
        } else {
            if (compiler_resolver::service_kind(kind)) {
                words = 2;
            } else {
                if (is_owner_storage(session, type)) {
                    words = 4;
                } else {
                    if (is_span(session, type)) {
                        words = 7;
                    } else {
                        if (kind == compiler_resolver::ResolvedTypeKind::class_value || kind
                            == compiler_resolver::ResolvedTypeKind::array_value) {
                            i64 bytes = type_size(session, type, request.source());
                            if (bytes < 1) {
                                bytes = 1;
                            }
                            words =(bytes + 7) / 8;
                        }
                    }
                }
            }
        }
        ContinuationRow root = session.continuation(0);
        if (words > 8192 || root.local_prefix_length() > 8192 - words) {
            return error(session, LoweringError::function_frame_limit, request.source());
        }
        const i64 frame_words = root.local_prefix_length() + words;
        root.set_scope(root.scope_head(), frame_words);
        session.set_continuation(0, root);
        i64 offset = frame_words * 8;
        if (request.borrowed()) {
            // Formal roots are selectors, not stack storage. Each still has
            // its own LocalRow and snapshot, including same-class formals.
            offset = request.borrowed_root();
            if (offset > 0 || offset < -5) {
                return session.fail_storage(compiler_resolver::StorageStatus::invalid);
            }
        }
        const bool active = is_resource_owner(session, type) && !request.borrowed();
        i64 name = -1;
        i64 scope_key = -1;
        i64 previous = -1;
        if (request.bind()) {
            name = request.name();
            scope_key = scope_id;
            previous = scope.scope_head();
        }
        LocalRow local = LocalRow(name, type, offset, scope_key, previous, request.mutable_value());
        local.set_binding_flags(request.borrowed(), request.lint());
        local.set_origin(request.owner(), request.origin(), request.origin_id(), request.field(), request.temporary());
        const SnapshotRow state = SnapshotRow(0, 0, true, false, active, false);
        local.set_state(state);
        if (!request.borrowed()) {
            if (compiler_resolver::service_kind(kind)) {
                local_slot(session, RecordKind::ServiceSlot, offset);
            } else {
                if (kind == compiler_resolver::ResolvedTypeKind::byte_region) {
                    local_slot(session, RecordKind::RegionSlot, offset);
                } else {
                    if (is_owner_storage(session, type)) {
                        const i64 begin = session.operand_count();
                        put(session, OperandRole::Offset, offset);
                        i64 mutable_value = 0;
                        if (request.mutable_value()) {
                            mutable_value = 1;
                        }
                        put(session, OperandRole::MutableValue, mutable_value);
                        emit_record(session, RecordKind::ByteSlot, begin);
                        if (kind == compiler_resolver::ResolvedTypeKind::owned_values) {
                            owned_element(session, type, request.source());
                            const i64 element = compiler_resolver::mw(session, type, 2);
                            const i64 owned_begin = session.operand_count();
                            put(session, OperandRole::Offset, offset);
                            const i64 staged_value_5 = compiler_resolver::mw(session, element, 1);
                            put(session, OperandRole::ClassNominalId, staged_value_5);
                            emit_record(session, RecordKind::OwnedValueType, owned_begin);
                        }
                        if (request.begin()) {
                            emit_BeginBytes(session, offset);
                        }
                    } else {
                        if (is_span(session, type)) {
                            local_slot(session, RecordKind::SpanSlot, offset);
                            if (kind == compiler_resolver::ResolvedTypeKind::value_span) {
                                owned_element(session, type, request.source());
                                const i64 element = compiler_resolver::mw(session, type, 2);
                                const i64 span_begin = session.operand_count();
                                put(session, OperandRole::Offset, offset);
                                const i64 span_nominal = compiler_resolver::mw(session, element, 1);
                                put(session, OperandRole::ClassNominalId, span_nominal);
                                emit_record(session, RecordKind::SpanValueType, span_begin);
                            }
                        } else {
                            if (kind == compiler_resolver::ResolvedTypeKind::class_value || is_class_array(session,
                                type)) {
                                i64 layout = -1;
                                i64 carrier = -1;
                                if (is_class_array(session, type)) {
                                    carrier = class_carrier(session, type, request.source());
                                    layout = carrier_class_row(session, carrier);
                                } else {
                                    layout = class_row(session, type);
                                }
                                const i64 begin = session.operand_count();
                                put(session, OperandRole::Offset, offset);
                                if (carrier >= 0) {
                                    put(session, OperandRole::CarrierId, carrier);
                                } else {
                                    const i64 staged_value_6 = compiler_resolver::mw(session, type, 1);
                                    put(session, OperandRole::ClassNominalId, staged_value_6);
                                }
                                i64 mutable_value = 0;
                                if (request.mutable_value()) {
                                    mutable_value = 1;
                                }
                                put(session, OperandRole::MutableValue, mutable_value);
                                emit_record(session, RecordKind::ObjectSlot, begin);
                                if (request.begin()) {
                                    emit_BeginObject(session, offset);
                                }
                                const OperandRow leaves = record_slice(session, layout, OperandRole::LeafTypes);
                                const i64 storage = record_signed(session, layout, OperandRole::StorageRef);
                                const OperandRow offsets = record_slice(session, storage, OperandRole::LeafOffsets);
                                i64 at = 0;
                                while (at < leaves.count() && session.good()) {
                                    const OperandRow leaf = session.view_operand(leaves.begin() + at);
                                    const OperandRow displacement = session.view_operand(offsets.begin() + at);
                                    scalar_slot(session, offset - displacement.signed_value(), leaf.signed_value());
                                    at = at + 1;
                                }
                            } else {
                                if (kind == compiler_resolver::ResolvedTypeKind::array_value) {
                                    const i64 element = compiler_resolver::mw(session, type, 2);
                                    const i64 length = compiler_resolver::mw(session, type, 3);
                                    if (is_byte_array(session, type)) {
                                        const i64 begin = session.operand_count();
                                        put(session, OperandRole::Offset, offset);
                                        put(session, OperandRole::Length, length);
                                        emit_record(session, RecordKind::ArraySlot, begin);
                                        emit_BeginArray(session, offset);
                                    }
                                    i64 at = 0;
                                    while (at < length && session.good()) {
                                        const i64 staged_offset_7 = offset - at * scalar_width(session, element);
                                        scalar_slot(session, staged_offset_7, element);
                                        at = at + 1;
                                    }
                                } else {
                                    const i64 staged_type_8 = payload_type(session, type);
                                    scalar_slot(session, offset, staged_type_8);
                                }
                            }
                        }
                    }
                }
            }
        }
        const i64 result = session.append_local(local);
        if (request.bind() && session.good()) {
            session.index_insert(110, body_function(session), scope_id, atom, 0, result);
            ContinuationRow updated_scope = session.continuation(scope_index);
            updated_scope.set_scope(result, updated_scope.local_prefix_length());
            session.set_continuation(scope_index, updated_scope);
        }
        return result;
    }
    auto end_owner(compiler_resolver::Session& session, i64 id) -> bool {
        const LocalRow local = session.local(id);
        if (local.borrowed_object()) {
            return fail(session, LoweringError::borrowed_object_ownership_transfer, local.name_source_id());
        }
        if (!no_object_loan(session, id, local.name_source_id())) {
            return false;
        }
        if (is_owner_storage(session, local.concrete_type_id())) {
            emit_EndBytes(session, local.offset());
        } else {
            emit_EndObject(session, local.offset());
        }
        return session.good();
    }
    auto release_span(compiler_resolver::Session& session, i64 id, bool instructions) -> bool {
        // Parent identities decrease strictly. This loop is bounded by Local
        // producers, not expression depth; named chains may exceed 128 spans.
        i64 current = id;
        while (current >= 0 && session.good()) {
            const LocalRow span = session.local(current);
            const SnapshotRow state = span.state();
            if (state.shared_count() != 0) {
                return fail(session, LoweringError::dependent_reborrow_lifetime, -1);
            }
            if (instructions) {
                emit_EndSpan(session, span.offset());
            }
            if (span.owner_id() >= 0) {
                change_shared(session, span.owner_id(), -1);
            }
            if (span.span_origin_kind() == SpanOriginKind::local) {
                change_shared(session, span.origin_local_id(), -1);
            }
            set_live(session, current, false, state.resource_active());
            if (!span.temporary_parent()) {
                return session.good();
            }
            if (span.owner_id() < 0 || span.owner_id() >= current) {
                session.fail_storage(compiler_resolver::StorageStatus::invalid);
                return false;
            }
            current = span.owner_id();
        }
        return session.good();
    }
    auto copied_snapshot(compiler_resolver::Session& session, i64 original, i64 source) -> i64 {
        const LocalRow local = session.local(original);
        if (owning_type(session, local.concrete_type_id())) {
            return error(session, LoweringError::owning_class_copy, source);
        }
        const LocalRequest request = LocalRequest(-1, local.concrete_type_id(), source, false, false, true);
        const i64 destination = add_local(session, request);
        const i64 staged_a1_9 = local_offset(session, destination);
        emit_CopyObject(session, local.offset(), staged_a1_9);
        return destination;
