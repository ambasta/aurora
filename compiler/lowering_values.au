    auto cleanup_scope(compiler_resolver::Session& session, i64 frame_id, bool terminal) -> bool {
        const ContinuationRow scope = session.continuation(frame_id);
        i64 at = scope.scope_head();
        while (at >= 0 && session.good()) {
            const LocalRow local = session.local(at);
            const SnapshotRow state = local.state();
            const i64 type = local.concrete_type_id();
            const compiler_resolver::ResolvedTypeKind kind = value_kind(session, type);
            if (!local.borrowed_object()) {
                if (is_resource_owner(session, type)) {
                    if (!terminal) {
                        end_owner(session, at);
                    }
                    set_live(session, at, false, false);
                } else {
                    if (is_span(session, type)) {
                        if (state.live()) {
                            release_span(session, at, !terminal);
                        }
                    } else {
                        if (is_byte_array(session, type)) {
                            if (state.shared_count() != 0) {
                                return fail_synthetic(session, LoweringError::byte_array_lifetime_while_borrowed,
                                    local.name_source_id(), scalar(OperandRole::NoDiagnosticValue, 0),
                                    scalar(OperandRole::NoDiagnosticValue, 0));
                            }
                            if (!terminal) {
                                emit_EndArray(session, local.offset());
                            }
                            set_live(session, at, false, state.resource_active());
                        }
                        if (kind == compiler_resolver::ResolvedTypeKind::reference) {
                            change_shared(session, local.owner_id(), -1);
                        }
                        if (kind == compiler_resolver::ResolvedTypeKind::mutable_reference) {
                            set_exclusive(session, local.owner_id(), false);
                        }
                        if (!terminal && (kind == compiler_resolver::ResolvedTypeKind::class_value
                            || is_class_array(session, type))) {
                            emit_EndObject(session, local.offset());
                        }
                    }
