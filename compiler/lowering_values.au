    auto moved_source(compiler_resolver::Session& session, i64 expression, i64 expected) -> i64 {
        const compiler_resolver::SyntaxRow syntax = session.syntax(expression);
        const i64 source = source_ref(session, expression);
        if (syntax.expression_kind() != compiler_parser::NodeKind::call || !expression_spelling(session, expression,
            "move")) {
            return error(session, LoweringError::owning_transfer_requires_move, source);
        }
        if (!require_arity(session, expression, 1)) {
            return -1;
        }
        const i64 target = compiler_resolver::sw(session, syntax.word(1), 0);
        const i64 id = named_source(session, target);
        if (!session.good()) {
            return -1;
        }
        const LocalRow local = session.local(id);
        match_type(session, local.concrete_type_id(), expected, source);
        if (!is_resource_owner(session, expected)) {
            return error(session, LoweringError::move_requires_owner, source);
        }
        if (local.borrowed_object()) {
            return error(session, LoweringError::borrowed_object_ownership_transfer, source);
        }
        if (!local.mutable_value()) {
            return error(session, LoweringError::move_const_owner, source);
        }
        no_span_borrow(session, id, -1, source);
        return id;
    }
    auto emit_move(compiler_resolver::Session& session, i64 original, i64 destination) -> bool {
        const LocalRow local = session.local(original);
        const SnapshotRow state = local.state();
        if (is_owner_storage(session, local.concrete_type_id())) {
            const i64 staged_a1_10 = local_offset(session, destination);
            emit_MoveBytes(session, local.offset(), staged_a1_10);
        } else {
            const i64 staged_a1_11 = local_offset(session, destination);
            emit_MoveObject(session, local.offset(), staged_a1_11);
        }
        return set_live(session, original, false, state.resource_active());
    }
    auto same_borrows(SnapshotRow first, SnapshotRow second) -> bool {
        return first.shared_count() == second.shared_count() && first.object_shared_count()
            == second.object_shared_count() && first.exclusive() == second.exclusive() && first.object_exclusive()
            == second.object_exclusive();
    }
    auto join_prefix(compiler_resolver::Session& session, i64 base, i64 count, i64 source, bool logical) -> bool {
        i64 at = 0;
        while (at < count && session.good()) {
            const LocalRow local = session.local(at);
            const SnapshotRow current = local.state();
            const SnapshotRow saved = session.snapshot(base + at);
            if (!same_borrows(current, saved)) {
                if (logical) {
                    return fail(session, LoweringError::logical_borrow_state_mismatch, source);
                }
                return fail(session, LoweringError::branch_borrow_state_mismatch, source);
            }
            if (is_resource_owner(session, local.concrete_type_id()) && current.live() != saved.live()) {
                if (logical) {
                    return fail(session, LoweringError::logical_byte_ownership_state_mismatch, source);
                }
                return fail(session, LoweringError::branch_byte_ownership_state_mismatch, source);
            }
            set_live(session, at, current.live() && saved.live(), current.resource_active());
            at = at + 1;
        }
