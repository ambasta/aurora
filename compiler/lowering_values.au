            }
            at = local.previous_binding();
        }
        return session.good();
    }
    auto return_borrows(compiler_resolver::Session& session, i64 returned) -> bool {
        i64 retained = returned;
        i64 at = session.local_count();
        while (at > 0 && session.good()) {
            at = at - 1;
            const LocalRow local = session.local(at);
            const SnapshotRow state = local.state();
            if (state.live() && is_span(session, local.concrete_type_id())) {
                if (retained == at) {
                    retained = local.owner_id();
                } else {
                    emit_EndSpan(session, local.offset());
                }
            }
        }
        at = session.local_count();
        while (at > 0 && session.good()) {
            at = at - 1;
            const LocalRow local = session.local(at);
            const SnapshotRow state = local.state();
            if (state.live() && is_byte_array(session, local.concrete_type_id())) {
                emit_EndArray(session, local.offset());
            }
        }
        return session.good();
    }
    auto return_owners(compiler_resolver::Session& session, i64 returned) -> bool {
        i64 at = session.local_count();
        while (at > 0 && session.good()) {
            at = at - 1;
            const LocalRow local = session.local(at);
            const SnapshotRow state = local.state();
            if (at != returned && state.resource_active()) {
                end_owner(session, at);
            }
        }
        return session.good();
    }
    // A source list is reversed once, using the existing balanced index. The
    // source syntax is immutable; each distinct list contributes one head entry
    // and one next entry per producer. Traversal thereafter is forward-only.
    auto ordered_first(compiler_resolver::Session& session, i64 last, i64 link_slot) -> i64 {
        if (last < 0) {
            return -1;
        }
        const i64 found = session.index(111, last, link_slot, 0, 0);
        if (found >= 0) {
            return found - 1;
        }
        i64 next = -1;
        i64 at = last;
        while (at >= 0 && session.good()) {
            session.index_insert(112, last, at, link_slot, 0, next + 1);
            next = at;
            at = compiler_resolver::sw(session, at, link_slot);
        }
        session.index_insert(111, last, link_slot, 0, 0, next + 1);
        return next;
    }
    auto ordered_next(compiler_resolver::Session& session, i64 last, i64 current, i64 link_slot) -> i64 {
        const i64 result = session.index(112, last, current, link_slot, 0);
        if (result < 0) {
            return session.fail_storage(compiler_resolver::StorageStatus::invalid);
        }
        return result - 1;
    }
    auto expression_argument(compiler_resolver::Session& session, i64 expression, i64 ordinal) -> i64 {
        const i64 last = compiler_resolver::sw(session, expression, 1);
        i64 edge = ordered_first(session, last, 1);
        i64 at = 0;
        while (at < ordinal && edge >= 0 && session.good()) {
            edge = ordered_next(session, last, edge, 1);
            at = at + 1;
        }
        if (edge < 0) {
            return session.fail_storage(compiler_resolver::StorageStatus::invalid);
        }
        return compiler_resolver::sw(session, edge, 0);
    }
    auto require_arity(compiler_resolver::Session& session, i64 expression, i64 expected) -> bool {
        if (compiler_resolver::sw(session, expression, 2) == expected) {
            return session.good();
        }
        const i64 source = source_ref(session, expression);
        i64 name_id = compiler_resolver::rw(session, expression, 0);
        if (name_id < 0) {
            name_id = source;
        }
        const OperandRow name = scalar(OperandRole::DiagnosticNameId, name_id);
        const OperandRow absent = scalar(OperandRole::NoDiagnosticValue, 0);
        return fail_pair(session, LoweringError::call_argument_count, source, name, absent);
    }
    class LiteralValue {
        i64 typeId;
        i64 signedValue;
        u64 unsignedValue;
        bool validValue;
    public:
        LiteralValue(i64 type, i64 signed_value, u64 unsigned_value, bool valid) : typeId(type),
            signedValue(signed_value), unsignedValue(unsigned_value), validValue(valid) {
        }
        auto type() const -> i64 {
            return typeId;
        }
        auto signed_value() const -> i64 {
            return signedValue;
        }
        auto unsigned_value() const -> u64 {
            return unsignedValue;
        }
        auto valid() const -> bool {
            return validValue;
        }
    };
    auto hex_digit(u8 byte) -> i64 {
        if (byte >= '0' && byte <= '9') {
            return i64(byte) - 48;
        }
        if (byte >= 'a' && byte <= 'f') {
            return i64(byte) - 87;
        }
        if (byte >= 'A' && byte <= 'F') {
            return i64(byte) - 55;
        }
        return -1;
    }
    auto escape_byte(u8 byte) -> i64 {
        if (byte == '\'') {
            return 39;
        }
        if (byte == '\\') {
            return 92;
        }
        if (byte == '0') {
            return 0;
        }
        if (byte == 'a') {
            return 7;
        }
        if (byte == 'b') {
            return 8;
        }
        if (byte == 'f') {
            return 12;
        }
        if (byte == 'n') {
            return 10;
        }
        if (byte == 'r') {
            return 13;
        }
        if (byte == 't') {
            return 9;
        }
        if (byte == 'v') {
            return 11;
        }
        return -1;
    }
    auto byte_literal(compiler_resolver::Session& session, i64 begin, i64 end) -> i64 {
        const i64 length = end - begin;
        if (length < 3 || session.source_byte(begin) != '\'' || session.source_byte(end - 1) != '\'') {
            return -1;
        }
        const u8 first = session.source_byte(begin + 1);
        if (length == 3) {
            if (first >= 32u8 && first <= 126u8 && first != '\'' && first != '\\') {
                return i64(first);
            }
            return -1;
        }
        if (first != '\\') {
            return -1;
        }
        if (length == 4) {
            return escape_byte(session.source_byte(begin + 2));
        }
        if (length != 6 || session.source_byte(begin + 2) != 'x') {
            return -1;
        }
        const i64 high = hex_digit(session.source_byte(begin + 3));
        const i64 low = hex_digit(session.source_byte(begin + 4));
        if (high < 0 || low < 0) {
            return -1;
        }
        return high * 16 + low;
    }
    auto integer_magnitude(compiler_resolver::Session& session, i64 begin, i64 end) -> LiteralValue {
        i64 at = begin;
        u64 radix = 10u64;
        if (end - begin >= 2 && session.source_byte(begin) == '0' && (session.source_byte(begin + 1) == 'b'
            || session.source_byte(begin + 1) == 'B')) {
            radix = 2u64;
            at = at + 2;
        }
        u64 magnitude = 0u64;
        bool previous_digit = false;
        while (at < end && session.good()) {
            const u8 byte = session.source_byte(at);
            if (radix == 2u64 && byte == '\'') {
                if (!previous_digit) {
                    return LiteralValue(-1, 0, 0u64, false);
                }
                previous_digit = false;
            } else {
                if (byte < '0' || byte > '9' || (radix == 2u64 && byte > '1')) {
                    return LiteralValue(-1, 0, 0u64, false);
                }
                const u64 digit = u64(byte) - 48u64;
                if (magnitude > (18446744073709551615u64 - digit) / radix) {
                    return LiteralValue(-1, 0, 0u64, false);
                }
                magnitude = magnitude * radix + digit;
                previous_digit = true;
            }
            at = at + 1;
        }
        return LiteralValue(-1, 0, magnitude, previous_digit);
    }
    auto negative_literal_magnitude(compiler_resolver::Session& session, i64 node, i64 unary_source) -> LiteralValue {
        const i64 reference = source_ref(session, node);
        const compiler_resolver::MetaRow token = session.meta(reference);
        const i64 begin = token.word(1);
        const i64 end = token.word(2);
        const LiteralValue absent = LiteralValue(-1, 0, 0u64, false);
        if (end <= begin || session.source_byte(begin) < '0' || session.source_byte(begin) > '9') {
            return absent;
        }
        if ((end - begin >= 2 && session.source_byte(end - 2) == 'u' && session.source_byte(end - 1) == '8') || (end
            - begin >= 3 && session.source_byte(end - 3) == 'u' && session.source_byte(end - 2) == '6'
            && session.source_byte(end - 1) == '4')) {
            return absent;
        }
        if (end - begin >= 2 && session.source_byte(begin) == '0' && (session.source_byte(begin + 1) == 'b'
            || session.source_byte(begin + 1) == 'B')) {
            const LiteralValue result = integer_magnitude(session, begin, end);
            if (!result.valid()) {
                fail(session, LoweringError::integer_literal_range, unary_source);
            }
            return result;
        }
        // Legacy decimal stoull checks prefix overflow before deciding whether
        // trailing suffix bytes force the full-token diagnostic instead.
        i64 cursor = begin;
        u64 magnitude = 0u64;
        while (cursor < end && session.good()) {
            const u8 byte = session.source_byte(cursor);
            if (byte < '0' || byte > '9') {
                return absent;
            }
            const u64 digit = u64(byte) - 48u64;
            if (magnitude > (18446744073709551615u64 - digit) / 10u64) {
                fail(session, LoweringError::integer_literal_range, unary_source);
                return absent;
            }
            magnitude = magnitude * 10u64 + digit;
            cursor = cursor + 1;
        }
        return LiteralValue(-1, 0, magnitude, true);
    }
    auto decode_literal(compiler_resolver::Session& session, i64 expression) -> LiteralValue {
        const i64 reference = source_ref(session, expression);
        const compiler_resolver::MetaRow source = session.meta(reference);
        const i64 begin = source.word(1);
        const i64 end = source.word(2);
        const compiler_resolver::ResolvedRow resolved = session.resolved(expression);
        i64 type = scalar_id(session, compiler_resolver::ResolvedTypeKind::i64_value);
        if (resolved.operation() == compiler_resolver::ResolvedOperation::capacity_constant) {
            return LiteralValue(type, resolved.word(3), 0u64, true);
        }
        if (session.source_equal(reference, "true") || session.source_equal(reference, "false")) {
            type = scalar_id(session, compiler_resolver::ResolvedTypeKind::bool_value);
            i64 value = 0;
            if (session.source_equal(reference, "true")) {
                value = 1;
            }
            return LiteralValue(type, value, 0u64, true);
        }
        if (session.source_byte(begin) == '\'') {
            type = scalar_id(session, compiler_resolver::ResolvedTypeKind::u8_value);
            const i64 number = byte_literal(session, begin, end);
            if (number < 0) {
                fail(session, LoweringError::invalid_byte_literal, reference);
            }
            return LiteralValue(type, number, 0u64, number >= 0);
        }
        i64 digits_end = end;
        bool unsigned_value = false;
        bool byte_value = false;
        if (end - begin >= 2 && session.source_byte(end - 2) == 'u' && session.source_byte(end - 1) == '8') {
            digits_end = end - 2;
            unsigned_value = true;
            byte_value = true;
            type = scalar_id(session, compiler_resolver::ResolvedTypeKind::u8_value);
        } else {
            if (end - begin >= 3 && session.source_byte(end - 3) == 'u' && session.source_byte(end - 2) == '6'
                && session.source_byte(end - 1) == '4') {
                digits_end = end - 3;
                unsigned_value = true;
                type = scalar_id(session, compiler_resolver::ResolvedTypeKind::u64_value);
            }
        }
        const LiteralValue magnitude = integer_magnitude(session, begin, digits_end);
        if (!magnitude.valid() || (byte_value && magnitude.unsigned_value() > 255u64) || (!unsigned_value
            && magnitude.unsigned_value() > 9223372036854775807u64)) {
            fail(session, LoweringError::invalid_integer_literal_or_suffix, reference);
            return LiteralValue(type, 0, 0u64, false);
        }
        i64 signed_value = 0;
        if (!unsigned_value || byte_value) {
            signed_value = i64(magnitude.unsigned_value());
        }
        return LiteralValue(type, signed_value, magnitude.unsigned_value(), true);
    }
    auto emit_literal(compiler_resolver::Session& session, LiteralValue literal) -> i64 {
        if (value_kind(session, literal.type()) == compiler_resolver::ResolvedTypeKind::u64_value) {
            return emit_unsigned(session, literal.unsigned_value(), literal.type());
        }
        return emit_signed(session, literal.signed_value(), literal.type());
    }
    // Three decoder passes share one bounded decoder: measure and validate,
    // retain literal-span bytes, or emit array constants. Array initialization
    // never allocates decoded payload in the source owner.
    auto decode_string(compiler_resolver::Session& session, i64 reference, bool retain, bool array_values) -> i64 {
        const compiler_resolver::MetaRow source = session.meta(reference);
        const i64 begin = source.word(1);
        const i64 end = source.word(2);
        if (end - begin < 2 || session.source_byte(begin) != '"' || session.source_byte(end - 1) != '"') {
            return error(session, LoweringError::invalid_byte_string_literal, reference);
        }
        i64 at = begin + 1;
        i64 count = 0;
        while (at < end - 1 && session.good()) {
            const u8 first = session.source_byte(at);
            i64 width = 1;
            i64 value = i64(first);
            if (first == '\\') {
                if (at + 1 >= end - 1) {
                    return error(session, LoweringError::invalid_byte_string_literal, reference);
                }
                const u8 second = session.source_byte(at + 1);
                width = 2;
                value = escape_byte(second);
                if (second == '"') {
                    value = 34;
                }
                if (second == 'x') {
                    width = 4;
                    if (at + width > end - 1) {
                        return error(session, LoweringError::invalid_byte_string_literal, reference);
                    }
                    const i64 high = hex_digit(session.source_byte(at + 2));
                    const i64 low = hex_digit(session.source_byte(at + 3));
                    if (high >= 0 && low >= 0) {
                        value = high * 16 + low;
                    }
                }
                if (value < 0) {
                    return error(session, LoweringError::invalid_byte_string_literal, reference);
                }
            } else {
                if (first < 128u8) {
                    if (first < 32u8 || first == 127u8 || first == '"') {
                        return error(session, LoweringError::invalid_byte_string_literal, reference);
                    }
                } else {
                    u64 scalar = 0u64;
                    if (first >= 194u8 && first <= 223u8) {
                        width = 2;
                        scalar = u64(first) & 31u64;
                    } else {
                        if (first >= 224u8 && first <= 239u8) {
                            width = 3;
                            scalar = u64(first) & 15u64;
                        } else {
                            if (first >= 240u8 && first <= 244u8) {
                                width = 4;
                                scalar = u64(first) & 7u64;
                            } else {
                                return error(session, LoweringError::invalid_byte_string_literal, reference);
                            }
                        }
                    }
                    if (at + width > end - 1) {
                        return error(session, LoweringError::invalid_byte_string_literal, reference);
                    }
                    i64 continuation = 1;
                    while (continuation < width) {
                        const u8 byte = session.source_byte(at + continuation);
                        if (byte < 128u8 || byte > 191u8) {
                            return error(session, LoweringError::invalid_byte_string_literal, reference);
                        }
                        scalar =(scalar << 6) | (u64(byte) & 63u64);
                        continuation = continuation + 1;
                    }
                    if ((width == 3 && scalar < 2048u64) || (width == 4 && scalar < 65536u64) || scalar > 1114111u64
                        || (scalar >= 55296u64 && scalar <= 57343u64)) {
                        return error(session, LoweringError::invalid_byte_string_literal, reference);
                    }
                }
            }
            i64 produced = 1;
            if (first >= 128u8) {
                produced = width;
            }
            if (count > 4096 - produced) {
                return error(session, LoweringError::invalid_byte_string_literal, reference);
            }
            i64 byte_index = 0;
            while (byte_index < produced && session.good()) {
                i64 decoded = value;
                if (first >= 128u8) {
                    decoded = i64(session.source_byte(at + byte_index));
                }
                if (retain) {
                    session.append_literal_byte(u8(decoded));
                }
                if (array_values) {
                    const i64 staged_type_12 = scalar_id(session, compiler_resolver::ResolvedTypeKind::u8_value);
                    emit_signed(session, decoded, staged_type_12);
                    emit_Push(session);
                }
                byte_index = byte_index + 1;
            }
            count = count + produced;
            at = at + width;
        }
        return count;
    }
}
