export module aurora.compiler.ir_metadata;
import aurora.compiler.ir_metadata_storage;

// Independent verification of the actual native Module import. Raw prefixes
// stay immutable; only normalized fields, offsets, storage and results append.
// No lowering result, native canonicality bit or caller-supplied offset is proof.
export namespace compiler_ir_metadata {
    auto fail(MetadataStore& store, MetadataError reason) -> bool {
        store.reject(reason);
        return false;
    }
    auto index_range(IndexRange range, i64 limit) -> bool {
        return range.begin() >= 0 && range.count() >= 0 && range.begin() <= limit && range.count() <= limit
            - range.begin();
    }
    auto byte_range(ByteRange range, i64 limit) -> bool {
        return range.begin() >= 0 && range.count() >= 0 && range.begin() <= limit && range.count() <= limit
            - range.begin();
    }
    // Getter results cross a copied-argument boundary, never a temporary method
    // receiver. The bootstrap language deliberately does not admit the latter.
    auto range_begin(IndexRange range) -> i64 {
        return range.begin();
    }
    auto range_count(IndexRange range) -> i64 {
        return range.count();
    }
    auto name_length(ByteRange name) -> i64 {
        return name.count();
    }
    // Unknown bits are rejected by input_integrity before any flag grants authority.
    auto member(ClassRow row, u64 bit) -> bool {
        return (row.membership() & bit) != 0u64;
    }
    // Byte-lexicographic order matches std::map<std::string, ...>, including
    // embedded NUL and bytes above ASCII. Names are never C strings.
    auto compare_names(const MetadataStore& store, ByteRange left, ByteRange right) -> i64 {
        const i64 left_begin = left.begin();
        const i64 right_begin = right.begin();
        const i64 left_count = left.count();
        const i64 right_count = right.count();
        i64 count = left_count;
        if (right_count < count) {
            count = right_count;
        }
        const i64 order = store.compare_bytes(left_begin, right_begin, count);
        if (order != 0) {
            return order;
        }
        if (left_count < right_count) {
            return -1;
        }
        if (left_count > right_count) {
            return 1;
        }
        return 0;
    }
    // Searches of admitted sorted names start each comparison after the bytes the
    // key is known to share with both search bounds: in sorted order every name
    // between two bounds shares at least that prefix with the key. Callable,
    // class and enum names are proven sorted before any search reads them.
    auto shared_prefix(const MetadataStore& store, ByteRange left, ByteRange right, i64 start) -> i64 {
        i64 count = left.count();
        if (right.count() < count) {
            count = right.count();
        }
        return store.shared_bytes(left.begin(), right.begin(), count, start);
    }
    // compare_names(left, right) when their first shared bytes are equal.
    auto order_after(const MetadataStore& store, ByteRange left, ByteRange right, i64 shared) -> i64 {
        if (shared < left.count() && shared < right.count()) {
            const i64 a = store.compared_byte(left.begin() + shared);
            const i64 b = store.compared_byte(right.begin() + shared);
            if (a < b) {
                return -1;
            }
            if (a > b) {
                return 1;
            }
            return 0;
        }
        if (left.count() < right.count()) {
            return -1;
        }
        if (left.count() > right.count()) {
            return 1;
        }
        return 0;
    }
    auto named(const MetadataStore& store, ByteRange name, builtin::span<const u8> expected) -> bool {
        if (name.count() != expected.size()) {
            return false;
        }
        i64 at = 0;
        while (at < name.count()) {
            if (store.byte_at(name.begin() + at) != i64(expected.at(at))) {
                return false;
            }
            at = at + 1;
        }
        return true;
    }
    auto find_class(const MetadataStore& store, ByteRange name) -> i64 {
        i64 begin = 0;
        i64 end = store.class_count();
        i64 below = 0;
        i64 above = 0;
        while (begin < end) {
            const i64 middle = begin + (end - begin) / 2;
            const ClassRow row = store.class_at(middle);
            i64 start = below;
            if (above < start) {
                start = above;
            }
            const i64 shared = shared_prefix(store, row.name(), name, start);
            const i64 order = order_after(store, row.name(), name, shared);
            if (order == 0) {
                return middle;
            }
            if (order < 0) {
                begin = middle + 1;
                below = shared;
            } else {
                end = middle;
                above = shared;
            }
        }
        return -1;
    }
    auto find_enum(const MetadataStore& store, ByteRange name) -> i64 {
        i64 begin = 0;
        i64 end = store.enum_count();
        i64 below = 0;
        i64 above = 0;
        while (begin < end) {
            const i64 middle = begin + (end - begin) / 2;
            const EnumRow row = store.enum_at(middle);
            i64 start = below;
            if (above < start) {
                start = above;
            }
            const i64 shared = shared_prefix(store, row.name(), name, start);
            const i64 order = order_after(store, row.name(), name, shared);
            if (order == 0) {
                return middle;
            }
            if (order < 0) {
                begin = middle + 1;
                below = shared;
            } else {
                end = middle;
                above = shared;
            }
        }
        return -1;
    }
    auto has_descriptor(const MetadataStore& store, i64 id) -> bool {
        i64 begin = 0;
        i64 end = store.descriptor_count();
        while (begin < end) {
            const i64 middle = begin + (end - begin) / 2;
            const DescriptorRow row = store.descriptor_at(middle);
            if (row.id() == id) {
                return true;
            }
            if (row.id() < id) {
                begin = middle + 1;
            } else {
                end = middle;
            }
        }
        return false;
    }
    // Ordinals are pinned to the generated MetadataTypeKind facts at the host
    // boundary. Keeping raw integers lets an unknown native TypeKind reject at
    // the same predicate as any other noncanonical type, without enum traps.
    auto canonical_tail(RawTypeRow type) -> bool {
        const RawTypeTail tail = type.tail();
        return tail.element_kind() == 0 && tail.length() == 0 && tail.element_parameter_bytes() == 0u64
            && tail.length_parameter_bytes() == 0u64 && tail.template_argument_count() == 0u64;
    }
    auto scalar_type(RawTypeRow type) -> bool {
        return (type.kind() == 0 || type.kind() == 1 || type.kind() == 7 || type.kind() == 10)
            && name_length(type.name()) == 0 && canonical_tail(type);
    }
    auto scalar_value(const MetadataStore& store, RawTypeRow type) -> bool {
        return scalar_type(type) || (type.kind() == 9 && canonical_tail(type) && find_enum(store, type.name()) >= 0);
    }
    auto owner_kind(RawTypeRow type) -> bool {
        return type.kind() == 13 || type.kind() == 17;
    }
    auto owner_type(RawTypeRow type) -> bool {
        return canonical_tail(type) && ((type.kind() == 13 && name_length(type.name()) == 0) || type.kind() == 17);
    }
    auto same_type(const MetadataStore& store, RawTypeRow left, RawTypeRow right) -> bool {
        // Both operands were checked canonically before any use of this helper.
        return left.kind() == right.kind() && compare_names(store, left.name(), right.name()) == 0;
    }
    auto owning_class(const MetadataStore& store, i64 class_index) -> bool {
        if (class_index < 0) {
            return false;
        }
        const ClassResultRow result = store.result_at(class_index);
        const IndexRange fields = result.fields();
        i64 at = 0;
        while (at < fields.count()) {
            const FieldRow field = store.field_at(fields.begin() + at);
            const RawTypeRow type = store.type_at(field.type());
            if (owner_kind(type)) {
                return true;
            }
            at = at + 1;
        }
        return false;
    }
    auto copied_leaves(const MetadataStore& store, ClassRow row) -> bool {
        const IndexRange leaves = row.leaves();
        if (leaves.count() > 513) {
            return false;
        }
        i64 bytes = 0;
        i64 at = 0;
        while (at < leaves.count()) {
            const RawTypeRow type = store.type_at(leaves.begin() + at);
            if (type.kind() == 10) {
                bytes = bytes + 1;
            }
            at = at + 1;
        }
        return bytes <= 512 && leaves.count() - bytes <= 64;
    }
    auto scalar_array_limit(RawTypeRow type) -> i64 {
        if (type.kind() == 10) {
            return 512;
        }
        return 64;
    }

    auto callable_flag(CallableRow row, u64 bit) -> bool {
        return (row.attributes() & bit) != 0u64;
    }
    auto receiver_flag(ReceiverShape receiver, u64 bit) -> bool {
        return (receiver.attributes() & bit) != 0u64;
    }
    auto absent_receiver(ReceiverShape receiver) -> bool {
        const ByteRange name = receiver.name();
        return name.begin() == 0 && name.count() == 0 && receiver.attributes() == 0u64;
    }
    // Symbols precede module metadata diagnostics. Only the names and sorted
    // suffix they read are admitted first; other transport checks remain below.
    auto callable_name_integrity(MetadataStore& store) -> bool {
        const i64 count = store.callable_count();
        if (count < 0 || count > store.input_index_count()) {
            return fail(store, MetadataError::integrity);
        }
        i64 at = 0;
        while (at < count) {
            const CallableRow row = store.callable_at(at);
            if (!byte_range(row.name(), store.byte_count())) {
                return fail(store, MetadataError::integrity);
            }
            at = at + 1;
        }
        const i64 first = store.input_index_count() - count;
        at = 0;
        while (at < count) {
            const IndexRow id = store.index_at(first + at);
            if (id.value() < 0 || id.value() >= count) {
                return fail(store, MetadataError::integrity);
            }
            if (at > 0) {
                const IndexRow previous_id = store.index_at(first + at - 1);
                const CallableRow previous = store.callable_at(previous_id.value());
                const CallableRow row = store.callable_at(id.value());
                const i64 order = compare_names(store, previous.name(), row.name());
                if (order > 0 || (order == 0 && previous_id.value() >= id.value())) {
                    return fail(store, MetadataError::integrity);
                }
            }
            at = at + 1;
        }
        // Strict (name, original ID) order excludes every repeated ID. Since
        // exactly count in-range IDs were read, the suffix is a permutation.
        return true;
    }
    auto first_named_callable(const MetadataStore& store, ByteRange name) -> i64 {
        const i64 first = store.input_index_count() - store.callable_count();
        i64 begin = 0;
        i64 end = store.callable_count();
        i64 below = 0;
        i64 above = 0;
        while (begin < end) {
            const i64 middle = begin + (end - begin) / 2;
            const IndexRow id = store.index_at(first + middle);
            const CallableRow row = store.callable_at(id.value());
            i64 start = below;
            if (above < start) {
                start = above;
            }
            const i64 shared = shared_prefix(store, row.name(), name, start);
            if (order_after(store, row.name(), name, shared) < 0) {
                begin = middle + 1;
                below = shared;
            } else {
                end = middle;
                above = shared;
            }
        }
        if (begin >= store.callable_count()) {
            return -1;
        }
        const IndexRow id = store.index_at(first + begin);
        const CallableRow row = store.callable_at(id.value());
        if (compare_names(store, row.name(), name) != 0) {
            return -1;
        }
        return id.value();
    }
    auto symbol_letter(i64 value) -> bool {
        return (value >= 65 && value <= 90) || (value >= 97 && value <= 122) || value == 95;
    }
    auto symbol_name(const MetadataStore& store, ByteRange name) -> bool {
        if (name.count() == 0 || !symbol_letter(store.byte_at(name.begin()))) {
            return false;
        }
        i64 at = 1;
        while (at < name.count()) {
            const i64 value = store.byte_at(name.begin() + at);
            if (!symbol_letter(value) && (value < 48 || value > 57)) {
                return false;
            }
            at = at + 1;
        }
        return true;
    }
    auto name_prefix(const MetadataStore& store, ByteRange name, builtin::span<const u8> prefix) -> bool {
        return name.count() >= prefix.size() && named(store, ByteRange(name.begin(), prefix.size()), prefix);
    }
    auto verify_callable_symbols(MetadataStore& store) -> bool {
        if (store.callable_count() == 0) {
            return fail(store, MetadataError::empty_module);
        }
        i64 at = 0;
        while (at < store.callable_count()) {
            const CallableRow row = store.callable_at(at);
            if (!symbol_name(store, row.name()) || named(store, row.name(), "aurora_reflect_size") || named(store,
                row.name(), "aurora_reflect_field_count") || name_prefix(store, row.name(), "__au_reflect_")
                || name_prefix(store, row.name(), "__au_runtime_")) {
                return fail(store, MetadataError::function_symbol);
            }
            if (first_named_callable(store, row.name()) != at) {
                return fail(store, MetadataError::duplicate_function);
            }
            at = at + 1;
        }
        return true;
    }

    // Check only transport here. In particular raw Type tails, nominal names,
    // physical extents and semantic counts stay untouched until their original
    // diagnostic position. All ranges are checked before their first read.
    auto input_integrity(MetadataStore& store) -> bool {
        const FlagMasks masks = FlagMasks();
        const i64 declarations = store.instruction_type_begin();
        if (declarations < 0 || declarations > store.type_count() || store.leaf_count() < 0 || store.input_field_count()
            < 0 || store.leaf_count() > declarations || store.input_field_count() > declarations - store.leaf_count()) {
            return fail(store, MetadataError::integrity);
        }
        i64 at = 0;
        while (at < store.type_count()) {
            const RawTypeRow type = store.type_at(at);
            if (!byte_range(type.name(), store.byte_count())) {
                return fail(store, MetadataError::integrity);
            }
            at = at + 1;
        }
        i64 next_type = store.leaf_count() + store.input_field_count();
        i64 next_slot = 0;
        at = 0;
        while (at < store.callable_count()) {
            const CallableRow row = store.callable_at(at);
            const IndexRange types = row.types();
            const IndexRange slots = row.slots();
            const ReceiverShape receiver = row.first_receiver();
            if (!index_range(types, declarations) || types.count() < 1 || types.begin() != next_type
                || !index_range(slots, store.slot_count()) || slots.begin() != next_slot || (row.attributes()
                & ~masks.callable_allowed()) != 0u64 || row.borrowed_root_count() < 0 || !byte_range(receiver.name(),
                store.byte_count()) || (receiver.attributes() & ~masks.receiver_allowed()) != 0u64
                || (!callable_flag(row, masks.callable_receiver()) && !absent_receiver(receiver))
                || (!callable_flag(row, masks.callable_span_summary()) && row.receiver_span_field() != 0)) {
                return fail(store, MetadataError::integrity);
            }
            next_type = next_type + types.count();
            i64 slot_index = 0;
            while (slot_index < slots.count()) {
                const SlotRow slot = store.slot_at(slots.begin() + slot_index);
                const i64 kind = slot.kind();
                if ((kind < 10 || kind > 17) && kind != 27 || (kind != 12 && slot.length() != 0) || (kind != 11 && kind
                    != 16 && slot.mutable_value() != 0) || ((kind == 11 || kind == 16) && slot.mutable_value() != 0
                    && slot.mutable_value() != 1)) {
                    return fail(store, MetadataError::integrity);
                }
                if (slot_index > 0) {
                    const SlotRow previous = store.slot_at(slots.begin() + slot_index - 1);
                    if (previous.kind() > kind || (previous.kind() == kind && previous.offset() >= slot.offset())) {
                        return fail(store, MetadataError::integrity);
                    }
                }
                if (kind == 10 || kind == 11 || kind == 17 || kind == 27) {
                    if (next_type >= declarations || slot.type() != next_type) {
                        return fail(store, MetadataError::integrity);
                    }
                    next_type = next_type + 1;
                } else {
                    if (slot.type() != 0) {
                        return fail(store, MetadataError::integrity);
                    }
                }
                slot_index = slot_index + 1;
            }
            next_slot = next_slot + slots.count();
            at = at + 1;
        }
        if (next_type != declarations || next_slot != store.slot_count()) {
            return fail(store, MetadataError::integrity);
        }
        const i64 metadata_indices = store.input_index_count() - store.callable_count();
        i64 next_leaf = 0;
        i64 next_field = 0;
        i64 next_storage = 0;
        i64 next_index = 0;
        at = 0;
        while (at < store.class_count()) {
            const ClassRow row = store.class_at(at);
            if (!byte_range(row.name(), store.byte_count()) || row.membership() == 0u64 || (row.membership()
                & ~masks.class_allowed()) != 0u64 || !index_range(row.leaves(), store.leaf_count())
                || !index_range(row.fields(), store.input_field_count()) || range_begin(row.leaves()) != next_leaf
                || range_begin(row.fields()) != next_field || (!member(row, masks.class_layout())
                && range_count(row.leaves()) != 0) || (!member(row, masks.class_fields()) && range_count(row.fields())
                != 0)) {
                return fail(store, MetadataError::integrity);
            }
            if (at > 0) {
                const ClassRow previous = store.class_at(at - 1);
                if (compare_names(store, previous.name(), row.name()) >= 0) {
                    return fail(store, MetadataError::integrity);
                }
            }
            next_leaf = next_leaf + range_count(row.leaves());
            next_field = next_field + range_count(row.fields());
            if (member(row, masks.class_storage())) {
                if (row.supplied_storage() != next_storage || next_storage >= store.input_storage_count()) {
                    return fail(store, MetadataError::integrity);
                }
                const StorageRow storage = store.storage_at(next_storage);
                if (!index_range(storage.leaf_offsets(), metadata_indices) || range_begin(storage.leaf_offsets())
                    != next_index) {
                    return fail(store, MetadataError::integrity);
                }
                next_index = next_index + range_count(storage.leaf_offsets());
                if (!index_range(storage.field_offsets(), metadata_indices) || range_begin(storage.field_offsets())
                    != next_index) {
                    return fail(store, MetadataError::integrity);
                }
                next_index = next_index + range_count(storage.field_offsets());
                next_storage = next_storage + 1;
            } else {
                if (row.supplied_storage() != -1) {
                    return fail(store, MetadataError::integrity);
                }
            }
            at = at + 1;
        }
        if (next_leaf != store.leaf_count() || next_field != store.input_field_count() || next_storage
            != store.input_storage_count()) {
            return fail(store, MetadataError::integrity);
        }
        at = 0;
        while (at < store.input_field_count()) {
            const FieldRow field = store.field_at(at);
            if (field.type() != store.leaf_count() + at || (field.array_flag() != 0 && field.array_flag() != 1)) {
                return fail(store, MetadataError::integrity);
            }
            at = at + 1;
        }
        at = 0;
        while (at < store.descriptor_count()) {
            if (at > 0) {
                const DescriptorRow previous = store.descriptor_at(at - 1);
                const DescriptorRow row = store.descriptor_at(at);
                if (previous.id() >= row.id()) {
                    return fail(store, MetadataError::integrity);
                }
            }
            at = at + 1;
        }
        at = 0;
        while (at < store.view_count()) {
            const ViewRow row = store.view_at(at);
            if (!index_range(row.descriptors(), metadata_indices) || range_begin(row.descriptors()) != next_index) {
                return fail(store, MetadataError::integrity);
            }
            if (at > 0) {
                const ViewRow previous = store.view_at(at - 1);
                if (previous.scope() >= row.scope()) {
                    return fail(store, MetadataError::integrity);
                }
            }
            i64 entry = 1;
            while (entry < range_count(row.descriptors())) {
                const IndexRow previous = store.index_at(next_index + entry - 1);
                const IndexRow value = store.index_at(next_index + entry);
                if (previous.value() >= value.value()) {
                    return fail(store, MetadataError::integrity);
                }
                entry = entry + 1;
            }
            next_index = next_index + range_count(row.descriptors());
            at = at + 1;
        }
        if (next_index != metadata_indices) {
            return fail(store, MetadataError::integrity);
        }
        at = 0;
        while (at < store.enum_count()) {
            const EnumRow row = store.enum_at(at);
            if (!byte_range(row.name(), store.byte_count())) {
                return fail(store, MetadataError::integrity);
            }
            if (at > 0) {
                const EnumRow previous = store.enum_at(at - 1);
                if (compare_names(store, previous.name(), row.name()) >= 0) {
                    return fail(store, MetadataError::integrity);
                }
            }
            at = at + 1;
        }
        return true;
    }

    auto verify_headers(MetadataStore& store) -> bool {
        const FlagMasks masks = FlagMasks();
        i64 at = 0;
        while (at < store.descriptor_count()) {
            const DescriptorRow row = store.descriptor_at(at);
            if (row.id() <= 0 || row.size() < 0 || row.public_fields() < 0) {
                return fail(store, MetadataError::descriptor);
            }
            at = at + 1;
        }
        bool root = false;
        at = 0;
        while (at < store.view_count()) {
            const ViewRow row = store.view_at(at);
            root = root || row.scope() == 0;
            at = at + 1;
        }
        if (!root) {
            return fail(store, MetadataError::root_scope);
        }
        at = 0;
        while (at < store.view_count()) {
            const ViewRow row = store.view_at(at);
            if (row.scope() < 0 || row.scope() >= 64) {
                return fail(store, MetadataError::scope);
            }
            i64 entry = 0;
            while (entry < range_count(row.descriptors())) {
                const IndexRow id = store.index_at(range_begin(row.descriptors()) + entry);
                if (!has_descriptor(store, id.value())) {
                    return fail(store, MetadataError::view_descriptor);
                }
                entry = entry + 1;
            }
            at = at + 1;
        }
        if (store.enum_count() > 64) {
            return fail(store, MetadataError::enum_count);
        }
        at = 0;
        while (at < store.enum_count()) {
            const EnumRow row = store.enum_at(at);
            if (name_length(row.name()) == 0 || name_length(row.name()) > 4096 || row.cases() < 1 || row.cases()
                > 256) {
                return fail(store, MetadataError::enum_declaration);
            }
            const i64 class_index = find_class(store, row.name());
            if (class_index >= 0) {
                const ClassRow declaration = store.class_at(class_index);
                if (member(declaration, masks.class_layout())) {
                    return fail(store, MetadataError::nominal_overlap);
                }
            }
            at = at + 1;
        }
        at = 0;
        while (at < store.class_count()) {
            const ClassRow row = store.class_at(at);
            if (member(row, masks.class_layout())) {
                if (name_length(row.name()) == 0 || name_length(row.name()) > 4096 || range_count(row.leaves())
                    > 8192) {
                    return fail(store, MetadataError::class_layout);
                }
                i64 leaf = 0;
                while (leaf < range_count(row.leaves())) {
                    const RawTypeRow type = store.type_at(range_begin(row.leaves()) + leaf);
                    if (!scalar_value(store, type)) {
                        return fail(store, MetadataError::class_leaf);
                    }
                    leaf = leaf + 1;
                }
            }
            at = at + 1;
        }
        return true;
    }
    auto normalize_fields(MetadataStore& store) -> bool {
        const FlagMasks masks = FlagMasks();
        i64 at = 0;
        while (at < store.class_count()) {
            const ClassRow row = store.class_at(at);
            if (member(row, masks.class_fields()) && !member(row, masks.class_layout())) {
                return fail(store, MetadataError::unknown_fields);
            }
            at = at + 1;
        }
        at = 0;
        while (at < store.class_count()) {
            const ClassRow row = store.class_at(at);
            const IndexRange original_fields = row.fields();
            i64 field_begin = original_fields.begin();
            i64 field_length = original_fields.count();
            if (field_length > maximum_class_fields()) {
                return fail(store, MetadataError::class_field_limit);
            }
            if (member(row, masks.class_layout()) && !member(row, masks.class_fields())) {
                const i64 begin = store.field_row_count();
                i64 leaf = 0;
                while (leaf < range_count(row.leaves())) {
                    const FieldRow field = FieldRow(range_begin(row.leaves()) + leaf, leaf, 1, 0, 1);
                    if (store.append_field(field) < 0) {
                        return false;
                    }
                    leaf = leaf + 1;
                }
                field_begin = begin;
                field_length = range_count(row.leaves());
            }
            const IndexRange fields = IndexRange(field_begin, field_length);
            const ClassResultRow result = ClassResultRow(fields, -1, 0, 0);
            if (!store.set_result(at, result)) {
                return false;
            }
            at = at + 1;
        }
        return true;
    }
    auto verify_fields(MetadataStore& store) -> bool {
        const FlagMasks masks = FlagMasks();
        i64 at = 0;
        while (at < store.class_count()) {
            const ClassRow row = store.class_at(at);
            if (member(row, masks.class_layout())) {
                const ClassResultRow result = store.result_at(at);
                const IndexRange fields = result.fields();
                i64 next_leaf = 0;
                bool composed = false;
                i64 field_index = 0;
                while (field_index < fields.count()) {
                    const FieldRow field = store.field_at(fields.begin() + field_index);
                    const RawTypeRow type = store.type_at(field.type());
                    const bool child = type.kind() == 5;
                    if (!(field.array_flag() != 0 && child) && field.element_count() != 1) {
                        return fail(store, MetadataError::field_element_count);
                    }
                    const i64 child_index = find_class(store, type.name());
                    if (child && child_index >= 0) {
                        const ClassRow child_row = store.class_at(child_index);
                        if (member(child_row, masks.class_array_carrier())) {
                            return fail(store, MetadataError::nested_carrier);
                        }
                    }
                    if (field.first_leaf() < 0 || field.first_leaf() != next_leaf) {
                        return fail(store, MetadataError::field_shape);
                    }
                    if (owner_kind(type)) {
                        if (field.array_flag() != 0 || field.length() != 0) {
                            return fail(store, MetadataError::owner_leaves);
                        }
                        if (!owner_type(type)) {
                            return fail(store, MetadataError::owner_field_type);
                        }
                    } else {
                        if (child) {
                            composed = true;
                            if (owning_class(store, child_index)) {
                                return fail(store, MetadataError::nested_owner);
                            }
                            if (!canonical_tail(type) || child_index < 0) {
                                return fail(store, MetadataError::nested_type);
                            }
                            const ClassRow child_row = store.class_at(child_index);
                            if (!member(child_row, masks.class_layout())) {
                                return fail(store, MetadataError::nested_type);
                            }
                            i64 count = 1;
                            if (field.array_flag() != 0) {
                                count = field.element_count();
                            }
                            if (count < 1 || count > 64) {
                                return fail(store, MetadataError::class_array_count);
                            }
                            if (field.length() < 0 || field.length() > 513 || field.length()
                                != range_count(child_row.leaves()) * count) {
                                return fail(store, MetadataError::nested_length);
                            }
                            if (field.length() > range_count(row.leaves()) - next_leaf) {
                                return fail(store, MetadataError::field_range);
                            }
                            i64 element = 0;
                            while (element < count) {
                                i64 leaf = 0;
                                while (leaf < range_count(child_row.leaves())) {
                                    const RawTypeRow left = store.type_at(range_begin(row.leaves()) + next_leaf
                                        + element * range_count(child_row.leaves()) + leaf);
                                    const RawTypeRow right = store.type_at(range_begin(child_row.leaves()) + leaf);
                                    if (!same_type(store, left, right)) {
                                        return fail(store, MetadataError::nested_leaf);
                                    }
                                    leaf = leaf + 1;
                                }
                                element = element + 1;
                            }
                        } else {
                            bool valid = scalar_value(store, type);
                            i64 maximum = 1;
                            if (field.array_flag() != 0) {
                                valid = scalar_type(type);
                                maximum = scalar_array_limit(type);
                            }
                            if (!valid || field.length() < 1 || field.length() > maximum) {
                                return fail(store, MetadataError::field_shape);
                            }
                            if (field.length() > range_count(row.leaves()) - next_leaf) {
                                return fail(store, MetadataError::field_range);
                            }
                            i64 leaf = 0;
                            while (leaf < field.length()) {
                                const RawTypeRow actual = store.type_at(range_begin(row.leaves()) + next_leaf + leaf);
                                if (!same_type(store, actual, type)) {
                                    return fail(store, MetadataError::field_leaf);
                                }
                                leaf = leaf + 1;
                            }
                        }
                    }
                    next_leaf = next_leaf + field.length();
                    field_index = field_index + 1;
                }
                if (next_leaf != range_count(row.leaves())) {
                    return fail(store, MetadataError::leaf_coverage);
                }
                if ((composed || owning_class(store, at)) && !copied_leaves(store, row)) {
                    return fail(store, MetadataError::class_leaf_limit);
                }
            }
            at = at + 1;
        }
        return true;
    }

    auto verify_carriers(MetadataStore& store) -> bool {
        const FlagMasks masks = FlagMasks();
        i64 at = 0;
        while (at < store.class_count()) {
            const ClassRow row = store.class_at(at);
            if (member(row, masks.class_array_carrier())) {
                if (!member(row, masks.class_layout())) {
                    return fail(store, MetadataError::unknown_carrier);
                }
                const ClassResultRow result = store.result_at(at);
                const IndexRange fields = result.fields();
                if (fields.count() != 1) {
                    return fail(store, MetadataError::carrier_shape);
                }
                const FieldRow field = store.field_at(fields.begin());
                const RawTypeRow type = store.type_at(field.type());
                if (field.array_flag() == 0 || type.kind() != 5) {
                    return fail(store, MetadataError::carrier_shape);
                }
            }
            at = at + 1;
        }
        return true;
    }
    // The mark and cached depth obey the old DFS order: cycle first, path bound
    // second, cached-subtree bound third. This includes empty nested cycles.
    auto enter_depth(MetadataStore& store, i64 class_index, i64 path) -> bool {
        const ClassResultRow result = store.result_at(class_index);
        if (result.mark() == 1) {
            return fail(store, MetadataError::cycle);
        }
        if (path > 4) {
            return fail(store, MetadataError::depth);
        }
        if (result.mark() == 2) {
            if (path + result.depth() - 1 > 4) {
                return fail(store, MetadataError::depth);
            }
            return true;
        }
        const ClassResultRow entered = ClassResultRow(result.fields(), -1, 1, 1);
        const FrameRow frame = FrameRow(class_index, 0, path);
        return store.set_result(class_index, entered) && store.push_frame(frame);
    }
    auto verify_depths(MetadataStore& store) -> bool {
        const FlagMasks masks = FlagMasks();
        i64 at = 0;
        while (at < store.class_count()) {
            const ClassRow row = store.class_at(at);
            if (member(row, masks.class_layout())) {
                if (!enter_depth(store, at, 1)) {
                    return false;
                }
                while (store.frame_count() > 0) {
                    const i64 top = store.frame_count() - 1;
                    const FrameRow frame = store.frame_at(top);
                    const ClassResultRow result = store.result_at(frame.class_index());
                    const IndexRange fields = result.fields();
                    if (frame.next_field() == fields.count()) {
                        const ClassResultRow finished = ClassResultRow(fields, -1, result.depth(), 2);
                        if (!store.set_result(frame.class_index(), finished) || !store.pop_frame()) {
                            return false;
                        }
                    } else {
                        const FieldRow field = store.field_at(fields.begin() + frame.next_field());
                        const RawTypeRow type = store.type_at(field.type());
                        bool advance = true;
                        if (type.kind() == 5) {
                            const i64 child = find_class(store, type.name());
                            if (child < 0) {
                                return fail(store, MetadataError::integrity);
                            }
                            const ClassResultRow child_result = store.result_at(child);
                            if (!enter_depth(store, child, frame.path_depth() + 1)) {
                                return false;
                            }
                            if (child_result.mark() != 2) {
                                // Resume the same edge once the child has a cached depth.
                                advance = false;
                            } else {
                                i64 depth = result.depth();
                                if (1 + child_result.depth() > depth) {
                                    depth = 1 + child_result.depth();
                                }
                                const ClassResultRow updated = ClassResultRow(fields, -1, depth, 1);
                                if (!store.set_result(frame.class_index(), updated)) {
                                    return false;
                                }
                            }
                        }
                        if (advance) {
                            const FrameRow next = FrameRow(frame.class_index(), frame.next_field() + 1,
                                frame.path_depth());
                            if (!store.set_frame(top, next)) {
                                return false;
                            }
                        }
                    }
                }
            }
            at = at + 1;
        }
        return true;
    }
    auto sealed_class(MetadataStore& store, i64 class_index, bool event) -> bool {
        const ClassRow row = store.class_at(class_index);
        const IndexRange leaves = row.leaves();
        i64 count = 3;
        MetadataError layout_error = MetadataError::console_layout;
        MetadataError fields_error = MetadataError::console_fields;
        MetadataError shape_error = MetadataError::console_field_shape;
        if (event) {
            count = 4;
            layout_error = MetadataError::event_layout;
            fields_error = MetadataError::event_fields;
            shape_error = MetadataError::event_field_shape;
        }
        if (leaves.count() != count) {
            return fail(store, layout_error);
        }
        i64 at = 0;
        while (at < count) {
            const RawTypeRow type = store.type_at(leaves.begin() + at);
            i64 expected = 1;
            if (at == 1) {
                expected = 10;
            }
            if (event) {
                expected = 7;
                if (at == 0) {
                    expected = 9;
                }
            }
            if (type.kind() != expected) {
                return fail(store, layout_error);
            }
            if (event && at == 0 && !named(store, type.name(), "__au_event_poll_result")) {
                return fail(store, layout_error);
            }
            at = at + 1;
        }
        const ClassResultRow result = store.result_at(class_index);
        const IndexRange fields = result.fields();
        if (fields.count() != count) {
            return fail(store, fields_error);
        }
        at = 0;
        while (at < count) {
            const FieldRow field = store.field_at(fields.begin() + at);
            const RawTypeRow type = store.type_at(field.type());
            const RawTypeRow leaf = store.type_at(leaves.begin() + at);
            if (field.array_flag() != 0 || field.first_leaf() != at || field.length() != 1 || !same_type(store, type,
                leaf)) {
                return fail(store, shape_error);
            }
            at = at + 1;
        }
        return true;
    }
    auto sealed_call_result(MetadataStore& store, i64 class_index, bool serve) -> bool {
        const ClassRow row = store.class_at(class_index);
        const IndexRange leaves = row.leaves();
        const ClassResultRow result = store.result_at(class_index);
        const IndexRange fields = result.fields();
        if (leaves.count() != 2 || fields.count() != 2) {
            return fail(store, MetadataError::call_layout);
        }
        i64 at = 0;
        while (at < 2) {
            const RawTypeRow type = store.type_at(leaves.begin() + at);
            bool status_type = type.kind() == 9;
            if (serve) {
                status_type = status_type && named(store, type.name(), "__au_serve_status");
            } else {
                status_type = status_type && named(store, type.name(), "__au_call_status");
            }
            if (!canonical_tail(type) || (at == 0 && !status_type) || (at == 1 && !plain_type(type, 7))) {
                return fail(store, MetadataError::call_layout);
            }
            const FieldRow field = store.field_at(fields.begin() + at);
            const RawTypeRow field_type = store.type_at(field.type());
            if (field.array_flag() != 0 || field.first_leaf() != at || field.length() != 1 || !same_type(store,
                field_type, type)) {
                return fail(store, MetadataError::call_fields);
            }
            at = at + 1;
        }
        return true;
    }
    auto sealed_enum(MetadataStore& store, builtin::span<const u8> name, i64 cases, bool event) -> bool {
        i64 at = 0;
        while (at < store.enum_count()) {
            const EnumRow row = store.enum_at(at);
            if (named(store, row.name(), name) && row.cases() != cases) {
                if (event) {
                    return fail(store, MetadataError::event_enum);
                }
                return fail(store, MetadataError::service_enum);
            }
            at = at + 1;
        }
        return true;
    }
    auto verify_sealed(MetadataStore& store) -> bool {
        const FlagMasks masks = FlagMasks();
        // Preserve the service-contract order, rather than map-name order.
        i64 at = 0;
        while (at < store.class_count()) {
            const ClassRow row = store.class_at(at);
            if (member(row, masks.class_layout()) && named(store, row.name(), "__au_console_sample")) {
                if (!sealed_class(store, at, false)) {
                    return false;
                }
            }
            at = at + 1;
        }
        at = 0;
        while (at < store.class_count()) {
            const ClassRow row = store.class_at(at);
            if (member(row, masks.class_layout()) && named(store, row.name(), "__au_iommu_event_sample")) {
                if (!sealed_class(store, at, true)) {
                    return false;
                }
            }
            at = at + 1;
        }
        at = 0;
        while (at < store.class_count()) {
            const ClassRow row = store.class_at(at);
            if (member(row, masks.class_layout()) && named(store, row.name(), "__au_call_result")) {
                if (!sealed_call_result(store, at, false)) {
                    return false;
                }
            }
            at = at + 1;
        }
        at = 0;
        while (at < store.class_count()) {
            const ClassRow row = store.class_at(at);
            if (member(row, masks.class_layout()) && named(store, row.name(), "__au_serve_request")) {
                if (!sealed_call_result(store, at, true)) {
                    return false;
                }
            }
            at = at + 1;
        }
        return sealed_enum(store, "__au_serve_status", 2, false) && sealed_enum(store, "__au_call_status", 3, false)
            && sealed_enum(store, "__au_event_poll_result", 4, true) && sealed_enum(store, "__au_event_ack_result", 3,
            true) && sealed_enum(store, "__au_event_intake_completion", 7, true) && sealed_enum(store,
            "__au_console_put_result", 2, false) && sealed_enum(store, "__au_console_completion", 2, false)
            && sealed_enum(store, "__au_display_put_result", 2, false) && sealed_enum(store, "__au_display_completion",
            2, false) && sealed_enum(store, "__au_port_write_result", 1, false);
    }

    // Children are complete before this computation starts. Offsets come only
    // from checked logical fields and independent widths/alignment, never from
    // the imported storage rows. Reserved index tails have input-derived size.
    auto build_storage(MetadataStore& store, i64 class_index) -> bool {
        const ClassRow row = store.class_at(class_index);
        const ClassResultRow result = store.result_at(class_index);
        const IndexRange leaves = row.leaves();
        const IndexRange fields = result.fields();
        const i64 leaf_begin = store.reserve_indices(leaves.count());
        if (leaf_begin < 0) {
            return false;
        }
        const i64 field_begin = store.reserve_indices(fields.count());
        if (field_begin < 0) {
            return false;
        }
        i64 cursor = 0;
        i64 alignment = 1;
        i64 leaf_count = 0;
        i64 at = 0;
        while (at < fields.count()) {
            const FieldRow field = store.field_at(fields.begin() + at);
            const RawTypeRow type = store.type_at(field.type());
            if (field.first_leaf() != leaf_count || field.length() < 0 || (!(field.array_flag() != 0 && type.kind()
                == 5) && field.element_count() != 1)) {
                return fail(store, MetadataError::storage_field_range);
            }
            i64 field_alignment = 8;
            i64 width = 8;
            i64 count = 1;
            i64 child_storage = -1;
            bool empty = false;
            if (owner_kind(type)) {
                if (field.array_flag() != 0 || field.length() != 0) {
                    return fail(store, MetadataError::storage_owner_shape);
                }
            } else {
                if (type.kind() == 5) {
                    const i64 child_index = find_class(store, type.name());
                    if (child_index < 0) {
                        return fail(store, MetadataError::storage_shape);
                    }
                    if (owning_class(store, child_index)) {
                        return fail(store, MetadataError::storage_nested_owner);
                    }
                    const ClassResultRow child_result = store.result_at(child_index);
                    child_storage = child_result.canonical_storage();
                    if (child_storage < store.input_storage_count() || child_storage >= store.storage_count()) {
                        return fail(store, MetadataError::storage_shape);
                    }
                    const StorageRow child = store.storage_at(child_storage);
                    const IndexRange child_leaves = child.leaf_offsets();
                    const PhysicalExtent extent = child.extent();
                    if (field.array_flag() != 0) {
                        count = field.element_count();
                    }
                    if (count < 1 || count > 64 || (field.array_flag() == 0 && field.element_count() != 1)
                        || field.length() != child_leaves.count() * count) {
                        return fail(store, MetadataError::storage_nested_shape);
                    }
                    empty = child_leaves.count() == 0;
                    field_alignment = extent.alignment();
                    if (empty) {
                        field_alignment = 1;
                    }
                } else {
                    bool valid = scalar_type(type) || type.kind() == 9;
                    if (field.array_flag() != 0) {
                        valid = scalar_type(type);
                    }
                    if (!valid || field.length() < 1 || (field.array_flag() == 0 && field.length() != 1)
                        || (field.array_flag() != 0 && field.length() > scalar_array_limit(type))) {
                        return fail(store, MetadataError::storage_scalar_shape);
                    }
                    if (type.kind() == 10) {
                        field_alignment = 1;
                        width = 1;
                    }
                }
            }
            if (field_alignment != 1 && field_alignment != 8) {
                return fail(store, MetadataError::storage_alignment);
            }
            cursor = (cursor + field_alignment - 1) / field_alignment * field_alignment;
            if (field_alignment > alignment) {
                alignment = field_alignment;
            }
            const IndexRow field_offset = IndexRow(cursor);
            if (!store.set_index(field_begin + at, field_offset)) {
                return false;
            }
            if (owner_kind(type)) {
                cursor = cursor + 32;
            } else {
                if (type.kind() == 5) {
                    const StorageRow child = store.storage_at(child_storage);
                    const IndexRange child_leaves = child.leaf_offsets();
                    const PhysicalExtent extent = child.extent();
                    i64 element = 0;
                    while (element < count) {
                        i64 leaf = 0;
                        while (leaf < child_leaves.count()) {
                            const IndexRow offset = store.index_at(child_leaves.begin() + leaf);
                            const IndexRow value = IndexRow(cursor + element * extent.size_bytes() + offset.value());
                            if (leaf_count >= leaves.count()) {
                                return fail(store, MetadataError::storage_coverage);
                            }
                            if (!store.set_index(leaf_begin + leaf_count, value)) {
                                return false;
                            }
                            leaf_count = leaf_count + 1;
                            leaf = leaf + 1;
                        }
                        element = element + 1;
                    }
                    if (!empty) {
                        cursor = cursor + count * extent.size_bytes();
                    }
                } else {
                    i64 leaf = 0;
                    while (leaf < field.length()) {
                        const IndexRow value = IndexRow(cursor);
                        if (leaf_count >= leaves.count()) {
                            return fail(store, MetadataError::storage_coverage);
                        }
                        if (!store.set_index(leaf_begin + leaf_count, value)) {
                            return false;
                        }
                        leaf_count = leaf_count + 1;
                        cursor = cursor + width;
                        leaf = leaf + 1;
                    }
                }
            }
            if (cursor > 65536) {
                return fail(store, MetadataError::storage_limit);
            }
            at = at + 1;
        }
        if (leaf_count != leaves.count()) {
            return fail(store, MetadataError::storage_coverage);
        }
        if (cursor == 0) {
            cursor = 8;
            alignment = 8;
        } else {
            cursor = (cursor + alignment - 1) / alignment * alignment;
        }
        if (cursor < 0 || cursor > 65536) {
            return fail(store, MetadataError::storage_extent);
        }
        const i64 reserved = (cursor + 7) / 8 * 8;
        const IndexRange leaf_offsets = IndexRange(leaf_begin, leaf_count);
        const IndexRange field_offsets = IndexRange(field_begin, fields.count());
        const PhysicalExtent extent = PhysicalExtent(cursor, alignment, reserved);
        const StorageRow storage = StorageRow(leaf_offsets, field_offsets, extent);
        const i64 storage_index = store.append_storage(storage);
        if (storage_index < 0) {
            return false;
        }
        const ClassResultRow finished = ClassResultRow(fields, storage_index, result.depth(), result.mark());
        return store.set_result(class_index, finished);
    }
    auto compute_storage(MetadataStore& store) -> bool {
        const FlagMasks masks = FlagMasks();
        i64 at = 0;
        while (at < store.class_count()) {
            const ClassRow row = store.class_at(at);
            const ClassResultRow result = store.result_at(at);
            if (member(row, masks.class_layout()) && result.canonical_storage() < 0) {
                const FrameRow root = FrameRow(at, 0, 1);
                if (!store.push_frame(root)) {
                    return false;
                }
                while (store.frame_count() > 0) {
                    const i64 top = store.frame_count() - 1;
                    const FrameRow frame = store.frame_at(top);
                    const ClassResultRow current = store.result_at(frame.class_index());
                    const IndexRange fields = current.fields();
                    if (frame.next_field() == fields.count()) {
                        if (!build_storage(store, frame.class_index()) || !store.pop_frame()) {
                            return false;
                        }
                    } else {
                        const FieldRow field = store.field_at(fields.begin() + frame.next_field());
                        const RawTypeRow type = store.type_at(field.type());
                        const FrameRow next = FrameRow(frame.class_index(), frame.next_field() + 1, frame.path_depth());
                        if (!store.set_frame(top, next)) {
                            return false;
                        }
                        if (type.kind() == 5) {
                            const i64 child_index = find_class(store, type.name());
                            if (child_index < 0) {
                                return fail(store, MetadataError::storage_shape);
                            }
                            const ClassResultRow child = store.result_at(child_index);
                            if (child.canonical_storage() < 0) {
                                if (frame.path_depth() >= 4) {
                                    return fail(store, MetadataError::storage_depth);
                                }
                                const FrameRow pending = FrameRow(child_index, 0, frame.path_depth() + 1);
                                if (!store.push_frame(pending)) {
                                    return false;
                                }
                            }
                        }
                    }
                }
            }
            at = at + 1;
        }
        return true;
    }
    // 0 when the named class may be a copied runtime element; otherwise which
    // rule fails: 1 unknown layout, 2 owner or carrier, 3 leaves, 4 storage.
    auto copied_element_failure(const MetadataStore& store, ByteRange name) -> i64 {
        const FlagMasks masks = FlagMasks();
        const i64 class_index = find_class(store, name);
        if (class_index < 0) {
            return 1;
        }
        const ClassRow row = store.class_at(class_index);
        const ClassResultRow result = store.result_at(class_index);
        if (!member(row, masks.class_layout()) || result.canonical_storage() < 0) {
            return 1;
        }
        if (owning_class(store, class_index) || member(row, masks.class_array_carrier())) {
            return 2;
        }
        if (!copied_leaves(store, row)) {
            return 3;
        }
        const StorageRow storage = store.storage_at(result.canonical_storage());
        const PhysicalExtent extent = storage.extent();
        if (extent.size_bytes() < 1 || extent.size_bytes() > 520 || extent.reserved_bytes() > 520) {
            return 4;
        }
        return 0;
    }
    auto verify_owner_element(MetadataStore& store, RawTypeRow type) -> bool {
        if (type.kind() == 13 && owner_type(type)) {
            return true;
        }
        if (type.kind() != 17 || !owner_type(type)) {
            return fail(store, MetadataError::owner_type);
        }
        const i64 failure = copied_element_failure(store, type.name());
        if (failure == 1) {
            return fail(store, MetadataError::owner_element_unknown);
        }
        if (failure == 2) {
            return fail(store, MetadataError::owner_element_kind);
        }
        if (failure == 3) {
            return fail(store, MetadataError::owner_element_leaves);
        }
        if (failure == 4) {
            return fail(store, MetadataError::owner_element_storage);
        }
        return true;
    }
    // A typed readonly span names one copied element class, like OwnedValues.
    auto verify_span_element(MetadataStore& store, RawTypeRow type) -> bool {
        if (type.kind() != 21 || !canonical_tail(type) || name_length(type.name()) == 0) {
            return fail(store, MetadataError::span_value_type);
        }
        const i64 failure = copied_element_failure(store, type.name());
        if (failure == 1) {
            return fail(store, MetadataError::span_element_unknown);
        }
        if (failure == 2) {
            return fail(store, MetadataError::span_element_kind);
        }
        if (failure == 3) {
            return fail(store, MetadataError::span_element_leaves);
        }
        if (failure == 4) {
            return fail(store, MetadataError::span_element_storage);
        }
        return true;
    }
    auto verify_storage_limits(MetadataStore& store) -> bool {
        const FlagMasks masks = FlagMasks();
        i64 at = 0;
        while (at < store.class_count()) {
            const ClassRow row = store.class_at(at);
            if (member(row, masks.class_layout())) {
                const ClassResultRow result = store.result_at(at);
                const IndexRange fields = result.fields();
                bool composed = false;
                i64 index = 0;
                while (index < fields.count()) {
                    const FieldRow field = store.field_at(fields.begin() + index);
                    const RawTypeRow type = store.type_at(field.type());
                    if (owner_kind(type) && !verify_owner_element(store, type)) {
                        return false;
                    }
                    composed = composed || type.kind() == 5;
                    index = index + 1;
                }
                const StorageRow storage = store.storage_at(result.canonical_storage());
                const PhysicalExtent extent = storage.extent();
                if ((composed || owning_class(store, at)) && extent.reserved_bytes() > 520) {
                    return fail(store, MetadataError::class_storage_limit);
                }
            }
            at = at + 1;
        }
        return true;
    }
    auto same_indices(const MetadataStore& store, IndexRange left, IndexRange right) -> bool {
        if (left.count() != right.count()) {
            return false;
        }
        i64 at = 0;
        while (at < left.count()) {
            const IndexRow a = store.index_at(left.begin() + at);
            const IndexRow b = store.index_at(right.begin() + at);
            if (a.value() != b.value()) {
                return false;
            }
            at = at + 1;
        }
        return true;
    }
    auto verify_supplied_storage(MetadataStore& store) -> bool {
        const FlagMasks masks = FlagMasks();
        if (store.input_storage_count() == 0) {
            return true;
        }
        i64 at = 0;
        while (at < store.class_count()) {
            const ClassRow row = store.class_at(at);
            if (member(row, masks.class_layout()) != member(row, masks.class_storage())) {
                return fail(store, MetadataError::supplied_storage);
            }
            if (member(row, masks.class_layout())) {
                const ClassResultRow result = store.result_at(at);
                const StorageRow supplied = store.storage_at(row.supplied_storage());
                const StorageRow canonical = store.storage_at(result.canonical_storage());
                const PhysicalExtent a = supplied.extent();
                const PhysicalExtent b = canonical.extent();
                if (a.size_bytes() != b.size_bytes() || a.alignment() != b.alignment() || a.reserved_bytes()
                    != b.reserved_bytes() || !same_indices(store, supplied.leaf_offsets(), canonical.leaf_offsets())
                    || !same_indices(store, supplied.field_offsets(), canonical.field_offsets())) {
                    return fail(store, MetadataError::supplied_storage);
                }
            }
            at = at + 1;
        }
        return true;
    }
    auto has_scope(const MetadataStore& store, i64 scope) -> bool {
        i64 begin = 0;
        i64 end = store.view_count();
        while (begin < end) {
            const i64 middle = begin + (end - begin) / 2;
            const ViewRow row = store.view_at(middle);
            if (row.scope() == scope) {
                return true;
            }
            if (row.scope() < scope) {
                begin = middle + 1;
            } else {
                end = middle;
            }
        }
        return false;
    }
    // Byte spans (11) and typed readonly spans (21) share one capability shape.
    auto span_type(RawTypeRow type) -> bool {
        return type.kind() == 11 || type.kind() == 21;
    }
    auto plain_type(RawTypeRow type, i64 kind) -> bool {
        return type.kind() == kind && name_length(type.name()) == 0 && canonical_tail(type);
    }
    auto service_type(RawTypeRow type) -> bool {
        return type.kind() == 14 || type.kind() == 15 || type.kind() == 16 || type.kind() == 18 || type.kind() == 19
            || type.kind() == 20;
    }
    auto service_kind(RawTypeRow type) -> i64 {
        if (type.kind() == 14) {
            return 0;
        }
        if (type.kind() == 15) {
            return 1;
        }
        if (type.kind() == 16) {
            return 2;
        }
        if (type.kind() == 18) {
            return 3;
        }
        if (type.kind() == 19) {
            return 4;
        }
        if (type.kind() == 20) {
            return 5;
        }
        return -1;
    }
    auto resource_type(RawTypeRow type) -> bool {
        return type.kind() == 12 || owner_kind(type);
    }
    auto owning_type(const MetadataStore& store, RawTypeRow type) -> bool {
        return type.kind() == 5 && owning_class(store, find_class(store, type.name()));
    }
    auto owning_constructor(const MetadataStore& store, CallableRow row) -> bool {
        const FlagMasks masks = FlagMasks();
        const ReceiverShape receiver = row.first_receiver();
        return callable_flag(row, masks.callable_receiver()) && receiver_flag(receiver, masks.receiver_constructor())
            && owning_class(store, find_class(store, receiver.name()));
    }
    auto resource_signature(const MetadataStore& store, CallableRow row) -> bool {
        if (owning_constructor(store, row)) {
            return true;
        }
        const IndexRange types = row.types();
        const RawTypeRow result = store.type_at(types.begin());
        if (resource_type(result) || owning_type(store, result)) {
            return true;
        }
        // Borrowed roots never become moved resource arguments.
        i64 at = 0;
        while (at < row.value_parameter_count()) {
            const RawTypeRow type = store.type_at(row.value_parameter_begin() + at);
            if (resource_type(type) || owning_type(store, type)) {
                return true;
            }
            at = at + 1;
        }
        return false;
    }
    auto service_signature(const MetadataStore& store, CallableRow row) -> bool {
        i64 at = 0;
        while (at < row.value_parameter_count()) {
            const RawTypeRow type = store.type_at(row.value_parameter_begin() + at);
            if (service_type(type)) {
                return true;
            }
            at = at + 1;
        }
        return false;
    }
    auto service_bit(RawTypeRow type) -> u64 {
        const FlagMasks masks = FlagMasks();
        if (type.kind() == 14) {
            return masks.service_console();
        }
        if (type.kind() == 15) {
            return masks.service_display();
        }
        if (type.kind() == 16) {
            return masks.service_iommu();
        }
        if (type.kind() == 18) {
            return masks.service_call();
        }
        if (type.kind() == 19) {
            return masks.service_port();
        }
        if (type.kind() == 20) {
            return masks.service_serve();
        }
        return 0u64;
    }
    auto console_region_signature(const MetadataStore& store, CallableRow row) -> bool {
        return row.value_parameter_count() >= 2 && plain_type(store.type_at(row.value_parameter_begin()), 14)
            && plain_type(store.type_at(row.value_parameter_begin() + 1), 12);
    }
    auto verify_service_signature(MetadataStore& store, CallableRow row, bool resource) -> bool {
        const FlagMasks masks = FlagMasks();
        const IndexRange types = row.types();
        if (callable_flag(row, masks.callable_receiver()) || row.borrowed_root_count() != 0 || (resource
            && !console_region_signature(store, row)) || row.value_parameter_count() == 0) {
            return fail(store, MetadataError::service_signature);
        }
        const RawTypeRow first = store.type_at(row.value_parameter_begin());
        if (!service_type(first)) {
            return fail(store, MetadataError::service_signature);
        }
        i64 at = 0;
        u64 kinds = 0u64;
        bool leading = true;
        while (at < row.value_parameter_count() && leading) {
            const RawTypeRow type = store.type_at(row.value_parameter_begin() + at);
            if (service_type(type)) {
                const u64 bit = service_bit(type);
                if ((kinds & bit) != 0u64) {
                    return fail(store, MetadataError::service_duplicates);
                }
                kinds = kinds | bit;
                at = at + 1;
            } else {
                leading = false;
            }
        }
        // Independent closed allowlist: recognition alone never grants new
        // pair or triple forwarding authority.
        if (at > 2 || (kinds != masks.service_console() && kinds != masks.service_display() && kinds
            != masks.service_iommu() && kinds != masks.service_call() && kinds != masks.service_port() && kinds
            != masks.service_serve() && kinds != (masks.service_console() | masks.service_display()) && kinds
            != (masks.service_console() | masks.service_iommu()))) {
            return fail(store, MetadataError::service_group);
        }
        if (console_region_signature(store, row)) {
            at = 2;
        }
        while (at < row.value_parameter_count()) {
            const RawTypeRow type = store.type_at(row.value_parameter_begin() + at);
            if (!scalar_value(store, type) && !plain_type(type, 11) && (type.kind() != 5 || owning_type(store, type))) {
                return fail(store, MetadataError::service_parameters);
            }
            at = at + 1;
        }
        const RawTypeRow result = store.type_at(types.begin());
        if (!scalar_value(store, result) && (result.kind() != 5 || owning_type(store, result))) {
            return fail(store, MetadataError::service_result);
        }
        return true;
    }
    auto verify_borrowed_signature(MetadataStore& store, CallableRow row, bool resource) -> bool {
        const FlagMasks masks = FlagMasks();
        const i64 roots = row.borrowed_root_count();
        if (roots == 0) {
            return true;
        }
        if (roots < 1 || roots > 4) {
            return fail(store, MetadataError::borrowed_root_count);
        }
        const IndexRange types = row.types();
        const RawTypeRow result = store.type_at(types.begin());
        if (callable_flag(row, masks.callable_receiver())) {
            return fail(store, MetadataError::borrowed_shape);
        }
        if (resource || span_type(result) || callable_flag(row, masks.callable_span_summary())) {
            return fail(store, MetadataError::borrowed_result);
        }
        if (types.count() > 7) {
            return fail(store, MetadataError::borrowed_parameters);
        }
        const RawTypeRow first = store.type_at(row.borrowed_root_type(0));
        if (first.kind() == 17) {
            // The builtin root is one mutable descriptor borrow. Its nominal
            // name denotes the copied element, never a class receiver.
            if (roots != 1 || !row.borrowed_root_mutable(0) || !scalar_value(store, result)) {
                return fail(store, MetadataError::borrowed_root_values);
            }
            if (!verify_owner_element(store, first)) {
                return false;
            }
            i64 parameter = 0;
            while (parameter < row.value_parameter_count()) {
                const RawTypeRow type = store.type_at(row.value_parameter_begin() + parameter);
                if (!scalar_value(store, type) && (type.kind() != 5 || owning_type(store, type))) {
                    return fail(store, MetadataError::borrowed_root_values);
                }
                parameter = parameter + 1;
            }
            return true;
        }
        i64 root = 0;
        while (root < roots) {
            const i64 index = row.borrowed_root_type(root);
            if (index < 0) {
                return fail(store, MetadataError::borrowed_root_count);
            }
            const RawTypeRow type = store.type_at(index);
            if (type.kind() != 5 || name_length(type.name()) == 0 || !canonical_tail(type)) {
                return fail(store, MetadataError::borrowed_root_type);
            }
            const i64 class_index = find_class(store, type.name());
            if (class_index < 0 || !owning_class(store, class_index)) {
                return fail(store, MetadataError::borrowed_root_class);
            }
            const ClassRow declaration = store.class_at(class_index);
            if (!member(declaration, masks.class_layout()) || member(declaration, masks.class_array_carrier())) {
                return fail(store, MetadataError::borrowed_root_class);
            }
            root = root + 1;
        }
        if (roots > 1) {
            if (!scalar_value(store, result)) {
                return fail(store, MetadataError::borrowed_root_values);
            }
            i64 at = 0;
            while (at < row.value_parameter_count()) {
                const RawTypeRow type = store.type_at(row.value_parameter_begin() + at);
                if (!scalar_value(store, type)) {
                    return fail(store, MetadataError::borrowed_root_values);
                }
                at = at + 1;
            }
        }
        return true;
    }
    auto verify_resource_signature(MetadataStore& store, CallableRow row) -> bool {
        const FlagMasks masks = FlagMasks();
        const bool constructor = owning_constructor(store, row);
        const bool receiver = callable_flag(row, masks.callable_receiver());
        const IndexRange types = row.types();
        if (receiver && !constructor) {
            return fail(store, MetadataError::resource_receiver);
        }
        if (row.value_parameter_count() == 0) {
            return fail(store, MetadataError::resource_region);
        }
        const RawTypeRow first = store.type_at(row.value_parameter_begin());
        if (!plain_type(first, 12)) {
            return fail(store, MetadataError::resource_region);
        }
        const RawTypeRow result = store.type_at(types.begin());
        if (!scalar_value(store, result) && !owner_kind(result) && (receiver || result.kind() != 5)) {
            return fail(store, MetadataError::resource_result);
        }
        i64 at = 1;
        while (at < row.value_parameter_count()) {
            const RawTypeRow type = store.type_at(row.value_parameter_begin() + at);
            if (!scalar_value(store, type) && !owner_kind(type) && (receiver || !owning_type(store, type))
                && (!constructor || type.kind() != 5 || owning_type(store, type))) {
                return fail(store, MetadataError::resource_parameters);
            }
            at = at + 1;
        }
        return true;
    }
    auto aggregate_boundary(const MetadataStore& store, CallableRow row) -> bool {
        const RawTypeRow result = store.type_at(range_begin(row.types()));
        if (result.kind() == 5) {
            return true;
        }
        i64 at = 0;
        while (at < row.value_parameter_count()) {
            const RawTypeRow parameter = store.type_at(row.value_parameter_begin() + at);
            if (parameter.kind() == 5 || span_type(parameter)) {
                return true;
            }
            at = at + 1;
        }
        return false;
    }
    auto verify_boundary_type(MetadataStore& store, CallableRow row, RawTypeRow type, bool parameter, bool resource,
        bool service) -> bool {
        const FlagMasks masks = FlagMasks();
        if (scalar_value(store, type)) {
            return true;
        }
        if (service_type(type)) {
            if (!parameter || !service) {
                return fail(store, MetadataError::service_boundary);
            }
            // The old kind-only native service branch admitted malformed names
            // and tails. Raw callable types must all be canonical before any
            // native observer reconstructs a Type from this owner.
            if (name_length(type.name()) != 0 || !canonical_tail(type)) {
                return fail(store, MetadataError::service_type);
            }
            return true;
        }
        if (resource_type(type)) {
            if (!resource || (!owner_kind(type) && (!parameter || !plain_type(type, 12)))) {
                return fail(store, MetadataError::resource_boundary);
            }
            if (owner_kind(type) && !verify_owner_element(store, type)) {
                return false;
            }
            return true;
        }
        const ReceiverShape receiver = row.first_receiver();
        if (type.kind() == 11 || type.kind() == 21) {
            if (type.kind() == 21 && !verify_span_element(store, type)) {
                return false;
            }
            if ((type.kind() == 11 && !plain_type(type, 11)) || !((parameter && (!callable_flag(row,
                masks.callable_receiver()) || !receiver_flag(receiver, masks.receiver_constructor()))) || (!parameter
                && callable_flag(row, masks.callable_receiver()) && !receiver_flag(receiver, masks.receiver_mutable())
                && !receiver_flag(receiver, masks.receiver_constructor()) && callable_flag(row,
                masks.callable_span_summary())))) {
                return fail(store, MetadataError::span_boundary);
            }
            return true;
        }
        if (callable_flag(row, masks.callable_receiver()) && !parameter && receiver_flag(receiver,
            masks.receiver_constructor())) {
            return fail(store, MetadataError::receiver_signature);
        }
        if (type.kind() != 5 || !canonical_tail(type)) {
            // Keep the boundary's specific contract when header admission
            // precedes a call that formerly rejected this unsupported kind.
            if (parameter && type.kind() != 5) {
                if (callable_flag(row, masks.callable_receiver())) {
                    return fail(store, MetadataError::receiver_signature);
                }
                if (!resource && !service && row.borrowed_root_count() == 0 && aggregate_boundary(store, row)) {
                    return fail(store, MetadataError::aggregate_parameter);
                }
            }
            return fail(store, MetadataError::value_type);
        }
        const i64 class_index = find_class(store, type.name());
        if (class_index < 0) {
            return fail(store, MetadataError::value_class);
        }
        const ClassRow declaration = store.class_at(class_index);
        if (!member(declaration, masks.class_layout())) {
            return fail(store, MetadataError::value_class);
        }
        if (member(declaration, masks.class_array_carrier())) {
            return fail(store, MetadataError::value_carrier);
        }
        const bool owning = owning_class(store, class_index);
        if (owning && (!resource || callable_flag(row, masks.callable_receiver()))) {
            return fail(store, MetadataError::value_owner);
        }
        if (resource && !service && !owning && parameter && !owning_constructor(store, row)) {
            return fail(store, MetadataError::value_resource);
        }
        if (!copied_leaves(store, declaration)) {
            return fail(store, MetadataError::value_leaves);
        }
        const ClassResultRow result = store.result_at(class_index);
        const StorageRow storage = store.storage_at(result.canonical_storage());
        const PhysicalExtent extent = storage.extent();
        if (extent.reserved_bytes() > 520) {
            return fail(store, MetadataError::value_storage);
        }
        return true;
    }
    auto verify_receiver_signature(MetadataStore& store, CallableRow row) -> bool {
        const FlagMasks masks = FlagMasks();
        const ReceiverShape receiver = row.first_receiver();
        i64 class_index = -1;
        if (callable_flag(row, masks.callable_receiver())) {
            class_index = find_class(store, receiver.name());
            if (class_index < 0) {
                return fail(store, MetadataError::receiver_class);
            }
            const ClassRow declaration = store.class_at(class_index);
            if (!member(declaration, masks.class_layout())) {
                return fail(store, MetadataError::receiver_class);
            }
            if (member(declaration, masks.class_array_carrier())) {
                return fail(store, MetadataError::receiver_carrier);
            }
        }
        if (callable_flag(row, masks.callable_span_summary())) {
            if (class_index < 0 || row.receiver_span_field() < 0) {
                return fail(store, MetadataError::receiver_span);
            }
            const ClassResultRow result = store.result_at(class_index);
            const IndexRange fields = result.fields();
            if (row.receiver_span_field() >= fields.count()) {
                return fail(store, MetadataError::receiver_span);
            }
            const FieldRow field = store.field_at(fields.begin() + row.receiver_span_field());
            const RawTypeRow type = store.type_at(field.type());
            const RawTypeRow span_result = store.type_at(range_begin(row.types()));
            if (span_result.kind() == 21) {
                // A typed view names exactly one direct OwnedValues field of its element.
                if (type.kind() != 17 || field.array_flag() != 0 || !canonical_tail(type) || compare_names(store,
                    type.name(), span_result.name()) != 0) {
                    return fail(store, MetadataError::receiver_span);
                }
            } else {
                if (!((plain_type(type, 13) && field.array_flag() == 0) || (plain_type(type, 10) && field.array_flag()
                    != 0))) {
                    return fail(store, MetadataError::receiver_span);
                }
            }
        }
        return true;
    }
    auto verify_callable_signatures(MetadataStore& store) -> bool {
        const FlagMasks masks = FlagMasks();
        i64 at = 0;
        while (at < store.callable_count()) {
            const CallableRow row = store.callable_at(at);
            if (!has_scope(store, row.scope())) {
                return fail(store, MetadataError::function_scope);
            }
            const bool resource = resource_signature(store, row);
            const bool service = service_signature(store, row);
            if (service && !verify_service_signature(store, row, resource)) {
                return false;
            }
            if (!verify_borrowed_signature(store, row, resource)) {
                return false;
            }
            if (resource && !service && !verify_resource_signature(store, row)) {
                return false;
            }
            const IndexRange types = row.types();
            const RawTypeRow result = store.type_at(types.begin());
            if (callable_flag(row, masks.callable_span_summary()) && !plain_type(result, 11) && result.kind() != 21) {
                return fail(store, MetadataError::span_result);
            }
            if (!verify_boundary_type(store, row, result, false, resource, service)) {
                return false;
            }
            if (types.count() > 7) {
                return fail(store, MetadataError::parameter_count);
            }
            i64 parameter = 0;
            while (parameter < row.value_parameter_count()) {
                const RawTypeRow type = store.type_at(row.value_parameter_begin() + parameter);
                if (!verify_boundary_type(store, row, type, true, resource, service)) {
                    return false;
                }
                parameter = parameter + 1;
            }
            if (!verify_receiver_signature(store, row)) {
                return false;
            }
            at = at + 1;
        }
        return true;
    }

    // Declaration kinds are the existing lowering RecordKind ordinals, pinned
    // by generated bridge facts: scalar10, object11, array12, span13, service14,
    // region15, owner16, and separate owned-value annotation17.
    auto slot_kind_begin(const MetadataStore& store, IndexRange range, i64 kind) -> i64 {
        i64 begin = range.begin();
        i64 end = range.begin() + range.count();
        while (begin < end) {
            const i64 middle = begin + (end - begin) / 2;
            const SlotRow slot = store.slot_at(middle);
            if (slot.kind() < kind) {
                begin = middle + 1;
            } else {
                end = middle;
            }
        }
        return begin;
    }
    auto slot_group(const MetadataStore& store, CallableRow row, i64 kind) -> IndexRange {
        const IndexRange slots = row.slots();
        const i64 begin = slot_kind_begin(store, slots, kind);
        return IndexRange(begin, slot_kind_begin(store, slots, kind + 1) - begin);
    }
    auto slot_lower_bound(const MetadataStore& store, IndexRange range, i64 offset) -> i64 {
        i64 begin = range.begin();
        i64 end = range.begin() + range.count();
        // Admitted ranges lie inside the slot owner; others keep the checked reader.
        if (store.status() != MetadataStatus::success || begin < 0 || end > store.slot_count()) {
            while (begin < end) {
                const i64 middle = begin + (end - begin) / 2;
                const SlotRow slot = store.slot_at(middle);
                if (slot.offset() < offset) {
                    begin = middle + 1;
                } else {
                    end = middle;
                }
            }
            return begin;
        }
        const builtin::span<const SlotRow> rows = store.slot_rows();
        while (begin < end) {
            const i64 middle = begin + (end - begin) / 2;
            const SlotRow slot = rows.at(middle);
            if (slot.offset() < offset) {
                begin = middle + 1;
            } else {
                end = middle;
            }
        }
        return begin;
    }
    auto find_slot(const MetadataStore& store, IndexRange range, i64 offset) -> i64 {
        const i64 index = slot_lower_bound(store, range, offset);
        if (index == range.begin() + range.count()) {
            return -1;
        }
        const SlotRow slot = store.slot_at(index);
        if (slot.offset() != offset) {
            return -1;
        }
        return index;
    }
    auto object_storage(const MetadataStore& store, SlotRow slot) -> StorageRow {
        const RawTypeRow type = store.type_at(slot.type());
        const ClassResultRow result = store.result_at(find_class(store, type.name()));
        const StorageRow storage = store.storage_at(result.canonical_storage());
        return storage;
    }
    auto scalar_width(RawTypeRow type) -> i64 {
        if (plain_type(type, 10)) {
            return 1;
        }
        return 8;
    }
    // Call only for already admitted groups, except scalar width before its
    // payload check. No width or subtraction is accepted as a layout proof.
    auto slot_width(const MetadataStore& store, SlotRow slot) -> i64 {
        if (slot.kind() == 10) {
            const RawTypeRow type = store.type_at(slot.type());
            return scalar_width(type);
        }
        if (slot.kind() == 11) {
            const StorageRow storage = object_storage(store, slot);
            const PhysicalExtent extent = storage.extent();
            return extent.reserved_bytes();
        }
        if (slot.kind() == 12) {
            return slot.length();
        }
        if (slot.kind() == 13) {
            return 56;
        }
        if (slot.kind() == 14) {
            return 16;
        }
        if (slot.kind() == 15) {
            return 8;
        }
        if (slot.kind() == 16) {
            return 32;
        }
        return 0;
    }
    // Each admitted group is sorted by end offset and internally disjoint.
    // Its first end at/above first is the only possible first intersection.
    // Thus each cross-category query is logarithmic without a retained bitmap
    // or a second native reservation owner.
    auto first_slot_overlap(const MetadataStore& store, IndexRange range, i64 first, i64 last) -> i64 {
        const i64 index = slot_lower_bound(store, range, first);
        if (index == range.begin() + range.count()) {
            return -1;
        }
        const SlotRow slot = store.slot_at(index);
        const i64 start = slot.offset() - slot_width(store, slot) + 1;
        if (start > last) {
            return -1;
        }
        if (start > first) {
            return start;
        }
        return first;
    }
    auto earlier_overlap(i64 left, i64 right) -> i64 {
        if (left < 0) {
            return right;
        }
        if (right < 0 || left < right) {
            return left;
        }
        return right;
    }
    auto declaration_overlap(const MetadataStore& store, CallableRow row, i64 first, i64 last, i64 last_kind) -> i64 {
        i64 overlap = -1;
        i64 kind = 10;
        while (kind <= last_kind) {
            const IndexRange range = slot_group(store, row, kind);
            overlap = earlier_overlap(overlap, first_slot_overlap(store, range, first, last));
            kind = kind + 1;
        }
        return overlap;
    }
    // Each typed span annotation names exactly one span spill of its callable.
    auto verify_span_value_slots(MetadataStore& store, CallableRow row) -> bool {
        const IndexRange annotations = slot_group(store, row, 27);
        const IndexRange spans = slot_group(store, row, 13);
        i64 at = 0;
        while (at < annotations.count()) {
            const SlotRow slot = store.slot_at(annotations.begin() + at);
            if (find_slot(store, spans, slot.offset()) < 0) {
                return fail(store, MetadataError::span_value_spill);
            }
            const RawTypeRow type = store.type_at(slot.type());
            if (!verify_span_element(store, type)) {
                return false;
            }
            at = at + 1;
        }
        return true;
    }
    auto verify_owner_slots(MetadataStore& store, CallableRow row) -> bool {
        const IndexRange annotations = slot_group(store, row, 17);
        const IndexRange owners = slot_group(store, row, 16);
        i64 at = 0;
        while (at < annotations.count()) {
            const SlotRow slot = store.slot_at(annotations.begin() + at);
            if (find_slot(store, owners, slot.offset()) < 0) {
                return fail(store, MetadataError::owner_spill);
            }
            const RawTypeRow type = store.type_at(slot.type());
            if (type.kind() != 17) {
                return fail(store, MetadataError::owner_type);
            }
            if (!verify_owner_element(store, type)) {
                return false;
            }
            at = at + 1;
        }
        return true;
    }
    auto verify_scalar_slots(MetadataStore& store, CallableRow row) -> bool {
        const IndexRange slots = slot_group(store, row, 10);
        i64 previous_end = 0;
        i64 at = 0;
        while (at < slots.count()) {
            const SlotRow slot = store.slot_at(slots.begin() + at);
            const RawTypeRow type = store.type_at(slot.type());
            const i64 width = scalar_width(type);
            if (slot.offset() < width || slot.offset() > row.frame_bytes() || slot.offset() % width != 0) {
                return fail(store, MetadataError::slot_offset);
            }
            if (!scalar_value(store, type) && !plain_type(type, 3) && !plain_type(type, 4)) {
                return fail(store, MetadataError::slot_type);
            }
            if (slot.offset() - width < previous_end) {
                return fail(store, MetadataError::slot_overlap);
            }
            previous_end = slot.offset();
            at = at + 1;
        }
        return true;
    }
    auto object_leaf_ordinal(const MetadataStore& store, SlotRow object, i64 offset) -> i64 {
        if (offset <= 0 || offset > object.offset()) {
            return -1;
        }
        const StorageRow storage = object_storage(store, object);
        const IndexRange offsets = storage.leaf_offsets();
        const i64 target = object.offset() - offset;
        i64 begin = offsets.begin();
        i64 end = offsets.begin() + offsets.count();
        while (begin < end) {
            const i64 middle = begin + (end - begin) / 2;
            const IndexRow leaf = store.index_at(middle);
            if (leaf.value() < target) {
                begin = middle + 1;
            } else {
                end = middle;
            }
        }
        if (begin == offsets.begin() + offsets.count()) {
            return -1;
        }
        const IndexRow leaf = store.index_at(begin);
        if (leaf.value() != target) {
            return -1;
        }
        return begin - offsets.begin();
    }
    auto object_has_leaf(const MetadataStore& store, SlotRow object, i64 offset) -> bool {
        return object_leaf_ordinal(store, object, offset) >= 0;
    }
    // Published frame groups are disjoint and sorted by their final offset.
    // The first end at/above an address is its only possible local origin. A
    // candidate is not membership proof: callers still check exact leaves or
    // byte-array bounds. Receiver identities are never frame addresses.
    auto local_origin_candidate(const MetadataStore& store, i64 callable, i64 kind, i64 offset) -> i64 {
        if (store.status() != MetadataStatus::success || callable < 0 || callable >= store.callable_count() || offset
            <= 0) {
            return -1;
        }
        const CallableRow row = store.callable_at(callable);
        if (offset > row.frame_bytes()) {
            return -1;
        }
        // Successful admission proved strict (kind, offset) order. Search that
        // pair once instead of finding both group bounds before its offset.
        const IndexRange slots = row.slots();
        i64 begin = slots.begin();
        const i64 limit = begin + slots.count();
        i64 end = limit;
        const builtin::span<const SlotRow> rows = store.slot_rows();
        while (begin < end) {
            const i64 middle = begin + (end - begin) / 2;
            const SlotRow slot = rows.at(middle);
            const i64 slot_kind = slot.kind();
            if (slot_kind < kind || (slot_kind == kind && slot.offset() < offset)) {
                begin = middle + 1;
            } else {
                end = middle;
            }
        }
        if (begin == limit) {
            return -1;
        }
        const SlotRow candidate = rows.at(begin);
        if (candidate.kind() != kind) {
            return -1;
        }
        return begin;
    }
    auto object_leaf_root(const MetadataStore& store, i64 callable, i64 offset) -> i64 {
        const i64 index = local_origin_candidate(store, callable, 11, offset);
        if (index < 0) {
            return -1;
        }
        const SlotRow object = store.slot_at(index);
        if (!object_has_leaf(store, object, offset)) {
            return -1;
        }
        return object.offset();
    }
    auto byte_array_element_root(const MetadataStore& store, i64 callable, i64 offset) -> i64 {
        const i64 index = local_origin_candidate(store, callable, 12, offset);
        if (index < 0) {
            return -1;
        }
        const SlotRow array_slot = store.slot_at(index);
        if (array_slot.offset() - offset >= array_slot.length()) {
            return -1;
        }
        return array_slot.offset();
    }
    auto nested_object_leaf(const MetadataStore& store, i64 callable, i64 offset) -> bool {
        const i64 index = local_origin_candidate(store, callable, 11, offset);
        if (index < 0) {
            return false;
        }
        const SlotRow object = store.slot_at(index);
        const i64 leaf = object_leaf_ordinal(store, object, offset);
        if (leaf < 0) {
            return false;
        }
        const RawTypeRow type = store.type_at(object.type());
        const ClassResultRow result = store.result_at(find_class(store, type.name()));
        const IndexRange fields = result.fields();
        i64 begin = fields.begin();
        i64 end = fields.begin() + fields.count();
        // Admitted field ends are monotonic. The first end strictly beyond
        // this leaf skips empty nested fields and owner descriptors, including
        // runs sharing a firstLeaf with the next nonempty logical field.
        while (begin < end) {
            const i64 middle = begin + (end - begin) / 2;
            const FieldRow field = store.field_at(middle);
            if (field.first_leaf() + field.length() <= leaf) {
                begin = middle + 1;
            } else {
                end = middle;
            }
        }
        if (begin == fields.begin() + fields.count()) {
            return false;
        }
        const FieldRow field = store.field_at(begin);
        if (field.length() == 0 || field.first_leaf() > leaf) {
            return false;
        }
        const RawTypeRow element = store.type_at(field.type());
        return element.kind() == 5;
    }
    auto verify_object_slots(MetadataStore& store, CallableRow row) -> bool {
        const FlagMasks masks = FlagMasks();
        const IndexRange objects = slot_group(store, row, 11);
        const IndexRange scalars = slot_group(store, row, 10);
        i64 previous_end = 0;
        i64 at = 0;
        while (at < objects.count()) {
            const SlotRow slot = store.slot_at(objects.begin() + at);
            const RawTypeRow type = store.type_at(slot.type());
            const i64 class_index = find_class(store, type.name());
            if (type.kind() != 5 || !canonical_tail(type) || class_index < 0) {
                return fail(store, MetadataError::object_class);
            }
            const ClassRow layout = store.class_at(class_index);
            const ClassResultRow result = store.result_at(class_index);
            if (!member(layout, masks.class_layout()) || result.canonical_storage() < 0) {
                return fail(store, MetadataError::object_class);
            }
            const StorageRow storage = store.storage_at(result.canonical_storage());
            const PhysicalExtent extent = storage.extent();
            if (slot.offset() <= 0 || slot.offset() > row.frame_bytes() || slot.offset() % 8 != 0 || slot.offset()
                < extent.reserved_bytes()) {
                return fail(store, MetadataError::object_offset);
            }
            if (slot.offset() - extent.reserved_bytes() < previous_end) {
                return fail(store, MetadataError::object_overlap);
            }
            const IndexRange leaves = layout.leaves();
            const IndexRange offsets = storage.leaf_offsets();
            i64 leaf = 0;
            while (leaf < leaves.count()) {
                const IndexRow offset = store.index_at(offsets.begin() + leaf);
                const i64 scalar_index = find_slot(store, scalars, slot.offset() - offset.value());
                if (scalar_index < 0) {
                    return fail(store, MetadataError::object_leaf);
                }
                const SlotRow scalar = store.slot_at(scalar_index);
                const RawTypeRow actual = store.type_at(scalar.type());
                const RawTypeRow expected = store.type_at(leaves.begin() + leaf);
                if (!same_type(store, actual, expected)) {
                    return fail(store, MetadataError::object_leaf);
                }
                leaf = leaf + 1;
            }
            previous_end = slot.offset();
            at = at + 1;
        }
        at = 0;
        i64 cached_object = -1;
        i64 cached_start = 0;
        while (at < scalars.count()) {
            const SlotRow scalar = store.slot_at(scalars.begin() + at);
            const i64 first = scalar.offset() - slot_width(store, scalar) + 1;
            const i64 object_index = slot_lower_bound(store, objects, first);
            if (object_index < objects.begin() + objects.count()) {
                const SlotRow object = store.slot_at(object_index);
                // Layout and storage are immutable throughout this pass. Keep
                // checked row reads, but resolve the same candidate's extent once.
                if (object_index != cached_object) {
                    cached_start = object.offset() - slot_width(store, object) + 1;
                    cached_object = object_index;
                }
                if (cached_start <= scalar.offset() && !object_has_leaf(store, object, scalar.offset())) {
                    return fail(store, MetadataError::object_padding);
                }
            }
            at = at + 1;
        }
        return true;
    }
    auto verify_array_slots(MetadataStore& store, CallableRow row) -> bool {
        const IndexRange arrays = slot_group(store, row, 12);
        const IndexRange scalars = slot_group(store, row, 10);
        const IndexRange objects = slot_group(store, row, 11);
        i64 previous_end = 0;
        i64 at = 0;
        while (at < arrays.count()) {
            const SlotRow slot = store.slot_at(arrays.begin() + at);
            if (slot.length() < 1 || slot.length() > 4096 || slot.offset() < slot.length() || slot.offset()
                > row.frame_bytes()) {
                return fail(store, MetadataError::array_extent);
            }
            i64 element = 0;
            while (element < slot.length()) {
                const i64 offset = slot.offset() - element;
                const i64 scalar_index = find_slot(store, scalars, offset);
                if (scalar_index < 0) {
                    return fail(store, MetadataError::array_leaf);
                }
                const SlotRow scalar = store.slot_at(scalar_index);
                const RawTypeRow type = store.type_at(scalar.type());
                if (!plain_type(type, 10)) {
                    return fail(store, MetadataError::array_leaf);
                }
                if (first_slot_overlap(store, objects, offset, offset) >= 0) {
                    return fail(store, MetadataError::array_object);
                }
                if (offset <= previous_end) {
                    return fail(store, MetadataError::array_overlap);
                }
                element = element + 1;
            }
            previous_end = slot.offset();
            at = at + 1;
        }
        return true;
    }
    auto spill_extent_error(MetadataStore& store, i64 kind) -> bool {
        if (kind == 13) {
            return fail(store, MetadataError::span_extent);
        }
        if (kind == 14) {
            return fail(store, MetadataError::service_extent);
        }
        if (kind == 15) {
            return fail(store, MetadataError::region_extent);
        }
        return fail(store, MetadataError::byte_extent);
    }
    auto spill_overlap_error(MetadataStore& store, i64 kind) -> bool {
        if (kind == 13) {
            return fail(store, MetadataError::span_overlap);
        }
        if (kind == 14) {
            return fail(store, MetadataError::service_overlap);
        }
        if (kind == 15) {
            return fail(store, MetadataError::region_overlap);
        }
        return fail(store, MetadataError::byte_overlap);
    }
    auto verify_spill_group(MetadataStore& store, CallableRow row, i64 kind) -> bool {
        const IndexRange slots = slot_group(store, row, kind);
        i64 previous_end = 0;
        i64 at = 0;
        while (at < slots.count()) {
            const SlotRow slot = store.slot_at(slots.begin() + at);
            const i64 width = slot_width(store, slot);
            if (slot.offset() < width || slot.offset() > row.frame_bytes() || slot.offset() % 8 != 0) {
                return spill_extent_error(store, kind);
            }
            const i64 first = slot.offset() - width + 1;
            i64 last_kind = 13;
            if (kind == 13) {
                last_kind = 12;
            }
            const i64 declaration = declaration_overlap(store, row, first, slot.offset(), last_kind);
            i64 spill = -1;
            if (first <= previous_end) {
                spill = first;
            }
            i64 earlier_kind = 14;
            while (earlier_kind < kind) {
                const IndexRange earlier = slot_group(store, row, earlier_kind);
                spill = earlier_overlap(spill, first_slot_overlap(store, earlier, first, slot.offset()));
                earlier_kind = earlier_kind + 1;
            }
            // The old occupied-byte scan checked declaration collision before
            // spill collision at each ascending byte. Preserve that precedence.
            if (declaration >= 0 && (spill < 0 || declaration <= spill)) {
                return spill_overlap_error(store, kind);
            }
            if (spill >= 0) {
                if (kind == 13) {
                    return fail(store, MetadataError::span_spills);
                }
                return fail(store, MetadataError::resource_overlap);
            }
            previous_end = slot.offset();
            at = at + 1;
        }
        return true;
    }
    auto verify_callable_frames(MetadataStore& store) -> bool {
        i64 at = 0;
        while (at < store.callable_count()) {
            const CallableRow row = store.callable_at(at);
            if (!verify_owner_slots(store, row) || !verify_span_value_slots(store, row)) {
                return false;
            }
            const IndexRange services = slot_group(store, row, 14);
            if (services.count() != 0 && !service_signature(store, row)) {
                return fail(store, MetadataError::service_spills);
            }
            if (row.frame_bytes() < 0 || row.frame_bytes() > 65536 || row.frame_bytes() % 16 != 0) {
                return fail(store, MetadataError::frame_size);
            }
            if (!verify_scalar_slots(store, row) || !verify_object_slots(store, row) || !verify_array_slots(store,
                row)) {
                return false;
            }
            i64 kind = 13;
            while (kind <= 16) {
                if (!verify_spill_group(store, row, kind)) {
                    return false;
                }
                kind = kind + 1;
            }
            at = at + 1;
        }
        return true;
    }

    auto run(MetadataStore& store) -> MetadataStatus {
        if (store.status() != MetadataStatus::pending) {
            return store.status();
        }
        if (!store.allocated()) {
            store.reject(MetadataError::integrity);
            return store.status();
        }
        if (!store.begin()) {
            return store.status();
        }
        if (!callable_name_integrity(store) || !verify_callable_symbols(store) || !input_integrity(store)
            || !verify_headers(store) || !normalize_fields(store) || !verify_fields(store) || !verify_carriers(store)
            || !verify_depths(store) || !verify_sealed(store) || !compute_storage(store)
            || !verify_storage_limits(store) || !verify_supplied_storage(store) || !verify_callable_signatures(store)
        // All frame declarations precede native instruction/CFG admission.
        // A later malformed frame can therefore precede an earlier body.
        || !verify_callable_frames(store) || !store.complete()) {
            if (store.status() == MetadataStatus::pending) {
                store.reject(MetadataError::integrity);
            }
            return store.status();
        }
        return store.status();
    }
}
