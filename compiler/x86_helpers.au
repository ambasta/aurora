export module aurora.compiler.x86_helpers;
import aurora.compiler.x86_storage;
import aurora.compiler.x86_object_storage;
import aurora.compiler.ir_metadata;
import aurora.compiler.ir_metadata_storage;
import aurora.compiler.ir_instructions;
import aurora.compiler.ir_instruction_storage;
import aurora.compiler.lowering_kinds;

export namespace compiler_x86 {
    auto service_type_kind(i64 kind) -> bool {
        return kind == 14 || kind == 15 || kind == 16 || kind == 18 || kind == 19 || kind == 20 || kind == 22 || kind
            == 23 || kind == 24 || kind == 25 || kind == 27;
    }
    // The zeroed session block the hosted entry reserves for the Linux binding
    // and lends to it as the HostFiles grant. Every HostFiles primitive checks
    // its byte offsets against this size before touching memory.
    auto host_session_bytes() -> i64 {
        return 16384;
    }
    // When the hosted entry takes a region, the session block is followed by
    // the memory runtime's mapping table, one 16-byte (base, length) entry per
    // slot, and then by the session's own address: a region word names a live
    // session only if the word at this offset from it equals the region word.
    // HostFiles session primitives cannot reach either (their offsets stay
    // below host_session_bytes()).
    auto host_memory_slots() -> i64 {
        return 16384;
    }
    auto host_session_self() -> i64 {
        return host_session_bytes() + 16 * host_memory_slots();
    }
    auto host_memory_block_bytes() -> i64 {
        return host_session_self() + 16;
    }
    // The memory runtime's state layout, the contract between the byte runtime
    // entries' inline fast path (x86_module.au) and runtime/linux/aurora/memory.au,
    // whose state comment defines the same layout; change both together. The
    // state is slot 0's mapping of host_memory_state_bytes(): a 64-byte header,
    // then one 32-byte record per slot whose word 0 is the id of the slot's
    // latest allocation, word 1 the element stride while it is live (0 when
    // free) and word 2 its byte length; WORD's offset in the record of SLOT is
    // 32 * SLOT + host_memory_record(WORD).
    auto host_memory_record_shift() -> i64 {
        return 5;
    }
    auto host_memory_record(i64 word) -> i64 {
        return 64 + 8 * word;
    }
    auto host_memory_state_bytes() -> i64 {
        return host_memory_record(0) + 32 * host_memory_slots();
    }
    // The openat2 flags of each HostFiles open mode: O_RDONLY | O_DIRECTORY,
    // O_RDONLY | O_NONBLOCK, O_PATH | O_NOFOLLOW (all O_CLOEXEC), O_WRONLY |
    // O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, O_RDWR, and mode 5 the same
    // O_RDONLY | O_NONBLOCK | O_CLOEXEC as mode 1.
    auto host_open_flags(i64 mode) -> i64 {
        if (mode == 0) {
            return 589824;
        }
        if (mode == 1 || mode == 5) {
            return 526336;
        }
        if (mode == 2) {
            return 2752512;
        }
        if (mode == 3) {
            return 655553;
        }
        return 2;
    }
    // The hosted entry: root-module main(builtin::HostFiles&, [builtin::ByteRegion,]
    // builtin::span<const u8>) -> builtin::HostExit, whose exact signature
    // lowering already admitted.
    auto hosted_entry(const compiler_ir_metadata::MetadataStore& metadata) -> i64 {
        i64 at = 0;
        while (at < metadata.callable_count()) {
            const compiler_ir_metadata::CallableRow row = metadata.callable_at(at);
            const compiler_ir_metadata::ByteRange name = row.name();
            const i64 suffix = name.count() - 11;
            const i64 count = row.value_parameter_count();
            if (row.scope() == 0 && (count == 2 || count == 3 || count == 4) && suffix > 0
                && compiler_ir_metadata::named(metadata, compiler_ir_metadata::ByteRange(name.begin() + suffix, 11),
                "_n0__d4main")) {
                const compiler_ir_metadata::RawTypeRow first = metadata.type_at(row.value_parameter_begin());
                const compiler_ir_metadata::RawTypeRow middle = metadata.type_at(row.value_parameter_begin() + 1);
                const compiler_ir_metadata::RawTypeRow last = metadata.type_at(row.value_parameter_begin() + count - 1);
                const compiler_ir_metadata::IndexRange types = row.types();
                const compiler_ir_metadata::RawTypeRow result = metadata.type_at(types.begin());
                bool signature = first.kind() == 22 && (count == 2 || (count == 3 && middle.kind() == 12));
                signature = signature || ((first.kind() == 20 || first.kind() == 24) && count == 3 && middle.kind()
                    == 12);
                if (first.kind() == 20 && count == 4 && (middle.kind() == 23 || middle.kind() == 24)) {
                    const compiler_ir_metadata::RawTypeRow region = metadata.type_at(row.value_parameter_begin() + 2);
                    signature = region.kind() == 12;
                }
                if (signature && last.kind() == 11 && result.kind() == 9 && compiler_ir_metadata::named(metadata,
                    result.name(), "__au_host_exit")) {
                    return at;
                }
            }
            at = at + 1;
        }
        return -1;
    }
    auto hosted_endpoint(const compiler_ir_metadata::MetadataStore& metadata) -> bool {
        const i64 entry = hosted_entry(metadata);
        if (entry < 0) {
            return false;
        }
        const compiler_ir_metadata::CallableRow row = metadata.callable_at(entry);
        const compiler_ir_metadata::RawTypeRow first = metadata.type_at(row.value_parameter_begin());
        return first.kind() == 20;
    }
    auto hosted_writer(const compiler_ir_metadata::MetadataStore& metadata) -> bool {
        const i64 entry = hosted_entry(metadata);
        if (entry < 0) {
            return false;
        }
        const compiler_ir_metadata::CallableRow row = metadata.callable_at(entry);
        const compiler_ir_metadata::RawTypeRow first = metadata.type_at(row.value_parameter_begin());
        if (first.kind() == 24) {
            return true;
        }
        if (first.kind() == 20 && row.value_parameter_count() == 4) {
            const compiler_ir_metadata::RawTypeRow second = metadata.type_at(row.value_parameter_begin() + 1);
            return second.kind() == 24;
        }
        return false;
    }
    auto hosted_block(const compiler_ir_metadata::MetadataStore& metadata) -> bool {
        const i64 entry = hosted_entry(metadata);
        if (entry < 0) {
            return false;
        }
        const compiler_ir_metadata::CallableRow row = metadata.callable_at(entry);
        return row.value_parameter_count() == 4;
    }
    auto block_window_bytes() -> i64 {
        return 528;
    }
    // Private process-endpoint window: copied metadata then disjoint request
    // and reply payloads. Neither source nor the memory grant can name it.
    auto endpoint_payload_bytes() -> i64 {
        return 65536;
    }
    auto endpoint_request_offset() -> i64 {
        return 64;
    }
    auto endpoint_reply_offset() -> i64 {
        return 65600;
    }
    auto endpoint_window_bytes() -> i64 {
        return 131136;
    }
    // Whether the hosted entry takes a ByteRegion, which the entry mints over
    // the memory runtime of aurora.host.
    auto hosted_region(const compiler_ir_metadata::MetadataStore& metadata) -> bool {
        const i64 entry = hosted_entry(metadata);
        if (entry < 0) {
            return false;
        }
        const compiler_ir_metadata::CallableRow row = metadata.callable_at(entry);
        return row.value_parameter_count() >= 3;
    }
    // The runtime's hooks host::start(builtin::HostFiles&) (hook 0), which the
    // hosted entry calls before main, and host::finish (hook 1), called after
    // main to discard uncommitted outputs and close descriptors.
    auto hosted_hook(const compiler_ir_metadata::MetadataStore& metadata, i64 callable, i64 hook) -> bool {
        const compiler_ir_metadata::CallableRow row = metadata.callable_at(callable);
        if (row.scope() == 0 || row.value_parameter_count() != 1) {
            return false;
        }
        if (hook == 0) {
            return compiler_ir_metadata::named(metadata, row.name(), "__au_v_m2_6aurora4host_n1_4host_d5start");
        }
        return compiler_ir_metadata::named(metadata, row.name(), "__au_v_m2_6aurora4host_n1_4host_d6finish");
    }
    // The memory runtime's functions host_memory::NAME(builtin::HostFiles&, ...)
    // of aurora.host that the hosted entry and the byte runtime entries call,
    // with their parameter counts: start 1, finish 1, allocate 3, payload 4,
    // at 5, set 6, element 6, resize 6 and drop 4.
    auto memory_hook_count() -> i64 {
        return 9;
    }
    auto memory_hook_parameters(i64 hook) -> i64 {
        if (hook < 2) {
            return 1;
        }
        if (hook == 2) {
            return 3;
        }
        if (hook == 3 || hook == 8) {
            return 4;
        }
        if (hook == 4) {
            return 5;
        }
        return 6;
    }
    auto memory_hook(const compiler_ir_metadata::MetadataStore& metadata, i64 callable, i64 hook) -> bool {
        const compiler_ir_metadata::CallableRow row = metadata.callable_at(callable);
        if (row.scope() == 0 || row.value_parameter_count() != memory_hook_parameters(hook)) {
            return false;
        }
        if (hook == 0) {
            return compiler_ir_metadata::named(metadata, row.name(), "__au_v_m2_6aurora6memory_n1_6memory_d5start");
        }
        if (hook == 1) {
            return compiler_ir_metadata::named(metadata, row.name(), "__au_v_m2_6aurora6memory_n1_6memory_d6finish");
        }
        if (hook == 2) {
            return compiler_ir_metadata::named(metadata, row.name(), "__au_v_m2_6aurora6memory_n1_6memory_d8allocate");
        }
        if (hook == 3) {
            return compiler_ir_metadata::named(metadata, row.name(), "__au_v_m2_6aurora6memory_n1_6memory_d7payload");
        }
        if (hook == 4) {
            return compiler_ir_metadata::named(metadata, row.name(), "__au_v_m2_6aurora6memory_n1_6memory_d2at");
        }
        if (hook == 5) {
            return compiler_ir_metadata::named(metadata, row.name(), "__au_v_m2_6aurora6memory_n1_6memory_d3set");
        }
        if (hook == 6) {
            return compiler_ir_metadata::named(metadata, row.name(), "__au_v_m2_6aurora6memory_n1_6memory_d7element");
        }
        if (hook == 7) {
            return compiler_ir_metadata::named(metadata, row.name(), "__au_v_m2_6aurora6memory_n1_6memory_d6resize");
        }
        return hook == 8 && compiler_ir_metadata::named(metadata, row.name(),
            "__au_v_m2_6aurora6memory_n1_6memory_d4drop");
    }
    // Whether CALLABLE is one of the memory runtime's functions.
    auto memory_runtime(const compiler_ir_metadata::MetadataStore& metadata, i64 callable) -> bool {
        i64 hook = 0;
        while (hook < memory_hook_count()) {
            if (memory_hook(metadata, callable, hook)) {
                return true;
            }
            hook = hook + 1;
        }
        return false;
    }
    auto memory_hook_callable(const compiler_ir_metadata::MetadataStore& metadata, i64 hook) -> i64 {
        i64 at = 0;
        while (at < metadata.callable_count()) {
            if (memory_hook(metadata, at, hook)) {
                return at;
            }
            at = at + 1;
        }
        return -1;
    }
    auto hosted_hook_callable(const compiler_ir_metadata::MetadataStore& metadata, i64 hook) -> i64 {
        i64 at = 0;
        while (at < metadata.callable_count()) {
            if (hosted_hook(metadata, at, hook)) {
                return at;
            }
            at = at + 1;
        }
        return -1;
    }
    auto operand_value(const compiler_ir_instructions::InstructionStore& store, i64 instruction, i64 field) -> i64 {
        return compiler_ir_instructions::call_value(store, instruction, field);
    }
    auto operand_count(const compiler_ir_instructions::InstructionStore& store, i64 instruction, i64 field) -> i64 {
        return compiler_ir_instructions::call_count(store, instruction, field);
    }
    auto operand_lane(const compiler_ir_instructions::InstructionStore& store, i64 instruction, i64 field,
        i64 lane) -> i64 {
        return compiler_ir_instructions::call_lane(store, instruction, field, lane);
    }
    auto instruction_target(const compiler_ir_metadata::MetadataStore& metadata,
        const compiler_ir_instructions::InstructionStore& store, i64 instruction) -> i64 {
        const compiler_ir_instructions::RawOperandRow operand = compiler_ir_instructions::call_operand(store,
            instruction, 0);
        const compiler_ir_metadata::ByteRange name = compiler_ir_metadata::ByteRange(operand.begin(), operand.count());
        return compiler_ir_metadata::first_named_callable(metadata, name);
    }
    auto type_kind(const compiler_ir_metadata::MetadataStore& metadata, i64 type) -> i64 {
        const compiler_ir_metadata::RawTypeRow row = metadata.type_at(type);
        return row.kind();
    }
    // Byte and typed readonly spans share the 56-byte capability record.
    auto span_kind(i64 kind) -> bool {
        return kind == 11 || kind == 21;
    }
    auto type_class(const compiler_ir_metadata::MetadataStore& metadata, i64 type) -> i64 {
        const compiler_ir_metadata::RawTypeRow row = metadata.type_at(type);
        return compiler_ir_metadata::find_class(metadata, row.name());
    }
    auto result_type(const compiler_ir_metadata::MetadataStore& metadata, i64 callable) -> i64 {
        const compiler_ir_metadata::CallableRow row = metadata.callable_at(callable);
        const compiler_ir_metadata::IndexRange types = row.types();
        return types.begin();
    }
    auto parameter_type(const compiler_ir_metadata::MetadataStore& metadata, i64 callable, i64 index) -> i64 {
        const compiler_ir_metadata::CallableRow row = metadata.callable_at(callable);
        return row.value_parameter_begin() + index;
    }
    auto parameter_count(const compiler_ir_metadata::MetadataStore& metadata, i64 callable) -> i64 {
        const compiler_ir_metadata::CallableRow row = metadata.callable_at(callable);
        return row.value_parameter_count();
    }
    auto class_storage(const compiler_ir_metadata::MetadataStore& metadata, i64 class_id) -> i64 {
        const compiler_ir_metadata::ClassResultRow row = metadata.result_at(class_id);
        return row.canonical_storage();
    }
    auto class_size(const compiler_ir_metadata::MetadataStore& metadata, i64 class_id) -> i64 {
        const compiler_ir_metadata::StorageRow row = metadata.storage_at(class_storage(metadata, class_id));
        const compiler_ir_metadata::PhysicalExtent extent = row.extent();
        return extent.size_bytes();
    }
    auto class_reserved(const compiler_ir_metadata::MetadataStore& metadata, i64 class_id) -> i64 {
        const compiler_ir_metadata::StorageRow row = metadata.storage_at(class_storage(metadata, class_id));
        const compiler_ir_metadata::PhysicalExtent extent = row.extent();
        return extent.reserved_bytes();
    }
    auto class_alignment(const compiler_ir_metadata::MetadataStore& metadata, i64 class_id) -> i64 {
        const compiler_ir_metadata::StorageRow row = metadata.storage_at(class_storage(metadata, class_id));
        const compiler_ir_metadata::PhysicalExtent extent = row.extent();
        return extent.alignment();
    }
    auto class_leaf_count(const compiler_ir_metadata::MetadataStore& metadata, i64 class_id) -> i64 {
        const compiler_ir_metadata::ClassRow row = metadata.class_at(class_id);
        const compiler_ir_metadata::IndexRange leaves = row.leaves();
        return leaves.count();
    }
    auto class_leaf_type(const compiler_ir_metadata::MetadataStore& metadata, i64 class_id, i64 leaf) -> i64 {
        const compiler_ir_metadata::ClassRow row = metadata.class_at(class_id);
        const compiler_ir_metadata::IndexRange leaves = row.leaves();
        return leaves.begin() + leaf;
    }
    auto class_leaf_offset(const compiler_ir_metadata::MetadataStore& metadata, i64 class_id, i64 leaf) -> i64 {
        const compiler_ir_metadata::StorageRow row = metadata.storage_at(class_storage(metadata, class_id));
        const compiler_ir_metadata::IndexRange offsets = row.leaf_offsets();
        const compiler_ir_metadata::IndexRow offset = metadata.index_at(offsets.begin() + leaf);
        return offset.value();
    }
    auto class_field_row(const compiler_ir_metadata::MetadataStore& metadata, i64 class_id, i64 field) -> i64 {
        const compiler_ir_metadata::ClassResultRow row = metadata.result_at(class_id);
        const compiler_ir_metadata::IndexRange fields = row.fields();
        return fields.begin() + field;
    }
    auto class_field_count(const compiler_ir_metadata::MetadataStore& metadata, i64 class_id) -> i64 {
        const compiler_ir_metadata::ClassResultRow row = metadata.result_at(class_id);
        const compiler_ir_metadata::IndexRange fields = row.fields();
        return fields.count();
    }
    auto class_field_type(const compiler_ir_metadata::MetadataStore& metadata, i64 class_id, i64 field) -> i64 {
        const compiler_ir_metadata::FieldRow row = metadata.field_at(class_field_row(metadata, class_id, field));
        return row.type();
    }
    auto class_field_first(const compiler_ir_metadata::MetadataStore& metadata, i64 class_id, i64 field) -> i64 {
        const compiler_ir_metadata::FieldRow row = metadata.field_at(class_field_row(metadata, class_id, field));
        return row.first_leaf();
    }
    auto class_field_length(const compiler_ir_metadata::MetadataStore& metadata, i64 class_id, i64 field) -> i64 {
        const compiler_ir_metadata::FieldRow row = metadata.field_at(class_field_row(metadata, class_id, field));
        return row.length();
    }
    auto class_field_elements(const compiler_ir_metadata::MetadataStore& metadata, i64 class_id, i64 field) -> i64 {
        const compiler_ir_metadata::FieldRow row = metadata.field_at(class_field_row(metadata, class_id, field));
        return row.element_count();
    }
    auto class_field_array(const compiler_ir_metadata::MetadataStore& metadata, i64 class_id, i64 field) -> i64 {
        const compiler_ir_metadata::FieldRow row = metadata.field_at(class_field_row(metadata, class_id, field));
        return row.array_flag();
    }
    auto class_field_offset(const compiler_ir_metadata::MetadataStore& metadata, i64 class_id, i64 field) -> i64 {
        const compiler_ir_metadata::StorageRow row = metadata.storage_at(class_storage(metadata, class_id));
        const compiler_ir_metadata::IndexRange offsets = row.field_offsets();
        const compiler_ir_metadata::IndexRow offset = metadata.index_at(offsets.begin() + field);
        return offset.value();
    }
    auto slot_class(const compiler_ir_metadata::MetadataStore& metadata, i64 callable, i64 offset) -> i64 {
        const i64 slot = compiler_ir_instructions::entry_slot(metadata, callable, 11, offset);
        const compiler_ir_metadata::SlotRow row = metadata.slot_at(slot);
        return type_class(metadata, row.type());
    }
    auto receiver_class(const compiler_ir_metadata::MetadataStore& metadata, i64 callable) -> i64 {
        const compiler_ir_metadata::CallableRow row = metadata.callable_at(callable);
        if (row.borrowed_root_count() > 0) {
            const i64 type = row.borrowed_root_type(0);
            if (type_kind(metadata, type) != 5) {
                return -1;
            }
            return type_class(metadata, type);
        }
        const compiler_ir_metadata::ReceiverShape receiver = row.first_receiver();
        return compiler_ir_metadata::find_class(metadata, receiver.name());
    }
    auto has_receiver(const compiler_ir_metadata::MetadataStore& metadata, i64 callable) -> bool {
        const compiler_ir_metadata::CallableRow row = metadata.callable_at(callable);
        const compiler_ir_metadata::FlagMasks masks = compiler_ir_metadata::flag_masks();
        return row.borrowed_root_count() > 0 || (row.attributes() & masks.callable_receiver()) != 0u64;
    }
    auto owning_class(const compiler_ir_metadata::MetadataStore& metadata, i64 class_id) -> bool {
        return compiler_ir_metadata::owning_class(metadata, class_id);
    }
    auto argument_bytes(const compiler_ir_metadata::MetadataStore& metadata, i64 type) -> i64 {
        const i64 kind = type_kind(metadata, type);
        if (service_type_kind(kind)) {
            return 16;
        }
        if (kind == 13 || kind == 17) {
            return 32;
        }
        if (kind == 5) {
            return class_reserved(metadata, type_class(metadata, type));
        }
        if (span_kind(kind)) {
            return 56;
        }
        return 8;
    }
    auto storage_width(const compiler_ir_metadata::MetadataStore& metadata, i64 type) -> i64 {
        if (type_kind(metadata, type) == 10) {
            return 1;
        }
        return 8;
    }
    auto record_offset(const compiler_ir_metadata::MetadataStore& metadata, i64 callable, i64 parameter) -> i64 {
        i64 offset = 0;
        i64 at = 0;
        while (at < parameter) {
            offset = offset + argument_bytes(metadata, parameter_type(metadata, callable, at));
            at = at + 1;
        }
        return offset;
    }
    auto aggregate_signature(const compiler_ir_metadata::MetadataStore& metadata, i64 callable) -> bool {
        const i64 result = type_kind(metadata, result_type(metadata, callable));
        if (result == 5 || span_kind(result) || result == 13 || result == 17) {
            return true;
        }
        i64 at = 0;
        while (at < parameter_count(metadata, callable)) {
            const i64 kind = type_kind(metadata, parameter_type(metadata, callable, at));
            if (kind == 5 || kind >= 11) {
                return true;
            }
            at = at + 1;
        }
        return false;
    }
    auto class_parameters(const compiler_ir_metadata::MetadataStore& metadata, i64 callable) -> bool {
        i64 at = 0;
        while (at < parameter_count(metadata, callable)) {
            const i64 kind = type_kind(metadata, parameter_type(metadata, callable, at));
            if (kind == 5 || span_kind(kind)) {
                return true;
            }
            at = at + 1;
        }
        return false;
    }
    auto object_leaf(const compiler_ir_metadata::MetadataStore& metadata, i64 callable, i64 base, i64 leaf) -> i64 {
        return base - class_leaf_offset(metadata, slot_class(metadata, callable, base), leaf);
    }
    auto owner_storage_type(const compiler_ir_metadata::MetadataStore& metadata, i64 callable, i64 offset,
        i64 field) -> i64 {
        if (field < 0) {
            const compiler_ir_metadata::CallableRow function = metadata.callable_at(callable);
            if (field == -1 && offset == 0 && function.borrowed_root_count() == 1) {
                const i64 type = function.borrowed_root_type(0);
                if (type_kind(metadata, type) == 17) {
                    return type;
                }
            }
            const compiler_ir_metadata::IndexRange slots = function.slots();
            i64 at = 0;
            while (at < slots.count()) {
                const compiler_ir_metadata::SlotRow row = metadata.slot_at(slots.begin() + at);
                if (row.offset() == offset && row.kind() == 17) {
                    return row.type();
                }
                at = at + 1;
            }
            return -1;
        }
        i64 class_id = receiver_class(metadata, callable);
        if (offset != 0) {
            class_id = slot_class(metadata, callable, offset);
        }
        return class_field_type(metadata, class_id, field);
    }
    // The element size of a typed readonly span spill, or -1 for a byte span.
    auto span_element_stride(const compiler_ir_metadata::MetadataStore& metadata, i64 callable, i64 offset) -> i64 {
        const compiler_ir_metadata::CallableRow function = metadata.callable_at(callable);
        const compiler_ir_metadata::IndexRange slots = function.slots();
        i64 at = 0;
        while (at < slots.count()) {
            const compiler_ir_metadata::SlotRow row = metadata.slot_at(slots.begin() + at);
            if (row.offset() == offset && row.kind() == 27) {
                return class_size(metadata, type_class(metadata, row.type()));
            }
            at = at + 1;
        }
        return -1;
    }
    auto owner_element_stride(const compiler_ir_metadata::MetadataStore& metadata, i64 callable, i64 offset,
        i64 field) -> i64 {
        return class_size(metadata, type_class(metadata, owner_storage_type(metadata, callable, offset, field)));
    }
    auto metadata_text(EmitWorkspace& workspace, ObjectWorkspace& o,
        const compiler_ir_metadata::MetadataStore& metadata, i64 begin, i64 count) -> bool {
        i64 at = 0;
        if (o.object_mode()) {
            while (at < count) {
                o.object_name_byte(u8(metadata.byte_at(begin + at)));
                at = at + 1;
            }
        } else {
            while (at < count) {
                workspace.byte(u8(metadata.byte_at(begin + at)));
                at = at + 1;
            }
        }
        return emit_object_status(workspace, o);
    }
    auto callable_name(EmitWorkspace& workspace, ObjectWorkspace& o,
        const compiler_ir_metadata::MetadataStore& metadata, i64 callable) -> bool {
        const compiler_ir_metadata::CallableRow row = metadata.callable_at(callable);
        const compiler_ir_metadata::ByteRange name = row.name();
        return metadata_text(workspace, o, metadata, name.begin(), name.count());
    }
    auto query_name(EmitWorkspace& workspace, ObjectWorkspace& o, i64 query, i64 scope) -> bool {
        if (scope < 0 || scope >= 256 || query < 0 || query >= 2) {
            return workspace.fail();
        }
        if (scope == 0) {
            if (o.object_mode()) {
                o.object_name_text("aurora_reflect_");
            } else {
                workspace.text("aurora_reflect_");
            }
        } else {
            if (o.object_mode()) {
                o.object_name_text("__au_reflect_s");
            } else {
                workspace.text("__au_reflect_s");
            }
            if (o.object_mode()) {
                if (scope >= 100) {
                    o.object_name_byte(u8(48 + scope / 100));
                }
                if (scope >= 10) {
                    o.object_name_byte(u8(48 + scope / 10 % 10));
                }
                o.object_name_byte(u8(48 + scope % 10));
            } else {
                workspace.number(scope);
            }
            if (o.object_mode()) {
                o.object_name_text("_");
            } else {
                workspace.text("_");
            }
        }
        if (o.object_mode()) {
            if (query == 0) {
                o.object_name_text("size");
            } else {
                o.object_name_text("field_count");
            }
            return emit_object_status(workspace, o);
        }
        if (query == 0) {
            return workspace.text("size");
        }
        return workspace.text("field_count");
    }
    auto direct_target(EmitWorkspace& workspace, ObjectWorkspace& o,
        const compiler_ir_metadata::MetadataStore& metadata, i64 callable) -> bool {
        workspace.record_call(0, callable);
        if (o.object_mode()) {
            if (!o.has_object_symbol(callable)) {
                o.begin_object_external(0, callable);
                callable_name(workspace, o, metadata, callable);
                o.end_object_symbol_name();
            }
            return emit_object_call_symbol(workspace, o, callable);
        }
        workspace.text("    call ");
        callable_name(workspace, o, metadata, callable);
        return workspace.end_line();
    }
    auto call_target(EmitWorkspace& workspace, ObjectWorkspace& o, const compiler_ir_metadata::MetadataStore& metadata,
        i64 callable) -> bool {
        emit_prepare_call(workspace, o);
        direct_target(workspace, o, metadata, callable);
        return emit_finish_call(workspace, o);
    }
    auto call_query(EmitWorkspace& workspace, ObjectWorkspace& o, const compiler_ir_metadata::MetadataStore& metadata,
        i64 query, i64 scope) -> bool {
        emit_prepare_call(workspace, o);
        const i64 identity = scope * 2 + query;
        workspace.record_call(1, identity);
        if (o.object_mode()) {
            if (o.object_symbol_index(4, identity) < 0) {
                o.begin_object_external(4, identity);
                query_name(workspace, o, query, scope);
                o.end_object_symbol_name();
            }
            o.object_call_query(identity);
            emit_object_status(workspace, o);
        } else {
            workspace.text("    call ");
            query_name(workspace, o, query, scope);
            workspace.end_line();
        }
        return emit_finish_call(workspace, o);
    }
    auto root_save_offset(EmitWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 ordinal) -> i64 {
        const i64 callable = workspace.current_callable();
        const compiler_ir_metadata::CallableRow row = metadata.callable_at(callable);
        i64 count = row.borrowed_root_count();
        if (count == 0 && has_receiver(metadata, callable)) {
            count = 1;
        }
        const i64 save = workspace.receiver_save();
        if (save == 0 || ordinal < 0 || ordinal >= count || ordinal >= 6) {
            workspace.fail();
            return 0;
        }
        return save + ordinal * 8;
    }
    // An in-place typed span element (module_elidable): kind 0 views stash the
    // element address in the object's first word; kind 1 views copied it there.
    auto elided_receiver(EmitWorkspace& workspace, ObjectWorkspace& o, i64 root, i64 span, Register target) -> bool {
        if (!workspace.owned_span_runtime()) {
            return emit_load(workspace, o, root, target, false);
        }
        const i64 division = workspace.next_division();
        emit_cmp_imm_memory(workspace, o, 0, span);
        emit_branch(workspace, o, 5, 5, division);
        emit_load(workspace, o, root, target, false);
        emit_branch(workspace, o, -1, 6, division);
        emit_bind_label(workspace, o, 5, division);
        emit_lea(workspace, o, root, target);
        return emit_bind_label(workspace, o, 6, division);
    }
    auto receiver_address(EmitWorkspace& workspace, ObjectWorkspace& o,
        const compiler_ir_metadata::MetadataStore& metadata, i64 root, Register target) -> bool {
        if (root > 0) {
            const i64 elided = workspace.loan_offset(0 - root);
            if (elided > 0) {
                return elided_receiver(workspace, o, root, elided, target);
            }
        }
        if (root >= -5 && root <= 0) {
            const i64 offset = root_save_offset(workspace, metadata, -root);
            return emit_load(workspace, o, offset, target, false);
        }
        if (root > 0) {
            return emit_lea(workspace, o, root, target);
        }
        return workspace.fail();
    }
    auto load_value(EmitWorkspace& workspace, ObjectWorkspace& o, const compiler_ir_metadata::MetadataStore& metadata,
        i64 type, i64 source) -> bool {
        return emit_load(workspace, o, source, Register::rax, type_kind(metadata, type) == 10);
    }
    auto store_value(EmitWorkspace& workspace, ObjectWorkspace& o, const compiler_ir_metadata::MetadataStore& metadata,
        i64 type, i64 destination) -> bool {
        return emit_store(workspace, o, Register::rax, destination, type_kind(metadata, type) == 10);
    }
    auto store_argument(EmitWorkspace& workspace, ObjectWorkspace& o,
        const compiler_ir_metadata::MetadataStore& metadata, i64 type, i64 index, i64 destination) -> bool {
        const Register source = workspace.argument_register_id(index);
        return emit_store(workspace, o, source, destination, type_kind(metadata, type) == 10);
    }
    auto clear_bytes(EmitWorkspace& workspace, ObjectWorkspace& o, i64 begin, i64 end, i64 destination) -> bool {
        i64 at = begin;
        while (at < end) {
            const i64 remaining = end - at;
            i64 width = 1;
            if (remaining >= 8) {
                width = 8;
            } else {
                if (remaining >= 4) {
                    width = 4;
                } else {
                    if (remaining >= 2) {
                        width = 2;
                    }
                }
            }
            const i64 address = workspace.advance_address(destination, at);
            emit_store_imm_width(workspace, o, 0, address, width);
            at = at + width;
        }
        return workspace.ok();
    }
    auto clear_bytes_owner(EmitWorkspace& workspace, ObjectWorkspace& o, i64 offset) -> bool {
        i64 byte = 0;
        while (byte < 32) {
            emit_store_imm(workspace, o, 0, offset - byte, false);
            byte = byte + 8;
        }
        return workspace.ok();
    }
    auto move_bytes_owner(EmitWorkspace& workspace, ObjectWorkspace& o, i64 source, i64 destination) -> bool {
        i64 byte = 0;
        while (byte < 32) {
            emit_load(workspace, o, source - byte, Register::rcx, false);
            emit_store(workspace, o, Register::rcx, destination - byte, false);
            byte = byte + 8;
        }
        return clear_bytes_owner(workspace, o, source);
    }
    auto bytes_owner_address(EmitWorkspace& workspace, ObjectWorkspace& o,
        const compiler_ir_metadata::MetadataStore& metadata, i64 offset, i64 field, i64 byte) -> i64 {
        const i64 callable = workspace.current_callable();
        if (field < 0) {
            if (offset == 0 && field == -1) {
                const compiler_ir_metadata::CallableRow function = metadata.callable_at(callable);
                if (function.borrowed_root_count() == 1 && type_kind(metadata, function.borrowed_root_type(0)) == 17) {
                    const i64 save = root_save_offset(workspace, metadata, 0);
                    emit_load(workspace, o, save, Register::r10, false);
                    return workspace.pack_address(2, byte);
                }
                workspace.fail();
            }
            return workspace.pack_address(0, offset - byte);
        }
        i64 class_id = receiver_class(metadata, callable);
        if (offset != 0) {
            class_id = slot_class(metadata, callable, offset);
        }
        const i64 field_offset = class_field_offset(metadata, class_id, field);
        if (offset != 0) {
            return workspace.pack_address(0, offset - field_offset - byte);
        }
        const i64 save = workspace.receiver_save();
        emit_load(workspace, o, save, Register::r10, false);
        return workspace.pack_address(2, field_offset + byte);
    }
    auto clear_padding(EmitWorkspace& workspace, ObjectWorkspace& o,
        const compiler_ir_metadata::MetadataStore& metadata, i64 class_id, i64 destination) -> bool {
        // Canonical admission orders leaf offsets and declaration field offsets.
        // Merge those two ordered payload streams, skipping non-owner fields.
        // Each extent is visited once; no payload-sized temporary or rescan.
        i64 cursor = 0;
        i64 leaf = 0;
        i64 field = 0;
        const i64 end = class_reserved(metadata, class_id);
        const i64 leaves = class_leaf_count(metadata, class_id);
        const i64 fields = class_field_count(metadata, class_id);
        while (leaf < leaves || field < fields) {
            bool owner = false;
            while (field < fields && !owner) {
                const i64 kind = type_kind(metadata, class_field_type(metadata, class_id, field));
                owner = kind == 13 || kind == 17;
                if (!owner) {
                    field = field + 1;
                }
            }
            i64 leaf_offset = end;
            i64 owner_offset = end;
            if (leaf < leaves) {
                leaf_offset = class_leaf_offset(metadata, class_id, leaf);
            }
            if (field < fields) {
                owner_offset = class_field_offset(metadata, class_id, field);
            }
            if (leaf_offset == end && owner_offset == end) {
                field = fields;
                leaf = leaves;
            } else {
                if (leaf_offset < owner_offset) {
                    clear_bytes(workspace, o, cursor, leaf_offset, destination);
                    cursor = leaf_offset + storage_width(metadata, class_leaf_type(metadata, class_id, leaf));
                    leaf = leaf + 1;
                } else {
                    clear_bytes(workspace, o, cursor, owner_offset, destination);
                    cursor = owner_offset + 32;
                    field = field + 1;
                }
            }
        }
        clear_bytes(workspace, o, cursor, end, destination);
        return workspace.ok();
    }
    auto clear_object(EmitWorkspace& workspace, ObjectWorkspace& o, const compiler_ir_metadata::MetadataStore& metadata,
        i64 base, i64 class_id) -> bool {
        const i64 packed_address1 = workspace.pack_address(0, base);
        clear_padding(workspace, o, metadata, class_id, packed_address1);
        i64 field = 0;
        while (field < class_field_count(metadata, class_id)) {
            const i64 kind = type_kind(metadata, class_field_type(metadata, class_id, field));
            if (kind == 13 || kind == 17) {
                clear_bytes_owner(workspace, o, base - class_field_offset(metadata, class_id, field));
            }
            field = field + 1;
        }
        return workspace.ok();
    }
    auto copy_leaves(EmitWorkspace& workspace, ObjectWorkspace& o, const compiler_ir_metadata::MetadataStore& metadata,
        i64 source_class, i64 destination_class, i64 count) -> bool {
        const i64 source = workspace.copy_source();
        const i64 destination = workspace.copy_destination();
        const i64 source_first = workspace.copy_source_first();
        const i64 destination_first = workspace.copy_destination_first();
        i64 leaf = 0;
        while (leaf < count) {
            const i64 type = class_leaf_type(metadata, source_class, source_first + leaf);
            const i64 source_offset = class_leaf_offset(metadata, source_class, source_first + leaf);
            const i64 destination_offset = class_leaf_offset(metadata, destination_class, destination_first + leaf);
            i64 end = leaf + 1;
            i64 bytes = storage_width(metadata, type);
            bool contiguous = true;
            while (end < count && contiguous) {
                contiguous = class_leaf_offset(metadata, source_class, source_first + end) == source_offset + bytes
                    && class_leaf_offset(metadata, destination_class, destination_first + end) == destination_offset
                    + bytes;
                if (contiguous) {
                    bytes = bytes + storage_width(metadata, class_leaf_type(metadata, source_class, source_first
                        + end));
                    end = end + 1;
                }
            }
            if (bytes >= 64) {
                const bool stack_destination = destination >= 1000000000 && destination < 2000000000;
                if (stack_destination) {
                    const i64 packed_address2 = workspace.advance_address(destination, destination_offset);
                    emit_lea(workspace, o, packed_address2, Register::rax);
                }
                emit_push_register(workspace, o, Register::rsi);
                emit_push_register(workspace, o, Register::rdi);
                emit_push_register(workspace, o, Register::rcx);
                workspace.grow_stack(24);
                const i64 packed_address3 = workspace.advance_address(source, source_offset);
                emit_lea(workspace, o, packed_address3, Register::rsi);
                if (stack_destination) {
                    emit_mov_rr(workspace, o, Register::rax, Register::rdi);
                } else {
                    const i64 packed_address4 = workspace.advance_address(destination, destination_offset);
                    emit_lea(workspace, o, packed_address4, Register::rdi);
                }
                emit_mov_imm(workspace, o, bytes, Register::rcx);
                emit_cld(workspace, o);
                emit_rep_movsb(workspace, o);
                emit_pop_register(workspace, o, Register::rcx);
                emit_pop_register(workspace, o, Register::rdi);
                emit_pop_register(workspace, o, Register::rsi);
                workspace.shrink_stack(24);
                leaf = end;
            } else {
                bool qword = count - leaf >= 8;
                i64 byte = 0;
                while (qword && byte < 8) {
                    qword = type_kind(metadata, class_leaf_type(metadata, source_class, source_first + leaf + byte))
                        == 10 && class_leaf_offset(metadata, source_class, source_first + leaf + byte) == source_offset
                        + byte && class_leaf_offset(metadata, destination_class, destination_first + leaf + byte)
                        == destination_offset + byte;
                    byte = byte + 1;
                }
                if (qword) {
                    const i64 packed_address5 = workspace.advance_address(source, source_offset);
                    emit_load(workspace, o, packed_address5, Register::rax, false);
                    const i64 packed_address6 = workspace.advance_address(destination, destination_offset);
                    emit_store(workspace, o, Register::rax, packed_address6, false);
                    leaf = leaf + 8;
                } else {
                    const i64 packed_address7 = workspace.advance_address(source, source_offset);
                    load_value(workspace, o, metadata, type, packed_address7);
                    const i64 packed_address8 = workspace.advance_address(destination, destination_offset);
                    store_value(workspace, o, metadata, type, packed_address8);
                    leaf = leaf + 1;
                }
            }
        }
        return workspace.ok();
    }
    auto copy_class(EmitWorkspace& workspace, ObjectWorkspace& o, const compiler_ir_metadata::MetadataStore& metadata,
        i64 class_id, i64 source, i64 destination) -> bool {
        workspace.set_copy(source, destination, 0, 0);
        return copy_leaves(workspace, o, metadata, class_id, class_id, class_leaf_count(metadata, class_id));
    }
    auto transfer_object(EmitWorkspace& workspace, ObjectWorkspace& o,
        const compiler_ir_metadata::MetadataStore& metadata, i64 class_id, i64 source, i64 destination) -> bool {
        i64 leaf = 0;
        while (leaf < class_leaf_count(metadata, class_id)) {
            const i64 offset = class_leaf_offset(metadata, class_id, leaf);
            const bool narrow = type_kind(metadata, class_leaf_type(metadata, class_id, leaf)) == 10;
            const i64 source_address = workspace.advance_address(source, offset);
            emit_load(workspace, o, source_address, Register::rcx, narrow);
            const i64 destination_address = workspace.advance_address(destination, offset);
            emit_store(workspace, o, Register::rcx, destination_address, narrow);
            leaf = leaf + 1;
        }
        i64 field = 0;
        while (field < class_field_count(metadata, class_id)) {
            const i64 kind = type_kind(metadata, class_field_type(metadata, class_id, field));
            if (kind == 13 || kind == 17) {
                const i64 offset = class_field_offset(metadata, class_id, field);
                i64 byte = 0;
                while (byte < 32) {
                    const i64 packed_address11 = workspace.advance_address(source, offset + byte);
                    emit_load(workspace, o, packed_address11, Register::rcx, false);
                    const i64 packed_address12 = workspace.advance_address(destination, offset + byte);
                    emit_store(workspace, o, Register::rcx, packed_address12, false);
                    byte = byte + 8;
                }
                clear_bytes(workspace, o, offset, offset + 32, source);
            }
            field = field + 1;
        }
        return workspace.ok();
    }
    auto drop_object(EmitWorkspace& workspace, ObjectWorkspace& o, const compiler_ir_metadata::MetadataStore& metadata,
        i64 base, i64 class_id) -> bool {
        if (!owning_class(metadata, class_id)) {
            return workspace.ok();
        }
        emit_push(workspace, o);
        i64 field = class_field_count(metadata, class_id);
        while (field > 0) {
            const i64 kind = type_kind(metadata, class_field_type(metadata, class_id, field - 1));
            if (kind == 13 || kind == 17) {
                emit_lea(workspace, o, base - class_field_offset(metadata, class_id, field - 1), Register::rdi);
                const i64 runtime_symbol1 = workspace.intern_runtime("__au_runtime_bytes_drop");
                emit_call_runtime(workspace, o, runtime_symbol1);
            }
            field = field - 1;
        }
        return emit_pop(workspace, o, Register::rax);
    }
}
