    auto resource_runtime_byte(i64 kind, i64 method, i64 index) -> i64 {
        if (kind == 2) {
            if (method == 0) {
                return catalog_byte("__au_runtime_resident_prepare", index);
            }
            if (method == 1) {
                return catalog_byte("__au_runtime_resident_run", index);
            }
            if (method == 2) {
                return catalog_byte("__au_runtime_resident_console", index);
            }
            if (method == 3) {
                return catalog_byte("__au_runtime_resident_reject", index);
            }
            if (method == 4) {
                return catalog_byte("__au_runtime_resident_begin_shutdown", index);
            }
            if (method == 5) {
                return catalog_byte("__au_runtime_resident_advance_shutdown", index);
            }
            if (method == 6) {
                return catalog_byte("__au_runtime_resident_finish", index);
            }
            return -1;
        }
        if (kind == 0) {
            if (method == -1) {
                return catalog_byte("__au_runtime_execution_prepare", index);
            }
            if (method == 0) {
                return catalog_byte("__au_runtime_execution_preparation", index);
            }
            if (method == 1) {
                return catalog_byte("__au_runtime_execution_advance", index);
            }
            if (method == 2) {
                return catalog_byte("__au_runtime_execution_output", index);
            }
            if (method == 3) {
                return catalog_byte("__au_runtime_execution_request", index);
            }
            if (method == 4) {
                return catalog_byte("__au_runtime_execution_cancel", index);
            }
            if (method == 5) {
                return catalog_byte("__au_runtime_execution_finish", index);
            }
        }
        if (kind == 1) {
            if (method == -1) {
                return catalog_byte("__au_runtime_service_bootstrap_begin", index);
            }
            if (method == 0) {
                return catalog_byte("__au_runtime_service_bootstrap_preparation", index);
            }
            if (method == 1) {
                return catalog_byte("__au_runtime_service_bootstrap_begin_volume", index);
            }
            if (method == 2) {
                return catalog_byte("__au_runtime_service_bootstrap_copy_volume", index);
            }
            if (method == 3) {
                return catalog_byte("__au_runtime_service_bootstrap_seal_volume", index);
            }
            if (method == 4) {
                return catalog_byte("__au_runtime_service_bootstrap_admit_storage", index);
            }
            if (method == 5) {
                return catalog_byte("__au_runtime_service_bootstrap_advance", index);
            }
            if (method == 6) {
                return catalog_byte("__au_runtime_service_bootstrap_finish", index);
            }
        }
        return -1;
    }
    auto bootstrap_type_word(compiler_resolver::Session& session, i64 type, i64 part, i64 begin, i64 end) -> i64 {
        if (type == 47) {
            return use_word(session, "builtin::ServiceBootstrapEffects", part, begin, end);
        }
        if (type == 48) {
            return use_word(session, "builtin::ServiceBootstrapLease", part, begin, end);
        }
        if (type == 49) {
            return use_word(session,
                "builtin::BootstrapPreparation;__au_bootstrap_preparation;loaded;volume_bytes;chunk_bytes;storage_required",
                part, begin, end);
        }
        if (type == 50) {
            return use_word(session, "builtin::BootstrapEffect;__au_bootstrap_effect;staged;failed", part, begin, end);
        }
        if (type == 51) {
            return use_word(session, "builtin::BootstrapProgress;__au_bootstrap_progress;pending;complete;failed", part,
                begin, end);
        }
        if (type == 52) {
            return use_word(session, "builtin::BootstrapFinish;__au_bootstrap_finish;publish;abandon", part, begin,
                end);
        }
        if (type == 53) {
            return use_word(session, "builtin::BootstrapResult;__au_bootstrap_result;ready;unavailable", part, begin,
                end);
        }
        return -1;
    }

    // Scalar descriptors: concrete kind, public reflection identity and size.
    auto scalar_count() -> i64 {
        return 7;
    }
    auto scalar_kind(i64 scalar) -> compiler_resolver::ResolvedTypeKind {
        if (scalar == 0) {
            return compiler_resolver::ResolvedTypeKind::i64_value;
        }
        if (scalar == 1) {
            return compiler_resolver::ResolvedTypeKind::bool_value;
        }
        if (scalar == 2) {
            return compiler_resolver::ResolvedTypeKind::owner;
        }
        if (scalar == 3) {
            return compiler_resolver::ResolvedTypeKind::reference;
        }
        if (scalar == 4) {
            return compiler_resolver::ResolvedTypeKind::mutable_reference;
        }
        if (scalar == 5) {
            return compiler_resolver::ResolvedTypeKind::u64_value;
        }
        if (scalar == 6) {
            return compiler_resolver::ResolvedTypeKind::u8_value;
        }
        return compiler_resolver::ResolvedTypeKind::invalid;
    }
    auto scalar_public_id(i64 scalar) -> i64 {
        if (scalar == 5) {
            return 8;
        }
        if (scalar == 6) {
            return 11;
        }
        return scalar + 1;
    }
    auto scalar_size(i64 scalar) -> i64 {
        if (scalar == 1 || scalar == 6) {
            return 1;
        }
        return 8;
    }

    // Sealed service operations, indexed by ServiceOperation.
    auto operation_count() -> i64 {
        return 52;
    }
    auto operation_kind(i64 operation) -> i64 {
        if (operation == 51) {
            return 10;
        }
        if (operation >= 46 && operation < 51) {
            return 9;
        }
        if (operation >= 39 && operation < 46) {
            return 8;
        }
        if (operation >= 36 && operation < 39) {
            return 7;
        }
        if (operation < 2) {
            return 0;
        }
        if (operation == 2) {
            return 1;
        }
        if (operation < 5) {
            return 2;
        }
        if (operation == 5) {
            return 3;
        }
        if (operation < 8) {
            return 4;
        }
        if (operation == 8 || (operation >= 32 && operation < 36)) {
            return 5;
        }
        return 6;
    }
    // Catalog type of a capability kind.
    auto kind_type(i64 kind) -> i64 {
        if (kind == 10) {
            return 47;
        }
        if (kind == 9) {
            return 36;
        }
        if (kind == 8) {
            return 35;
        }
        if (kind == 7) {
            return 34;
        }
        if (kind == 6) {
            return 26;
        }
        return 6 + kind;
    }
    auto kind_receiver(i64 kind) -> compiler_resolver::ResolvedTypeKind {
        return type_kind(kind_type(kind));
    }
    auto kind_family(i64 kind) -> i64 {
        return type_family(kind_type(kind));
    }
    // Catalog type of the operation's result.
    auto operation_result(i64 operation) -> i64 {
        if (operation == 51) {
            return 48;
        }
        if (operation == 46) {
            return 45;
        }
        if (operation == 47) {
            return 41;
        }
        if (operation == 48 || operation == 50) {
            return 42;
        }
        if (operation == 49) {
            return 43;
        }
        if (operation >= 39 && operation < 46) {
            if (operation == 40) {
                return 2;
            }
            return 1;
        }
        if (operation == 36 || operation == 38) {
            return 1;
        }
        if (operation == 37) {
            return 2;
        }
        if (operation == 0) {
            return 12;
        }
        if (operation == 1) {
            return 13;
        }
        if (operation == 2) {
            return 15;
        }
        if (operation == 3) {
            return 17;
        }
        if (operation == 4) {
            return 19;
        }
        if (operation == 5) {
            return 21;
        }
        if (operation == 6) {
            return 2;
        }
        if (operation == 7) {
            return 23;
        }
        if (operation == 8 || operation == 32) {
            return 24;
        }
        if (operation == 9 || operation == 10 || operation == 24 || operation == 25 || operation == 28 || operation
            == 35) {
            return 1;
        }
        if (operation == 11 || operation == 12 || operation == 26 || operation == 27 || operation == 33 || operation
            == 34) {
            return 2;
        }
        if (operation == 14 || operation == 30) {
            return 33;
        }
        return 0;
    }
    auto parameter_count(i64 operation) -> i64 {
        if (operation == 51) {
            return 0;
        }
        if (operation >= 46 && operation < 50) {
            return 0;
        }
        if (operation == 44 || operation == 45) {
            return 0;
        }
        if (operation == 42) {
            return 2;
        }
        if (operation == 0 || operation == 3 || operation == 4 || operation == 20) {
            return 0;
        }
        if (operation == 2 || operation == 16 || operation == 31) {
            return 5;
        }
        if (operation == 13) {
            return 4;
        }
        if (operation == 7 || operation == 10 || operation == 12 || operation == 14 || operation == 19 || operation
            == 21 || operation == 22 || operation == 24 || operation == 26 || operation == 30 || operation == 34) {
            return 2;
        }
        if (operation == 15 || operation == 17 || operation == 25 || operation == 27 || operation == 28 || operation
            == 29) {
            return 3;
        }
        return 1;
    }
    // Optional nominal argument identity; other operations retain scalar arguments.
    auto parameter_nominal(i64 operation, i64 index) -> i64 {
        if (operation == 50 && index == 0) {
            return 44;
        }
        return -1;
    }
    auto parameter_kind(i64 operation, i64 index) -> compiler_resolver::ResolvedTypeKind {
        if ((operation == 42 && index == 1) || operation == 1 || (operation == 2 && index > 1) || (operation == 7
            && index == 1) || (operation == 12 && index == 1) || (operation == 27 && index == 2) || (operation == 34
            && index == 1)) {
            return compiler_resolver::ResolvedTypeKind::u8_value;
        }
        if (operation > 12 && operation < 20 && index == 0) {
            return compiler_resolver::ResolvedTypeKind::i64_value;
        }
        return compiler_resolver::ResolvedTypeKind::u64_value;
    }
    auto append_spelling(compiler_resolver::Session& session, i64 operation) -> i64 {
        if (operation == 51) {
            return use_word(session, "begin", 0, -1, 0);
        }
        if (operation >= 46 && operation < 51) {
            return use_word(session, "prepare;advance;output;request;finish", operation - 46, -1, 0);
        }
        if (operation >= 39 && operation < 46) {
            return use_word(session, "read_sector;sector_byte;descriptor;stage_byte;write_sector;flush;budget",
                operation - 39, -1, 0);
        }
        if (operation >= 36 && operation < 39) {
            return use_word(session, "read_sector;sector_byte;descriptor", operation - 36, -1, 0);
        }
        if (operation >= 32 && operation < 36) {
            return use_word(session, "message_exchange;message_load;message_store;message_identity", operation - 32, -1,
                0);
        }
        if (operation > 28) {
            return use_word(session, "kernel_print;kernel_chunk;kernel_file", operation - 29, -1, 0);
        }
        if (operation > 20) {
            return use_word(session,
                "map_memory;remap_memory;unmap_memory;memory_load;memory_store;memory_load8;memory_store8;memory_address",
                operation - 21, -1, 0);
        }
        if (operation > 14) {
            return use_word(session,
                "system_write;system_rename;system_unlink;system_close;system_stat;system_identity", operation - 15, -1,
                0);
        }
        if (operation > 8) {
            return use_word(session, "load;store;load8;store8;system_open;system_chunk", operation - 9, -1, 0);
        }
        return use_word(session, "next;put;pixel;poll;acknowledge;call;read8;write8;exchange", operation, -1, 0);
    }

    // HostFiles operations 9..31 are the bindings' private primitives,
    // admitted only inside the designated runtime module aurora.host. The
    // byte offsets of 9..20 address the session block that the hosted entry
    // reserves; 21..28 map, unmap and access the memory runtime's mappings,
    // whose table follows the session block when the entry takes a region.
    // 9..12 and 21..28 serve every target; 13..20 exist only for --target
    // linux and 29 (print), 30 (read into a HostChunk) and 31 (a file
    // operation on a handle, a session buffer and a session result record)
    // only for --target aurora, where they and map, remap and unmap enter the
    // Aurora kernel through INT 0x83.
    // The ten public HostFiles operations are implemented by exported
    // functions of namespace host in module aurora.host; a call on the
    // capability forwards it to that function as its first argument.
    auto host_operation_count() -> i64 {
        return 10;
    }
    auto host_operation(compiler_resolver::Session& session, i64 operation, i64 begin, i64 end) -> i64 {
        if (operation > 7) {
            return use_word(session, "close;open_file", operation - 8, begin, end);
        }
        return use_word(session, "open_directory;open_beneath;read;create_output;write;commit;discard;print", operation,
            begin, end);
    }
    // The runtime function implementing each public operation, host::files_NAME
    // (`read` and `write` themselves are reserved function names).
    auto host_runtime_name(compiler_resolver::Session& session, i64 operation, i64 begin, i64 end) -> i64 {
        if (operation > 5) {
            return use_word(session, "files_discard;files_print;files_close;files_open_file", operation - 6, begin,
                end);
        }
        return use_word(session,
            "files_open_directory;files_open_beneath;files_read;files_create_output;files_write;files_commit",
            operation, begin, end);
    }

    // Group bit 1 << m admits the capability-kind set m (bit k for kind k) in
    // one signature: every singleton plus Console+Display and Console+IommuEvent.
    // HostFiles is kind 6, whose set 64 has no bit in the word; bit 0 (the empty
    // set, never a group) admits that singleton instead.
    auto host_service_group() -> i64 {
        return 1;
    }
    auto base_service_groups() -> i64 {
        return 62;
    }
    auto call_service_group() -> i64 {
        return 256;
    }
    auto port_service_group() -> i64 {
        return 65536;
    }
    auto serve_service_group() -> i64 {
        return 4294967296;
    }
    // Explicit tags for groups whose capability masks exceed the legacy word.
    // They are not permission for the old mask6 pair or mask7 triple.
    auto block_service_group() -> i64 {
        return 64;
    }
    auto serve_block_service_group() -> i64 {
        return 128;
    }
    auto writer_service_group() -> i64 {
        return 512;
    }
    auto serve_writer_service_group() -> i64 {
        return 1024;
    }
    auto bootstrap_service_group() -> i64 {
        return 4096;
    }
    auto bootstrap_groups(i64 groups, bool bootstrap) -> i64 {
        if (bootstrap) {
            return groups + bootstrap_service_group();
        }
        return groups;
    }
    auto execution_service_group() -> i64 {
        return 2048;
    }
    auto execution_groups(i64 groups, bool execution) -> i64 {
        if (execution) {
            return groups + execution_service_group();
        }
        return groups;
    }
    auto service_groups(bool call, bool port, bool serve, bool host, bool block, bool writer) -> i64 {
        i64 groups = base_service_groups();
        if (writer) {
            groups = groups + writer_service_group();
            if (serve) {
                groups = groups + serve_writer_service_group();
            }
        }
        if (host) {
            groups = groups + host_service_group();
        }
        if (block) {
            groups = groups + block_service_group();
            if (serve) {
                groups = groups + serve_block_service_group();
            }
        }
        if (call) {
            groups = groups + call_service_group();
        }
        if (port) {
            groups = groups + port_service_group();
        }
        if (serve) {
            groups = groups + serve_service_group();
        }
        return groups;
    }
    auto summary() -> Summary {
        i64 texts = 0;
        i64 members = 0;
        i64 type = 0;
        while (type < type_count()) {
            texts = texts + 1;
            if (nominal(type)) {
                texts = texts + 1 + member_count(type);
                members = members + member_count(type);
            }
            type = type + 1;
        }
        i64 parameters = 0;
        i64 operation = 0;
        while (operation < operation_count()) {
            parameters = parameters + parameter_count(operation);
            operation = operation + 1;
        }
        texts = texts + operation_count();
        Summary result = Summary(type_count(), texts, texts * maximum_word(), members, operation_count(), parameters);
        result.set_policy(scalar_count(), bootstrap_groups(execution_groups(service_groups(true, true, true, true, true,
            true), true), true));
        return result;
    }
}
