export module aurora.compiler.builtin_catalog;
import aurora.compiler.lexer;
import aurora.compiler.resolution_kinds;
import aurora.compiler.resolution_rows;
import aurora.compiler.resolution_arena;
import aurora.compiler.syntax_arena;
import aurora.compiler.lowering_kinds;
import aurora.compiler.lowering_errors;
import aurora.compiler.lowering_storage;

// The closed catalog of built-in types, scalar descriptors and sealed service
// operations. The resolver seeds its descriptors and lowering its contracts
// from these tables; the host reads only the two enums and summary().
export namespace compiler_catalog {
    // Case ordinals are the kind and operation codes carried by lowering
    // operand rows and typed IR; the tables below are indexed by them.
    enum class ServiceKind {
        Console,
        Display,
        IommuEvent,
        Call,
        Port,
        Serve,
        HostFiles,
        ReadOnlyBlock,
        WritableBlock,
        ExecutionEffects,
        ServiceBootstrapEffects
    };
    enum class ServiceOperation {
        Next,
        Put,
        Pixel,
        IommuPoll,
        IommuAcknowledge,
        Call,
        PortRead8,
        PortWrite8,
        ServeExchange,
        HostLoad,
        HostStore,
        HostLoad8,
        HostStore8,
        HostOpen,
        HostChunk,
        HostWrite,
        HostRename,
        HostUnlink,
        HostClose,
        HostStat,
        HostIdentity,
        MemoryMap,
        MemoryRemap,
        MemoryUnmap,
        MemoryLoad,
        MemoryStore,
        MemoryLoad8,
        MemoryStore8,
        MemoryAddress,
        KernelPrint,
        KernelChunk,
        KernelFile,
        MessageExchange,
        MessageLoad,
        MessageStore,
        MessageIdentity,
        BlockRead,
        BlockByte,
        BlockDescriptor,
        WriterRead,
        WriterByte,
        WriterDescriptor,
        WriterStageByte,
        WriterWrite,
        WriterFlush,
        WriterBudget,
        ExecutionPrepare,
        ExecutionAdvance,
        ExecutionOutput,
        ExecutionRequest,
        ExecutionFinish,
        BootstrapBegin
    };
    // Catalog extents for the host's loose resolution quota.
    class Summary {
        i64 typeCount;
        i64 textCount;
        i64 textBytes;
        i64 memberCount;
        i64 operationCount;
        i64 parameterCount;
        i64 scalarCount;
        i64 serviceGroups;
    public:
        Summary(i64 types, i64 texts, i64 bytes, i64 members, i64 operations, i64 parameters) : typeCount(types),
            textCount(texts), textBytes(bytes), memberCount(members), operationCount(operations),
            parameterCount(parameters), scalarCount(0), serviceGroups(0) {
        }
        auto set_policy(i64 scalars, i64 groups) -> bool {
            scalarCount = scalars;
            serviceGroups = groups;
            return true;
        }
    };
    class Word {
        i64 first;
        i64 count;
    public:
        Word(i64 begin, i64 size) : first(begin), count(size) {
        }
        auto begin() const -> i64 {
            return first;
        }
        auto size() const -> i64 {
            return count;
        }
    };
    // Every catalog spelling fits this many bytes; summary() charges it per text.
    auto maximum_word() -> i64 {
        return 32;
    }
    auto word(builtin::span<const u8> words, i64 part) -> Word {
        i64 at = 0;
        i64 begin = 0;
        i64 index = 0;
        while (at <= words.size()) {
            if (at == words.size() || words.at(at) == ';') {
                if (index == part) {
                    const Word result = Word(begin, at - begin);
                    return result;
                }
                index = index + 1;
                begin = at + 1;
            }
            at = at + 1;
        }
        const Word missing = Word(0, 0);
        return missing;
    }
    // With begin < 0, appends word `part` of the ';'-separated list as Session
    // text and returns its reference. Otherwise returns 1 when source bytes
    // [begin, end) spell the word after its last ':' and 0 when they do not.
    auto use_word(compiler_resolver::Session& session, builtin::span<const u8> words, i64 part, i64 begin,
        i64 end) -> i64 {
        const Word found = word(words, part);
        if (found.size() < 1 || found.size() > maximum_word()) {
            return session.fail_storage(compiler_resolver::StorageStatus::invalid);
        }
        if (begin < 0) {
            return session.append_text(words.subspan(found.begin(), found.size()));
        }
        i64 first = found.begin();
        i64 at = 0;
        while (at < found.size()) {
            if (words.at(found.begin() + at) == ':') {
                first = found.begin() + at + 1;
            }
            at = at + 1;
        }
        const i64 count = found.begin() + found.size() - first;
        if (end - begin != count) {
            return 0;
        }
        at = 0;
        while (at < count && session.good()) {
            if (session.source_byte(begin + at) != words.at(first + at)) {
                return 0;
            }
            at = at + 1;
        }
        return 1;
    }

    // Built-in types in seeding order. Types 6..11 and 26 are the capability
    // types in ServiceKind order. Family 0 is always seeded; families 1 (Call),
    // 2 (Port), 3 (Serve) and 4 (HostFiles) only when admitted syntax names one
    // of their types.
    auto type_count() -> i64 {
        return 57;
    }
    auto type_kind(i64 type) -> compiler_resolver::ResolvedTypeKind {
        if (type == 54) {
            return compiler_resolver::ResolvedTypeKind::service_resource;
        }
        if (type == 55) {
            return compiler_resolver::ResolvedTypeKind::class_value;
        }
        if (type == 56) {
            return compiler_resolver::ResolvedTypeKind::enum_value;
        }
        if (type == 47) {
            return compiler_resolver::ResolvedTypeKind::bootstrap_effects;
        }
        if (type == 49) {
            return compiler_resolver::ResolvedTypeKind::class_value;
        }
        if (type >= 50 && type <= 53) {
            return compiler_resolver::ResolvedTypeKind::enum_value;
        }
        if (type == 45 || type == 48) {
            return compiler_resolver::ResolvedTypeKind::service_resource;
        }
        if (type == 46) {
            return compiler_resolver::ResolvedTypeKind::enum_value;
        }
        if (type == 36) {
            return compiler_resolver::ResolvedTypeKind::execution_effects;
        }
        if (type == 39 || type == 41) {
            return compiler_resolver::ResolvedTypeKind::class_value;
        }
        if (type > 36 && type < 45) {
            return compiler_resolver::ResolvedTypeKind::enum_value;
        }
        if (type == 0) {
            return compiler_resolver::ResolvedTypeKind::i64_value;
        }
        if (type == 1) {
            return compiler_resolver::ResolvedTypeKind::u64_value;
        }
        if (type == 2) {
            return compiler_resolver::ResolvedTypeKind::u8_value;
        }
        if (type == 3) {
            return compiler_resolver::ResolvedTypeKind::bool_value;
        }
        if (type == 4) {
            return compiler_resolver::ResolvedTypeKind::byte_region;
        }
        if (type == 5) {
            return compiler_resolver::ResolvedTypeKind::owned_bytes;
        }
        if (type == 6) {
            return compiler_resolver::ResolvedTypeKind::console_session;
        }
        if (type == 7) {
            return compiler_resolver::ResolvedTypeKind::display_session;
        }
        if (type == 8) {
            return compiler_resolver::ResolvedTypeKind::event_session;
        }
        if (type == 9) {
            return compiler_resolver::ResolvedTypeKind::call_session;
        }
        if (type == 10) {
            return compiler_resolver::ResolvedTypeKind::port_range;
        }
        if (type == 11) {
            return compiler_resolver::ResolvedTypeKind::serve_session;
        }
        if (type == 26) {
            return compiler_resolver::ResolvedTypeKind::host_files;
        }
        if (type == 35) {
            return compiler_resolver::ResolvedTypeKind::writable_block;
        }
        if (type == 34) {
            return compiler_resolver::ResolvedTypeKind::read_only_block;
        }
        if (type == 12 || type == 17 || type == 21 || type == 24 || (type > 29 && type < 34)) {
            return compiler_resolver::ResolvedTypeKind::class_value;
        }
        if (type > 12 && type < 30) {
            return compiler_resolver::ResolvedTypeKind::enum_value;
        }
        return compiler_resolver::ResolvedTypeKind::invalid;
    }
    auto type_family(i64 type) -> i64 {
        if (type >= 54 && type < 57) {
            return 9;
        }
        if (type >= 47 && type < 54) {
            return 8;
        }
        if (type >= 36 && type < 47) {
            return 7;
        }
        if (type == 35) {
            return 6;
        }
        if (type == 34) {
            return 5;
        }
        if (type == 9 || type == 21 || type == 22) {
            return 1;
        }
        if (type == 10 || type == 23) {
            return 2;
        }
        if (type == 11 || type == 24 || type == 25) {
            return 3;
        }
        if (type > 25 && type < 34) {
            return 4;
        }
        return 0;
    }
    auto nominal(i64 type) -> bool {
        const compiler_resolver::ResolvedTypeKind kind = type_kind(type);
        return kind == compiler_resolver::ResolvedTypeKind::class_value || kind
            == compiler_resolver::ResolvedTypeKind::enum_value;
    }
    // Field or case count of a nominal type.
    auto member_count(i64 type) -> i64 {
        if (type == 55) {
            return 2;
        }
        if (type == 56) {
            return 4;
        }
        if (type == 49) {
            return 4;
        }
        if (type == 51) {
            return 3;
        }
        if (type == 50 || type == 52 || type == 53) {
            return 2;
        }
        if (type == 37 || type == 41 || type == 46) {
            return 3;
        }
        if (type == 39) {
            return 2;
        }
        if (type == 38) {
            return 9;
        }
        if (type == 43 || type == 44) {
            return 5;
        }
        if (type == 40) {
            return 4;
        }
        if (type == 12 || type == 19) {
            return 3;
        }
        if (type == 17 || type == 18) {
            return 4;
        }
        if (type == 20) {
            return 7;
        }
        if (type == 22) {
            return 3;
        }
        if (type == 23) {
            return 1;
        }
        if (type == 27 || type == 33) {
            return 3;
        }
        if (type == 30) {
            return 4;
        }
        if (type == 32) {
            return 6;
        }
        if (type == 28) {
            return 10;
        }
        if (type == 31) {
            return 5;
        }
        if (nominal(type)) {
            return 2;
        }
        return 0;
    }
    // Catalog type of a class field.
    auto field_type(i64 type, i64 field) -> i64 {
        if (type == 55) {
            if (field == 0) {
                return 38;
            }
            return 1;
        }
        if (type == 49) {
            if (field == 0 || field == 3) {
                return 3;
            }
            return 1;
        }
        if (type == 39 || type == 41) {
            if (field == 0) {
                if (type == 39) {
                    return 37;
                }
                return 40;
            }
            if (field == 1) {
                return 38;
            }
            if (type == 39) {
                return 3;
            }
            return 1;
        }
        if (type == 12) {
            if (field == 1) {
                return 2;
            }
            return 3;
        }
        if (type == 33 && field == 2) {
            return 2;
        }
        if (field > 0) {
            return 1;
        }
        if (type == 17) {
            return 18;
        }
        if (type == 21) {
            return 22;
        }
        if (type > 29) {
            return 28;
        }
        return 25;
    }
    // Element count of an array-typed class field, or 0 for a scalar field.
    // HostChunk carries 504 bytes: with its two leading qwords that is the
    // whole 520-byte copied-class bound and 506 of the 513 permitted leaves.
    auto field_array_length(i64 type, i64 field) -> i64 {
        if (type == 33 && field == 2) {
            return 504;
        }
        return 0;
    }
    // Words: full spelling, then for nominal types the native spelling and the
    // field or case names in declaration order. See use_word for begin/end.
    auto type_word(compiler_resolver::Session& session, i64 type, i64 part, i64 begin, i64 end) -> i64 {
        if (type == 54) {
            return use_word(session, "builtin::ResidentSlot", part, begin, end);
        }
        if (type == 55) {
            return use_word(session, "builtin::ResidentRunResult;__au_resident_run_result;status;value", part, begin,
                end);
        }
        if (type == 56) {
            return use_word(session,
                "builtin::ResidentStatus;__au_resident_status;success;unavailable;conflict;malformed", part, begin,
                end);
        }
        if (type >= 47 && type < 54) {
            return bootstrap_type_word(session, type, part, begin, end);
        }
        if (type >= 36 && type < 47) {
            return execution_type_word(session, type, part, begin, end);
        }
        if (type < 4) {
            return use_word(session, "i64;u64;u8;bool", type, begin, end);
        }
        if (type < 8) {
            return use_word(session,
                "builtin::ByteRegion;builtin::OwnedBytes;builtin::ConsoleSession;builtin::DisplaySession", type - 4,
                begin, end);
        }
        if (type < 12) {
            return use_word(session,
                "builtin::IommuEventSession;builtin::CallSession;builtin::Com1UartGrant;builtin::ServeSession", type
                - 8, begin, end);
        }
        if (type == 35) {
            return use_word(session, "builtin::WritableBlock", part, begin, end);
        }
        if (type == 34) {
            return use_word(session, "builtin::ReadOnlyBlock", part, begin, end);
        }
        if (type > 25) {
            return host_type_word(session, type, part, begin, end);
        }
        if (type == 12) {
            return use_word(session, "builtin::ConsoleSample;__au_console_sample;byte_present;byte;damaged", part,
                begin, end);
        }
        if (type == 13) {
            return use_word(session, "builtin::ConsolePutResult;__au_console_put_result;success;timeout", part, begin,
                end);
        }
        if (type == 14) {
            return use_word(session, "builtin::ConsoleCompletion;__au_console_completion;requested_exit;output_failure",
                part, begin, end);
        }
        if (type == 15) {
            return use_word(session, "builtin::DisplayPutResult;__au_display_put_result;success;out_of_bounds", part,
                begin, end);
        }
        if (type == 16) {
            return use_word(session, "builtin::DisplayCompletion;__au_display_completion;rendered;output_failure", part,
                begin, end);
        }
        if (type == 17) {
            return use_word(session, "builtin::IommuEventSample;__au_iommu_event_sample;result;word0;word1;status_low",
                part, begin, end);
        }
        if (type == 18) {
            return use_word(session,
                "builtin::EventPollResult;__au_event_poll_result;empty;record;overflow;transport_failure", part, begin,
                end);
        }
        if (type == 19) {
            return use_word(session,
                "builtin::EventAckResult;__au_event_ack_result;committed;overflow;transport_failure", part, begin, end);
        }
        if (type == 20 && part < 4) {
            return use_word(session,
                "builtin::EventIntakeCompletion;__au_event_intake_completion;drained;budget_exhausted", part, begin,
                end);
        }
        if (type == 20) {
            return use_word(session, "loss_detected;unsupported_event;command_error;transport_failure;output_failure",
                part - 4, begin, end);
        }
        if (type == 21) {
            return use_word(session, "builtin::CallResult;__au_call_result;status;value", part, begin, end);
        }
        if (type == 22) {
            return use_word(session, "builtin::CallStatus;__au_call_status;replied;cancelled;rejected", part, begin,
                end);
        }
        if (type == 23) {
            return use_word(session, "builtin::PortWriteResult;__au_port_write_result;issued", part, begin, end);
        }
        if (type == 24) {
            return use_word(session, "builtin::ServeRequest;__au_serve_request;status;value", part, begin, end);
        }
        return use_word(session, "builtin::ServeStatus;__au_serve_status;request;cancelled", part, begin, end);
    }
    auto execution_type_word(compiler_resolver::Session& session, i64 type, i64 part, i64 begin, i64 end) -> i64 {
        if (type == 45) {
            return use_word(session, "builtin::ExecutionLease", part, begin, end);
        }
        if (type == 46) {
            return use_word(session, "builtin::ExecCancel;__au_exec_cancel;settled;draining;service_lost", part, begin,
                end);
        }
        if (type == 36) {
            return use_word(session, "builtin::ExecutionEffects", part, begin, end);
        }
        if (type == 37) {
            return use_word(session, "builtin::ExecPrepared;__au_exec_prepared;loaded;refused;service_lost", part,
                begin, end);
        }
        if (type == 38) {
            return use_word(session,
                "builtin::ExecStatus;__au_exec_status;exited;fault;watchdog;missing;malformed;quota;unavailable;output_failed;cancelled",
                part, begin, end);
        }
        if (type == 39) {
            return use_word(session, "builtin::ExecutionPrep;__au_execution_prep;state;status", part, begin, end);
        }
        if (type == 40) {
            return use_word(session, "builtin::ExecStep;__au_exec_step;retired;output;request;parked", part, begin,
                end);
        }
        if (type == 41) {
            return use_word(session, "builtin::ExecutionStep;__au_execution_step;state;status;value", part, begin, end);
        }
        if (type == 42) {
            return use_word(session, "builtin::ExecEffect;__au_exec_effect;success;failed", part, begin, end);
        }
        if (type == 43) {
            return use_word(session,
                "builtin::ExecRequest;__au_exec_request;ready;cancelled;service_lost;pending;cancel_requested", part,
                begin, end);
        }
        return use_word(session,
            "builtin::ExecFinish;__au_exec_finish;complete;output_failed;cancelled;service_lost;cancel_requested", part,
            begin, end);
    }
    auto host_type_word(compiler_resolver::Session& session, i64 type, i64 part, i64 begin, i64 end) -> i64 {
        if (type == 26) {
            return use_word(session, "builtin::HostFiles", part, begin, end);
        }
        if (type == 27) {
            return use_word(session, "builtin::HostExit;__au_host_exit;success;failure;usage", part, begin, end);
        }
        if (type == 28 && part < 6) {
            return use_word(session, "builtin::HostStatus;__au_host_status;success;invalid_handle;not_found;denied",
                part, begin, end);
        }
        if (type == 28) {
            return use_word(session, "escape;not_regular;exhausted;too_large;invalid_path;failed", part - 6, begin,
                end);
        }
        if (type == 29) {
            return use_word(session, "builtin::HostStream;__au_host_stream;stdout;stderr", part, begin, end);
        }
        if (type == 30) {
            return use_word(session, "builtin::HostDirectoryResult;__au_host_directory_result;status;id;device;inode",
                part, begin, end);
        }
        if (type == 31) {
            return use_word(session, "builtin::HostFileResult;__au_host_file_result;status;id;size;device;inode", part,
                begin, end);
        }
        if (type == 32) {
            if (part < 6) {
                return use_word(session, "builtin::HostOutputResult;__au_host_output_result;status;id;device;inode",
                    part, begin, end);
            }
            return use_word(session, "directory_device;directory_inode", part - 6, begin, end);
        }
        return use_word(session, "builtin::HostChunk;__au_host_chunk;status;count;bytes", part, begin, end);
    }

    // Resource identities are catalog ordinals, not per-family resolver kinds.
    auto resource_count() -> i64 {
        return 3;
    }
    auto resource_kind(i64 type) -> i64 {
        if (type == 54) {
            return 2;
        }
        if (type == 45) {
            return 0;
        }
        if (type == 48) {
            return 1;
        }
        return -1;
    }
    auto resource_type(i64 kind) -> i64 {
        if (kind == 2) {
            return 54;
        }
        if (kind == 0) {
            return 45;
        }
        if (kind == 1) {
            return 48;
        }
        return -1;
    }
    auto resource_retained(i64 kind) -> bool {
        return kind == 2;
    }
    auto resource_field_eligible(i64 kind) -> bool {
        return resource_retained(kind);
    }
    auto resource_issuer(i64 kind) -> i64 {
        if (kind >= 0 && kind < 2) {
            return 9 + kind;
        }
        return -1;
    }
    auto resource_issue_operation(i64 kind) -> i64 {
        if (kind == 0) {
            return 46;
        }
        if (kind == 1) {
            return 51;
        }
        return -1;
    }
    auto resource_extent(i64 kind) -> i64 {
        if (kind >= 0 && kind < resource_count()) {
            return 16;
        }
        return 0;
    }
    auto resource_explicit_finish(i64 kind) -> bool {
        return kind >= 0 && kind < resource_count();
    }
    auto resource_method_count(i64 kind) -> i64 {
        if (kind == 2) {
            return 7;
        }
        if (kind >= 0 && kind < resource_count()) {
            return 6 + kind;
        }
        return 0;
    }
    auto resource_method_word(compiler_resolver::Session& session, i64 kind, i64 method, i64 begin, i64 end) -> i64 {
        if (kind == 2) {
            return use_word(session, "prepare;run;console;reject;begin_shutdown;advance_shutdown;finish", method, begin,
                end);
        }
        if (kind == 0) {
            return use_word(session, "preparation;advance;output;request;cancel;finish", method, begin, end);
        }
        if (kind == 1) {
            return use_word(session, "preparation;begin_volume;copy_volume;seal_volume;admit_storage;advance;finish",
                method, begin, end);
        }
        return -1;
    }
    auto resource_method_result(i64 kind, i64 method) -> i64 {
        if (method < 0 || method >= resource_method_count(kind)) {
            return -1;
        }
        if (kind == 2) {
            if (method == 0) {
                return 3;
            }
            if (method == 1) {
                return 55;
            }
            if (method == 2 || method == 3) {
                return 56;
            }
            if (method == 6) {
                return 42;
            }
            return 51;
        }
        if (kind == 1) {
            if (method == 0) {
                return 49;
            }
            if (method == 5) {
                return 51;
            }
            if (method == 6) {
                return 53;
            }
            return 50;
        }
        if (method == 0) {
            return 39;
        }
        if (method == 1) {
            return 41;
        }
        if (method == 3) {
            return 43;
        }
        if (method == 4) {
            return 46;
        }
        return 42;
    }
    auto resource_method_parameters(i64 kind, i64 method) -> i64 {
        if ((kind == 0 && method == 5) || (kind == 1 && (method == 2 || method == 6))) {
            return 1;
        }
        return 0;
    }
    auto resource_method_parameter(i64 kind, i64 method) -> i64 {
        if (kind == 0 && method == 5) {
            return 44;
        }
        if (kind == 1 && method == 2) {
            return 1;
        }
        if (kind == 1 && method == 6) {
            return 52;
        }
        return -1;
    }
    auto resource_method_effect(i64 kind, i64 method) -> i64 {
        if (method < 0 || method >= resource_method_count(kind)) {
            return -1;
        }
        if (method == 0 && !resource_retained(kind)) {
            return 0;
        }
        if (method == resource_method_count(kind) - 1) {
            return 2;
        }
        return 1;
    }
    auto operation_admitted(i64 operation) -> bool {
        return (operation >= 0 && operation < 47) || operation == 51;
    }
    auto catalog_byte(builtin::span<const u8> name, i64 index) -> i64 {
        if (index == -1) {
            return name.size();
        }
        if (index < 0 || index >= name.size()) {
            return -1;
        }
        return i64(name.at(index));
    }
    auto type_source_byte(i64 type, i64 index) -> i64 {
        if (type == 54) {
            return catalog_byte("builtin::ResidentSlot", index);
        }
        if (type == 45) {
            return catalog_byte("builtin::ExecutionLease", index);
        }
        if (type == 48) {
            return catalog_byte("builtin::ServiceBootstrapLease", index);
        }
        return -1;
    }
    auto type_native_byte(i64 type, i64 index) -> i64 {
        if (type == 54) {
