export module aurora.compiler.lowering_configuration;
import aurora.compiler.syntax_arena;
import aurora.compiler.lexer;
import aurora.compiler.resolver;
import aurora.compiler.resolution_arena;
import aurora.compiler.resolution_rows;
import aurora.compiler.resolution_kinds;
import aurora.compiler.lowering_kinds;
import aurora.compiler.lowering_errors;
import aurora.compiler.lowering_storage;
import aurora.compiler.lowering_common;
import aurora.compiler.builtin_catalog;

// A bounded immutable setup contract. It is not a semantic query surface.
// Row0 reserves diagnostics; row1 has limits, mode and service groups; rows2..8
// have the catalog scalar descriptors; the next five through nine rows hold the
// catalog operations of the seeded service families, followed by initial
// layout order and then semantic output.
export namespace compiler_lowering {
    auto setup_invalid(compiler_resolver::Session& session) -> i64 {
        return session.fail_storage(compiler_resolver::StorageStatus::invalid);
    }
    auto has_call_service(i64 groups) -> bool {
        const i64 mask = compiler_catalog::call_service_group();
        return (u64(groups) & u64(mask)) != 0u64;
    }
    auto has_port_service(i64 groups) -> bool {
        const i64 mask = compiler_catalog::port_service_group();
        return (u64(groups) & u64(mask)) != 0u64;
    }
    auto has_serve_service(i64 groups) -> bool {
        const i64 mask = compiler_catalog::serve_service_group();
        return (u64(groups) & u64(mask)) != 0u64;
    }
    auto valid_service_groups(i64 groups) -> bool {
        return groups >= 0 && groups == compiler_catalog::service_groups(has_call_service(groups),
            has_port_service(groups), has_serve_service(groups));
    }
    auto active_service_kind(i64 groups, i64 kind) -> bool {
        if (kind < 0 || kind > 5) {
            return false;
        }
        const i64 family = compiler_catalog::kind_family(kind);
        return family == 0 || (family == 1 && has_call_service(groups)) || (family == 2 && has_port_service(groups))
            || (family == 3 && has_serve_service(groups));
    }
    auto active_service_operation(i64 groups, i64 operation) -> bool {
        return operation >= 0 && operation < compiler_catalog::operation_count() && active_service_kind(groups,
            compiler_catalog::operation_kind(operation));
    }
    auto service_operation_count(i64 groups) -> i64 {
        i64 count = 0;
        i64 operation = 0;
        while (operation < compiler_catalog::operation_count()) {
            if (active_service_operation(groups, operation)) {
                count = count + 1;
            }
            operation = operation + 1;
        }
        return count;
    }
    auto service_contract_count(compiler_resolver::Session& session) -> i64 {
        const i64 groups = record_signed(session, 1, OperandRole::SupportedServiceGroups);
        if (!valid_service_groups(groups)) {
            return setup_invalid(session);
        }
        return service_operation_count(groups);
    }
    auto lowering_prelude_rows(compiler_resolver::Session& session) -> i64 {
        return 10 + service_contract_count(session);
    }
    auto seed_scalar(compiler_resolver::Session& session, i64 scalar) -> i64 {
        const i64 begin = session.operand_count();
        const i64 type = compiler_resolver::scalar_type(session, compiler_catalog::scalar_kind(scalar));
        put(session, OperandRole::TypeId, type);
        put(session, OperandRole::PublicDescriptorId, compiler_catalog::scalar_public_id(scalar));
        put(session, OperandRole::Size, compiler_catalog::scalar_size(scalar));
        return record(session, RecordKind::ScalarContract, begin, 3);
    }
    auto seed_service(compiler_resolver::Session& session, i64 operation) -> i64 {
        const i64 kind = compiler_catalog::operation_kind(operation);
        const i64 spelling = compiler_catalog::append_spelling(session, operation);
        const i64 result = compiler_resolver::catalog_type(session, compiler_catalog::operation_result(operation));
        const i64 count = compiler_catalog::parameter_count(operation);
        const i64 arguments = session.operand_count();
        i64 at = 0;
        while (at < count && session.good()) {
            const i64 type = compiler_resolver::scalar_type(session, compiler_catalog::parameter_kind(operation, at));
            put(session, OperandRole::TypeId, type);
            at = at + 1;
        }
        const i64 begin = session.operand_count();
        const i64 receiver = compiler_resolver::scalar_type(session, compiler_catalog::kind_receiver(kind));
        put(session, OperandRole::TypeId, receiver);
        put(session, OperandRole::ServiceKindId, kind);
        put(session, OperandRole::ServiceOperationId, operation);
        put(session, OperandRole::IdentifierSourceRef, spelling);
        put(session, OperandRole::ResultTypeId, result);
        put_slice(session, OperandRole::ParameterTypes, arguments, count);
        return record(session, RecordKind::ServiceContract, begin, 6);
    }
    // Work row [symbol, native-begin, native-end] ordering by native name bytes.
    auto native_before(compiler_resolver::Session& session, compiler_resolver::WorkRow left,
        compiler_resolver::WorkRow right) -> bool {
        i64 at = 0;
        while (left.word(1) + at < left.word(2) && right.word(1) + at < right.word(2) && session.good()) {
            const u8 first = session.source_byte(left.word(1) + at);
            const u8 second = session.source_byte(right.word(1) + at);
            if (first != second) {
                return first < second;
            }
            at = at + 1;
        }
        return left.word(2) - left.word(1) < right.word(2) - right.word(1);
    }
    auto smaller(i64 left, i64 right) -> i64 {
        if (left < right) {
            return left;
        }
        return right;
    }
    // Initial layout order: every class declaration, sorted by native name with a
    // bottom-up merge sort over two work-row runs.
    auto seed_layout_order(compiler_resolver::Session& session) -> i64 {
        const i64 base = session.work_count();
        const i64 resolved = session.index(60, 0, 0, 0, 0);
        i64 count = 0;
        i64 link = compiler_resolver::mw(session, resolved, 2);
        while (link >= 0 && session.good()) {
            const i64 symbol = compiler_resolver::mw(session, link, 0);
            const i64 native = compiler_resolver::mw(session, symbol, 0);
            const compiler_resolver::MetaRow name = session.meta(native);
            session.append_work(compiler_resolver::WorkRow(symbol, name.word(1), name.word(2), 0, 0, 0));
            count = count + 1;
            link = compiler_resolver::mw(session, link, 1);
        }
        i64 at = 0;
        while (at < count && session.good()) {
            session.append_work(compiler_resolver::WorkRow(-1, 0, 0, 0, 0, 0));
            at = at + 1;
        }
        i64 from = base;
        i64 to = base + count;
        i64 width = 1;
        while (width < count && session.good()) {
            i64 low = 0;
            while (low < count && session.good()) {
                const i64 middle = smaller(low + width, count);
                const i64 high = smaller(low + 2 * width, count);
                i64 left = low;
                i64 right = middle;
                at = low;
                while (at < high && session.good()) {
                    bool take_left = left < middle;
                    if (take_left && right < high) {
                        const compiler_resolver::WorkRow first = session.work(from + left);
                        const compiler_resolver::WorkRow second = session.work(from + right);
                        take_left = !native_before(session, second, first);
                    }
                    i64 source = right;
                    if (take_left) {
                        source = left;
                        left = left + 1;
                    } else {
                        right = right + 1;
                    }
                    const compiler_resolver::WorkRow row = session.work(from + source);
                    session.set_work(to + at, row);
                    at = at + 1;
                }
                low = high;
            }
            const i64 sorted = to;
            to = from;
            from = sorted;
            width = width * 2;
        }
        const i64 first = session.operand_count();
        at = 0;
        while (at < count && session.good()) {
            const compiler_resolver::WorkRow row = session.work(from + at);
            put(session, OperandRole::ClassNominalId, row.word(0));
            at = at + 1;
        }
        session.truncate_work(base);
        const i64 prefix = session.operand_count();
        put_slice(session, OperandRole::InitialLayoutSymbols, first, count);
        return record(session, RecordKind::InitialLayoutOrder, prefix, 1);
    }
    // Publishes the whole prelude from the host limits and the seeded catalog.
    // Copied classes have at most 512 byte, 64 other and 513 total leaves in
    // 520 bytes; class arrays hold at most 512 bytes or 64 scalars. Mode 1 lints.
    auto begin_lowering(compiler_resolver::Session& session, i64 mode) -> i64 {
        if (!session.reserve_diagnostic_payload()) {
            return -1;
        }
        if (mode < 0 || mode > 1) {
            return setup_invalid(session);
        }
        const i64 groups = compiler_catalog::service_groups(compiler_resolver::family_seeded(session, 1),
            compiler_resolver::family_seeded(session, 2), compiler_resolver::family_seeded(session, 3));
        const i64 begin = session.operand_count();
        put(session, OperandRole::MaximumCopiedByteLeaves, 512);
        put(session, OperandRole::MaximumCopiedNonByteLeaves, 64);
        put(session, OperandRole::MaximumCopiedLeaves, 513);
        put(session, OperandRole::MaximumCopiedBytes, 520);
        put(session, OperandRole::MaximumByteArrayLength, 512);
        put(session, OperandRole::MaximumScalarArrayLength, 64);
        put(session, OperandRole::AnalysisMode, mode);
        put(session, OperandRole::SupportedServiceGroups, groups);
        const i64 configuration = record(session, RecordKind::Configuration, begin, 8);
        i64 at = 0;
        while (at < compiler_catalog::scalar_count() && session.good()) {
            seed_scalar(session, at);
            at = at + 1;
        }
        at = 0;
        while (at < compiler_catalog::operation_count() && session.good()) {
            if (active_service_operation(groups, at)) {
                seed_service(session, at);
            }
            at = at + 1;
        }
        if (seed_layout_order(session) != lowering_prelude_rows(session) - 1 || !session.good()) {
            return setup_invalid(session);
        }
        return configuration;
    }
    auto configured(compiler_resolver::Session& session) -> bool {
        if (!session.good() || session.output_count() < 2) {
            setup_invalid(session);
            return false;
        }
        const OutputRow row = session.view_output(1);
        if (row.kind() != RecordKind::Configuration || row.operand_count() != 8 || session.output_count()
            != lowering_prelude_rows(session)) {
            setup_invalid(session);
            return false;
        }
        return true;
    }
    auto configured_limit(compiler_resolver::Session& session, OperandRole role) -> i64 {
        const OutputRow row = session.view_output(1);
        if (row.kind() != RecordKind::Configuration || row.operand_count() != 8) {
            return setup_invalid(session);
        }
        return record_signed(session, 1, role);
    }
    auto scalar_descriptor_row(compiler_resolver::Session& session, compiler_resolver::ResolvedTypeKind kind) -> i64 {
        i64 at = 0;
        while (at < compiler_catalog::scalar_count()) {
            if (kind == compiler_catalog::scalar_kind(at)) {
                return at + 2;
            }
            at = at + 1;
        }
        return setup_invalid(session);
    }
    auto scalar_descriptor(compiler_resolver::Session& session, compiler_resolver::ResolvedTypeKind kind) -> i64 {
        const i64 row = scalar_descriptor_row(session, kind);
        return record_signed(session, row, OperandRole::PublicDescriptorId);
    }
    auto scalar_descriptor_size(compiler_resolver::Session& session, compiler_resolver::ResolvedTypeKind kind) -> i64 {
        const i64 row = scalar_descriptor_row(session, kind);
        return record_signed(session, row, OperandRole::Size);
    }
    auto service_contract(compiler_resolver::Session& session, i64 ordinal) -> i64 {
        if (ordinal < 0 || ordinal >= service_contract_count(session) || session.output_count()
            < lowering_prelude_rows(session)) {
            return setup_invalid(session);
        }
        return ordinal + 9;
    }
    auto service_group_supported(compiler_resolver::Session& session, i64 first, i64 second) -> bool {
        if (first < 0 || first > 5 || second < -1 || second > 5) {
            setup_invalid(session);
            return false;
        }
        u64 group = 1u64 << first;
        if (second >= 0) {
            group = group | (1u64 << second);
        }
        const i64 allowed = configured_limit(session, OperandRole::SupportedServiceGroups);
        if (!valid_service_groups(allowed)) {
            setup_invalid(session);
            return false;
        }
        return (u64(allowed) & (1u64 << i64(group))) != 0u64;
    }
    auto initial_layout_count(compiler_resolver::Session& session) -> i64 {
        const i64 layout = lowering_prelude_rows(session) - 1;
        const OperandRow order = record_slice(session, layout, OperandRole::InitialLayoutSymbols);
        return order.count();
    }
    auto initial_layout_symbol(compiler_resolver::Session& session, i64 ordinal) -> i64 {
        const i64 layout = lowering_prelude_rows(session) - 1;
        const OperandRow order = record_slice(session, layout, OperandRole::InitialLayoutSymbols);
        if (ordinal < 0 || ordinal >= order.count()) {
            return setup_invalid(session);
        }
        const OperandRow entry = session.view_operand(order.begin() + ordinal);
        if (entry.role() != OperandRole::ClassNominalId || entry.signed_value() < 0) {
            return setup_invalid(session);
        }
        return entry.signed_value();
    }
}
