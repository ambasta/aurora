export module aurora.compiler.x86_module;
import aurora.compiler.x86_storage;
import aurora.compiler.x86_object_storage;
import aurora.compiler.x86_helpers;
import aurora.compiler.x86_scalar;
import aurora.compiler.x86_objects;
import aurora.compiler.x86_resources;
import aurora.compiler.x86_facts;
import aurora.compiler.ir_instruction_storage;
import aurora.compiler.ir_instructions;
import aurora.compiler.ir_metadata_storage;
import aurora.compiler.ir_metadata;

// The module owner visits retained durable instruction IDs in their admitted
// order. All instruction text and stack/ABI policy stays in Aurora; the host
// receives bounded completed-artifact chunks only after sticky success.
export namespace compiler_x86 {
    auto module_form(const compiler_ir_instructions::InstructionStore& s, i64 instruction) -> i64 {
        if (instruction <= 0) {
            return -1;
        }
        const compiler_ir_instructions::RawInstructionRow row = s.instruction_at(instruction);
        return row.form();
    }
    auto module_instruction(const compiler_ir_instructions::InstructionStore& s, i64 callable, i64 position) -> i64 {
        const compiler_ir_instructions::BodyRow body = s.body_at(callable);
        if (position < 0 || position >= body.count()) {
            return -1;
        }
        const compiler_ir_instructions::CodeRow row = s.code_at(body.begin() + position);
        return row.id();
    }
    auto module_private_type(const compiler_ir_metadata::MetadataStore& m, i64 type) -> bool {
        const i64 kind = type_kind(m, type);
        if (kind == 12 || kind == 13 || kind == 17) {
            return true;
        }
        return kind == 5 && owning_class(m, type_class(m, type));
    }
    auto module_resource_graph(const EmitWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s) -> bool {
        i64 at = 0;
        while (at < m.class_count()) {
            if (owning_class(m, at)) {
                return true;
            }
            at = at + 1;
        }
        at = 0;
        while (at < w.retained_count()) {
            const i64 callable = w.retained_at(at);
            if (module_private_type(m, result_type(m, callable))) {
                return true;
            }
            if (has_receiver(m, callable) && owning_class(m, receiver_class(m, callable))) {
                return true;
            }
            i64 parameter = 0;
            while (parameter < parameter_count(m, callable)) {
                if (module_private_type(m, parameter_type(m, callable, parameter))) {
                    return true;
                }
                parameter = parameter + 1;
            }
            const compiler_ir_instructions::BodyRow body = s.body_at(callable);
            i64 position = 0;
            while (position < body.count()) {
                const i64 form = module_form(s, module_instruction(s, callable, position));
                if (form == 60 || form == 75 || form == 77 || form == 78 || form == 79 || form == 80) {
                    return true;
                }
                position = position + 1;
            }
            at = at + 1;
        }
        return false;
    }
    auto module_service_graph(const EmitWorkspace& w, const compiler_ir_metadata::MetadataStore& m) -> bool {
        i64 at = 0;
        while (at < w.retained_count()) {
            const i64 callable = w.retained_at(at);
            i64 parameter = 0;
            while (parameter < parameter_count(m, callable)) {
                const i64 kind = type_kind(m, parameter_type(m, callable, parameter));
                if (service_type_kind(kind)) {
                    return true;
                }
                parameter = parameter + 1;
            }
            at = at + 1;
        }
        return false;
    }
    auto module_hidden_symbol(const compiler_ir_metadata::MetadataStore& m, i64 callable) -> bool {
        const compiler_ir_metadata::CallableRow row = m.callable_at(callable);
        return compiler_ir_metadata::name_prefix(m, row.name(), "__au_o_");
    }
    auto module_emit_instruction(EmitWorkspace& w, ObjectWorkspace& o, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 instruction, i64 position) -> bool {
        i64 control = position;
        if (o.object_mode()) {
            const compiler_ir_instructions::BodyRow body = s.body_at(w.current_callable());
            if (position < 0 || position >= body.count()) {
                return w.fail();
            }
            const compiler_ir_instructions::CodeRow code = s.code_at(body.begin() + position);
            if (code.id() != instruction) {
                return w.fail();
            }
            const i64 form = module_form(s, instruction);
            if (form == 41 || form == 42) {
                control = code.target();
                if (control < 0 || control >= body.count()) {
                    return w.fail();
                }
            }
        }
        if (emit_scalar(w, o, m, s, instruction, control)) {
            return w.ok();
        }
        if (emit_objects(w, o, m, s, instruction)) {
            return w.ok();
        }
        if (emit_resources(w, o, m, s, instruction)) {
            return w.ok();
        }
        return w.fail();
    }
    auto module_plain_load(i64 form) -> bool {
        return form == 5 || form == 6 || form == 7 || form == 32;
    }
    auto module_popped_binary(i64 form) -> bool {
        return form == 12 || form == 14;
    }
    auto module_emit_body(EmitWorkspace& w, ObjectWorkspace& o, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 callable) -> bool {
        const compiler_ir_instructions::BodyRow body = s.body_at(callable);
        w.set_direct_result(false);
        w.set_left_in_rcx(false);
        i64 at = 0;
        while (at < body.count() && w.ok()) {
            const i64 current = module_instruction(s, callable, at);
            const i64 next = module_instruction(s, callable, at + 1);
            const i64 following = module_instruction(s, callable, at + 2);
            const i64 form = module_form(s, current);
            const i64 next_form = module_form(s, next);
            i64 last = current;
            if (following > 0 && form == 9 && fusable_binary(m, s, next, following)) {
                // The left value stays in %rax and the right is an operand.
                emit_fused_binary(w, o, m, s, next, following);
                last = following;
                at = at + 3;
            } else {
                if (following > 0 && form == 9 && module_plain_load(next_form) && module_popped_binary(module_form(s,
                    following))) {
                    // The intervening accumulator load touches neither RCX nor the
                    // operand stack; preserve the old adjacency-only peephole.
                    emit_mov_rr(w, o, Register::rax, Register::rcx);
                    module_emit_instruction(w, o, m, s, next, at + 1);
                    w.set_left_in_rcx(true);
                    module_emit_instruction(w, o, m, s, following, at + 2);
                    w.set_left_in_rcx(false);
                    last = following;
                    at = at + 3;
                } else {
                    if (form == 63 && next_form == 44 && operand_value(s, next, 0) == operand_value(s, current, 2)) {
                        const i64 result = result_type(m, callable);
                        const i64 source = operand_value(s, current, 0);
                        const i64 field = operand_value(s, current, 1);
                        if (class_size(m, type_class(m, result)) != owner_element_stride(m, callable, source, field)) {
                            return w.fail();
                        }
                        w.set_direct_result(true);
                        module_emit_instruction(w, o, m, s, current, at);
                        w.set_direct_result(false);
                        emit_alu_rr(w, o, AluOp::bit_xor, Register::rax, Register::rax);
                        emit_branch(w, o, -1, 1, 0);
                        at = at + 2;
                    } else {
                        module_emit_instruction(w, o, m, s, current, at);
                        at = at + 1;
                    }
                }
            }
            const i64 branch = module_instruction(s, callable, at);
            if (module_form(s, last) == 14 && module_form(s, branch) == 42) {
                i64 target = operand_value(s, branch, 0);
                if (o.object_mode()) {
                    const compiler_ir_instructions::CodeRow code = s.code_at(body.begin() + at);
                    target = code.target();
                    if (code.id() != branch || target < 0 || target >= body.count()) {
                        return w.fail();
                    }
                }
                fused_branch(w, o, m, s, last, target);
                at = at + 1;
            }
        }
        return w.ok();
    }
    // Scalar operands, list entries included, that lie in the frame extent
    // (low, high]. Constants, type identities and byte slices are never offsets,
    // so an unrelated equal value only makes a caller conservative.
    auto module_operand_mentions(const compiler_ir_instructions::InstructionStore& s, i64 instruction, i64 low,
        i64 high) -> i64 {
        const compiler_ir_instructions::RawInstructionRow row = s.instruction_at(instruction);
        i64 count = 0;
        i64 at = 0;
        while (at < row.operand_count()) {
            const compiler_ir_instructions::RawOperandRow operand = s.operand_at(row.operand_begin() + at);
            const i64 role = operand.role();
            if (compiler_ir_instructions::list_role(role)) {
                i64 item = 0;
                while (item < operand.count()) {
                    const compiler_ir_instructions::RawOperandRow entry = s.operand_at(operand.begin() + item);
                    if (entry.signed_value() > low && entry.signed_value() <= high) {
                        count = count + 1;
                    }
                    item = item + 1;
                }
            } else {
                if (role != 10 && role != 11 && role != 33 && role != 100 && role != 101
                    && !compiler_ir_instructions::type_role(role) && operand.signed_value() > low
                    && operand.signed_value() <= high) {
                    count = count + 1;
                }
            }
            at = at + 1;
        }
        return count;
    }
    // Whether an instruction ends the span or makes it a new capability.
    auto module_rewrites_span(const compiler_ir_instructions::InstructionStore& s, i64 instruction, i64 span) -> bool {
        const compiler_ir_instructions::RawInstructionRow row = s.instruction_at(instruction);
        if (row.form() == 56 || row.form() == 59) {
            return operand_value(s, instruction, 0) == span || operand_value(s, instruction, 1) == span;
        }
        i64 at = 0;
        while (at < row.operand_count()) {
            const compiler_ir_instructions::RawOperandRow operand = s.operand_at(row.operand_begin() + at);
            if (operand.role() == 6 && operand.signed_value() == span) {
                return true;
            }
            at = at + 1;
        }
        return false;
    }
    auto module_const_method(const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 instruction) -> bool {
        const compiler_ir_metadata::FlagMasks masks = compiler_ir_metadata::FlagMasks();
        const i64 target = instruction_target(m, s, instruction);
        if (target < 0 || !has_receiver(m, target)) {
            return false;
        }
        const compiler_ir_metadata::CallableRow declaration = m.callable_at(target);
        const compiler_ir_metadata::ReceiverShape receiver = declaration.first_receiver();
        return declaration.borrowed_root_count() == 0 && !compiler_ir_metadata::receiver_flag(receiver,
            masks.receiver_mutable()) && !compiler_ir_metadata::receiver_flag(receiver, masks.receiver_constructor());
    }
    // A typed span element can be read in place, without copying it into its
    // object, when every condition below holds; the verifier still checks the
    // copying program. The object is an immutable slot filled only by this
    // SpanValuesLoad and otherwise only begun, ended or the sole receiver of
    // const methods, which cannot write a receiver or keep its address. From the
    // load to the last use the span is neither ended nor rebound and that range is
    // entered only through the load, so the span stays live there; a live span
    // freezes its owner, so the element is unchanged at every use.
    auto module_elidable(const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 callable, i64 position, i64 span, i64 object) -> bool {
        const i64 index = compiler_ir_instructions::entry_slot(m, callable, 11, object);
        if (index < 0) {
            return false;
        }
        const compiler_ir_metadata::SlotRow slot = m.slot_at(index);
        const i64 size = class_size(m, slot_class(m, callable, object));
        if (slot.mutable_value() != 0 || size < 8 || size > object) {
            return false;
        }
        const i64 low = object - size;
        const compiler_ir_instructions::BodyRow body = s.body_at(callable);
        i64 last = -1;
        i64 at = 0;
        while (at < body.count()) {
            const i64 instruction = module_instruction(s, callable, at);
            const i64 form = module_form(s, instruction);
            const i64 mentions = module_operand_mentions(s, instruction, low, object);
            if (mentions != 0) {
                bool allowed = mentions == 1 && at == position;
                if (mentions == 1 && (form == 21 || form == 23) && operand_value(s, instruction, 0) == object) {
                    allowed = true;
                }
                if (mentions == 1 && form == 38 && operand_value(s, instruction, 1) == object && operand_value(s,
                    instruction, 4) == -1 && module_const_method(m, s, instruction) && at > position) {
                    allowed = true;
                    last = at;
                }
                if (!allowed) {
                    return false;
                }
            }
            at = at + 1;
        }
        if (last < 0) {
            return false;
        }
        at = position + 1;
        while (at <= last) {
            if (module_rewrites_span(s, module_instruction(s, callable, at), span)) {
                return false;
            }
            at = at + 1;
        }
        // Every jump into (position, last] starts inside [position, last].
        at = 0;
        while (at < body.count()) {
            const i64 instruction = module_instruction(s, callable, at);
            const i64 form = module_form(s, instruction);
            if ((form == 41 || form == 42) && (at < position || at > last)) {
                const i64 label = operand_value(s, instruction, 0);
                i64 inside = position + 1;
                while (inside <= last) {
                    const i64 candidate = module_instruction(s, callable, inside);
                    if (module_form(s, candidate) == 40 && operand_value(s, candidate, 0) == label) {
                        return false;
                    }
                    inside = inside + 1;
                }
            }
            at = at + 1;
        }
        return true;
    }
    // Elided objects are recorded with the loans under negated offsets; loan
    // identities are positive.
    auto module_elide_span_objects(EmitWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 callable) -> bool {
        const compiler_ir_instructions::BodyRow body = s.body_at(callable);
        i64 at = 0;
        while (at < body.count() && w.ok()) {
            const i64 load = module_instruction(s, callable, at);
            if (module_form(s, load) == 84) {
                const i64 span = operand_value(s, load, 0);
                const i64 object = operand_value(s, load, 1);
                if (object > 0 && module_elidable(m, s, callable, at, span, object)) {
                    w.add_loan(0 - object, span);
                }
            }
            at = at + 1;
        }
        return w.ok();
    }
    auto module_emit_callable(EmitWorkspace& w, ObjectWorkspace& o, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 callable, bool force_local) -> bool {
        const compiler_ir_metadata::CallableRow declaration = m.callable_at(callable);
        const compiler_ir_instructions::BodyRow body = s.body_at(callable);
        const i64 declared = declaration.frame_bytes();
        const i64 roots = declaration.borrowed_root_count();
        const bool receiver = has_receiver(m, callable);
        const bool aggregate = aggregate_signature(m, callable);
        // Independent backend backstop: multiple borrowed roots admit only
        // scalar/enum value tails and results, never aggregate/private records.
        if (roots > 1 && aggregate) {
            return w.fail();
        }
        if (!w.begin_function(0, callable, callable)) {
            return false;
        }
        i64 at = 0;
        while (at < body.count()) {
            const i64 instruction = module_instruction(s, callable, at);
            if (module_form(s, instruction) == 1) {
                w.add_loan(operand_value(s, instruction, 0), operand_value(s, instruction, 1));
            }
            at = at + 1;
        }
        if (!module_elide_span_objects(w, m, s, callable)) {
            return false;
        }
        const bool local = force_local || receiver || aggregate || module_hidden_symbol(m, callable);
        if (o.object_mode()) {
            o.begin_function_labels(body.count());
            o.begin_object_symbol(0, callable, local);
            callable_name(w, o, m, callable);
            o.end_object_symbol_name();
        } else {
            if (local) {
                w.text(".local ");
            } else {
                w.text(".globl ");
            }
            callable_name(w, o, m, callable);
            w.text("\n.type ");
            callable_name(w, o, m, callable);
            w.text(", @function\n");
            callable_name(w, o, m, callable);
            w.text(":\n");
        }
        emit_push_register(w, o, Register::rbp);
        w.grow_stack(8);
        emit_mov_rr(w, o, Register::rsp, Register::rbp);
        i64 receiver_save = 0;
        if (receiver) {
            receiver_save = declared + 8;
        }
        const bool resource_parameters = parameter_count(m, callable) != 0 && type_kind(m, parameter_type(m, callable,
            0)) == 12;
        bool packed = aggregate;
        if (receiver) {
            packed = class_parameters(m, callable) || resource_parameters;
        }
        if (packed) {
            w.record_signature(copied_record_bytes(m, callable), service_record_bytes(m, callable));
        }
        const i64 result_kind = type_kind(m, result_type(m, callable));
        const bool combined = receiver && packed && (result_kind == 5 || span_kind(result_kind));
        i64 record_save = 0;
        if (packed) {
            record_save = declared + 8;
            if (receiver) {
                record_save = declared + 16;
            }
        }
        i64 result_save = 0;
        if (result_kind == 5 || span_kind(result_kind) || result_kind == 13 || result_kind == 17) {
            result_save = declared + 16;
            if (combined) {
                result_save = declared + 24;
            }
        }
        w.set_saves(receiver_save, record_save, result_save);
        i64 frame = declared;
        if (roots > 1) {
            frame = frame + ((roots * 8 + 15) / 16) * 16;
        } else {
            if (combined) {
                frame = frame + 32;
            } else {
                if (receiver || aggregate) {
                    frame = frame + 16;
                }
            }
        }
        emit_reserve_stack(w, o, frame);
        if (roots > 1) {
            i64 ordinal = 1;
            while (ordinal < roots) {
                const i64 root_address = w.pack_address(2, ordinal * 8);
                emit_load(w, o, root_address, Register::r11, false);
                const i64 save = root_save_offset(w, m, ordinal);
                emit_store(w, o, Register::r11, save, false);
                ordinal = ordinal + 1;
            }
            const i64 first_root = w.pack_address(2, 0);
            emit_load(w, o, first_root, Register::r10, false);
        }
        if (receiver) {
            const i64 save = root_save_offset(w, m, 0);
            emit_store(w, o, Register::r10, save, false);
        }
        if (packed) {
            emit_store(w, o, Register::r11, record_save, false);
        }
        if (result_save != 0) {
            if (combined) {
                emit_store(w, o, Register::rax, result_save, false);
            } else {
                if (receiver) {
                    emit_store(w, o, Register::r11, result_save, false);
                } else {
                    emit_store(w, o, Register::r10, result_save, false);
                }
            }
        }
        if (!module_emit_body(w, o, m, s, callable)) {
            return false;
        }
        if (w.stack_depth() != 0 || w.live_stack() != frame + 16) {
            return w.fail();
        }
        emit_bind_label(w, o, 1, 0);
        emit_leave_instruction(w, o);
        emit_return_instruction(w, o);
        if (o.object_mode()) {
            o.end_object_symbol();
        } else {
            w.text(".size ");
            callable_name(w, o, m, callable);
            w.text(", .-");
            callable_name(w, o, m, callable);
            w.end_line();
        }
        return w.finish_function();
    }
    auto module_reflection_referenced(const EmitWorkspace& w, const compiler_ir_instructions::InstructionStore& s,
        i64 scope, i64 query) -> bool {
        i64 at = 0;
        while (at < w.retained_count()) {
            const i64 callable = w.retained_at(at);
            const compiler_ir_instructions::BodyRow body = s.body_at(callable);
            i64 position = 0;
            while (position < body.count()) {
                const i64 instruction = module_instruction(s, callable, position);
                const compiler_ir_instructions::RawInstructionRow row = s.instruction_at(instruction);
                if (row.form() == 39 && row.query() == query && operand_value(s, instruction, 0) == scope) {
                    return true;
                }
                position = position + 1;
            }
            at = at + 1;
        }
        return false;
    }
    auto module_descriptor_value(const compiler_ir_metadata::MetadataStore& m, i64 id, i64 query) -> i64 {
        i64 begin = 0;
        i64 end = m.descriptor_count();
        while (begin < end) {
            const i64 middle = begin + (end - begin) / 2;
            const compiler_ir_metadata::DescriptorRow row = m.descriptor_at(middle);
            if (row.id() == id) {
                if (query == 0) {
                    return row.size();
                }
                return row.public_fields();
            }
            if (row.id() < id) {
                begin = middle + 1;
            } else {
                end = middle;
            }
        }
        return -1;
    }
    auto module_scope_label(EmitWorkspace& w, ObjectWorkspace& o, i64 scope, i64 query, i64 id) -> bool {
        w.text(".Lscope");
        w.number(scope);
        if (query == 0) {
            w.text("_size");
        } else {
            w.text("_field_count");
        }
        return w.number(id);
    }
    auto module_emit_reflection(EmitWorkspace& w, ObjectWorkspace& o, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 binding, i64 reflection) -> bool {
        i64 at = 0;
        while (at < m.view_count() && w.ok()) {
            const compiler_ir_metadata::ViewRow view = m.view_at(at);
            const compiler_ir_metadata::IndexRange ids = view.descriptors();
            const i64 scope = view.scope();
            i64 query = 0;
            while (query < 2 && w.ok()) {
                if (reflection == 0 || module_reflection_referenced(w, s, scope, query)) {
                    if (!w.begin_function(1, scope * 2 + query, -1)) {
                        return false;
                    }
                    if (o.object_mode()) {
                        o.begin_function_labels(ids.count());
                        o.begin_object_symbol(4, scope * 2 + query, binding == 1);
                        query_name(w, o, query, scope);
                        o.end_object_symbol_name();
                        emit_object_status(w, o);
                    } else {
                        if (binding == 1) {
                            w.text(".local ");
                        } else {
                            w.text(".globl ");
                        }
                        query_name(w, o, query, scope);
                        w.text("\n.type ");
                        query_name(w, o, query, scope);
                        w.text(", @function\n");
                        query_name(w, o, query, scope);
                        w.text(":\n");
                    }
                    i64 entry = 0;
                    while (entry < ids.count()) {
                        const compiler_ir_metadata::IndexRow row = m.index_at(ids.begin() + entry);
                        const i64 id = row.value();
                        emit_alu_imm(w, o, AluOp::compare, id, Register::rdi);
                        if (o.object_mode()) {
                            emit_branch(w, o, 4, 0, entry);
                        } else {
                            w.text("    je ");
                            module_scope_label(w, o, scope, query, id);
                            w.end_line();
                        }
                        entry = entry + 1;
                    }
                    emit_alu_rr(w, o, AluOp::bit_xor, Register::rax, Register::rax);
                    emit_return_instruction(w, o);
                    entry = 0;
                    while (entry < ids.count()) {
                        const compiler_ir_metadata::IndexRow row = m.index_at(ids.begin() + entry);
                        const i64 id = row.value();
                        const i64 value = module_descriptor_value(m, id, query);
                        if (value < 0) {
                            return w.fail();
                        }
                        if (o.object_mode()) {
                            emit_bind_label(w, o, 0, entry);
                        } else {
                            module_scope_label(w, o, scope, query, id);
                            w.text(":\n");
                        }
                        emit_mov_imm(w, o, value, Register::rax);
                        emit_return_instruction(w, o);
                        entry = entry + 1;
                    }
                    if (o.object_mode()) {
                        o.end_object_symbol();
                        emit_object_status(w, o);
                    } else {
                        w.text(".size ");
                        query_name(w, o, query, scope);
                        w.text(", .-");
                        query_name(w, o, query, scope);
                        w.end_line();
                    }
                }
                query = query + 1;
            }
            at = at + 1;
        }
        return w.ok();
    }
    auto module_emit_literals(EmitWorkspace& w, ObjectWorkspace& o,
        const compiler_ir_instructions::InstructionStore& s) -> bool {
        bool section = false;
        i64 at = 0;
        while (at < w.retained_count() && w.ok()) {
            const i64 callable = w.retained_at(at);
            const compiler_ir_instructions::BodyRow body = s.body_at(callable);
            i64 position = 0;
            while (position < body.count() && w.ok()) {
                const i64 instruction = module_instruction(s, callable, position);
                if (module_form(s, instruction) == 51) {
                    if (o.object_mode()) {
                        o.begin_literal(instruction);
                    } else {
                        if (!section) {
                            w.text(".section .rodata\n");
                            section = true;
                        }
                        w.text(".Laurora_literal_");
                        w.number(instruction);
                        w.text(":\n");
                    }
                    const compiler_ir_instructions::RawOperandRow literal = compiler_ir_instructions::call_operand(s,
                        instruction, 0);
                    i64 byte = 0;
                    while (byte < literal.count() && w.ok()) {
                        if (o.object_mode()) {
                            const i64 value = s.literal_at(literal.begin() + byte);
                            if (value < 0 || value > 255) {
                                return w.fail();
                            }
                            o.literal_byte(u8(value));
                            emit_object_status(w, o);
                        } else {
                            w.line_number(".byte ", s.literal_at(literal.begin() + byte), "");
                        }
                        byte = byte + 1;
                    }
                    if (o.object_mode()) {
                        o.end_literal();
                        emit_object_status(w, o);
                    }
                }
                position = position + 1;
            }
            at = at + 1;
        }
        return w.ok();
    }
    // The hosted process entry `_start`, emitted for a root-module hosted main.
    // The Linux initial stack holds argc, then argv; the argument strings form
    // one contiguous block of NUL-terminated bytes (each argv[i] must follow the
    // previous string's NUL, or the entry traps), which main receives as its
    // readonly `arguments` span. The zeroed session block below the record is
    // the HostFiles grant. host::start first replaces closed standard streams
    // (a failure exits 1 without main); after main, host::finish discards
    // uncommitted outputs and closes descriptors; exit_group reports the
    // HostExit ordinal (success 0, failure 1, usage 2). No C runtime or loader
    // code is involved.
    //
    // When main also takes a region, the block holds the memory runtime's
    // mapping table and the session's own address after the session, the
    // region is that address, host_memory::start maps the runtime's state
    // after host::start (a failure exits 1 without main) and
    // host_memory::finish checks after main that no allocation is live.
    auto module_emit_hosted_entry(EmitWorkspace& w, ObjectWorkspace& o,
        const compiler_ir_metadata::MetadataStore& m) -> bool {
        const i64 entry = hosted_entry(m);
        if (entry < 0) {
            return w.ok();
        }
        const i64 start = hosted_hook_callable(m, 0);
        const i64 finish = hosted_hook_callable(m, 1);
        if (start < 0 || finish < 0) {
            return w.fail();
        }
        const bool memory = w.hosted_memory();
        const i64 memory_start = memory_hook_callable(m, 0);
        const i64 memory_finish = memory_hook_callable(m, 1);
        if (memory && (memory_start < 0 || memory_finish < 0)) {
            return w.fail();
        }
        const i64 name = w.intern_runtime("_start");
        if (!w.begin_function(2, name, -1)) {
            return false;
        }
        if (o.object_mode()) {
            o.begin_function_labels(4);
            // _start follows the 512 reflection query identities.
            o.begin_object_symbol(4, 512, false);
            o.object_name_text("_start");
            o.end_object_symbol_name();
            emit_object_status(w, o);
        } else {
            w.text(".globl _start\n.type _start, @function\n_start:\n");
        }
        emit_alu_rr(w, o, AluOp::bit_xor, Register::rbp, Register::rbp);
        const i64 argc = w.pack_address(1, 0);
        emit_load(w, o, argc, Register::rcx, false);
        const i64 argv = w.pack_address(1, 8);
        emit_lea(w, o, argv, Register::rsi);
        emit_alu_rr(w, o, AluOp::bit_xor, Register::rdx, Register::rdx);
        emit_alu_rr(w, o, AluOp::bit_xor, Register::r9, Register::r9);
        emit_alu_rr(w, o, AluOp::bit_xor, Register::r10, Register::r10);
        emit_alu_rr(w, o, AluOp::test, Register::rcx, Register::rcx);
        emit_branch(w, o, 4, 0, 1);
        // RDX stays zero as the index register; R8 walks the block.
        emit_indexed_load(w, o, Register::rsi, Register::rdx, indexed_address(1, 0), false);
        emit_mov_rr(w, o, Register::rax, Register::r9);
        emit_mov_rr(w, o, Register::rax, Register::r8);
        emit_bind_label(w, o, 0, 0);
        emit_indexed_load(w, o, Register::rsi, Register::rdx, indexed_address(1, 0), false);
        emit_alu_rr(w, o, AluOp::compare, Register::rax, Register::r8);
        emit_branch(w, o, 5, 4, 0);
        emit_bind_label(w, o, 0, 2);
        emit_indexed_load(w, o, Register::r8, Register::rdx, indexed_address(1, 0), true);
        emit_alu_imm(w, o, AluOp::add, 1, Register::r8);
        emit_alu_rr(w, o, AluOp::test, Register::rax, Register::rax);
        emit_branch(w, o, 5, 0, 2);
        emit_alu_imm(w, o, AluOp::add, 8, Register::rsi);
        emit_alu_imm(w, o, AluOp::subtract, 1, Register::rcx);
        emit_branch(w, o, 5, 0, 0);
        emit_mov_rr(w, o, Register::r8, Register::r10);
        emit_alu_rr(w, o, AluOp::subtract, Register::r9, Register::r10);
        emit_bind_label(w, o, 0, 1);
        // R9 is the block address and R10 its length (both zero without argv).
        emit_alu_imm(w, o, AluOp::bit_and, -16, Register::rsp);
        i64 session = host_session_bytes();
        if (memory) {
            session = host_memory_block_bytes();
        }
        emit_reserve_stack(w, o, session);
        emit_mov_rr(w, o, Register::rsp, Register::rdi);
        emit_alu_rr(w, o, AluOp::bit_xor, Register::rax, Register::rax);
        emit_mov_imm(w, o, session, Register::rcx);
        emit_cld(w, o);
        emit_rep_stosb(w, o);
        emit_mov_rr(w, o, Register::rsp, Register::r8);
        // Private record: grant, generation, [region,] then the 56-byte
        // arguments span; the exit status follows it.
        i64 span = 16;
        i64 record = 80;
        if (memory) {
            const i64 self = w.pack_address(1, host_session_self());
            emit_store(w, o, Register::r8, self, false);
            span = 24;
            record = 96;
        }
        emit_reserve_stack(w, o, record);
        const i64 grant = w.pack_address(1, 0);
        emit_store(w, o, Register::r8, grant, false);
        const i64 generation = w.pack_address(1, 8);
        emit_store_imm(w, o, 1, generation, false);
        i64 word = 16;
        while (word < span + 56) {
            const i64 lane = w.pack_address(1, word);
            emit_store_imm(w, o, 0, lane, false);
            word = word + 8;
        }
        if (memory) {
            const i64 region = w.pack_address(1, 16);
            emit_store(w, o, Register::r8, region, false);
        }
        const i64 address = w.pack_address(1, span + 8);
        emit_store(w, o, Register::r9, address, false);
        const i64 length = w.pack_address(1, span + 48);
        emit_store(w, o, Register::r10, length, false);
        const i64 status = w.pack_address(1, span + 56);
        emit_store_imm(w, o, 1, status, false);
        emit_mov_rr(w, o, Register::rsp, Register::r11);
        direct_target(w, o, m, start);
        emit_alu_rr(w, o, AluOp::test, Register::rax, Register::rax);
        emit_branch(w, o, 5, 0, 3);
        if (memory) {
            emit_mov_rr(w, o, Register::rsp, Register::r11);
            direct_target(w, o, m, memory_start);
            emit_alu_rr(w, o, AluOp::test, Register::rax, Register::rax);
            emit_branch(w, o, 5, 0, 3);
        }
        emit_mov_rr(w, o, Register::rsp, Register::r11);
        direct_target(w, o, m, entry);
        emit_alu_imm(w, o, AluOp::compare, 2, Register::rax);
        emit_branch(w, o, 7, 4, 0);
        emit_store(w, o, Register::rax, status, false);
        if (memory) {
            emit_mov_rr(w, o, Register::rsp, Register::r11);
            direct_target(w, o, m, memory_finish);
            emit_alu_rr(w, o, AluOp::test, Register::rax, Register::rax);
            emit_branch(w, o, 5, 4, 0);
        }
        emit_bind_label(w, o, 0, 3);
        emit_mov_rr(w, o, Register::rsp, Register::r11);
        direct_target(w, o, m, finish);
        emit_load(w, o, status, Register::rdi, false);
        emit_mov_imm(w, o, 231, Register::rax);
        const i64 marker = w.intern_runtime("__au_linux_system_call");
        w.record_call(2, marker);
        emit_system_call(w, o);
        emit_trap_instruction(w, o);
        if (o.object_mode()) {
            o.end_object_symbol();
        } else {
            w.text(".size _start, .-_start\n");
        }
        if (!w.finish_function() || !memory) {
            return w.ok();
        }
        return module_emit_memory_entries(w, o, m);
    }
    // The byte runtime entries of a hosted program with a region: the private
    // C-convention calls generated owner code makes (RDI, RSI, RDX, RCX, R8;
    // result in RAX), bound locally to these definitions. Each checks that the
    // descriptor's region word names the session, calls one host_memory
    // function with the session as the HostFiles grant and the descriptor's
    // words as scalars, traps on its fail-stop result (u64 max), and stores the
    // results or copies elements to and from the addresses it returns. The
    // frame keeps the five arguments at -8..-40(%rbp), three temporaries at
    // -48..-64 and the 64-byte record at 0(%rsp). The hot accesses (bytes at,
    // set and borrow_span, values at and set) first try an inline fast path
    // without a frame or call (memory_fast_owner) and take that ordinary path
    // only when it does not apply.
    // The runtime name SYMBOL, as object symbol-name or assembly text bytes.
    auto memory_entry_name(EmitWorkspace& w, ObjectWorkspace& o, i64 symbol) -> bool {
        const NameRow name = w.runtime_name(symbol);
        i64 at = 0;
        while (at < name.count() && w.ok()) {
            const i64 value = w.name_byte(name.begin() + at);
            if (o.object_mode()) {
                o.object_name_byte(u8(value));
            } else {
                w.byte(u8(value));
            }
            at = at + 1;
        }
        return w.ok();
    }
    // Begins entry SYMBOL with local labels 0..7, of which an inline fast path
    // takes 4..7 (label 7 is the ordinary path through the runtime).
    auto memory_entry_symbol(EmitWorkspace& w, ObjectWorkspace& o, i64 symbol) -> bool {
        if (symbol < 0 || !w.begin_function(2, symbol, -1)) {
            return w.fail();
        }
        if (o.object_mode()) {
            o.begin_function_labels(8);
            o.begin_object_symbol(1, symbol, true);
            memory_entry_name(w, o, symbol);
            o.end_object_symbol_name();
            emit_object_status(w, o);
        } else {
            w.text(".local ");
            memory_entry_name(w, o, symbol);
            w.text("\n.type ");
            memory_entry_name(w, o, symbol);
            w.text(", @function\n");
            memory_entry_name(w, o, symbol);
            w.text(":\n");
        }
        return w.ok();
    }
    // The entry's frame, which keeps the five arguments for the runtime call.
    auto memory_entry_frame(EmitWorkspace& w, ObjectWorkspace& o) -> bool {
        emit_push_register(w, o, Register::rbp);
        w.grow_stack(8);
        emit_mov_rr(w, o, Register::rsp, Register::rbp);
        emit_reserve_stack(w, o, 128);
        const i64 first = w.pack_address(0, 8);
        emit_store(w, o, Register::rdi, first, false);
        const i64 second = w.pack_address(0, 16);
        emit_store(w, o, Register::rsi, second, false);
        const i64 third = w.pack_address(0, 24);
        emit_store(w, o, Register::rdx, third, false);
        const i64 fourth = w.pack_address(0, 32);
        emit_store(w, o, Register::rcx, fourth, false);
        const i64 fifth = w.pack_address(0, 40);
        return emit_store(w, o, Register::r8, fifth, false);
    }
    auto memory_entry_begin(EmitWorkspace& w, ObjectWorkspace& o, i64 symbol) -> bool {
        memory_entry_symbol(w, o, symbol);
        return memory_entry_frame(w, o);
    }
    auto memory_entry_end(EmitWorkspace& w, ObjectWorkspace& o, i64 symbol) -> bool {
        emit_leave_instruction(w, o);
        emit_return_instruction(w, o);
        if (o.object_mode()) {
            o.end_object_symbol();
        } else {
            w.text(".size ");
            memory_entry_name(w, o, symbol);
            w.text(", .-");
            memory_entry_name(w, o, symbol);
            w.text("\n");
        }
        return w.finish_function();
    }
    // Copies RCX bytes from RSI to RDI, RCX > 0: whole qwords when RCX is a
    // multiple of eight, else REP MOVSB, whose startup dominates the short
    // element copies of owner accesses. Clobbers RAX and RDX; uses local
    // labels FIRST, FIRST + 1 and FIRST + 2.
    auto memory_copy(EmitWorkspace& w, ObjectWorkspace& o, i64 first) -> bool {
        emit_alu_imm(w, o, AluOp::test, 7, Register::rcx);
        emit_branch(w, o, 5, 0, first + 1);
        emit_alu_rr(w, o, AluOp::bit_xor, Register::rdx, Register::rdx);
        emit_bind_label(w, o, 0, first);
        emit_indexed_load(w, o, Register::rsi, Register::rdx, indexed_address(1, 0), false);
        emit_indexed_store(w, o, Register::rdi, Register::rdx, indexed_address(1, 0), false);
        emit_alu_imm(w, o, AluOp::add, 8, Register::rdx);
        emit_alu_rr(w, o, AluOp::compare, Register::rcx, Register::rdx);
        emit_branch(w, o, 2, 0, first);
        emit_branch(w, o, -1, 0, first + 2);
        emit_bind_label(w, o, 0, first + 1);
        emit_cld(w, o);
        emit_rep_movsb(w, o);
        return emit_bind_label(w, o, 0, first + 2);
    }
    // The frame slot -SAVE(%rbp) into the record word at +OFFSET.
    auto memory_argument(EmitWorkspace& w, ObjectWorkspace& o, i64 save, i64 offset) -> bool {
        const i64 source = w.pack_address(0, save);
        emit_load(w, o, source, Register::rcx, false);
        const i64 lane = w.pack_address(1, offset);
        return emit_store(w, o, Register::rcx, lane, false);
    }
    // RAX = the region word in -SAVE(%rbp) (an owner's first word when OWNER),
    // which must name the session: the word at host_session_self() from it is
    // itself. The record gets the grant and generation 1, and an owner's
    // allocation, length and success words; R10 keeps the owner address.
    auto memory_record(EmitWorkspace& w, ObjectWorkspace& o, i64 save, bool owner) -> bool {
        const i64 source = w.pack_address(0, save);
        emit_load(w, o, source, Register::rax, false);
        if (owner) {
            emit_mov_rr(w, o, Register::rax, Register::r10);
            const i64 region = w.pack_address(2, 0);
            emit_load(w, o, region, Register::rax, false);
        }
        const i64 self = w.pack_address(4, host_session_self());
        emit_load(w, o, self, Register::rcx, false);
        emit_alu_rr(w, o, AluOp::compare, Register::rax, Register::rcx);
        emit_branch(w, o, 5, 4, 0);
        const i64 grant = w.pack_address(1, 0);
        emit_store(w, o, Register::rax, grant, false);
        const i64 generation = w.pack_address(1, 8);
        emit_store_imm(w, o, 1, generation, false);
        if (!owner) {
            return w.ok();
        }
        i64 word = 8;
        while (word < 32) {
            const i64 field = w.pack_address(2, word);
            emit_load(w, o, field, Register::rcx, false);
            const i64 lane = w.pack_address(1, word + 8);
            emit_store(w, o, Register::rcx, lane, false);
            word = word + 8;
        }
        return w.ok();
    }
    // Calls memory runtime function HOOK with the record and traps on its
    // fail-stop result.
    auto memory_call(EmitWorkspace& w, ObjectWorkspace& o, const compiler_ir_metadata::MetadataStore& m,
        i64 hook) -> bool {
        const i64 callable = memory_hook_callable(m, hook);
        if (callable < 0) {
            return w.fail();
        }
        emit_mov_rr(w, o, Register::rsp, Register::r11);
        direct_target(w, o, m, callable);
        emit_alu_imm(w, o, AluOp::compare, -1, Register::rax);
        return emit_branch(w, o, 4, 4, 0);
    }
    // R10 = the owner address in -SAVE(%rbp); RCX = its four words or-ed, so
    // the zero flag marks a pristine (all-zero) descriptor.
    auto memory_pristine(EmitWorkspace& w, ObjectWorkspace& o, i64 save) -> bool {
        const i64 source = w.pack_address(0, save);
        emit_load(w, o, source, Register::r10, false);
        const i64 region = w.pack_address(2, 0);
        emit_load(w, o, region, Register::rcx, false);
        i64 word = 8;
        while (word < 32) {
            const i64 field = w.pack_address(2, word);
            emit_alu_load(w, o, AluOp::bit_or, field, Register::rcx);
            word = word + 8;
        }
        return w.ok();
    }
    // Writes the descriptor at -SAVE(%rbp): the region word from -REGION(%rbp),
    // then the allocation id in RAX with the length in -LENGTH(%rbp) and
    // success 1, or zeros for a failed allocation (RAX zero).
    auto memory_descriptor(EmitWorkspace& w, ObjectWorkspace& o, i64 save, i64 region, i64 length) -> bool {
        const i64 target = w.pack_address(0, save);
        emit_load(w, o, target, Register::r10, false);
        const i64 source = w.pack_address(0, region);
        emit_load(w, o, source, Register::rcx, false);
        const i64 first = w.pack_address(2, 0);
        emit_store(w, o, Register::rcx, first, false);
        const i64 allocation = w.pack_address(2, 8);
        emit_store(w, o, Register::rax, allocation, false);
        emit_alu_rr(w, o, AluOp::bit_xor, Register::rdx, Register::rdx);
        emit_alu_rr(w, o, AluOp::test, Register::rax, Register::rax);
        emit_set_condition(w, o, 5, Register::rdx);
        const i64 success = w.pack_address(2, 24);
        emit_store(w, o, Register::rdx, success, false);
        emit_unary(w, o, UnaryOp::negate, Register::rdx);
        const i64 bytes = w.pack_address(0, length);
        emit_alu_load(w, o, AluOp::bit_and, bytes, Register::rdx);
        const i64 size = w.pack_address(2, 16);
        return emit_store(w, o, Register::rdx, size, false);
    }
    // Copies the element at -SOURCE(%rbp) to each stride (-24(%rbp)) bytes of
    // [RAX + -FROM(%rbp), RAX + -TO(%rbp)), with labels 0 and 1.
    auto memory_fill(EmitWorkspace& w, ObjectWorkspace& o, i64 source, i64 from, i64 to) -> bool {
        emit_mov_rr(w, o, Register::rax, Register::rdi);
        const i64 begin = w.pack_address(0, from);
        emit_alu_load(w, o, AluOp::add, begin, Register::rdi);
        emit_mov_rr(w, o, Register::rax, Register::rdx);
        const i64 end = w.pack_address(0, to);
        emit_alu_load(w, o, AluOp::add, end, Register::rdx);
        emit_cld(w, o);
        emit_bind_label(w, o, 0, 0);
        emit_alu_rr(w, o, AluOp::compare, Register::rdx, Register::rdi);
        emit_branch(w, o, 3, 0, 1);
        const i64 element = w.pack_address(0, source);
        emit_load(w, o, element, Register::rsi, false);
        const i64 stride = w.pack_address(0, 24);
        emit_load(w, o, stride, Register::rcx, false);
        emit_rep_movsb(w, o);
        emit_branch(w, o, -1, 0, 0);
        return emit_bind_label(w, o, 0, 1);
    }
    // -SAVE(%rbp) = count (-16(%rbp)) * stride (-24(%rbp)), which the runtime
    // already checked fits.
    auto memory_bytes(EmitWorkspace& w, ObjectWorkspace& o, i64 save) -> bool {
        const i64 count = w.pack_address(0, 16);
        emit_load(w, o, count, Register::rax, false);
        const i64 stride = w.pack_address(0, 24);
        emit_load(w, o, stride, Register::rcx, false);
        emit_unary(w, o, UnaryOp::unsigned_multiply, Register::rcx);
        const i64 target = w.pack_address(0, save);
        return emit_store(w, o, Register::rax, target, false);
    }
    // RAX = the payload address of the live allocation in RAX of -LENGTH(%rbp)
    // bytes; the record's grant and generation are already set.
    auto memory_payload(EmitWorkspace& w, ObjectWorkspace& o, const compiler_ir_metadata::MetadataStore& m,
        i64 length) -> bool {
        const i64 allocation = w.pack_address(1, 16);
        emit_store(w, o, Register::rax, allocation, false);
        memory_argument(w, o, length, 24);
        const i64 success = w.pack_address(1, 32);
        emit_store_imm(w, o, 1, success, false);
        return memory_call(w, o, m, 3);
    }
    // The inline fast path of an owner access, before the entry's frame. It
    // makes the checks of the runtime's own fast path (memory::at, set,
    // element and payload) and of the access primitive behind it, reading the
    // runtime's state through the layout contract in x86_helpers.au, and
    // branches to label 7, the entry's ordinary path through the runtime,
    // unless: the owner in RDI succeeded; its region word names the session;
    // slot 0's mapping holds the whole state; and the record of the slot of
    // the owner's allocation id has that id, the owner's length and a stride
    // of STRIDE, or the stride in RDX when STRIDE is 0, or any live stride
    // when STRIDE is -1. It then leaves the owner's length in R8 and the
    // slot's mapping-table entry at R10 + host_session_bytes(), clobbers RAX,
    // R9 and R11 and keeps the argument registers for label 7.
    auto memory_fast_owner(EmitWorkspace& w, ObjectWorkspace& o, i64 stride) -> bool {
        emit_mov_rr(w, o, Register::rdi, Register::r10);
        const i64 success = w.pack_address(2, 24);
        emit_alu_mem_imm(w, o, AluOp::compare, 1, success);
        emit_branch(w, o, 5, 0, 7);
        const i64 region = w.pack_address(2, 0);
        emit_load(w, o, region, Register::rax, false);
        const i64 self = w.pack_address(4, host_session_self());
        emit_alu_load(w, o, AluOp::compare, self, Register::rax);
        emit_branch(w, o, 5, 0, 7);
        const i64 state_length = w.pack_address(4, host_session_bytes() + 8);
        emit_alu_mem_imm(w, o, AluOp::compare, host_memory_state_bytes(), state_length);
        emit_branch(w, o, 2, 0, 7);
        const i64 allocation = w.pack_address(2, 8);
        emit_load(w, o, allocation, Register::r9, false);
        const i64 length = w.pack_address(2, 16);
        emit_load(w, o, length, Register::r8, false);
        emit_mov_rr(w, o, Register::r9, Register::r10);
        emit_alu_imm(w, o, AluOp::bit_and, host_memory_slots() - 1, Register::r10);
        emit_mov_rr(w, o, Register::r10, Register::r11);
        emit_shift_imm(w, o, true, host_memory_record_shift(), Register::r11);
        const i64 state = w.pack_address(4, host_session_bytes());
        emit_alu_load(w, o, AluOp::add, state, Register::r11);
        emit_shift_imm(w, o, true, 4, Register::r10);
        emit_alu_rr(w, o, AluOp::add, Register::rax, Register::r10);
        const i64 identity = w.pack_address(3, host_memory_record(0));
        emit_alu_load(w, o, AluOp::compare, identity, Register::r9);
        emit_branch(w, o, 5, 0, 7);
        const i64 recorded = w.pack_address(3, host_memory_record(2));
        emit_alu_load(w, o, AluOp::compare, recorded, Register::r8);
        emit_branch(w, o, 5, 0, 7);
        const i64 live = w.pack_address(3, host_memory_record(1));
        if (stride == 0) {
            // A free record's stride is 0, so this also proves liveness: RDX
            // is an owner element size, which typed IR admits only in 1..520.
            emit_alu_load(w, o, AluOp::compare, live, Register::rdx);
            return emit_branch(w, o, 5, 0, 7);
        }
        if (stride < 0) {
            emit_alu_mem_imm(w, o, AluOp::compare, 0, live);
            return emit_branch(w, o, 4, 0, 7);
        }
        emit_alu_mem_imm(w, o, AluOp::compare, stride, live);
        return emit_branch(w, o, 5, 0, 7);
    }
    // After memory_fast_owner(0): RAX = the address of element RSI of RDX
    // bytes, checked as memory::element and memory_address check it: index
    // below the length, index * stride (no overflow: the length is within
    // the quota and the stride the record's) below it, and the element within
    // the slot's mapping.
    auto memory_fast_element(EmitWorkspace& w, ObjectWorkspace& o) -> bool {
        emit_alu_rr(w, o, AluOp::compare, Register::r8, Register::rsi);
        emit_branch(w, o, 3, 0, 7);
        emit_mov_rr(w, o, Register::rsi, Register::rax);
        emit_alu_rr(w, o, AluOp::multiply, Register::rdx, Register::rax);
        emit_alu_rr(w, o, AluOp::compare, Register::r8, Register::rax);
        emit_branch(w, o, 3, 0, 7);
        const i64 mapped = w.pack_address(2, host_session_bytes() + 8);
        emit_load(w, o, mapped, Register::r9, false);
        emit_alu_rr(w, o, AluOp::compare, Register::r9, Register::rax);
        emit_branch(w, o, 7, 0, 7);
        emit_alu_rr(w, o, AluOp::subtract, Register::rax, Register::r9);
        emit_alu_rr(w, o, AluOp::compare, Register::r9, Register::rdx);
        emit_branch(w, o, 7, 0, 7);
        const i64 base = w.pack_address(2, host_session_bytes());
        return emit_alu_load(w, o, AluOp::add, base, Register::rax);
    }
    // After memory_fast_owner(1): R9 = the slot's base once index RSI is
    // below the length and the mapping's (as memory::at and memory_load8).
    auto memory_fast_byte(EmitWorkspace& w, ObjectWorkspace& o) -> bool {
        emit_alu_rr(w, o, AluOp::compare, Register::r8, Register::rsi);
        emit_branch(w, o, 3, 0, 7);
        const i64 mapped = w.pack_address(2, host_session_bytes() + 8);
        emit_alu_load(w, o, AluOp::compare, mapped, Register::rsi);
        emit_branch(w, o, 3, 0, 7);
        const i64 base = w.pack_address(2, host_session_bytes());
        return emit_load(w, o, base, Register::r9, false);
    }
    // The kind-0 view at R10 of the payload at RAX of LENGTH bytes.
    auto memory_view(EmitWorkspace& w, ObjectWorkspace& o, Register length) -> bool {
        i64 word = 0;
        while (word < 56) {
            const i64 lane = w.pack_address(2, word);
            emit_store_imm(w, o, 0, lane, false);
            word = word + 8;
        }
        const i64 view_base = w.pack_address(2, 8);
        emit_store(w, o, Register::rax, view_base, false);
        const i64 view_length = w.pack_address(2, 48);
        return emit_store(w, o, length, view_length, false);
    }
    // Ends a fast path and opens the ordinary one, label 7, with the frame.
    auto memory_fast_end(EmitWorkspace& w, ObjectWorkspace& o) -> bool {
        emit_return_instruction(w, o);
        emit_bind_label(w, o, 0, 7);
        return memory_entry_frame(w, o);
    }
    auto module_emit_memory_entries(EmitWorkspace& w, ObjectWorkspace& o,
        const compiler_ir_metadata::MetadataStore& m) -> bool {
        const i64 owner = w.pack_address(0, 8);
        const i64 identity = w.pack_address(0, 48);
        const i64 old = w.pack_address(0, 64);
        const i64 owner_allocation = w.pack_address(2, 8);
        const i64 owner_length = w.pack_address(2, 16);
        const i64 single = w.pack_address(1, 24);
        // __au_runtime_bytes_allocate(region, length, owner*)
        const i64 entry_bytes_allocate = w.intern_runtime("__au_runtime_bytes_allocate");
        memory_entry_begin(w, o, entry_bytes_allocate);
        memory_pristine(w, o, 24);
        emit_branch(w, o, 5, 4, 0);
        memory_record(w, o, 8, false);
        memory_argument(w, o, 16, 16);
        emit_store_imm(w, o, 1, single, false);
        memory_call(w, o, m, 2);
        memory_descriptor(w, o, 24, 8, 16);
        memory_entry_end(w, o, entry_bytes_allocate);
        // __au_runtime_values_allocate(region, count, stride, fill*, owner*):
        // every element is a copy of the fill.
        const i64 entry_values_allocate = w.intern_runtime("__au_runtime_values_allocate");
        memory_entry_begin(w, o, entry_values_allocate);
        memory_pristine(w, o, 40);
        emit_branch(w, o, 5, 4, 0);
        memory_record(w, o, 8, false);
        memory_argument(w, o, 16, 16);
        memory_argument(w, o, 24, 24);
        memory_call(w, o, m, 2);
        emit_store(w, o, Register::rax, identity, false);
        emit_alu_rr(w, o, AluOp::test, Register::rax, Register::rax);
        emit_branch(w, o, 4, 0, 2);
        memory_bytes(w, o, 56);
        emit_store_imm(w, o, 0, old, false);
        emit_load(w, o, identity, Register::rax, false);
        memory_payload(w, o, m, 56);
        memory_fill(w, o, 32, 64, 56);
        emit_bind_label(w, o, 0, 2);
        emit_load(w, o, identity, Register::rax, false);
        memory_descriptor(w, o, 40, 8, 56);
        memory_entry_end(w, o, entry_values_allocate);
        // __au_runtime_bytes_borrow_length(owner*)
        const i64 entry_bytes_borrow_length = w.intern_runtime("__au_runtime_bytes_borrow_length");
        memory_entry_begin(w, o, entry_bytes_borrow_length);
        memory_record(w, o, 8, true);
        memory_call(w, o, m, 3);
        emit_load(w, o, owner, Register::r10, false);
        emit_load(w, o, owner_length, Register::rax, false);
        memory_entry_end(w, o, entry_bytes_borrow_length);
        // __au_runtime_bytes_borrow_span(owner*, span*): a contiguous kind-0 view.
        const i64 entry_bytes_borrow_span = w.intern_runtime("__au_runtime_bytes_borrow_span");
        memory_entry_symbol(w, o, entry_bytes_borrow_span);
        memory_fast_owner(w, o, -1);
        emit_alu_rr(w, o, AluOp::test, Register::r8, Register::r8);
        emit_branch(w, o, 14, 0, 7);
        const i64 mapped = w.pack_address(2, host_session_bytes() + 8);
        emit_alu_load(w, o, AluOp::compare, mapped, Register::r8);
        emit_branch(w, o, 7, 0, 7);
        const i64 base = w.pack_address(2, host_session_bytes());
        emit_load(w, o, base, Register::rax, false);
        emit_mov_rr(w, o, Register::rsi, Register::r10);
        memory_view(w, o, Register::r8);
        memory_fast_end(w, o);
        memory_record(w, o, 8, true);
        memory_call(w, o, m, 3);
        emit_load(w, o, owner, Register::r10, false);
        emit_load(w, o, owner_length, Register::rdx, false);
        const i64 view = w.pack_address(0, 16);
        emit_load(w, o, view, Register::r10, false);
        memory_view(w, o, Register::rdx);
        memory_entry_end(w, o, entry_bytes_borrow_span);
        // __au_runtime_bytes_at(owner*, index)
        const i64 entry_bytes_at = w.intern_runtime("__au_runtime_bytes_at");
        memory_entry_symbol(w, o, entry_bytes_at);
        memory_fast_owner(w, o, 1);
        memory_fast_byte(w, o);
        emit_indexed_load(w, o, Register::r9, Register::rsi, indexed_address(1, 0), true);
        memory_fast_end(w, o);
        memory_record(w, o, 8, true);
        memory_argument(w, o, 16, 40);
        memory_call(w, o, m, 4);
        memory_entry_end(w, o, entry_bytes_at);
        // __au_runtime_bytes_set(owner*, index, value)
        const i64 entry_bytes_set = w.intern_runtime("__au_runtime_bytes_set");
        memory_entry_symbol(w, o, entry_bytes_set);
        memory_fast_owner(w, o, 1);
        emit_alu_imm(w, o, AluOp::compare, 255, Register::rdx);
        emit_branch(w, o, 7, 0, 7);
        memory_fast_byte(w, o);
        emit_mov_rr(w, o, Register::rdx, Register::rax);
        emit_indexed_store(w, o, Register::r9, Register::rsi, indexed_address(1, 0), true);
        emit_mov_imm(w, o, 1, Register::rax);
        memory_fast_end(w, o);
        memory_record(w, o, 8, true);
        memory_argument(w, o, 16, 40);
        memory_argument(w, o, 24, 48);
        memory_call(w, o, m, 5);
        memory_entry_end(w, o, entry_bytes_set);
        // __au_runtime_bytes_resize(owner*, length): 1 resized, 0 unchanged.
        const i64 entry_bytes_resize = w.intern_runtime("__au_runtime_bytes_resize");
        memory_entry_begin(w, o, entry_bytes_resize);
        memory_record(w, o, 8, true);
        memory_argument(w, o, 16, 40);
        const i64 unit = w.pack_address(1, 48);
        emit_store_imm(w, o, 1, unit, false);
        memory_call(w, o, m, 7);
        emit_alu_rr(w, o, AluOp::test, Register::rax, Register::rax);
        emit_branch(w, o, 4, 0, 2);
        emit_load(w, o, owner, Register::r10, false);
        emit_store(w, o, Register::rax, owner_allocation, false);
        const i64 requested = w.pack_address(0, 16);
        emit_load(w, o, requested, Register::rcx, false);
        emit_store(w, o, Register::rcx, owner_length, false);
        emit_mov_imm(w, o, 1, Register::rax);
        emit_bind_label(w, o, 0, 2);
        memory_entry_end(w, o, entry_bytes_resize);
        // __au_runtime_values_resize(owner*, count, stride, fill*): elements
        // past the old count are copies of the fill.
        const i64 entry_values_resize = w.intern_runtime("__au_runtime_values_resize");
        memory_entry_begin(w, o, entry_values_resize);
        emit_load(w, o, owner, Register::r10, false);
        emit_load(w, o, owner_length, Register::rcx, false);
        emit_store(w, o, Register::rcx, old, false);
        memory_record(w, o, 8, true);
        memory_argument(w, o, 16, 40);
        memory_argument(w, o, 24, 48);
        memory_call(w, o, m, 7);
        emit_alu_rr(w, o, AluOp::test, Register::rax, Register::rax);
        emit_branch(w, o, 4, 0, 2);
        emit_store(w, o, Register::rax, identity, false);
        memory_bytes(w, o, 56);
        emit_load(w, o, owner, Register::r10, false);
        emit_load(w, o, identity, Register::rax, false);
        emit_store(w, o, Register::rax, owner_allocation, false);
        const i64 resized = w.pack_address(0, 56);
        emit_load(w, o, resized, Register::rcx, false);
        emit_store(w, o, Register::rcx, owner_length, false);
        emit_alu_load(w, o, AluOp::compare, old, Register::rcx);
        emit_branch(w, o, 6, 0, 3);
        memory_payload(w, o, m, 56);
        memory_fill(w, o, 32, 64, 56);
        emit_bind_label(w, o, 0, 3);
        emit_mov_imm(w, o, 1, Register::rax);
        emit_bind_label(w, o, 0, 2);
        memory_entry_end(w, o, entry_values_resize);
        // __au_runtime_values_at(owner*, index, stride, element*)
        const i64 element = w.pack_address(0, 32);
        const i64 stride = w.pack_address(0, 24);
        const i64 entry_values_at = w.intern_runtime("__au_runtime_values_at");
        memory_entry_symbol(w, o, entry_values_at);
        memory_fast_owner(w, o, 0);
        memory_fast_element(w, o);
        emit_mov_rr(w, o, Register::rax, Register::rsi);
        emit_mov_rr(w, o, Register::rcx, Register::rdi);
        emit_mov_rr(w, o, Register::rdx, Register::rcx);
        memory_copy(w, o, 4);
        memory_fast_end(w, o);
        memory_record(w, o, 8, true);
        memory_argument(w, o, 16, 40);
        memory_argument(w, o, 24, 48);
        memory_call(w, o, m, 6);
        emit_alu_rr(w, o, AluOp::test, Register::rax, Register::rax);
        emit_branch(w, o, 4, 4, 0);
        emit_mov_rr(w, o, Register::rax, Register::rsi);
        emit_load(w, o, element, Register::rdi, false);
        emit_load(w, o, stride, Register::rcx, false);
        memory_copy(w, o, 0);
        memory_entry_end(w, o, entry_values_at);
        // __au_runtime_values_set(owner*, index, stride, element*): 1 written.
        const i64 entry_values_set = w.intern_runtime("__au_runtime_values_set");
        memory_entry_symbol(w, o, entry_values_set);
        memory_fast_owner(w, o, 0);
        memory_fast_element(w, o);
        emit_mov_rr(w, o, Register::rax, Register::rdi);
        emit_mov_rr(w, o, Register::rcx, Register::rsi);
        emit_mov_rr(w, o, Register::rdx, Register::rcx);
        memory_copy(w, o, 4);
        emit_mov_imm(w, o, 1, Register::rax);
        memory_fast_end(w, o);
        memory_record(w, o, 8, true);
        memory_argument(w, o, 16, 40);
        memory_argument(w, o, 24, 48);
        memory_call(w, o, m, 6);
        emit_alu_rr(w, o, AluOp::test, Register::rax, Register::rax);
        emit_branch(w, o, 4, 0, 3);
        emit_mov_rr(w, o, Register::rax, Register::rdi);
        emit_load(w, o, element, Register::rsi, false);
        emit_load(w, o, stride, Register::rcx, false);
        memory_copy(w, o, 0);
        emit_mov_imm(w, o, 1, Register::rax);
        emit_bind_label(w, o, 0, 3);
        memory_entry_end(w, o, entry_values_set);
        // __au_runtime_bytes_drop(owner*): a pristine descriptor is inert.
        const i64 entry_bytes_drop = w.intern_runtime("__au_runtime_bytes_drop");
        memory_entry_begin(w, o, entry_bytes_drop);
        memory_pristine(w, o, 8);
        emit_branch(w, o, 4, 0, 2);
        memory_record(w, o, 8, true);
        memory_call(w, o, m, 8);
        emit_load(w, o, owner, Register::r10, false);
        i64 word = 0;
        while (word < 32) {
            const i64 lane = w.pack_address(2, word);
            emit_store_imm(w, o, 0, lane, false);
            word = word + 8;
        }
        emit_bind_label(w, o, 0, 2);
        return memory_entry_end(w, o, entry_bytes_drop);
    }
    auto module_retained_integrity(EmitWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s) -> bool {
        if (m.status() != compiler_ir_metadata::MetadataStatus::success || s.status()
            != compiler_ir_instructions::InstructionStatus::published || m.callable_count() != s.body_count()) {
            return w.fail();
        }
        return w.retained_valid(m.callable_count());
    }
    auto run(EmitWorkspace& w, ObjectWorkspace& o, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 binding, i64 reflection) -> EmitStatus {
        if ((binding != 0 && binding != 1) || (reflection != 0 && reflection != 1) || !module_retained_integrity(w, m,
            s) || !w.begin()) {
            w.fail();
            return w.status();
        }
        if (o.object_mode()) {
            w.select_object();
            const i64 instruction_count = s.instruction_count();
            const i64 callable_count = m.callable_count();
            o.configure_labels(instruction_count, callable_count, m.descriptor_count());
            if (!emit_object_status(w, o)) {
                return w.status();
            }
        }
        const bool resources = module_resource_graph(w, m, s);
        const bool private_graph = resources || module_service_graph(w, m);
        w.set_runtime_mode(resources, hosted_region(m));
        if (!o.object_mode()) {
            w.text("# Aurora compiler output: validated typed IR, x86-64 bootstrap\n.text\n");
        }
        i64 at = 0;
        while (at < w.retained_count() && w.ok()) {
            const i64 callable = w.retained_at(at);
            module_emit_callable(w, o, m, s, callable, binding == 1 || private_graph);
            at = at + 1;
        }
        module_emit_reflection(w, o, m, s, binding, reflection);
        module_emit_hosted_entry(w, o, m);
        i64 trap = 0;
        while (trap < 4) {
            emit_bind_label(w, o, 4, trap);
            emit_trap_instruction(w, o);
            trap = trap + 1;
        }
        module_emit_literals(w, o, s);
        if (!o.object_mode()) {
            w.text(".section .note.GNU-stack,\"\",@progbits\n");
        }
        finish_assembly(w, o);
        return w.status();
    }
}
