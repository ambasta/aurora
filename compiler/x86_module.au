export module aurora.compiler.x86_module;
import aurora.compiler.x86_storage;
import aurora.compiler.x86_object_storage;
import aurora.compiler.x86_helpers;
import aurora.compiler.x86_scalar;
import aurora.compiler.x86_objects;
import aurora.compiler.x86_resources;
import aurora.compiler.x86_facts;
import aurora.compiler.ir_instruction_storage;
import aurora.compiler.ir_instructions;
import aurora.compiler.ir_metadata_storage;
import aurora.compiler.ir_metadata;

// The module owner visits retained durable instruction IDs in their admitted
// order. All instruction text and stack/ABI policy stays in Aurora; the host
// receives bounded completed-artifact chunks only after sticky success.
export namespace compiler_x86 {
    auto module_form(const compiler_ir_instructions::InstructionStore& s, i64 instruction) -> i64 {
        if (instruction <= 0) {
            return -1;
        }
        const compiler_ir_instructions::RawInstructionRow row = s.instruction_at(instruction);
        return row.form();
    }
    auto module_instruction(const compiler_ir_instructions::InstructionStore& s, i64 callable, i64 position) -> i64 {
        const compiler_ir_instructions::BodyRow body = s.body_at(callable);
        if (position < 0 || position >= body.count()) {
            return -1;
        }
        const compiler_ir_instructions::CodeRow row = s.code_at(body.begin() + position);
        return row.id();
    }
    auto module_private_type(const compiler_ir_metadata::MetadataStore& m, i64 type) -> bool {
        const i64 kind = type_kind(m, type);
        if (kind == 12 || kind == 13 || kind == 17) {
            return true;
        }
        return kind == 5 && owning_class(m, type_class(m, type));
    }
    auto module_resource_graph(const EmitWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s) -> bool {
        i64 at = 0;
        while (at < m.class_count()) {
            if (owning_class(m, at)) {
                return true;
            }
            at = at + 1;
        }
        at = 0;
        while (at < w.retained_count()) {
            const i64 callable = w.retained_at(at);
            if (module_private_type(m, result_type(m, callable))) {
                return true;
            }
            if (has_receiver(m, callable) && owning_class(m, receiver_class(m, callable))) {
                return true;
            }
            i64 parameter = 0;
            while (parameter < parameter_count(m, callable)) {
                if (module_private_type(m, parameter_type(m, callable, parameter))) {
                    return true;
                }
                parameter = parameter + 1;
            }
            const compiler_ir_instructions::BodyRow body = s.body_at(callable);
            i64 position = 0;
            while (position < body.count()) {
                const i64 form = module_form(s, module_instruction(s, callable, position));
                if (form == 60 || form == 75 || form == 77 || form == 78 || form == 79 || form == 80) {
                    return true;
                }
                position = position + 1;
            }
            at = at + 1;
        }
        return false;
    }
    auto module_service_graph(const EmitWorkspace& w, const compiler_ir_metadata::MetadataStore& m) -> bool {
        i64 at = 0;
        while (at < w.retained_count()) {
            const i64 callable = w.retained_at(at);
            i64 parameter = 0;
            while (parameter < parameter_count(m, callable)) {
                const i64 kind = type_kind(m, parameter_type(m, callable, parameter));
                if (service_type_kind(kind)) {
                    return true;
                }
                parameter = parameter + 1;
            }
            at = at + 1;
        }
        return false;
    }
    auto module_hidden_symbol(const compiler_ir_metadata::MetadataStore& m, i64 callable) -> bool {
        const compiler_ir_metadata::CallableRow row = m.callable_at(callable);
        return compiler_ir_metadata::name_prefix(m, row.name(), "__au_o_");
    }
    auto module_emit_instruction(EmitWorkspace& w, ObjectWorkspace& o, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 instruction) -> bool {
        if (emit_scalar(w, o, m, s, instruction)) {
            return w.ok();
        }
        if (emit_objects(w, o, m, s, instruction)) {
            return w.ok();
        }
        if (emit_resources(w, o, m, s, instruction)) {
            return w.ok();
        }
        return w.fail();
    }
    auto module_plain_load(i64 form) -> bool {
        return form == 5 || form == 6 || form == 7 || form == 32;
    }
    auto module_popped_binary(i64 form) -> bool {
        return form == 12 || form == 14;
    }
    auto module_emit_body(EmitWorkspace& w, ObjectWorkspace& o, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 callable) -> bool {
        const compiler_ir_instructions::BodyRow body = s.body_at(callable);
        w.set_direct_result(false);
        w.set_left_in_rcx(false);
        i64 at = 0;
        while (at < body.count() && w.ok()) {
            const i64 current = module_instruction(s, callable, at);
            const i64 next = module_instruction(s, callable, at + 1);
            const i64 following = module_instruction(s, callable, at + 2);
            const i64 form = module_form(s, current);
            const i64 next_form = module_form(s, next);
            i64 last = current;
            if (following > 0 && form == 9 && fusable_binary(m, s, next, following)) {
                // The left value stays in %rax and the right is an operand.
                emit_fused_binary(w, o, m, s, next, following);
                last = following;
                at = at + 3;
            } else {
                if (following > 0 && form == 9 && module_plain_load(next_form) && module_popped_binary(module_form(s,
                    following))) {
                    // The intervening accumulator load touches neither RCX nor the
                    // operand stack; preserve the old adjacency-only peephole.
                    emit_mov_rr(w, o, Register::rax, Register::rcx);
                    module_emit_instruction(w, o, m, s, next);
                    w.set_left_in_rcx(true);
                    module_emit_instruction(w, o, m, s, following);
                    w.set_left_in_rcx(false);
                    last = following;
                    at = at + 3;
                } else {
                    if (form == 63 && next_form == 44 && operand_value(s, next, 0) == operand_value(s, current, 2)) {
                        const i64 result = result_type(m, callable);
                        const i64 source = operand_value(s, current, 0);
                        const i64 field = operand_value(s, current, 1);
                        if (class_size(m, type_class(m, result)) != owner_element_stride(m, callable, source, field)) {
                            return w.fail();
                        }
                        w.set_direct_result(true);
                        module_emit_instruction(w, o, m, s, current);
                        w.set_direct_result(false);
                        emit_alu_rr(w, o, AluOp::bit_xor, Register::rax, Register::rax);
                        emit_branch(w, o, -1, 1, 0);
                        at = at + 2;
                    } else {
                        module_emit_instruction(w, o, m, s, current);
                        at = at + 1;
                    }
                }
            }
            const i64 branch = module_instruction(s, callable, at);
            if (module_form(s, last) == 14 && module_form(s, branch) == 42) {
                fused_branch(w, o, m, s, last, branch);
                at = at + 1;
            }
        }
        return w.ok();
    }
    // Scalar operands, list entries included, that lie in the frame extent
    // (low, high]. Constants, type identities and byte slices are never offsets,
    // so an unrelated equal value only makes a caller conservative.
    auto module_operand_mentions(const compiler_ir_instructions::InstructionStore& s, i64 instruction, i64 low,
        i64 high) -> i64 {
        const compiler_ir_instructions::RawInstructionRow row = s.instruction_at(instruction);
        i64 count = 0;
        i64 at = 0;
        while (at < row.operand_count()) {
            const compiler_ir_instructions::RawOperandRow operand = s.operand_at(row.operand_begin() + at);
            const i64 role = operand.role();
            if (compiler_ir_instructions::list_role(role)) {
                i64 item = 0;
                while (item < operand.count()) {
                    const compiler_ir_instructions::RawOperandRow entry = s.operand_at(operand.begin() + item);
                    if (entry.signed_value() > low && entry.signed_value() <= high) {
                        count = count + 1;
                    }
                    item = item + 1;
                }
            } else {
                if (role != 10 && role != 11 && role != 33 && role != 100 && role != 101
                    && !compiler_ir_instructions::type_role(role) && operand.signed_value() > low
                    && operand.signed_value() <= high) {
                    count = count + 1;
                }
            }
            at = at + 1;
        }
        return count;
    }
    // Whether an instruction ends the span or makes it a new capability.
    auto module_rewrites_span(const compiler_ir_instructions::InstructionStore& s, i64 instruction, i64 span) -> bool {
        const compiler_ir_instructions::RawInstructionRow row = s.instruction_at(instruction);
        if (row.form() == 56 || row.form() == 59) {
            return operand_value(s, instruction, 0) == span || operand_value(s, instruction, 1) == span;
        }
        i64 at = 0;
        while (at < row.operand_count()) {
            const compiler_ir_instructions::RawOperandRow operand = s.operand_at(row.operand_begin() + at);
            if (operand.role() == 6 && operand.signed_value() == span) {
                return true;
            }
            at = at + 1;
        }
        return false;
    }
    auto module_const_method(const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 instruction) -> bool {
        const compiler_ir_metadata::FlagMasks masks = compiler_ir_metadata::FlagMasks();
        const i64 target = instruction_target(m, s, instruction);
        if (target < 0 || !has_receiver(m, target)) {
            return false;
        }
        const compiler_ir_metadata::CallableRow declaration = m.callable_at(target);
        const compiler_ir_metadata::ReceiverShape receiver = declaration.first_receiver();
        return declaration.borrowed_root_count() == 0 && !compiler_ir_metadata::receiver_flag(receiver,
            masks.receiver_mutable()) && !compiler_ir_metadata::receiver_flag(receiver, masks.receiver_constructor());
    }
    // A typed span element can be read in place, without copying it into its
    // object, when every condition below holds; the verifier still checks the
    // copying program. The object is an immutable slot filled only by this
    // SpanValuesLoad and otherwise only begun, ended or the sole receiver of
    // const methods, which cannot write a receiver or keep its address. From the
    // load to the last use the span is neither ended nor rebound and that range is
    // entered only through the load, so the span stays live there; a live span
    // freezes its owner, so the element is unchanged at every use.
    auto module_elidable(const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 callable, i64 position, i64 span, i64 object) -> bool {
        const i64 index = compiler_ir_instructions::entry_slot(m, callable, 11, object);
        if (index < 0) {
            return false;
        }
        const compiler_ir_metadata::SlotRow slot = m.slot_at(index);
        const i64 size = class_size(m, slot_class(m, callable, object));
        if (slot.mutable_value() != 0 || size < 8 || size > object) {
            return false;
        }
        const i64 low = object - size;
        const compiler_ir_instructions::BodyRow body = s.body_at(callable);
        i64 last = -1;
        i64 at = 0;
        while (at < body.count()) {
            const i64 instruction = module_instruction(s, callable, at);
            const i64 form = module_form(s, instruction);
            const i64 mentions = module_operand_mentions(s, instruction, low, object);
            if (mentions != 0) {
                bool allowed = mentions == 1 && at == position;
                if (mentions == 1 && (form == 21 || form == 23) && operand_value(s, instruction, 0) == object) {
                    allowed = true;
                }
                if (mentions == 1 && form == 38 && operand_value(s, instruction, 1) == object && operand_value(s,
                    instruction, 4) == -1 && module_const_method(m, s, instruction) && at > position) {
                    allowed = true;
                    last = at;
                }
                if (!allowed) {
                    return false;
                }
            }
            at = at + 1;
        }
        if (last < 0) {
            return false;
        }
        at = position + 1;
        while (at <= last) {
            if (module_rewrites_span(s, module_instruction(s, callable, at), span)) {
                return false;
            }
            at = at + 1;
        }
        // Every jump into (position, last] starts inside [position, last].
        at = 0;
        while (at < body.count()) {
            const i64 instruction = module_instruction(s, callable, at);
            const i64 form = module_form(s, instruction);
            if ((form == 41 || form == 42) && (at < position || at > last)) {
                const i64 label = operand_value(s, instruction, 0);
                i64 inside = position + 1;
                while (inside <= last) {
                    const i64 candidate = module_instruction(s, callable, inside);
                    if (module_form(s, candidate) == 40 && operand_value(s, candidate, 0) == label) {
                        return false;
                    }
                    inside = inside + 1;
                }
            }
            at = at + 1;
        }
        return true;
    }
    // Elided objects are recorded with the loans under negated offsets; loan
    // identities are positive.
    auto module_elide_span_objects(EmitWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 callable) -> bool {
        const compiler_ir_instructions::BodyRow body = s.body_at(callable);
        i64 at = 0;
        while (at < body.count() && w.ok()) {
            const i64 load = module_instruction(s, callable, at);
            if (module_form(s, load) == 84) {
                const i64 span = operand_value(s, load, 0);
                const i64 object = operand_value(s, load, 1);
                if (object > 0 && module_elidable(m, s, callable, at, span, object)) {
                    w.add_loan(0 - object, span);
                }
            }
            at = at + 1;
        }
        return w.ok();
    }
    auto module_emit_callable(EmitWorkspace& w, ObjectWorkspace& o, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 callable, bool force_local) -> bool {
        const compiler_ir_metadata::CallableRow declaration = m.callable_at(callable);
        const compiler_ir_instructions::BodyRow body = s.body_at(callable);
        const i64 declared = declaration.frame_bytes();
        const i64 roots = declaration.borrowed_root_count();
        const bool receiver = has_receiver(m, callable);
        const bool aggregate = aggregate_signature(m, callable);
        // Independent backend backstop: multiple borrowed roots admit only
        // scalar/enum value tails and results, never aggregate/private records.
        if (roots > 1 && aggregate) {
            return w.fail();
        }
        if (!w.begin_function(0, callable, callable)) {
            return false;
        }
        i64 at = 0;
        while (at < body.count()) {
            const i64 instruction = module_instruction(s, callable, at);
            if (module_form(s, instruction) == 1) {
                w.add_loan(operand_value(s, instruction, 0), operand_value(s, instruction, 1));
            }
            at = at + 1;
        }
        if (!module_elide_span_objects(w, m, s, callable)) {
            return false;
        }
        const bool local = force_local || receiver || aggregate || module_hidden_symbol(m, callable);
        if (o.object_mode()) {
            o.begin_object_symbol(callable, local);
            callable_name(w, o, m, callable);
            o.end_object_symbol_name();
        } else {
            if (local) {
                w.text(".local ");
            } else {
                w.text(".globl ");
            }
            callable_name(w, o, m, callable);
            w.text("\n.type ");
            callable_name(w, o, m, callable);
            w.text(", @function\n");
            callable_name(w, o, m, callable);
            w.text(":\n");
        }
        emit_push_register(w, o, Register::rbp);
        w.grow_stack(8);
        emit_mov_rr(w, o, Register::rsp, Register::rbp);
        i64 receiver_save = 0;
        if (receiver) {
            receiver_save = declared + 8;
        }
        const bool resource_parameters = parameter_count(m, callable) != 0 && type_kind(m, parameter_type(m, callable,
            0)) == 12;
        bool packed = aggregate;
        if (receiver) {
            packed = class_parameters(m, callable) || resource_parameters;
        }
        if (packed) {
            w.record_signature(copied_record_bytes(m, callable), service_record_bytes(m, callable));
        }
        const i64 result_kind = type_kind(m, result_type(m, callable));
        const bool combined = receiver && packed && (result_kind == 5 || span_kind(result_kind));
        i64 record_save = 0;
        if (packed) {
            record_save = declared + 8;
            if (receiver) {
                record_save = declared + 16;
            }
        }
        i64 result_save = 0;
        if (result_kind == 5 || span_kind(result_kind) || result_kind == 13 || result_kind == 17) {
            result_save = declared + 16;
            if (combined) {
                result_save = declared + 24;
            }
        }
        w.set_saves(receiver_save, record_save, result_save);
        i64 frame = declared;
        if (roots > 1) {
            frame = frame + ((roots * 8 + 15) / 16) * 16;
        } else {
            if (combined) {
                frame = frame + 32;
            } else {
                if (receiver || aggregate) {
                    frame = frame + 16;
                }
            }
        }
        emit_reserve_stack(w, o, frame);
        if (roots > 1) {
            i64 ordinal = 1;
            while (ordinal < roots) {
                const i64 root_address = w.pack_address(2, ordinal * 8);
                emit_load(w, o, root_address, Register::r11, false);
                const i64 save = root_save_offset(w, m, ordinal);
                emit_store(w, o, Register::r11, save, false);
                ordinal = ordinal + 1;
            }
            const i64 first_root = w.pack_address(2, 0);
            emit_load(w, o, first_root, Register::r10, false);
        }
        if (receiver) {
            const i64 save = root_save_offset(w, m, 0);
            emit_store(w, o, Register::r10, save, false);
        }
        if (packed) {
            emit_store(w, o, Register::r11, record_save, false);
        }
        if (result_save != 0) {
            if (combined) {
                emit_store(w, o, Register::rax, result_save, false);
            } else {
                if (receiver) {
                    emit_store(w, o, Register::r11, result_save, false);
                } else {
                    emit_store(w, o, Register::r10, result_save, false);
                }
            }
        }
        if (!module_emit_body(w, o, m, s, callable)) {
            return false;
        }
        if (w.stack_depth() != 0 || w.live_stack() != frame + 16) {
            return w.fail();
        }
        emit_bind_label(w, o, 1, 0);
        emit_leave_instruction(w, o);
        emit_return_instruction(w, o);
        if (o.object_mode()) {
            o.end_object_symbol();
        } else {
            w.text(".size ");
            callable_name(w, o, m, callable);
            w.text(", .-");
            callable_name(w, o, m, callable);
            w.end_line();
        }
        return w.finish_function();
    }
    auto module_reflection_referenced(const EmitWorkspace& w, const compiler_ir_instructions::InstructionStore& s,
        i64 scope, i64 query) -> bool {
        i64 at = 0;
        while (at < w.retained_count()) {
            const i64 callable = w.retained_at(at);
            const compiler_ir_instructions::BodyRow body = s.body_at(callable);
            i64 position = 0;
            while (position < body.count()) {
                const i64 instruction = module_instruction(s, callable, position);
                const compiler_ir_instructions::RawInstructionRow row = s.instruction_at(instruction);
                if (row.form() == 39 && row.query() == query && operand_value(s, instruction, 0) == scope) {
                    return true;
                }
                position = position + 1;
            }
            at = at + 1;
        }
        return false;
    }
    auto module_descriptor_value(const compiler_ir_metadata::MetadataStore& m, i64 id, i64 query) -> i64 {
        i64 begin = 0;
        i64 end = m.descriptor_count();
        while (begin < end) {
            const i64 middle = begin + (end - begin) / 2;
            const compiler_ir_metadata::DescriptorRow row = m.descriptor_at(middle);
            if (row.id() == id) {
                if (query == 0) {
                    return row.size();
                }
                return row.public_fields();
            }
            if (row.id() < id) {
                begin = middle + 1;
            } else {
                end = middle;
            }
        }
        return -1;
    }
    auto module_scope_label(EmitWorkspace& w, ObjectWorkspace& o, i64 scope, i64 query, i64 id) -> bool {
        w.text(".Lscope");
        w.number(scope);
        if (query == 0) {
            w.text("_size");
        } else {
            w.text("_field_count");
        }
        return w.number(id);
    }
    auto module_emit_reflection(EmitWorkspace& w, ObjectWorkspace& o, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 binding, i64 reflection) -> bool {
        i64 at = 0;
        while (at < m.view_count() && w.ok()) {
            const compiler_ir_metadata::ViewRow view = m.view_at(at);
            const compiler_ir_metadata::IndexRange ids = view.descriptors();
            const i64 scope = view.scope();
            i64 query = 0;
            while (query < 2 && w.ok()) {
                if (reflection == 0 || module_reflection_referenced(w, s, scope, query)) {
                    // Object output initially admits ordinary callable code only.
                    // Never silently discard an admitted reflection function.
                    if (o.object_mode()) {
                        return w.unsupported_object();
                    }
                    if (!w.begin_function(1, scope * 2 + query, -1)) {
                        return false;
                    }
                    if (binding == 1) {
                        w.text(".local ");
                    } else {
                        w.text(".globl ");
                    }
                    query_name(w, o, query, scope);
                    w.text("\n.type ");
                    query_name(w, o, query, scope);
                    w.text(", @function\n");
                    query_name(w, o, query, scope);
                    w.text(":\n");
                    i64 entry = 0;
                    while (entry < ids.count()) {
                        const compiler_ir_metadata::IndexRow row = m.index_at(ids.begin() + entry);
                        const i64 id = row.value();
                        w.line_number("cmpq $", id, ", %rdi");
                        w.text("    je ");
                        module_scope_label(w, o, scope, query, id);
                        w.end_line();
                        entry = entry + 1;
                    }
                    emit_alu_rr(w, o, AluOp::bit_xor, Register::rax, Register::rax);
                    w.line("ret");
                    entry = 0;
                    while (entry < ids.count()) {
                        const compiler_ir_metadata::IndexRow row = m.index_at(ids.begin() + entry);
                        const i64 id = row.value();
                        const i64 value = module_descriptor_value(m, id, query);
                        if (value < 0) {
                            return w.fail();
                        }
                        module_scope_label(w, o, scope, query, id);
                        w.text(":\n");
                        w.line_number("movq $", value, ", %rax");
                        w.line("ret");
                        entry = entry + 1;
                    }
                    w.text(".size ");
                    query_name(w, o, query, scope);
                    w.text(", .-");
                    query_name(w, o, query, scope);
                    w.end_line();
                }
                query = query + 1;
            }
            at = at + 1;
        }
        return w.ok();
    }
    auto module_emit_literals(EmitWorkspace& w, ObjectWorkspace& o,
        const compiler_ir_instructions::InstructionStore& s) -> bool {
        bool section = false;
        i64 at = 0;
        while (at < w.retained_count() && w.ok()) {
            const i64 callable = w.retained_at(at);
            const compiler_ir_instructions::BodyRow body = s.body_at(callable);
            i64 position = 0;
            while (position < body.count() && w.ok()) {
                const i64 instruction = module_instruction(s, callable, position);
                if (module_form(s, instruction) == 51) {
                    if (o.object_mode()) {
                        return w.unsupported_object();
                    }
                    if (!section) {
                        w.text(".section .rodata\n");
                        section = true;
                    }
                    w.text(".Laurora_literal_");
                    w.number(instruction);
                    w.text(":\n");
                    const compiler_ir_instructions::RawOperandRow literal = compiler_ir_instructions::call_operand(s,
                        instruction, 0);
                    i64 byte = 0;
                    while (byte < literal.count() && w.ok()) {
                        w.line_number(".byte ", s.literal_at(literal.begin() + byte), "");
                        byte = byte + 1;
                    }
                }
                position = position + 1;
            }
            at = at + 1;
        }
        return w.ok();
    }
    auto module_retained_integrity(EmitWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s) -> bool {
        if (m.status() != compiler_ir_metadata::MetadataStatus::success || s.status()
            != compiler_ir_instructions::InstructionStatus::published || m.callable_count() != s.body_count()) {
            return w.fail();
        }
        return w.retained_valid(m.callable_count());
    }
    auto run(EmitWorkspace& w, ObjectWorkspace& o, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 binding, i64 reflection) -> EmitStatus {
        if ((binding != 0 && binding != 1) || (reflection != 0 && reflection != 1) || !module_retained_integrity(w, m,
            s) || !w.begin()) {
            w.fail();
            return w.status();
        }
        if (o.object_mode()) {
            w.select_object();
            const i64 instruction_count = s.instruction_count();
            const i64 retained_count = w.retained_count();
            o.configure_labels(instruction_count, retained_count);
            if (!emit_object_status(w, o)) {
                return w.status();
            }
        }
        const bool resources = module_resource_graph(w, m, s);
        const bool private_graph = resources || module_service_graph(w, m);
        w.set_owned_span_runtime(resources);
        if (!o.object_mode()) {
            w.text("# Aurora compiler output: validated typed IR, x86-64 bootstrap\n.text\n");
        }
        i64 at = 0;
        while (at < w.retained_count() && w.ok()) {
            const i64 callable = w.retained_at(at);
            module_emit_callable(w, o, m, s, callable, binding == 1 || private_graph);
            at = at + 1;
        }
        module_emit_reflection(w, o, m, s, binding, reflection);
        i64 trap = 0;
        while (trap < 4) {
            emit_bind_label(w, o, 4, trap);
            emit_trap_instruction(w, o);
            trap = trap + 1;
        }
        module_emit_literals(w, o, s);
        if (!o.object_mode()) {
            w.text(".section .note.GNU-stack,\"\",@progbits\n");
        }
        finish_assembly(w, o);
        return w.status();
    }
}
