export module aurora.compiler.ir_instructions;
import aurora.compiler.ir_instruction_storage;
import aurora.compiler.ir_metadata;
import aurora.compiler.ir_metadata_storage;

// Generic durable transport admission precedes the sole native field walk for
// exact opcode shapes. Source admission normalizes every body, then checks all
// entry bindings, static call sites, storage accesses, scalar computations and
// service contracts against readonly metadata. Native verification keeps
// dynamic value/type, lifetime, provenance and joins.
export namespace compiler_ir_instructions {
    auto bounded_range(i64 begin, i64 count, i64 limit) -> bool {
        return begin >= 0 && count >= 0 && begin <= limit && count <= limit - begin;
    }
    // These raw ordinals reuse the lowering vocabulary. The closed native
    // binding pins each used role and the form endpoints to generated facts.
    auto type_role(i64 role) -> bool {
        return role == 12 || role == 14 || role == 15 || role == 16 || role == 18 || role == 20;
    }
    auto list_role(i64 role) -> bool {
        return role == 8 || role == 9 || role == 21 || role == 25 || role == 37 || role == 102;
    }
    auto scalar_payload(RawOperandRow operand) -> bool {
        return operand.unsigned_value() == 0u64 && operand.begin() == 0 && operand.count() == 0;
    }
    auto slice_payload(RawOperandRow operand) -> bool {
        return operand.signed_value() == 0 && operand.unsigned_value() == 0u64;
    }
    auto fail(InstructionStore& store, InstructionError reason) -> bool {
        return store.reject(reason);
    }
    auto body_integrity(InstructionStore& store) -> bool {
        i64 next_code = 0;
        i64 callable = 0;
        while (callable < store.body_count()) {
            const BodyRow body = store.body_at(callable);
            if (!bounded_range(body.begin(), body.capacity(), store.code_count()) || body.count() != body.capacity()
                || body.unreachable_after() != 0 || (body.capacity() != 0 && body.begin() != next_code)) {
                return fail(store, InstructionError::integrity);
            }
            next_code = next_code + body.capacity();
            callable = callable + 1;
        }
        if (next_code != store.code_count()) {
            return fail(store, InstructionError::integrity);
        }
        i64 at = 0;
        while (at < store.code_count()) {
            const CodeRow code = store.code_at(at);
            if (code.id() != at + 1 || code.target() != -1 || code.flags() != 0u64 || code.scratch() != 0) {
                return fail(store, InstructionError::integrity);
            }
            at = at + 1;
        }
        return true;
    }
    auto list_integrity(InstructionStore& store, i64 begin, i64 count) -> bool {
        i64 at = 0;
        while (at < count) {
            const RawOperandRow operand = store.operand_at(begin + at);
            // All nested lists contain scalar leaves. Their exact entry roles
            // and pair grouping belong to the sole native field walk.
            if (operand.role() <= 0 || operand.role() > 102 || (operand.role() >= 96 && operand.role() <= 99)
                || !scalar_payload(operand)) {
                return fail(store, InstructionError::integrity);
            }
            at = at + 1;
        }
        return true;
    }
    auto storage_integrity(InstructionStore& store, const compiler_ir_metadata::MetadataStore& metadata) -> bool {
        if (metadata.status() != compiler_ir_metadata::MetadataStatus::success || store.body_count()
            != metadata.callable_count() || !body_integrity(store)) {
            return fail(store, InstructionError::integrity);
        }
        const i64 type_begin = metadata.instruction_type_begin();
        if (type_begin < 0 || type_begin > metadata.type_count()) {
            return fail(store, InstructionError::integrity);
        }
        // Raw unresolved counts survive ingress. Reject them explicitly before
        // a native observation can reconstruct a canonical Type and lose them.
        i64 at = type_begin;
        while (at < metadata.type_count()) {
            const compiler_ir_metadata::RawTypeRow type = metadata.type_at(at);
            if (!compiler_ir_metadata::byte_range(type.name(), metadata.byte_count())) {
                return fail(store, InstructionError::integrity);
            }
            if (!compiler_ir_metadata::canonical_tail(type)) {
                return fail(store, InstructionError::noncanonical_type);
            }
            at = at + 1;
        }
        i64 next_operand = 0;
        i64 next_literal = 0;
        i64 next_type = type_begin;
        i64 instruction = 0;
        while (instruction < store.instruction_count()) {
            const RawInstructionRow row = store.instruction_at(instruction + 1);
            if (row.kind() != 1 || row.form() < 0 || row.form() > 84 || !bounded_range(row.operand_begin(),
                row.operand_count(), store.operand_count()) || (row.operand_count() != 0 && row.operand_begin()
                != next_operand)) {
                return fail(store, InstructionError::integrity);
            }
            // Each prefix is followed by its child lists in prefix order. This
            // monotone packing proves exclusive exact coverage without a bitmap.
            next_operand = next_operand + row.operand_count();
            at = 0;
            while (at < row.operand_count()) {
                const RawOperandRow operand = store.operand_at(row.operand_begin() + at);
                const i64 role = operand.role();
                if (role <= 0 || role > 102 || (role >= 96 && role <= 99)) {
                    return fail(store, InstructionError::integrity);
                }
                if (type_role(role)) {
                    if (!scalar_payload(operand) || next_type >= metadata.type_count() || operand.signed_value()
                        != next_type) {
                        return fail(store, InstructionError::integrity);
                    }
                    // Occurrences have storage identities, never semantic type identities.
                    next_type = next_type + 1;
                } else {
                    if (list_role(role)) {
                        if (!slice_payload(operand) || !bounded_range(operand.begin(), operand.count(),
                            store.operand_count()) || (operand.count() != 0 && operand.begin() != next_operand)
                            || !list_integrity(store, operand.begin(), operand.count())) {
                            return fail(store, InstructionError::integrity);
                        }
                        next_operand = next_operand + operand.count();
                    } else {
                        if (role == 33) { // LiteralBytes, packed once for each occurrence
                            if (!slice_payload(operand) || !bounded_range(operand.begin(), operand.count(),
                                store.literal_count()) || (operand.count() != 0 && operand.begin() != next_literal)) {
                                return fail(store, InstructionError::integrity);
                            }
                            next_literal = next_literal + operand.count();
                        } else {
                            if (role == 100 || role == 101) { // CalleeName, ClassName
                                if (!slice_payload(operand) || !bounded_range(operand.begin(), operand.count(),
                                    metadata.byte_count())) {
                                    return fail(store, InstructionError::integrity);
                                }
                            } else {
                                if (role == 11) { // UnsignedConstant
                                    if (operand.signed_value() != 0 || operand.begin() != 0 || operand.count() != 0) {
                                        return fail(store, InstructionError::integrity);
                                    }
                                } else {
                                    if (!scalar_payload(operand)) {
                                        return fail(store, InstructionError::integrity);
                                    }
                                }
                            }
                        }
                    }
                }
                at = at + 1;
            }
            instruction = instruction + 1;
        }
        if (next_operand != store.operand_count() || next_literal != store.literal_count() || next_type
            != metadata.type_count()) {
            return fail(store, InstructionError::integrity);
        }
        return true;
    }
    auto admit_instruction_storage(InstructionStore& store,
        const compiler_ir_metadata::MetadataStore& metadata) -> InstructionStatus {
        if (store.status() != InstructionStatus::pending) {
            return store.status();
        }
        if (!store.allocated()) {
            store.reject(InstructionError::integrity);
            return store.status();
        }
        if (!storage_integrity(store, metadata) || !store.admit()) {
            if (store.status() == InstructionStatus::pending) {
                store.reject(InstructionError::integrity);
            }
        }
        return store.status();
    }
    // Generated lowering facts pin these forms and their ordered payloads.
    // No retained binding index is needed: the admitted normalized prefix has
    // at most six entries and is the sole source of parameter-root identities.
    auto parameter_form(i64 form) -> bool {
        return form == 0 || form == 45 || form == 46 || form == 59 || form == 73 || form == 74 || form == 79;
    }
    auto entry_instruction(const InstructionStore& store, i64 callable, i64 position) -> RawInstructionRow {
        const BodyRow body = store.body_at(callable);
        if (position < 0 || position >= body.count()) {
            return RawInstructionRow(-1, -1, -1, -1);
        }
        const CodeRow code = store.code_at(body.begin() + position);
        const RawInstructionRow result = store.instruction_at(code.id());
        return result;
    }
    auto entry_operand(const InstructionStore& store, RawInstructionRow row, i64 field) -> RawOperandRow {
        const RawOperandRow result = store.operand_at(row.operand_begin() + field);
        return result;
    }
    auto entry_value(const InstructionStore& store, RawInstructionRow row, i64 field) -> i64 {
        const RawOperandRow operand = entry_operand(store, row, field);
        return operand.signed_value();
    }
    auto expected_parameter_form(const compiler_ir_metadata::MetadataStore& metadata,
        compiler_ir_metadata::RawTypeRow type) -> i64 {
        if (compiler_ir_metadata::service_type(type)) {
            return 0;
        }
        if (type.kind() == 12) {
            return 73;
        }
        if (compiler_ir_metadata::owner_kind(type)) {
            return 74;
        }
        if (compiler_ir_metadata::owning_type(metadata, type)) {
            return 79;
        }
        if (type.kind() == 5) {
            return 46;
        }
        if (compiler_ir_metadata::span_type(type)) {
            return 59;
        }
        return 45;
    }
    auto prefix_error(i64 form) -> InstructionError {
        if (form == 0) {
            return InstructionError::service_prefix;
        }
        if (form == 73) {
            return InstructionError::region_prefix;
        }
        if (form == 74) {
            return InstructionError::owner_prefix;
        }
        if (form == 79) {
            return InstructionError::owning_prefix;
        }
        if (form == 46) {
            return InstructionError::object_prefix;
        }
        if (form == 59) {
            return InstructionError::span_prefix;
        }
        return InstructionError::scalar_prefix;
    }
    auto overlap_error(i64 form) -> InstructionError {
        if (form == 0) {
            return InstructionError::service_overlap;
        }
        if (form == 74) {
            return InstructionError::owner_overlap;
        }
        if (form == 79) {
            return InstructionError::owning_overlap;
        }
        if (form == 46) {
            return InstructionError::object_overlap;
        }
        if (form == 59) {
            return InstructionError::span_overlap;
        }
        return InstructionError::scalar_overlap;
    }
    auto entry_slot(const compiler_ir_metadata::MetadataStore& metadata, i64 callable, i64 kind, i64 offset) -> i64 {
        // Instruction admission only reads successfully admitted metadata.
        const i64 index = compiler_ir_metadata::local_origin_candidate(metadata, callable, kind, offset);
        if (index < 0) {
            return -1;
        }
        const compiler_ir_metadata::SlotRow slot = metadata.slot_at(index);
        if (slot.offset() != offset) {
            return -1;
        }
        return index;
    }
    // The exact element of a span spill: -1 for a byte span, otherwise the
    // annotation's type row. Admitted metadata pairs each annotation with a spill.
    auto span_element_type(const compiler_ir_metadata::MetadataStore& metadata, i64 callable, i64 offset) -> i64 {
        const i64 annotation = entry_slot(metadata, callable, 27, offset);
        if (annotation < 0) {
            return -1;
        }
        const compiler_ir_metadata::SlotRow slot = metadata.slot_at(annotation);
        return slot.type();
    }
    // Whether a span spill holds exactly the span type a signature names.
    auto span_matches_type(const compiler_ir_metadata::MetadataStore& metadata, i64 callable, i64 offset,
        compiler_ir_metadata::RawTypeRow expected) -> bool {
        const i64 element = span_element_type(metadata, callable, offset);
        if (expected.kind() == 11) {
            return element < 0;
        }
        if (expected.kind() != 21 || element < 0) {
            return false;
        }
        const compiler_ir_metadata::RawTypeRow actual = metadata.type_at(element);
        return compiler_ir_metadata::same_type(metadata, actual, expected);
    }
    auto same_span_element(const compiler_ir_metadata::MetadataStore& metadata, i64 callable, i64 left,
        i64 right) -> bool {
        const i64 first = span_element_type(metadata, callable, left);
        const i64 second = span_element_type(metadata, callable, right);
        if (first < 0 || second < 0) {
            return first < 0 && second < 0;
        }
        const compiler_ir_metadata::RawTypeRow a = metadata.type_at(first);
        const compiler_ir_metadata::RawTypeRow b = metadata.type_at(second);
        return compiler_ir_metadata::same_type(metadata, a, b);
    }
    auto entry_has_region(const InstructionStore& store, i64 callable) -> bool {
        const RawInstructionRow first = entry_instruction(store, callable, 0);
        if (first.form() == 73 && entry_value(store, first, 0) == 0) {
            return true;
        }
        const BodyRow body = store.body_at(callable);
        if (first.form() != 0 || body.count() < 2) {
            return false;
        }
        const RawInstructionRow second = entry_instruction(store, callable, 1);
        return second.form() == 73 && entry_value(store, second, 0) == 1;
    }
    auto verify_entry_prefix(InstructionStore& store, const compiler_ir_metadata::MetadataStore& metadata,
        i64 callable) -> bool {
        const compiler_ir_metadata::CallableRow declaration = metadata.callable_at(callable);
        const i64 parameters = declaration.value_parameter_count();
        i64 position = 0;
        while (position < parameters) {
            const compiler_ir_metadata::RawTypeRow type = metadata.type_at(declaration.value_parameter_begin()
                + position);
            const i64 expected = expected_parameter_form(metadata, type);
            const RawInstructionRow row = entry_instruction(store, callable, position);
            if (row.form() != expected || entry_value(store, row, 0) != position || (expected == 73 && position != 0
                && !(position == 1 && compiler_ir_metadata::console_region_signature(metadata, declaration)))) {
                return fail(store, prefix_error(expected));
            }
            const i64 offset = entry_value(store, row, 1);
            i64 previous = 0;
            while (previous < position) {
                const RawInstructionRow earlier = entry_instruction(store, callable, previous);
                const bool same_root_kind = earlier.form() == expected || ((earlier.form() == 46 || earlier.form()
                    == 79) && (expected == 46 || expected == 79));
                if (same_root_kind && entry_value(store, earlier, 1) == offset) {
                    return fail(store, overlap_error(expected));
                }
                previous = previous + 1;
            }
            position = position + 1;
        }
        const BodyRow body = store.body_at(callable);
        while (position < body.count()) {
            const RawInstructionRow row = entry_instruction(store, callable, position);
            if (parameter_form(row.form())) {
                return fail(store, InstructionError::late_binding);
            }
            position = position + 1;
        }
        return true;
    }
    auto verify_scalar_parameter(InstructionStore& store, const compiler_ir_metadata::MetadataStore& metadata,
        i64 callable, i64 position) -> bool {
        const compiler_ir_metadata::CallableRow declaration = metadata.callable_at(callable);
        const compiler_ir_metadata::RawTypeRow expected = metadata.type_at(declaration.value_parameter_begin()
            + position);
        const RawInstructionRow row = entry_instruction(store, callable, position);
        const i64 offset = entry_value(store, row, 1);
        const compiler_ir_metadata::RawTypeRow supplied = metadata.type_at(entry_value(store, row, 2));
        if (!compiler_ir_metadata::same_type(metadata, expected, supplied)) {
            return fail(store, InstructionError::scalar_type);
        }
        // Each sorted, admitted storage group is disjoint. Its first end at or
        // above offset is the only possible containing origin. For objects,
        // check actual leaf offsets, not padding or the nominal root alone.
        const compiler_ir_metadata::IndexRange objects = compiler_ir_metadata::slot_group(metadata, declaration, 11);
        const i64 object_index = compiler_ir_metadata::slot_lower_bound(metadata, objects, offset);
        if (object_index < objects.begin() + objects.count()) {
            const compiler_ir_metadata::SlotRow object = metadata.slot_at(object_index);
            if (compiler_ir_metadata::object_has_leaf(metadata, object, offset)) {
                return fail(store, InstructionError::scalar_object);
            }
        }
        const compiler_ir_metadata::IndexRange arrays = compiler_ir_metadata::slot_group(metadata, declaration, 12);
        if (compiler_ir_metadata::first_slot_overlap(metadata, arrays, offset, offset) >= 0) {
            return fail(store, InstructionError::scalar_array);
        }
        const i64 slot_index = entry_slot(metadata, callable, 10, offset);
        if (slot_index < 0) {
            return fail(store, InstructionError::scalar_slot);
        }
        const compiler_ir_metadata::SlotRow slot = metadata.slot_at(slot_index);
        const compiler_ir_metadata::RawTypeRow slot_type = metadata.type_at(slot.type());
        if (!compiler_ir_metadata::same_type(metadata, expected, slot_type)) {
            return fail(store, InstructionError::scalar_slot);
        }
        return true;
    }
    auto verify_object_parameter(InstructionStore& store, const compiler_ir_metadata::MetadataStore& metadata,
        i64 callable, i64 position) -> bool {
        const compiler_ir_metadata::CallableRow declaration = metadata.callable_at(callable);
        const compiler_ir_metadata::RawTypeRow expected = metadata.type_at(declaration.value_parameter_begin()
            + position);
        const RawInstructionRow row = entry_instruction(store, callable, position);
        const i64 offset = entry_value(store, row, 1);
        const RawOperandRow name_operand = entry_operand(store, row, 2);
        const compiler_ir_metadata::ByteRange name = compiler_ir_metadata::ByteRange(name_operand.begin(),
            name_operand.count());
        const bool owning = row.form() == 79;
        const bool named_owner = compiler_ir_metadata::owning_class(metadata, compiler_ir_metadata::find_class(metadata,
            name));
        if (!owning && named_owner) {
            return fail(store, InstructionError::object_owner);
        }
        if (compiler_ir_metadata::compare_names(metadata, expected.name(), name) != 0 || owning != named_owner) {
            if (owning) {
                return fail(store, InstructionError::owning_type);
            }
            return fail(store, InstructionError::object_type);
        }
        if (owning && !entry_has_region(store, callable)) {
            return fail(store, InstructionError::owning_region);
        }
        const i64 slot_index = entry_slot(metadata, callable, 11, offset);
        if (slot_index < 0) {
            if (owning) {
                return fail(store, InstructionError::owning_slot);
            }
            return fail(store, InstructionError::object_slot);
        }
        const compiler_ir_metadata::SlotRow slot = metadata.slot_at(slot_index);
        const compiler_ir_metadata::RawTypeRow slot_type = metadata.type_at(slot.type());
        if (!compiler_ir_metadata::same_type(metadata, expected, slot_type)) {
            if (owning) {
                return fail(store, InstructionError::owning_slot);
            }
            return fail(store, InstructionError::object_nominal);
        }
        if (owning && slot.mutable_value() != 1) {
            return fail(store, InstructionError::owning_mutable);
        }
        if (!owning && slot.mutable_value() != 0) {
            return fail(store, InstructionError::object_readonly);
        }
        return true;
    }
    auto verify_owner_parameter(InstructionStore& store, const compiler_ir_metadata::MetadataStore& metadata,
        i64 callable, i64 position) -> bool {
        const compiler_ir_metadata::CallableRow declaration = metadata.callable_at(callable);
        const compiler_ir_metadata::RawTypeRow expected = metadata.type_at(declaration.value_parameter_begin()
            + position);
        const RawInstructionRow row = entry_instruction(store, callable, position);
        const i64 offset = entry_value(store, row, 1);
        const i64 slot_index = entry_slot(metadata, callable, 16, offset);
        if (slot_index < 0) {
            return fail(store, InstructionError::owner_slot);
        }
        const i64 annotation = entry_slot(metadata, callable, 17, offset);
        if (annotation < 0) {
            if (expected.kind() != 13) {
                return fail(store, InstructionError::owner_type);
            }
        } else {
            const compiler_ir_metadata::SlotRow nominal = metadata.slot_at(annotation);
            const compiler_ir_metadata::RawTypeRow slot_type = metadata.type_at(nominal.type());
            if (!compiler_ir_metadata::same_type(metadata, expected, slot_type)) {
                return fail(store, InstructionError::owner_type);
            }
        }
        if (!entry_has_region(store, callable)) {
            return fail(store, InstructionError::owner_region);
        }
        const compiler_ir_metadata::SlotRow slot = metadata.slot_at(slot_index);
        if (slot.mutable_value() != 1) {
            return fail(store, InstructionError::owner_mutable);
        }
        return true;
    }
    auto verify_entry_parameters(InstructionStore& store, const compiler_ir_metadata::MetadataStore& metadata,
        i64 callable) -> bool {
        const compiler_ir_metadata::FlagMasks masks = compiler_ir_metadata::FlagMasks();
        if (!verify_entry_prefix(store, metadata, callable)) {
            return false;
        }
        const compiler_ir_metadata::CallableRow declaration = metadata.callable_at(callable);
        i64 position = 0;
        while (position < declaration.value_parameter_count()) {
            const RawInstructionRow row = entry_instruction(store, callable, position);
            const i64 form = row.form();
            const i64 offset = entry_value(store, row, 1);
            if (form == 45) {
                if (!verify_scalar_parameter(store, metadata, callable, position)) {
                    return false;
                }
            } else {
                if (form == 46 || form == 79) {
                    if (!verify_object_parameter(store, metadata, callable, position)) {
                        return false;
                    }
                } else {
                    if (form == 74) {
                        if (!verify_owner_parameter(store, metadata, callable, position)) {
                            return false;
                        }
                    } else {
                        if (form == 0) {
                            const compiler_ir_metadata::RawTypeRow type = metadata.type_at(
                                declaration.value_parameter_begin() + position);
                            if (entry_value(store, row, 2) != compiler_ir_metadata::service_kind(type)
                                || entry_slot(metadata, callable, 14, offset) < 0) {
                                return fail(store, InstructionError::service_binding);
                            }
                        } else {
                            if (form == 73) {
                                if (entry_slot(metadata, callable, 15, offset) < 0) {
                                    return fail(store, InstructionError::region_slot);
                                }
                            } else {
                                const compiler_ir_metadata::ReceiverShape receiver = declaration.first_receiver();
                                if (compiler_ir_metadata::callable_flag(declaration, masks.callable_receiver())
                                    && compiler_ir_metadata::receiver_flag(receiver, masks.receiver_constructor())) {
                                    return fail(store, InstructionError::span_type);
                                }
                                if (entry_slot(metadata, callable, 13, offset) < 0) {
                                    return fail(store, InstructionError::span_slot);
                                }
                                const compiler_ir_metadata::RawTypeRow span_parameter = metadata.type_at(
                                    declaration.value_parameter_begin() + position);
                                if (!span_matches_type(metadata, callable, offset, span_parameter)) {
                                    return fail(store, InstructionError::span_type);
                                }
                            }
                        }
                    }
                }
            }
            position = position + 1;
        }
        return true;
    }
    // Static call admission reads only normalized immutable instructions and
    // admitted metadata/frame declarations. Every helper with both store roots
    // takes scalar selectors; copied rows stay local to that call boundary.
    auto call_operand(const InstructionStore& store, i64 instruction, i64 field) -> RawOperandRow {
        const RawInstructionRow row = store.instruction_at(instruction);
        const RawOperandRow result = store.operand_at(row.operand_begin() + field);
        return result;
    }
    auto call_value(const InstructionStore& store, i64 instruction, i64 field) -> i64 {
        const RawOperandRow operand = call_operand(store, instruction, field);
        return operand.signed_value();
    }
    auto call_count(const InstructionStore& store, i64 instruction, i64 field) -> i64 {
        const RawOperandRow operand = call_operand(store, instruction, field);
        return operand.count();
    }
    auto call_lane(const InstructionStore& store, i64 instruction, i64 field, i64 position) -> i64 {
        const RawOperandRow list = call_operand(store, instruction, field);
        if (list.count() == 0) {
            return 0;
        }
        const RawOperandRow operand = store.operand_at(list.begin() + position);
        return operand.signed_value();
    }
    auto call_type(const compiler_ir_metadata::MetadataStore& metadata, i64 target,
        i64 position) -> compiler_ir_metadata::RawTypeRow {
        const compiler_ir_metadata::CallableRow declaration = metadata.callable_at(target);
        const compiler_ir_metadata::IndexRange types = declaration.types();
        i64 index = types.begin();
        if (position > 0) {
            index = declaration.value_parameter_begin() + position - 1;
        }
        const compiler_ir_metadata::RawTypeRow result = metadata.type_at(index);
        return result;
    }
    auto call_has_parameter(const compiler_ir_metadata::MetadataStore& metadata, i64 target, i64 kind) -> bool {
        const compiler_ir_metadata::CallableRow declaration = metadata.callable_at(target);
        i64 at = 0;
        while (at < declaration.value_parameter_count()) {
            const compiler_ir_metadata::RawTypeRow type = metadata.type_at(declaration.value_parameter_begin() + at);
            if (type.kind() == kind) {
                return true;
            }
            at = at + 1;
        }
        return false;
    }
    auto call_objects_field(i64 form) -> i64 {
        if (form == 20) {
            return 1;
        }
        if (form == 4) {
            return 6;
        }
        if (form == 83) {
            return 2;
        }
        return 2;
    }
    auto call_result_field(i64 form) -> i64 {
        if (form == 20 || form == 4) {
            return 2;
        }
        if (form == 83) {
            return 3;
        }
        return 3;
    }
    auto call_receiver_root(const InstructionStore& store, i64 instruction) -> i64 {
        const RawInstructionRow row = store.instruction_at(instruction);
        if (row.form() == 75) {
            return call_value(store, instruction, 4);
        }
        if (row.form() == 83) {
            return call_lane(store, instruction, 1, 0);
        }
        return call_value(store, instruction, 1);
    }
    auto call_spans_field(i64 form) -> i64 {
        if (form == 83) {
            return 4;
        }
        return 5;
    }
    auto call_lane_alias(const InstructionStore& store, i64 instruction, i64 field, i64 start, i64 root) -> bool {
        // Zero lanes are absent roots, never members of a copied/transferred
        // argument set. A zero supplied for a real root fails its exact slot.
        if (root == 0) {
            return false;
        }
        i64 at = start;
        while (at < call_count(store, instruction, field)) {
            if (call_lane(store, instruction, field, at) == root) {
                return true;
            }
            at = at + 1;
        }
        return false;
    }
    auto call_private_access(const compiler_ir_metadata::MetadataStore& metadata, i64 caller, i64 target) -> bool {
        const compiler_ir_metadata::FlagMasks masks = compiler_ir_metadata::FlagMasks();
        const compiler_ir_metadata::CallableRow destination = metadata.callable_at(target);
        const compiler_ir_metadata::ReceiverShape receiver = destination.first_receiver();
        if (compiler_ir_metadata::receiver_flag(receiver, masks.receiver_public())) {
            return true;
        }
        const compiler_ir_metadata::CallableRow source = metadata.callable_at(caller);
        const compiler_ir_metadata::ReceiverShape authority = source.first_receiver();
        return compiler_ir_metadata::callable_flag(source, masks.callable_receiver()) && source.borrowed_root_count()
            == 0 && compiler_ir_metadata::compare_names(metadata, authority.name(), receiver.name()) == 0;
    }
    auto call_exact_slot(InstructionStore& store, const compiler_ir_metadata::MetadataStore& metadata, i64 caller,
        i64 kind, i64 offset, InstructionError reason) -> bool {
        if (entry_slot(metadata, caller, kind, offset) < 0) {
            return fail(store, reason);
        }
        return true;
    }
    auto call_argument_error(i64 form, bool constructor, i64 fault) -> InstructionError {
        if (form == 20) {
            if (fault == 0) {
                return InstructionError::aggregate_parameter;
            }
            if (fault == 1) {
                return InstructionError::aggregate_argument_slot;
            }
            if (fault == 2) {
                return InstructionError::aggregate_argument_alias;
            }
            if (fault == 3) {
                return InstructionError::aggregate_argument_nominal;
            }
            return InstructionError::aggregate_argument_readonly;
        }
        if (form == 4) {
            if (fault == 0) {
                return InstructionError::service_parameter;
            }
            if (fault == 1) {
                return InstructionError::service_argument_slot;
            }
            if (fault == 2) {
                return InstructionError::service_argument_alias;
            }
            if (fault == 3) {
                return InstructionError::service_argument_nominal;
            }
            return InstructionError::service_argument_readonly;
        }
        if (fault == 1) {
            return InstructionError::call_copy_slot;
        }
        if (form == 75) {
            if (fault == 2) {
                return InstructionError::constructor_argument_alias;
            }
            if (fault == 3) {
                return InstructionError::resource_copied_nominal;
            }
            if (fault == 5) {
                return InstructionError::resource_copied_receiver;
            }
            return InstructionError::resource_copied_readonly;
        }
        if (constructor) {
            if (fault == 2) {
                return InstructionError::constructor_argument_alias;
            }
            if (fault == 3) {
                return InstructionError::constructor_argument_nominal;
            }
            if (fault == 5) {
                return InstructionError::constructor_receiver_alias;
            }
            return InstructionError::constructor_argument_readonly;
        }
        if (fault == 2) {
            return InstructionError::method_argument_alias;
        }
        if (fault == 3) {
            return InstructionError::method_argument_nominal;
        }
        if (fault == 5) {
            return InstructionError::method_receiver_alias;
        }
        return InstructionError::method_argument_readonly;
    }
    auto verify_call_copy_argument(InstructionStore& store, const compiler_ir_metadata::MetadataStore& metadata,
        i64 caller, i64 instruction, i64 target, i64 position) -> bool {
        const compiler_ir_metadata::FlagMasks masks = compiler_ir_metadata::FlagMasks();
        const RawInstructionRow row = store.instruction_at(instruction);
        const i64 form = row.form();
        const compiler_ir_metadata::CallableRow destination = metadata.callable_at(target);
        const compiler_ir_metadata::ReceiverShape receiver = destination.first_receiver();
        const bool constructor = compiler_ir_metadata::receiver_flag(receiver, masks.receiver_constructor());
        const compiler_ir_metadata::RawTypeRow type = call_type(metadata, target, position + 1);
        const i64 field = call_objects_field(form);
        const i64 root = call_lane(store, instruction, field, position);
        const i64 slot_index = entry_slot(metadata, caller, 11, root);
        if (form == 20 || form == 4) {
            if (type.kind() != 5 || compiler_ir_metadata::find_class(metadata, type.name()) < 0) {
                return fail(store, call_argument_error(form, constructor, 0));
            }
            if (slot_index < 0) {
                return fail(store, call_argument_error(form, constructor, 1));
            }
        } else {
            if (form != 75 && root == call_receiver_root(store, instruction)) {
                return fail(store, call_argument_error(form, constructor, 5));
            }
        }
        if (call_lane_alias(store, instruction, field, position + 1, root)) {
            return fail(store, call_argument_error(form, constructor, 2));
        }
        if (form == 75 && root == call_receiver_root(store, instruction)) {
            return fail(store, InstructionError::resource_copied_receiver);
        }
        if (slot_index < 0) {
            return fail(store, call_argument_error(form, constructor, 1));
        }
        const compiler_ir_metadata::SlotRow slot = metadata.slot_at(slot_index);
        const compiler_ir_metadata::RawTypeRow declared = metadata.type_at(slot.type());
        if (!compiler_ir_metadata::same_type(metadata, type, declared)) {
            return fail(store, call_argument_error(form, constructor, 3));
        }
        if (slot.mutable_value() != 0) {
            return fail(store, call_argument_error(form, constructor, 4));
        }
        return true;
    }
    auto call_result_error(i64 form, i64 fault) -> InstructionError {
        if (form == 20) {
            if (fault == 0) {
                return InstructionError::aggregate_result_slot;
            }
            if (fault == 1) {
                return InstructionError::aggregate_result_alias;
            }
            return InstructionError::aggregate_result_nominal;
        }
        if (form == 75) {
            if (fault == 0) {
                return InstructionError::resource_copied_result_slot;
            }
            if (fault == 1) {
                return InstructionError::resource_copied_result_alias;
            }
            return InstructionError::resource_copied_result_nominal;
        }
        if (form == 4) {
            if (fault == 0) {
                return InstructionError::call_copy_slot;
            }
            if (fault == 1) {
                return InstructionError::service_result_alias;
            }
            return InstructionError::call_copy_nominal;
        }
        if (fault == 0) {
            return InstructionError::method_result_slot;
        }
        if (fault == 1) {
            return InstructionError::method_result_alias;
        }
        return InstructionError::method_result_nominal;
    }
    auto verify_call_copy_result(InstructionStore& store, const compiler_ir_metadata::MetadataStore& metadata,
        i64 caller, i64 instruction, i64 target) -> bool {
        const RawInstructionRow row = store.instruction_at(instruction);
        const i64 form = row.form();
        const i64 root = call_value(store, instruction, call_result_field(form));
        const i64 slot_index = entry_slot(metadata, caller, 11, root);
        if (form == 38 || form == 83) {
            if (root == call_receiver_root(store, instruction)) {
                return fail(store, InstructionError::method_result_receiver);
            }
        }
        if ((form == 20 || form == 75) && slot_index < 0) {
            return fail(store, call_result_error(form, 0));
        }
        if (call_lane_alias(store, instruction, call_objects_field(form), 0, root)) {
            return fail(store, call_result_error(form, 1));
        }
        if (slot_index < 0) {
            return fail(store, call_result_error(form, 0));
        }
        const compiler_ir_metadata::SlotRow slot = metadata.slot_at(slot_index);
        const compiler_ir_metadata::RawTypeRow declared = metadata.type_at(slot.type());
        const compiler_ir_metadata::RawTypeRow result = call_type(metadata, target, 0);
        if (!compiler_ir_metadata::same_type(metadata, result, declared)) {
            return fail(store, call_result_error(form, 2));
        }
        return true;
    }
    auto verify_plain_call(InstructionStore& store, const compiler_ir_metadata::MetadataStore& metadata,
        i64 target) -> bool {
        const compiler_ir_metadata::FlagMasks masks = compiler_ir_metadata::FlagMasks();
        const compiler_ir_metadata::CallableRow declaration = metadata.callable_at(target);
        if (compiler_ir_metadata::callable_flag(declaration, masks.callable_receiver())
            || declaration.borrowed_root_count() != 0) {
            return fail(store, InstructionError::call_receiver);
        }
        if (compiler_ir_metadata::service_signature(metadata, declaration)) {
            return fail(store, InstructionError::call_service);
        }
        if (compiler_ir_metadata::resource_signature(metadata, declaration)) {
            return fail(store, InstructionError::call_resource);
        }
        const compiler_ir_metadata::IndexRange types = declaration.types();
        i64 at = 0;
        while (at < types.count()) {
            const compiler_ir_metadata::RawTypeRow type = metadata.type_at(types.begin() + at);
            if (!compiler_ir_metadata::scalar_value(metadata, type)) {
                return fail(store, InstructionError::call_aggregate);
            }
            at = at + 1;
        }
        return true;
    }
    auto verify_aggregate_call(InstructionStore& store, const compiler_ir_metadata::MetadataStore& metadata, i64 caller,
        i64 instruction, i64 target) -> bool {
        const compiler_ir_metadata::FlagMasks masks = compiler_ir_metadata::FlagMasks();
        const compiler_ir_metadata::CallableRow declaration = metadata.callable_at(target);
        if (compiler_ir_metadata::callable_flag(declaration, masks.callable_receiver())
            || declaration.borrowed_root_count() != 0) {
            return fail(store, InstructionError::aggregate_receiver);
        }
        if (compiler_ir_metadata::service_signature(metadata, declaration)) {
            return fail(store, InstructionError::aggregate_service);
        }
        if (compiler_ir_metadata::resource_signature(metadata, declaration)) {
            return fail(store, InstructionError::aggregate_resource);
        }
        const compiler_ir_metadata::RawTypeRow result = call_type(metadata, target, 0);
        const bool spans = call_has_parameter(metadata, target, 11) || call_has_parameter(metadata, target, 21);
        if (result.kind() != 5 && !call_has_parameter(metadata, target, 5) && !spans) {
            return fail(store, InstructionError::aggregate_signature);
        }
        const i64 count = declaration.value_parameter_count();
        if (call_count(store, instruction, 1) != count) {
            return fail(store, InstructionError::aggregate_vector);
        }
        if ((spans || call_count(store, instruction, 3) != 0) && call_count(store, instruction, 3) != count) {
            return fail(store, InstructionError::aggregate_span_vector);
        }
        i64 at = count;
        while (at > 0) {
            at = at - 1;
            const compiler_ir_metadata::RawTypeRow type = call_type(metadata, target, at + 1);
            const i64 object = call_lane(store, instruction, 1, at);
            const i64 span = call_lane(store, instruction, 3, at);
            if (compiler_ir_metadata::span_type(type)) {
                if (object != 0) {
                    return fail(store, InstructionError::aggregate_span_object);
                }
                if (!call_exact_slot(store, metadata, caller, 13, span, InstructionError::call_span_slot)) {
                    return false;
                }
                if (!span_matches_type(metadata, caller, span, type)) {
                    return fail(store, InstructionError::call_span_type);
                }
            } else {
                if (span != 0) {
                    return fail(store, InstructionError::aggregate_nonspan);
                }
                if (compiler_ir_metadata::scalar_value(metadata, type)) {
                    if (object != 0) {
                        return fail(store, InstructionError::aggregate_scalar);
                    }
                } else {
                    if (!verify_call_copy_argument(store, metadata, caller, instruction, target, at)) {
                        return false;
                    }
                }
            }
        }
        if (result.kind() == 5) {
            return verify_call_copy_result(store, metadata, caller, instruction, target);
        }
        if (!compiler_ir_metadata::scalar_value(metadata, result)) {
            return fail(store, InstructionError::aggregate_result_type);
        }
        if (call_value(store, instruction, 2) != 0) {
            return fail(store, InstructionError::aggregate_scalar_result);
        }
        return true;
    }
    auto verify_call_owner_type(InstructionStore& store, const compiler_ir_metadata::MetadataStore& metadata,
        i64 caller, i64 root, i64 type_index, InstructionError reason) -> bool {
        if (!call_exact_slot(store, metadata, caller, 16, root, InstructionError::call_owner_slot)) {
            return false;
        }
        const compiler_ir_metadata::RawTypeRow type = metadata.type_at(type_index);
        const i64 annotation = entry_slot(metadata, caller, 17, root);
        if (annotation < 0) {
            if (type.kind() != 13) {
                return fail(store, reason);
            }
        } else {
            const compiler_ir_metadata::SlotRow slot = metadata.slot_at(annotation);
            const compiler_ir_metadata::RawTypeRow supplied = metadata.type_at(slot.type());
            if (!compiler_ir_metadata::same_type(metadata, type, supplied)) {
                return fail(store, reason);
            }
        }
        return true;
    }
    auto verify_resource_call(InstructionStore& store, const compiler_ir_metadata::MetadataStore& metadata, i64 caller,
        i64 instruction, i64 target) -> bool {
        const compiler_ir_metadata::FlagMasks masks = compiler_ir_metadata::FlagMasks();
        const compiler_ir_metadata::CallableRow declaration = metadata.callable_at(target);
        const compiler_ir_metadata::IndexRange types = declaration.types();
        const compiler_ir_metadata::ReceiverShape receiver = declaration.first_receiver();
        const bool constructor = compiler_ir_metadata::owning_constructor(metadata, declaration);
        if (declaration.borrowed_root_count() != 0 || !compiler_ir_metadata::resource_signature(metadata, declaration)
            || (compiler_ir_metadata::callable_flag(declaration, masks.callable_receiver()) && !constructor)
            || declaration.value_parameter_count() == 0) {
            return fail(store, InstructionError::resource_signature);
        }
        const compiler_ir_metadata::RawTypeRow first = call_type(metadata, target, 1);
        if (first.kind() != 12) {
            return fail(store, InstructionError::resource_signature);
        }
        if (constructor && !call_private_access(metadata, caller, target)) {
            return fail(store, InstructionError::resource_private);
        }
        const i64 receiver_root = call_value(store, instruction, 4);
        if ((constructor && receiver_root <= 0) || (!constructor && receiver_root != 0)) {
            return fail(store, InstructionError::resource_receiver);
        }
        const i64 region_root = call_value(store, instruction, 1);
        if (!call_exact_slot(store, metadata, caller, 15, region_root, InstructionError::call_region_slot)) {
            return false;
        }
        if (call_count(store, instruction, 2) != declaration.value_parameter_count()) {
            return fail(store, InstructionError::resource_vector);
        }
        i64 at = declaration.value_parameter_count();
        while (at > 0) {
            at = at - 1;
            const compiler_ir_metadata::RawTypeRow type = call_type(metadata, target, at + 1);
            const i64 root = call_lane(store, instruction, 2, at);
            const bool owner = compiler_ir_metadata::owner_kind(type);
            if (owner || compiler_ir_metadata::owning_type(metadata, type)) {
                if (constructor && !owner) {
                    return fail(store, InstructionError::resource_constructor_argument);
                }
                if (call_lane_alias(store, instruction, 2, at + 1, root)) {
                    return fail(store, InstructionError::resource_argument_alias);
                }
                if (root == receiver_root) {
                    return fail(store, InstructionError::resource_receiver_alias);
                }
                if (owner) {
                    if (!verify_call_owner_type(store, metadata, caller, root, declaration.value_parameter_begin() + at,
                        InstructionError::resource_argument_nominal)) {
                        return false;
                    }
                    const compiler_ir_metadata::SlotRow slot = metadata.slot_at(entry_slot(metadata, caller, 16, root));
                    if (slot.mutable_value() != 1) {
                        return fail(store, InstructionError::call_owner_mutable);
                    }
                } else {
                    const i64 slot_index = entry_slot(metadata, caller, 11, root);
                    if (slot_index < 0) {
                        return fail(store, InstructionError::call_copy_slot);
                    }
                    const compiler_ir_metadata::SlotRow slot = metadata.slot_at(slot_index);
                    const compiler_ir_metadata::RawTypeRow supplied = metadata.type_at(slot.type());
                    if (!compiler_ir_metadata::same_type(metadata, type, supplied)) {
                        return fail(store, InstructionError::call_owning_nominal);
                    }
                    if (slot.mutable_value() != 1) {
                        return fail(store, InstructionError::call_owning_mutable);
                    }
                }
            } else {
                if (constructor && type.kind() == 5) {
                    if (!verify_call_copy_argument(store, metadata, caller, instruction, target, at)) {
                        return false;
                    }
                } else {
                    if (root != 0) {
                        return fail(store, InstructionError::resource_nonowner);
                    }
                    if (at == 0) {
                        if (type.kind() != 12) {
                            return fail(store, InstructionError::resource_first);
                        }
                    } else {
                        if (!compiler_ir_metadata::scalar_value(metadata, type)) {
                            return fail(store, InstructionError::resource_parameter);
                        }
                    }
                }
            }
        }
        const compiler_ir_metadata::RawTypeRow result = call_type(metadata, target, 0);
        const i64 root = call_value(store, instruction, 3);
        if (constructor) {
            if (result.kind() != 0 || root != 0) {
                return fail(store, InstructionError::resource_constructor_result);
            }
            const i64 slot_index = entry_slot(metadata, caller, 11, receiver_root);
            if (slot_index < 0) {
                return fail(store, InstructionError::resource_constructor_root);
            }
            const compiler_ir_metadata::SlotRow slot = metadata.slot_at(slot_index);
            const compiler_ir_metadata::RawTypeRow supplied = metadata.type_at(slot.type());
            if (compiler_ir_metadata::compare_names(metadata, supplied.name(), receiver.name()) != 0) {
                return fail(store, InstructionError::resource_constructor_root);
            }
        } else {
            if (compiler_ir_metadata::owner_kind(result) || compiler_ir_metadata::owning_type(metadata, result)) {
                if (call_lane_alias(store, instruction, 2, 0, root)) {
                    return fail(store, InstructionError::resource_result_alias);
                }
                if (compiler_ir_metadata::owner_kind(result)) {
                    if (!verify_call_owner_type(store, metadata, caller, root, types.begin(),
                        InstructionError::resource_result_nominal)) {
                        return false;
                    }
                } else {
                    const i64 slot_index = entry_slot(metadata, caller, 11, root);
                    if (slot_index < 0) {
                        return fail(store, InstructionError::call_copy_slot);
                    }
                    const compiler_ir_metadata::SlotRow slot = metadata.slot_at(slot_index);
                    const compiler_ir_metadata::RawTypeRow supplied = metadata.type_at(slot.type());
                    if (!compiler_ir_metadata::same_type(metadata, result, supplied)) {
                        return fail(store, InstructionError::call_copy_nominal);
                    }
                }
            } else {
                if (result.kind() == 5) {
                    return verify_call_copy_result(store, metadata, caller, instruction, target);
                }
                if (!compiler_ir_metadata::scalar_value(metadata, result)) {
                    return fail(store, InstructionError::resource_result_type);
                }
                if (root != 0) {
                    return fail(store, InstructionError::resource_scalar_result);
                }
            }
        }
        return true;
    }
    auto call_bound_root(compiler_ir_metadata::CallableRow declaration, i64 root) -> bool {
        const compiler_ir_metadata::FlagMasks masks = compiler_ir_metadata::FlagMasks();
        // Bound before negation: hostile minimum integers never become ordinals.
        if (root > 0 || root < -5) {
            return false;
        }
        if (declaration.borrowed_root_count() > 0) {
            return 0 - root < declaration.borrowed_root_count();
        }
        return root == 0 && compiler_ir_metadata::callable_flag(declaration, masks.callable_receiver());
    }
    auto borrowed_values_type(const compiler_ir_metadata::MetadataStore& metadata, i64 callable) -> i64 {
        const compiler_ir_metadata::CallableRow row = metadata.callable_at(callable);
        if (row.borrowed_root_count() != 1) {
            return -1;
        }
        const i64 index = row.borrowed_root_type(0);
        const compiler_ir_metadata::RawTypeRow type = metadata.type_at(index);
        if (type.kind() != 17 || !row.borrowed_root_mutable(0)) {
            return -1;
        }
        return index;
    }
    // -2 is an admitted standalone OwnedBytes slot, -1 is invalid. Otherwise
    // the result is an exact owner type occurrence, including its element name.
    auto storage_owner_type(const compiler_ir_metadata::MetadataStore& metadata, i64 callable, i64 root, i64 field,
        bool mutation) -> i64 {
        if (root < 0 || field < -1) {
            return -1;
        }
        if (field == -1) {
            if (root == 0) {
                return borrowed_values_type(metadata, callable);
            }
            const i64 index = entry_slot(metadata, callable, 16, root);
            if (index < 0) {
                return -1;
            }
            const compiler_ir_metadata::SlotRow slot = metadata.slot_at(index);
            if (mutation && slot.mutable_value() != 1) {
                return -1;
            }
            const i64 annotation = entry_slot(metadata, callable, 17, root);
            if (annotation < 0) {
                return -2;
            }
            const compiler_ir_metadata::SlotRow nominal = metadata.slot_at(annotation);
            return nominal.type();
        }
        const compiler_ir_metadata::FlagMasks masks = compiler_ir_metadata::FlagMasks();
        const compiler_ir_metadata::CallableRow declaration = metadata.callable_at(callable);
        i64 class_index = -1;
        if (root == 0) {
            const compiler_ir_metadata::ReceiverShape receiver = declaration.first_receiver();
            if (declaration.borrowed_root_count() != 0 || !compiler_ir_metadata::callable_flag(declaration,
                masks.callable_receiver()) || compiler_ir_metadata::receiver_flag(receiver,
                masks.receiver_constructor()) || (mutation && !compiler_ir_metadata::receiver_flag(receiver,
                masks.receiver_mutable()))) {
                return -1;
            }
            class_index = compiler_ir_metadata::find_class(metadata, receiver.name());
        } else {
            const i64 index = entry_slot(metadata, callable, 11, root);
            if (index < 0) {
                return -1;
            }
            const compiler_ir_metadata::SlotRow slot = metadata.slot_at(index);
            if (mutation && slot.mutable_value() != 1) {
                return -1;
            }
            const compiler_ir_metadata::RawTypeRow type = metadata.type_at(slot.type());
            if (type.kind() != 5) {
                return -1;
            }
            class_index = compiler_ir_metadata::find_class(metadata, type.name());
        }
        if (class_index < 0) {
            return -1;
        }
        const compiler_ir_metadata::ClassResultRow shape = metadata.result_at(class_index);
        const compiler_ir_metadata::IndexRange fields = shape.fields();
        if (field >= fields.count()) {
            return -1;
        }
        const compiler_ir_metadata::FieldRow selected = metadata.field_at(fields.begin() + field);
        const compiler_ir_metadata::RawTypeRow type = metadata.type_at(selected.type());
        if (selected.array_flag() != 0 || !compiler_ir_metadata::owner_kind(type)) {
            return -1;
        }
        return selected.type();
    }
    auto values_field_authority(const compiler_ir_metadata::MetadataStore& metadata, i64 callable, i64 root,
        i64 field) -> bool {
        if (field == -1) {
            return true;
        }
        if (root != 0) {
            return false;
        }
        const compiler_ir_metadata::FlagMasks masks = compiler_ir_metadata::FlagMasks();
        const compiler_ir_metadata::CallableRow declaration = metadata.callable_at(callable);
        const compiler_ir_metadata::ReceiverShape receiver = declaration.first_receiver();
        return declaration.borrowed_root_count() == 0 && compiler_ir_metadata::callable_flag(declaration,
            masks.callable_receiver()) && !compiler_ir_metadata::receiver_flag(receiver, masks.receiver_constructor())
            && compiler_ir_metadata::receiver_flag(receiver, masks.receiver_mutable());
    }
    auto verify_borrowed_values_root(InstructionStore& store, const compiler_ir_metadata::MetadataStore& metadata,
        i64 caller, i64 target_type, i64 root, i64 field) -> bool {
        const i64 actual_index = storage_owner_type(metadata, caller, root, field, true);
        if (actual_index < 0 || !values_field_authority(metadata, caller, root, field)) {
            return fail(store, InstructionError::borrowed_root);
        }
        const compiler_ir_metadata::RawTypeRow actual = metadata.type_at(actual_index);
        const compiler_ir_metadata::RawTypeRow expected = metadata.type_at(target_type);
        if (actual.kind() != 17 || !compiler_ir_metadata::same_type(metadata, actual, expected)) {
            return fail(store, InstructionError::borrowed_root);
        }
        return true;
    }
    auto call_formal(const compiler_ir_metadata::MetadataStore& metadata, i64 callable,
        i64 root) -> compiler_ir_metadata::ReceiverShape {
        const compiler_ir_metadata::FlagMasks masks = compiler_ir_metadata::FlagMasks();
        const compiler_ir_metadata::CallableRow declaration = metadata.callable_at(callable);
        if (!call_bound_root(declaration, root)) {
            return compiler_ir_metadata::ReceiverShape(compiler_ir_metadata::ByteRange(0, 0), 0u64);
        }
        if (declaration.borrowed_root_count() > 0) {
            const i64 ordinal = 0 - root;
            const compiler_ir_metadata::RawTypeRow type = metadata.type_at(declaration.borrowed_root_type(ordinal));
            if (type.kind() != 5) {
                return compiler_ir_metadata::ReceiverShape(compiler_ir_metadata::ByteRange(0, 0), 0u64);
            }
            u64 flags = masks.receiver_public();
            if (declaration.borrowed_root_mutable(ordinal)) {
                flags = flags | masks.receiver_mutable();
            }
            return compiler_ir_metadata::ReceiverShape(type.name(), flags);
        }
        const compiler_ir_metadata::ReceiverShape result = declaration.first_receiver();
        return result;
    }
    auto call_root_name(const compiler_ir_metadata::MetadataStore& metadata, i64 caller,
        i64 root) -> compiler_ir_metadata::ByteRange {
        if (root <= 0) {
            const compiler_ir_metadata::ReceiverShape formal = call_formal(metadata, caller, root);
            const compiler_ir_metadata::ByteRange result = formal.name();
            return result;
        }
        const compiler_ir_metadata::SlotRow slot = metadata.slot_at(entry_slot(metadata, caller, 11, root));
        const compiler_ir_metadata::RawTypeRow type = metadata.type_at(slot.type());
        const compiler_ir_metadata::ByteRange result = type.name();
        return result;
    }
    auto verify_borrowed_call_root(InstructionStore& store, const compiler_ir_metadata::MetadataStore& metadata,
        i64 caller, i64 target, i64 instruction, i64 ordinal) -> bool {
        const i64 root = call_lane(store, instruction, 1, 3 * ordinal);
        const i64 field = call_lane(store, instruction, 1, 3 * ordinal + 2);
        const compiler_ir_metadata::CallableRow destination = metadata.callable_at(target);
        const i64 target_index = destination.borrowed_root_type(ordinal);
        const compiler_ir_metadata::RawTypeRow target_type = metadata.type_at(target_index);
        if (target_type.kind() == 17) {
            return verify_borrowed_values_root(store, metadata, caller, target_index, root, field);
        }
        if (target_type.kind() != 5 || field != -1) {
            return fail(store, InstructionError::borrowed_root);
        }
        const compiler_ir_metadata::FlagMasks masks = compiler_ir_metadata::FlagMasks();
        const compiler_ir_metadata::CallableRow source = metadata.callable_at(caller);
        const compiler_ir_metadata::ReceiverShape receiver = call_formal(metadata, target, 0 - ordinal);
        if (root < -5) {
            return fail(store, InstructionError::borrowed_selector);
        }
        if (root <= 0) {
            if (!call_bound_root(source, root)) {
                return fail(store, InstructionError::borrowed_unbound);
            }
            const compiler_ir_metadata::ReceiverShape formal = call_formal(metadata, caller, root);
            if (compiler_ir_metadata::receiver_flag(formal, masks.receiver_constructor())
                || compiler_ir_metadata::compare_names(metadata, formal.name(), receiver.name()) != 0
                || (compiler_ir_metadata::receiver_flag(receiver, masks.receiver_mutable())
                && !compiler_ir_metadata::receiver_flag(formal, masks.receiver_mutable()))) {
                return fail(store, InstructionError::borrowed_root);
            }
        } else {
            const i64 slot_index = entry_slot(metadata, caller, 11, root);
            if (slot_index < 0) {
                return fail(store, InstructionError::borrowed_root);
            }
            const compiler_ir_metadata::SlotRow slot = metadata.slot_at(slot_index);
            const compiler_ir_metadata::RawTypeRow type = metadata.type_at(slot.type());
            if (compiler_ir_metadata::compare_names(metadata, type.name(), receiver.name()) != 0
                || (compiler_ir_metadata::receiver_flag(receiver, masks.receiver_mutable()) && slot.mutable_value()
                != 1)) {
                return fail(store, InstructionError::borrowed_root);
            }
        }
        // Exact nominal type and admitted root signature prove owning shape.
        // Live ownership and each loan's recorded site remain dynamic facts.
        return true;
    }
    auto verify_method_field(InstructionStore& store, const compiler_ir_metadata::MetadataStore& metadata, i64 caller,
        i64 instruction, i64 target) -> bool {
        const compiler_ir_metadata::FlagMasks masks = compiler_ir_metadata::FlagMasks();
        const compiler_ir_metadata::ReceiverShape receiver = call_formal(metadata, target, 0);
        const i64 root = call_value(store, instruction, 1);
        const i64 field_index = call_value(store, instruction, 4);
        if (compiler_ir_metadata::receiver_flag(receiver, masks.receiver_constructor())) {
            return fail(store, InstructionError::method_nested_constructor);
        }
        if (root < 0) {
            return fail(store, InstructionError::method_field_root);
        }
        const compiler_ir_metadata::CallableRow source = metadata.callable_at(caller);
        if (root == 0) {
            if (source.borrowed_root_count() != 0) {
                return fail(store, InstructionError::method_field_authority);
            }
            if (!compiler_ir_metadata::callable_flag(source, masks.callable_receiver())) {
                return fail(store, InstructionError::method_field_unbound);
            }
        } else {
            const i64 slot_index = entry_slot(metadata, caller, 11, root);
            if (slot_index < 0) {
                return fail(store, InstructionError::call_copy_slot);
            }
            const compiler_ir_metadata::SlotRow slot = metadata.slot_at(slot_index);
            if (compiler_ir_metadata::receiver_flag(receiver, masks.receiver_mutable()) && slot.mutable_value() != 1) {
                return fail(store, InstructionError::method_field_mutable);
            }
        }
        const compiler_ir_metadata::ByteRange name = call_root_name(metadata, caller, root);
        const compiler_ir_metadata::ClassResultRow shape = metadata.result_at(compiler_ir_metadata::find_class(metadata,
            name));
        const compiler_ir_metadata::IndexRange fields = shape.fields();
        if (field_index >= fields.count()) {
            if (root == 0) {
                return fail(store, InstructionError::method_field_layout);
            }
            return fail(store, InstructionError::method_field_range);
        }
        if (root == 0) {
            const compiler_ir_metadata::ReceiverShape formal = source.first_receiver();
            if (compiler_ir_metadata::receiver_flag(formal, masks.receiver_constructor())) {
                return fail(store, InstructionError::method_field_constructor);
            }
            if (compiler_ir_metadata::receiver_flag(receiver, masks.receiver_mutable())
                && !compiler_ir_metadata::receiver_flag(formal, masks.receiver_mutable())) {
                return fail(store, InstructionError::method_field_formal_mutable);
            }
        }
        const compiler_ir_metadata::FieldRow field = metadata.field_at(fields.begin() + field_index);
        const compiler_ir_metadata::RawTypeRow type = metadata.type_at(field.type());
        if (field.array_flag() != 0 || type.kind() != 5) {
            return fail(store, InstructionError::method_field_class);
        }
        if (compiler_ir_metadata::compare_names(metadata, type.name(), receiver.name()) != 0) {
            return fail(store, InstructionError::method_field_nominal);
        }
        return true;
    }
    auto verify_method_receiver(InstructionStore& store, const compiler_ir_metadata::MetadataStore& metadata,
        i64 caller, i64 instruction, i64 target) -> bool {
        const compiler_ir_metadata::FlagMasks masks = compiler_ir_metadata::FlagMasks();
        const RawInstructionRow row = store.instruction_at(instruction);
        const compiler_ir_metadata::CallableRow source = metadata.callable_at(caller);
        const compiler_ir_metadata::ReceiverShape receiver = call_formal(metadata, target, 0);
        const i64 root = call_value(store, instruction, 1);
        if (root < 0 && !call_bound_root(source, root)) {
            return fail(store, InstructionError::method_offset);
        }
        if (row.form() == 38) {
            const i64 field = call_value(store, instruction, 4);
            if (field < -1) {
                return fail(store, InstructionError::method_field_index);
            }
            if (field >= 0) {
                return verify_method_field(store, metadata, caller, instruction, target);
            }
        }
        if (root <= 0) {
            if (!call_bound_root(source, root)) {
                return fail(store, InstructionError::method_forward_unbound);
            }
            const compiler_ir_metadata::ReceiverShape formal = call_formal(metadata, caller, root);
            if (compiler_ir_metadata::receiver_flag(formal, masks.receiver_constructor())
                || compiler_ir_metadata::receiver_flag(receiver, masks.receiver_constructor())) {
                return fail(store, InstructionError::method_forward_constructor);
            }
            if (compiler_ir_metadata::compare_names(metadata, formal.name(), receiver.name()) != 0) {
                return fail(store, InstructionError::method_forward_nominal);
            }
            if (compiler_ir_metadata::receiver_flag(receiver, masks.receiver_mutable())
                && !compiler_ir_metadata::receiver_flag(formal, masks.receiver_mutable())) {
                return fail(store, InstructionError::method_forward_mutable);
            }
        } else {
            const i64 slot_index = entry_slot(metadata, caller, 11, root);
            if (slot_index < 0) {
                return fail(store, InstructionError::method_receiver_slot);
            }
            const compiler_ir_metadata::SlotRow slot = metadata.slot_at(slot_index);
            const compiler_ir_metadata::RawTypeRow type = metadata.type_at(slot.type());
            if (compiler_ir_metadata::compare_names(metadata, type.name(), receiver.name()) != 0) {
                return fail(store, InstructionError::method_receiver_nominal);
            }
            if (!compiler_ir_metadata::receiver_flag(receiver, masks.receiver_constructor())
                && compiler_ir_metadata::receiver_flag(receiver, masks.receiver_mutable()) && slot.mutable_value()
                != 1) {
                return fail(store, InstructionError::method_receiver_mutable);
            }
        }
        return true;
    }
    auto verify_call_span_result(InstructionStore& store, const compiler_ir_metadata::MetadataStore& metadata,
        i64 caller, i64 root) -> bool {
        if (!call_exact_slot(store, metadata, caller, 13, root, InstructionError::call_span_slot)) {
            return false;
        }
        const compiler_ir_metadata::CallableRow source = metadata.callable_at(caller);
        i64 at = 0;
        while (at < source.value_parameter_count()) {
            const RawInstructionRow binding = entry_instruction(store, caller, at);
            if (binding.form() == 59 && entry_value(store, binding, 1) == root) {
                return fail(store, InstructionError::call_span_parameter);
            }
            at = at + 1;
        }
        return true;
    }
    auto verify_method_call(InstructionStore& store, const compiler_ir_metadata::MetadataStore& metadata, i64 caller,
        i64 instruction, i64 target) -> bool {
        const compiler_ir_metadata::FlagMasks masks = compiler_ir_metadata::FlagMasks();
        const RawInstructionRow row = store.instruction_at(instruction);
        const bool borrowed = row.form() == 83;
        const compiler_ir_metadata::CallableRow declaration = metadata.callable_at(target);
        const i64 root_count = declaration.borrowed_root_count();
        if (borrowed) {
            if (root_count < 1 || root_count > 4) {
                return fail(store, InstructionError::borrowed_target);
            }
            if (call_count(store, instruction, 1) != 3 * root_count) {
                return fail(store, InstructionError::borrowed_roots);
            }
            i64 ordinal = 0;
            while (ordinal < root_count) {
                const i64 root = call_lane(store, instruction, 1, 3 * ordinal);
                const i64 loan = call_lane(store, instruction, 1, 3 * ordinal + 1);
                if (loan <= 0) {
                    return fail(store, InstructionError::borrowed_loan);
                }
                i64 previous = 0;
                while (previous < ordinal) {
                    if (root == call_lane(store, instruction, 1, 3 * previous) || loan == call_lane(store, instruction,
                        1, 3 * previous + 1)) {
                        return fail(store, InstructionError::borrowed_roots);
                    }
                    previous = previous + 1;
                }
                if (!verify_borrowed_call_root(store, metadata, caller, target, instruction, ordinal)) {
                    return false;
                }
                ordinal = ordinal + 1;
            }
        } else {
            if (root_count != 0) {
                return fail(store, InstructionError::method_borrowed);
            }
            if (!compiler_ir_metadata::callable_flag(declaration, masks.callable_receiver())) {
                return fail(store, InstructionError::method_receiver);
            }
            if (!call_private_access(metadata, caller, target)) {
                return fail(store, InstructionError::method_private);
            }
        }
        const compiler_ir_metadata::ReceiverShape receiver = call_formal(metadata, target, 0);
        const bool constructor = compiler_ir_metadata::receiver_flag(receiver, masks.receiver_constructor());
        const i64 root = call_receiver_root(store, instruction);
        if (compiler_ir_metadata::resource_signature(metadata, declaration)) {
            return fail(store, InstructionError::method_resource);
        }
        const compiler_ir_metadata::RawTypeRow result = call_type(metadata, target, 0);
        if (root_count > 1 && !compiler_ir_metadata::scalar_value(metadata, result)) {
            return fail(store, InstructionError::method_signature);
        }
        if (!compiler_ir_metadata::scalar_value(metadata, result) && !(!constructor && result.kind() == 5)
            && !(compiler_ir_metadata::span_type(result) && compiler_ir_metadata::callable_flag(declaration,
            masks.callable_span_summary()) && !compiler_ir_metadata::receiver_flag(receiver, masks.receiver_mutable())
            && !constructor)) {
            return fail(store, InstructionError::method_signature);
        }
        i64 at = 1;
        while (at <= declaration.value_parameter_count()) {
            const compiler_ir_metadata::RawTypeRow type = call_type(metadata, target, at);
            if (root_count > 1 && !compiler_ir_metadata::scalar_value(metadata, type)) {
                return fail(store, InstructionError::method_signature);
            }
            if (!compiler_ir_metadata::scalar_value(metadata, type) && type.kind() != 5 && !(!constructor
                && compiler_ir_metadata::span_type(type))) {
                return fail(store, InstructionError::method_signature);
            }
            at = at + 1;
        }
        const bool spans = call_has_parameter(metadata, target, 11) || call_has_parameter(metadata, target, 21);
        const bool aggregate = spans || call_has_parameter(metadata, target, 5);
        const i64 count = declaration.value_parameter_count();
        const i64 objects = call_objects_field(row.form());
        const i64 span_field = call_spans_field(row.form());
        if (borrowed_values_type(metadata, target) >= 0 && (call_count(store, instruction, span_field) != 0
            || call_value(store, instruction, call_result_field(row.form())) != 0)) {
            return fail(store, InstructionError::borrowed_roots);
        }
        // Multiple roots have scalar-only tails/results. In particular an
        // all-zero nonempty span list is not the canonical empty lane shape.
        if (root_count > 1 && (call_count(store, instruction, objects) != 0 || call_count(store, instruction,
            span_field) != 0 || call_value(store, instruction, call_result_field(row.form())) != 0)) {
            return fail(store, InstructionError::borrowed_roots);
        }
        if ((aggregate && call_count(store, instruction, objects) != count) || (!aggregate && call_count(store,
            instruction, objects) != 0)) {
            if (constructor) {
                return fail(store, InstructionError::constructor_vector);
            }
            return fail(store, InstructionError::method_vector);
        }
        if ((spans || call_count(store, instruction, span_field) != 0) && call_count(store, instruction, span_field)
            != count) {
            return fail(store, InstructionError::method_span_vector);
        }
        at = count;
        while (at > 0) {
            at = at - 1;
            const compiler_ir_metadata::RawTypeRow type = call_type(metadata, target, at + 1);
            const i64 object = call_lane(store, instruction, objects, at);
            const i64 span = call_lane(store, instruction, span_field, at);
            if (compiler_ir_metadata::span_type(type)) {
                if (object != 0) {
                    return fail(store, InstructionError::method_span_object);
                }
                if (!call_exact_slot(store, metadata, caller, 13, span, InstructionError::call_span_slot)) {
                    return false;
                }
                if (!span_matches_type(metadata, caller, span, type)) {
                    return fail(store, InstructionError::call_span_type);
                }
            } else {
                if (span != 0) {
                    return fail(store, InstructionError::method_nonspan);
                }
                if (compiler_ir_metadata::scalar_value(metadata, type)) {
                    if (object != 0) {
                        if (constructor) {
                            return fail(store, InstructionError::constructor_scalar);
                        }
                        return fail(store, InstructionError::method_scalar);
                    }
                } else {
                    if (!verify_call_copy_argument(store, metadata, caller, instruction, target, at)) {
                        return false;
                    }
                }
            }
        }
        if (!borrowed && !verify_method_receiver(store, metadata, caller, instruction, target)) {
            return false;
        }
        const i64 result_root = call_value(store, instruction, call_result_field(row.form()));
        if (compiler_ir_metadata::span_type(result)) {
            if (!span_matches_type(metadata, caller, result_root, result)) {
                return fail(store, InstructionError::call_span_type);
            }
            const compiler_ir_metadata::CallableRow source = metadata.callable_at(caller);
            if (source.borrowed_root_count() > 1 && root <= 0) {
                return fail(store, InstructionError::method_span_multiple);
            }
            if (!borrowed && call_value(store, instruction, 4) != -1) {
                return fail(store, InstructionError::method_span_direct);
            }
            if (!compiler_ir_metadata::callable_flag(declaration, masks.callable_span_summary())) {
                return fail(store, InstructionError::method_span_summary);
            }
            // Admitted summary plus exact receiver nominal identity already
            // proves a direct u8 array or OwnedBytes field, including its index.
            return verify_call_span_result(store, metadata, caller, result_root);
        }
        if (result.kind() == 5) {
            return verify_call_copy_result(store, metadata, caller, instruction, target);
        }
        if (result_root != 0) {
            return fail(store, InstructionError::method_scalar_result);
        }
        return true;
    }
    auto verify_service_call(InstructionStore& store, const compiler_ir_metadata::MetadataStore& metadata, i64 caller,
        i64 instruction, i64 target) -> bool {
        const compiler_ir_metadata::FlagMasks masks = compiler_ir_metadata::FlagMasks();
        const compiler_ir_metadata::CallableRow declaration = metadata.callable_at(target);
        if (declaration.borrowed_root_count() != 0 || !compiler_ir_metadata::service_signature(metadata, declaration)
            || compiler_ir_metadata::callable_flag(declaration, masks.callable_receiver())) {
            return fail(store, InstructionError::service_signature);
        }
        const i64 parameters = declaration.value_parameter_count();
        const bool mixed = compiler_ir_metadata::console_region_signature(metadata, declaration);
        const i64 region = call_value(store, instruction, 7);
        if (mixed) {
            if (!call_exact_slot(store, metadata, caller, 15, region, InstructionError::call_region_slot)) {
                return false;
            }
        } else {
            if (region != 0) {
                return fail(store, InstructionError::call_region_slot);
            }
        }
        i64 count = 0;
        i64 at = 1;
        while (at <= declaration.value_parameter_count()) {
            const compiler_ir_metadata::RawTypeRow type = call_type(metadata, target, at);
            if (compiler_ir_metadata::service_type(type)) {
                count = count + 1;
            }
            at = at + 1;
        }
        if (count < 1 || count > 2 || call_count(store, instruction, 5) != 2 * (count - 1) || call_count(store,
            instruction, 3) != parameters) {
            return fail(store, InstructionError::service_vector);
        }
        if ((call_has_parameter(metadata, target, 5) || call_count(store, instruction, 6) != 0) && call_count(store,
            instruction, 6) != parameters) {
            return fail(store, InstructionError::service_object_vector);
        }
        // These are immutable explicit IDs and kinds only. Never infer roots,
        // identity or suspension by scanning textual loan acquisitions: CFG
        // execution may acquire later in text, and completed IDs may be reused.
        at = 0;
        while (at < count) {
            i64 loan = call_value(store, instruction, 1);
            i64 kind = call_value(store, instruction, 4);
            if (at != 0) {
                loan = call_lane(store, instruction, 5, 0);
                kind = call_lane(store, instruction, 5, 1);
            }
            const compiler_ir_metadata::RawTypeRow type = call_type(metadata, target, at + 1);
            if (loan <= 0 || (at != 0 && loan == call_value(store, instruction, 1)) || call_lane(store, instruction, 3,
                at) != 0 || call_lane(store, instruction, 6, at) != 0 || !compiler_ir_metadata::service_type(type)) {
                return fail(store, InstructionError::service_leading);
            }
            if (kind != compiler_ir_metadata::service_kind(type)) {
                return fail(store, InstructionError::service_kind);
            }
            at = at + 1;
        }
        at = parameters;
        while (at > count) {
            at = at - 1;
            const compiler_ir_metadata::RawTypeRow type = call_type(metadata, target, at + 1);
            const i64 span = call_lane(store, instruction, 3, at);
            const i64 object = call_lane(store, instruction, 6, at);
            if (mixed && at == 1) {
                if (span != 0 || object != 0) {
                    return fail(store, InstructionError::service_scalar);
                }
            } else {
                if (type.kind() == 11) {
                    if (object != 0) {
                        return fail(store, InstructionError::service_span_object);
                    }
                    if (!call_exact_slot(store, metadata, caller, 13, span, InstructionError::call_span_slot)) {
                        return false;
                    }
                } else {
                    if (type.kind() == 5) {
                        if (span != 0) {
                            return fail(store, InstructionError::service_object_span);
                        }
                        if (!verify_call_copy_argument(store, metadata, caller, instruction, target, at)) {
                            return false;
                        }
                    } else {
                        if (span != 0 || object != 0 || !compiler_ir_metadata::scalar_value(metadata, type)) {
                            return fail(store, InstructionError::service_scalar);
                        }
                    }
                }
            }
        }
        const compiler_ir_metadata::RawTypeRow result = call_type(metadata, target, 0);
        if (result.kind() == 5) {
            return verify_call_copy_result(store, metadata, caller, instruction, target);
        }
        if (call_value(store, instruction, 2) != 0 || !compiler_ir_metadata::scalar_value(metadata, result)) {
            return fail(store, InstructionError::service_scalar_result);
        }
        return true;
    }
    auto verify_call_site(InstructionStore& store, const compiler_ir_metadata::MetadataStore& metadata, i64 caller,
        i64 instruction) -> bool {
        const RawInstructionRow row = store.instruction_at(instruction);
        const i64 form = row.form();
        if (form != 19 && form != 20 && form != 75 && form != 38 && form != 83 && form != 4) {
            return true;
        }
        const RawOperandRow operand = call_operand(store, instruction, 0);
        const compiler_ir_metadata::ByteRange name = compiler_ir_metadata::ByteRange(operand.begin(), operand.count());
        if (form == 19 && compiler_ir_metadata::name_prefix(metadata, name, "__au_runtime_")) {
            return fail(store, InstructionError::call_runtime);
        }
        const i64 target = compiler_ir_metadata::first_named_callable(metadata, name);
        if (target < 0) {
            if (form == 19) {
                return fail(store, InstructionError::call_target);
            }
            if (form == 20) {
                return fail(store, InstructionError::aggregate_target);
            }
            if (form == 75) {
                return fail(store, InstructionError::resource_target);
            }
            if (form == 4) {
                return fail(store, InstructionError::service_target);
            }
            return fail(store, InstructionError::method_target);
        }
        if (form == 19) {
            return verify_plain_call(store, metadata, target);
        }
        if (form == 20) {
            return verify_aggregate_call(store, metadata, caller, instruction, target);
        }
        if (form == 75) {
            return verify_resource_call(store, metadata, caller, instruction, target);
        }
        if (form == 4) {
            return verify_service_call(store, metadata, caller, instruction, target);
        }
        return verify_method_call(store, metadata, caller, instruction, target);
    }
    auto verify_call_sites(InstructionStore& store, const compiler_ir_metadata::MetadataStore& metadata) -> bool {
        i64 caller = 0;
        while (caller < store.body_count()) {
            const BodyRow body = store.body_at(caller);
            i64 position = 0;
            while (position < body.count()) {
                const CodeRow code = store.code_at(body.begin() + position);
                if (!verify_call_site(store, metadata, caller, code.id())) {
                    return false;
                }
                position = position + 1;
            }
            caller = caller + 1;
        }
        return true;
    }
    auto verify_constructor_signatures(InstructionStore& store,
        const compiler_ir_metadata::MetadataStore& metadata) -> bool {
        const compiler_ir_metadata::FlagMasks masks = compiler_ir_metadata::FlagMasks();
        i64 callable = 0;
        while (callable < metadata.callable_count()) {
            const compiler_ir_metadata::CallableRow row = metadata.callable_at(callable);
            const compiler_ir_metadata::ReceiverShape receiver = row.first_receiver();
            if (compiler_ir_metadata::callable_flag(row, masks.callable_receiver())
                && compiler_ir_metadata::receiver_flag(receiver, masks.receiver_constructor())) {
                const compiler_ir_metadata::RawTypeRow result = call_type(metadata, callable, 0);
                if (!compiler_ir_metadata::receiver_flag(receiver, masks.receiver_mutable())
                    || !compiler_ir_metadata::plain_type(result, 0)) {
                    return fail(store, InstructionError::constructor_signature);
                }
            }
            callable = callable + 1;
        }
        return true;
    }
    // These checks depend only on admitted declarations and normalized operands.
    // Exact origins come from ordered canonical metadata, never a second frame
    // map or a retained instruction summary. Native State owns the changing
    // lifetime, loan, current-value and bounds-token evidence; the separate
    // initialization workspace owns local scalar must/may facts.
    auto verify_object_loan_site(InstructionStore& store, const compiler_ir_metadata::MetadataStore& metadata,
        i64 callable, i64 instruction) -> bool {
        const i64 root = call_value(store, instruction, 1);
        const i64 field = call_value(store, instruction, 3);
        // Canonical class-root acquisitions keep their original native phase
        // and diagnostic order. Only the new builtin places are admitted here.
        if (field == -1 && !(root == 0 && borrowed_values_type(metadata, callable) >= 0) && entry_slot(metadata,
            callable, 16, root) < 0) {
            return true;
        }
        const i64 loan = call_value(store, instruction, 0);
        const i64 mutable_value = call_value(store, instruction, 2);
        const i64 owner = storage_owner_type(metadata, callable, root, field, true);
        if (loan <= 0 || mutable_value != 1 || owner < 0) {
            return fail(store, InstructionError::borrowed_root);
        }
        return verify_borrowed_values_root(store, metadata, callable, owner, root, field);
    }
    auto verify_values_copy(InstructionStore& store, const compiler_ir_metadata::MetadataStore& metadata, i64 callable,
        i64 owner, i64 instruction, bool snapshot) -> bool {
        const i64 root = call_value(store, instruction, 0);
        const i64 value = call_value(store, instruction, 2);
        if (owner < 0 || value == root) {
            return fail(store, InstructionError::borrowed_root);
        }
        const compiler_ir_metadata::RawTypeRow type = metadata.type_at(owner);
        const i64 index = entry_slot(metadata, callable, 11, value);
        if (type.kind() != 17 || index < 0) {
            return fail(store, InstructionError::borrowed_root);
        }
        const compiler_ir_metadata::SlotRow slot = metadata.slot_at(index);
        const compiler_ir_metadata::RawTypeRow element = metadata.type_at(slot.type());
        if (element.kind() != 5 || compiler_ir_metadata::compare_names(metadata, type.name(), element.name()) != 0
            || (snapshot && slot.mutable_value() != 0)) {
            return fail(store, InstructionError::borrowed_root);
        }
        return true;
    }
    auto verify_owner_instruction(InstructionStore& store, const compiler_ir_metadata::MetadataStore& metadata,
        i64 callable, i64 instruction) -> bool {
        const RawInstructionRow row = store.instruction_at(instruction);
        const i64 form = row.form();
        if (form == 81) {
            return verify_object_loan_site(store, metadata, callable, instruction);
        }
        if (borrowed_values_type(metadata, callable) < 0) {
            return true;
        }
        i64 root = 0;
        if (row.operand_count() > 0) {
            root = call_value(store, instruction, 0);
        }
        if ((form == 63 || form == 64 || form == 65) && root <= 0) {
            const i64 field = call_value(store, instruction, 1);
            const i64 owner = storage_owner_type(metadata, callable, root, field, form != 63);
            return verify_values_copy(store, metadata, callable, owner, instruction, form != 63);
        }
        // Ownership operations cannot consume, replace, allocate or drop the
        // borrowed descriptor. Existing standalone owners remain native facts.
        if (((form == 60 || form == 72 || form == 76 || form == 80) && root <= 0) || ((form == 66 || form == 78)
            && (root <= 0 || call_value(store, instruction, 1) <= 0)) || ((form == 61 || form == 62) && (root <= 0
            || call_value(store, instruction, 1) <= 0))) {
            return fail(store, InstructionError::borrowed_root);
        }
        // The element's name gives no field, receiver, byte-view or owning
        // authority. A builtin root is usable only through typed operations.
        if ((form >= 32 && form <= 37) || form == 50 || ((form >= 25 && form <= 31) && root <= 0) || (form == 77
            && (root <= 0 || call_value(store, instruction, 2) <= 0))) {
            return fail(store, InstructionError::borrowed_root);
        }
        if ((form == 52 || (form >= 67 && form <= 71)) && root <= 0) {
            const i64 field = call_value(store, instruction, 1);
            if (root != 0 || field != -1 || (form != 67 && form != 68)) {
                return fail(store, InstructionError::borrowed_root);
            }
        }
        return true;
    }
    auto verify_storage_scalar(InstructionStore& store, const compiler_ir_metadata::MetadataStore& metadata,
        i64 callable, i64 offset, i64 type_index) -> bool {
        const i64 slot_index = entry_slot(metadata, callable, 10, offset);
        if (slot_index < 0) {
            return fail(store, InstructionError::scalar_slot);
        }
        const compiler_ir_metadata::SlotRow slot = metadata.slot_at(slot_index);
        const compiler_ir_metadata::RawTypeRow declared = metadata.type_at(slot.type());
        const compiler_ir_metadata::RawTypeRow supplied = metadata.type_at(type_index);
        if (!compiler_ir_metadata::same_type(metadata, declared, supplied)) {
            return fail(store, InstructionError::scalar_slot);
        }
        return true;
    }
    auto verify_storage_borrow(InstructionStore& store, const compiler_ir_metadata::MetadataStore& metadata,
        i64 callable, i64 instruction) -> bool {
        const i64 offset = call_value(store, instruction, 0);
        const i64 slot_index = entry_slot(metadata, callable, 10, offset);
        if (slot_index < 0) {
            return fail(store, InstructionError::scalar_slot);
        }
        const compiler_ir_metadata::SlotRow slot = metadata.slot_at(slot_index);
        const compiler_ir_metadata::RawTypeRow declared = metadata.type_at(slot.type());
        if (!compiler_ir_metadata::plain_type(declared, 0)) {
            return fail(store, InstructionError::scalar_slot);
        }
        if (compiler_ir_metadata::object_leaf_root(metadata, callable, offset) >= 0) {
            return fail(store, InstructionError::storage_borrow_object);
        }
        const compiler_ir_metadata::RawTypeRow reference = metadata.type_at(call_value(store, instruction, 1));
        if (!compiler_ir_metadata::plain_type(reference, 3) && !compiler_ir_metadata::plain_type(reference, 4)) {
            return fail(store, InstructionError::storage_borrow_type);
        }
        return true;
    }
    auto verify_storage_range(InstructionStore& store, const compiler_ir_metadata::MetadataStore& metadata,
        i64 callable, i64 instruction) -> bool {
        const i64 offset = call_value(store, instruction, 0);
        const i64 length = call_value(store, instruction, 1);
        const i64 type_index = call_value(store, instruction, 2);
        const compiler_ir_metadata::RawTypeRow type = metadata.type_at(type_index);
        if (!compiler_ir_metadata::scalar_type(type) || length < 1 || length > 4096) {
            return fail(store, InstructionError::storage_array_shape);
        }
        const i64 width = compiler_ir_metadata::scalar_width(type);
        // Divide before multiplying untrusted extents. Scalar widths are 1/8;
        // the admitted length then bounds every element product by 32760.
        if (offset < width || length > offset / width) {
            return fail(store, InstructionError::storage_array_extent);
        }
        i64 element = 0;
        while (element < length) {
            const i64 element_offset = offset - element * width;
            if (!verify_storage_scalar(store, metadata, callable, element_offset, type_index)) {
                return false;
            }
            if (compiler_ir_metadata::nested_object_leaf(metadata, callable, element_offset)) {
                return fail(store, InstructionError::storage_array_nested);
            }
            element = element + 1;
        }
        // Contiguous scalar ranges, including I64 ranges, need no byte-array
        // origin declaration. Only byte-array lifetime/span forms require one.
        return true;
    }
    // Typed span element identity is static: every producer, transfer and
    // reader agrees with the spill annotations, the owner and the signature.
    auto verify_span_types(InstructionStore& store, const compiler_ir_metadata::MetadataStore& metadata, i64 callable,
        i64 instruction) -> bool {
        const RawInstructionRow row = store.instruction_at(instruction);
        const i64 form = row.form();
        if (form == 50 || form == 51) {
            if (span_element_type(metadata, callable, call_value(store, instruction, 1)) >= 0) {
                return fail(store, InstructionError::storage_span_type);
            }
            return true;
        }
        if (form == 52) {
            const i64 element = span_element_type(metadata, callable, call_value(store, instruction, 2));
            if (element < 0) {
                return true;
            }
            const i64 owner = storage_owner_type(metadata, callable, call_value(store, instruction, 0),
                call_value(store, instruction, 1), false);
            if (owner < 0) {
                return fail(store, InstructionError::storage_span_type);
            }
            const compiler_ir_metadata::RawTypeRow owned = metadata.type_at(owner);
            const compiler_ir_metadata::RawTypeRow viewed = metadata.type_at(element);
            if (owned.kind() != 17 || compiler_ir_metadata::compare_names(metadata, owned.name(), viewed.name()) != 0) {
                return fail(store, InstructionError::storage_span_type);
            }
            return true;
        }
        if (form == 54 || form == 55) {
            if (!same_span_element(metadata, callable, call_value(store, instruction, 0), call_value(store, instruction,
                1))) {
                return fail(store, InstructionError::storage_span_type);
            }
            return true;
        }
        if (form == 58) {
            if (span_element_type(metadata, callable, call_value(store, instruction, 0)) >= 0) {
                return fail(store, InstructionError::storage_span_type);
            }
            return true;
        }
        if (form == 84) {
            const i64 element = span_element_type(metadata, callable, call_value(store, instruction, 0));
            const i64 index = entry_slot(metadata, callable, 11, call_value(store, instruction, 1));
            if (element < 0 || index < 0) {
                return fail(store, InstructionError::storage_span_values);
            }
            const compiler_ir_metadata::SlotRow slot = metadata.slot_at(index);
            const compiler_ir_metadata::RawTypeRow object = metadata.type_at(slot.type());
            const compiler_ir_metadata::RawTypeRow viewed = metadata.type_at(element);
            if (object.kind() != 5 || compiler_ir_metadata::compare_names(metadata, object.name(), viewed.name())
                != 0) {
                return fail(store, InstructionError::storage_span_values);
            }
            return true;
        }
        return true;
    }
    auto verify_storage_access(InstructionStore& store, const compiler_ir_metadata::MetadataStore& metadata,
        i64 callable, i64 instruction) -> bool {
        const RawInstructionRow row = store.instruction_at(instruction);
        const i64 form = row.form();
        if (form == 7 || form == 8) {
            const i64 offset = call_value(store, instruction, 0);
            const i64 type_index = call_value(store, instruction, 1);
            if (!verify_storage_scalar(store, metadata, callable, offset, type_index)) {
                return false;
            }
            if (form == 8 && compiler_ir_metadata::nested_object_leaf(metadata, callable, offset)) {
                return fail(store, InstructionError::storage_nested_store);
            }
            return true;
        }
        if (form == 18) {
            return verify_storage_borrow(store, metadata, callable, instruction);
        }
        if (form == 15 || form == 16 || form == 17) {
            return verify_storage_range(store, metadata, callable, instruction);
        }
        if (form == 47 || form == 48) {
            if (entry_slot(metadata, callable, 12, call_value(store, instruction, 0)) < 0) {
                return fail(store, InstructionError::storage_array_origin);
            }
            return true;
        }
        if (form == 49) {
            // Frame admission already proves this exact local byte-array root's
            // complete U8 element range and disjointness from every object.
            if (entry_slot(metadata, callable, 12, call_value(store, instruction, 0)) < 0) {
                return fail(store, InstructionError::storage_span_origin);
            }
            const i64 result_offset = call_value(store, instruction, 1);
            if (span_element_type(metadata, callable, result_offset) >= 0) {
                return fail(store, InstructionError::storage_span_type);
            }
            return verify_call_span_result(store, metadata, callable, result_offset);
        }
        return verify_span_types(store, metadata, callable, instruction);
    }
    auto verify_storage_accesses(InstructionStore& store, const compiler_ir_metadata::MetadataStore& metadata) -> bool {
        i64 callable = 0;
        while (callable < store.body_count()) {
            const BodyRow body = store.body_at(callable);
            i64 position = 0;
            while (position < body.count()) {
                const CodeRow code = store.code_at(body.begin() + position);
                if (!verify_storage_access(store, metadata, callable, code.id()) || !verify_owner_instruction(store,
                    metadata, callable, code.id())) {
                    return false;
                }
                position = position + 1;
            }
            callable = callable + 1;
        }
        return true;
    }
    auto scalar_unsigned_type(compiler_ir_metadata::RawTypeRow type) -> bool {
        return compiler_ir_metadata::plain_type(type, 7) || compiler_ir_metadata::plain_type(type, 10);
    }
    auto scalar_integer_type(compiler_ir_metadata::RawTypeRow type) -> bool {
        return compiler_ir_metadata::plain_type(type, 0) || scalar_unsigned_type(type);
    }
    auto verify_scalar_constant(InstructionStore& store, const compiler_ir_metadata::MetadataStore& metadata,
        i64 instruction) -> bool {
        const compiler_ir_metadata::RawTypeRow type = metadata.type_at(call_value(store, instruction, 1));
        if (!compiler_ir_metadata::scalar_type(type)) {
            return fail(store, InstructionError::constant_type);
        }
        // Codec shape admission already selected the unsigned lane for U64.
        // Every bit pattern is canonical there, including values above I64_MAX.
        if (type.kind() == 7) {
            return true;
        }
        const i64 value = call_value(store, instruction, 0);
        if (type.kind() == 1 && value != 0 && value != 1) {
            return fail(store, InstructionError::constant_bool);
        }
        if (type.kind() == 10 && (value < 0 || value > 255)) {
            return fail(store, InstructionError::constant_u8);
        }
        return true;
    }
    auto verify_scalar_enum_constant(InstructionStore& store, const compiler_ir_metadata::MetadataStore& metadata,
        i64 instruction) -> bool {
        const compiler_ir_metadata::RawTypeRow type = metadata.type_at(call_value(store, instruction, 0));
        if (type.kind() != 9 || !compiler_ir_metadata::canonical_tail(type)) {
            return fail(store, InstructionError::enum_constant_type);
        }
        const i64 enum_index = compiler_ir_metadata::find_enum(metadata, type.name());
        if (enum_index < 0) {
            return fail(store, InstructionError::enum_constant_type);
        }
        const compiler_ir_metadata::EnumRow declaration = metadata.enum_at(enum_index);
        const i64 case_index = call_value(store, instruction, 1);
        if (case_index < 0 || case_index >= declaration.cases()) {
            return fail(store, InstructionError::enum_constant_case);
        }
        return true;
    }
    auto verify_scalar_computation(InstructionStore& store, const compiler_ir_metadata::MetadataStore& metadata,
        i64 instruction) -> bool {
        const RawInstructionRow row = store.instruction_at(instruction);
        const i64 form = row.form();
        if (form == 5) {
            return verify_scalar_constant(store, metadata, instruction);
        }
        if (form == 6) {
            return verify_scalar_enum_constant(store, metadata, instruction);
        }
        if (form != 11 && form != 12 && form != 13 && form != 14) {
            return true;
        }
        const compiler_ir_metadata::RawTypeRow type = metadata.type_at(call_value(store, instruction, 0));
        if (form == 11) {
            const i64 operation = row.unary_operation();
            if (operation < 0 || operation > 2) {
                return fail(store, InstructionError::unary_operation);
            }
            if ((operation == 0 && !compiler_ir_metadata::plain_type(type, 0)) || (operation == 1
                && !compiler_ir_metadata::plain_type(type, 1)) || (operation == 2 && !scalar_unsigned_type(type))) {
                return fail(store, InstructionError::unary_operand);
            }
            return true;
        }
        if (form == 12) {
            const i64 operation = row.binary_operation();
            if (operation < 0 || operation > 9) {
                return fail(store, InstructionError::binary_operation);
            }
            if (!scalar_unsigned_type(type) && (operation >= 5 || !compiler_ir_metadata::plain_type(type, 0))) {
                return fail(store, InstructionError::binary_operand);
            }
            return true;
        }
        if (form == 13) {
            const compiler_ir_metadata::RawTypeRow result = metadata.type_at(call_value(store, instruction, 1));
            if (!scalar_integer_type(type) || !scalar_integer_type(result) || compiler_ir_metadata::same_type(metadata,
                type, result)) {
                return fail(store, InstructionError::conversion_types);
            }
            return true;
        }
        const i64 operation = row.comparison_operation();
        if (operation < 0 || operation > 5) {
            return fail(store, InstructionError::comparison_operation);
        }
        if (!compiler_ir_metadata::scalar_value(metadata, type)) {
            return fail(store, InstructionError::comparison_scalar);
        }
        if (operation >= 2 && !scalar_integer_type(type)) {
            return fail(store, InstructionError::comparison_ordered);
        }
        return true;
    }
    auto verify_scalar_computations(InstructionStore& store,
        const compiler_ir_metadata::MetadataStore& metadata) -> bool {
        i64 callable = 0;
        while (callable < store.body_count()) {
            const BodyRow body = store.body_at(callable);
            i64 position = 0;
            while (position < body.count()) {
                const CodeRow code = store.code_at(body.begin() + position);
                if (!verify_scalar_computation(store, metadata, code.id())) {
                    return false;
                }
                position = position + 1;
            }
            callable = callable + 1;
        }
        return true;
    }
    auto service_entry_matches(InstructionStore& store, const compiler_ir_metadata::MetadataStore& metadata,
        i64 callable, i64 offset, i64 kind) -> bool {
        const compiler_ir_metadata::CallableRow declaration = metadata.callable_at(callable);
        // Entry admission already proved the exact kind and spill declaration.
        // At most six parameter rows are inspected; no root index is retained.
        i64 position = 0;
        while (position < declaration.value_parameter_count()) {
            const RawInstructionRow row = entry_instruction(store, callable, position);
            if (row.form() == 0 && entry_value(store, row, 1) == offset && entry_value(store, row, 2) == kind) {
                return true;
            }
            position = position + 1;
        }
        return false;
    }
    auto service_result_enums(const compiler_ir_metadata::MetadataStore& metadata) -> u64 {
        // Presence only: metadata has already checked each declared sealed
        // enum's cardinality. Scan once rather than once per service operation.
        u64 result = 0u64;
        i64 at = 0;
        while (at < metadata.enum_count()) {
            const compiler_ir_metadata::EnumRow row = metadata.enum_at(at);
            if (compiler_ir_metadata::named(metadata, row.name(), "__au_console_put_result")) {
                result = result | 1u64;
            }
            if (compiler_ir_metadata::named(metadata, row.name(), "__au_display_put_result")) {
                result = result | 2u64;
            }
            if (compiler_ir_metadata::named(metadata, row.name(), "__au_event_ack_result")) {
                result = result | 4u64;
            }
            if (compiler_ir_metadata::named(metadata, row.name(), "__au_port_write_result")) {
                result = result | 8u64;
            }
            at = at + 1;
        }
        return result;
    }
    auto host_runtime_callable(const compiler_ir_metadata::MetadataStore& metadata, i64 callable) -> bool {
        const compiler_ir_metadata::CallableRow row = metadata.callable_at(callable);
        const compiler_ir_metadata::ByteRange name = row.name();
        if (name.count() < 23) {
            return false;
        }
        return compiler_ir_metadata::named(metadata, compiler_ir_metadata::ByteRange(name.begin(), 5), "__au_")
            && compiler_ir_metadata::named(metadata, compiler_ir_metadata::ByteRange(name.begin() + 6, 17),
            "_m2_6aurora4host_");
    }
    auto verify_service_instruction(InstructionStore& store, const compiler_ir_metadata::MetadataStore& metadata,
        i64 callable, i64 instruction, u64 result_enums) -> bool {
        const RawInstructionRow row = store.instruction_at(instruction);
        const i64 form = row.form();
        if (form == 1) { // AcquireServiceLoan: positivity and stable ID roots were checked for this body.
            const i64 root = call_value(store, instruction, 1);
            const i64 kind = call_value(store, instruction, 2);
            if (!service_entry_matches(store, metadata, callable, root, kind)) {
                return fail(store, InstructionError::service_loan_root);
            }
            return true;
        }
        if (form == 2) { // ReleaseServiceLoan: the executed path decides which loan is live and called.
            const i64 kind = call_value(store, instruction, 1);
            if (call_value(store, instruction, 0) <= 0 || kind < 0 || kind > 6) {
                return fail(store, InstructionError::service_release);
            }
            return true;
        }
        if (form != 3) {
            return true;
        } // BindServiceParameter and ServiceCall were admitted in earlier phases.
        const i64 operation = call_value(store, instruction, 1);
        if (operation < 0 || operation > 20) {
            return fail(store, InstructionError::service_operation);
        }
        i64 expected_kind = 0; // Console: Next, Put
        if (operation == 2) {
            expected_kind = 1;
        } // Display: Pixel
        if (operation == 3 || operation == 4) {
            expected_kind = 2;
        } // IommuEvent: Poll, Acknowledge
        if (operation == 5) {
            expected_kind = 3;
        }
        if (operation == 6 || operation == 7) {
            expected_kind = 4;
        } // Port: Read8, Write8
        if (operation == 8) {
            expected_kind = 5;
        } // Serve: Exchange
        if (operation > 8) {
            expected_kind = 6;
        } // HostFiles: the Linux binding's session and system primitives
        const i64 kind = call_value(store, instruction, 3);
        if (kind != expected_kind) {
            return fail(store, InstructionError::service_operation_kind);
        }
        const i64 root = call_value(store, instruction, 0);
        if (!service_entry_matches(store, metadata, callable, root, kind)) {
            return fail(store, InstructionError::service_operation_root);
        }
        const i64 result_offset = call_value(store, instruction, 2);
        // The Linux binding's primitives belong to functions of module aurora.host
        // only, whose native names are __au_<mode>_m2_6aurora4host_...
        if (operation > 8 && !host_runtime_callable(metadata, callable)) {
            return fail(store, InstructionError::service_operation);
        }
        if (operation > 8 && operation != 14) {
            if (result_offset != 0) {
                return fail(store, InstructionError::service_operation);
            }
            return true;
        }
        if (operation == 6 || operation == 7) {
            if (result_offset != 0 || (operation == 7 && (result_enums & 8u64) == 0u64)) {
                return fail(store, InstructionError::service_port_result);
            }
            return true;
        }
        if (operation == 2) {
            if (result_offset != 0 || (result_enums & 2u64) == 0u64) {
                return fail(store, InstructionError::service_pixel_result);
            }
            return true;
        }
        if (operation == 1) {
            if (result_offset != 0 || (result_enums & 1u64) == 0u64) {
                return fail(store, InstructionError::service_put_result);
            }
            return true;
        }
        if (operation == 4) {
            if (result_offset != 0 || (result_enums & 4u64) == 0u64) {
                return fail(store, InstructionError::service_ack_result);
            }
            return true;
        }
        // Next/Poll require an exact declared copied sample root. Its nominal
        // class and physical layout were sealed by metadata admission. Active
        // authority and logical completion remain native; local scalar facts live
        // in the separate initialization workspace.
        const i64 slot_index = entry_slot(metadata, callable, 11, result_offset);
        if (slot_index < 0) {
            return fail(store, InstructionError::service_sample_result);
        }
        const compiler_ir_metadata::SlotRow slot = metadata.slot_at(slot_index);
        const compiler_ir_metadata::RawTypeRow type = metadata.type_at(slot.type());
        if ((operation == 0 && !compiler_ir_metadata::named(metadata, type.name(), "__au_console_sample")) || (operation
            == 3 && !compiler_ir_metadata::named(metadata, type.name(), "__au_iommu_event_sample")) || (operation == 5
            && !compiler_ir_metadata::named(metadata, type.name(), "__au_call_result")) || (operation == 8
            && !compiler_ir_metadata::named(metadata, type.name(), "__au_serve_request")) || (operation == 14
            && !compiler_ir_metadata::named(metadata, type.name(), "__au_host_chunk"))) {
            return fail(store, InstructionError::service_sample_result);
        }
        return true;
    }
    auto verify_service_instructions(InstructionStore& store,
        const compiler_ir_metadata::MetadataStore& metadata) -> bool {
        const u64 result_enums = service_result_enums(metadata);
        i64 callable = 0;
        while (callable < store.body_count()) {
            // A body's stable loan identities precede its site contracts. The
            // bounded scratch sort borrows no native state and clears its lanes.
            if (!store.verify_service_loan_roots(callable)) {
                return false;
            }
            const BodyRow body = store.body_at(callable);
            i64 position = 0;
            while (position < body.count()) {
                const CodeRow code = store.code_at(body.begin() + position);
                if (!verify_service_instruction(store, metadata, callable, code.id(), result_enums)) {
                    return false;
                }
                position = position + 1;
            }
            callable = callable + 1;
        }
        return true;
    }
    auto admit_instruction_bodies(InstructionStore& store,
        const compiler_ir_metadata::MetadataStore& metadata) -> InstructionStatus {
        if (store.status() != InstructionStatus::admitted) {
            return store.status();
        }
        if (metadata.status() != compiler_ir_metadata::MetadataStatus::success || store.body_count()
            != metadata.callable_count()) {
            store.reject(InstructionError::integrity);
            return store.status();
        }
        // Structural errors in any body precede entry errors in every body.
        // Post-normalization rejection poisons structured state; publication
        // and all subsequent admission/mutation calls then remain closed.
        if (store.normalize_cfg() != InstructionStatus::structured) {
            return store.status();
        }
        i64 callable = 0;
        while (callable < store.body_count()) {
            if (!verify_entry_parameters(store, metadata, callable)) {
                return store.status();
            }
            callable = callable + 1;
        }
        // All entry contracts precede all call contracts. Constructor call
        // restrictions precede the final mutable/I64 constructor policy, even
        // for uncalled/imported declarations. Then storage contracts precede
        // all scalar computations and service contracts
        // before the first native State in any body. Separate passes preserve
        // this module-wide order:
        // a later static error can precede an earlier dynamic value/lifetime
        // error; source rejection remains terminal and unpublished.
        if (!verify_call_sites(store, metadata) || !verify_constructor_signatures(store, metadata)
            || !verify_storage_accesses(store, metadata) || !verify_scalar_computations(store, metadata)
            || !verify_service_instructions(store, metadata)) {
            return store.status();
        }
        return store.status();
    }
}
