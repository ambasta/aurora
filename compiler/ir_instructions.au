export module aurora.compiler.ir_instructions;
import aurora.compiler.ir_instruction_storage;
import aurora.compiler.ir_metadata;

// Generic durable transport admission only. The sole native field walk owns
// ordered opcode shapes; native verification retains all instruction semantics.
export namespace compiler_ir_instructions {
    auto bounded_range(i64 begin, i64 count, i64 limit) -> bool {
        return begin >= 0 && count >= 0 && begin <= limit && count <= limit - begin;
    }
    // These raw ordinals reuse the lowering vocabulary. The closed native
    // binding pins each used role and the form endpoints to generated facts.
    auto type_role(i64 role) -> bool {
        return role == 12 || role == 14 || role == 15 || role == 16 || role == 18 || role == 20;
    }
    auto list_role(i64 role) -> bool {
        return role == 8 || role == 9 || role == 21 || role == 25 || role == 37;
    }
    auto scalar_payload(RawOperandRow operand) -> bool {
        return operand.unsigned_value() == 0u64 && operand.begin() == 0 && operand.count() == 0;
    }
    auto slice_payload(RawOperandRow operand) -> bool {
        return operand.signed_value() == 0 && operand.unsigned_value() == 0u64;
    }
    auto fail(InstructionStore& store, InstructionError reason) -> bool {
        return store.reject(reason);
    }
    auto body_integrity(InstructionStore& store) -> bool {
        i64 next_code = 0;
        i64 callable = 0;
        while (callable < store.body_count()) {
            const BodyRow body = store.body_at(callable);
            if (!bounded_range(body.begin(), body.capacity(), store.code_count())
                || body.count() != body.capacity()
                || (body.capacity() != 0 && body.begin() != next_code)) {
                return fail(store, InstructionError::integrity);
            }
            next_code = next_code + body.capacity();
            callable = callable + 1;
        }
        if (next_code != store.code_count()) { return fail(store, InstructionError::integrity); }
        i64 at = 0;
        while (at < store.code_count()) {
            const CodeRow code = store.code_at(at);
            if (code.id() != at + 1) { return fail(store, InstructionError::integrity); }
            at = at + 1;
        }
        return true;
    }
    auto list_integrity(InstructionStore& store, i64 begin, i64 count) -> bool {
        i64 at = 0;
        while (at < count) {
            const RawOperandRow operand = store.operand_at(begin + at);
            // All nested lists contain scalar leaves. Their exact entry roles
            // and pair grouping belong to the sole native field walk.
            if (operand.role() <= 0 || operand.role() > 101 || !scalar_payload(operand)) {
                return fail(store, InstructionError::integrity);
            }
            at = at + 1;
        }
        return true;
    }
    auto storage_integrity(InstructionStore& store, const compiler_ir_metadata::MetadataStore& metadata) -> bool {
        if (metadata.status() != compiler_ir_metadata::MetadataStatus::success
            || store.body_count() != metadata.callable_count() || !body_integrity(store)) {
            return fail(store, InstructionError::integrity);
        }
        const i64 type_begin = metadata.instruction_type_begin();
        if (type_begin < 0 || type_begin > metadata.type_count()) { return fail(store, InstructionError::integrity); }
        // Raw unresolved counts survive ingress. Reject them explicitly before
        // a native observation can reconstruct a canonical Type and lose them.
        i64 at = type_begin;
        while (at < metadata.type_count()) {
            const compiler_ir_metadata::RawTypeRow type = metadata.type_at(at);
            if (!compiler_ir_metadata::byte_range(type.name(), metadata.byte_count())) {
                return fail(store, InstructionError::integrity);
            }
            if (!compiler_ir_metadata::canonical_tail(type)) {
                return fail(store, InstructionError::noncanonical_type);
            }
            at = at + 1;
        }
        i64 next_operand = 0;
        i64 next_literal = 0;
        i64 next_type = type_begin;
        i64 instruction = 0;
        while (instruction < store.instruction_count()) {
            const RawInstructionRow row = store.instruction_at(instruction + 1);
            if (row.kind() != 1 || row.form() < 0 || row.form() > 83
                || !bounded_range(row.operand_begin(), row.operand_count(), store.operand_count())
                || (row.operand_count() != 0 && row.operand_begin() != next_operand)) {
                return fail(store, InstructionError::integrity);
            }
            // Each prefix is followed by its child lists in prefix order. This
            // monotone packing proves exclusive exact coverage without a bitmap.
            next_operand = next_operand + row.operand_count();
            at = 0;
            while (at < row.operand_count()) {
                const RawOperandRow operand = store.operand_at(row.operand_begin() + at);
                const i64 role = operand.role();
                if (role <= 0 || role > 101) { return fail(store, InstructionError::integrity); }
                if (type_role(role)) {
                    if (!scalar_payload(operand) || next_type >= metadata.type_count()
                        || operand.signed_value() != next_type) { return fail(store, InstructionError::integrity); }
                    // Occurrences have storage identities, never semantic type identities.
                    next_type = next_type + 1;
                } else {
                    if (list_role(role)) {
                        if (!slice_payload(operand)
                            || !bounded_range(operand.begin(), operand.count(), store.operand_count())
                            || (operand.count() != 0 && operand.begin() != next_operand)
                            || !list_integrity(store, operand.begin(), operand.count())) {
                            return fail(store, InstructionError::integrity);
                        }
                        next_operand = next_operand + operand.count();
                    } else {
                        if (role == 33) { // LiteralBytes, packed once for each occurrence
                            if (!slice_payload(operand)
                                || !bounded_range(operand.begin(), operand.count(), store.literal_count())
                                || (operand.count() != 0 && operand.begin() != next_literal)) {
                                return fail(store, InstructionError::integrity);
                            }
                            next_literal = next_literal + operand.count();
                        } else {
                            if (role == 100 || role == 101) { // CalleeName, ClassName
                                if (!slice_payload(operand)
                                    || !bounded_range(operand.begin(), operand.count(), metadata.byte_count())) {
                                    return fail(store, InstructionError::integrity);
                                }
                            } else {
                                if (role == 11) { // UnsignedConstant
                                    if (operand.signed_value() != 0 || operand.begin() != 0 || operand.count() != 0) {
                                        return fail(store, InstructionError::integrity);
                                    }
                                } else {
                                    if (!scalar_payload(operand)) {
                                        return fail(store, InstructionError::integrity);
                                    }
                                }
                            }
                        }
                    }
                }
                at = at + 1;
            }
            instruction = instruction + 1;
        }
        if (next_operand != store.operand_count() || next_literal != store.literal_count()
            || next_type != metadata.type_count()) { return fail(store, InstructionError::integrity); }
        return true;
    }
    auto admit_instruction_storage(InstructionStore& store, const compiler_ir_metadata::MetadataStore& metadata)
        -> InstructionStatus {
        if (store.status() != InstructionStatus::pending) { return store.status(); }
        if (!store.allocated()) { store.reject(InstructionError::integrity); return store.status(); }
        if (!storage_integrity(store, metadata) || !store.admit()) {
            if (store.status() == InstructionStatus::pending) { store.reject(InstructionError::integrity); }
        }
        return store.status();
    }
}
