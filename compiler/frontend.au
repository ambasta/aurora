export module aurora.compiler.frontend;
import aurora.compiler.lexer;
import aurora.compiler.syntax_arena;
import aurora.compiler.parser;
import aurora.compiler.resolution_kinds;
import aurora.compiler.resolution_arena;
import aurora.compiler.resolution_rows;
import aurora.compiler.resolution_names;
import aurora.compiler.resolution_ingest;
import aurora.compiler.lowering_kinds;
import aurora.compiler.lowering_errors;
import aurora.compiler.lowering_storage;
import aurora.compiler.lowering_configuration;
import aurora.compiler.lowering;
import aurora.compiler.resolver;
import aurora.compiler.ir_graph;
import aurora.compiler.ir_metadata_storage;
import aurora.compiler.ir_metadata;
import aurora.compiler.ir_instruction_storage;
import aurora.compiler.ir_instructions;

// The host bridge enters this root module. Ordinary imported-function retention
// then keeps exactly the parser, resolver, lowering and IR graph implementations they call.
// These forwards add no state, policy or owner: each moved input is consumed once.
export namespace compiler_frontend {
    auto lexer_next(builtin::span<const u8> source, compiler_lexer::Cursor cursor) -> compiler_lexer::Lexeme {
        const compiler_lexer::Lexeme result = compiler_lexer::next_lexeme(source, cursor);
        return result;
    }
    auto parser_create(builtin::ByteRegion region, i64 capacity) -> compiler_parser::AstArena {
        compiler_parser::AstArena result = compiler_parser::create(region, capacity);
        return move(result);
    }
    auto parser_parse(compiler_parser::AstArena& arena, builtin::span<const u8> source, compiler_lexer::Cursor cursor,
        compiler_parser::Stop stop, compiler_parser::TypeContext context,
        i64 enum_count) -> compiler_parser::ParseResult {
        const compiler_parser::ParseResult result = compiler_parser::parse(arena, source, cursor, stop, context,
            enum_count);
        return result;
    }
    auto parser_admit(compiler_parser::AstArena& arena, builtin::span<const u8> source, i64 root,
        compiler_parser::AdmissionConfig configuration) -> compiler_parser::AdmissionResult {
        const compiler_parser::AdmissionResult result = compiler_parser::admit(arena, source, root, configuration);
        return result;
    }
    auto parser_release(builtin::ByteRegion region, compiler_parser::AstArena arena) -> i64 {
        return compiler_parser::release(region, move(arena));
    }
    auto parser_node_count(const compiler_parser::AstArena& arena) -> i64 {
        return compiler_parser::node_count(arena);
    }
    auto parser_edge_count(const compiler_parser::AstArena& arena) -> i64 {
        return compiler_parser::edge_count(arena);
    }
    auto parser_type_count(const compiler_parser::AstArena& arena) -> i64 {
        return compiler_parser::type_count(arena);
    }
    auto parser_syntax_count(const compiler_parser::AstArena& arena) -> i64 {
        return compiler_parser::syntax_count(arena);
    }
    auto parser_read_node(const compiler_parser::AstArena& arena, i64 index) -> compiler_parser::AstNode {
        const compiler_parser::AstNode result = compiler_parser::read_node(arena, index);
        return result;
    }
    auto parser_read_edge(const compiler_parser::AstArena& arena, i64 index) -> compiler_parser::ChildEdge {
        const compiler_parser::ChildEdge result = compiler_parser::read_edge(arena, index);
        return result;
    }
    auto parser_read_type(const compiler_parser::AstArena& arena, i64 index) -> compiler_parser::TypeSyntax {
        const compiler_parser::TypeSyntax result = compiler_parser::read_type(arena, index);
        return result;
    }
    auto parser_read_syntax(const compiler_parser::AstArena& arena, i64 index) -> compiler_parser::SyntaxNode {
        const compiler_parser::SyntaxNode result = compiler_parser::read_syntax(arena, index);
        return result;
    }
    auto resolver_create(builtin::ByteRegion region) -> compiler_resolver::Session {
        compiler_resolver::Session result = compiler_resolver::create(region);
        return move(result);
    }
    auto resolver_ingest(builtin::ByteRegion region, compiler_resolver::Session session,
        compiler_parser::AstArena parsed, i64 module_id, i64 root) -> compiler_resolver::Session {
        compiler_resolver::Session result = compiler_resolver::ingest(region, move(session), move(parsed), module_id,
            root);
        return move(result);
    }
    auto resolver_release(builtin::ByteRegion region, compiler_resolver::Session session) -> i64 {
        return compiler_resolver::release(region, move(session));
    }
    auto resolver_release_pair(builtin::ByteRegion region, compiler_resolver::Session session,
        compiler_parser::AstArena parsed) -> i64 {
        return compiler_resolver::release_pair(region, move(session), move(parsed));
    }
    auto resolver_append_source(compiler_resolver::Session& session, builtin::span<const u8> source) -> i64 {
        return compiler_resolver::append_source(session, source);
    }
    auto resolver_append_text(compiler_resolver::Session& session, builtin::span<const u8> source) -> i64 {
        return compiler_resolver::append_text(session, source);
    }
    auto resolver_order_module(compiler_resolver::Session& session, i64 module_id, i64 order, i64 scope,
        bool root) -> bool {
        return compiler_resolver::order_module(session, module_id, order, scope, root);
    }
    auto resolver_bind_import(compiler_resolver::Session& session, i64 module_id, i64 node, i64 target) -> bool {
        return compiler_resolver::bind_import(session, module_id, node, target);
    }
    auto resolver_count(const compiler_resolver::Session& session, i64 pool) -> i64 {
        return compiler_resolver::count(session, pool);
    }
    auto resolver_read_source(const compiler_resolver::Session& session, i64 index) -> i64 {
        return compiler_resolver::read_source(session, index);
    }
    auto resolver_status(const compiler_resolver::Session& session) -> compiler_resolver::SessionStatus {
        const compiler_resolver::SessionStatus result = compiler_resolver::status(session);
        return result;
    }
    auto resolver_seed_builtin(compiler_resolver::Session& session, compiler_resolver::MetaRow definition) -> i64 {
        return compiler_resolver::seed_builtin(session, definition);
    }
    auto resolver_seed_member(compiler_resolver::Session& session, compiler_resolver::MetaRow definition) -> i64 {
        return compiler_resolver::seed_member(session, definition);
    }
    auto resolver_run(compiler_resolver::Session& session) -> i64 {
        return compiler_resolver::run(session);
    }
    auto resolver_read_syntax(const compiler_resolver::Session& session, i64 index) -> compiler_resolver::SyntaxRow {
        const compiler_resolver::SyntaxRow result = compiler_resolver::read_syntax(session, index);
        return result;
    }
    auto resolver_read_meta(const compiler_resolver::Session& session, i64 index) -> compiler_resolver::MetaRow {
        const compiler_resolver::MetaRow result = compiler_resolver::read_meta(session, index);
        return result;
    }
    auto resolver_read_resolved(const compiler_resolver::Session& session,
        i64 index) -> compiler_resolver::ResolvedRow {
        const compiler_resolver::ResolvedRow result = compiler_resolver::read_resolved(session, index);
        return result;
    }
    auto lowering_begin(compiler_resolver::Session& session, compiler_lowering::LoweringConfig configuration) -> i64 {
        return compiler_lowering::begin_lowering(session, configuration);
    }
    auto lowering_seed_scalar(compiler_resolver::Session& session, compiler_lowering::ScalarSeed seed) -> i64 {
        return compiler_lowering::seed_scalar(session, seed);
    }
    auto lowering_seed_service(compiler_resolver::Session& session, compiler_lowering::ServiceSeed seed) -> i64 {
        return compiler_lowering::seed_service(session, seed);
    }
    auto lowering_seed_layout_symbol(compiler_resolver::Session& session, i64 symbol) -> i64 {
        return compiler_lowering::seed_layout_symbol(session, symbol);
    }
    auto lowering_run(compiler_resolver::Session& session) -> compiler_lowering::LoweringResult {
        const compiler_lowering::LoweringResult result = compiler_lowering::run_lowering(session);
        return result;
    }
    auto lowering_count(const compiler_resolver::Session& session, i64 pool) -> i64 {
        if (pool == 0) {
            return session.output_count();
        }
        if (pool == 1) {
            return session.operand_count();
        }
        return -1;
    }
    auto lowering_read_output(const compiler_resolver::Session& session, i64 index) -> compiler_lowering::OutputRow {
        const compiler_lowering::OutputRow result = session.view_output(index);
        return result;
    }
    auto lowering_read_operand(const compiler_resolver::Session& session, i64 index) -> compiler_lowering::OperandRow {
        const compiler_lowering::OperandRow result = session.view_operand(index);
        return result;
    }
    auto graph_create_input(builtin::ByteRegion region, i64 functions, i64 edges) -> compiler_ir_graph::Input {
        compiler_ir_graph::Input result = compiler_ir_graph::create_input(region, functions, edges);
        return move(result);
    }
    auto graph_create_workspace(builtin::ByteRegion region, i64 functions, i64 edges) -> compiler_ir_graph::Workspace {
        compiler_ir_graph::Workspace result = compiler_ir_graph::create_workspace(region, functions, edges);
        return move(result);
    }
    auto graph_release_input(builtin::ByteRegion region, compiler_ir_graph::Input input) -> i64 {
        return compiler_ir_graph::release_input(region, move(input));
    }
    auto graph_release_workspace(builtin::ByteRegion region, compiler_ir_graph::Workspace workspace) -> i64 {
        return compiler_ir_graph::release_workspace(region, move(workspace));
    }
    auto graph_set_function(compiler_ir_graph::Input& input, i64 index, compiler_ir_graph::FunctionRow function) -> bool {
        return compiler_ir_graph::set_function(input, index, function);
    }
    auto graph_set_edge(compiler_ir_graph::Input& input, i64 index, i64 target) -> bool {
        return compiler_ir_graph::set_edge(input, index, target);
    }
    auto graph_run(compiler_ir_graph::Workspace& workspace, const compiler_ir_graph::Input& input)
        -> compiler_ir_graph::GraphStatus {
        return compiler_ir_graph::run(workspace, input);
    }
    auto graph_retained(const compiler_ir_graph::Workspace& workspace, i64 index) -> bool {
        return compiler_ir_graph::retained(workspace, index);
    }
    auto metadata_create(builtin::ByteRegion region, compiler_ir_metadata::InputCounts counts,
        i64 callableCount, i64 slotCount, i64 instructionBegin)
        -> compiler_ir_metadata::MetadataStore {
        compiler_ir_metadata::MetadataStore result = compiler_ir_metadata::create(region, counts, callableCount,
            slotCount, instructionBegin);
        return move(result);
    }
    auto metadata_release(builtin::ByteRegion region, compiler_ir_metadata::MetadataStore store) -> i64 {
        return compiler_ir_metadata::release(region, move(store));
    }
    auto metadata_allocated(const compiler_ir_metadata::MetadataStore& store) -> bool {
        return store.allocated();
    }
    auto metadata_run(compiler_ir_metadata::MetadataStore& store) -> compiler_ir_metadata::MetadataStatus {
        return compiler_ir_metadata::run(store);
    }
    auto metadata_error(const compiler_ir_metadata::MetadataStore& store) -> compiler_ir_metadata::MetadataError {
        return store.error();
    }
    auto instructions_create(builtin::ByteRegion region, compiler_ir_instructions::InstructionCounts counts)
        -> compiler_ir_instructions::InstructionStore {
        compiler_ir_instructions::InstructionStore result = compiler_ir_instructions::create(region, counts);
        return move(result);
    }
    auto instructions_release(builtin::ByteRegion region, compiler_ir_instructions::InstructionStore store) -> i64 {
        return compiler_ir_instructions::release(region, move(store));
    }
    auto instructions_allocated(const compiler_ir_instructions::InstructionStore& store) -> bool {
        return store.allocated();
    }
    auto instructions_admit(compiler_ir_instructions::InstructionStore& store,
        const compiler_ir_metadata::MetadataStore& metadata) -> compiler_ir_instructions::InstructionStatus {
        return compiler_ir_instructions::admit_instruction_storage(store, metadata);
    }
    auto instructions_structure(compiler_ir_instructions::InstructionStore& store,
        const compiler_ir_metadata::MetadataStore& metadata) -> compiler_ir_instructions::InstructionStatus {
        return compiler_ir_instructions::normalize_instruction_cfg(store, metadata);
    }
    auto instructions_publish(compiler_ir_instructions::InstructionStore& store) -> bool {
        return store.publish();
    }
    auto instructions_error(const compiler_ir_instructions::InstructionStore& store)
        -> compiler_ir_instructions::InstructionError {
        return store.error();
    }
}
