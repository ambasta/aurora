export module aurora.compiler.ir_graph;

// Independent post-function verification. Input is a snapshot of actual,
// normalized native IR, never lowering state or a producer's success report.
export namespace compiler_ir_graph {
    enum class GraphStatus { success, allocation, invalid, recursive };
    class FunctionRow {
        i64 firstEdge;
        i64 edgeCount;
        bool hasReceiver;
        bool serviceEntry;
        bool rootScope;
    public:
        FunctionRow(i64 first, i64 count, bool receiver, bool service, bool root) : firstEdge(first),
            edgeCount(count), hasReceiver(receiver), serviceEntry(service), rootScope(root) {
        }
        auto first() const -> i64 { return firstEdge; }
        auto count() const -> i64 { return edgeCount; }
        auto receiver() const -> bool { return hasReceiver; }
        auto service() const -> bool { return serviceEntry; }
        auto root() const -> bool { return rootScope; }
    };
    class IndexRow {
        i64 value;
    public:
        IndexRow(i64 index) : value(index) {}
        auto index() const -> i64 { return value; }
    };
    class StateRow {
        i64 callerHead;
        i64 marks;
    public:
        StateRow(i64 caller, i64 flags) : callerHead(caller), marks(flags) {}
        auto caller() const -> i64 { return callerHead; }
        auto flags() const -> i64 { return marks; }
    };
    class ReverseEdge {
        i64 source;
        i64 next;
    public:
        ReverseEdge(i64 caller, i64 following) : source(caller), next(following) {}
        auto caller() const -> i64 { return source; }
        auto following() const -> i64 { return next; }
    };
    class FrameRow {
        i64 function;
        i64 nextEdge;
    public:
        FrameRow(i64 node, i64 edge) : function(node), nextEdge(edge) {}
        auto node() const -> i64 { return function; }
        auto edge() const -> i64 { return nextEdge; }
    };
    auto function_pool(builtin::ByteRegion region, i64 count) -> builtin::OwnedValues<FunctionRow> {
        const FunctionRow fill = FunctionRow(0, 0, false, false, false);
        builtin::OwnedValues<FunctionRow> result = region.try_allocate(count, fill);
        return move(result);
    }
    auto index_pool(builtin::ByteRegion region, i64 count) -> builtin::OwnedValues<IndexRow> {
        const IndexRow fill = IndexRow(-1);
        builtin::OwnedValues<IndexRow> result = region.try_allocate(count, fill);
        return move(result);
    }
    auto state_pool(builtin::ByteRegion region, i64 count) -> builtin::OwnedValues<StateRow> {
        const StateRow fill = StateRow(-1, 0);
        builtin::OwnedValues<StateRow> result = region.try_allocate(count, fill);
        return move(result);
    }
    auto reverse_pool(builtin::ByteRegion region, i64 count) -> builtin::OwnedValues<ReverseEdge> {
        const ReverseEdge fill = ReverseEdge(-1, -1);
        builtin::OwnedValues<ReverseEdge> result = region.try_allocate(count, fill);
        return move(result);
    }
    auto frame_pool(builtin::ByteRegion region, i64 count) -> builtin::OwnedValues<FrameRow> {
        const FrameRow fill = FrameRow(-1, -1);
        builtin::OwnedValues<FrameRow> result = region.try_allocate(count, fill);
        return move(result);
    }
    class Input {
        builtin::OwnedValues<FunctionRow> functions;
        builtin::OwnedValues<IndexRow> edges;
        i64 functionCount;
        i64 edgeCount;
        i64 functionsWritten;
        i64 edgesWritten;
    public:
        Input(builtin::ByteRegion region, i64 nodes, i64 calls) : functions(function_pool(region, nodes)),
            edges(index_pool(region, calls)), functionCount(nodes), edgeCount(calls), functionsWritten(0),
            edgesWritten(0) {}
        auto allocated() const -> bool {
            return functionCount >= 0 && edgeCount >= 0 && functions.ok() && edges.ok()
                && functions.size() == functionCount && edges.size() == edgeCount;
        }
        auto complete() const -> bool {
            return functionsWritten == functionCount && edgesWritten == edgeCount;
        }
        auto size() const -> i64 { return functionCount; }
        auto calls() const -> i64 { return edgeCount; }
        auto function(i64 index) const -> FunctionRow {
            const FunctionRow result = functions.at(index);
            return result;
        }
        auto target(i64 index) const -> i64 {
            const IndexRow result = edges.at(index);
            return result.index();
        }
        auto write_function(i64 index, FunctionRow value) -> bool {
            if (!allocated() || index != functionsWritten || index >= functionCount
                || !functions.set(index, value)) { return false; }
            functionsWritten = functionsWritten + 1;
            return true;
        }
        auto write_edge(i64 index, i64 target) -> bool {
            if (!allocated() || index != edgesWritten || index >= edgeCount) { return false; }
            const IndexRow value = IndexRow(target);
            if (!edges.set(index, value)) { return false; }
            edgesWritten = edgesWritten + 1;
            return true;
        }
    };
    class Workspace {
        builtin::OwnedValues<StateRow> states;
        builtin::OwnedValues<ReverseEdge> reverse;
        builtin::OwnedValues<FrameRow> pending;
        builtin::OwnedValues<IndexRow> finish;
        i64 functionCount;
        i64 edgeCount;
        i64 pendingCount;
        i64 finishCount;
        bool started;
        bool completed;
    public:
        Workspace(builtin::ByteRegion region, i64 nodes, i64 calls) : states(state_pool(region, nodes)),
            reverse(reverse_pool(region, calls)), pending(frame_pool(region, nodes)), finish(index_pool(region, nodes)),
            functionCount(nodes), edgeCount(calls), pendingCount(0), finishCount(0), started(false), completed(false) {}
        auto allocated() const -> bool {
            return functionCount >= 0 && edgeCount >= 0 && states.ok() && reverse.ok() && pending.ok() && finish.ok()
                && states.size() == functionCount && reverse.size() == edgeCount && pending.size() == functionCount
                && finish.size() == functionCount;
        }
        auto size() const -> i64 { return functionCount; }
        auto calls() const -> i64 { return edgeCount; }
        auto begin() -> bool {
            if (started) { return false; }
            started = true;
            return true;
        }
        auto state(i64 node) const -> StateRow {
            const StateRow result = states.at(node);
            return result;
        }
        auto marked(i64 node, i64 mask) const -> bool {
            const StateRow result = states.at(node);
            // Flags start at zero and this pass uses only masks 1, 2 and 4.
            return (result.flags() / mask) % 2 != 0;
        }
        auto mark(i64 node, i64 mask) -> bool {
            const StateRow old = states.at(node);
            i64 flags = old.flags();
            if ((flags / mask) % 2 == 0) { flags = flags + mask; }
            const StateRow value = StateRow(old.caller(), flags);
            return states.set(node, value);
        }
        auto clear_visited(i64 node) -> bool {
            const StateRow old = states.at(node);
            const StateRow value = StateRow(old.caller(), old.flags() - old.flags() % 2);
            return states.set(node, value);
        }
        auto add_reverse(i64 edge, i64 source, i64 target) -> bool {
            const StateRow old = states.at(target);
            const ReverseEdge value = ReverseEdge(source, old.caller());
            const StateRow state = StateRow(edge, old.flags());
            return reverse.set(edge, value) && states.set(target, state);
        }
        auto incoming(i64 edge) const -> ReverseEdge {
            const ReverseEdge result = reverse.at(edge);
            return result;
        }
        auto push(i64 node, i64 edge) -> bool {
            if (pendingCount >= functionCount) { return false; }
            const FrameRow frame = FrameRow(node, edge);
            if (!pending.set(pendingCount, frame)) { return false; }
            pendingCount = pendingCount + 1;
            return true;
        }
        auto empty() const -> bool { return pendingCount == 0; }
        auto top() const -> FrameRow {
            const FrameRow result = pending.at(pendingCount - 1);
            return result;
        }
        auto advance(i64 node, i64 edge) -> bool {
            const FrameRow value = FrameRow(node, edge);
            return pending.set(pendingCount - 1, value);
        }
        auto pop() -> bool {
            if (pendingCount == 0) { return false; }
            pendingCount = pendingCount - 1;
            return true;
        }
        auto finished(i64 node) -> bool {
            if (finishCount >= functionCount) { return false; }
            const IndexRow value = IndexRow(node);
            if (!finish.set(finishCount, value)) { return false; }
            finishCount = finishCount + 1;
            return true;
        }
        auto finished_count() const -> i64 { return finishCount; }
        auto finished_at(i64 index) const -> i64 {
            const IndexRow value = finish.at(index);
            return value.index();
        }
        auto publish() -> bool { completed = true; return true; }
        auto retained(i64 index) const -> bool {
            if (!completed || index < 0 || index >= functionCount) { return false; }
            return marked(index, 4);
        }
    };
    auto create_input(builtin::ByteRegion region, i64 functions, i64 edges) -> Input {
        Input result = Input(region, functions, edges);
        return move(result);
    }
    auto create_workspace(builtin::ByteRegion region, i64 functions, i64 edges) -> Workspace {
        Workspace result = Workspace(region, functions, edges);
        return move(result);
    }
    auto release_input(builtin::ByteRegion region, Input input) -> i64 { return 0; }
    auto release_workspace(builtin::ByteRegion region, Workspace workspace) -> i64 { return 0; }
    auto set_function(Input& input, i64 index, FunctionRow function) -> bool {
        return input.write_function(index, function);
    }
    auto set_edge(Input& input, i64 index, i64 target) -> bool { return input.write_edge(index, target); }
    auto retained(const Workspace& workspace, i64 index) -> bool { return workspace.retained(index); }

    // A node is marked before it is pushed: each worklist has at most V entries.
    // Flags: 1 = DFS visited, 2 = service reachable, 4 = retained from scope zero.
    auto reach(Workspace& workspace, const Input& input, i64 mask) -> bool {
        i64 node = 0;
        while (node < input.size()) {
            const FunctionRow function = input.function(node);
            if ((mask == 2 && function.service()) || (mask == 4 && function.root())) {
                if (!workspace.mark(node, mask) || !workspace.push(node, 0)) { return false; }
            }
            node = node + 1;
        }
        while (!workspace.empty()) {
            const FrameRow frame = workspace.top();
            workspace.pop();
            const FunctionRow function = input.function(frame.node());
            i64 edge = function.first();
            while (edge < function.first() + function.count()) {
                const i64 target = input.target(edge);
                if (!workspace.marked(target, mask)) {
                    if (!workspace.mark(target, mask) || !workspace.push(target, 0)) { return false; }
                }
                edge = edge + 1;
            }
        }
        return true;
    }
    // Generated scalar result codes; nothing is pruned before success.
    auto run(Workspace& workspace, const Input& input) -> GraphStatus {
        if (!workspace.allocated() || !input.allocated()) { return GraphStatus::allocation; }
        if (!input.complete() || input.size() != workspace.size() || input.calls() != workspace.calls()
            || input.size() == 0 || !workspace.begin()) { return GraphStatus::invalid; }
        i64 node = 0;
        i64 next = 0;
        while (node < input.size()) {
            const FunctionRow function = input.function(node);
            if (function.first() != next || function.count() < 0 || function.count() > input.calls() - next) {
                return GraphStatus::invalid;
            }
            i64 edge = next;
            next = next + function.count();
            while (edge < next) {
                const i64 target = input.target(edge);
                if (target < 0 || target >= input.size() || !workspace.add_reverse(edge, node, target)) {
                    return GraphStatus::invalid;
                }
                edge = edge + 1;
            }
            node = node + 1;
        }
        if (next != input.calls() || !reach(workspace, input, 2)) { return GraphStatus::invalid; }
        node = 0;
        while (node < input.size()) {
            if (!workspace.marked(node, 1)) {
                const FunctionRow start = input.function(node);
                if (!workspace.mark(node, 1) || !workspace.push(node, start.first())) { return GraphStatus::invalid; }
                while (!workspace.empty()) {
                    const FrameRow frame = workspace.top();
                    const FunctionRow function = input.function(frame.node());
                    if (frame.edge() == function.first() + function.count()) {
                        if (!workspace.finished(frame.node()) || !workspace.pop()) { return GraphStatus::invalid; }
                    } else {
                        const i64 target = input.target(frame.edge());
                        if (!workspace.advance(frame.node(), frame.edge() + 1)) { return GraphStatus::invalid; }
                        if (!workspace.marked(target, 1)) {
                            const FunctionRow child = input.function(target);
                            if (!workspace.mark(target, 1) || !workspace.push(target, child.first())) {
                                return GraphStatus::invalid;
                            }
                        }
                    }
                }
            }
            node = node + 1;
        }
        if (workspace.finished_count() != input.size()) { return GraphStatus::invalid; }
        node = 0;
        while (node < input.size()) {
            if (!workspace.clear_visited(node)) { return GraphStatus::invalid; }
            node = node + 1;
        }
        i64 order = input.size();
        while (order > 0) {
            order = order - 1;
            const i64 start = workspace.finished_at(order);
            if (!workspace.marked(start, 1)) {
                if (!workspace.mark(start, 1) || !workspace.push(start, 0)) { return GraphStatus::invalid; }
                i64 component_size = 0;
                bool has_receiver = false;
                bool self_edge = false;
                while (!workspace.empty()) {
                    const FrameRow frame = workspace.top();
                    if (!workspace.pop()) { return GraphStatus::invalid; }
                    const i64 current = frame.node();
                    const FunctionRow function = input.function(current);
                    component_size = component_size + 1;
                    has_receiver = has_receiver || function.receiver() || workspace.marked(current, 2);
                    i64 edge = function.first();
                    while (edge < function.first() + function.count()) {
                        self_edge = self_edge || input.target(edge) == current;
                        edge = edge + 1;
                    }
                    const StateRow state = workspace.state(current);
                    edge = state.caller();
                    while (edge != -1) {
                        const ReverseEdge incoming = workspace.incoming(edge);
                        const i64 caller = incoming.caller();
                        if (!workspace.marked(caller, 1)) {
                            if (!workspace.mark(caller, 1) || !workspace.push(caller, 0)) {
                                return GraphStatus::invalid;
                            }
                        }
                        edge = incoming.following();
                    }
                }
                if (has_receiver && (component_size != 1 || self_edge)) { return GraphStatus::recursive; }
            }
        }
        // All components, including unreachable imports, precede retention.
        if (!reach(workspace, input, 4) || !workspace.publish()) { return GraphStatus::invalid; }
        return GraphStatus::success;
    }
}
