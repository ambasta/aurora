export module aurora.compiler.resolver;
import aurora.compiler.resolution_kinds;
import aurora.compiler.resolution_arena;
import aurora.compiler.resolution_rows;
import aurora.compiler.resolution_names;
import aurora.compiler.resolution_linkage;
import aurora.compiler.lowering_kinds;
import aurora.compiler.lowering_errors;
import aurora.compiler.lowering_storage;
import aurora.compiler.syntax_arena;
import aurora.compiler.parser;
import aurora.compiler.lexer;
import aurora.compiler.builtin_catalog;
import aurora.compiler.diagnostics;

export namespace compiler_resolver {
    // Metadata indices are identities, never addresses. These private index
    // domains are separate from the arena's source/atom/prefix indices.
    // Symbol words: linkage-source,module_id,scope,qualified,source,syntax,exported,
    // receiver,parameters,instance,overload,signature,public-types,visit,next.
    // Type words: unused,nominal,element,length,unresolved-source.
    // Instance words: prototype,count,arg0,arg1,nominal-depth,symbol.
    // Signature words: owner,type,parameter-syntax,next.
    // Public edge words: type,next. Authority words: function,nominal,next.
    // Output link words: symbol,next. Category list words: first,last,count.
    // The typed enum fields are the sole host-visible kind authority.
    // Conservative producer ledger used by the granting host's checked quota:
    // S = original syntax rows; X = expanded rows <= 257*S; M <= 256 modules;
    // I <= 256 instances; K = seeded descriptors; F = seeded members;
    // T <= 2*X + K + 18 concrete types; D = maximum source/seed name byte depth.
    // Semantic metadata C charges each producing family separately:
    // 2 state/output + 7*(M+1) category heads + (X+K) symbols
    // + 32*S namespace records + S overload groups + S overload edges + T types
    // + I instances + 2*X signature edges + 3*X public-type edges
    // + I*(X+K) distinct authority pairs + 65*X request/argument-check rows
    // + X signature-tuple nodes + (X+K) visibility + (X+K) output links + K+F seeds.
    // The 65*X request charge covers one root request and at most two checks at
    // each of the <=31 class-template nodes in a binary depth-four request.
    // Semantic AVL entries J (storage domains 1..9 are charged in the arena):
    // T type keys + S declarations + 7*(M+1) categories + 1 state + S type owners
    // + I*(X+K) authority keys + 32*S namespace keys + X member-conflict keys
    // + X raw receiver-member keys (domain 58) + S enum cases + S overload groups
    // + I instances + 2*K seed/native keys + X public tails + X signature tails
    // + X tuple keys + S overload uniqueness + M*S visible names
    // + 32*M*S visible prefixes + (X+K)*(M+1) visibility keys + 1 output key.
    // Scratch W <= 3*X + T + 2*D + 128: outer ordered traversal, temporary clone
    // map plus clone traversal, enqueue-once type visibility, and prefix scratch.
    // Source names/ranges and lexical scopes are shared by clones: unique name
    // ranges L <= S+seed-text references; name-cache N <= projected refs+L+seeds.
    // Lookup creates at most 32 ancestor candidates per distinct scoped source
    // occurrence; no source name bytes or display-specialization names are copied.
    // Linkage adds one source-reference per symbol and immutable byte caches.
    // A length-prefixed base uses <=2*D+8320 bytes; nested nominal arguments
    // duplicate <=31 bases, function tuples <=63, plus <=32 per signature edge.
    // Module normalization charges <=4096 components/module separately; spelling
    // scratch adds <=2*X+4096 rows above the existing saved caller base.
    // All bit operations use u64 with <=32 live bits; checked i64 conversion
    // when storing the mask is exact. Visibility is one key per (nominal, scope).
    class BindContext {
        i64 defining_module;
        i64 lexical_scope;
        i64 callable_symbol;
        i64 receiver_symbol;
        bool receiver_initializer;
        bool allow_expansion;
    public:
        BindContext(i64 module_id, i64 scope, i64 function, i64 receiver, bool initializer,
            bool expand) : defining_module(module_id), lexical_scope(scope), callable_symbol(function),
            receiver_symbol(receiver), receiver_initializer(initializer), allow_expansion(expand) {
        }
        auto module_id() const -> i64 {
            return defining_module;
        }
        auto scope() const -> i64 {
            return lexical_scope;
        }
        auto function() const -> i64 {
            return callable_symbol;
        }
        auto receiver() const -> i64 {
            return receiver_symbol;
        }
        auto initializer() const -> bool {
            return receiver_initializer;
        }
        auto expand() const -> bool {
            return allow_expansion;
        }
    };

    auto mw(Session& session, i64 row, i64 word) -> i64 {
        return session.meta_word(row, word);
    }
    auto sw(Session& session, i64 row, i64 word) -> i64 {
        return session.syntax_word(row, word);
    }
    auto rw(Session& session, i64 row, i64 word) -> i64 {
        const ResolvedRow value = session.resolved(row);
        return value.word(word);
    }
    auto set_mw(Session& session, i64 row, i64 word, i64 value) -> i64 {
        MetaRow record = session.meta(row);
        record.set_word(word, value);
        session.set_meta(row, record);
        return value;
    }
    auto set_sw(Session& session, i64 row, i64 word, i64 value) -> i64 {
        SyntaxRow record = session.syntax(row);
        record.set_word(word, value);
        session.set_syntax(row, record);
        return value;
    }
    auto set_rw(Session& session, i64 row, i64 word, i64 value) -> i64 {
        ResolvedRow record = session.resolved(row);
        record.set_word(word, value);
        session.set_resolved(row, record);
        return value;
    }
    // The first rejection renders its diagnostic before the Session latches it.
    auto reject(Session& session, SemanticError code, i64 node, i64 first, i64 second) -> i64 {
        report_semantic(session, code, node, first, second);
        session.reject(code, node, first, second);
        return -1;
    }
    auto declaration_kind(Session& session, i64 symbol) -> DeclarationKind {
        const MetaRow value = session.meta(symbol);
        return value.declaration_kind();
    }
    auto type_kind(Session& session, i64 type) -> ResolvedTypeKind {
        return session.meta_type_kind(type);
    }
    auto scalar_kind(ResolvedTypeKind kind) -> bool {
        return kind == ResolvedTypeKind::i64_value || kind == ResolvedTypeKind::u64_value || kind
            == ResolvedTypeKind::u8_value || kind == ResolvedTypeKind::bool_value;
    }
    auto nominal_kind(ResolvedTypeKind kind) -> bool {
        return kind == ResolvedTypeKind::class_value || kind == ResolvedTypeKind::enum_value;
    }
    auto scalar_value_kind(ResolvedTypeKind kind) -> bool {
        return scalar_kind(kind) || kind == ResolvedTypeKind::enum_value;
    }
    auto service_kind(ResolvedTypeKind kind) -> bool {
        return kind == ResolvedTypeKind::console_session || kind == ResolvedTypeKind::display_session || kind
            == ResolvedTypeKind::event_session || kind == ResolvedTypeKind::call_session || kind
            == ResolvedTypeKind::port_range || kind == ResolvedTypeKind::serve_session || kind
            == ResolvedTypeKind::host_files || kind == ResolvedTypeKind::read_only_block || kind
            == ResolvedTypeKind::writable_block || kind == ResolvedTypeKind::execution_effects || kind
            == ResolvedTypeKind::bootstrap_effects;
    }
    auto resource_kind(ResolvedTypeKind kind) -> bool {
        return kind == ResolvedTypeKind::byte_region || kind == ResolvedTypeKind::owned_bytes || kind
            == ResolvedTypeKind::owned_values || kind == ResolvedTypeKind::service_resource;
    }
    // These numbers are index ordering only. They are never exported as type
    // kinds, native signature components, or a foreign enum representation.
    auto type_rank(ResolvedTypeKind kind) -> i64 {
        if (kind == ResolvedTypeKind::bootstrap_effects) {
            return 28;
        }
        if (kind == ResolvedTypeKind::i64_value) {
            return 1;
        }
        if (kind == ResolvedTypeKind::u64_value) {
            return 2;
        }
        if (kind == ResolvedTypeKind::u8_value) {
            return 3;
        }
        if (kind == ResolvedTypeKind::bool_value) {
            return 4;
        }
        if (kind == ResolvedTypeKind::owner) {
            return 5;
        }
        if (kind == ResolvedTypeKind::reference) {
            return 6;
        }
        if (kind == ResolvedTypeKind::mutable_reference) {
            return 7;
        }
        if (kind == ResolvedTypeKind::class_value) {
            return 8;
        }
        if (kind == ResolvedTypeKind::enum_value) {
            return 9;
        }
        if (kind == ResolvedTypeKind::array_value) {
            return 10;
        }
        if (kind == ResolvedTypeKind::parameter) {
            return 11;
        }
        if (kind == ResolvedTypeKind::byte_span) {
            return 12;
        }
        if (kind == ResolvedTypeKind::byte_region) {
            return 13;
        }
        if (kind == ResolvedTypeKind::owned_bytes) {
            return 14;
        }
        if (kind == ResolvedTypeKind::console_session) {
            return 15;
        }
        if (kind == ResolvedTypeKind::display_session) {
            return 16;
        }
        if (kind == ResolvedTypeKind::event_session) {
            return 17;
        }
        if (kind == ResolvedTypeKind::owned_values) {
            return 18;
        }
        if (kind == ResolvedTypeKind::call_session) {
            return 19;
        }
        if (kind == ResolvedTypeKind::port_range) {
            return 20;
        }
        if (kind == ResolvedTypeKind::serve_session) {
            return 21;
        }
        if (kind == ResolvedTypeKind::value_span) {
            return 22;
        }
        if (kind == ResolvedTypeKind::host_files) {
            return 23;
        }
        if (kind == ResolvedTypeKind::service_resource) {
            return 27;
        }
        if (kind == ResolvedTypeKind::execution_effects) {
            return 26;
        }
        if (kind == ResolvedTypeKind::writable_block) {
            return 25;
        }
        if (kind == ResolvedTypeKind::read_only_block) {
            return 24;
        }
        return 0;
    }
    auto category(DeclarationKind kind) -> i64 {
        if (kind == DeclarationKind::enumeration) {
            return 1;
        }
        if (kind == DeclarationKind::class_value) {
            return 2;
        }
        if (kind == DeclarationKind::class_template) {
            return 3;
        }
        if (kind == DeclarationKind::function_template) {
            return 4;
        }
        if (kind == DeclarationKind::function) {
            return 5;
        }
        if (kind == DeclarationKind::method) {
            return 6;
        }
        if (kind == DeclarationKind::constructor) {
            return 7;
        }
        return 0;
    }
    auto state(Session& session) -> i64 {
        i64 found = session.index(42, 0, 0, 0, 0);
        if (found < 0) {
            MetaRow value = MetaRow(MetaTag::context);
            i64 at = 0;
            while (at < 15) {
                value.set_word(at, 0);
                at = at + 1;
            }
            value.set_word(0, 99);
            value.set_word(5, session.syntax_count());
            found = session.append_meta(value);
            session.index_insert(42, 0, 0, 0, 0, found);
        }
        return found;
    }
    auto leaf_is(Session& session, i64 name, builtin::span<const u8> text) -> bool {
        if (name < 0) {
            return false;
        }
        const i64 atom = name_atom(session, name);
        const i64 reference = atom_source(session, atom);
        return session.source_equal(reference, text);
    }
    auto plain_is(Session& session, i64 name, builtin::span<const u8> text) -> bool {
        return name >= 0 && prefix_parent(session, name) < 0 && leaf_is(session, name, text);
    }
    auto builtin_name(Session& session, i64 name) -> bool {
        if (name < 0) {
            return false;
        }
        const i64 parent = prefix_parent(session, name);
        return plain_is(session, parent, "builtin");
    }
    auto source_identifier(Session& session, i64 name, i64 node) -> bool {
        const i64 base = session.work_count();
        i64 current = name;
        while (current >= 0 && session.good()) {
            session.append_work(WorkRow(current, 0, 0, 0, 0, 0));
            current = prefix_parent(session, current);
        }
        while (session.work_count() > base && session.good()) {
            const i64 top = session.work_count() - 1;
            const WorkRow item = session.work(top);
            session.truncate_work(top);
            const i64 atom = name_atom(session, item.word(0));
            const i64 reference = atom_source(session, atom);
            if (session.source_prefix(reference, "__au_")) {
                reject(session, SemanticError::reserved_prefix, node, reference, -1);
            } else {
                if (session.source_equal(reference, "builtin")) {
                    reject(session, SemanticError::reserved_builtin, node, reference, -1);
                }
            }
        }
        session.truncate_work(base);
        return session.good();
    }
    auto intrinsic(Session& session, i64 name) -> bool {
        if (name < 0 || prefix_parent(session, name) >= 0) {
            return false;
        }
        return leaf_is(session, name, "i64") || leaf_is(session, name, "u64") || leaf_is(session, name, "u8")
            || leaf_is(session, name, "own") || leaf_is(session, name, "move") || leaf_is(session, name, "borrow")
            || leaf_is(session, name, "borrow_mut") || leaf_is(session, name, "borrow_bytes") || leaf_is(session, name,
            "borrow_values") || leaf_is(session, name, "read") || leaf_is(session, name, "write") || leaf_is(session,
            name, "size_of") || leaf_is(session, name, "type_id") || leaf_is(session, name, "field_count")
            || leaf_is(session, name, "len") || leaf_is(session, name, "reflect_size") || leaf_is(session, name,
            "reflect_field_count") || leaf_is(session, name, "aurora_reflect_size") || leaf_is(session, name,
            "aurora_reflect_field_count");
    }
    auto concrete_type(Session& session, ResolvedTypeKind kind, i64 nominal, i64 element, i64 length) -> i64 {
        const i64 rank = type_rank(kind);
        i64 found = session.index(34, rank, nominal, element, length);
        if (found >= 0) {
            return found;
        }
        MetaRow value = MetaRow(MetaTag::concrete_type);
        value.set_type_kind(kind);
        value.set_word(1, nominal);
        value.set_word(2, element);
        value.set_word(3, length);
        found = session.append_meta(value);
        session.index_insert(34, rank, nominal, element, length, found);
        return found;
    }
    auto scalar_type(Session& session, ResolvedTypeKind kind) -> i64 {
        return concrete_type(session, kind, -1, -1, 0);
    }
    auto category_list(Session& session, i64 module_id, DeclarationKind kind) -> i64 {
        const i64 tag = category(kind);
        i64 found = session.index(33, module_id, tag, 0, 0);
        if (found < 0) {
            MetaRow list = MetaRow(MetaTag::link);
            list.set_word(2, 0);
            found = session.append_meta(list);
            session.index_insert(33, module_id, tag, 0, 0, found);
        }
        return found;
    }
    auto first_symbol(Session& session, i64 module_id, DeclarationKind kind) -> i64 {
        const i64 list = category_list(session, module_id, kind);
        return mw(session, list, 0);
    }
    auto append_symbol(Session& session, i64 symbol) -> i64 {
        const DeclarationKind kind = declaration_kind(session, symbol);
        const i64 defining_unit = mw(session, symbol, 1);
        const i64 list = category_list(session, defining_unit, kind);
        const i64 tail = mw(session, list, 1);
        if (tail >= 0) {
            set_mw(session, tail, 14, symbol);
        } else {
            set_mw(session, list, 0, symbol);
        }
        set_mw(session, list, 1, symbol);
        const i64 count = mw(session, list, 2) + 1;
        set_mw(session, list, 2, count);
        return symbol;
    }
    auto module_at_order(Session& session, i64 order) -> i64 {
        i64 at = 0;
        while (at < session.module_count()) {
            if (mw(session, at, 12) == order) {
                return at;
            }
            at = at + 1;
        }
        return -1;
    }
    auto direct_import(Session& session, i64 module_id, i64 target) -> bool {
        i64 edge = import_head(session, module_id);
        while (edge >= 0 && session.good()) {
            if (mw(session, edge, 1) == target) {
                return true;
            }
            edge = mw(session, edge, 4);
        }
        return false;
    }
    auto exported(Session& session, i64 symbol) -> bool {
        const i64 group = mw(session, symbol, 10);
        if (group >= 0) {
            return mw(session, group, 3) != 0;
        }
        return mw(session, symbol, 6) != 0;
    }
    auto visible_name(Session& session, i64 module_id, i64 name, i64 node) -> i64 {
        i64 found = session.index(32, module_id, name, 0, 0);
        i64 edge = import_head(session, module_id);
        while (edge >= 0 && session.good()) {
            const i64 imported_unit = mw(session, edge, 1);
            const i64 candidate = session.index(32, imported_unit, name, 0, 0);
            if (candidate >= 0 && exported(session, candidate)) {
                if (found >= 0) {
                    return reject(session, SemanticError::ambiguous_visible, node, name, module_id);
                }
                found = candidate;
            }
            edge = mw(session, edge, 4);
        }
        return found;
    }
    auto lookup(Session& session, BindContext context, i64 name, DeclarationKind required, i64 node) -> i64 {
        if (!source_identifier(session, name, node)) {
            return -1;
        }
        i64 parent = context.scope();
        bool finished = false;
        while (!finished && session.good()) {
            const i64 qualified = prefix_join(session, parent, name);
            const i64 found = visible_name(session, context.module_id(), qualified, node);
            if (found >= 0) {
                if (required != DeclarationKind::invalid && declaration_kind(session, found) != required) {
                    return reject(session, SemanticError::wrong_kind, node, qualified, -1);
                }
                return found;
            }
            if (parent < 0) {
                finished = true;
            } else {
                parent = prefix_parent(session, parent);
            }
        }
        parent = context.scope();
        finished = false;
        while (!finished && session.good()) {
            const i64 qualified = prefix_join(session, parent, name);
            i64 edge = import_head(session, context.module_id());
            while (edge >= 0 && session.good()) {
                const i64 imported_unit = mw(session, edge, 1);
                const i64 candidate = session.index(32, imported_unit, qualified, 0, 0);
                if (candidate >= 0 && !exported(session, candidate)) {
                    if (declaration_kind(session, candidate) == DeclarationKind::function) {
                        return reject(session, SemanticError::private_function, node, qualified, -1);
                    }
                    return reject(session, SemanticError::private_type, node, qualified, -1);
                }
                edge = mw(session, edge, 4);
            }
            if (parent < 0) {
                finished = true;
            } else {
                parent = prefix_parent(session, parent);
            }
        }
        return -1;
    }
    auto instance_argument(Session& session, i64 symbol, i64 index) -> i64 {
        const i64 instance = mw(session, symbol, 9);
        if (instance < 0 || index < 0 || index >= mw(session, instance, 1)) {
            return -1;
        }
        return mw(session, instance, 2 + index);
    }
    auto exact_argument(Session& session, i64 symbol, i64 type) -> bool {
        if (symbol < 0) {
            return false;
        }
        return instance_argument(session, symbol, 0) == type || instance_argument(session, symbol, 1) == type;
    }
    auto enqueue_type(Session& session, i64 type, i64 generation) -> i64 {
        if (mw(session, type, 14) != generation) {
            set_mw(session, type, 14, generation);
            session.append_work(WorkRow(type, 0, 0, 0, 0, 0));
        }
        return 0;
    }
    auto type_accessible(Session& session, i64 type, i64 module_id, i64 authority) -> bool {
        const i64 base = session.work_count();
        const i64 status = state(session);
        const i64 generation = mw(session, status, 6) + 1;
        set_mw(session, status, 6, generation);
        enqueue_type(session, type, generation);
        i64 position = base;
        bool accessible = true;
        while (position < session.work_count() && accessible && session.good()) {
            const WorkRow item = session.work(position);
            position = position + 1;
            const i64 current = item.word(0);
            const ResolvedTypeKind kind = type_kind(session, current);
            if (kind == ResolvedTypeKind::array_value || kind == ResolvedTypeKind::owned_values || kind
                == ResolvedTypeKind::value_span) {
                const i64 element = mw(session, current, 2);
                enqueue_type(session, element, generation);
            } else {
                if (nominal_kind(kind)) {
                    const i64 symbol = mw(session, current, 1);
                    if (symbol < 0) {
                        accessible = false;
                    } else {
                        if (mw(session, symbol, 13) != generation) {
                            set_mw(session, symbol, 13, generation);
                            const MetaRow declaration = session.meta(symbol);
                            if (declaration.native_mode() != NativeMode::sealed_builtin && !exact_argument(session,
                                authority, current)) {
                                if (module_id < 0) {
                                    accessible = mw(session, symbol, 6) != 0;
                                } else {
                                    if (mw(session, symbol, 1) != module_id) {
                                        const i64 defining_unit = mw(session, symbol, 1);
                                        accessible = mw(session, symbol, 6) != 0 && direct_import(session, module_id,
                                            defining_unit);
                                    }
                                }
                                const i64 instance = mw(session, symbol, 9);
                                if (instance >= 0) {
                                    i64 index = 0;
                                    while (index < mw(session, instance, 1)) {
                                        const i64 argument = mw(session, instance, 2 + index);
                                        if (argument >= 0) {
                                            enqueue_type(session, argument, generation);
                                        }
                                        index = index + 1;
                                    }
                                }
                                i64 edge = mw(session, symbol, 12);
                                while (edge >= 0 && session.good()) {
                                    const i64 exposed = mw(session, edge, 0);
                                    enqueue_type(session, exposed, generation);
                                    edge = mw(session, edge, 1);
                                }
                            }
                        }
                    }
                }
            }
        }
        session.truncate_work(base);
        return accessible && session.good();
    }
    auto body_visible(Session& session, i64 type, BindContext context) -> bool {
        const ResolvedTypeKind kind = type_kind(session, type);
        if (context.receiver() >= 0 && mw(session, context.receiver(), 9) >= 0) {
            if (kind == ResolvedTypeKind::class_value && mw(session, type, 1) == context.receiver()) {
                return true;
            }
            if (exact_argument(session, context.receiver(), type)) {
                return true;
            }
        }
        return type_accessible(session, type, context.module_id(), context.function());
    }
    auto record_authority(Session& session, i64 type, BindContext context) -> i64 {
        if (context.function() < 0 || mw(session, context.function(), 9) < 0 || !nominal_kind(type_kind(session, type))
            || !body_visible(session, type, context)) {
            return 0;
        }
        const i64 nominal = mw(session, type, 1);
        if (session.index(37, context.function(), nominal, 0, 0) >= 0) {
            return 0;
        }
        MetaRow edge = MetaRow(MetaTag::authority);
        edge.set_word(0, context.function());
        edge.set_word(1, nominal);
        const i64 result = session.append_meta(edge);
        session.index_insert(37, context.function(), nominal, 0, 0, result);
        return 0;
    }

    auto push_declarations(Session& session, i64 last, i64 scope, i64 exported_scope, i64 receiver) -> i64 {
        i64 current = last;
        while (current >= 0 && session.good()) {
            session.append_work(WorkRow(current, scope, exported_scope, receiver, 0, 0));
            current = sw(session, current, 2);
        }
        return 0;
    }
    auto declaration_name(Session& session, i64 node) -> i64 {
        const i64 reference = sw(session, node, 0);
        return source_name(session, reference);
    }
    auto make_symbol(Session& session, DeclarationKind kind, i64 module_id, i64 scope, i64 node) -> i64 {
        const i64 leaf = declaration_name(session, node);
        const i64 qualified = prefix_join(session, scope, leaf);
        const i64 reference = sw(session, node, 0);
        MetaRow value = MetaRow(MetaTag::symbol);
        value.set_declaration_kind(kind);
        value.set_word(1, module_id);
        value.set_word(2, scope);
        value.set_word(3, qualified);
        value.set_word(4, reference);
        value.set_word(5, node);
        value.set_word(6, 0);
        value.set_word(13, 0);
        const i64 symbol = session.append_meta(value);
        return append_symbol(session, symbol);
    }
    auto add_namespace(Session& session, i64 module_id, i64 name, i64 node) -> i64 {
        i64 at = name;
        while (at >= 0 && session.good()) {
            if (session.index(38, module_id, at, 0, 0) < 0) {
                MetaRow value = MetaRow(MetaTag::context);
                value.set_word(0, 2);
                value.set_word(1, module_id);
                value.set_word(2, at);
                value.set_word(3, node);
                const i64 row = session.append_meta(value);
                session.index_insert(38, module_id, at, 0, 0, row);
            }
            at = prefix_parent(session, at);
        }
        return 0;
    }
    auto gather_module(Session& session, i64 module_id) -> i64 {
        const i64 base = session.work_count();
        const i64 root = mw(session, module_id, 10);
        const i64 declarations = sw(session, root, 8);
        push_declarations(session, declarations, -1, 0, -1);
        while (session.work_count() > base && session.good()) {
            const i64 top = session.work_count() - 1;
            const WorkRow item = session.work(top);
            session.truncate_work(top);
            const i64 wrapper = item.word(0);
            const i64 node = sw(session, wrapper, 7);
            const SyntaxRow syntax = session.syntax(node);
            const i64 scope = item.word(1);
            bool is_exported = item.word(2) != 0 || sw(session, wrapper, 9) != 0;
            i64 export_value = 0;
            if (is_exported) {
                export_value = 1;
            }
            if (syntax.declaration_kind() == compiler_parser::SyntaxKind::namespace_definition) {
                const i64 relative = source_name_range(session, syntax.word(0), syntax.word(6));
                const i64 full = prefix_join(session, scope, relative);
                add_namespace(session, module_id, full, node);
                push_declarations(session, syntax.word(7), full, export_value, -1);
            } else {
                DeclarationKind kind = DeclarationKind::function;
                const i64 parameters = sw(session, wrapper, 8);
                if (syntax.declaration_kind() == compiler_parser::SyntaxKind::enum_definition) {
                    kind = DeclarationKind::enumeration;
                } else {
                    if (syntax.declaration_kind() == compiler_parser::SyntaxKind::class_definition) {
                        kind = DeclarationKind::class_value;
                        if (parameters >= 0) {
                            kind = DeclarationKind::class_template;
                        }
                    } else {
                        if (parameters >= 0) {
                            kind = DeclarationKind::function_template;
                        }
                    }
                }
                const i64 symbol = make_symbol(session, kind, module_id, scope, node);
                set_mw(session, symbol, 6, export_value);
                set_mw(session, symbol, 8, parameters);
                if (kind == DeclarationKind::function) {
                    const i64 qualified = mw(session, symbol, 3);
                    i64 group = session.index(47, module_id, qualified, 0, 0);
                    if (group < 0) {
                        MetaRow value = MetaRow(MetaTag::overload);
                        value.set_word(2, 0);
                        value.set_word(3, 0);
                        value.set_word(4, symbol);
                        group = session.append_meta(value);
                        session.index_insert(47, module_id, qualified, 0, 0, group);
                    }
                    MetaRow edge = MetaRow(MetaTag::link);
                    edge.set_word(0, symbol);
                    const i64 linked = session.append_meta(edge);
                    const i64 last = mw(session, group, 1);
                    if (last >= 0) {
                        set_mw(session, last, 1, linked);
                    } else {
                        set_mw(session, group, 0, linked);
                    }
                    set_mw(session, group, 1, linked);
                    const i64 count = mw(session, group, 2) + 1;
                    set_mw(session, group, 2, count);
                    if (is_exported) {
                        set_mw(session, group, 3, 1);
                    }
                    set_mw(session, symbol, 10, group);
                }
            }
        }
        session.truncate_work(base);
        return 0;
    }
    auto list_count(Session& session, i64 last) -> i64 {
        i64 count = 0;
        i64 current = last;
        while (current >= 0 && session.good()) {
            count = count + 1;
            current = sw(session, current, 2);
        }
        return count;
    }
    // Only bounded parameter/case/member searches use reverse-list indexing.
    // Arbitrarily long declaration and body lists use worklist reversal instead.
    auto list_item(Session& session, i64 last, i64 index) -> i64 {
        const i64 count = list_count(session, last);
        i64 steps = count - index - 1;
        i64 current = last;
        while (current >= 0 && steps > 0 && session.good()) {
            current = sw(session, current, 2);
            steps = steps - 1;
        }
        if (index < 0 || index >= count) {
            return -1;
        }
        return current;
    }
    auto raw_value_boundary(Session& session, i64 type, bool parameter) -> bool {
        if (type < 0) {
            return false;
        }
        const SyntaxRow syntax = session.syntax(type);
        if (syntax.type_kind() == compiler_parser::TypeKind::named || syntax.type_kind()
            == compiler_parser::TypeKind::owned_values) {
            return true;
        }
        if (parameter && (syntax.type_kind() == compiler_parser::TypeKind::byte_span || syntax.type_kind()
            == compiler_parser::TypeKind::value_span)) {
            return true;
        }
        if (syntax.type_kind() == compiler_parser::TypeKind::builtin_class) {
            return true;
        }
        if (syntax.type_kind() == compiler_parser::TypeKind::builtin_type) {
            const i64 name = source_name_range(session, syntax.word(0), syntax.word(1));
            const i64 seeded = session.index(48, name, 0, 0, 0);
            if (seeded >= 0) {
                const MetaRow descriptor = session.meta(seeded);
                return resource_kind(descriptor.type_kind()) || (parameter && service_kind(descriptor.type_kind()));
            }
        }
        return false;
    }
    auto function_boundary(Session& session, i64 node) -> bool {
        const i64 result = sw(session, node, 5);
        if (raw_value_boundary(session, result, false)) {
            return true;
        }
        i64 parameter = sw(session, node, 8);
        while (parameter >= 0 && session.good()) {
            const i64 type = sw(session, parameter, 5);
            if (raw_value_boundary(session, type, true)) {
                return true;
            }
            parameter = sw(session, parameter, 2);
        }
        return false;
    }
    auto reserved_leaf(Session& session, i64 leaf, DeclarationKind kind, i64 scope) -> bool {
        if (intrinsic(session, leaf)) {
            return true;
        }
        if (plain_is(session, leaf, "array")) {
            return kind != DeclarationKind::class_template || !plain_is(session, scope, "std");
        }
        return kind != DeclarationKind::function && (plain_is(session, leaf, "bool") || plain_is(session, leaf, "ref")
            || plain_is(session, leaf, "mutref"));
    }
    auto register_symbol(Session& session, i64 symbol) -> i64 {
        MetaRow declaration = session.meta(symbol);
        const DeclarationKind kind = declaration.declaration_kind();
        const i64 module_id = declaration.word(1);
        const i64 scope = declaration.word(2);
        const i64 qualified = declaration.word(3);
        const i64 node = declaration.word(5);
        const i64 leaf = declaration_name(session, node);
        const i64 group = declaration.word(10);
        bool overloaded = false;
        if (kind == DeclarationKind::function && group >= 0) {
            overloaded = mw(session, group, 2) > 1;
        }
        if (overloaded) {
            if (mw(session, group, 2) > 32) {
                return reject(session, SemanticError::overload_count, node, qualified, -1);
            }
            if (mw(session, module_id, 14) != 0 && scope < 0 && plain_is(session, leaf, "answer")) {
                return reject(session, SemanticError::answer_overload, node, -1, -1);
            }
            i64 parameter = sw(session, node, 8);
            while (parameter >= 0 && session.good()) {
                if (sw(session, parameter, 10) >= 0) {
                    return reject(session, SemanticError::borrowed_overload, node, qualified, -1);
                }
                parameter = sw(session, parameter, 2);
            }
        }
        const i64 previous = session.index(32, module_id, qualified, 0, 0);
        if (!overloaded || previous < 0) {
            if (!source_identifier(session, scope, node) || !source_identifier(session, leaf, node)) {
                return -1;
            }
            if (session.index(38, module_id, qualified, 0, 0) >= 0) {
                return reject(session, SemanticError::namespace_collision, node, qualified, -1);
            }
            if (reserved_leaf(session, leaf, kind, scope)) {
                if (kind == DeclarationKind::function) {
                    return reject(session, SemanticError::reserved_function, node, -1, -1);
                }
                return reject(session, SemanticError::reserved_class, node, -1, -1);
            }
        }
        if (previous >= 0 && !(overloaded && declaration_kind(session, previous) == DeclarationKind::function)) {
            if (overloaded) {
                return reject(session, SemanticError::reserved_function, node, qualified, -1);
            }
            if (kind == DeclarationKind::function) {
                return reject(session, SemanticError::duplicate_function, node, module_id, qualified);
            }
            return reject(session, SemanticError::duplicate_class, node, module_id, qualified);
        }
        if (previous < 0) {
            session.index_insert(32, module_id, qualified, 0, 0, symbol);
        }
        NativeMode native = NativeMode::class_value;
        if (kind == DeclarationKind::enumeration) {
            native = NativeMode::enumeration;
        }
        if (kind == DeclarationKind::class_template) {
            native = NativeMode::class_template;
        }
        if (kind == DeclarationKind::function_template) {
            native = NativeMode::function_template;
        }
        if (kind == DeclarationKind::function) {
            if (overloaded) {
                native = NativeMode::ordinary_overload;
            } else {
                declaration.set_word(10, -1);
                native = NativeMode::function;
                if (function_boundary(session, node)) {
                    native = NativeMode::value_function;
                } else {
                    if (mw(session, module_id, 14) != 0 && scope < 0) {
                        native = NativeMode::root_entry;
                    }
                }
            }
        }
        declaration.set_native_mode(native);
        session.set_meta(symbol, declaration);
        if (native != NativeMode::ordinary_overload) {
            finalize_linkage(session, symbol);
        }
        return symbol;
    }
    auto index_members(Session& session, i64 symbol) -> i64 {
        const i64 root = mw(session, symbol, 5);
        const i64 last = sw(session, root, 7);
        const i64 base = session.work_count();
        push_declarations(session, last, -1, 0, symbol);
        while (session.work_count() > base && session.good()) {
            const i64 top = session.work_count() - 1;
            const WorkRow item = session.work(top);
            session.truncate_work(top);
            const i64 member = sw(session, item.word(0), 7);
            const SyntaxRow row = session.syntax(member);
            i64 reference = row.word(0);
            if (row.declaration_kind() == compiler_parser::SyntaxKind::field) {
                reference = row.word(6);
            }
            const i64 name = source_name(session, reference);
            if (session.index(58, symbol, name, 0, 0) < 0) {
                session.index_insert(58, symbol, name, 0, 0, member);
            }
        }
        session.truncate_work(base);
        return 0;
    }
    auto register_members(Session& session, i64 symbol) -> i64 {
        index_members(session, symbol);
        const i64 node = mw(session, symbol, 5);
        const i64 scope = mw(session, symbol, 2);
        const i64 module_id = mw(session, symbol, 1);
        const i64 body = sw(session, node, 7);
        i64 wrapper = body;
        while (wrapper >= 0 && session.good()) {
            const i64 member = sw(session, wrapper, 7);
            const SyntaxRow syntax = session.syntax(member);
            if (syntax.declaration_kind() == compiler_parser::SyntaxKind::field) {
                const i64 reference = syntax.word(6);
                const i64 name = source_name(session, reference);
                if (session.index(46, symbol, name, 0, 0) < 0) {
                    session.index_insert(46, symbol, name, 0, 0, member);
                }
            }
            wrapper = sw(session, wrapper, 2);
        }
        const i64 base = session.work_count();
        push_declarations(session, body, scope, 0, symbol);
        while (session.work_count() > base && session.good()) {
            const i64 top = session.work_count() - 1;
            const WorkRow item = session.work(top);
            session.truncate_work(top);
            const i64 declaration = item.word(0);
            const i64 member = sw(session, declaration, 7);
            const SyntaxRow syntax = session.syntax(member);
            if (syntax.declaration_kind() != compiler_parser::SyntaxKind::field) {
                const i64 name = declaration_name(session, member);
                const bool constructor = syntax.declaration_kind() == compiler_parser::SyntaxKind::constructor;
                if (source_identifier(session, name, member)) {
                    if (intrinsic(session, name) || (!constructor && plain_is(session, name, "array"))
                        || session.index(46, symbol, name, 0, 0) >= 0) {
                        reject(session, SemanticError::duplicate_member, member, name, -1);
                    } else {
                        DeclarationKind kind = DeclarationKind::method;
                        NativeMode native = NativeMode::method;
                        if (constructor) {
                            kind = DeclarationKind::constructor;
                            native = NativeMode::constructor;
                        }
                        const i64 method = make_symbol(session, kind, module_id, scope, member);
                        MetaRow value = session.meta(method);
                        value.set_word(7, symbol);
                        value.set_word(6, sw(session, declaration, 9));
                        value.set_native_mode(native);
                        session.set_meta(method, value);
                        session.index_insert(46, symbol, name, 0, 0, method);
                        set_rw(session, member, 1, method);
                        finalize_linkage(session, method);
                    }
                }
            }
        }
        session.truncate_work(base);
        return 0;
    }
    auto register_enum(Session& session, i64 symbol) -> i64 {
        const i64 status = state(session);
        const i64 count = mw(session, status, 2) + 1;
        set_mw(session, status, 2, count);
        const i64 node = mw(session, symbol, 5);
        if (count > 256) {
            return reject(session, SemanticError::enum_count, node, -1, -1);
        }
        const i64 cases = sw(session, node, 7);
        const i64 size = list_count(session, cases);
        if (size < 1 || size > 256) {
            return reject(session, SemanticError::enum_cases, node, -1, -1);
        }
        i64 ordinal = 0;
        while (ordinal < size && session.good()) {
            const i64 value = list_item(session, cases, ordinal);
            const i64 name = declaration_name(session, value);
            if (source_identifier(session, name, value)) {
                if (session.index(49, symbol, name, 0, 0) >= 0) {
                    reject(session, SemanticError::duplicate_enum_case, value, name, -1);
                } else {
                    MetaRow record = MetaRow(MetaTag::link);
                    record.set_word(0, value);
                    record.set_word(1, ordinal);
                    const i64 edge = session.append_meta(record);
                    session.index_insert(49, symbol, name, 0, 0, edge);
                }
            }
            ordinal = ordinal + 1;
        }
        if (session.good()) {
            register_symbol(session, symbol);
        }
        return 0;
    }

    auto parameter_index(Session& session, i64 symbol, i64 name) -> i64 {
        const i64 last = mw(session, symbol, 8);
        const i64 count = list_count(session, last);
        i64 at = 0;
        while (at < count && session.good()) {
            const i64 node = list_item(session, last, at);
            const i64 candidate = declaration_name(session, node);
            if (candidate == name) {
                return at;
            }
            at = at + 1;
        }
        return -1;
    }
    auto capacity_parameter(Session& session, i64 symbol, i64 name) -> bool {
        const i64 index = parameter_index(session, symbol, name);
        if (index < 0) {
            return false;
        }
        const i64 last = mw(session, symbol, 8);
        const i64 node = list_item(session, last, index);
        const SyntaxRow parameter = session.syntax(node);
        return parameter.declaration_kind() == compiler_parser::SyntaxKind::template_capacity;
    }
    auto parameter_root(Session& session, i64 symbol, i64 name) -> bool {
        if (name < 0 || prefix_parent(session, name) < 0) {
            return false;
        }
        i64 first = name;
        while (prefix_parent(session, first) >= 0 && session.good()) {
            first = prefix_parent(session, first);
        }
        return parameter_index(session, symbol, first) >= 0;
    }
    auto syntax_child(SyntaxRow row, i64 slot) -> bool {
        if (row.kind() == SyntaxTag::edge) {
            return slot == 0 || slot == 1;
        }
        if (row.kind() == SyntaxTag::type) {
            return slot == 3 || slot == 4;
        }
        if (row.kind() == SyntaxTag::declaration) {
            return slot == 2 || slot == 3 || slot == 4 || slot == 5 || slot == 7 || slot == 8;
        }
        if (row.kind() == SyntaxTag::expression) {
            if (slot == 6) {
                return true;
            }
            if (slot == 1) {
                return true;
            }
            return slot == 2 && (row.expression_kind() == compiler_parser::NodeKind::binary || row.expression_kind()
                == compiler_parser::NodeKind::index);
        }
        return false;
    }
    auto push_children(Session& session, i64 node, i64 action, i64 context) -> i64 {
        const SyntaxRow row = session.syntax(node);
        i64 slot = 0;
        while (slot < 12 && session.good()) {
            if (syntax_child(row, slot) && row.word(slot) >= 0) {
                session.append_work(WorkRow(row.word(slot), action, context, 0, 0, 0));
            }
            slot = slot + 1;
        }
        return 0;
    }
    auto attach_expression_types(Session& session) -> i64 {
        const i64 count = session.syntax_count();
        i64 at = 0;
        while (at < count && session.good()) {
            const SyntaxRow row = session.syntax(at);
            if (row.kind() == SyntaxTag::type && (row.type_kind() == compiler_parser::TypeKind::named || row.type_kind()
                == compiler_parser::TypeKind::parameter || row.type_kind()
                == compiler_parser::TypeKind::length_parameter || row.type_kind()
                == compiler_parser::TypeKind::builtin_type || row.type_kind()
                == compiler_parser::TypeKind::builtin_class)) {
                const i64 name = source_name_range(session, row.word(0), row.word(1));
                set_rw(session, at, 0, name);
            }
            if (row.kind() == SyntaxTag::type && (row.word(6) == 1 || row.word(6) == 2)) {
                session.index_insert(36, row.word(11), row.word(5), row.word(6), 0, at);
            }
            at = at + 1;
        }
        at = 0;
        while (at < count && session.good()) {
            SyntaxRow row = session.syntax(at);
            if (row.kind() == SyntaxTag::expression) {
                i64 type = session.index(36, row.word(11), row.word(0), 1, 0);
                i64 role = 1;
                if (type < 0) {
                    type = session.index(36, row.word(11), row.word(0), 2, 0);
                    role = 2;
                }
                if (type >= 0) {
                    row.set_word(6, type);
                    row.set_word(7, role);
                    session.set_syntax(at, row);
                }
            }
            at = at + 1;
        }
        return 0;
    }
    auto raw_scalar(compiler_parser::TypeKind kind) -> bool {
        return kind == compiler_parser::TypeKind::i64_type || kind == compiler_parser::TypeKind::u64_type || kind
            == compiler_parser::TypeKind::u8_type || kind == compiler_parser::TypeKind::bool_type;
    }
    auto template_boundary(Session& session, i64 type, i64 node) -> bool {
        if (type < 0) {
            return true;
        }
        const SyntaxRow value = session.syntax(type);
        if (raw_scalar(value.type_kind()) || value.type_kind() == compiler_parser::TypeKind::named || value.type_kind()
            == compiler_parser::TypeKind::parameter) {
            return true;
        }
        if (value.type_kind() == compiler_parser::TypeKind::builtin_class || value.type_kind()
            == compiler_parser::TypeKind::builtin_type) {
            const i64 name = source_name_range(session, value.word(0), value.word(1));
            const i64 descriptor = session.index(48, name, 0, 0, 0);
            if (descriptor >= 0) {
                const MetaRow builtin_descriptor = session.meta(descriptor);
                if (nominal_kind(builtin_descriptor.type_kind())) {
                    return true;
                }
            }
        }
        reject(session, SemanticError::function_boundaries, node, -1, -1);
        return false;
    }
    auto validate_parameter_list(Session& session, i64 symbol) -> i64 {
        const i64 last = mw(session, symbol, 8);
        const i64 count = list_count(session, last);
        const bool function = declaration_kind(session, symbol) == DeclarationKind::function_template;
        const i64 definition = mw(session, symbol, 5);
        if (count < 1 || count > 2) {
            if (function) {
                return reject(session, SemanticError::function_parameters, definition, -1, -1);
            }
            return reject(session, SemanticError::class_parameters, definition, -1, -1);
        }
        if (function) {
            const i64 result = sw(session, definition, 5);
            template_boundary(session, result, definition);
            const i64 params = sw(session, definition, 8);
            const i64 base = session.work_count();
            push_statement_list(session, params);
            while (session.work_count() > base && session.good()) {
                const i64 top = session.work_count() - 1;
                const WorkRow item = session.work(top);
                session.truncate_work(top);
                const i64 parameter = item.word(0);
                const i64 type = sw(session, parameter, 5);
                template_boundary(session, type, definition);
            }
            session.truncate_work(base);
        }
        i64 at = 0;
        i64 first_name = -1;
        bool first_scalar = false;
        while (at < count && session.good()) {
            const i64 node = list_item(session, last, at);
            const SyntaxRow value = session.syntax(node);
            const i64 name = declaration_name(session, node);
            if (at > 0 && name == first_name) {
                if (function) {
                    return reject(session, SemanticError::function_parameter_names, node, -1, -1);
                }
                return reject(session, SemanticError::duplicate_class_parameter, node, name, -1);
            }
            if (value.declaration_kind() == compiler_parser::SyntaxKind::template_capacity) {
                if (function) {
                    return reject(session, SemanticError::function_parameter_names, node, -1, -1);
                }
                if (at != 1 || !first_scalar) {
                    return reject(session, SemanticError::capacity_order, node, -1, -1);
                }
            }
            if (at == 0) {
                first_name = name;
                first_scalar = value.declaration_kind() == compiler_parser::SyntaxKind::template_scalar;
            }
            at = at + 1;
        }
        return count;
    }
    auto validate_template_tree(Session& session, i64 symbol, i64 root, i64 instance) -> i64 {
        const bool function = declaration_kind(session, symbol) == DeclarationKind::function_template;
        const i64 base = session.work_count();
        session.append_work(WorkRow(root, 0, symbol, 0, 0, 0));
        while (session.work_count() > base && session.good()) {
            const i64 top = session.work_count() - 1;
            const WorkRow item = session.work(top);
            session.truncate_work(top);
            const i64 node = item.word(0);
            const SyntaxRow row = session.syntax(node);
            if (row.kind() == SyntaxTag::type) {
                i64 name = -1;
                if (row.type_kind() == compiler_parser::TypeKind::named || row.type_kind()
                    == compiler_parser::TypeKind::parameter || row.type_kind()
                    == compiler_parser::TypeKind::length_parameter) {
                    name = source_name_range(session, row.word(0), row.word(1));
                }
                if (row.type_kind() == compiler_parser::TypeKind::array_type) {
                    const SyntaxRow element = session.syntax(row.word(3));
                    bool scalar = raw_scalar(element.type_kind());
                    if (element.type_kind() == compiler_parser::TypeKind::parameter) {
                        const i64 parameter_name = source_name_range(session, element.word(0), element.word(1));
                        const i64 parameter = parameter_index(session, symbol, parameter_name);
                        scalar = parameter >= 0 && !capacity_parameter(session, symbol, parameter_name);
                        if (scalar && instance >= 0) {
                            const i64 argument = mw(session, instance, 2 + parameter);
                            scalar = argument >= 0 && scalar_kind(type_kind(session, argument));
                        }
                        if (!scalar) {
                            if (function) {
                                reject(session, SemanticError::function_array_scalar, node, -1, -1);
                            } else {
                                reject(session, SemanticError::array_scalar_parameter, node, parameter_name, -1);
                            }
                        }
                    }
                    const SyntaxRow capacity = session.syntax(row.word(4));
                    i64 length = 0;
                    if (capacity.type_kind() == compiler_parser::TypeKind::length_parameter) {
                        const i64 capacity_name = source_name_range(session, capacity.word(0), capacity.word(1));
                        if (function) {
                            reject(session, SemanticError::function_capacity, node, -1, -1);
                        } else {
                            if (!capacity_parameter(session, symbol, capacity_name)) {
                                reject(session, SemanticError::unknown_capacity, node, capacity_name, -1);
                            } else {
                                length = 1;
                                if (instance >= 0) {
                                    const i64 parameter = parameter_index(session, symbol, capacity_name);
                                    length = -mw(session, instance, 2 + parameter) - 1;
                                }
                            }
                        }
                    } else {
                        length = capacity_value(session, row.word(4));
                    }
                    if (!function && session.good()) {
                        i64 maximum = 4096;
                        if (!scalar) {
                            maximum = 64;
                        }
                        if ((!scalar && element.type_kind() != compiler_parser::TypeKind::named) || length < 1 || length
                            > maximum) {
                            reject(session, SemanticError::invalid_substituted_array, node, -1, -1);
                        }
                    }
                }
                if (function && row.type_kind() == compiler_parser::TypeKind::parameter && item.word(3) > 1) {
                    reject(session, SemanticError::function_nested_dependent, node, -1, -1);
                } else {
                    if (!function && row.type_kind() == compiler_parser::TypeKind::named && row.word(3) >= 0) {
                        reject(session, SemanticError::class_body_template, node, -1, -1);
                    } else {
                        if (function && parameter_root(session, symbol, name)) {
                            reject(session, SemanticError::dependent_qualified, node, name, -1);
                        } else {
                            if (row.type_kind() == compiler_parser::TypeKind::parameter) {
                                if (parameter_index(session, symbol, name) < 0) {
                                    if (function) {
                                        reject(session, SemanticError::unknown_function_parameter, node, name, -1);
                                    } else {
                                        reject(session, SemanticError::unknown_class_parameter, node, name, -1);
                                    }
                                }
                            } else {
                                if (row.type_kind() == compiler_parser::TypeKind::length_parameter) {
                                    if (function) {
                                        reject(session, SemanticError::function_capacity, node, -1, -1);
                                    } else {
                                        if (!capacity_parameter(session, symbol, name)) {
                                            reject(session, SemanticError::unknown_capacity, node, name, -1);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            } else {
                if (row.kind() == SyntaxTag::expression) {
                    i64 name = -1;
                    if (row.expression_kind() == compiler_parser::NodeKind::name || row.expression_kind()
                        == compiler_parser::NodeKind::call || row.expression_kind()
                        == compiler_parser::NodeKind::construct) {
                        name = source_name_range(session, row.word(0), row.word(4));
                    }
                    const bool call = row.expression_kind() == compiler_parser::NodeKind::call;
                    const bool construct = row.expression_kind() == compiler_parser::NodeKind::construct;
                    const i64 parameter = parameter_index(session, symbol, name);
                    if (!function && row.word(6) >= 0 && row.word(7) == 1) {
                        reject(session, SemanticError::class_body_template, node, -1, -1);
                    } else {
                        if (function && parameter_root(session, symbol, name)) {
                            reject(session, SemanticError::dependent_qualified, node, name, -1);
                        } else {
                            if (function && (call || construct) && parameter >= 0) {
                                reject(session, SemanticError::dependent_construction, node, name, -1);
                            } else {
                                if (!function && call && parameter >= 0) {
                                    if (capacity_parameter(session, symbol, name)) {
                                        reject(session, SemanticError::capacity_callable, node, name, -1);
                                    } else {
                                        reject(session, SemanticError::dependent_conversion, node, name, -1);
                                    }
                                } else {
                                    if (!function && call && plain_is(session, name, "move")) {
                                        i64 edge = row.word(1);
                                        while (edge >= 0 && session.good()) {
                                            const i64 child = sw(session, edge, 0);
                                            const SyntaxRow argument = session.syntax(child);
                                            if (argument.expression_kind() == compiler_parser::NodeKind::name) {
                                                const i64 argument_name = source_name_range(session, argument.word(0),
                                                    argument.word(4));
                                                if (capacity_parameter(session, symbol, argument_name)) {
                                                    reject(session, SemanticError::capacity_move, child, argument_name,
                                                        -1);
                                                }
                                            }
                                            edge = sw(session, edge, 1);
                                        }
                                    }
                                }
                            }
                        }
                    }
                } else {
                    if (row.kind() == SyntaxTag::declaration) {
                        i64 reference = -1;
                        if (row.declaration_kind() == compiler_parser::SyntaxKind::local || row.declaration_kind()
                            == compiler_parser::SyntaxKind::parameter || row.declaration_kind()
                            == compiler_parser::SyntaxKind::field) {
                            reference = row.word(6);
                        }
                        if (row.declaration_kind() == compiler_parser::SyntaxKind::method || row.declaration_kind()
                            == compiler_parser::SyntaxKind::constructor) {
                            reference = row.word(0);
                        }
                        if (reference >= 0) {
                            const i64 name = source_name(session, reference);
                            if (!function && capacity_parameter(session, symbol, name)) {
                                reject(session, SemanticError::shadow_capacity, node, name, -1);
                            } else {
                                if (function && parameter_index(session, symbol, name) >= 0) {
                                    if (row.declaration_kind() == compiler_parser::SyntaxKind::parameter) {
                                        reject(session, SemanticError::shadow_function_parameter, node, -1, -1);
                                    } else {
                                        reject(session, SemanticError::shadow_function_local, node, name, -1);
                                    }
                                }
                            }
                        }
                        if (!function && row.declaration_kind() == compiler_parser::SyntaxKind::assign && row.word(4)
                            >= 0) {
                            const SyntaxRow target = session.syntax(row.word(4));
                            if (target.expression_kind() == compiler_parser::NodeKind::name) {
                                const i64 name = source_name_range(session, target.word(0), target.word(4));
                                if (capacity_parameter(session, symbol, name)) {
                                    reject(session, SemanticError::capacity_assign, node, name, -1);
                                }
                            }
                        }
                    }
                }
            }
            if (session.good()) {
                if (row.kind() == SyntaxTag::type) {
                    i64 depth = item.word(3);
                    if (row.type_kind() == compiler_parser::TypeKind::named) {
                        depth = depth + 1;
                    }
                    if (row.word(4) >= 0) {
                        session.append_work(WorkRow(row.word(4), 2, 0, depth, 0, 0));
                    }
                    if (row.word(3) >= 0) {
                        session.append_work(WorkRow(row.word(3), 2, 0, depth, 0, 0));
                    }
                } else {
                    if (row.kind() == SyntaxTag::expression) {
                        push_expression_children(session, row);
                        if (row.word(6) >= 0) {
                            session.append_work(WorkRow(row.word(6), 2, 0, 0, 0, 0));
                        }
                    } else {
                        push_statement_children(session, row);
                    }
                }
            }
        }
        session.truncate_work(base);
        return 0;
    }
    auto validate_substitution(Session& session, i64 symbol, i64 instance) -> i64 {
        const i64 node = mw(session, symbol, 5);
        if (declaration_kind(session, symbol) == DeclarationKind::function_template) {
            validate_template_tree(session, symbol, node, instance);
        } else {
            i64 phase = 0;
            while (phase < 2 && session.good()) {
                const i64 base = session.work_count();
                const i64 last = sw(session, node, 7);
                push_declarations(session, last, -1, 0, symbol);
                while (session.work_count() > base && session.good()) {
                    const i64 top = session.work_count() - 1;
                    const WorkRow item = session.work(top);
                    session.truncate_work(top);
                    const i64 member = sw(session, item.word(0), 7);
                    const SyntaxRow syntax = session.syntax(member);
                    const bool field = syntax.declaration_kind() == compiler_parser::SyntaxKind::field;
                    if ((phase == 0 && field) || (phase == 1 && !field)) {
                        validate_template_tree(session, symbol, member, instance);
                    }
                }
                session.truncate_work(base);
                phase = phase + 1;
            }
        }
        return 0;
    }
    auto register_template(Session& session, i64 symbol) -> i64 {
        const i64 status = state(session);
        const i64 count = mw(session, status, 1) + 1;
        set_mw(session, status, 1, count);
        const i64 node = mw(session, symbol, 5);
        if (count > 64) {
            return reject(session, SemanticError::template_count, node, -1, -1);
        }
        validate_parameter_list(session, symbol);
        if (session.good()) {
            validate_substitution(session, symbol, -1);
        }
        if (session.good()) {
            register_symbol(session, symbol);
        }
        if (session.good() && declaration_kind(session, symbol) == DeclarationKind::class_template) {
            index_members(session, symbol);
        }
        return 0;
    }
    auto validate_namespaces(Session& session, i64 unit) -> i64 {
        const i64 base = session.work_count();
        const i64 count = session.meta_count();
        i64 at = 0;
        while (at < count && session.good()) {
            const MetaRow row = session.meta(at);
            if (row.kind() == MetaTag::context && row.word(0) == 2 && row.word(1) == unit) {
                session.append_work(WorkRow(row.word(2), row.word(3), 0, 0, 0, 0));
            }
            at = at + 1;
        }
        sort_names(session, base);
        at = base;
        while (at < session.work_count() && session.good()) {
            const WorkRow row = session.work(at);
            source_identifier(session, row.word(0), row.word(1));
            at = at + 1;
        }
        session.truncate_work(base);
        return 0;
    }
    auto register_declarations(Session& session) -> i64 {
        i64 order = 0;
        while (order < session.module_count() && session.good()) {
            const i64 module_id = module_at_order(session, order);
            gather_module(session, module_id);
            order = order + 1;
        }
        order = 0;
        while (order < session.module_count() && session.good()) {
            const i64 module_id = module_at_order(session, order);
            validate_namespaces(session, module_id);
            i64 phase = 1;
            while (phase <= 5 && session.good()) {
                DeclarationKind kind = DeclarationKind::enumeration;
                if (phase == 2) {
                    kind = DeclarationKind::class_value;
                }
                if (phase == 3) {
                    kind = DeclarationKind::class_template;
                }
                if (phase == 4) {
                    kind = DeclarationKind::function_template;
                }
                if (phase == 5) {
                    kind = DeclarationKind::function;
                }
                i64 symbol = first_symbol(session, module_id, kind);
                while (symbol >= 0 && session.good()) {
                    if (phase == 1) {
                        register_enum(session, symbol);
                    } else {
                        if (phase == 3 || phase == 4) {
                            register_template(session, symbol);
                        } else {
                            register_symbol(session, symbol);
                            if (phase == 2 && session.good()) {
                                register_members(session, symbol);
                            }
                        }
                    }
                    symbol = mw(session, symbol, 14);
                }
                phase = phase + 1;
            }
            order = order + 1;
        }
        return 0;
    }
    auto clone_tree(Session& session, i64 prototype, i64 instance) -> i64 {
        const i64 base = session.work_count();
        const i64 status = state(session);
        const i64 source_count = mw(session, status, 5);
        i64 at = 0;
        while (at < source_count && session.good()) {
            session.append_work(WorkRow(-1, 0, 0, 0, 0, 0));
            at = at + 1;
        }
        const i64 stack = session.work_count();
        const i64 root = mw(session, prototype, 5);
        session.append_work(WorkRow(root, 0, 0, 0, 0, 0));
        while (session.work_count() > stack && session.good()) {
            const i64 top = session.work_count() - 1;
            const WorkRow item = session.work(top);
            session.truncate_work(top);
            const i64 node = item.word(0);
            const WorkRow mapped = session.work(base + node);
            if (mapped.word(0) < 0) {
                if (item.word(1) == 0) {
                    session.append_work(WorkRow(node, 1, 0, 0, 0, 0));
                    push_children(session, node, 0, 0);
                } else {
                    SyntaxRow row = session.syntax(node);
                    i64 slot = 0;
                    while (slot < 12 && session.good()) {
                        if (syntax_child(row, slot) && row.word(slot) >= 0) {
                            const WorkRow child = session.work(base + row.word(slot));
                            row.set_word(slot, child.word(0));
                        }
                        slot = slot + 1;
                    }
                    const i64 copy = session.append_syntax(row);
                    ResolvedRow binding = ResolvedRow();
                    binding.set_word(0, rw(session, node, 0));
                    if (row.kind() == SyntaxTag::type && (row.type_kind() == compiler_parser::TypeKind::parameter
                        || row.type_kind() == compiler_parser::TypeKind::length_parameter)) {
                        const i64 name = source_name_range(session, row.word(0), row.word(1));
                        const i64 parameter = parameter_index(session, prototype, name);
                        if (parameter >= 0) {
                            const i64 argument = mw(session, instance, 2 + parameter);
                            if (argument >= 0) {
                                binding.set_word(2, argument);
                                binding.set_word(7, 1);
                            } else {
                                binding.set_word(3, -argument - 1);
                            }
                        }
                    }
                    if (row.kind() == SyntaxTag::expression && row.expression_kind()
                        == compiler_parser::NodeKind::name) {
                        const i64 name = source_name_range(session, row.word(0), row.word(4));
                        if (capacity_parameter(session, prototype, name)) {
                            const i64 parameter = parameter_index(session, prototype, name);
                            const i64 argument = mw(session, instance, 2 + parameter);
                            binding.set_operation(ResolvedOperation::capacity_constant);
                            binding.set_word(3, -argument - 1);
                        }
                    }
                    session.set_resolved(copy, binding);
                    session.set_work(base + node, WorkRow(copy, 0, 0, 0, 0, 0));
                }
            }
        }
        const WorkRow result = session.work(base + root);
        const i64 copied_root = result.word(0);
        session.truncate_work(base);
        return copied_root;
    }

    // Sealed descriptors are seeded once from compiler_catalog when run starts.
    // Descriptor words [90,source-prefix,-1,native-source,member-head,member-tail].
    // Member words [91,name-source,type-or-case-ordinal,next].
    auto seed_descriptor(Session& session, i64 name, i64 native, ResolvedTypeKind kind) -> i64 {
        MetaRow descriptor = MetaRow(MetaTag::context);
        descriptor.set_word(0, 90);
        descriptor.set_word(1, name);
        descriptor.set_word(3, native);
        descriptor.set_type_kind(kind);
        const i64 result = session.append_meta(descriptor);
        session.index_insert(48, name, 0, 0, 0, result);
        return result;
    }
    auto append_seed_member(Session& session, i64 descriptor, i64 name, i64 type_or_ordinal) -> i64 {
        MetaRow member = MetaRow(MetaTag::context);
        member.set_word(0, 91);
        member.set_word(1, name);
        member.set_word(2, type_or_ordinal);
        const i64 result = session.append_meta(member);
        const i64 tail = mw(session, descriptor, 5);
        if (tail < 0) {
            set_mw(session, descriptor, 4, result);
        } else {
            set_mw(session, tail, 3, result);
        }
        set_mw(session, descriptor, 5, result);
        return result;
    }
    auto seed_type(Session& session, ResolvedTypeKind kind, i64 descriptor) -> i64 {
        if (kind == ResolvedTypeKind::service_resource) {
            const i64 resource = mw(session, descriptor, 2);
            if (resource < 0 || resource >= compiler_catalog::resource_count()) {
                return session.fail_storage(StorageStatus::invalid);
            }
            return concrete_type(session, kind, resource, -1, 0);
        }
        if (!nominal_kind(kind)) {
            return scalar_type(session, kind);
        }
        i64 symbol = session.index(50, descriptor, 0, 0, 0);
        if (symbol < 0) {
            MetaRow value = MetaRow(MetaTag::symbol);
            DeclarationKind declaration = DeclarationKind::class_value;
            if (kind == ResolvedTypeKind::enum_value) {
                declaration = DeclarationKind::enumeration;
            }
            value.set_declaration_kind(declaration);
            value.set_native_mode(NativeMode::sealed_builtin);
            value.set_word(3, mw(session, descriptor, 1));
            value.set_word(4, mw(session, descriptor, 3));
            value.set_word(6, 1);
            value.set_word(8, descriptor);
            value.set_word(13, 0);
            symbol = session.append_meta(value);
            session.index_insert(50, descriptor, 0, 0, 0, symbol);
            finalize_linkage(session, symbol);
        }
        return concrete_type(session, kind, symbol, -1, 0);
    }
    auto builtin_type(Session& session, i64 name) -> i64 {
        const i64 descriptor = session.index(48, name, 0, 0, 0);
        if (descriptor < 0) {
            return -1;
        }
        const MetaRow value = session.meta(descriptor);
        if (service_kind(value.type_kind()) || nominal_kind(value.type_kind())) {
            const i64 status = state(session);
            set_mw(session, status, 3, 1);
        }
        return seed_type(session, value.type_kind(), descriptor);
    }
    // The concrete TypeId of a seeded catalog type, or -1.
    auto catalog_type(Session& session, i64 type) -> i64 {
        return session.index(43, type, 0, 0, 0);
    }
    auto family_seeded(Session& session, i64 family) -> bool {
        i64 type = 0;
        while (type < compiler_catalog::type_count()) {
            if (compiler_catalog::type_family(type) == family) {
                return catalog_type(session, type) >= 0;
            }
            type = type + 1;
        }
        return false;
    }
    // Seeds one catalog family in catalog order: every type, then the members of
    // its nominal types. Index (43, type) holds each seeded type's concrete TypeId.
    auto seed_family(Session& session, i64 family) -> bool {
        i64 type = 0;
        while (type < compiler_catalog::type_count() && session.good()) {
            if (compiler_catalog::type_family(type) == family) {
                const ResolvedTypeKind kind = compiler_catalog::type_kind(type);
                const i64 spelling = compiler_catalog::type_word(session, type, 0, -1, 0);
                i64 native = -1;
                if (compiler_catalog::nominal(type)) {
                    native = compiler_catalog::type_word(session, type, 1, -1, 0);
                }
                const i64 name = source_name(session, spelling);
                const i64 descriptor = seed_descriptor(session, name, native, kind);
                if (kind == ResolvedTypeKind::service_resource) {
                    set_mw(session, descriptor, 2, compiler_catalog::resource_kind(type));
                }
                const i64 seeded = seed_type(session, kind, descriptor);
                session.index_insert(43, type, 0, 0, 0, seeded);
            }
            type = type + 1;
        }
        type = 0;
        while (type < compiler_catalog::type_count() && session.good()) {
            if (compiler_catalog::type_family(type) == family && compiler_catalog::nominal(type)) {
                const i64 concrete = catalog_type(session, type);
                const i64 owner = mw(session, concrete, 1);
                const i64 descriptor = mw(session, owner, 8);
                i64 member = 0;
                while (member < compiler_catalog::member_count(type) && session.good()) {
                    const i64 name = compiler_catalog::type_word(session, type, 2 + member, -1, 0);
                    i64 value = member;
                    if (compiler_catalog::type_kind(type) == ResolvedTypeKind::class_value) {
                        value = catalog_type(session, compiler_catalog::field_type(type, member));
                        const i64 length = compiler_catalog::field_array_length(type, member);
                        if (length > 0) {
                            value = concrete_type(session, ResolvedTypeKind::array_value, -1, value, length);
                        }
                    }
                    append_seed_member(session, descriptor, name, value);
                    member = member + 1;
                }
            }
            type = type + 1;
        }
        return session.good();
    }
    // The optional family named by source bytes [begin, end), or 0.
    auto named_family(Session& session, i64 begin, i64 end) -> i64 {
        i64 type = 0;
        while (type < compiler_catalog::type_count() && session.good()) {
            const i64 family = compiler_catalog::type_family(type);
            if (family != 0 && compiler_catalog::type_word(session, type, 0, begin, end) == 1) {
                return family;
            }
            type = type + 1;
        }
        return 0;
    }
    // The optional family named by the third token of a `builtin :: Name`
    // spelling between token references first and last, or 0.
    auto qualified_family(Session& session, i64 first, i64 last) -> i64 {
        if (first < 0 || last < 0) {
            return 0;
        }
        const MetaRow head = session.meta(first);
        const MetaRow tail = session.meta(last);
        if (head.kind() != MetaTag::source_reference || tail.kind() != MetaTag::source_reference || tail.word(5)
            < head.word(5) + 2 || tail.word(2) <= head.word(1) || compiler_catalog::use_word(session, "builtin", 0,
            head.word(1), head.word(2)) != 1) {
            return 0;
        }
        const i64 base = head.word(1);
        const i64 count = tail.word(2) - base;
        i64 offset = head.word(2) - base;
        i64 line = 1;
        i64 start = 0;
        bool scope = false;
        while (session.good()) {
            const compiler_lexer::Lexeme token = session.scan_range(base, count, compiler_lexer::Cursor(offset, line,
                start));
            if (token.kind() == compiler_lexer::Event::token) {
                if (scope) {
                    return named_family(session, base + offset, base + token.next_offset());
                }
                if (token.next_offset() - offset != 2 || session.source_byte(base + offset) != ':'
                    || session.source_byte(base + offset + 1) != ':') {
                    return 0;
                }
                scope = true;
            } else {
                if ((token.kind() != compiler_lexer::Event::whitespace && token.kind()
                    != compiler_lexer::Event::line_comment) || token.next_offset() <= offset) {
                    return 0;
                }
            }
            offset = token.next_offset();
            line = token.next_line();
            start = token.next_line_start();
        }
        return 0;
    }
    // Seeds the base family, then each optional family that admitted syntax of
    // an ingested module names: a builtin type, or a builtin-qualified name,
    // call or construct expression. Comments, strings and user names never do.
    auto seed_catalog(Session& session) -> bool {
        bool call = false;
        bool port = false;
        bool serve = false;
        bool host = false;
        bool block = false;
        bool writer = false;
        bool execution = false;
        bool bootstrap = false;
        bool resident = false;
        i64 at = 0;
        while (at < session.syntax_count() && session.good()) {
            const SyntaxRow row = session.syntax(at);
            i64 family = 0;
            if (row.kind() == SyntaxTag::type && (row.type_kind() == compiler_parser::TypeKind::builtin_type
                || row.type_kind() == compiler_parser::TypeKind::builtin_class) && row.word(1) >= 0) {
                const MetaRow name = session.meta(row.word(1));
                family = named_family(session, name.word(1), name.word(2));
            }
            if (row.kind() == SyntaxTag::expression && (row.expression_kind() == compiler_parser::NodeKind::name
                || row.expression_kind() == compiler_parser::NodeKind::call || row.expression_kind()
                == compiler_parser::NodeKind::construct)) {
                family = qualified_family(session, row.word(0), row.word(4));
            }
            call = call || family == 1;
            port = port || family == 2;
            serve = serve || family == 3;
            host = host || family == 4;
            block = block || family == 5;
            writer = writer || family == 6;
            execution = execution || family == 7;
            bootstrap = bootstrap || family == 8;
            resident = resident || family == 9;
            at = at + 1;
        }
        seed_family(session, 0);
        if (resident) {
            execution = true;
            bootstrap = true;
        }
        if (bootstrap) {
            seed_family(session, 8);
        }
        if (execution) {
            seed_family(session, 7);
        }
        if (resident) {
            seed_family(session, 9);
        }
        if (writer) {
            seed_family(session, 6);
        }
        if (call) {
            seed_family(session, 1);
        }
        if (port) {
            seed_family(session, 2);
        }
        if (serve) {
            seed_family(session, 3);
        }
        if (host) {
            seed_family(session, 4);
        }
        if (block) {
            seed_family(session, 5);
        }
        return session.good();
    }
    class Arguments {
        i64 size;
        i64 first;
        i64 second;
        i64 trusted;
    public:
        Arguments(i64 count, i64 left, i64 right, i64 provenance) : size(count), first(left), second(right),
            trusted(provenance) {
        }
        auto count() const -> i64 {
            return size;
        }
        auto at(i64 index) const -> i64 {
            if (index == 0) {
                return first;
            }
            return second;
        }
        auto checked(i64 index) const -> bool {
            return (u64(trusted) & (u64(1) << index)) != u64(0);
        }
    };
    auto remember_argument_check(Session& session, i64 module_id, i64 type, i64 node) -> i64 {
        MetaRow check = MetaRow(MetaTag::request);
        check.set_word(0, 1);
        check.set_word(1, module_id);
        check.set_word(2, type);
        check.set_word(3, node);
        const i64 result = session.append_meta(check);
        return result;
    }
    auto request_instance(Session& session, i64 prototype, Arguments arguments, BindContext context, i64 node) -> i64 {
        const bool function = declaration_kind(session, prototype) == DeclarationKind::function_template;
        const i64 parameters = mw(session, prototype, 8);
        const i64 count = list_count(session, parameters);
        if (arguments.count() != count) {
            const SyntaxRow request = session.syntax(node);
            i64 last = request.word(1);
            if (request.kind() == SyntaxTag::expression) {
                last = request.word(4);
            }
            const i64 spelling = source_name_range(session, request.word(0), last);
            if (function) {
                return reject(session, SemanticError::function_arity, node, spelling, -1);
            }
            return reject(session, SemanticError::class_arity, node, spelling, -1);
        }
        i64 depth = 1;
        i64 at = 0;
        while (at < count && session.good()) {
            const i64 argument = arguments.at(at);
            if (argument >= 0) {
                const ResolvedTypeKind kind = type_kind(session, argument);
                if (kind == ResolvedTypeKind::class_value) {
                    const i64 nominal = mw(session, argument, 1);
                    const i64 nested = mw(session, nominal, 9);
                    if (nested >= 0 && mw(session, nested, 4) + 1 > depth) {
                        depth = mw(session, nested, 4) + 1;
                    }
                }
                if (context.expand() && (function || (!arguments.checked(at) && nominal_kind(kind)))) {
                    remember_argument_check(session, context.module_id(), argument, node);
                }
            }
            at = at + 1;
        }
        if (!function && depth > 4) {
            return reject(session, SemanticError::template_nominal_depth, node, -1, -1);
        }
        const i64 first = arguments.at(0);
        const i64 second = arguments.at(1);
        const i64 existing = session.index(35, prototype, first, second, count);
        if (existing >= 0) {
            return mw(session, existing, 5);
        }
        if (!context.expand()) {
            if (function) {
                return reject(session, SemanticError::unexpanded_function, node, prototype, -1);
            }
            return reject(session, SemanticError::unexpanded_class, node, prototype, -1);
        }
        const i64 status = state(session);
        const i64 instances = mw(session, status, 7) + 1;
        set_mw(session, status, 7, instances);
        if (instances > 256) {
            return reject(session, SemanticError::instance_count, node, -1, -1);
        }
        at = 0;
        while (at < count && session.good()) {
            const i64 parameter = list_item(session, parameters, at);
            const SyntaxRow syntax = session.syntax(parameter);
            const i64 argument = arguments.at(at);
            bool allowed = false;
            ResolvedTypeKind kind = ResolvedTypeKind::invalid;
            if (argument >= 0) {
                kind = type_kind(session, argument);
            }
            if (syntax.declaration_kind() == compiler_parser::SyntaxKind::template_scalar) {
                allowed = argument >= 0 && scalar_kind(kind);
                if (!allowed && !function) {
                    reject(session, SemanticError::class_scalar_argument, node, -1, -1);
                }
            } else {
                if (syntax.declaration_kind() == compiler_parser::SyntaxKind::template_value) {
                    allowed = argument >= 0 && (scalar_kind(kind) || nominal_kind(kind));
                    if (!allowed && !function) {
                        reject(session, SemanticError::class_value_argument, node, -1, -1);
                    }
                } else {
                    allowed = !function && argument <= -2 && argument >= -65;
                    if (!allowed && !function) {
                        reject(session, SemanticError::class_capacity, node, -1, -1);
                    }
                }
            }
            if (!allowed && function) {
                reject(session, SemanticError::function_constraint, node, -1, -1);
            }
            at = at + 1;
        }
        if (!session.good()) {
            return -1;
        }
        MetaRow instance = MetaRow(MetaTag::instance);
        instance.set_word(0, prototype);
        instance.set_word(1, count);
        instance.set_word(2, first);
        instance.set_word(3, second);
        instance.set_word(4, depth);
        const i64 instance_id = session.append_meta(instance);
        validate_substitution(session, prototype, instance_id);
        if (!session.good()) {
            return -1;
        }
        const i64 copied_root = clone_tree(session, prototype, instance_id);
        MetaRow symbol = session.meta(prototype);
        symbol.set_word(0, -1);
        DeclarationKind kind = DeclarationKind::class_value;
        NativeMode native = NativeMode::class_value;
        if (function) {
            kind = DeclarationKind::function;
            native = NativeMode::function_template;
            symbol.set_word(6, 0);
        }
        symbol.set_declaration_kind(kind);
        symbol.set_native_mode(native);
        symbol.set_word(5, copied_root);
        symbol.set_word(8, -1);
        symbol.set_word(9, instance_id);
        symbol.set_word(10, -1);
        symbol.set_word(11, -1);
        symbol.set_word(12, -1);
        symbol.set_word(13, 0);
        symbol.set_word(14, -1);
        const i64 result = session.append_meta(symbol);
        set_mw(session, instance_id, 5, result);
        session.index_insert(35, prototype, first, second, count, instance_id);
        append_symbol(session, result);
        finalize_linkage(session, result);
        if (!function && session.good()) {
            register_members(session, result);
        }
        return result;
    }
    auto parsed_kind(compiler_parser::TypeKind kind) -> ResolvedTypeKind {
        if (kind == compiler_parser::TypeKind::i64_type) {
            return ResolvedTypeKind::i64_value;
        }
        if (kind == compiler_parser::TypeKind::u64_type) {
            return ResolvedTypeKind::u64_value;
        }
        if (kind == compiler_parser::TypeKind::u8_type) {
            return ResolvedTypeKind::u8_value;
        }
        if (kind == compiler_parser::TypeKind::bool_type) {
            return ResolvedTypeKind::bool_value;
        }
        if (kind == compiler_parser::TypeKind::own_type) {
            return ResolvedTypeKind::owner;
        }
        if (kind == compiler_parser::TypeKind::ref_type) {
            return ResolvedTypeKind::reference;
        }
        if (kind == compiler_parser::TypeKind::mutref_type) {
            return ResolvedTypeKind::mutable_reference;
        }
        if (kind == compiler_parser::TypeKind::byte_span) {
            return ResolvedTypeKind::byte_span;
        }
        return ResolvedTypeKind::invalid;
    }
    auto capacity_value(Session& session, i64 node) -> i64 {
        const i64 substituted = rw(session, node, 3);
        if (substituted >= 0) {
            return substituted;
        }
        const SyntaxRow syntax = session.syntax(node);
        if (syntax.type_kind() == compiler_parser::TypeKind::length_parameter) {
            reject(session, SemanticError::unsubstituted_array, node, -1, -1);
            return 0;
        }
        const i64 reference = syntax.word(0);
        const MetaRow source = session.meta(reference);
        i64 cursor = source.word(1);
        i64 value = 0;
        while (cursor < source.word(2) && session.good()) {
            const u8 byte = session.source_byte(cursor);
            value = value * 10 + i64(byte) - 48;
            cursor = cursor + 1;
        }
        return value;
    }
    auto request_arguments(Session& session, i64 root) -> Arguments {
        const SyntaxRow row = session.syntax(root);
        i64 count = 0;
        i64 first = -1;
        i64 second = -1;
        u64 trusted = u64(0);
        i64 at = 0;
        while (at < 2 && session.good()) {
            const i64 child = row.word(3 + at);
            if (child >= 0) {
                count = count + 1;
                const SyntaxRow argument = session.syntax(child);
                i64 value = rw(session, child, 2);
                if (argument.type_kind() == compiler_parser::TypeKind::capacity) {
                    value = -capacity_value(session, child) - 1;
                }
                if (rw(session, child, 7) == 1) {
                    trusted = trusted | (u64(1) << at);
                }
                if (at == 0) {
                    first = value;
                } else {
                    second = value;
                }
            }
            at = at + 1;
        }
        return Arguments(count, first, second, i64(trusted));
    }
    auto bind_type_node(Session& session, i64 node, BindContext context, bool argument) -> i64 {
        const SyntaxRow row = session.syntax(node);
        i64 bound = rw(session, node, 2);
        if (bound >= 0) {
            if (nominal_kind(type_kind(session, bound))) {
                const i64 status = state(session);
                if (mw(session, status, 4) != 0 && !body_visible(session, bound, context)) {
                    if (rw(session, node, 7) == 1) {
                        return reject(session, SemanticError::resolved_import, node, bound, -1);
                    }
                    return reject(session, SemanticError::type_import, node, bound, -1);
                }
                record_authority(session, bound, context);
            }
            return bound;
        }
        const ResolvedTypeKind atomic = parsed_kind(row.type_kind());
        if (atomic != ResolvedTypeKind::invalid) {
            bound = scalar_type(session, atomic);
        } else {
            if (row.type_kind() == compiler_parser::TypeKind::capacity || row.type_kind()
                == compiler_parser::TypeKind::length_parameter) {
                return -1;
            } else {
                if (row.type_kind() == compiler_parser::TypeKind::array_type) {
                    const i64 element = rw(session, row.word(3), 2);
                    const i64 length = capacity_value(session, row.word(4));
                    const ResolvedTypeKind kind = type_kind(session, element);
                    if (!scalar_kind(kind) && kind != ResolvedTypeKind::class_value) {
                        return reject(session, SemanticError::array_elements, node, element, -1);
                    }
                    if (kind == ResolvedTypeKind::class_value && mw(session, element, 1) < 0) {
                        return reject(session, SemanticError::unknown_array_element, node, element, -1);
                    }
                    if (kind == ResolvedTypeKind::class_value && (length < 1 || length > 64)) {
                        return reject(session, SemanticError::class_array_capacity, node, -1, -1);
                    }
                    bound = concrete_type(session, ResolvedTypeKind::array_value, -1, element, length);
                } else {
                    if (row.type_kind() == compiler_parser::TypeKind::owned_values || row.type_kind()
                        == compiler_parser::TypeKind::value_span) {
                        const i64 element = rw(session, row.word(3), 2);
                        if (row.type_kind() == compiler_parser::TypeKind::value_span) {
                            if (type_kind(session, element) != ResolvedTypeKind::class_value) {
                                return reject(session, SemanticError::span_named, node, -1, -1);
                            }
                            bound = concrete_type(session, ResolvedTypeKind::value_span, -1, element, 0);
                        } else {
                            if (type_kind(session, element) != ResolvedTypeKind::class_value) {
                                return reject(session, SemanticError::owned_named, node, -1, -1);
                            }
                            bound = concrete_type(session, ResolvedTypeKind::owned_values, -1, element, 0);
                        }
                    } else {
                        if (row.type_kind() == compiler_parser::TypeKind::parameter) {
                            const i64 name = source_name_range(session, row.word(0), row.word(1));
                            return reject(session, SemanticError::unsubstituted_parameter, node, name, -1);
                        } else {
                            const i64 name = source_name_range(session, row.word(0), row.word(1));
                            if (builtin_name(session, name)) {
                                bound = builtin_type(session, name);
                            }
                            if (bound < 0 && plain_is(session, name, "array")) {
                                return reject(session, SemanticError::array_explicit, node, -1, -1);
                            }
                            i64 target = -1;
                            if (bound < 0 && context.receiver() >= 0 && mw(session, context.receiver(), 9) >= 0
                                && row.word(3) < 0) {
                                const i64 receiver = context.receiver();
                                const i64 receiver_node = mw(session, receiver, 5);
                                const i64 receiver_name = declaration_name(session, receiver_node);
                                if (name == receiver_name || name == mw(session, receiver, 3)) {
                                    target = receiver;
                                }
                            }
                            if (bound < 0 && target < 0) {
                                DeclarationKind required = DeclarationKind::invalid;
                                if (row.word(3) >= 0) {
                                    required = DeclarationKind::class_template;
                                }
                                target = lookup(session, context, name, required, node);
                            }
                            if (bound < 0 && target >= 0 && row.word(3) >= 0) {
                                const Arguments arguments = request_arguments(session, node);
                                target = request_instance(session, target, arguments, context, node);
                            }
                            if (bound < 0 && target >= 0 && session.good()) {
                                const DeclarationKind kind = declaration_kind(session, target);
                                if (kind != DeclarationKind::class_value && kind != DeclarationKind::enumeration) {
                                    if (argument) {
                                        return reject(session, SemanticError::argument_concrete, node, name, -1);
                                    }
                                    return reject(session, SemanticError::concrete_type, node, name, -1);
                                }
                                ResolvedTypeKind value_kind = ResolvedTypeKind::class_value;
                                if (kind == DeclarationKind::enumeration) {
                                    value_kind = ResolvedTypeKind::enum_value;
                                }
                                bound = concrete_type(session, value_kind, target, -1, 0);
                            }
                            if (bound < 0 && session.good()) {
                                if (row.word(3) >= 0) {
                                    return reject(session, SemanticError::unknown_template, node, name, -1);
                                }
                                if (argument) {
                                    return reject(session, SemanticError::unknown_argument, node, name, -1);
                                }
                                // Unknown non-template body types retain their source spelling;
                                // the existing later semantic checker owns that diagnostic.
                                bound = concrete_type(session, ResolvedTypeKind::class_value, -name - 2, -1, 0);
                            }
                        }
                    }
                }
            }
        }
        if (bound >= 0 && session.good()) {
            set_rw(session, node, 2, bound);
            const i64 status = state(session);
            if (nominal_kind(type_kind(session, bound)) && mw(session, bound, 1) >= 0) {
                if (mw(session, status, 4) != 0 && !body_visible(session, bound, context)) {
                    return reject(session, SemanticError::type_import, node, bound, -1);
                }
                record_authority(session, bound, context);
            }
        }
        return bound;
    }
    auto check_arity(Session& session, i64 prototype, SyntaxRow request, i64 node, i64 spelling) -> bool {
        i64 count = 0;
        if (request.word(3) >= 0) {
            count = count + 1;
        }
        if (request.word(4) >= 0) {
            count = count + 1;
        }
        const i64 last = mw(session, prototype, 8);
        if (count != list_count(session, last)) {
            if (declaration_kind(session, prototype) == DeclarationKind::function_template) {
                reject(session, SemanticError::function_arity, node, spelling, -1);
            } else {
                reject(session, SemanticError::class_arity, node, spelling, -1);
            }
        }
        return session.good();
    }
    auto resolve_type(Session& session, i64 root, BindContext context, bool argument) -> i64 {
        if (root < 0) {
            return scalar_type(session, ResolvedTypeKind::i64_value);
        }
        const i64 base = session.work_count();
        i64 argument_flag = 0;
        if (argument) {
            argument_flag = 1;
        }
        session.append_work(WorkRow(root, 0, argument_flag, 0, 0, 0));
        while (session.work_count() > base && session.good()) {
            const i64 top = session.work_count() - 1;
            const WorkRow item = session.work(top);
            session.truncate_work(top);
            const i64 node = item.word(0);
            const SyntaxRow row = session.syntax(node);
            if (item.word(1) == 0) {
                i64 depth = item.word(3);
                i64 child_argument = item.word(2);
                if (row.type_kind() == compiler_parser::TypeKind::named && row.word(3) >= 0) {
                    depth = depth + 1;
                    if (depth > 4) {
                        reject(session, SemanticError::template_depth, node, -1, -1);
                    }
                    const i64 name = source_name_range(session, row.word(0), row.word(1));
                    const i64 target = lookup(session, context, name, DeclarationKind::class_template, node);
                    if (target < 0 && session.good()) {
                        reject(session, SemanticError::unknown_template, node, name, -1);
                    }
                    if (target >= 0 && session.good()) {
                        check_arity(session, target, row, node, name);
                    }
                    child_argument = 1;
                }
                if (session.good()) {
                    session.append_work(WorkRow(node, 1, item.word(2), depth, 0, 0));
                    if (row.word(4) >= 0) {
                        session.append_work(WorkRow(row.word(4), 0, child_argument, depth, 0, 0));
                    }
                    if (row.word(3) >= 0) {
                        session.append_work(WorkRow(row.word(3), 0, child_argument, depth, 0, 0));
                    }
                }
            } else {
                bind_type_node(session, node, context, item.word(2) != 0);
            }
        }
        session.truncate_work(base);
        return rw(session, root, 2);
    }

    auto receiver_member(Session& session, i64 receiver, i64 name) -> i64 {
        if (receiver < 0) {
            return -1;
        }
        return session.index(58, receiver, name, 0, 0);
    }
    auto validate_fixed_tree(Session& session, i64 root, BindContext context) -> i64 {
        const i64 base = session.work_count();
        session.append_work(WorkRow(root, 0, 0, 0, 0, 0));
        while (session.work_count() > base && session.good()) {
            const i64 top = session.work_count() - 1;
            const WorkRow task = session.work(top);
            session.truncate_work(top);
            const i64 node = task.word(0);
            const SyntaxRow row = session.syntax(node);
            const bool deferred = row.kind() == SyntaxTag::expression && row.word(6) >= 0 && row.word(7) == 2
                && task.word(1) != 4;
            if (deferred) {
                session.append_work(WorkRow(node, 4, 0, 0, 0, 0));
                session.append_work(WorkRow(row.word(6), 2, 0, 0, 0, 0));
            }
            if (!deferred && row.kind() == SyntaxTag::type && row.type_kind() == compiler_parser::TypeKind::named
                && row.word(3) >= 0) {
                const i64 name = source_name_range(session, row.word(0), row.word(1));
                const i64 target = lookup(session, context, name, DeclarationKind::class_template, node);
                if (target < 0 && session.good()) {
                    reject(session, SemanticError::template_static_type, node, name, -1);
                }
            }
            if (!deferred && row.kind() == SyntaxTag::expression && (row.expression_kind()
                == compiler_parser::NodeKind::call || row.expression_kind() == compiler_parser::NodeKind::construct)) {
                const i64 name = source_name_range(session, row.word(0), row.word(4));
                bool member = false;
                if (context.receiver() >= 0 && row.expression_kind() == compiler_parser::NodeKind::call) {
                    member = receiver_member(session, context.receiver(), name) >= 0;
                }
                i64 target = -1;
                if (!intrinsic(session, name) && !member) {
                    target = lookup(session, context, name, DeclarationKind::invalid, node);
                }
                if (target >= 0 && declaration_kind(session, target) == DeclarationKind::function_template) {
                    reject(session, SemanticError::template_function_call, node, -1, -1);
                } else {
                    if (row.word(6) >= 0 && row.word(7) == 1 && (target < 0 || declaration_kind(session, target)
                        != DeclarationKind::class_template)) {
                        reject(session, SemanticError::template_static_body, node, -1, -1);
                    }
                }
            }
            if (session.good() && !deferred) {
                if (row.kind() == SyntaxTag::type) {
                    if (row.type_kind() == compiler_parser::TypeKind::array_type) {
                        session.append_work(WorkRow(row.word(3), 2, 0, 0, 0, 0));
                    }
                } else {
                    if (row.kind() == SyntaxTag::expression) {
                        push_expression_children(session, row);
                    } else {
                        push_statement_children(session, row);
                    }
                }
            }
        }
        session.truncate_work(base);
        return 0;
    }
    auto validate_template_definitions(Session& session) -> i64 {
        i64 order = 0;
        while (order < session.module_count() && session.good()) {
            const i64 unit = module_at_order(session, order);
            i64 function = first_symbol(session, unit, DeclarationKind::function_template);
            while (function >= 0 && session.good()) {
                const i64 scope = mw(session, function, 2);
                const BindContext context = BindContext(unit, scope, -1, -1, false, false);
                const i64 node = mw(session, function, 5);
                validate_fixed_tree(session, node, context);
                function = mw(session, function, 14);
            }
            i64 definition = first_symbol(session, unit, DeclarationKind::class_template);
            while (definition >= 0 && session.good()) {
                const i64 scope = mw(session, definition, 2);
                const BindContext context = BindContext(unit, scope, -1, definition, false, false);
                const i64 node = mw(session, definition, 5);
                const i64 base = session.work_count();
                const i64 last = sw(session, node, 7);
                push_declarations(session, last, scope, 0, definition);
                while (session.work_count() > base && session.good()) {
                    const i64 top = session.work_count() - 1;
                    const WorkRow item = session.work(top);
                    session.truncate_work(top);
                    const i64 member = sw(session, item.word(0), 7);
                    const SyntaxRow syntax = session.syntax(member);
                    if (syntax.declaration_kind() != compiler_parser::SyntaxKind::field) {
                        validate_fixed_tree(session, member, context);
                    }
                }
                session.truncate_work(base);
                definition = mw(session, definition, 14);
            }
            order = order + 1;
        }
        return 0;
    }
    // Worklist actions: 0 declaration/statement, 1 expression, 2 type,
    // 3 expression argument edge. Lists are reversed once, never indexed.
    auto push_statement_list(Session& session, i64 last) -> i64 {
        i64 current = last;
        while (current >= 0 && session.good()) {
            session.append_work(WorkRow(current, 0, 0, 0, 0, 0));
            current = sw(session, current, 2);
        }
        return 0;
    }
    auto push_expression_children(Session& session, SyntaxRow row) -> i64 {
        const compiler_parser::NodeKind kind = row.expression_kind();
        if (kind == compiler_parser::NodeKind::call || kind == compiler_parser::NodeKind::method_call || kind
            == compiler_parser::NodeKind::construct || kind == compiler_parser::NodeKind::array_literal || kind
            == compiler_parser::NodeKind::array_zero) {
            i64 edge = row.word(1);
            while (edge >= 0 && session.good()) {
                const i64 child = sw(session, edge, 0);
                session.append_work(WorkRow(child, 1, 0, 0, 0, 0));
                edge = sw(session, edge, 1);
            }
        } else {
            if ((kind == compiler_parser::NodeKind::binary || kind == compiler_parser::NodeKind::index) && row.word(2)
                >= 0) {
                session.append_work(WorkRow(row.word(2), 1, 0, 0, 0, 0));
            }
            if (row.word(1) >= 0) {
                session.append_work(WorkRow(row.word(1), 1, 0, 0, 0, 0));
            }
        }
        return 0;
    }
    auto push_statement_children(Session& session, SyntaxRow row) -> i64 {
        const compiler_parser::SyntaxKind kind = row.declaration_kind();
        if (kind == compiler_parser::SyntaxKind::block) {
            return push_statement_list(session, row.word(7));
        }
        if (kind == compiler_parser::SyntaxKind::function || kind == compiler_parser::SyntaxKind::method || kind
            == compiler_parser::SyntaxKind::constructor) {
            if (kind == compiler_parser::SyntaxKind::constructor) {
                if (row.word(4) >= 0) {
                    session.append_work(WorkRow(row.word(4), 0, 0, 0, 0, 0));
                }
                push_statement_list(session, row.word(7));
            } else {
                if (row.word(7) >= 0) {
                    session.append_work(WorkRow(row.word(7), 0, 0, 0, 0, 0));
                }
            }
            push_statement_list(session, row.word(8));
            if (row.word(5) >= 0) {
                session.append_work(WorkRow(row.word(5), 2, 0, 0, 0, 0));
            }
            return 0;
        }
        if (row.word(8) >= 0) {
            session.append_work(WorkRow(row.word(8), 0, 0, 0, 0, 0));
        }
        if (row.word(7) >= 0) {
            session.append_work(WorkRow(row.word(7), 0, 0, 0, 0, 0));
        }
        if (row.word(4) >= 0) {
            session.append_work(WorkRow(row.word(4), 1, 0, 0, 0, 0));
        }
        if (row.word(3) >= 0) {
            session.append_work(WorkRow(row.word(3), 1, 0, 0, 0, 0));
        }
        if (row.word(5) >= 0) {
            session.append_work(WorkRow(row.word(5), 2, 0, 0, 0, 0));
        }
        return 0;
    }
    auto collect_type_request(Session& session, i64 type, BindContext context) -> i64 {
        i64 current = type;
        bool finished = false;
        while (current >= 0 && !finished && session.good()) {
            const SyntaxRow row = session.syntax(current);
            if (row.type_kind() == compiler_parser::TypeKind::array_type || row.type_kind()
                == compiler_parser::TypeKind::owned_values || row.type_kind()
                == compiler_parser::TypeKind::value_span) {
                if (row.type_kind() == compiler_parser::TypeKind::array_type) {
                    const SyntaxRow element = session.syntax(row.word(3));
                    const SyntaxRow capacity = session.syntax(row.word(4));
                    if ((element.type_kind() == compiler_parser::TypeKind::parameter && rw(session, row.word(3), 2) < 0)
                        || (capacity.type_kind() == compiler_parser::TypeKind::length_parameter && rw(session,
                        row.word(4), 3) < 0)) {
                        reject(session, SemanticError::unsubstituted_array, current, -1, -1);
                    }
                }
                if (row.type_kind() == compiler_parser::TypeKind::owned_values || row.type_kind()
                    == compiler_parser::TypeKind::value_span) {
                    const SyntaxRow element = session.syntax(row.word(3));
                    if (element.word(3) >= 0) {
                        if (row.type_kind() == compiler_parser::TypeKind::value_span) {
                            reject(session, SemanticError::span_named, current, -1, -1);
                        } else {
                            reject(session, SemanticError::owned_named, current, -1, -1);
                        }
                    }
                }
                current = row.word(3);
            } else {
                if (row.type_kind() == compiler_parser::TypeKind::parameter && rw(session, current, 2) < 0) {
                    const i64 name = source_name_range(session, row.word(0), row.word(1));
                    reject(session, SemanticError::unsubstituted_parameter, current, name, -1);
                    finished = true;
                } else {
                    if (row.type_kind() == compiler_parser::TypeKind::named && row.word(3) >= 0) {
                        MetaRow request = MetaRow(MetaTag::request);
                        request.set_word(0, 0);
                        request.set_word(1, context.module_id());
                        request.set_word(2, context.scope());
                        request.set_word(3, current);
                        request.set_word(4, 0);
                        session.append_meta(request);
                    } else {
                        if (row.type_kind() == compiler_parser::TypeKind::builtin_type || row.type_kind()
                            == compiler_parser::TypeKind::builtin_class) {
                            const i64 name = source_name_range(session, row.word(0), row.word(1));
                            builtin_type(session, name);
                        }
                    }
                    finished = true;
                }
            }
        }
        return 0;
    }
    auto collect_function_requests(Session& session, i64 root, BindContext context) -> i64 {
        const i64 base = session.work_count();
        session.append_work(WorkRow(root, 0, 0, 0, 0, 0));
        while (session.work_count() > base && session.good()) {
            const i64 top = session.work_count() - 1;
            const WorkRow item = session.work(top);
            session.truncate_work(top);
            const i64 node = item.word(0);
            const SyntaxRow row = session.syntax(node);
            if (item.word(1) == 2) {
                collect_type_request(session, node, context);
            } else {
                if (item.word(1) == 1) {
                    if (row.word(6) >= 0) {
                        if (row.word(7) == 2) {
                            collect_type_request(session, row.word(6), context);
                        } else {
                            MetaRow request = MetaRow(MetaTag::request);
                            request.set_word(0, 0);
                            request.set_word(1, context.module_id());
                            request.set_word(2, context.scope());
                            request.set_word(3, row.word(6));
                            request.set_word(4, 1);
                            session.append_meta(request);
                        }
                    }
                    push_expression_children(session, row);
                } else {
                    push_statement_children(session, row);
                }
            }
        }
        session.truncate_work(base);
        return 0;
    }
    auto collect_class_requests(Session& session, i64 symbol) -> i64 {
        const i64 module_id = mw(session, symbol, 1);
        const i64 scope = mw(session, symbol, 2);
        const BindContext context = BindContext(module_id, scope, -1, symbol, false, true);
        const i64 root = mw(session, symbol, 5);
        const i64 last = sw(session, root, 7);
        i64 phase = 0;
        while (phase < 2 && session.good()) {
            const i64 base = session.work_count();
            push_declarations(session, last, scope, 0, symbol);
            while (session.work_count() > base && session.good()) {
                const i64 top = session.work_count() - 1;
                const WorkRow item = session.work(top);
                session.truncate_work(top);
                const i64 node = sw(session, item.word(0), 7);
                const SyntaxRow row = session.syntax(node);
                const bool field = row.declaration_kind() == compiler_parser::SyntaxKind::field;
                if (phase == 0 && field) {
                    collect_type_request(session, row.word(5), context);
                }
                if (phase == 1 && !field) {
                    collect_function_requests(session, node, context);
                }
            }
            session.truncate_work(base);
            phase = phase + 1;
        }
        return 0;
    }
    auto expand_request(Session& session, i64 request) -> i64 {
        const MetaRow item = session.meta(request);
        const BindContext context = BindContext(item.word(1), item.word(2), -1, -1, false, true);
        const i64 type = item.word(3);
        const SyntaxRow syntax = session.syntax(type);
        const i64 name = source_name_range(session, syntax.word(0), syntax.word(1));
        const i64 target = lookup(session, context, name, DeclarationKind::invalid, type);
        if (item.word(4) != 0 && target >= 0 && declaration_kind(session, target)
            == DeclarationKind::function_template) {
            check_arity(session, target, syntax, type, name);
            if (!session.good()) {
                return -1;
            }
            if (syntax.word(3) >= 0) {
                resolve_type(session, syntax.word(3), context, true);
            }
            if (syntax.word(4) >= 0 && session.good()) {
                resolve_type(session, syntax.word(4), context, true);
            }
            if (!session.good()) {
                return -1;
            }
            const Arguments arguments = request_arguments(session, type);
            request_instance(session, target, arguments, context, type);
        } else {
            resolve_type(session, type, context, false);
        }
        return 0;
    }
    auto expand_templates(Session& session) -> i64 {
        const i64 begin = session.meta_count();
        i64 order = 0;
        while (order < session.module_count() && session.good()) {
            const i64 unit = module_at_order(session, order);
            i64 symbol = first_symbol(session, unit, DeclarationKind::function);
            while (symbol >= 0 && session.good()) {
                const i64 scope = mw(session, symbol, 2);
                const BindContext context = BindContext(unit, scope, symbol, -1, false, true);
                const i64 node = mw(session, symbol, 5);
                collect_function_requests(session, node, context);
                symbol = mw(session, symbol, 14);
            }
            symbol = first_symbol(session, unit, DeclarationKind::class_value);
            while (symbol >= 0 && session.good()) {
                collect_class_requests(session, symbol);
                symbol = mw(session, symbol, 14);
            }
            order = order + 1;
        }
        const i64 end = session.meta_count();
        i64 at = begin;
        while (at < end && session.good()) {
            const MetaRow request = session.meta(at);
            if (request.kind() == MetaTag::request && request.word(0) == 0) {
                expand_request(session, at);
            }
            at = at + 1;
        }
        const i64 generated = session.meta_count();
        order = 0;
        while (order < session.module_count() && session.good()) {
            const i64 unit = module_at_order(session, order);
            i64 symbol = first_symbol(session, unit, DeclarationKind::function);
            while (symbol >= 0 && session.good()) {
                if (mw(session, symbol, 9) >= 0) {
                    const i64 scope = mw(session, symbol, 2);
                    const BindContext context = BindContext(unit, scope, symbol, -1, false, true);
                    const i64 node = mw(session, symbol, 5);
                    collect_function_requests(session, node, context);
                }
                symbol = mw(session, symbol, 14);
            }
            order = order + 1;
        }
        const i64 generated_end = session.meta_count();
        at = generated;
        while (at < generated_end && session.good()) {
            const MetaRow request = session.meta(at);
            if (request.kind() == MetaTag::request && request.word(0) == 0) {
                expand_request(session, at);
            }
            at = at + 1;
        }
        return 0;
    }

    auto add_public_type(Session& session, i64 symbol, i64 type) -> i64 {
        MetaRow edge = MetaRow(MetaTag::public_type);
        edge.set_word(0, type);
        const i64 result = session.append_meta(edge);
        const i64 tail = session.index(51, symbol, 0, 0, 0);
        if (tail < 0) {
            set_mw(session, symbol, 12, result);
            session.index_insert(51, symbol, 0, 0, 0, result);
        } else {
            set_mw(session, tail, 1, result);
            session.index_replace(51, symbol, 0, 0, 0, result);
        }
        return result;
    }
    auto add_signature(Session& session, i64 symbol, i64 type, i64 parameter) -> i64 {
        MetaRow edge = MetaRow(MetaTag::signature);
        edge.set_word(0, symbol);
        edge.set_word(1, type);
        edge.set_word(2, parameter);
        const i64 result = session.append_meta(edge);
        const i64 tail = session.index(52, symbol, 0, 0, 0);
        if (tail < 0) {
            set_mw(session, symbol, 11, result);
            session.index_insert(52, symbol, 0, 0, 0, result);
        } else {
            set_mw(session, tail, 3, result);
            session.index_replace(52, symbol, 0, 0, 0, result);
        }
        return result;
    }
    auto known_nominal(Session& session, i64 type) -> bool {
        return !nominal_kind(type_kind(session, type)) || mw(session, type, 1) >= 0;
    }
    auto check_function_type(Session& session, i64 type, i64 function, BindContext context) -> i64 {
        if (!nominal_kind(type_kind(session, type))) {
            return 0;
        }
        const i64 node = mw(session, function, 5);
        if (!known_nominal(session, type)) {
            return reject(session, SemanticError::unknown_signature, node, type, -1);
        }
        const i64 nominal = mw(session, type, 1);
        const MetaRow declaration = session.meta(nominal);
        if (declaration.native_mode() == NativeMode::sealed_builtin) {
            return 0;
        }
        if (!body_visible(session, type, context)) {
            return reject(session, SemanticError::function_signature_import, node, type, -1);
        }
        if (mw(session, function, 6) != 0 && !type_accessible(session, type, -1, -1)) {
            return reject(session, SemanticError::export_function_private, node, type, -1);
        }
        return 0;
    }
    auto resolve_callable_signature(Session& session, i64 symbol, BindContext context, i64 receiver) -> i64 {
        const i64 root = mw(session, symbol, 5);
        const bool constructor = declaration_kind(session, symbol) == DeclarationKind::constructor;
        const i64 result_root = sw(session, root, 5);
        const i64 result = resolve_type(session, result_root, context, false);
        if (receiver < 0) {
            check_function_type(session, result, symbol, context);
        } else {
            if (!known_nominal(session, result)) {
                reject(session, SemanticError::unknown_class_declaration, root, result, -1);
            }
        }
        add_signature(session, symbol, result, -1);
        if (receiver >= 0 && mw(session, symbol, 6) != 0 && !constructor) {
            add_public_type(session, receiver, result);
        }
        const i64 base = session.work_count();
        const i64 last = sw(session, root, 8);
        push_statement_list(session, last);
        while (session.work_count() > base && session.good()) {
            const i64 top = session.work_count() - 1;
            const WorkRow item = session.work(top);
            session.truncate_work(top);
            const i64 parameter = item.word(0);
            const i64 type_root = sw(session, parameter, 5);
            const i64 type = resolve_type(session, type_root, context, false);
            const ResolvedTypeKind kind = type_kind(session, type);
            if (receiver < 0) {
                check_function_type(session, type, symbol, context);
            } else {
                if (!known_nominal(session, type)) {
                    reject(session, SemanticError::unknown_class_declaration, parameter, type, -1);
                } else {
                    if (!scalar_value_kind(kind) && kind != ResolvedTypeKind::class_value && !(!constructor && (kind
                        == ResolvedTypeKind::byte_span || kind == ResolvedTypeKind::value_span)) && !(constructor
                        && resource_kind(kind))) {
                        if (constructor) {
                            reject(session, SemanticError::constructor_parameter, parameter, -1, -1);
                        } else {
                            reject(session, SemanticError::method_parameter, parameter, -1, -1);
                        }
                    }
                }
                if (mw(session, symbol, 6) != 0) {
                    add_public_type(session, receiver, type);
                }
            }
            add_signature(session, symbol, type, parameter);
        }
        session.truncate_work(base);
        return 0;
    }
    auto resolve_class_signature(Session& session, i64 symbol) -> i64 {
        const i64 unit = mw(session, symbol, 1);
        const i64 scope = mw(session, symbol, 2);
        const BindContext context = BindContext(unit, scope, -1, symbol, false, false);
        const i64 node = mw(session, symbol, 5);
        const i64 last = sw(session, node, 7);
        i64 phase = 0;
        while (phase < 2 && session.good()) {
            const i64 base = session.work_count();
            push_declarations(session, last, scope, 0, symbol);
            while (session.work_count() > base && session.good()) {
                const i64 top = session.work_count() - 1;
                const WorkRow item = session.work(top);
                session.truncate_work(top);
                const i64 wrapper = item.word(0);
                const i64 member = sw(session, wrapper, 7);
                const SyntaxRow syntax = session.syntax(member);
                const bool field = syntax.declaration_kind() == compiler_parser::SyntaxKind::field;
                if (phase == 0 && field) {
                    const i64 type = resolve_type(session, syntax.word(5), context, false);
                    if (!known_nominal(session, type)) {
                        reject(session, SemanticError::unknown_class_declaration, member, type, -1);
                    }
                    if (sw(session, wrapper, 9) != 0) {
                        add_public_type(session, symbol, type);
                    }
                }
                if (phase == 1 && !field) {
                    const i64 method = rw(session, member, 1);
                    resolve_callable_signature(session, method, context, symbol);
                }
            }
            session.truncate_work(base);
            phase = phase + 1;
        }
        return 0;
    }
    auto check_class_exposure(Session& session, i64 symbol) -> i64 {
        if (mw(session, symbol, 9) >= 0) {
            return 0;
        }
        const i64 unit = mw(session, symbol, 1);
        const i64 root = mw(session, symbol, 5);
        const i64 base = session.work_count();
        const i64 last = sw(session, root, 7);
        i64 phase = 0;
        while (phase < 2 && session.good()) {
            push_declarations(session, last, -1, 0, symbol);
            while (session.work_count() > base && session.good()) {
                const i64 top = session.work_count() - 1;
                const WorkRow item = session.work(top);
                session.truncate_work(top);
                const i64 member = sw(session, item.word(0), 7);
                const SyntaxRow syntax = session.syntax(member);
                if (phase == 0 && syntax.declaration_kind() == compiler_parser::SyntaxKind::field) {
                    const i64 type = rw(session, syntax.word(5), 2);
                    if (!type_accessible(session, type, unit, -1)) {
                        reject(session, SemanticError::class_signature_import, member, type, -1);
                    }
                } else {
                    if (phase == 1 && syntax.declaration_kind() != compiler_parser::SyntaxKind::field) {
                        const i64 method = rw(session, member, 1);
                        i64 edge = mw(session, method, 11);
                        if (syntax.declaration_kind() == compiler_parser::SyntaxKind::constructor && edge >= 0) {
                            edge = mw(session, edge, 3);
                        }
                        while (edge >= 0 && session.good()) {
                            const i64 type = mw(session, edge, 1);
                            if (!type_accessible(session, type, unit, -1)) {
                                reject(session, SemanticError::class_signature_import, member, type, -1);
                            }
                            edge = mw(session, edge, 3);
                        }
                    }
                }
            }
            session.truncate_work(base);
            phase = phase + 1;
        }
        if (mw(session, symbol, 6) != 0) {
            i64 edge = mw(session, symbol, 12);
            while (edge >= 0 && session.good()) {
                const i64 type = mw(session, edge, 0);
                if (!type_accessible(session, type, -1, -1)) {
                    reject(session, SemanticError::export_class_private, root, type, -1);
                } else {
                    if (!type_accessible(session, type, unit, -1)) {
                        reject(session, SemanticError::class_signature_import, root, type, -1);
                    }
                }
                edge = mw(session, edge, 1);
            }
        }
        return 0;
    }
    auto resolve_class_types(Session& session) -> i64 {
        i64 order = 0;
        while (order < session.module_count() && session.good()) {
            const i64 unit = module_at_order(session, order);
            i64 symbol = first_symbol(session, unit, DeclarationKind::class_value);
            while (symbol >= 0 && session.good()) {
                resolve_class_signature(session, symbol);
                symbol = mw(session, symbol, 14);
            }
            order = order + 1;
        }
        const i64 status = state(session);
        set_mw(session, status, 4, 1);
        order = 0;
        while (order < session.module_count() && session.good()) {
            const i64 unit = module_at_order(session, order);
            i64 symbol = first_symbol(session, unit, DeclarationKind::class_value);
            while (symbol >= 0 && session.good()) {
                check_class_exposure(session, symbol);
                symbol = mw(session, symbol, 14);
            }
            order = order + 1;
        }
        const i64 count = session.meta_count();
        i64 at = 0;
        while (at < count && session.good()) {
            const MetaRow row = session.meta(at);
            if (row.kind() == MetaTag::request && row.word(0) == 1) {
                if (!type_accessible(session, row.word(2), row.word(1), -1)) {
                    reject(session, SemanticError::argument_import, row.word(3), row.word(2), -1);
                }
            }
            at = at + 1;
        }
        return 0;
    }
    auto validate_fixed_signature_type(Session& session, i64 root, i64 function, BindContext context) -> i64 {
        if (root < 0) {
            return 0;
        }
        const i64 base = session.work_count();
        session.append_work(WorkRow(root, 0, 0, 0, 0, 0));
        while (session.work_count() > base && session.good()) {
            const i64 top = session.work_count() - 1;
            const WorkRow item = session.work(top);
            session.truncate_work(top);
            const i64 node = item.word(0);
            const SyntaxRow row = session.syntax(node);
            if (row.type_kind() == compiler_parser::TypeKind::array_type) {
                session.append_work(WorkRow(row.word(3), 0, 0, 0, 0, 0));
            } else {
                if (row.type_kind() == compiler_parser::TypeKind::builtin_class || row.type_kind()
                    == compiler_parser::TypeKind::builtin_type) {
                    const i64 name = source_name_range(session, row.word(0), row.word(1));
                    const i64 descriptor = session.index(48, name, 0, 0, 0);
                    if (descriptor >= 0) {
                        const MetaRow builtin_descriptor = session.meta(descriptor);
                        if (nominal_kind(builtin_descriptor.type_kind())) {
                            const i64 native = source_name(session, builtin_descriptor.word(3));
                            source_identifier(session, native, node);
                        }
                    }
                } else {
                    if (row.type_kind() == compiler_parser::TypeKind::named) {
                        const i64 name = source_name_range(session, row.word(0), row.word(1));
                        const i64 target = lookup(session, context, name, DeclarationKind::invalid, node);
                        if (target < 0 && session.good()) {
                            reject(session, SemanticError::function_fixed_unknown, node, name, -1);
                        } else {
                            if (target >= 0) {
                                if (row.word(3) >= 0) {
                                    if (declaration_kind(session, target) != DeclarationKind::class_template) {
                                        reject(session, SemanticError::function_signature_template, node, -1, -1);
                                    } else {
                                        if (mw(session, function, 6) != 0 && !exported(session, target)) {
                                            reject(session, SemanticError::export_template_private, node, name, -1);
                                        }
                                    }
                                    if (row.word(4) >= 0) {
                                        session.append_work(WorkRow(row.word(4), 0, 0, 0, 0, 0));
                                    }
                                    session.append_work(WorkRow(row.word(3), 0, 0, 0, 0, 0));
                                } else {
                                    const DeclarationKind kind = declaration_kind(session, target);
                                    if (kind != DeclarationKind::class_value && kind != DeclarationKind::enumeration) {
                                        reject(session, SemanticError::function_signature_concrete, node, -1, -1);
                                    } else {
                                        ResolvedTypeKind type_kind = ResolvedTypeKind::class_value;
                                        if (kind == DeclarationKind::enumeration) {
                                            type_kind = ResolvedTypeKind::enum_value;
                                        }
                                        const i64 type = concrete_type(session, type_kind, target, -1, 0);
                                        if (!type_accessible(session, type, context.module_id(), -1)) {
                                            reject(session, SemanticError::function_template_signature_import, node,
                                                name, -1);
                                        } else {
                                            if (mw(session, function, 6) != 0 && !type_accessible(session, type, -1,
                                                -1)) {
                                                reject(session, SemanticError::export_function_template_private, node,
                                                    name, -1);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        session.truncate_work(base);
        return 0;
    }
    auto validate_function_template_signatures(Session& session) -> i64 {
        i64 order = 0;
        while (order < session.module_count() && session.good()) {
            const i64 unit = module_at_order(session, order);
            i64 function = first_symbol(session, unit, DeclarationKind::function_template);
            while (function >= 0 && session.good()) {
                const i64 root = mw(session, function, 5);
                const i64 scope = mw(session, function, 2);
                const BindContext context = BindContext(unit, scope, -1, -1, false, false);
                const i64 result = sw(session, root, 5);
                validate_fixed_signature_type(session, result, function, context);
                const i64 base = session.work_count();
                const i64 last = sw(session, root, 8);
                push_statement_list(session, last);
                while (session.work_count() > base && session.good()) {
                    const i64 top = session.work_count() - 1;
                    const WorkRow item = session.work(top);
                    session.truncate_work(top);
                    const i64 type = sw(session, item.word(0), 5);
                    validate_fixed_signature_type(session, type, function, context);
                }
                session.truncate_work(base);
                function = mw(session, function, 14);
            }
            order = order + 1;
        }
        return 0;
    }
    auto finalize_overload(Session& session, i64 symbol) -> i64 {
        const i64 group = mw(session, symbol, 10);
        if (group < 0) {
            return 0;
        }
        i64 tuple = -1;
        i64 count = 0;
        i64 edge = mw(session, symbol, 11);
        if (edge >= 0) {
            edge = mw(session, edge, 3);
        }
        while (edge >= 0 && session.good()) {
            const i64 type = mw(session, edge, 1);
            const ResolvedTypeKind kind = type_kind(session, type);
            if (!scalar_value_kind(kind) && kind != ResolvedTypeKind::class_value && kind
                != ResolvedTypeKind::byte_span) {
                const i64 node = mw(session, symbol, 5);
                return reject(session, SemanticError::overload_parameters, node, -1, -1);
            }
            i64 component = session.index(53, tuple, type, 0, 0);
            if (component < 0) {
                MetaRow value = MetaRow(MetaTag::context);
                value.set_word(0, 3);
                value.set_word(1, tuple);
                value.set_word(2, type);
                component = session.append_meta(value);
                session.index_insert(53, tuple, type, 0, 0, component);
            }
            tuple = component;
            count = count + 1;
            edge = mw(session, edge, 3);
        }
        if (session.index(54, group, tuple, count, 0) >= 0) {
            const i64 node = mw(session, symbol, 5);
            const i64 unit = mw(session, symbol, 1);
            const i64 name = mw(session, symbol, 3);
            return reject(session, SemanticError::duplicate_function, node, unit, name);
        }
        session.index_insert(54, group, tuple, count, 0, symbol);
        finalize_linkage(session, symbol);
        return 0;
    }
    auto resolve_signatures(Session& session) -> i64 {
        i64 order = 0;
        while (order < session.module_count() && session.good()) {
            const i64 unit = module_at_order(session, order);
            i64 symbol = first_symbol(session, unit, DeclarationKind::function);
            while (symbol >= 0 && session.good()) {
                const i64 scope = mw(session, symbol, 2);
                const BindContext context = BindContext(unit, scope, symbol, -1, false, false);
                resolve_callable_signature(session, symbol, context, -1);
                if (session.good()) {
                    finalize_overload(session, symbol);
                }
                symbol = mw(session, symbol, 14);
            }
            order = order + 1;
        }
        return 0;
    }

    auto signature_visible(Session& session, i64 symbol, BindContext context) -> bool {
        i64 edge = mw(session, symbol, 11);
        while (edge >= 0 && session.good()) {
            const i64 type = mw(session, edge, 1);
            if (!body_visible(session, type, context)) {
                return false;
            }
            edge = mw(session, edge, 3);
        }
        return session.good();
    }
    auto require_signature(Session& session, i64 symbol, BindContext context, i64 node) -> i64 {
        i64 edge = mw(session, symbol, 11);
        while (edge >= 0 && session.good()) {
            const i64 type = mw(session, edge, 1);
            if (!body_visible(session, type, context)) {
                return reject(session, SemanticError::function_signature_import, node, type, -1);
            }
            edge = mw(session, edge, 3);
        }
        return 0;
    }
    auto bind_overload(Session& session, i64 node, i64 target, BindContext context) -> i64 {
        const i64 group = mw(session, target, 10);
        u64 visible = u64(0);
        u64 inaccessible = u64(0);
        i64 ordinal = 0;
        i64 edge = mw(session, group, 0);
        while (edge >= 0 && session.good()) {
            const i64 candidate = mw(session, edge, 0);
            if (mw(session, candidate, 6) != 0 || mw(session, candidate, 1) == context.module_id()) {
                visible = visible | (u64(1) << ordinal);
                if (!signature_visible(session, candidate, context)) {
                    inaccessible = inaccessible | (u64(1) << ordinal);
                }
            }
            ordinal = ordinal + 1;
            edge = mw(session, edge, 1);
        }
        if (visible == u64(0)) {
            const i64 name = mw(session, target, 3);
            return reject(session, SemanticError::private_function, node, name, -1);
        }
        set_rw(session, node, 4, group);
        set_rw(session, node, 5, i64(visible));
        set_rw(session, node, 6, i64(inaccessible));
        return 0;
    }
    auto bind_construction(Session& session, i64 node, i64 target, BindContext context, bool call) -> i64 {
        const i64 type = concrete_type(session, ResolvedTypeKind::class_value, target, -1, 0);
        const bool self = context.receiver() == target && mw(session, target, 9) >= 0;
        if (!self && !body_visible(session, type, context)) {
            return reject(session, SemanticError::construction_import, node, type, -1);
        }
        ResolvedRow value = session.resolved(node);
        value.set_word(1, target);
        value.set_word(2, type);
        if (call) {
            value.set_operation(ResolvedOperation::constructor_call);
        }
        session.set_resolved(node, value);
        if (mw(session, target, 9) >= 0) {
            record_authority(session, type, context);
        }
        return 0;
    }
    auto bind_enum_name(Session& session, i64 node, i64 name, BindContext context) -> i64 {
        const i64 enum_name = prefix_parent(session, name);
        if (enum_name < 0) {
            return 0;
        }
        const SyntaxRow expression = session.syntax(node);
        const i64 case_name = source_name(session, expression.word(4));
        i64 type = -1;
        i64 ordinal = -1;
        i64 target = -1;
        const i64 builtin_descriptor = session.index(48, enum_name, 0, 0, 0);
        if (builtin_descriptor >= 0) {
            const MetaRow descriptor = session.meta(builtin_descriptor);
            if (descriptor.type_kind() == ResolvedTypeKind::enum_value) {
                type = builtin_type(session, enum_name);
                target = mw(session, type, 1);
                i64 member = descriptor.word(4);
                while (member >= 0 && session.good()) {
                    const i64 reference = mw(session, member, 1);
                    const i64 candidate = source_name(session, reference);
                    if (candidate == case_name) {
                        ordinal = mw(session, member, 2);
                    }
                    member = mw(session, member, 3);
                }
                if (ordinal < 0) {
                    return reject(session, SemanticError::unknown_builtin_case, node, name, -1);
                }
            }
        }
        if (type < 0) {
            if (!source_identifier(session, name, node)) {
                return -1;
            }
            target = lookup(session, context, enum_name, DeclarationKind::enumeration, node);
            if (target < 0) {
                return 0;
            }
            const i64 value = session.index(49, target, case_name, 0, 0);
            if (value < 0) {
                return reject(session, SemanticError::unknown_enum_case, node, name, -1);
            }
            ordinal = mw(session, value, 1);
            type = concrete_type(session, ResolvedTypeKind::enum_value, target, -1, 0);
        }
        ResolvedRow result = session.resolved(node);
        result.set_operation(ResolvedOperation::enum_case);
        result.set_word(1, target);
        result.set_word(2, type);
        result.set_word(3, ordinal);
        session.set_resolved(node, result);
        return 0;
    }
    auto bind_expression(Session& session, i64 node, BindContext context) -> i64 {
        const SyntaxRow row = session.syntax(node);
        const compiler_parser::NodeKind kind = row.expression_kind();
        if (kind != compiler_parser::NodeKind::call && kind != compiler_parser::NodeKind::construct && kind
            != compiler_parser::NodeKind::name) {
            return 0;
        }
        const i64 name = source_name_range(session, row.word(0), row.word(4));
        set_rw(session, node, 0, name);
        const ResolvedRow prior = session.resolved(node);
        if (prior.operation() == ResolvedOperation::capacity_constant) {
            return 0;
        }
        const bool call = kind == compiler_parser::NodeKind::call;
        const bool construct = kind == compiler_parser::NodeKind::construct;
        if ((call || construct) && (plain_is(session, name, "array") || (builtin_name(session, name) && leaf_is(session,
            name, "array")))) {
            return reject(session, SemanticError::array_constructor, node, -1, -1);
        }
        if (row.word(6) >= 0 && row.word(7) == 1) {
            if (!call && !construct) {
                return reject(session, SemanticError::template_expression, node, -1, -1);
            }
            const i64 target = lookup(session, context, name, DeclarationKind::invalid, node);
            if (!session.good()) {
                return -1;
            }
            const bool function = target >= 0 && declaration_kind(session, target)
                == DeclarationKind::function_template;
            if (function) {
                if ((context.receiver() >= 0 && mw(session, context.receiver(), 9) >= 0) || (context.function() >= 0
                    && mw(session, context.function(), 9) >= 0)) {
                    return reject(session, SemanticError::template_function_call, node, -1, -1);
                }
                if (!call) {
                    return reject(session, SemanticError::function_template_arguments, node, -1, -1);
                }
            } else {
                if (target < 0) {
                    return reject(session, SemanticError::unknown_template, node, name, -1);
                }
                if (declaration_kind(session, target) != DeclarationKind::class_template) {
                    const i64 qualified = mw(session, target, 3);
                    return reject(session, SemanticError::wrong_kind, node, qualified, -1);
                }
            }
            const SyntaxRow arguments_root = session.syntax(row.word(6));
            check_arity(session, target, arguments_root, node, name);
            if (!session.good()) {
                return -1;
            }
            if (arguments_root.word(3) >= 0) {
                resolve_type(session, arguments_root.word(3), context, true);
            }
            if (arguments_root.word(4) >= 0 && session.good()) {
                resolve_type(session, arguments_root.word(4), context, true);
            }
            if (!session.good()) {
                return -1;
            }
            const Arguments arguments = request_arguments(session, row.word(6));
            const i64 instance = request_instance(session, target, arguments, context, node);
            if (instance >= 0 && session.good()) {
                if (function) {
                    require_signature(session, instance, context, node);
                    set_rw(session, node, 1, instance);
                } else {
                    bind_construction(session, node, instance, context, call);
                }
            }
            return 0;
        }
        if (call) {
            if (plain_is(session, name, "size_of") || plain_is(session, name, "type_id") || plain_is(session, name,
                "field_count")) {
                const i64 type = resolve_type(session, row.word(6), context, false);
                set_rw(session, node, 2, type);
                return 0;
            }
            if (intrinsic(session, name)) {
                return 0;
            }
            const i64 member = receiver_member(session, context.receiver(), name);
            if (member >= 0) {
                const SyntaxRow declaration = session.syntax(member);
                if (declaration.declaration_kind() == compiler_parser::SyntaxKind::field) {
                    return reject(session, SemanticError::field_callable, node, name, -1);
                }
                if (declaration.declaration_kind() != compiler_parser::SyntaxKind::constructor) {
                    if (context.initializer()) {
                        return reject(session, SemanticError::initializer_method, node, -1, -1);
                    }
                    const i64 method = rw(session, member, 1);
                    ResolvedRow binding = session.resolved(node);
                    binding.set_operation(ResolvedOperation::implicit_method_call);
                    binding.set_word(1, method);
                    session.set_resolved(node, binding);
                    return 0;
                }
            }
            i64 target = -1;
            if (context.receiver() >= 0 && mw(session, context.receiver(), 9) >= 0) {
                const i64 receiver_node = mw(session, context.receiver(), 5);
                const i64 receiver_name = declaration_name(session, receiver_node);
                if (name == receiver_name || name == mw(session, context.receiver(), 3)) {
                    target = context.receiver();
                }
            }
            if (target < 0) {
                target = lookup(session, context, name, DeclarationKind::invalid, node);
            }
            if (target < 0 && session.good()) {
                return reject(session, SemanticError::unknown_function, node, name, context.module_id());
            }
            if (!session.good()) {
                return -1;
            }
            const DeclarationKind declaration = declaration_kind(session, target);
            if (declaration == DeclarationKind::class_template) {
                return reject(session, SemanticError::class_arguments, node, name, -1);
            }
            if (declaration == DeclarationKind::function_template) {
                return reject(session, SemanticError::function_arguments, node, name, -1);
            }
            if (declaration == DeclarationKind::enumeration) {
                return reject(session, SemanticError::enum_named, node, name, -1);
            }
            set_rw(session, node, 1, target);
            if (declaration == DeclarationKind::class_value) {
                bind_construction(session, node, target, context, true);
            } else {
                if (mw(session, target, 10) >= 0) {
                    bind_overload(session, node, target, context);
                } else {
                    require_signature(session, target, context, node);
                }
            }
        } else {
            if (construct) {
                i64 type = -1;
                if (builtin_name(session, name)) {
                    type = builtin_type(session, name);
                }
                if (type < 0) {
                    i64 target = -1;
                    if (context.receiver() >= 0 && mw(session, context.receiver(), 9) >= 0) {
                        const i64 receiver_root = mw(session, context.receiver(), 5);
                        const i64 receiver_name = declaration_name(session, receiver_root);
                        if (name == receiver_name || name == mw(session, context.receiver(), 3)) {
                            target = context.receiver();
                        }
                    }
                    if (target < 0) {
                        target = lookup(session, context, name, DeclarationKind::invalid, node);
                    }
                    if (target >= 0) {
                        const DeclarationKind declaration = declaration_kind(session, target);
                        if (declaration == DeclarationKind::enumeration) {
                            return reject(session, SemanticError::enum_named, node, name, -1);
                        }
                        if (declaration != DeclarationKind::class_value) {
                            return reject(session, SemanticError::concrete_type, node, name, -1);
                        }
                        type = concrete_type(session, ResolvedTypeKind::class_value, target, -1, 0);
                        if (!body_visible(session, type, context)) {
                            return reject(session, SemanticError::type_import, node, type, -1);
                        }
                        record_authority(session, type, context);
                    } else {
                        if (session.good()) {
                            type = concrete_type(session, ResolvedTypeKind::class_value, -name - 2, -1, 0);
                        }
                    }
                }
                if (type >= 0) {
                    if (type_kind(session, type) == ResolvedTypeKind::enum_value) {
                        return reject(session, SemanticError::enum_named, node, name, -1);
                    }
                    set_rw(session, node, 2, type);
                }
            } else {
                if (prefix_parent(session, name) >= 0) {
                    bind_enum_name(session, node, name, context);
                } else {
                    source_identifier(session, name, node);
                }
            }
        }
        return 0;
    }
    auto resolve_body_tree(Session& session, i64 body, BindContext context, bool initializers) -> i64 {
        const i64 base = session.work_count();
        if (initializers) {
            push_statement_list(session, body);
        } else {
            if (body >= 0) {
                session.append_work(WorkRow(body, 0, 0, 0, 0, 0));
            }
        }
        while (session.work_count() > base && session.good()) {
            const i64 top = session.work_count() - 1;
            const WorkRow item = session.work(top);
            session.truncate_work(top);
            const i64 node = item.word(0);
            const SyntaxRow row = session.syntax(node);
            if (item.word(1) == 2) {
                resolve_type(session, node, context, false);
            } else {
                if (item.word(1) == 1) {
                    bind_expression(session, node, context);
                    if (session.good()) {
                        push_expression_children(session, row);
                    }
                } else {
                    push_statement_children(session, row);
                }
            }
        }
        session.truncate_work(base);
        return 0;
    }
    auto resolve_body(Session& session, i64 symbol, i64 receiver) -> i64 {
        const i64 unit = mw(session, symbol, 1);
        const i64 scope = mw(session, symbol, 2);
        const i64 root = mw(session, symbol, 5);
        const bool constructor = declaration_kind(session, symbol) == DeclarationKind::constructor;
        i64 function = symbol;
        if (receiver >= 0) {
            function = -1;
        }
        const BindContext context = BindContext(unit, scope, function, receiver, constructor, false);
        const i64 initializers = sw(session, root, 7);
        resolve_body_tree(session, initializers, context, constructor);
        if (constructor && session.good()) {
            const BindContext complete = BindContext(unit, scope, function, receiver, false, false);
            const i64 body = sw(session, root, 4);
            resolve_body_tree(session, body, complete, false);
        }
        return 0;
    }
    auto heap_down(Session& session, i64 base, i64 root, i64 count) -> i64 {
        i64 current = root;
        bool done = false;
        while (!done && session.good()) {
            i64 child = current * 2 + 1;
            if (child >= count) {
                done = true;
            } else {
                const WorkRow left = session.work(base + child);
                if (child + 1 < count) {
                    const WorkRow right = session.work(base + child + 1);
                    if (prefix_compare(session, left.word(0), right.word(0)) < 0) {
                        child = child + 1;
                    }
                }
                const WorkRow selected = session.work(base + child);
                const WorkRow parent = session.work(base + current);
                if (prefix_compare(session, parent.word(0), selected.word(0)) >= 0) {
                    done = true;
                } else {
                    session.set_work(base + current, selected);
                    session.set_work(base + child, parent);
                    current = child;
                }
            }
        }
        return 0;
    }
    auto sort_names(Session& session, i64 base) -> i64 {
        const i64 count = session.work_count() - base;
        i64 start = count / 2;
        while (start > 0 && session.good()) {
            start = start - 1;
            heap_down(session, base, start, count);
        }
        i64 end = count;
        while (end > 1 && session.good()) {
            end = end - 1;
            const WorkRow first = session.work(base);
            const WorkRow last = session.work(base + end);
            session.set_work(base, last);
            session.set_work(base + end, first);
            heap_down(session, base, 0, end);
        }
        return 0;
    }
    // Only symbols defined by unit or by a module it imports directly can be
    // visible in it. make_symbol and template instantiation link every symbol
    // with an owner into that owner's category lists, and no symbol's owner
    // changes, so walking the owners' lists visits every row the old scan of all
    // metadata accepted. Visiting order does not matter here: names are recorded
    // once and then sorted.
    auto collect_visible(Session& session, i64 unit, i64 owner, i64 count) -> i64 {
        i64 tag = 0;
        while (tag < 8 && session.good()) {
            const i64 list = session.index(33, owner, tag, 0, 0);
            i64 at = -1;
            if (list >= 0) {
                at = mw(session, list, 0);
            }
            while (at >= 0 && session.good()) {
                const MetaRow value = session.meta(at);
                if (at < count && value.kind() == MetaTag::symbol && value.word(1) >= 0 && value.word(7) < 0
                    && value.word(9) < 0) {
                    const i64 defining = value.word(1);
                    if (defining == unit || (exported(session, at) && direct_import(session, unit, defining))) {
                        const i64 name = value.word(3);
                        if (session.index(55, unit, name, 0, 0) < 0) {
                            session.index_insert(55, unit, name, 0, 0, at);
                            session.append_work(WorkRow(name, at, 0, 0, 0, 0));
                            i64 parent = prefix_parent(session, name);
                            while (parent >= 0 && session.good()) {
                                if (session.index(56, unit, parent, 0, 0) < 0) {
                                    session.index_insert(56, unit, parent, 0, 0, at);
                                }
                                parent = prefix_parent(session, parent);
                            }
                        }
                    }
                }
                at = value.word(14);
            }
            tag = tag + 1;
        }
        return 0;
    }
    auto check_visible_names(Session& session, i64 unit) -> i64 {
        const i64 base = session.work_count();
        const i64 count = session.meta_count();
        collect_visible(session, unit, unit, count);
        i64 edge = import_head(session, unit);
        while (edge >= 0 && session.good()) {
            const i64 target = mw(session, edge, 1);
            collect_visible(session, unit, target, count);
            edge = mw(session, edge, 4);
        }
        sort_names(session, base);
        const i64 end = session.work_count();
        i64 at = base;
        while (at < end && session.good()) {
            const WorkRow value = session.work(at);
            const i64 name = value.word(0);
            visible_name(session, unit, name, -1);
            if (session.good() && (session.index(38, unit, name, 0, 0) >= 0 || session.index(56, unit, name, 0, 0)
                >= 0)) {
                reject(session, SemanticError::namespace_collision, -1, name, -1);
            }
            at = at + 1;
        }
        session.truncate_work(base);
        return 0;
    }

    auto output_context(Session& session) -> i64 {
        MetaRow value = MetaRow(MetaTag::context);
        value.set_word(0, 1);
        value.set_word(14, 1);
        const i64 result = session.append_meta(value);
        session.index_insert(60, 0, 0, 0, 0, result);
        return result;
    }
    auto append_output(Session& session, i64 output, i64 lane, i64 symbol) -> i64 {
        MetaRow value = MetaRow(MetaTag::link);
        value.set_word(0, symbol);
        const i64 result = session.append_meta(value);
        const i64 tail = mw(session, output, lane + 4);
        if (tail < 0) {
            set_mw(session, output, lane, result);
        } else {
            set_mw(session, tail, 1, result);
        }
        set_mw(session, output, lane + 4, result);
        return result;
    }
    auto show_nominal(Session& session, i64 output, i64 symbol, i64 scope) -> i64 {
        i64 view = session.index(57, symbol, 0, 0, 0);
        if (view < 0) {
            MetaRow value = MetaRow(MetaTag::visibility);
            value.set_word(0, symbol);
            view = session.append_meta(value);
            const i64 tail = mw(session, output, 8);
            if (tail < 0) {
                set_mw(session, output, 4, view);
            } else {
                set_mw(session, tail, 3, view);
            }
            set_mw(session, output, 8, view);
            session.index_insert(57, symbol, 0, 0, 0, view);
        }
        // Each module scope that sees the nominal has its own key, scope + 1
        // (the key with 0 is the view row), so any graph size scales.
        session.index_insert(57, symbol, scope + 1, 0, 0, view);
        return 0;
    }
    // Pushes the class and enum list heads of owner, once per distinct owner.
    // Every class or enum symbol with an owner is on that owner's list for its
    // category, in creation order.
    auto push_nominal_lists(Session& session, i64 owner, i64 base) -> i64 {
        i64 at = base;
        while (at < session.work_count() && session.good()) {
            const WorkRow seen = session.work(at);
            if (seen.word(1) == owner) {
                return 0;
            }
            at = at + 1;
        }
        i64 tag = 1;
        while (tag <= 2 && session.good()) {
            const i64 list = session.index(33, owner, tag, 0, 0);
            if (list >= 0) {
                const i64 head = mw(session, list, 0);
                session.append_work(WorkRow(head, owner, 0, 0, 0, 0));
            }
            tag = tag + 1;
        }
        return 0;
    }
    // Shows each class or enum of unit and its direct imports in metadata order,
    // merging their creation-ordered lists; rows made while showing are not
    // visited, as the old scan bounded by the starting row count did not visit them.
    auto reflection_view(Session& session, i64 output, i64 unit) -> i64 {
        const i64 scope = mw(session, unit, 13);
        const i64 count = session.meta_count();
        const i64 base = session.work_count();
        push_nominal_lists(session, unit, base);
        i64 edge = import_head(session, unit);
        while (edge >= 0 && session.good()) {
            const i64 target = mw(session, edge, 1);
            push_nominal_lists(session, target, base);
            edge = mw(session, edge, 4);
        }
        const i64 lists = session.work_count();
        bool done = false;
        while (!done && session.good()) {
            i64 selected = -1;
            i64 at = count;
            i64 list = base;
            while (list < lists && session.good()) {
                const WorkRow head = session.work(list);
                if (head.word(0) >= 0 && head.word(0) < at) {
                    at = head.word(0);
                    selected = list;
                }
                list = list + 1;
            }
            if (selected < 0) {
                done = true;
            } else {
                const MetaRow row = session.meta(at);
                const WorkRow head = session.work(selected);
                session.set_work(selected, WorkRow(row.word(14), head.word(1), 0, 0, 0, 0));
                if (row.kind() == MetaTag::symbol && row.word(1) >= 0 && (row.declaration_kind()
                    == DeclarationKind::class_value || row.declaration_kind() == DeclarationKind::enumeration)) {
                    if (row.word(1) == unit || (row.word(6) != 0 && direct_import(session, unit, row.word(1)))) {
                        ResolvedTypeKind kind = ResolvedTypeKind::class_value;
                        if (row.declaration_kind() == DeclarationKind::enumeration) {
                            kind = ResolvedTypeKind::enum_value;
                        }
                        const i64 type = concrete_type(session, kind, at, -1, 0);
                        if (type_accessible(session, type, unit, -1)) {
                            show_nominal(session, output, at, scope);
                        }
                    }
                }
            }
        }
        session.truncate_work(base);
        return 0;
    }
    auto resolve_class_bodies(Session& session, i64 symbol) -> i64 {
        const i64 root = mw(session, symbol, 5);
        const i64 last = sw(session, root, 7);
        const i64 base = session.work_count();
        push_declarations(session, last, -1, 0, symbol);
        while (session.work_count() > base && session.good()) {
            const i64 top = session.work_count() - 1;
            const WorkRow item = session.work(top);
            session.truncate_work(top);
            const i64 node = sw(session, item.word(0), 7);
            const SyntaxRow row = session.syntax(node);
            if (row.declaration_kind() != compiler_parser::SyntaxKind::field) {
                const i64 method = rw(session, node, 1);
                resolve_body(session, method, symbol);
            }
        }
        session.truncate_work(base);
        return 0;
    }
    auto publish_services(Session& session, i64 output) -> i64 {
        const i64 status = state(session);
        if (mw(session, status, 3) == 0) {
            return 0;
        }
        const i64 count = session.meta_count();
        i64 at = 0;
        while (at < count && session.good()) {
            const MetaRow descriptor = session.meta(at);
            if (descriptor.kind() == MetaTag::context && descriptor.word(0) == 90
                && nominal_kind(descriptor.type_kind())) {
                const i64 type = seed_type(session, descriptor.type_kind(), at);
                const i64 symbol = mw(session, type, 1);
                i64 lane = 2;
                if (descriptor.type_kind() == ResolvedTypeKind::enum_value) {
                    lane = 3;
                }
                append_output(session, output, lane, symbol);
                i64 unit = 0;
                while (unit < session.module_count() && session.good()) {
                    const i64 scope = mw(session, unit, 13);
                    show_nominal(session, output, symbol, scope);
                    unit = unit + 1;
                }
            }
            at = at + 1;
        }
        return 0;
    }
    auto resolve_and_publish(Session& session) -> i64 {
        const i64 output = output_context(session);
        i64 order = 0;
        while (order < session.module_count() && session.good()) {
            const i64 unit = module_at_order(session, order);
            check_visible_names(session, unit);
            i64 symbol = first_symbol(session, unit, DeclarationKind::function);
            while (symbol >= 0 && session.good()) {
                resolve_body(session, symbol, -1);
                if (session.good()) {
                    append_output(session, output, 1, symbol);
                }
                symbol = mw(session, symbol, 14);
            }
            symbol = first_symbol(session, unit, DeclarationKind::class_value);
            while (symbol >= 0 && session.good()) {
                resolve_class_bodies(session, symbol);
                if (session.good()) {
                    append_output(session, output, 2, symbol);
                }
                symbol = mw(session, symbol, 14);
            }
            if (session.good()) {
                reflection_view(session, output, unit);
            }
            order = order + 1;
        }
        order = 0;
        while (order < session.module_count() && session.good()) {
            const i64 unit = module_at_order(session, order);
            i64 symbol = first_symbol(session, unit, DeclarationKind::enumeration);
            while (symbol >= 0 && session.good()) {
                append_output(session, output, 3, symbol);
                symbol = mw(session, symbol, 14);
            }
            order = order + 1;
        }
        if (session.good()) {
            publish_services(session, output);
        }
        if (session.good() && mw(session, output, 1) < 0) {
            reject(session, SemanticError::missing_function, -1, -1, -1);
        }
        if (!session.good()) {
            return -1;
        }
        return output;
    }
    // One invocation is the only production source-resolution authority. Every
    // output remains tentative until the final successful context is returned.
    auto run(Session& session) -> i64 {
        // Create resolution state only after every source module is ingested,
        // its imports are bound and the catalog is seeded: its syntax-count
        // snapshot bounds subsequent template cloning.
        if (!bind_imports(session) || !seed_catalog(session)) {
            return -1;
        }
        const i64 status = state(session);
        const i64 call_rank = type_rank(ResolvedTypeKind::call_session);
        if (session.index(34, call_rank, -1, -1, 0) >= 0 || session.index(34, type_rank(ResolvedTypeKind::port_range),
            -1, -1, 0) >= 0 || session.index(34, type_rank(ResolvedTypeKind::serve_session), -1, -1, 0) >= 0
            || session.index(34, type_rank(ResolvedTypeKind::host_files), -1, -1, 0) >= 0 || session.index(34,
            type_rank(ResolvedTypeKind::read_only_block), -1, -1, 0) >= 0 || session.index(34,
            type_rank(ResolvedTypeKind::writable_block), -1, -1, 0) >= 0 || session.index(34,
            type_rank(ResolvedTypeKind::execution_effects), -1, -1, 0) >= 0 || session.index(34,
            type_rank(ResolvedTypeKind::bootstrap_effects), -1, -1, 0) >= 0) {
            set_mw(session, status, 3, 1);
        }
        if (session.good()) {
            attach_expression_types(session);
        }
        if (session.good()) {
            register_declarations(session);
        }
        if (session.good()) {
            validate_template_definitions(session);
        }
        if (session.good()) {
            expand_templates(session);
        }
        if (session.good()) {
            resolve_class_types(session);
        }
        if (session.good()) {
            validate_function_template_signatures(session);
        }
        if (session.good()) {
            resolve_signatures(session);
        }
        if (!session.good()) {
            return -1;
        }
        const i64 output = resolve_and_publish(session);
        if (output < 0 || !session.good()) {
            return -1;
        }
        return 0;
    }
}
