export module aurora.compiler.syntax_arena;

// Compiler-owned graph storage. Indices belong to one arena invocation and
// never expose references, owner descriptors or byte representations.
export namespace compiler_parser {
    enum class NodeKind {
        invalid,
        literal,
        name,
        unary,
        binary,
        call,
        member,
        method_call,
        index,
        array_literal,
        construct,
        array_zero
    };

    enum class ArenaFailure {
        none,
        allocation,
        depth,
        invalid
    };
    enum class FrameState {
        expression_start,
        expression_left,
        expression_right,
        primary_start,
        primary_group,
        primary_unary,
        primary_postfix,
        call_arguments,
        method_arguments,
        index_expression,
        array_arguments,
        construct_field,
        construct_arguments,
        constructor_arguments,
        template_opening,
        template_candidate,
        type_start,
        type_arguments,
        type_argument_first,
        type_argument_second,
        type_array_element,
        type_owned_element,
        body_block,
        body_if_then,
        body_if_else,
        body_while
    };

    class ParseFrame {
        FrameState step;
        i64 minimum;
        i64 left;
        i64 operator_token;
        i64 field_token;
    public:
        ParseFrame(FrameState state, i64 precedence, i64 lhs, i64 token) : step(state), minimum(precedence), left(lhs),
            operator_token(token), field_token(-1) {
        }
        auto state() const -> FrameState {
            return step;
        }
        auto min() const -> i64 {
            return minimum;
        }
        auto lhs() const -> i64 {
            return left;
        }
        auto token() const -> i64 {
            return operator_token;
        }
        auto designate(i64 field) -> i64 {
            field_token = field;
            return 0;
        }
        auto field() const -> i64 {
            return field_token;
        }
    };

    class AstNode {
        NodeKind tag;
        i64 token_index;
        i64 first_child;
        i64 second_child;
        i64 tree_depth;
        i64 name_end;
        i64 closing_token;
    public:
        AstNode(NodeKind kind, i64 token, i64 first, i64 second, i64 depth) : tag(kind), token_index(token),
            first_child(first), second_child(second), tree_depth(depth), name_end(token), closing_token(token) {
        }
        auto kind() const -> NodeKind {
            return tag;
        }
        auto token() const -> i64 {
            return token_index;
        }
        auto first() const -> i64 {
            return first_child;
        }
        auto second() const -> i64 {
            return second_child;
        }
        auto depth() const -> i64 {
            return tree_depth;
        }
        auto locate(i64 last, i64 close) -> i64 {
            name_end = last;
            closing_token = close;
            return 0;
        }
        auto last() const -> i64 {
            return name_end;
        }
        auto close() const -> i64 {
            return closing_token;
        }
    };

    class ChildEdge {
        i64 child_node;
        i64 previous_edge;
        i64 argument_count;
        i64 tree_depth;
        i64 field_token;
    public:
        ChildEdge(i64 child, i64 previous, i64 count, i64 depth, i64 field) : child_node(child),
            previous_edge(previous), argument_count(count), tree_depth(depth), field_token(field) {
        }
        auto child() const -> i64 {
            return child_node;
        }
        auto previous() const -> i64 {
            return previous_edge;
        }
        auto count() const -> i64 {
            return argument_count;
        }
        auto depth() const -> i64 {
            return tree_depth;
        }
        auto field() const -> i64 {
            return field_token;
        }
    };

    enum class TypeKind {
        invalid,
        i64_type,
        u64_type,
        u8_type,
        bool_type,
        named,
        parameter,
        capacity,
        length_parameter,
        array_type,
        own_type,
        ref_type,
        mutref_type,
        byte_span,
        builtin_type,
        owned_values,
        builtin_class
    };
    // Unresolved syntax only. close encodes the original token and its half;
    // roots name their containing expression or declaration by its first token.
    class TypeSyntax {
        TypeKind tag;
        i64 token_index;
        i64 name_end;
        i64 closing_token;
        i64 first_child;
        i64 second_child;
        i64 owner_token;
        i64 owner_role;
    public:
        TypeSyntax(TypeKind kind, i64 token, i64 last, i64 close, i64 first, i64 second) : tag(kind),
            token_index(token), name_end(last), closing_token(close), first_child(first), second_child(second),
            owner_token(-1), owner_role(0) {
        }
        auto kind() const -> TypeKind {
            return tag;
        }
        auto token() const -> i64 {
            return token_index;
        }
        auto last() const -> i64 {
            return name_end;
        }
        auto close() const -> i64 {
            return closing_token;
        }
        auto first() const -> i64 {
            return first_child;
        }
        auto second() const -> i64 {
            return second_child;
        }
        auto owner() const -> i64 {
            return owner_token;
        }
        auto role() const -> i64 {
            return owner_role;
        }
        auto bind_owner(i64 token, i64 role) -> bool {
            if (owner_token != -1 || owner_role != 0 || token < 0 || (role != 1 && role != 2 && role != 3)) {
                return false;
            }
            owner_token = token;
            owner_role = role;
            return true;
        }
    };

    enum class StatementKind {
        invalid,
        block,
        local,
        return_value,
        static_assertion,
        conditional,
        loop,
        expression,
        assign,
        field_assign,
        index_assign
    };
    // Complete body syntax, with child-before-parent block/control ownership.
    // Siblings are reverse-linked; expression and type indices share this arena.
    class StatementSyntax {
        StatementKind tag;
        i64 token_index;
        i64 end_token;
        i64 previous_statement;
        i64 expression_root;
        i64 target_root;
        i64 declared_type;
        i64 binding_token;
        i64 body_statement;
        i64 other_statement;
        i64 mutable_value;
    public:
        StatementSyntax(StatementKind kind, i64 token, i64 end, i64 previous) : tag(kind), token_index(token),
            end_token(end), previous_statement(previous), expression_root(-1), target_root(-1), declared_type(-1),
            binding_token(-1), body_statement(-1), other_statement(-1), mutable_value(0) {
        }
        auto kind() const -> StatementKind {
            return tag;
        }
        auto token() const -> i64 {
            return token_index;
        }
        auto end() const -> i64 {
            return end_token;
        }
        auto previous() const -> i64 {
            return previous_statement;
        }
        auto expression() const -> i64 {
            return expression_root;
        }
        auto target() const -> i64 {
            return target_root;
        }
        auto type() const -> i64 {
            return declared_type;
        }
        auto binding() const -> i64 {
            return binding_token;
        }
        auto body() const -> i64 {
            return body_statement;
        }
        auto other() const -> i64 {
            return other_statement;
        }
        auto mutable_binding() const -> i64 {
            return mutable_value;
        }
        auto bind_expression(i64 expression, i64 target) -> i64 {
            expression_root = expression;
            target_root = target;
            return 0;
        }
        auto bind_local(i64 type, i64 binding, i64 mutable_binding) -> i64 {
            declared_type = type;
            binding_token = binding;
            mutable_value = mutable_binding;
            return 0;
        }
        auto bind_body(i64 body, i64 other) -> i64 {
            body_statement = body;
            other_statement = other;
            return 0;
        }
    };

    class AstArena {
        builtin::OwnedValues<AstNode> nodes;
        i64 used;
        builtin::OwnedValues<ParseFrame> frames;
        i64 frame_count;
        ArenaFailure error;
        builtin::OwnedValues<ChildEdge> edges;
        i64 edge_count;
        builtin::OwnedValues<TypeSyntax> type_nodes;
        i64 type_count;
        builtin::OwnedValues<StatementSyntax> statement_nodes;
        i64 statement_count;
        auto store(AstNode node) -> i64 {
            if (node.depth() > 128) {
                error = ArenaFailure::depth;
                return -1;
            }
            if (used == 9223372036854775807) {
                error = ArenaFailure::invalid;
                return -1;
            }
            if (used == nodes.size()) {
                i64 next = 8;
                if (used > 0) {
                    if (used > 4611686018427387903) {
                        next = used + 1;
                    } else {
                        next = used * 2;
                    }
                }
                AstNode empty = AstNode(NodeKind::invalid, -1, -1, -1, 0);
                if (!nodes.try_resize(next, empty)) {
                    error = ArenaFailure::allocation;
                    return -1;
                }
            }
            if (!nodes.set(used, node)) {
                error = ArenaFailure::invalid;
                return -1;
            }
            const i64 index = used;
            used = used + 1;
            error = ArenaFailure::none;
            return index;
        }
    public:
        AstArena(builtin::ByteRegion region, builtin::OwnedValues<AstNode> initial,
            builtin::OwnedValues<ParseFrame> scratch, builtin::OwnedValues<ChildEdge> arguments,
            builtin::OwnedValues<TypeSyntax> types,
            builtin::OwnedValues<StatementSyntax> statements) : nodes(move(initial)), used(0), frames(move(scratch)),
            frame_count(0), error(ArenaFailure::none), edges(move(arguments)), edge_count(0), type_nodes(move(types)),
            type_count(0), statement_nodes(move(statements)), statement_count(0) {
        }
        auto ok() const -> bool {
            return nodes.ok() && frames.ok() && edges.ok() && type_nodes.ok() && statement_nodes.ok();
        }
        auto size() const -> i64 {
            return used;
        }
        auto capacity() const -> i64 {
            return nodes.size();
        }

        auto failure() const -> ArenaFailure {
            return error;
        }
        auto stack_size() const -> i64 {
            return frame_count;
        }
        auto scratch_at(i64 index) const -> ParseFrame {
            i64 checked = index;
            if (index < 0 || index >= frame_count) {
                checked = -1;
            }
            return frames.at(checked);
        }
        auto replace_scratch(i64 index, ParseFrame value) -> bool {
            if (index < 0 || index >= frame_count || !frames.set(index, value)) {
                error = ArenaFailure::invalid;
                return false;
            }
            return true;
        }
        auto truncate_stack(i64 count) -> bool {
            if (count < 0 || count > frame_count) {
                error = ArenaFailure::invalid;
                return false;
            }
            frame_count = count;
            return true;
        }
        auto types() const -> i64 {
            return type_count;
        }
        auto type_at(i64 index) const -> TypeSyntax {
            i64 checked = index;
            if (index < 0 || index >= type_count) {
                checked = -1;
            }
            return type_nodes.at(checked);
        }
        auto append_type(TypeKind kind, i64 token, i64 last, i64 close, i64 first, i64 second) -> i64 {
            error = ArenaFailure::invalid;
            if (!type_nodes.ok() || kind == TypeKind::invalid || token < 0 || last < token || last > 4611686018427387903
                || close < last * 2 || first < -1 || second < -1 || first >= type_count || second >= type_count
                || (first == -1 && second != -1) || (first >= 0 && first == second) || type_count
                == 9223372036854775807) {
                return -1;
            }
            if (first >= 0) {
                TypeSyntax child = type_nodes.at(first);
                if (child.owner() != -1 || child.role() != 0) {
                    return -1;
                }
            }
            if (second >= 0) {
                TypeSyntax child = type_nodes.at(second);
                if (child.owner() != -1 || child.role() != 0) {
                    return -1;
                }
            }
            if (type_count == type_nodes.size()) {
                i64 next = 8;
                if (type_count > 0) {
                    if (type_count > 4611686018427387903) {
                        next = type_count + 1;
                    } else {
                        next = type_count * 2;
                    }
                }
                TypeSyntax empty = TypeSyntax(TypeKind::invalid, -1, -1, -1, -1, -1);
                if (!type_nodes.try_resize(next, empty)) {
                    error = ArenaFailure::allocation;
                    return -1;
                }
            }
            TypeSyntax value = TypeSyntax(kind, token, last, close, first, second);
            if (!type_nodes.set(type_count, value)) {
                return -1;
            }
            const i64 index = type_count;
            type_count = type_count + 1;
            error = ArenaFailure::none;
            return index;
        }
        auto own_type(i64 index, i64 token, i64 role) -> bool {
            error = ArenaFailure::invalid;
            if (index < 0 || index >= type_count) {
                return false;
            }
            TypeSyntax value = type_nodes.at(index);
            if (!value.bind_owner(token, role) || !type_nodes.set(index, value)) {
                return false;
            }
            error = ArenaFailure::none;
            return true;
        }
        auto statements() const -> i64 {
            return statement_count;
        }
        auto statement_at(i64 index) const -> StatementSyntax {
            i64 checked = index;
            if (index < 0 || index >= statement_count) {
                checked = -1;
            }
            return statement_nodes.at(checked);
        }
        auto append_statement(StatementSyntax value) -> i64 {
            error = ArenaFailure::invalid;
            if (!statement_nodes.ok() || value.kind() == StatementKind::invalid || value.token() < 0 || value.end()
                <= value.token() || value.previous() < -1 || value.previous() >= statement_count || value.expression()
                < -1 || value.expression() >= used || value.target() < -1 || value.target() >= used || value.type() < -1
                || value.type() >= type_count || value.binding() < -1 || value.body() < -1 || value.body()
                >= statement_count || value.other() < -1 || value.other() >= statement_count || value.mutable_binding()
                < 0 || value.mutable_binding() > 1 || statement_count == 9223372036854775807) {
                return -1;
            }
            if (statement_count == statement_nodes.size()) {
                i64 next = 8;
                if (statement_count > 0) {
                    if (statement_count > 4611686018427387903) {
                        next = statement_count + 1;
                    } else {
                        next = statement_count * 2;
                    }
                }
                StatementSyntax empty = StatementSyntax(StatementKind::invalid, -1, -1, -1);
                if (!statement_nodes.try_resize(next, empty)) {
                    error = ArenaFailure::allocation;
                    return -1;
                }
            }
            if (!statement_nodes.set(statement_count, value)) {
                return -1;
            }
            const i64 index = statement_count;
            statement_count = statement_count + 1;
            error = ArenaFailure::none;
            return index;
        }
        auto frame() const -> ParseFrame {
            return frames.at(frame_count - 1);
        }
        auto pop() -> i64 {
            if (frame_count <= 0) {
                error = ArenaFailure::invalid;
                return -1;
            }
            frame_count = frame_count - 1;
            return 0;
        }
        auto replace(ParseFrame value) -> bool {
            return frames.set(frame_count - 1, value);
        }
        auto push(ParseFrame value) -> bool {
            if (frame_count == 9223372036854775807) {
                error = ArenaFailure::invalid;
                return false;
            }
            if (frame_count == frames.size()) {
                i64 next = 8;
                if (frame_count > 0) {
                    if (frame_count > 4611686018427387903) {
                        next = frame_count + 1;
                    } else {
                        next = frame_count * 2;
                    }
                }
                ParseFrame empty = ParseFrame(FrameState::expression_start, 1, -1, -1);
                if (!frames.try_resize(next, empty)) {
                    error = ArenaFailure::allocation;
                    return false;
                }
            }
            if (!frames.set(frame_count, value)) {
                error = ArenaFailure::invalid;
                return false;
            }
            frame_count = frame_count + 1;
            return true;
        }

        auto at(i64 index) const -> AstNode {
            i64 checked = index;
            if (index < 0 || index >= used) {
                checked = -1;
            }
            return nodes.at(checked);
        }

        auto append_at(NodeKind kind, i64 token, i64 first, i64 second, i64 last, i64 close) -> i64 {
            error = ArenaFailure::invalid;
            if (!nodes.ok() || token < 0 || last < token || close < last) {
                return -1;
            }
            i64 depth = 1;
            if (kind == NodeKind::literal || kind == NodeKind::name) {
                if (first != -1 || second != -1) {
                    return -1;
                }
            }
            if (kind == NodeKind::unary || kind == NodeKind::member) {
                if (first < 0 || first >= used || second != -1) {
                    return -1;
                }
                AstNode child = nodes.at(first);
                depth = child.depth() + 1;
            }
            if (kind == NodeKind::binary || kind == NodeKind::index) {
                if (first < 0 || first >= used || second < 0 || second >= used) {
                    return -1;
                }
                AstNode left = nodes.at(first);
                AstNode right = nodes.at(second);
                depth = left.depth() + 1;
                if (right.depth() >= depth) {
                    depth = right.depth() + 1;
                }
            }
            if (kind != NodeKind::literal && kind != NodeKind::name && kind != NodeKind::unary && kind
                != NodeKind::binary && kind != NodeKind::member && kind != NodeKind::index) {
                return -1;
            }
            AstNode node = AstNode(kind, token, first, second, depth);
            node.locate(last, close);
            return store(node);
        }
        auto append(NodeKind kind, i64 token, i64 first, i64 second) -> i64 {
            return append_at(kind, token, first, second, token, token);
        }
        auto append_name(i64 first, i64 last) -> i64 {
            return append_at(NodeKind::name, first, -1, -1, last, last);
        }
        auto append_index(i64 token, i64 close, i64 base, i64 index) -> i64 {
            return append_at(NodeKind::index, token, base, index, token, close);
        }
        auto arguments() const -> i64 {
            return edge_count;
        }
        auto edge(i64 index) const -> ChildEdge {
            i64 checked = index;
            if (index < 0 || index >= edge_count) {
                checked = -1;
            }
            return edges.at(checked);
        }
        // Reverse-linked argument records permit source/resource-bounded arity.
        // Count/depth summaries avoid repeatedly walking a growing argument list.
        auto append_field(i64 previous, i64 child, i64 field) -> i64 {
            error = ArenaFailure::invalid;
            if (!edges.ok() || child < 0 || child >= used || previous < -1 || previous >= edge_count || edge_count
                == 9223372036854775807 || field < -1) {
                return -1;
            }
            AstNode node = nodes.at(child);
            i64 count = 1;
            i64 depth = node.depth() + 1;
            if (previous >= 0) {
                ChildEdge tail = edges.at(previous);
                count = tail.count() + 1;
                if (tail.depth() > depth) {
                    depth = tail.depth();
                }
            }
            if (depth > 128) {
                error = ArenaFailure::depth;
                return -1;
            }
            if (edge_count == edges.size()) {
                i64 next = 8;
                if (edge_count > 0) {
                    if (edge_count > 4611686018427387903) {
                        next = edge_count + 1;
                    } else {
                        next = edge_count * 2;
                    }
                }
                ChildEdge empty = ChildEdge(-1, -1, 0, 0, -1);
                if (!edges.try_resize(next, empty)) {
                    error = ArenaFailure::allocation;
                    return -1;
                }
            }
            ChildEdge argument = ChildEdge(child, previous, count, depth, field);
            if (!edges.set(edge_count, argument)) {
                return -1;
            }
            const i64 index = edge_count;
            edge_count = edge_count + 1;
            error = ArenaFailure::none;
            return index;
        }
        auto append_argument(i64 previous, i64 child) -> i64 {
            return append_field(previous, child, -1);
        }
        auto append_list(NodeKind kind, i64 token, i64 last, i64 close, i64 head) -> i64 {
            error = ArenaFailure::invalid;
            if (!nodes.ok() || !edges.ok() || token < 0 || last < token || close <= last || head < -1 || head
                >= edge_count || (kind != NodeKind::call && kind != NodeKind::method_call && kind
                != NodeKind::array_literal && kind != NodeKind::construct && kind != NodeKind::array_zero)) {
                return -1;
            }
            i64 count = 0;
            i64 depth = 1;
            if (head >= 0) {
                ChildEdge argument = edges.at(head);
                count = argument.count();
                depth = argument.depth();
            }
            if ((kind == NodeKind::method_call && count == 0) || (kind == NodeKind::array_zero && count != 0)) {
                return -1;
            }
            AstNode node = AstNode(kind, token, head, count, depth);
            node.locate(last, close);
            return store(node);
        }
    };
    auto make_arena(builtin::ByteRegion region, i64 initial_capacity) -> AstArena {
        AstNode empty = AstNode(NodeKind::invalid, -1, -1, -1, 0);
        builtin::OwnedValues<AstNode> storage = region.try_allocate(initial_capacity, empty);
        ParseFrame frame = ParseFrame(FrameState::expression_start, 1, -1, -1);
        builtin::OwnedValues<ParseFrame> scratch = region.try_allocate(0, frame);
        ChildEdge argument = ChildEdge(-1, -1, 0, 0, -1);
        builtin::OwnedValues<ChildEdge> edges = region.try_allocate(0, argument);
        TypeSyntax type_node = TypeSyntax(TypeKind::invalid, -1, -1, -1, -1, -1);
        builtin::OwnedValues<TypeSyntax> types = region.try_allocate(0, type_node);
        StatementSyntax statement = StatementSyntax(StatementKind::invalid, -1, -1, -1);
        builtin::OwnedValues<StatementSyntax> statements = region.try_allocate(0, statement);
        AstArena arena = AstArena(region, move(storage), move(scratch), move(edges), move(types), move(statements));
        return move(arena);
    }
}
