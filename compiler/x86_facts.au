export module aurora.compiler.x86_facts;
import aurora.compiler.x86_storage;
import aurora.compiler.x86_helpers;
import aurora.compiler.ir_metadata;
import aurora.compiler.ir_metadata_storage;

// Sidecars read the exact source-owned metadata and emission facts. Name views
// are scalar identities, so sorting and JSON escaping need no borrowed spans
// or copied name buffers.
export namespace compiler_x86 {
    auto fact_scalar_kind(i64 kind) -> bool {
        return kind == 0 || kind == 1 || kind == 7 || kind == 9 || kind == 10;
    }
    auto fact_copied_bytes(const compiler_ir_metadata::MetadataStore& metadata, i64 type) -> i64 {
        const i64 kind = type_kind(metadata, type);
        if (kind != 5) {
            if (fact_scalar_kind(kind) && storage_width(metadata, type) == 8) {
                return argument_bytes(metadata, type);
            }
            return 0;
        }
        const i64 class_id = type_class(metadata, type);
        if (class_id < 0 || owning_class(metadata, class_id)) {
            return 0;
        }
        i64 cursor = 0;
        i64 at = 0;
        while (at < class_leaf_count(metadata, class_id)) {
            if (class_leaf_offset(metadata, class_id, at) != cursor) {
                return 0;
            }
            cursor = cursor + storage_width(metadata, class_leaf_type(metadata, class_id, at));
            at = at + 1;
        }
        if (cursor != class_reserved(metadata, class_id)) {
            return 0;
        }
        return argument_bytes(metadata, type);
    }
    auto copied_record_bytes(const compiler_ir_metadata::MetadataStore& metadata, i64 callable) -> i64 {
        if (metadata.status() != compiler_ir_metadata::MetadataStatus::success || callable < 0 || callable
            >= metadata.callable_count()) {
            return 0;
        }
        const i64 result = result_type(metadata, callable);
        if (has_receiver(metadata, callable) || type_kind(metadata, result) != 5) {
            return 0;
        }
        const i64 bytes = fact_copied_bytes(metadata, result);
        if (bytes == 0) {
            return 0;
        }
        i64 at = 0;
        while (at < parameter_count(metadata, callable)) {
            if (fact_copied_bytes(metadata, parameter_type(metadata, callable, at)) == 0) {
                return 0;
            }
            at = at + 1;
        }
        return bytes;
    }
    auto service_record_bytes(const compiler_ir_metadata::MetadataStore& metadata, i64 callable) -> i64 {
        if (metadata.status() != compiler_ir_metadata::MetadataStatus::success || callable < 0 || callable
            >= metadata.callable_count()) {
            return 0;
        }
        const i64 result = result_type(metadata, callable);
        if (has_receiver(metadata, callable) || !fact_scalar_kind(type_kind(metadata, result))) {
            return 0;
        }
        bool service = false;
        i64 at = 0;
        while (at < parameter_count(metadata, callable)) {
            const i64 kind = type_kind(metadata, parameter_type(metadata, callable, at));
            if (kind >= 14 && kind <= 16) {
                service = true;
            } else {
                if (!fact_scalar_kind(kind)) {
                    return 0;
                }
            }
            at = at + 1;
        }
        if (!service) {
            return 0;
        }
        return storage_width(metadata, result);
    }
    auto fact_decimal_digits(i64 input) -> i64 {
        i64 value = input;
        i64 count = 1;
        while (value >= 10) {
            value = value / 10;
            count = count + 1;
        }
        return count;
    }
    auto fact_literal_byte(builtin::span<const u8> value, i64 index) -> i64 {
        return i64(value.at(index));
    }
    auto fact_query_count(i64 symbol) -> i64 {
        i64 suffix = 4;
        if (symbol % 2 == 1) {
            suffix = 11;
        }
        if (symbol / 2 == 0) {
            return 15 + suffix;
        }
        return 15 + fact_decimal_digits(symbol / 2) + suffix;
    }
    auto fact_query_byte(i64 symbol, i64 index) -> i64 {
        const i64 scope = symbol / 2;
        i64 suffix = 15;
        if (scope == 0) {
            if (index < 15) {
                return fact_literal_byte("aurora_reflect_", index);
            }
        } else {
            if (index < 14) {
                return fact_literal_byte("__au_reflect_s", index);
            }
            const i64 digits = fact_decimal_digits(scope);
            suffix = 15 + digits;
            if (index < 14 + digits) {
                i64 value = scope;
                i64 remaining = 13 + digits - index;
                while (remaining > 0) {
                    value = value / 10;
                    remaining = remaining - 1;
                }
                return 48 + value % 10;
            }
            if (index == 14 + digits) {
                return 95;
            }
        }
        if (symbol % 2 == 0) {
            return fact_literal_byte("size", index - suffix);
        }
        return fact_literal_byte("field_count", index - suffix);
    }
    // Kinds 0/1/2 share FunctionFact/CallFact identities. Kinds 3/4/5/6
    // identify class, enum, type-name and adapter ABI-name rows respectively.
    auto fact_name_valid(const EmitWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata, i64 kind,
        i64 identity) -> bool {
        if (identity < 0) {
            return false;
        }
        if (kind == 0) {
            return identity < metadata.callable_count();
        }
        if (kind == 1) {
            if (identity >= 128) {
                return false;
            }
            i64 at = 0;
            while (at < metadata.view_count()) {
                const compiler_ir_metadata::ViewRow row = metadata.view_at(at);
                if (row.scope() == identity / 2) {
                    return true;
                }
                at = at + 1;
            }
            return false;
        }
        if (kind == 2) {
            return identity < workspace.runtime_count();
        }
        if (kind == 3) {
            return identity < metadata.class_count();
        }
        if (kind == 4) {
            return identity < metadata.enum_count();
        }
        if (kind == 5) {
            return identity < metadata.type_count();
        }
        if (kind == 6) {
            return identity < workspace.abi_name_count();
        }
        return false;
    }
    auto fact_name_count(const EmitWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata, i64 kind,
        i64 identity) -> i64 {
        if (kind == 0) {
            const compiler_ir_metadata::CallableRow row = metadata.callable_at(identity);
            const compiler_ir_metadata::ByteRange name = row.name();
            return name.count();
        }
        if (kind == 1) {
            return fact_query_count(identity);
        }
        if (kind == 2) {
            const NameRow row = workspace.runtime_name(identity);
            return row.count();
        }
        if (kind == 3) {
            const compiler_ir_metadata::ClassRow row = metadata.class_at(identity);
            const compiler_ir_metadata::ByteRange name = row.name();
            return name.count();
        }
        if (kind == 4) {
            const compiler_ir_metadata::EnumRow row = metadata.enum_at(identity);
            const compiler_ir_metadata::ByteRange name = row.name();
            return name.count();
        }
        if (kind == 5) {
            const compiler_ir_metadata::RawTypeRow row = metadata.type_at(identity);
            const compiler_ir_metadata::ByteRange name = row.name();
            return name.count();
        }
        if (kind == 6) {
            const AbiNameRow row = workspace.abi_name_at(identity);
            return row.count();
        }
        return -1;
    }
    auto fact_name_byte(const EmitWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata, i64 kind,
        i64 identity, i64 index) -> i64 {
        if (kind == 0) {
            const compiler_ir_metadata::CallableRow row = metadata.callable_at(identity);
            const compiler_ir_metadata::ByteRange name = row.name();
            return metadata.byte_at(name.begin() + index);
        }
        if (kind == 1) {
            return fact_query_byte(identity, index);
        }
        if (kind == 2) {
            const NameRow row = workspace.runtime_name(identity);
            return workspace.name_byte(row.begin() + index);
        }
        if (kind == 3) {
            const compiler_ir_metadata::ClassRow row = metadata.class_at(identity);
            const compiler_ir_metadata::ByteRange name = row.name();
            return metadata.byte_at(name.begin() + index);
        }
        if (kind == 4) {
            const compiler_ir_metadata::EnumRow row = metadata.enum_at(identity);
            const compiler_ir_metadata::ByteRange name = row.name();
            return metadata.byte_at(name.begin() + index);
        }
        if (kind == 5) {
            const compiler_ir_metadata::RawTypeRow row = metadata.type_at(identity);
            const compiler_ir_metadata::ByteRange name = row.name();
            return metadata.byte_at(name.begin() + index);
        }
        if (kind == 6) {
            const AbiNameRow row = workspace.abi_name_at(identity);
            return workspace.name_byte(row.begin() + index);
        }
        return -1;
    }
    auto fact_name_compare(const EmitWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 left_kind, i64 left, i64 right_kind, i64 right) -> i64 {
        const i64 left_count = fact_name_count(workspace, metadata, left_kind, left);
        const i64 right_count = fact_name_count(workspace, metadata, right_kind, right);
        i64 count = left_count;
        if (right_count < count) {
            count = right_count;
        }
        i64 at = 0;
        while (at < count) {
            const i64 left_byte = fact_name_byte(workspace, metadata, left_kind, left, at);
            const i64 right_byte = fact_name_byte(workspace, metadata, right_kind, right, at);
            if (left_byte < right_byte) {
                return -1;
            }
            if (left_byte > right_byte) {
                return 1;
            }
            at = at + 1;
        }
        if (left_count < right_count) {
            return -1;
        }
        if (left_count > right_count) {
            return 1;
        }
        return 0;
    }
    auto fact_hex(i64 value) -> u8 {
        if (value < 10) {
            return u8(48 + value);
        }
        return u8(87 + value);
    }
    auto fact_json_name(EmitWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata, i64 kind,
        i64 identity) -> bool {
        if (!fact_name_valid(workspace, metadata, kind, identity)) {
            return workspace.fail();
        }
        const i64 count = fact_name_count(workspace, metadata, kind, identity);
        workspace.byte('"');
        i64 at = 0;
        while (at < count && workspace.ok()) {
            const i64 byte = fact_name_byte(workspace, metadata, kind, identity, at);
            if (byte == 34 || byte == 92) {
                workspace.byte('\\');
                workspace.byte(u8(byte));
                at = at + 1;
            } else {
                if (byte >= 32 && byte < 128) {
                    workspace.byte(u8(byte));
                    at = at + 1;
                } else {
                    i64 width = 0;
                    i64 scalar = byte % 8;
                    if (byte >= 194 && byte <= 223) {
                        width = 2;
                        scalar = byte % 32;
                    } else {
                        if (byte >= 224 && byte <= 239) {
                            width = 3;
                            scalar = byte % 16;
                        } else {
                            if (byte >= 240 && byte <= 244) {
                                width = 4;
                            }
                        }
                    }
                    bool valid = width != 0 && width <= count - at;
                    i64 next = 1;
                    while (valid && next < width) {
                        const i64 continuation = fact_name_byte(workspace, metadata, kind, identity, at + next);
                        valid = continuation >= 128 && continuation <= 191;
                        scalar = scalar * 64 + continuation % 64;
                        next = next + 1;
                    }
                    valid = valid && scalar <= 1114111 && !(scalar >= 55296 && scalar <= 57343) && (width != 3 || scalar
                        >= 2048) && (width != 4 || scalar >= 65536);
                    if (valid) {
                        next = 0;
                        while (next < width) {
                            const i64 value = fact_name_byte(workspace, metadata, kind, identity, at + next);
                            workspace.byte(u8(value));
                            next = next + 1;
                        }
                        at = at + width;
                    } else {
                        workspace.text("\\u00");
                        workspace.byte(fact_hex(byte / 16));
                        workspace.byte(fact_hex(byte % 16));
                        at = at + 1;
                    }
                }
            }
        }
        return workspace.byte('"');
    }
    auto fact_stack_valid(EmitWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata) -> bool {
        if (workspace.status() != EmitStatus::running || metadata.status()
            != compiler_ir_metadata::MetadataStatus::success) {
            return workspace.fail();
        }
        i64 at = 0;
        while (at < workspace.function_count()) {
            const FunctionFact row = workspace.function_at(at);
            if ((row.kind() != 0 && row.kind() != 1) || !fact_name_valid(workspace, metadata, row.kind(), row.symbol())
                || row.local() < 8) {
                return workspace.fail();
            }
            if (row.kind() == 0) {
                if (row.copied() != copied_record_bytes(metadata, row.symbol()) || row.service()
                    != service_record_bytes(metadata, row.symbol())) {
                    return workspace.fail();
                }
            } else {
                if (row.copied() != 0 || row.service() != 0) {
                    return workspace.fail();
                }
            }
            at = at + 1;
        }
        at = 0;
        while (at < workspace.call_count()) {
            const CallFact row = workspace.call_at(at);
            if (row.function() < 0 || row.function() >= workspace.function_count() || row.kind() < 0 || row.kind() > 2
                || !fact_name_valid(workspace, metadata, row.kind(), row.symbol()) || row.live() < 8 || row.arguments()
                < -1 || row.maximum() < -1 || (row.arguments() == -1) != (row.maximum() == -1) || (row.arguments() >= 0
                && row.kind() != 2)) {
                return workspace.fail();
            }
            at = at + 1;
        }
        return workspace.ok();
    }
    // Scratch indices occupy only the spare suffix of the workspace's retained
    // owner. Heapsort bounds comparisons by O(F log F + C log C), without a
    // second owner or changes to retained callable order.
    auto fact_sort_compare(const EmitWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        bool calls, i64 left, i64 right) -> i64 {
        i64 order = 0;
        if (calls) {
            const CallFact a = workspace.call_at(left);
            const CallFact b = workspace.call_at(right);
            if (a.function() < b.function()) {
                return -1;
            }
            if (a.function() > b.function()) {
                return 1;
            }
            order = fact_name_compare(workspace, metadata, a.kind(), a.symbol(), b.kind(), b.symbol());
        } else {
            const FunctionFact a = workspace.function_at(left);
            const FunctionFact b = workspace.function_at(right);
            order = fact_name_compare(workspace, metadata, a.kind(), a.symbol(), b.kind(), b.symbol());
        }
        if (order != 0) {
            return order;
        }
        // Equal call names retain original insertion order, including the last
        // service row used when the native symbol-keyed maps coalesce entries.
        if (left < right) {
            return -1;
        }
        if (left > right) {
            return 1;
        }
        return 0;
    }
    auto fact_sort_swap(EmitWorkspace& workspace, i64 left, i64 right) -> bool {
        const i64 a = workspace.sort_at(left);
        const i64 b = workspace.sort_at(right);
        if (!workspace.sort_set(left, b) || !workspace.sort_set(right, a)) {
            return workspace.fail();
        }
        return workspace.ok();
    }
    auto fact_sort_sift(EmitWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata, bool calls,
        i64 count, i64 first) -> bool {
        i64 root = first;
        i64 base = 0;
        if (calls) {
            base = workspace.function_count();
        }
        while (root < count && workspace.ok()) {
            i64 child = root * 2 + 1;
            if (child >= count) {
                return workspace.ok();
            }
            if (child + 1 < count) {
                const i64 left = workspace.sort_at(base + child);
                const i64 right = workspace.sort_at(base + child + 1);
                if (fact_sort_compare(workspace, metadata, calls, left, right) < 0) {
                    child = child + 1;
                }
            }
            const i64 parent_id = workspace.sort_at(base + root);
            const i64 child_id = workspace.sort_at(base + child);
            if (fact_sort_compare(workspace, metadata, calls, parent_id, child_id) >= 0) {
                return workspace.ok();
            }
            if (!fact_sort_swap(workspace, base + root, base + child)) {
                return false;
            }
            root = child;
        }
        return workspace.ok();
    }
    auto fact_heap_sort(EmitWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        bool calls) -> bool {
        i64 count = workspace.function_count();
        i64 base = 0;
        if (calls) {
            base = count;
            count = workspace.call_count();
        }
        i64 root = count / 2;
        while (root > 0 && workspace.ok()) {
            root = root - 1;
            fact_sort_sift(workspace, metadata, calls, count, root);
        }
        while (count > 1 && workspace.ok()) {
            count = count - 1;
            fact_sort_swap(workspace, base, base + count);
            fact_sort_sift(workspace, metadata, calls, count, 0);
        }
        return workspace.ok();
    }
    auto fact_call_begin(const EmitWorkspace& workspace, i64 function) -> i64 {
        const i64 base = workspace.function_count();
        i64 begin = 0;
        i64 end = workspace.call_count();
        while (begin < end) {
            const i64 middle = begin + (end - begin) / 2;
            const i64 id = workspace.sort_at(base + middle);
            const CallFact row = workspace.call_at(id);
            if (row.function() < function) {
                begin = middle + 1;
            } else {
                end = middle;
            }
        }
        return begin;
    }
    auto fact_has_service_call(const EmitWorkspace& workspace, i64 function) -> bool {
        const i64 base = workspace.function_count();
        i64 at = fact_call_begin(workspace, function);
        while (at < workspace.call_count()) {
            const i64 id = workspace.sort_at(base + at);
            const CallFact row = workspace.call_at(id);
            if (row.function() != function) {
                return false;
            }
            if (row.arguments() >= 0) {
                return true;
            }
            at = at + 1;
        }
        return false;
    }
    auto fact_emit_calls(EmitWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata, i64 function,
        bool service) -> bool {
        const i64 base = workspace.function_count();
        i64 at = fact_call_begin(workspace, function);
        bool first = true;
        while (at < workspace.call_count() && workspace.ok()) {
            const i64 selected = workspace.sort_at(base + at);
            const CallFact row = workspace.call_at(selected);
            if (row.function() != function) {
                return workspace.ok();
            }
            i64 live = row.live();
            i64 arguments = row.arguments();
            i64 maximum = row.maximum();
            i64 end = at + 1;
            bool same = true;
            // Adjacent equal names form one native map entry. Only this caller's
            // local range is walked; no function or callee rescans the graph.
            while (end < workspace.call_count() && same) {
                const i64 other_id = workspace.sort_at(base + end);
                const CallFact other = workspace.call_at(other_id);
                same = other.function() == function && fact_name_compare(workspace, metadata, row.kind(), row.symbol(),
                    other.kind(), other.symbol()) == 0;
                if (same) {
                    if (other.live() > live) {
                        live = other.live();
                    }
                    if (other.arguments() >= 0) {
                        arguments = other.arguments();
                        maximum = other.maximum();
                    }
                    end = end + 1;
                }
            }
            if (!service || arguments >= 0) {
                if (!first) {
                    workspace.byte(',');
                }
                first = false;
                fact_json_name(workspace, metadata, row.kind(), row.symbol());
                workspace.byte(':');
                if (service) {
                    workspace.text("{\"sysv_arguments\":");
                    workspace.number(arguments);
                    workspace.text(",\"result_max\":");
                    workspace.number(maximum);
                    workspace.byte('}');
                } else {
                    workspace.number(live);
                }
            }
            at = end;
        }
        return workspace.ok();
    }
    auto fact_emit_service_kind(EmitWorkspace& workspace, i64 kind) -> bool {
        if (kind == 14) {
            return workspace.text("\"builtin::ConsoleSession\"");
        }
        if (kind == 15) {
            return workspace.text("\"builtin::DisplaySession\"");
        }
        if (kind == 16) {
            return workspace.text("\"builtin::IommuEventSession\"");
        }
        return workspace.text("\"scalar\"");
    }
    auto fact_emit_stack_function(EmitWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 function) -> bool {
        const FunctionFact row = workspace.function_at(function);
        fact_json_name(workspace, metadata, row.kind(), row.symbol());
        workspace.text(":{\"local_bytes\":");
        workspace.number(row.local());
        workspace.text(",\"calls\":{");
        fact_emit_calls(workspace, metadata, function, false);
        workspace.text("},\"copied_record\":");
        if (row.copied() > 0) {
            workspace.text("{\"parameter_bytes\":[");
            i64 at = 0;
            while (at < parameter_count(metadata, row.symbol())) {
                if (at > 0) {
                    workspace.byte(',');
                }
                workspace.number(fact_copied_bytes(metadata, parameter_type(metadata, row.symbol(), at)));
                at = at + 1;
            }
            workspace.text("],\"result_bytes\":");
            workspace.number(row.copied());
            workspace.byte('}');
        } else {
            workspace.text("null");
        }
        if (row.service() > 0 || fact_has_service_call(workspace, function)) {
            workspace.text(",\"service_abi\":{\"record\":");
            if (row.service() > 0) {
                workspace.text("{\"parameters\":[");
                i64 at = 0;
                while (at < parameter_count(metadata, row.symbol())) {
                    if (at > 0) {
                        workspace.byte(',');
                    }
                    const i64 type = parameter_type(metadata, row.symbol(), at);
                    workspace.byte('[');
                    fact_emit_service_kind(workspace, type_kind(metadata, type));
                    workspace.byte(',');
                    workspace.number(argument_bytes(metadata, type));
                    workspace.byte(']');
                    at = at + 1;
                }
                workspace.text("],\"result_bytes\":");
                workspace.number(row.service());
                workspace.byte('}');
            } else {
                workspace.text("null");
            }
            workspace.text(",\"calls\":{");
            fact_emit_calls(workspace, metadata, function, true);
            workspace.text("}}");
        }
        return workspace.byte('}');
    }
    auto emit_stack_facts(EmitWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata) -> bool {
        if (!fact_stack_valid(workspace, metadata) || !workspace.sort_prepare() || !fact_heap_sort(workspace, metadata,
            false) || !fact_heap_sort(workspace, metadata, true)) {
            return false;
        }
        i64 at = 1;
        while (at < workspace.function_count()) {
            const i64 previous = workspace.sort_at(at - 1);
            const i64 current = workspace.sort_at(at);
            const FunctionFact a = workspace.function_at(previous);
            const FunctionFact b = workspace.function_at(current);
            if (fact_name_compare(workspace, metadata, a.kind(), a.symbol(), b.kind(), b.symbol()) >= 0) {
                return workspace.fail();
            }
            at = at + 1;
        }
        workspace.text("{\"version\":2,\"functions\":{");
        at = 0;
        while (at < workspace.function_count() && workspace.ok()) {
            if (at > 0) {
                workspace.byte(',');
            }
            const i64 selected = workspace.sort_at(at);
            fact_emit_stack_function(workspace, metadata, selected);
            at = at + 1;
        }
        return workspace.text("}}\n");
    }

    auto fact_abi_symbol_kind(i64 category) -> i64 {
        if (category == 0) {
            return 3;
        }
        if (category == 1) {
            return 4;
        }
        return 0;
    }
    auto fact_abi_member_count(const compiler_ir_metadata::MetadataStore& metadata, i64 category, i64 identity) -> i64 {
        if (category == 0) {
            return class_field_count(metadata, identity);
        }
        if (category == 1) {
            const compiler_ir_metadata::EnumRow row = metadata.enum_at(identity);
            return row.cases();
        }
        return 0;
    }
    auto fact_abi_names_valid(EmitWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata) -> bool {
        if (metadata.status() != compiler_ir_metadata::MetadataStatus::success) {
            return workspace.fail();
        }
        i64 at = 0;
        i64 previous_category = -1;
        i64 previous_identity = -1;
        while (at < workspace.abi_name_count()) {
            const AbiNameRow header = workspace.abi_name_at(at);
            const i64 category = header.category();
            const i64 identity = header.identity();
            if (category < 0 || category > 2 || category < previous_category || header.member() != -1
                || !fact_name_valid(workspace, metadata, fact_abi_symbol_kind(category), identity)) {
                return workspace.fail();
            }
            if (category == 0) {
                const i64 storage = class_storage(metadata, identity);
                if (storage < 0 || storage >= metadata.storage_count()) {
                    return workspace.fail();
                }
            }
            if (category == previous_category && fact_name_compare(workspace, metadata, fact_abi_symbol_kind(category),
                previous_identity, fact_abi_symbol_kind(category), identity) >= 0) {
                return workspace.fail();
            }
            const i64 members = fact_abi_member_count(metadata, category, identity);
            if (members < 0 || members > workspace.abi_name_count() - at - 1) {
                return workspace.fail();
            }
            i64 member = 0;
            while (member < members) {
                const AbiNameRow row = workspace.abi_name_at(at + 1 + member);
                if (row.category() != category || row.identity() != identity || row.member() != member) {
                    return workspace.fail();
                }
                member = member + 1;
            }
            previous_category = category;
            previous_identity = identity;
            at = at + 1 + members;
        }
        at = 0;
        while (at < workspace.retained_count()) {
            const i64 callable = workspace.retained_at(at);
            if (callable < 0 || callable >= metadata.callable_count()) {
                return workspace.fail();
            }
            at = at + 1;
        }
        return workspace.ok();
    }
    auto fact_emit_type(EmitWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 type) -> bool {
        const i64 kind = type_kind(metadata, type);
        workspace.text("\"kind\":");
        if (kind == 5) {
            workspace.text("\"class\"");
        } else {
            if (kind == 9) {
                workspace.text("\"enum\"");
            } else {
                if (kind == 11) {
                    workspace.text("\"span\"");
                } else {
                    if (kind == 13 || kind == 17) {
                        workspace.text("\"owner\"");
                    } else {
                        if (kind >= 14 && kind <= 16) {
                            workspace.text("\"service\"");
                        } else {
                            if (kind == 12) {
                                workspace.text("\"region\"");
                            } else {
                                if (kind == 10) {
                                    workspace.text("\"u8\"");
                                } else {
                                    if (kind == 7) {
                                        workspace.text("\"u64\"");
                                    } else {
                                        if (kind == 1) {
                                            workspace.text("\"bool\"");
                                        } else {
                                            if (kind == 0) {
                                                workspace.text("\"i64\"");
                                            } else {
                                                if (kind == 2) {
                                                    workspace.text("\"own\"");
                                                } else {
                                                    if (kind == 3) {
                                                        workspace.text("\"ref\"");
                                                    } else {
                                                        if (kind == 4) {
                                                            workspace.text("\"mutref\"");
                                                        } else {
                                                            return workspace.fail();
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if (kind == 5 || kind == 9) {
            workspace.text(",\"type_name\":");
            fact_json_name(workspace, metadata, 5, type);
        }
        return workspace.ok();
    }
    auto fact_emit_record(EmitWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 header_index) -> bool {
        const AbiNameRow header = workspace.abi_name_at(header_index);
        const i64 class_id = header.identity();
        fact_json_name(workspace, metadata, 3, class_id);
        workspace.text(":{\"source_name\":");
        fact_json_name(workspace, metadata, 6, header_index);
        workspace.text(",\"size\":");
        workspace.number(class_size(metadata, class_id));
        workspace.text(",\"alignment\":");
        workspace.number(class_alignment(metadata, class_id));
        workspace.text(",\"reserved\":");
        workspace.number(class_reserved(metadata, class_id));
        workspace.text(",\"fields\":[");
        i64 at = 0;
        while (at < class_field_count(metadata, class_id) && workspace.ok()) {
            if (at > 0) {
                workspace.byte(',');
            }
            const i64 type = class_field_type(metadata, class_id, at);
            const i64 kind = type_kind(metadata, type);
            const bool array_value = class_field_array(metadata, class_id, at) != 0;
            i64 width = storage_width(metadata, type);
            i64 count = 1;
            if (array_value) {
                count = class_field_length(metadata, class_id, at);
            }
            if (kind == 13 || kind == 17) {
                width = argument_bytes(metadata, type);
            }
            if (kind == 5) {
                const i64 child = type_class(metadata, type);
                width = 0;
                if (class_leaf_count(metadata, child) > 0) {
                    width = class_size(metadata, child);
                }
                if (array_value) {
                    count = class_field_elements(metadata, class_id, at);
                }
            }
            workspace.text("{\"name\":");
            fact_json_name(workspace, metadata, 6, header_index + 1 + at);
            workspace.text(",\"offset\":");
            workspace.number(class_field_offset(metadata, class_id, at));
            workspace.text(",\"bytes\":");
            workspace.number(width * count);
            workspace.text(",\"array_length\":");
            if (array_value) {
                workspace.number(count);
            } else {
                workspace.number(0);
            }
            workspace.byte(',');
            fact_emit_type(workspace, metadata, type);
            workspace.byte('}');
            at = at + 1;
        }
        return workspace.text("]}");
    }
    auto fact_emit_enum(EmitWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 header_index) -> bool {
        const AbiNameRow header = workspace.abi_name_at(header_index);
        const compiler_ir_metadata::EnumRow row = metadata.enum_at(header.identity());
        fact_json_name(workspace, metadata, 4, header.identity());
        workspace.text(":{\"source_name\":");
        fact_json_name(workspace, metadata, 6, header_index);
        workspace.text(",\"cases\":{");
        i64 at = 0;
        while (at < row.cases() && workspace.ok()) {
            if (at > 0) {
                workspace.byte(',');
            }
            fact_json_name(workspace, metadata, 6, header_index + 1 + at);
            workspace.byte(':');
            workspace.number(at);
            at = at + 1;
        }
        return workspace.text("}}");
    }
    auto fact_emit_abi_groups(EmitWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 category) -> bool {
        i64 at = 0;
        bool first = true;
        while (at < workspace.abi_name_count() && workspace.ok()) {
            const AbiNameRow row = workspace.abi_name_at(at);
            if (row.category() == category) {
                if (!first) {
                    workspace.byte(',');
                }
                first = false;
                if (category == 0) {
                    fact_emit_record(workspace, metadata, at);
                } else {
                    fact_emit_enum(workspace, metadata, at);
                }
            }
            at = at + 1 + fact_abi_member_count(metadata, row.category(), row.identity());
        }
        return workspace.ok();
    }
    auto fact_function_declaration(const EmitWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 callable) -> i64 {
        // Validated category-2 rows form a byte-name-sorted suffix with no
        // member rows. Earlier categories sort before every function key.
        i64 begin = 0;
        i64 end = workspace.abi_name_count();
        while (begin < end) {
            const i64 middle = begin + (end - begin) / 2;
            const AbiNameRow row = workspace.abi_name_at(middle);
            if (row.category() < 2) {
                begin = middle + 1;
            } else {
                if (fact_name_compare(workspace, metadata, 0, row.identity(), 0, callable) < 0) {
                    begin = middle + 1;
                } else {
                    end = middle;
                }
            }
        }
        if (begin < workspace.abi_name_count()) {
            const AbiNameRow row = workspace.abi_name_at(begin);
            if (row.category() == 2 && fact_name_compare(workspace, metadata, 0, row.identity(), 0, callable) == 0) {
                return begin;
            }
        }
        return -1;
    }
    auto fact_emit_bool(EmitWorkspace& workspace, bool value) -> bool {
        if (value) {
            return workspace.text("true");
        }
        return workspace.text("false");
    }
    auto fact_emit_abi_function(EmitWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 callable, i64 declaration) -> bool {
        const compiler_ir_metadata::CallableRow row = metadata.callable_at(callable);
        const i64 roots = row.borrowed_root_count();
        if (roots < 0 || roots > 3) {
            return workspace.fail();
        }
        fact_json_name(workspace, metadata, 0, callable);
        workspace.text(":{\"source_name\":");
        fact_json_name(workspace, metadata, 6, declaration);
        workspace.text(",\"receiver\":");
        const bool receiver = has_receiver(metadata, callable) && roots == 0;
        if (receiver) {
            fact_json_name(workspace, metadata, 3, receiver_class(metadata, callable));
        } else {
            workspace.text("null");
        }
        workspace.text(",\"receiver_mutable\":");
        if (receiver) {
            const compiler_ir_metadata::ReceiverShape shape = row.first_receiver();
            const compiler_ir_metadata::FlagMasks masks = compiler_ir_metadata::flag_masks();
            fact_emit_bool(workspace,(shape.attributes() & masks.receiver_mutable()) != 0u64);
        } else {
            workspace.text("null");
        }
        workspace.text(",\"borrowed_root_count\":");
        workspace.number(roots);
        workspace.text(",\"borrowed_roots\":[");
        i64 at = 0;
        while (at < roots) {
            if (at > 0) {
                workspace.byte(',');
            }
            workspace.text("{\"ordinal\":");
            workspace.number(at);
            workspace.text(",\"selector\":");
            workspace.number(-at);
            workspace.text(",\"type_name\":");
            fact_json_name(workspace, metadata, 5, row.borrowed_root_type(at));
            workspace.text(",\"mutable\":");
            fact_emit_bool(workspace, row.borrowed_root_mutable(at));
            workspace.byte('}');
            at = at + 1;
        }
        i64 payload = 0;
        if (roots > 1) {
            payload = roots * 8;
        }
        const i64 reserved =((payload + 15) / 16) * 16;
        const i64 saved =((roots * 8 + 15) / 16) * 16;
        workspace.text("],\"borrowed_root_abi\":{\"kind\":");
        if (roots == 0) {
            workspace.text("\"none\"");
        } else {
            if (roots == 1) {
                workspace.text("\"direct\"");
            } else {
                workspace.text("\"tuple\"");
            }
        }
        workspace.text(",\"register\":");
        if (roots > 0) {
            workspace.text("\"r10\"");
        } else {
            workspace.text("null");
        }
        workspace.text(",\"tuple_payload_bytes\":");
        workspace.number(payload);
        workspace.text(",\"tuple_reserved_bytes\":");
        workspace.number(reserved);
        workspace.text(",\"saved_root_reserved_bytes\":");
        workspace.number(saved);
        workspace.text("},\"parameter_bytes\":");
        workspace.number(record_offset(metadata, callable, parameter_count(metadata, callable)));
        workspace.text(",\"parameters\":[");
        at = 0;
        while (at < parameter_count(metadata, callable) && workspace.ok()) {
            if (at > 0) {
                workspace.byte(',');
            }
            const i64 type = parameter_type(metadata, callable, at);
            workspace.text("{\"offset\":");
            workspace.number(record_offset(metadata, callable, at));
            workspace.text(",\"bytes\":");
            workspace.number(argument_bytes(metadata, type));
            workspace.byte(',');
            fact_emit_type(workspace, metadata, type);
            workspace.byte('}');
            at = at + 1;
        }
        const i64 result = result_type(metadata, callable);
        workspace.text("],\"result\":{\"bytes\":");
        workspace.number(argument_bytes(metadata, result));
        workspace.byte(',');
        fact_emit_type(workspace, metadata, result);
        return workspace.text("}}");
    }
    auto emit_abi_facts(EmitWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata) -> EmitStatus {
        if (!workspace.begin_abi() || !fact_abi_names_valid(workspace, metadata)) {
            return workspace.status();
        }
        workspace.text("{\"version\":2,\"span_bytes\":56,\"records\":{");
        fact_emit_abi_groups(workspace, metadata, 0);
        workspace.text("},\"enums\":{");
        fact_emit_abi_groups(workspace, metadata, 1);
        workspace.text("},\"functions\":{");
        i64 at = 0;
        bool first = true;
        while (at < workspace.retained_count() && workspace.ok()) {
            const i64 callable = workspace.retained_at(at);
            const i64 declaration = fact_function_declaration(workspace, metadata, callable);
            if (declaration >= 0) {
                if (!first) {
                    workspace.byte(',');
                }
                first = false;
                fact_emit_abi_function(workspace, metadata, callable, declaration);
            }
            at = at + 1;
        }
        workspace.text("}}\n");
        workspace.finish_abi();
        return workspace.status();
    }
}
