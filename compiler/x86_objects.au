export module aurora.compiler.x86_objects;
import aurora.compiler.x86_storage;
import aurora.compiler.x86_object_storage;
import aurora.compiler.x86_helpers;
import aurora.compiler.ir_metadata;
import aurora.compiler.ir_metadata_storage;
import aurora.compiler.ir_instruction_storage;

// Calls and copied objects consume the same admitted durable rows as the other
// emitter families. No observation vector or native layout authority is rebuilt.
export namespace compiler_x86 {
    auto object_root_class(const compiler_ir_metadata::MetadataStore& metadata, i64 callable, i64 offset) -> i64 {
        if (offset == 0) {
            return receiver_class(metadata, callable);
        }
        return slot_class(metadata, callable, offset);
    }
    auto object_copy_record_words(EmitWorkspace& workspace, ObjectWorkspace& object, i64 source, i64 destination,
        i64 bytes) -> bool {
        if (bytes == 56) {
            // These fixed descriptor calls copy an admitted RBP-local slot to a
            // fresh, disjoint RSP argument record. Capture RSP before saving the
            // scalar argument registers, and retain all seven descriptor words.
            emit_lea(workspace, object, destination, Register::rax);
            emit_push_register(workspace, object, Register::rsi);
            emit_push_register(workspace, object, Register::rdi);
            emit_push_register(workspace, object, Register::rcx);
            workspace.grow_stack(24);
            emit_lea(workspace, object, source, Register::rsi);
            emit_mov_rr(workspace, object, Register::rax, Register::rdi);
            emit_mov_imm(workspace, object, bytes, Register::rcx);
            emit_cld(workspace, object);
            emit_rep_movsb(workspace, object);
            emit_pop_register(workspace, object, Register::rcx);
            emit_pop_register(workspace, object, Register::rdi);
            emit_pop_register(workspace, object, Register::rsi);
            workspace.shrink_stack(24);
            return workspace.ok();
        }
        i64 byte = 0;
        while (byte < bytes) {
            const i64 packed_address13 = workspace.advance_address(source, byte);
            emit_load(workspace, object, packed_address13, Register::rax, false);
            const i64 packed_address14 = workspace.advance_address(destination, byte);
            emit_store(workspace, object, Register::rax, packed_address14, false);
            byte = byte + 8;
        }
        return workspace.ok();
    }
    auto pack_arguments(EmitWorkspace& workspace, ObjectWorkspace& object,
        const compiler_ir_metadata::MetadataStore& metadata, const compiler_ir_instructions::InstructionStore& store,
        i64 instruction, i64 target) -> i64 {
        const compiler_ir_instructions::RawInstructionRow row = store.instruction_at(instruction);
        const i64 form = row.form();
        i64 object_field = 2;
        i64 span_field = 5;
        if (form == 20) {
            object_field = 1;
            span_field = 3;
        } else {
            if (form == 83) {
                span_field = 4;
            } else {
                if (form != 38) {
                    workspace.fail();
                    return 0;
                }
            }
        }
        const i64 count = parameter_count(metadata, target);
        i64 index = count;
        while (index > 0) {
            index = index - 1;
            const i64 type = parameter_type(metadata, target, index);
            const i64 kind = type_kind(metadata, type);
            if (kind != 5 && !span_kind(kind)) {
                emit_pop_argument(workspace, object, index);
            }
        }
        const i64 payload = record_offset(metadata, target, count);
        const i64 bytes =((payload + 15) / 16) * 16;
        if (bytes != 0) {
            emit_reserve_stack(workspace, object, bytes);
        }
        // Clear exact representation gaps before storing payload. Owner-bearing
        // parameters cannot enter this admitted copied-argument family.
        index = 0;
        while (index < count) {
            const i64 type = parameter_type(metadata, target, index);
            const i64 kind = type_kind(metadata, type);
            const i64 offset = record_offset(metadata, target, index);
            if (kind == 5) {
                const i64 class_id = type_class(metadata, type);
                const i64 packed_address15 = workspace.pack_address(1, offset);
                clear_padding(workspace, object, metadata, class_id, packed_address15);
            } else {
                if (!span_kind(kind)) {
                    i64 width = 8;
                    if (kind == 10) {
                        width = 1;
                    }
                    const i64 packed_address16 = workspace.pack_address(1, offset);
                    clear_bytes(workspace, object, width, 8, packed_address16);
                }
            }
            index = index + 1;
        }
        const i64 packed_address17 = workspace.pack_address(1, 0);
        clear_bytes(workspace, object, payload, bytes, packed_address17);
        index = 0;
        while (index < count) {
            const i64 type = parameter_type(metadata, target, index);
            const i64 kind = type_kind(metadata, type);
            const i64 offset = record_offset(metadata, target, index);
            if (span_kind(kind)) {
                const i64 source = operand_lane(store, instruction, span_field, index);
                const i64 packed_address18 = workspace.pack_address(0, source);
                const i64 packed_address19 = workspace.pack_address(1, offset);
                object_copy_record_words(workspace, object, packed_address18, packed_address19, 56);
            } else {
                if (kind == 5) {
                    const i64 class_id = type_class(metadata, type);
                    const i64 source = operand_lane(store, instruction, object_field, index);
                    const i64 packed_address20 = workspace.pack_address(0, source);
                    const i64 packed_address21 = workspace.pack_address(1, offset);
                    copy_class(workspace, object, metadata, class_id, packed_address20, packed_address21);
                } else {
                    const i64 packed_address22 = workspace.pack_address(1, offset);
                    store_argument(workspace, object, metadata, type, index, packed_address22);
                }
            }
            index = index + 1;
        }
        emit_mov_rr(workspace, object, Register::rsp, Register::r11);
        return bytes;
    }
    auto pack_service(EmitWorkspace& workspace, ObjectWorkspace& object,
        const compiler_ir_metadata::MetadataStore& metadata, const compiler_ir_instructions::InstructionStore& store,
        i64 instruction, i64 target) -> i64 {
        const i64 count = parameter_count(metadata, target);
        i64 index = count;
        while (index > 0) {
            index = index - 1;
            const i64 type = parameter_type(metadata, target, index);
            const i64 kind = type_kind(metadata, type);
            if (kind != 5 && kind != 11 && kind != 12 && !service_type_kind(kind)) {
                emit_pop_argument(workspace, object, index);
            }
        }
        const i64 payload = record_offset(metadata, target, count);
        const i64 bytes =((payload + 15) / 16) * 16;
        emit_reserve_stack(workspace, object, bytes);
        const i64 packed_address23 = workspace.pack_address(1, 0);
        // Every admitted payload is stored below before the call. Clear only
        // the record tail and representation gaps, never overwritten payload.
        clear_bytes(workspace, object, payload, bytes, packed_address23);
        index = 0;
        while (index < count) {
            const i64 type = parameter_type(metadata, target, index);
            const i64 kind = type_kind(metadata, type);
            const i64 offset = record_offset(metadata, target, index);
            if (service_type_kind(kind)) {
                i64 loan = operand_value(store, instruction, 1);
                if (index != 0) {
                    loan = operand_lane(store, instruction, 5,(index - 1) * 2);
                }
                const i64 source = workspace.loan_offset(loan);
                if (source <= 0) {
                    workspace.fail();
                    return bytes;
                }
                const i64 packed_address24 = workspace.pack_address(0, source);
                const i64 packed_address25 = workspace.pack_address(1, offset);
                object_copy_record_words(workspace, object, packed_address24, packed_address25, 16);
            } else {
                if (kind == 12) {
                    const i64 source = operand_value(store, instruction, 7);
                    const i64 address_token1 = workspace.pack_address(0, source);
                    emit_load(workspace, object, address_token1, Register::r10, false);
                    const i64 address_token2 = workspace.pack_address(1, offset);
                    emit_store(workspace, object, Register::r10, address_token2, false);
                } else {
                    if (kind == 11) {
                        const i64 source = operand_lane(store, instruction, 3, index);
                        const i64 packed_address26 = workspace.pack_address(0, source);
                        const i64 packed_address27 = workspace.pack_address(1, offset);
                        object_copy_record_words(workspace, object, packed_address26, packed_address27, 56);
                    } else {
                        if (kind == 5) {
                            const i64 class_id = type_class(metadata, type);
                            const i64 source = operand_lane(store, instruction, 6, index);
                            const i64 packed_address28 = workspace.pack_address(0, source);
                            const i64 packed_address29 = workspace.pack_address(1, offset);
                            clear_padding(workspace, object, metadata, class_id, packed_address29);
                            copy_class(workspace, object, metadata, class_id, packed_address28, packed_address29);
                        } else {
                            const i64 packed_address30 = workspace.pack_address(1, offset);
                            clear_bytes(workspace, object, storage_width(metadata, type), 8, packed_address30);
                            store_argument(workspace, object, metadata, type, index, packed_address30);
                        }
                    }
                }
            }
            index = index + 1;
        }
        emit_mov_rr(workspace, object, Register::rsp, Register::r11);
        return bytes;
    }
    auto emit_service_operation(EmitWorkspace& workspace, ObjectWorkspace& object,
        const compiler_ir_instructions::InstructionStore& store, i64 instruction) -> bool {
        const i64 offset = operand_value(store, instruction, 0);
        const i64 operation = operand_value(store, instruction, 1);
        const i64 result = operand_value(store, instruction, 2);
        const i64 address_token3 = workspace.pack_address(0, offset);
        emit_load(workspace, object, address_token3, Register::rdi, false);
        const i64 address_token4 = workspace.pack_address(0, offset - 8);
        emit_load(workspace, object, address_token4, Register::rsi, false);
        if (operation == 6) {
            emit_mov_rr(workspace, object, Register::rax, Register::rdx);
            const i64 runtime_symbol1 = workspace.intern_runtime("__au_runtime_port_read8");
            emit_call_runtime(workspace, object, runtime_symbol1);
            emit_service_completion(workspace, object, runtime_symbol1, 3, 255);
            return workspace.ok();
        }
        if (operation == 7) {
            emit_pop(workspace, object, Register::rcx);
            emit_pop(workspace, object, Register::rdx);
            const i64 runtime_symbol2 = workspace.intern_runtime("__au_runtime_port_write8");
            emit_call_runtime(workspace, object, runtime_symbol2);
            emit_service_completion(workspace, object, runtime_symbol2, 4, 0);
            return workspace.ok();
        }
        if (operation == 5 || operation == 8) {
            emit_mov_rr(workspace, object, Register::rax, Register::rdx);
            if (operation == 8) {
                const i64 runtime_symbol3 = workspace.intern_runtime("__au_runtime_serve_exchange");
                emit_call_runtime(workspace, object, runtime_symbol3);
                emit_service_completion(workspace, object, runtime_symbol3, 3, 1);
            } else {
                const i64 runtime_symbol4 = workspace.intern_runtime("__au_runtime_call");
                emit_call_runtime(workspace, object, runtime_symbol4);
                emit_service_completion(workspace, object, runtime_symbol4, 3, 2);
            }
            // The trap returns copied scalars only. Never pass the result address
            // to the kernel, and reject a nonzero value for every failure status.
            emit_alu_rr(workspace, object, AluOp::bit_xor, Register::rcx, Register::rcx);
            emit_alu_rr(workspace, object, AluOp::test, Register::rax, Register::rax);
            emit_set_condition(workspace, object, 5, Register::rcx);
            emit_unary(workspace, object, UnaryOp::negate, Register::rcx);
            emit_alu_rr(workspace, object, AluOp::bit_and, Register::rdx, Register::rcx);
            emit_branch(workspace, object, 5, 4, 0);
            const i64 address_token5 = workspace.pack_address(0, result);
            emit_store(workspace, object, Register::rax, address_token5, false);
            const i64 address_token6 = workspace.pack_address(0, result - 8);
            emit_store(workspace, object, Register::rdx, address_token6, false);
            return workspace.ok();
        }
        if (operation == 2) { // Pixel has a seventh host argument.
            emit_pop(workspace, object, Register::r10);
            emit_pop(workspace, object, Register::r9);
            emit_pop(workspace, object, Register::r8);
            emit_pop(workspace, object, Register::rcx);
            emit_pop(workspace, object, Register::rdx);
            i64 bytes = 16;
            const i64 depth = workspace.stack_depth();
            if (depth % 2 != 0) {
                bytes = 8;
            }
            emit_alu_imm(workspace, object, AluOp::subtract, bytes, Register::rsp);
            workspace.grow_stack(bytes);
            const i64 address_token7 = workspace.pack_address(1, 0);
            emit_store(workspace, object, Register::r10, address_token7, false);
            const i64 runtime_symbol5 = workspace.intern_runtime("__au_runtime_display_pixel");
            emit_direct_runtime(workspace, object, runtime_symbol5);
            emit_release_stack(workspace, object, bytes);
            emit_service_completion(workspace, object, runtime_symbol5, 7, 1);
        } else {
            if (operation == 1) {
                emit_mov_rr(workspace, object, Register::rax, Register::rdx);
                const i64 runtime_symbol7 = workspace.intern_runtime("__au_runtime_console_put");
                emit_call_runtime(workspace, object, runtime_symbol7);
                emit_service_completion(workspace, object, runtime_symbol7, 3, 1);
            } else {
                if (operation == 4) {
                    const i64 runtime_symbol8 = workspace.intern_runtime("__au_runtime_iommu_event_acknowledge");
                    emit_call_runtime(workspace, object, runtime_symbol8);
                    emit_service_completion(workspace, object, runtime_symbol8, 2, 2);
                } else {
                    if (operation == 3 || operation == 0) {
                        const i64 address_token8 = workspace.pack_address(0, result);
                        emit_lea(workspace, object, address_token8, Register::rdx);
                        i64 bytes = 24;
                        if (operation == 3) {
                            bytes = 32;
                        }
                        i64 byte = 0;
                        while (byte < bytes) {
                            const i64 address_token9 = workspace.pack_address(0, result - byte);
                            emit_store_imm(workspace, object, 0, address_token9, false);
                            byte = byte + 8;
                        }
                        // Every raw host channel is checked before any source
                        // field can observe the copied result.
                        if (operation == 3) {
                            const i64 runtime_symbol9 = workspace.intern_runtime("__au_runtime_iommu_event_poll");
                            emit_call_runtime(workspace, object, runtime_symbol9);
                            const i64 address_token10 = workspace.pack_address(0, result);
                            emit_alu_mem_imm(workspace, object, AluOp::compare, 3, address_token10);
                            emit_branch(workspace, object, 7, 4, 0);
                            const i64 address_token11 = workspace.pack_address(0, result - 24);
                            emit_alu_mem_imm(workspace, object, AluOp::compare, 31, address_token11);
                            emit_branch(workspace, object, 7, 4, 0);
                            emit_alu_rr(workspace, object, AluOp::bit_xor, Register::rax, Register::rax);
                            const i64 address_token12 = workspace.pack_address(0, result);
                            emit_alu_mem_imm(workspace, object, AluOp::compare, 1, address_token12);
                            emit_set_condition(workspace, object, 5, Register::rax);
                            emit_unary(workspace, object, UnaryOp::negate, Register::rax);
                            const i64 address_token13 = workspace.pack_address(0, result - 8);
                            emit_load(workspace, object, address_token13, Register::rcx, false);
                            const i64 address_token14 = workspace.pack_address(0, result - 16);
                            emit_alu_load(workspace, object, AluOp::bit_or, address_token14, Register::rcx);
                            emit_alu_rr(workspace, object, AluOp::bit_and, Register::rcx, Register::rax);
                            emit_branch(workspace, object, 5, 4, 0);
                        } else {
                            const i64 runtime_symbol10 = workspace.intern_runtime("__au_runtime_console_next");
                            emit_call_runtime(workspace, object, runtime_symbol10);
                            const i64 address_token15 = workspace.pack_address(0, result);
                            emit_alu_mem_imm(workspace, object, AluOp::compare, 1, address_token15);
                            emit_branch(workspace, object, 7, 4, 0);
                            const i64 address_token16 = workspace.pack_address(0, result - 8);
                            emit_alu_mem_imm(workspace, object, AluOp::compare, 255, address_token16);
                            emit_branch(workspace, object, 7, 4, 0);
                            const i64 address_token17 = workspace.pack_address(0, result - 16);
                            emit_alu_mem_imm(workspace, object, AluOp::compare, 1, address_token17);
                            emit_branch(workspace, object, 7, 4, 0);
                            const i64 address_token18 = workspace.pack_address(0, result);
                            emit_load(workspace, object, address_token18, Register::rax, false);
                            emit_unary(workspace, object, UnaryOp::negate, Register::rax);
                            emit_unary(workspace, object, UnaryOp::bit_not, Register::rax);
                            const i64 address_token19 = workspace.pack_address(0, result - 8);
                            emit_alu_load(workspace, object, AluOp::bit_and, address_token19, Register::rax);
                            emit_branch(workspace, object, 5, 4, 0);
                        }
                    } else {
                        workspace.fail();
                    }
                }
            }
        }
        return workspace.ok();
    }
    // A getter whose whole body is one receiver field load and its return costs a
    // frame, a receiver spill and a call per use. Return that load so the call
    // site can emit it directly; any other body shape keeps the real call.
    auto inline_getter_load(const compiler_ir_metadata::MetadataStore& metadata,
        const compiler_ir_instructions::InstructionStore& store, i64 target) -> i64 {
        if (!has_receiver(metadata, target) || parameter_count(metadata, target) != 0) {
            return -1;
        }
        const compiler_ir_metadata::CallableRow callable = metadata.callable_at(target);
        const compiler_ir_instructions::BodyRow body = store.body_at(target);
        if (callable.borrowed_root_count() != 0 || body.count() != 2) {
            return -1;
        }
        const compiler_ir_instructions::CodeRow first = store.code_at(body.begin());
        const compiler_ir_instructions::CodeRow second = store.code_at(body.begin() + 1);
        if (first.id() <= 0 || second.id() <= 0) {
            return -1;
        }
        const compiler_ir_instructions::RawInstructionRow load = store.instruction_at(first.id());
        const compiler_ir_instructions::RawInstructionRow done = store.instruction_at(second.id());
        if (load.form() != 32 || done.form() != 43) {
            return -1;
        }
        return first.id();
    }
    auto emit_object_calls(EmitWorkspace& workspace, ObjectWorkspace& object,
        const compiler_ir_metadata::MetadataStore& metadata, const compiler_ir_instructions::InstructionStore& store,
        i64 instruction) -> bool {
        const compiler_ir_instructions::RawInstructionRow row = store.instruction_at(instruction);
        const i64 form = row.form();
        if (form != 4 && form != 19 && form != 20 && form != 38 && form != 83) {
            return false;
        }
        const i64 target = instruction_target(metadata, store, instruction);
        if (target < 0) {
            workspace.fail();
            return true;
        }
        const i64 count = parameter_count(metadata, target);
        if (form == 19) {
            i64 index = count;
            while (index > 0) {
                index = index - 1;
                emit_pop_argument(workspace, object, index);
            }
            call_target(workspace, object, metadata, target);
            return true;
        }
        const i64 result_type_id = result_type(metadata, target);
        const i64 result_kind = type_kind(metadata, result_type_id);
        if (form == 20 || form == 4) {
            i64 bytes = 0;
            if (form == 20) {
                bytes = pack_arguments(workspace, object, metadata, store, instruction, target);
            } else {
                bytes = pack_service(workspace, object, metadata, store, instruction, target);
            }
            if (result_kind == 5) {
                const i64 result = operand_value(store, instruction, 2);
                const i64 address_token20 = workspace.pack_address(0, result);
                emit_lea(workspace, object, address_token20, Register::r10);
            }
            call_target(workspace, object, metadata, target);
            if (bytes != 0 || form == 4) {
                emit_release_stack(workspace, object, bytes);
            }
            return true;
        }
        const bool aggregate = class_parameters(metadata, target);
        i64 bytes = 0;
        if (aggregate) {
            bytes = pack_arguments(workspace, object, metadata, store, instruction, target);
        } else {
            i64 index = count;
            while (index > 0) {
                index = index - 1;
                emit_pop_argument(workspace, object, index);
            }
        }
        i64 root_bytes = 0;
        if (form == 83) {
            const compiler_ir_metadata::CallableRow callable = metadata.callable_at(target);
            const i64 roots = callable.borrowed_root_count();
            // Root lists contain (selector, loan, field) triples. Loans are
            // independently admitted; roots and fields select actual addresses.
            if (roots < 1 || roots > 4 || operand_count(store, instruction, 1) != roots * 3) {
                workspace.fail();
                return true;
            }
            if (roots > 1) {
                // Multi-root signatures admit scalar/enum tails and results
                // only. Keep all six scalar argument registers untouched.
                if (aggregate || result_kind == 5 || span_kind(result_kind)) {
                    workspace.fail();
                    return true;
                }
                root_bytes =((roots * 8 + 15) / 16) * 16;
                emit_reserve_stack(workspace, object, root_bytes);
                i64 ordinal = 0;
                while (ordinal < roots) {
                    const i64 root = operand_lane(store, instruction, 1, ordinal * 3);
                    receiver_address(workspace, object, metadata, root, Register::r10);
                    const i64 address_token21 = workspace.pack_address(1, ordinal * 8);
                    emit_store(workspace, object, Register::r10, address_token21, false);
                    ordinal = ordinal + 1;
                }
                const i64 address_token22 = workspace.pack_address(1, 0);
                emit_lea(workspace, object, address_token22, Register::r10);
            } else {
                const i64 root = operand_lane(store, instruction, 1, 0);
                const i64 field = operand_lane(store, instruction, 1, 2);
                if (type_kind(metadata, callable.borrowed_root_type(0)) == 17) {
                    const i64 descriptor = bytes_owner_address(workspace, object, metadata, root, field, 0);
                    emit_lea(workspace, object, descriptor, Register::r10);
                } else {
                    receiver_address(workspace, object, metadata, root, Register::r10);
                }
            }
        } else {
            const i64 root = operand_value(store, instruction, 1);
            const i64 field = operand_value(store, instruction, 4);
            receiver_address(workspace, object, metadata, root, Register::r10);
            if (field >= 0) {
                const i64 current = workspace.current_callable();
                const i64 class_id = object_root_class(metadata, current, root);
                const i64 offset = class_field_offset(metadata, class_id, field);
                if (offset != 0) {
                    emit_alu_imm(workspace, object, AluOp::add, offset, Register::r10);
                }
            }
        }
        if (result_kind == 5 || span_kind(result_kind)) {
            const i64 result = operand_value(store, instruction, 3);
            if (aggregate) {
                const i64 address_token23 = workspace.pack_address(0, result);
                emit_lea(workspace, object, address_token23, Register::rax);
            } else {
                const i64 address_token24 = workspace.pack_address(0, result);
                emit_lea(workspace, object, address_token24, Register::r11);
            }
        }
        i64 getter = -1;
        if (form == 38 && count == 0 && !aggregate && root_bytes == 0 && result_kind != 5 && !span_kind(result_kind)) {
            getter = inline_getter_load(metadata, store, target);
        }
        if (getter > 0) {
            // The receiver is already in %r10, exactly where the getter reloads it.
            const i64 field = operand_value(store, getter, 0);
            const i64 type = operand_value(store, getter, 1);
            const i64 offset = class_field_offset(metadata, receiver_class(metadata, target), field);
            const i64 address = workspace.pack_address(2, offset);
            load_value(workspace, object, metadata, type, address);
        } else {
            call_target(workspace, object, metadata, target);
        }
        if (root_bytes != 0) {
            emit_release_stack(workspace, object, root_bytes);
        }
        if (bytes != 0) {
            emit_release_stack(workspace, object, bytes);
        }
        return true;
    }
    auto emit_object_payload(EmitWorkspace& workspace, ObjectWorkspace& object,
        const compiler_ir_metadata::MetadataStore& metadata, const compiler_ir_instructions::InstructionStore& store,
        i64 instruction) -> bool {
        const compiler_ir_instructions::RawInstructionRow row = store.instruction_at(instruction);
        const i64 form = row.form();
        const i64 current = workspace.current_callable();
        if (form == 21 || form == 23) {
            const i64 offset = operand_value(store, instruction, 0);
            const i64 class_id = slot_class(metadata, current, offset);
            if (form == 21) {
                // An in-place element is never read from its own padding.
                if (workspace.loan_offset(0 - offset) <= 0) {
                    clear_object(workspace, object, metadata, offset, class_id);
                }
            } else {
                drop_object(workspace, object, metadata, offset, class_id);
            }
            return true;
        }
        if (form == 22) {
            // BeginObject already initialized canonical representation padding.
            return true;
        }
        if (form == 24) {
            const i64 source = operand_value(store, instruction, 0);
            const i64 destination = operand_value(store, instruction, 1);
            const i64 class_id = slot_class(metadata, current, source);
            const i64 packed_address31 = workspace.pack_address(0, source);
            const i64 packed_address32 = workspace.pack_address(0, destination);
            copy_class(workspace, object, metadata, class_id, packed_address31, packed_address32);
            return true;
        }
        if (form == 25) {
            const i64 source = operand_value(store, instruction, 0);
            const i64 field = operand_value(store, instruction, 1);
            const i64 destination = operand_value(store, instruction, 2);
            const i64 parent = object_root_class(metadata, current, source);
            const i64 type = class_field_type(metadata, parent, field);
            const i64 child = type_class(metadata, type);
            const i64 first = class_field_first(metadata, parent, field);
            const i64 count = class_field_length(metadata, parent, field);
            receiver_address(workspace, object, metadata, source, Register::r10);
            const i64 packed_address33 = workspace.pack_address(2, 0);
            const i64 packed_address34 = workspace.pack_address(0, destination);
            workspace.set_copy(packed_address33, packed_address34, first, 0);
            copy_leaves(workspace, object, metadata, parent, child, count);
            return true;
        }
        if (form == 26 || form == 27) {
            i64 root = operand_value(store, instruction, 0);
            if (form == 27) {
                root = 0;
            }
            const i64 field = operand_value(store, instruction, 1);
            const i64 source = operand_value(store, instruction, 2);
            const i64 parent = object_root_class(metadata, current, root);
            const i64 type = class_field_type(metadata, parent, field);
            const i64 child = type_class(metadata, type);
            const i64 first = class_field_first(metadata, parent, field);
            const i64 count = class_field_length(metadata, parent, field);
            receiver_address(workspace, object, metadata, root, Register::r10);
            const i64 packed_address35 = workspace.pack_address(0, source);
            const i64 packed_address36 = workspace.pack_address(2, 0);
            workspace.set_copy(packed_address35, packed_address36, 0, first);
            copy_leaves(workspace, object, metadata, child, parent, count);
            return true;
        }
        if (form == 28) {
            const i64 root = operand_value(store, instruction, 0);
            const i64 field = operand_value(store, instruction, 1);
            const i64 parent = object_root_class(metadata, current, root);
            const i64 type = class_field_type(metadata, parent, field);
            const i64 child = type_class(metadata, type);
            const i64 first = class_field_first(metadata, parent, field);
            const i64 count = class_leaf_count(metadata, child);
            const i64 elements = operand_count(store, instruction, 2);
            receiver_address(workspace, object, metadata, root, Register::r10);
            i64 element = 0;
            while (element < elements) {
                const i64 source = operand_lane(store, instruction, 2, element);
                const i64 packed_address37 = workspace.pack_address(0, source);
                const i64 packed_address38 = workspace.pack_address(2, 0);
                workspace.set_copy(packed_address37, packed_address38, 0, first + element * count);
                copy_leaves(workspace, object, metadata, child, parent, count);
                element = element + 1;
            }
            return true;
        }
        if (form == 29 || form == 30 || form == 31) {
            const i64 root = operand_value(store, instruction, 0);
            const i64 field = operand_value(store, instruction, 1);
            const i64 parent = object_root_class(metadata, current, root);
            if (form == 29) {
                const i64 count = class_field_elements(metadata, parent, field);
                emit_alu_imm(workspace, object, AluOp::compare, count, Register::rax);
                emit_branch(workspace, object, 3, 4, 0);
                return true;
            }
            const i64 type = class_field_type(metadata, parent, field);
            const i64 child = type_class(metadata, type);
            i64 stride = 0;
            if (class_leaf_count(metadata, child) != 0) {
                stride = class_size(metadata, child);
            }
            emit_alu_imm(workspace, object, AluOp::multiply, stride, Register::rax);
            receiver_address(workspace, object, metadata, root, Register::r10);
            const i64 field_offset = class_field_offset(metadata, parent, field);
            emit_indexed_lea(workspace, object, Register::r10, Register::rax, field_offset, Register::r10);
            const i64 local = operand_value(store, instruction, 2);
            if (form == 30) {
                const i64 packed_address39 = workspace.pack_address(2, 0);
                const i64 packed_address40 = workspace.pack_address(0, local);
                copy_class(workspace, object, metadata, child, packed_address39, packed_address40);
            } else {
                const i64 packed_address41 = workspace.pack_address(0, local);
                const i64 packed_address42 = workspace.pack_address(2, 0);
                copy_class(workspace, object, metadata, child, packed_address41, packed_address42);
            }
            return true;
        }
        if (form == 44) {
            const i64 save = workspace.result_save();
            const i64 source = operand_value(store, instruction, 0);
            const i64 result = result_type(metadata, current);
            const i64 class_id = type_class(metadata, result);
            const i64 address_token25 = workspace.pack_address(0, save);
            emit_load(workspace, object, address_token25, Register::r10, false);
            const i64 packed_address43 = workspace.pack_address(0, source);
            const i64 packed_address44 = workspace.pack_address(2, 0);
            copy_class(workspace, object, metadata, class_id, packed_address43, packed_address44);
            emit_alu_rr(workspace, object, AluOp::bit_xor, Register::rax, Register::rax);
            emit_branch(workspace, object, -1, 1, 0);
            return true;
        }
        return false;
    }
    auto emit_receiver_payload(EmitWorkspace& workspace, ObjectWorkspace& object,
        const compiler_ir_metadata::MetadataStore& metadata, const compiler_ir_instructions::InstructionStore& store,
        i64 instruction) -> bool {
        const compiler_ir_instructions::RawInstructionRow row = store.instruction_at(instruction);
        const i64 form = row.form();
        if (form < 32 || form > 37) {
            return false;
        }
        const i64 current = workspace.current_callable();
        const i64 class_id = receiver_class(metadata, current);
        const i64 field = operand_value(store, instruction, 0);
        const i64 save = workspace.receiver_save();
        const i64 field_offset = class_field_offset(metadata, class_id, field);
        if (form == 35) {
            const i64 count = class_field_length(metadata, class_id, field);
            emit_alu_imm(workspace, object, AluOp::compare, count, Register::rax);
            emit_branch(workspace, object, 3, 4, 0);
            return true;
        }
        if (form == 32 || form == 33) {
            const i64 type = operand_value(store, instruction, 1);
            const i64 address_token26 = workspace.pack_address(0, save);
            emit_load(workspace, object, address_token26, Register::r10, false);
            if (form == 32) {
                const i64 packed_address45 = workspace.pack_address(2, field_offset);
                load_value(workspace, object, metadata, type, packed_address45);
            } else {
                const i64 packed_address46 = workspace.pack_address(2, field_offset);
                store_value(workspace, object, metadata, type, packed_address46);
            }
            return true;
        }
        const i64 type = class_field_type(metadata, class_id, field);
        const i64 kind = type_kind(metadata, type);
        if (form == 34) {
            const i64 first = class_field_first(metadata, class_id, field);
            const i64 count = class_field_length(metadata, class_id, field);
            const i64 address_token27 = workspace.pack_address(0, save);
            emit_load(workspace, object, address_token27, Register::r10, false);
            i64 element = 0;
            while (element < count) {
                const i64 offset = class_leaf_offset(metadata, class_id, first + element);
                if (kind == 10) {
                    const i64 address_token28 = workspace.pack_address(2, offset);
                    emit_store_imm(workspace, object, 0, address_token28, true);
                } else {
                    const i64 address_token29 = workspace.pack_address(2, offset);
                    emit_store_imm(workspace, object, 0, address_token29, false);
                }
                element = element + 1;
            }
            return true;
        }
        i64 width = 8;
        if (kind == 10) {
            width = 1;
        }
        if (form == 37) {
            emit_pop(workspace, object, Register::rcx);
        }
        const i64 address_token30 = workspace.pack_address(0, save);
        emit_load(workspace, object, address_token30, Register::r10, false);
        if (form == 36) {
            if (kind == 10) {
                emit_indexed_load(workspace, object, Register::r10, Register::rax, indexed_address(width, field_offset),
                    true);
            } else {
                emit_indexed_load(workspace, object, Register::r10, Register::rax, indexed_address(width, field_offset),
                    false);
            }
        } else {
            if (kind == 10) {
                emit_indexed_store(workspace, object, Register::r10, Register::rcx, indexed_address(width,
                    field_offset), true);
            } else {
                emit_indexed_store(workspace, object, Register::r10, Register::rcx, indexed_address(width,
                    field_offset), false);
            }
        }
        return true;
    }
    auto emit_objects(EmitWorkspace& workspace, ObjectWorkspace& object,
        const compiler_ir_metadata::MetadataStore& metadata, const compiler_ir_instructions::InstructionStore& store,
        i64 instruction) -> bool {
        const compiler_ir_instructions::RawInstructionRow row = store.instruction_at(instruction);
        const i64 form = row.form();
        if (form == 1 || form == 2 || form == 81 || form == 82) {
            // Provenance and loan lifetime are verified before emission. The
            // service loan-to-frame map is prepared over the whole retained body.
            return true;
        }
        if (form == 3) {
            emit_service_operation(workspace, object, store, instruction);
            return true;
        }
        if (form == 0 || form == 45 || form == 46) {
            const i64 current = workspace.current_callable();
            const i64 index = operand_value(store, instruction, 0);
            const i64 destination = operand_value(store, instruction, 1);
            const i64 save = workspace.call_record_save();
            const i64 source = record_offset(metadata, current, index);
            if (form == 0) {
                const i64 address_token31 = workspace.pack_address(0, save);
                emit_load(workspace, object, address_token31, Register::r11, false);
                const i64 packed_address47 = workspace.pack_address(3, source);
                const i64 packed_address48 = workspace.pack_address(0, destination);
                object_copy_record_words(workspace, object, packed_address47, packed_address48, 16);
                return true;
            }
            if (form == 45) {
                const i64 type = operand_value(store, instruction, 2);
                if (save != 0) {
                    const i64 address_token32 = workspace.pack_address(0, save);
                    emit_load(workspace, object, address_token32, Register::r11, false);
                    const i64 packed_address49 = workspace.pack_address(3, source);
                    load_value(workspace, object, metadata, type, packed_address49);
                    const i64 packed_address50 = workspace.pack_address(0, destination);
                    store_value(workspace, object, metadata, type, packed_address50);
                } else {
                    const i64 packed_address51 = workspace.pack_address(0, destination);
                    store_argument(workspace, object, metadata, type, index, packed_address51);
                }
                return true;
            }
            const i64 type = parameter_type(metadata, current, index);
            const i64 class_id = type_class(metadata, type);
            const i64 address_token33 = workspace.pack_address(0, save);
            emit_load(workspace, object, address_token33, Register::r11, false);
            clear_object(workspace, object, metadata, destination, class_id);
            const i64 packed_address52 = workspace.pack_address(3, source);
            const i64 packed_address53 = workspace.pack_address(0, destination);
            copy_class(workspace, object, metadata, class_id, packed_address52, packed_address53);
            return true;
        }
        if (emit_object_calls(workspace, object, metadata, store, instruction)) {
            return true;
        }
        if (emit_object_payload(workspace, object, metadata, store, instruction)) {
            return true;
        }
        return emit_receiver_payload(workspace, object, metadata, store, instruction);
    }
}
