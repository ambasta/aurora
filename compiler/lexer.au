export module aurora.compiler.lexer;

// This module only observes a synchronous readonly span and returns copied
// coordinates. The hosted bootstrap adapter is the sole foreign input boundary.
export namespace compiler_lexer {
    // Authoritative private wire order; the build generates the host enum entries.
    // The generated-code fixture checks every case against that host mapping.
    enum class Event {
        token,
        whitespace,
        line_comment,
        end_of_input,
        unsupported_character,
        invalid_byte,
        invalid_string,
        invalid_cursor
    };

    class Cursor {
        i64 offset;
        i64 line;
        i64 line_start;
    public:
        Cursor(i64 at, i64 row, i64 start) : offset(at), line(row), line_start(start) {
        }
        auto at() const -> i64 {
            return offset;
        }
        auto row() const -> i64 {
            return line;
        }
        auto start() const -> i64 {
            return line_start;
        }
    };

    class Lexeme {
        Event event;
        i64 offset;
        i64 line;
        i64 line_start;
    public:
        Lexeme(Event kind, i64 at, i64 row, i64 start) : event(kind), offset(at), line(row), line_start(start) {
        }
        auto kind() const -> Event {
            return event;
        }
        auto next_offset() const -> i64 {
            return offset;
        }
        auto next_line() const -> i64 {
            return line;
        }
        auto next_line_start() const -> i64 {
            return line_start;
        }
    };

    auto space(u8 byte) -> bool {
        return byte == ' ' || (byte >= '\t' && byte <= '\r');
    }
    auto letter(u8 byte) -> bool {
        return (byte >= 'A' && byte <= 'Z') || (byte >= 'a' && byte <= 'z') || byte == '_';
    }
    auto digit(u8 byte) -> bool {
        return byte >= '0' && byte <= '9';
    }
    auto word(u8 byte) -> bool {
        return letter(byte) || digit(byte);
    }
    auto hex(u8 byte) -> bool {
        return digit(byte) || (byte >= 'a' && byte <= 'f') || (byte >= 'A' && byte <= 'F');
    }
    auto escape(u8 byte) -> bool {
        return byte == '\'' || byte == '\\' || byte == '0' || byte == 'a' || byte == 'b' || byte == 'f' || byte == 'n'
            || byte == 'r' || byte == 't' || byte == 'v';
    }
    auto punctuation(u8 byte) -> bool {
        return byte == '(' || byte == ')' || byte == '{' || byte == '}' || byte == '[' || byte == ']' || byte == ':'
            || byte == ';' || byte == ',' || byte == '=' || byte == '+' || byte == '-' || byte == '*' || byte == '/'
            || byte == '%' || byte == '<' || byte == '>' || byte == '!' || byte == '.' || byte == '&' || byte == '|'
            || byte == '^' || byte == '~';
    }
    auto pair(u8 first, u8 second) -> bool {
        return (first == '-' && second == '>') || (first == '=' && second == '=') || (first == '!' && second == '=')
            || (first == '<' && second == '=') || (first == '>' && second == '=') || (first == ':' && second == ':')
            || (first == '<' && second == '<') || (first == '>' && second == '>') || (first == '&' && second == '&')
            || (first == '|' && second == '|');
    }
    auto valid_byte(builtin::span<const u8> source, i64 begin, i64 end) -> bool {
        const i64 count = end - begin;
        if (count == 3) {
            const u8 value = source.at(begin + 1);
            return value >= ' ' && value <= '~' && value != '\'' && value != '\\';
        }
        if (count != 4 && count != 6) {
            return false;
        }
        if (source.at(begin + 1) != '\\') {
            return false;
        }
        if (count == 4) {
            return escape(source.at(begin + 2));
        }
        return source.at(begin + 2) == 'x' && hex(source.at(begin + 3)) && hex(source.at(begin + 4));
    }
    auto valid_string(builtin::span<const u8> source, i64 begin, i64 end) -> bool {
        i64 at = begin + 1;
        const i64 limit = end - 1;
        i64 decoded = 0;
        while (at < limit) {
            const u8 first = source.at(at);
            if (first == '\\') {
                if (limit - at < 2) {
                    return false;
                }
                const u8 next = source.at(at + 1);
                if (next == 'x') {
                    if (limit - at < 4) {
                        return false;
                    }
                    if (!hex(source.at(at + 2)) || !hex(source.at(at + 3))) {
                        return false;
                    }
                    at = at + 4;
                } else {
                    if (next != '"' && !escape(next)) {
                        return false;
                    }
                    at = at + 2;
                }
                decoded = decoded + 1;
            } else {
                if (first < 128u8) {
                    if (first < ' ' || first == 127u8 || first == '"') {
                        return false;
                    }
                    at = at + 1;
                    decoded = decoded + 1;
                } else {
                    i64 width = 0;
                    if (first >= 194u8 && first <= 223u8) {
                        width = 2;
                    }
                    if (first >= 224u8 && first <= 239u8) {
                        width = 3;
                    }
                    if (first >= 240u8 && first <= 244u8) {
                        width = 4;
                    }
                    if (width == 0 || width > limit - at) {
                        return false;
                    }
                    const u8 second = source.at(at + 1);
                    if (second < 128u8 || second > 191u8) {
                        return false;
                    }
                    // Exclude overlong encodings, surrogates, and scalars above U+10FFFF.
                    if (first == 224u8 && second < 160u8) {
                        return false;
                    }
                    if (first == 237u8 && second > 159u8) {
                        return false;
                    }
                    if (first == 240u8 && second < 144u8) {
                        return false;
                    }
                    if (first == 244u8 && second > 143u8) {
                        return false;
                    }
                    i64 index = 2;
                    while (index < width) {
                        const u8 next = source.at(at + index);
                        if (next < 128u8 || next > 191u8) {
                            return false;
                        }
                        index = index + 1;
                    }
                    at = at + width;
                    decoded = decoded + width;
                }
            }
            if (decoded > 4096) {
                return false;
            }
        }
        return true;
    }

    auto next_lexeme(builtin::span<const u8> source, Cursor cursor) -> Lexeme {
        const i64 count = source.size();
        i64 index = cursor.at();
        i64 line = cursor.row();
        i64 start = cursor.start();
        // The existing host SourcePosition uses signed 32-bit line/column values.
        // Keep every coordinate plus one representable, including at EOF.
        if (count > 2147483646 || index < 0 || index > count || start < 0 || start > index || line < 1 || line > start
            + 1 || (line == 1 && start != 0)) {
            const Lexeme result = Lexeme(Event::invalid_cursor, index, line, start);
            return result;
        }
        if (index == count) {
            const Lexeme result = Lexeme(Event::end_of_input, index, line, start);
            return result;
        }
        const i64 begin = index;
        const u8 first = source.at(index);
        if (space(first)) {
            while (index < count && space(source.at(index))) {
                if (source.at(index) == '\n') {
                    line = line + 1;
                    start = index + 1;
                }
                index = index + 1;
            }
            const Lexeme result = Lexeme(Event::whitespace, index, line, start);
            return result;
        }
        if (first == '/' && count - index >= 2 && source.at(index + 1) == '/') {
            index = index + 2;
            while (index < count && source.at(index) != '\n') {
                index = index + 1;
            }
            const Lexeme result = Lexeme(Event::line_comment, index, line, start);
            return result;
        }
        if (first == '\'' || first == '"') {
            index = index + 1;
            bool closed = false;
            while (index < count && !closed && source.at(index) != '\n' && source.at(index) != '\r') {
                const u8 current = source.at(index);
                index = index + 1;
                if (current == first) {
                    closed = true;
                }
                if (current == '\\' && index < count && source.at(index) != '\n' && source.at(index) != '\r') {
                    index = index + 1;
                }
            }
            const i64 quote_end = index;
            // An attempted suffix belongs to the entire invalid literal span.
            while (closed && index < count && word(source.at(index))) {
                index = index + 1;
            }
            Event kind = Event::token;
            if (first == '\'') {
                if (!closed || index != quote_end || !valid_byte(source, begin, quote_end)) {
                    kind = Event::invalid_byte;
                }
            } else {
                if (!closed || index != quote_end || !valid_string(source, begin, quote_end)) {
                    kind = Event::invalid_string;
                }
            }
            const Lexeme result = Lexeme(kind, index, line, start);
            return result;
        }
        if (letter(first) || digit(first)) {
            const bool binary = first == '0' && count - index >= 2 && (source.at(index + 1) == 'b' || source.at(index
                + 1) == 'B');
            index = index + 1;
            while (index < count && (word(source.at(index)) || (binary && source.at(index) == '\''))) {
                index = index + 1;
            }
            const Lexeme result = Lexeme(Event::token, index, line, start);
            return result;
        }
        if (count - index >= 2 && pair(first, source.at(index + 1))) {
            const Lexeme result = Lexeme(Event::token, index + 2, line, start);
            return result;
        }
        Event kind = Event::unsupported_character;
        if (punctuation(first)) {
            kind = Event::token;
        }
        const Lexeme result = Lexeme(kind, index + 1, line, start);
        return result;
    }
}
