export module aurora.compiler.resolution_names;
import aurora.compiler.lexer;
import aurora.compiler.resolution_kinds;
import aurora.compiler.resolution_rows;
import aurora.compiler.resolution_arena;
import aurora.compiler.syntax_arena;
import aurora.compiler.lowering_kinds;
import aurora.compiler.lowering_errors;
import aurora.compiler.lowering_storage;

// Source names, atoms, prefixes and import bindings over one Session. Each
// helper uses only Session's checked rows and index, so a failed read or
// write latches the Session exactly as before.
export namespace compiler_resolver {
    auto name_range(Session& session, i64 first, i64 last) -> i64 {
        if (first == last) {
            return first;
        }
        const MetaRow begin = session.meta(first);
        const MetaRow end = session.meta(last);
        if (begin.kind() != MetaTag::source_reference || end.kind() != MetaTag::source_reference || begin.word(0)
            != end.word(0) || begin.word(9) != end.word(9) || begin.word(1) < 0 || end.word(2) < begin.word(2)
            || end.word(2) > session.source_size()) {
            return session.fail_storage(StorageStatus::invalid);
        }
        const i64 existing = session.index(7, first, last, 0, 0);
        if (existing >= 0 || !session.good()) {
            return existing;
        }
        MetaRow combined = begin;
        combined.set_word(2, end.word(2));
        combined.set_word(7, end.word(7));
        combined.set_word(8, end.word(8));
        const i64 result = session.append_meta(combined);
        if (result < 0) {
            return -1;
        }
        return session.index_insert(7, first, last, 0, 0, result);
    }
    // The half-0 reference ingest made for a token ordinal of a module, or -1.
    // Ingest publishes each module's references as one range sorted by ordinal
    // and half, bounded by index keys (9, module, -1) and (9, module, -2).
    auto ingested_reference(Session& session, i64 module_id, i64 ordinal) -> i64 {
        if (module_id < 0 || ordinal < 0) {
            return -1;
        }
        const i64 first = session.index(9, module_id, -1, 0, 0);
        const i64 last = session.index(9, module_id, -2, 0, 0);
        if (first < 0 || last < first || !session.good()) {
            return -1;
        }
        // Lower bound of the ordinal; its half 0, when made, precedes half 1.
        i64 begin = first;
        i64 end = last;
        while (begin < end && session.good()) {
            const i64 middle = begin + (end - begin) / 2;
            const MetaRow row = session.meta(middle);
            if (row.kind() != MetaTag::source_reference || row.word(0) != module_id) {
                return session.fail_storage(StorageStatus::invalid);
            }
            if (row.word(5) < ordinal) {
                begin = middle + 1;
            } else {
                end = middle;
            }
        }
        if (!session.good() || begin >= last) {
            return -1;
        }
        const MetaRow found = session.meta(begin);
        if (found.word(5) != ordinal || found.word(6) != 0) {
            return -1;
        }
        return begin;
    }
    auto component_ref(Session& session, MetaRow base, WorkRow location) -> i64 {
        const i64 begin = location.word(0);
        const i64 end = location.word(1);
        const i64 line = location.word(2);
        const i64 start = location.word(3);
        if (base.kind() != MetaTag::source_reference || begin < 0 || end <= begin || end > base.word(2) - base.word(1)
            || line < 1 || start < 0 || start > begin) {
            return session.fail_storage(StorageStatus::invalid);
        }
        const i64 ordinal = base.word(5) + location.word(4);
        i64 existing = -1;
        if (base.word(9) == 0) {
            existing = ingested_reference(session, base.word(0), ordinal);
        }
        if (existing < 0 && session.good()) {
            existing = session.index(9, base.word(0), ordinal, 0, base.word(9));
        }
        if (existing >= 0 || !session.good()) {
            return existing;
        }
        MetaRow row = MetaRow(MetaTag::source_reference);
        i64 column = begin - start + 1;
        if (line == 1) {
            column = column + base.word(4) - 1;
        }
        row.set_word(0, base.word(0));
        row.set_word(1, base.word(1) + begin);
        row.set_word(2, base.word(1) + end);
        row.set_word(3, base.word(3) + line - 1);
        row.set_word(4, column);
        row.set_word(5, ordinal);
        row.set_word(6, 0);
        row.set_word(7, base.word(3) + line - 1);
        row.set_word(8, column + end - begin);
        row.set_word(9, base.word(9));
        const i64 result = session.append_meta(row);
        if (result < 0) {
            return -1;
        }
        return session.index_insert(9, base.word(0), ordinal, 0, base.word(9), result);
    }
    auto intern_atom(Session& session, i64 reference) -> i64 {
        const MetaRow source = session.meta(reference);
        if (source.kind() != MetaTag::source_reference || source.word(1) < 0 || source.word(2) <= source.word(1)
            || source.word(2) > session.source_size()) {
            return session.fail_storage(StorageStatus::invalid);
        }
        const i64 begin = source.word(1);
        const i64 count = source.word(2) - begin;
        const i64 existing = session.index(1, begin, count, 0, 0);
        if (existing >= 0 || !session.good()) {
            return existing;
        }
        MetaRow atom = MetaRow(MetaTag::atom);
        atom.set_word(0, begin);
        atom.set_word(1, count);
        atom.set_word(2, reference);
        const i64 result = session.append_meta(atom);
        if (result < 0) {
            return -1;
        }
        return session.index_insert(1, begin, count, 0, 0, result);
    }
    auto atom_source(Session& session, i64 atom) -> i64 {
        const MetaRow row = session.meta(atom);
        if (row.kind() != MetaTag::atom) {
            return session.fail_storage(StorageStatus::invalid);
        }
        return row.word(2);
    }
    auto intern_prefix(Session& session, i64 parent, i64 atom) -> i64 {
        const MetaRow leaf = session.meta(atom);
        if (leaf.kind() != MetaTag::atom || parent < -1) {
            return session.fail_storage(StorageStatus::invalid);
        }
        i64 depth = 1;
        if (parent >= 0) {
            const MetaRow prefix = session.meta(parent);
            if (prefix.kind() != MetaTag::prefix || prefix.word(2) < 1 || prefix.word(2) == 9223372036854775807) {
                return session.fail_storage(StorageStatus::invalid);
            }
            depth = prefix.word(2) + 1;
        }
        const i64 existing = session.index(2, parent, atom, 0, 0);
        if (existing >= 0 || !session.good()) {
            return existing;
        }
        MetaRow row = MetaRow(MetaTag::prefix);
        row.set_word(0, parent);
        row.set_word(1, atom);
        row.set_word(2, depth);
        const i64 result = session.append_meta(row);
        if (result < 0) {
            return -1;
        }
        return session.index_insert(2, parent, atom, 0, 0, result);
    }
    auto source_name(Session& session, i64 reference) -> i64 {
        const i64 cached = session.index(6, reference, 0, 0, 0);
        if (cached >= 0 || !session.good()) {
            return cached;
        }
        const MetaRow source = session.meta(reference);
        if (source.kind() != MetaTag::source_reference || source.word(1) < 0 || source.word(2) <= source.word(1)
            || source.word(2) > session.source_size()) {
            return session.fail_storage(StorageStatus::invalid);
        }
        const i64 count = source.word(2) - source.word(1);
        i64 offset = 0;
        i64 line = 1;
        i64 start = 0;
        i64 ordinal = 0;
        i64 prefix = -1;
        bool identifier = true;
        bool done = false;
        while (!done && session.good()) {
            const compiler_lexer::Cursor cursor = compiler_lexer::Cursor(offset, line, start);
            const compiler_lexer::Lexeme token = session.scan_range(source.word(1), count, cursor);
            if (token.kind() == compiler_lexer::Event::end_of_input) {
                done = true;
            } else {
                if (token.kind() == compiler_lexer::Event::token) {
                    const i64 length = token.next_offset() - offset;
                    if (identifier) {
                        if (length < 1 || !compiler_lexer::letter(session.source_byte(source.word(1) + offset))) {
                            return session.fail_storage(StorageStatus::invalid);
                        }
                        i64 at = offset + 1;
                        while (at < token.next_offset()) {
                            if (!compiler_lexer::word(session.source_byte(source.word(1) + at))) {
                                return session.fail_storage(StorageStatus::invalid);
                            }
                            at = at + 1;
                        }
                        i64 part = reference;
                        if (offset != 0 || token.next_offset() != count) {
                            const WorkRow position = WorkRow(offset, token.next_offset(), line, start, ordinal, 0);
                            part = component_ref(session, source, position);
                        }
                        if (!session.good()) {
                            return -1;
                        }
                        const i64 atom = intern_atom(session, part);
                        if (atom < 0) {
                            return -1;
                        }
                        prefix = intern_prefix(session, prefix, atom);
                        identifier = false;
                    } else {
                        const u8 first = session.source_byte(source.word(1) + offset);
                        if (!((length == 1 && first == '.') || (length == 2 && first == ':'
                            && session.source_byte(source.word(1) + offset + 1) == ':'))) {
                            return session.fail_storage(StorageStatus::invalid);
                        }
                        identifier = true;
                    }
                    ordinal = ordinal + 1;
                } else {
                    if (token.kind() != compiler_lexer::Event::whitespace && token.kind()
                        != compiler_lexer::Event::line_comment) {
                        return session.fail_storage(StorageStatus::invalid);
                    }
                }
                if (token.next_offset() <= offset || token.next_offset() > count) {
                    return session.fail_storage(StorageStatus::invalid);
                }
                offset = token.next_offset();
                line = token.next_line();
                start = token.next_line_start();
            }
        }
        if (!session.good()) {
            return -1;
        }
        if (identifier || prefix < 0) {
            return session.fail_storage(StorageStatus::invalid);
        }
        return session.index_insert(6, reference, 0, 0, 0, prefix);
    }
    auto source_name_range(Session& session, i64 first, i64 last) -> i64 {
        if (first < 0) {
            return -1;
        }
        if (last < 0 || last == first) {
            return source_name(session, first);
        }
        const i64 reference = name_range(session, first, last);
        return source_name(session, reference);
    }
    auto prefix_parent(Session& session, i64 prefix) -> i64 {
        if (prefix == -1) {
            return -1;
        }
        const MetaRow row = session.meta(prefix);
        if (row.kind() != MetaTag::prefix) {
            return session.fail_storage(StorageStatus::invalid);
        }
        return row.word(0);
    }
    auto name_atom(Session& session, i64 prefix) -> i64 {
        const MetaRow row = session.meta(prefix);
        if (row.kind() != MetaTag::prefix) {
            return session.fail_storage(StorageStatus::invalid);
        }
        return row.word(1);
    }
    auto prefix_join(Session& session, i64 scope, i64 name) -> i64 {
        if (name < -1 || scope < -1) {
            return session.fail_storage(StorageStatus::invalid);
        }
        if (name >= 0) {
            const MetaRow named = session.meta(name);
            if (named.kind() != MetaTag::prefix) {
                return session.fail_storage(StorageStatus::invalid);
            }
        }
        if (scope >= 0) {
            const MetaRow parent = session.meta(scope);
            if (parent.kind() != MetaTag::prefix) {
                return session.fail_storage(StorageStatus::invalid);
            }
        }
        if (name == -1) {
            return scope;
        }
        if (scope == -1) {
            return name;
        }
        const i64 base = session.work_count();
        i64 part = name;
        i64 steps = 0;
        while (part >= 0 && session.good()) {
            if (steps >= session.meta_count()) {
                session.truncate_work(base);
                return session.fail_storage(StorageStatus::invalid);
            }
            steps = steps + 1;
            const MetaRow row = session.meta(part);
            if (row.kind() != MetaTag::prefix) {
                session.truncate_work(base);
                return session.fail_storage(StorageStatus::invalid);
            }
            const WorkRow item = WorkRow(row.word(1), -1, -1, -1, -1, -1);
            if (session.append_work(item) < 0) {
                session.truncate_work(base);
                return -1;
            }
            part = row.word(0);
        }
        i64 result = scope;
        i64 at = session.work_count();
        while (at > base && session.good()) {
            at = at - 1;
            const WorkRow item = session.work(at);
            result = intern_prefix(session, result, item.word(0));
        }
        session.truncate_work(base);
        return result;
    }
    auto prefix_compare(Session& session, i64 first, i64 second) -> i64 {
        if (first == second) {
            return 0;
        }
        const i64 base = session.work_count();
        i64 part = first;
        i64 steps = 0;
        while (part >= 0 && session.good()) {
            if (steps >= session.meta_count()) {
                session.truncate_work(base);
                return session.fail_storage(StorageStatus::invalid);
            }
            steps = steps + 1;
            const MetaRow row = session.meta(part);
            if (row.kind() != MetaTag::prefix) {
                session.truncate_work(base);
                return session.fail_storage(StorageStatus::invalid);
            }
            const WorkRow item = WorkRow(row.word(1), -1, -1, -1, -1, -1);
            if (session.append_work(item) < 0) {
                session.truncate_work(base);
                return 0;
            }
            part = row.word(0);
        }
        const i64 middle = session.work_count();
        part = second;
        steps = 0;
        while (part >= 0 && session.good()) {
            if (steps >= session.meta_count()) {
                session.truncate_work(base);
                return session.fail_storage(StorageStatus::invalid);
            }
            steps = steps + 1;
            const MetaRow row = session.meta(part);
            if (row.kind() != MetaTag::prefix) {
                session.truncate_work(base);
                return session.fail_storage(StorageStatus::invalid);
            }
            const WorkRow item = WorkRow(row.word(1), -1, -1, -1, -1, -1);
            if (session.append_work(item) < 0) {
                session.truncate_work(base);
                return 0;
            }
            part = row.word(0);
        }
        i64 left = middle;
        i64 right = session.work_count();
        i64 result = 0;
        while (left > base && right > middle && result == 0 && session.good()) {
            left = left - 1;
            right = right - 1;
            const WorkRow a = session.work(left);
            const WorkRow b = session.work(right);
            result = session.compare_components(a.word(0), b.word(0), left > base, right > middle);
        }
        if (result == 0) {
            if (left > base) {
                result = 1;
            }
            if (right > middle) {
                result = -1;
            }
        }
        session.truncate_work(base);
        return result;
    }
    auto order_module(Session& session, i64 module_id, i64 order, i64 scope, bool root) -> bool {
        if (!session.good() || module_id < 0 || module_id >= session.module_count() || order < 0 || order
            >= session.module_count() || scope < 0 || scope >= session.module_count() || (root && scope != 0) || (!root
            && scope == 0)) {
            session.fail_storage(StorageStatus::invalid);
            return false;
        }
        MetaRow row = session.meta(module_id);
        if (row.kind() != MetaTag::module_unit || row.word(12) != -1) {
            session.fail_storage(StorageStatus::invalid);
            return false;
        }
        i64 at = 0;
        while (at < session.module_count()) {
            const MetaRow existing = session.meta(at);
            if (existing.kind() == MetaTag::module_unit && existing.word(12) >= 0 && (existing.word(12) == order
                || existing.word(13) == scope)) {
                session.fail_storage(StorageStatus::invalid);
                return false;
            }
            at = at + 1;
        }
        row.set_word(12, order);
        row.set_word(13, scope);
        if (root) {
            row.set_word(14, 1);
        } else {
            row.set_word(14, 0);
        }
        return session.set_meta(module_id, row);
    }
    auto import_head(Session& session, i64 module_id) -> i64 {
        return session.index(3, module_id, 0, 0, 0);
    }
    auto bind_import(Session& session, i64 module_id, i64 import_node, i64 target) -> bool {
        if (!session.good() || module_id < 0 || module_id >= session.module_count() || target < 0 || target
            >= session.module_count()) {
            session.fail_storage(StorageStatus::invalid);
            return false;
        }
        const MetaRow from = session.meta(module_id);
        const MetaRow to = session.meta(target);
        const SyntaxRow declaration = session.syntax(import_node);
        if (from.kind() != MetaTag::module_unit || to.kind() != MetaTag::module_unit || declaration.kind()
            != SyntaxTag::declaration || declaration.word(11) != module_id || declaration.declaration_kind()
            != compiler_parser::SyntaxKind::import_name || session.index(5, module_id, import_node, 0, 0) >= 0) {
            session.fail_storage(StorageStatus::invalid);
            return false;
        }
        // Ingestion projects the final identifier into the otherwise unused
        // import binding slot, so trailing trivia never widens its name span.
        const i64 reference = name_range(session, declaration.word(0), declaration.word(6));
        if (reference < 0) {
            return false;
        }
        MetaRow row = MetaRow(MetaTag::import_name);
        row.set_word(0, module_id);
        row.set_word(1, target);
        row.set_word(2, import_node);
        row.set_word(3, reference);
        const i64 result = session.append_meta(row);
        if (result < 0) {
            return false;
        }
        const i64 tail = session.index(4, module_id, 0, 0, 0);
        if (tail < 0) {
            if (session.index_insert(3, module_id, 0, 0, 0, result) < 0 || session.index_insert(4, module_id, 0, 0, 0,
                result) < 0) {
                return false;
            }
        } else {
            MetaRow previous = session.meta(tail);
            if (previous.kind() != MetaTag::import_name || previous.word(4) != -1) {
                session.fail_storage(StorageStatus::invalid);
                return false;
            }
            previous.set_word(4, result);
            if (!session.set_meta(tail, previous) || !session.index_replace(4, module_id, 0, 0, 0, result)) {
                return false;
            }
        }
        return session.index_insert(5, module_id, import_node, 0, 0, result) == result;
    }
    // Frames are transient scratch rows: module, next import syntax, ordinal,
    // entered. A host source request unwinds all frames before ingest. Replaying
    // unfinished ancestry retains only completed module order and import bindings.
    // The graph bounds (64 files, depth 16) bound this replay without another owner.
    auto graph_walk(Session& session, i64 root) -> WorkRow {
        const WorkRow initial = WorkRow(root, -1, 0, 0, -1, -1);
        session.append_work(initial);
        while (session.good() && session.work_count() > 0) {
            const i64 depth = session.work_count() - 1;
            WorkRow frame = session.work(depth);
            const i64 module_id = frame.word(0);
            const MetaRow unit = session.meta(module_id);
            if (unit.kind() != MetaTag::module_unit) {
                session.fail_storage(StorageStatus::invalid);
                return WorkRow(-1, -1, -1, -1, -1, -1);
            }
            if (frame.word(3) == 0) {
                // Entry priority is depth, active ancestry, then completed.
                if (depth > 16) {
                    return WorkRow(4, -1, -1, -1, -1, -1);
                }
                i64 ancestor = 0;
                while (ancestor < depth) {
                    const WorkRow active = session.work(ancestor);
                    if (active.word(0) == module_id) {
                        return WorkRow(3, module_id, -1, -1, -1, -1);
                    }
                    ancestor = ancestor + 1;
                }
                if (unit.word(12) >= 0) {
                    session.truncate_work(depth);
                } else {
                    frame.set_word(1, unit.word(8));
                    frame.set_word(3, 1);
                    session.set_work(depth, frame);
                }
            } else {
                const SyntaxRow definition = session.syntax(unit.word(10));
                const i64 end = definition.word(7);
                const SyntaxRow preamble = session.syntax(end);
                const i64 node = frame.word(1);
                if (definition.declaration_kind() != compiler_parser::SyntaxKind::module_definition
                    || preamble.declaration_kind() != compiler_parser::SyntaxKind::preamble || node < unit.word(8)
                    || node > end) {
                    session.fail_storage(StorageStatus::invalid);
                    return WorkRow(-1, -1, -1, -1, -1, -1);
                }
                if (node == end) {
                    i64 count = 0;
                    i64 at = 0;
                    while (at < session.module_count()) {
                        const MetaRow other = session.meta(at);
                        if (other.word(12) >= 0) {
                            count = count + 1;
                        }
                        at = at + 1;
                    }
                    i64 scope = count + 1;
                    if (module_id == root) {
                        scope = 0;
                    }
                    order_module(session, module_id, count, scope, module_id == root);
                    session.truncate_work(depth);
                } else {
                    const SyntaxRow imported = session.syntax(node);
                    if (imported.declaration_kind() != compiler_parser::SyntaxKind::import_name
                        || imported.word(11) != module_id) {
                        session.fail_storage(StorageStatus::invalid);
                        return WorkRow(-1, -1, -1, -1, -1, -1);
                    }
                    const i64 name = source_name_range(session, imported.word(0), imported.word(6));
                    i64 previous = import_head(session, module_id);
                    while (previous >= 0 && session.good()) {
                        const MetaRow bound = session.meta(previous);
                        if (bound.kind() != MetaTag::import_name) {
                            session.fail_storage(StorageStatus::invalid);
                            return WorkRow(-1, -1, -1, -1, -1, -1);
                        }
                        if (bound.word(2) < node && source_name(session, bound.word(3)) == name) {
                            return WorkRow(2, module_id, frame.word(2), -1, -1, -1);
                        }
                        previous = bound.word(4);
                    }
                    i64 target = -1;
                    i64 at = 0;
                    while (at < session.module_count() && session.good()) {
                        const MetaRow candidate = session.meta(at);
                        const SyntaxRow candidate_root = session.syntax(candidate.word(10));
                        const SyntaxRow header = session.syntax(candidate_root.word(7));
                        if (source_name_range(session, header.word(0), header.word(6)) == name) {
                            target = at;
                        }
                        at = at + 1;
                    }
                    if (target < 0) {
                        if (session.module_count() >= 64) {
                            return WorkRow(5, -1, -1, -1, -1, -1);
                        }
                        return WorkRow(1, module_id, frame.word(2), -1, -1, -1);
                    }
                    if (session.index(5, module_id, node, 0, 0) < 0) {
                        bind_import(session, module_id, node, target);
                    }
                    frame.set_word(1, node + 1);
                    frame.set_word(2, frame.word(2) + 1);
                    session.set_work(depth, frame);
                    const WorkRow child = WorkRow(target, -1, 0, 0, -1, -1);
                    session.append_work(child);
                }
            }
        }
        return WorkRow(0, -1, -1, -1, -1, -1);
    }
    // Status: complete, request source, duplicate, cycle, depth, file limit.
    // Copied coordinates are diagnostic/transport observations, not authority.
    auto graph_step(Session& session, i64 root) -> WorkRow {
        if (!session.good() || session.work_count() != 0 || root < 0 || root >= session.module_count()) {
            session.fail_storage(StorageStatus::invalid);
            return WorkRow(-1, -1, -1, -1, -1, -1);
        }
        const WorkRow result = graph_walk(session, root);
        session.truncate_work(0);
        if (!session.good()) {
            return WorkRow(-1, -1, -1, -1, -1, -1);
        }
        return result;
    }

}
