export module aurora.compiler.lowering;
import aurora.compiler.resolver;
import aurora.compiler.resolution_arena;
import aurora.compiler.resolution_kinds;
import aurora.compiler.lowering_kinds;
import aurora.compiler.lowering_errors;
import aurora.compiler.lowering_storage;
import aurora.compiler.lowering_common;
import aurora.compiler.lowering_configuration;
import aurora.compiler.lowering_types;
import aurora.compiler.lowering_values;
import aurora.compiler.lowering_body;

export namespace compiler_lowering {
    auto layout_failure(LoweringError reason) -> bool {
        return reason == LoweringError::ir_storage_extent_limit
            || reason == LoweringError::ir_class_storage_depth
            || reason == LoweringError::ir_missing_class_storage_shape
            || reason == LoweringError::ir_class_storage_alignment
            || reason == LoweringError::ir_logical_field_storage_range
            || reason == LoweringError::ir_owned_byte_field_descriptor
            || reason == LoweringError::ir_nested_owning_class_field
            || reason == LoweringError::ir_nested_field_storage_shape
            || reason == LoweringError::ir_scalar_field_storage_shape
            || reason == LoweringError::ir_class_storage_limit
            || reason == LoweringError::ir_class_storage_leaf_coverage;
    }
    auto failed_result(compiler_resolver::Session& session) -> LoweringResult {
        const compiler_resolver::StorageStatus storage = session.storage_status();
        if (storage != compiler_resolver::StorageStatus::none) {
            LoweringStatus status = LoweringStatus::invalid;
            if (storage == compiler_resolver::StorageStatus::allocation) {
                status = LoweringStatus::storage_failure;
            }
            const LoweringResult result = LoweringResult(status, LoweringError::none,
                session.diagnostic_payload_row(), -1);
            return result;
        }
        const LoweringError reason = session.lowering_error();
        LoweringStatus status = LoweringStatus::invalid;
        if (reason != LoweringError::none && !layout_failure(reason)) {
            status = LoweringStatus::semantic_failure;
        }
        const LoweringResult result = LoweringResult(status, reason, session.diagnostic_payload_row(), -1);
        return result;
    }
    // Seven bounded linear passes create the module's seven distinct lists.
    // Metadata rows may interleave instructions; no row order is guessed from
    // a native name. Functions and instructions retain their producer order.
    auto module_list(compiler_resolver::Session& session, RecordKind kind, OperandRole role, i64 limit) -> OperandRow {
        const i64 begin = session.operand_count();
        i64 at = 15;
        i64 count = 0;
        while (at < limit && session.good()) {
            const OutputRow row = session.view_output(at);
            if (row.kind() == kind) {
                put(session, OperandRole::OutputRowId, at);
                count = count + 1;
            }
            at = at + 1;
        }
        const OperandRow result = slice(role, begin, count);
        return result;
    }
    auto run_lowering(compiler_resolver::Session& session) -> LoweringResult {
        if (!seal_lowering_configuration(session) || !prepare_types(session)) {
            const LoweringResult result = failed_result(session);
            return result;
        }
        const bool lint = configured_limit(session, OperandRole::AnalysisMode) == 1;
        const i64 count = function_count(session);
        if (count < 0 || count > session.meta_count()) {
            session.fail_storage(compiler_resolver::StorageStatus::invalid);
            const LoweringResult result = failed_result(session);
            return result;
        }
        i64 at = 0;
        i64 label = 0;
        while (at < count && session.good()) {
            const i64 symbol = function_symbol(session, at);
            const FunctionBodyResult body = lower_function_body(session, symbol, label, lint);
            if (session.good() && (body.function_row() < 15 || body.next_label() < label)) {
                session.fail_storage(compiler_resolver::StorageStatus::invalid);
            }
            label = body.next_label();
            at = at + 1;
        }
        if (session.good() && (session.work_count() != 0 || session.continuation_count() != 0
            || session.snapshot_count() != 0)) {
            session.fail_storage(compiler_resolver::StorageStatus::invalid);
        }
        if (!session.good() || !finalize_types(session)) {
            const LoweringResult result = failed_result(session);
            return result;
        }
        const i64 limit = session.output_count();
        const OperandRow functions = module_list(session, RecordKind::Function, OperandRole::Functions, limit);
        const OperandRow classes = module_list(session, RecordKind::Class, OperandRole::Classes, limit);
        const OperandRow carriers = module_list(session, RecordKind::Carrier, OperandRole::Carriers, limit);
        const OperandRow descriptors = module_list(session, RecordKind::Descriptor, OperandRole::Descriptors, limit);
        const OperandRow views = module_list(session, RecordKind::DescriptorView, OperandRole::DescriptorViews, limit);
        const OperandRow enums = module_list(session, RecordKind::EnumCases, OperandRole::Enumerations, limit);
        const OperandRow lint_messages = module_list(session, RecordKind::UnreadLocal, OperandRole::LintDiagnostics, limit);
        const i64 begin = session.operand_count();
        session.append_operand(functions);
        session.append_operand(classes);
        session.append_operand(carriers);
        session.append_operand(descriptors);
        session.append_operand(views);
        session.append_operand(enums);
        session.append_operand(lint_messages);
        const i64 root = record(session, RecordKind::Module, begin, 7);
        if (!session.good() || root < 15) {
            const LoweringResult result = failed_result(session);
            return result;
        }
        const LoweringResult result = LoweringResult(LoweringStatus::success, LoweringError::none,
            session.diagnostic_payload_row(), root);
        return result;
    }
}
