export module aurora.compiler.parser;
import aurora.compiler.lexer;
import aurora.compiler.syntax_arena;

export namespace compiler_parser {
    // Copied bootstrap results contain indices and status, never owner storage.
    enum class ParseStatus {
        success,
        unsupported,
        expected_expression,
        expected_close,
        expected_end,
        nesting_limit,
        depth_limit,
        allocation_failure,
        expected_index_close,
        expected_identifier,
        reserved_identifier,
        reserved_builtin,
        reserved_prefix,
        expected_brace_close,
        expected_dot,
        expected_equal,
        expected_brace_open,
        expected_angle_open,
        expected_angle_close,
        expected_scope,
        expected_comma,
        expected_const,
        expected_u8,
        expected_i64,
        expected_array,
        reserved_type,
        expected_type,
        type_nesting_limit,
        template_nesting_limit,
        call_template_nesting_limit,
        template_context,
        template_arity,
        template_argument,
        capacity_argument,
        nested_dependent,
        owned_element,
        array_element,
        array_length,
        class_array_length,
        expected_open,
        expected_semicolon,
        unterminated_block,
        block_nesting_limit,
        assignment_target,
        expected_auto,
        expected_arrow,
        invalid
    };
    enum class Stop {
        semicolon,
        close_parenthesis,
        assignment,
        constructor_braces,
        body,
        type,
        function,
        method,
        constructor,
        field
    };
    // Source-backed syntactic parameters, captured by declaration parsing.
    // These names carry no resolved nominal identity or visibility authority.
    class TypeContext {
        i64 first_begin;
        i64 first_end;
        i64 second_begin;
        i64 second_end;
        i64 capacity_begin;
        i64 capacity_end;
        i64 template_mode;
    public:
        TypeContext() : first_begin(0), first_end(0), second_begin(0), second_end(0), capacity_begin(0),
            capacity_end(0), template_mode(0) {
        }
        auto begin(i64 index) const -> i64 {
            if (index == 0) {
                return first_begin;
            }
            if (index == 1) {
                return second_begin;
            }
            return capacity_begin;
        }
        auto end(i64 index) const -> i64 {
            if (index == 0) {
                return first_end;
            }
            if (index == 1) {
                return second_end;
            }
            return capacity_end;
        }
        auto mode() const -> i64 {
            return template_mode;
        }
    };
    class ParseResult {
        ParseStatus result;
        i64 root_node;
        i64 node_count;
        i64 token_count;
        i64 source_offset;
        i64 token_half;
    public:
        ParseResult(ParseStatus status, i64 root, i64 nodes, i64 tokens, i64 offset, i64 half) : result(status),
            root_node(root), node_count(nodes), token_count(tokens), source_offset(offset), token_half(half) {
        }
        auto status() const -> ParseStatus {
            return result;
        }
        auto root() const -> i64 {
            return root_node;
        }
        auto size() const -> i64 {
            return node_count;
        }
        auto tokens() const -> i64 {
            return token_count;
        }
        auto offset() const -> i64 {
            return source_offset;
        }
        auto half() const -> i64 {
            return token_half;
        }
    };
}

namespace compiler_parser {
    class ParseToken {
        compiler_lexer::Event event;
        i64 begin;
        i64 end;
        i64 line;
        i64 line_start;
        i64 ordinal;
        i64 token_half;
    public:
        ParseToken(compiler_lexer::Event kind, i64 first, i64 last, i64 row, i64 start, i64 index) : event(kind),
            begin(first), end(last), line(row), line_start(start), ordinal(index), token_half(0) {
        }
        auto update(ParseToken next) -> i64 {
            event = next.kind();
            begin = next.first();
            end = next.last();
            line = next.row();
            line_start = next.start();
            ordinal = next.index();
            token_half = next.half();
            return 0;
        }
        auto kind() const -> compiler_lexer::Event {
            return event;
        }
        auto first() const -> i64 {
            return begin;
        }
        auto last() const -> i64 {
            return end;
        }
        auto row() const -> i64 {
            return line;
        }
        auto start() const -> i64 {
            return line_start;
        }
        auto index() const -> i64 {
            return ordinal;
        }
        auto half() const -> i64 {
            return token_half;
        }
        auto split() -> i64 {
            begin = begin + 1;
            token_half = 1;
            return 0;
        }
    };
    class TypeResult {
        ParseStatus result;
        i64 root_type;
        ParseToken next_token;
    public:
        TypeResult(ParseStatus status, i64 root, ParseToken next) : result(status), root_type(root), next_token(next) {
        }
        auto status() const -> ParseStatus {
            return result;
        }
        auto root() const -> i64 {
            return root_type;
        }
        auto token() const -> ParseToken {
            // Rebuild the copied field through its scalar accessors, retaining a split closer.
            const i64 half = next_token.half();
            ParseToken next = ParseToken(next_token.kind(), next_token.first() - half, next_token.last(),
                next_token.row(), next_token.start(), next_token.index());
            if (half == 1) {
                next.split();
            }
            return next;
        }
    };
    auto read_token(builtin::span<const u8> source, compiler_lexer::Cursor cursor, i64 ordinal) -> ParseToken {
        i64 offset = cursor.at();
        i64 line = cursor.row();
        i64 start = cursor.start();
        bool again = true;
        while (again) {
            const compiler_lexer::Cursor at = compiler_lexer::Cursor(offset, line, start);
            const compiler_lexer::Lexeme lexeme = compiler_lexer::next_lexeme(source, at);
            if (lexeme.kind() != compiler_lexer::Event::whitespace && lexeme.kind()
                != compiler_lexer::Event::line_comment) {
                return ParseToken(lexeme.kind(), at.at(), lexeme.next_offset(), lexeme.next_line(),
                    lexeme.next_line_start(), ordinal);
            }
            offset = lexeme.next_offset();
            line = lexeme.next_line();
            start = lexeme.next_line_start();
        }
        return ParseToken(compiler_lexer::Event::invalid_cursor, 0, 0, 1, 0, ordinal);
    }
    auto advance(builtin::span<const u8> source, ParseToken token) -> ParseToken {
        if (token.kind() == compiler_lexer::Event::end_of_input) {
            return token;
        }
        const compiler_lexer::Cursor cursor = compiler_lexer::Cursor(token.last(), token.row(), token.start());
        return read_token(source, cursor, token.index() + 1);
    }
    auto single(builtin::span<const u8> source, ParseToken token, u8 value) -> bool {
        return token.last() - token.first() == 1 && source.at(token.first()) == value;
    }
    auto boolean_literal(builtin::span<const u8> source, ParseToken token) -> bool {
        const i64 at = token.first();
        const i64 count = token.last() - at;
        return (count == 4 && source.at(at) == 't' && source.at(at + 1) == 'r' && source.at(at + 2) == 'u'
            && source.at(at + 3) == 'e') || (count == 5 && source.at(at) == 'f' && source.at(at + 1) == 'a'
            && source.at(at + 2) == 'l' && source.at(at + 3) == 's' && source.at(at + 4) == 'e');
    }
    auto precedence(builtin::span<const u8> source, ParseToken token) -> i64 {
        const i64 count = token.last() - token.first();
        if (count < 1 || count > 2) {
            return 0;
        }
        const u8 first = source.at(token.first());
        if (count == 2) {
            const u8 second = source.at(token.first() + 1);
            if (first == '|' && second == '|') {
                return 1;
            }
            if (first == '&' && second == '&') {
                return 2;
            }
            if ((first == '=' || first == '!') && second == '=') {
                return 6;
            }
            if ((first == '<' || first == '>') && second == '=') {
                return 7;
            }
            if ((first == '<' || first == '>') && second == first) {
                return 8;
            }
            return 0;
        }
        if (first == '|') {
            return 3;
        }
        if (first == '^') {
            return 4;
        }
        if (first == '&') {
            return 5;
        }
        if (first == '<' || first == '>') {
            return 7;
        }
        if (first == '+' || first == '-') {
            return 9;
        }
        if (first == '*' || first == '/' || first == '%') {
            return 10;
        }
        return 0;
    }
    auto stopped(builtin::span<const u8> source, ParseToken token, Stop stop) -> bool {
        if (stop == Stop::close_parenthesis) {
            return single(source, token, ')');
        }
        return stop != Stop::constructor_braces && (single(source, token, ';') || (stop == Stop::assignment
            && single(source, token, '=')));
    }
    auto pair(builtin::span<const u8> source, ParseToken token, u8 value) -> bool {
        return token.last() - token.first() == 2 && source.at(token.first()) == value && source.at(token.first() + 1)
            == value;
    }
    auto word_matches(builtin::span<const u8> source, ParseToken token, builtin::span<const u8> words, i64 begin,
        i64 end) -> bool {
        if (token.last() - token.first() != end - begin) {
            return false;
        }
        i64 index = 0;
        while (index < end - begin) {
            if (source.at(token.first() + index) != words.at(begin + index)) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }
    auto word_list_matches(builtin::span<const u8> source, ParseToken token, builtin::span<const u8> words) -> bool {
        i64 begin = 0;
        while (begin < words.size()) {
            i64 end = begin;
            while (words.at(end) != ';') {
                end = end + 1;
            }
            if (word_matches(source, token, words, begin, end)) {
                return true;
            }
            begin = end + 1;
        }
        return false;
    }
    auto identifier_status(builtin::span<const u8> source, ParseToken token, bool allow_array) -> ParseStatus {
        if (token.kind() != compiler_lexer::Event::token || !compiler_lexer::letter(source.at(token.first()))) {
            return ParseStatus::expected_identifier;
        }
        const array<u8, 14> storage_names = "builtin;array;";
        const builtin::span<const u8> storage = borrow_bytes(storage_names);
        if (word_matches(source, token, storage, 0, 7) || (!allow_array && word_matches(source, token, storage, 8,
            13))) {
            return ParseStatus::reserved_builtin;
        }
        const i64 first = token.first();
        if (token.last() - first >= 5 && source.at(first) == '_' && source.at(first + 1) == '_' && source.at(first + 2)
            == 'a' && source.at(first + 3) == 'u' && source.at(first + 4) == '_') {
            return ParseStatus::reserved_prefix;
        }
        const array<u8,
            85> flow_names = "fn;module;let;mut;if;else;return;true;false;static_assert;class;while;break;continue;";
        const builtin::span<const u8> flow_words = borrow_bytes(flow_names);
        const array<u8,
            71> declaration_names = "auto;const;public;private;protected;unsafe;extern;struct;export;import;";
        const builtin::span<const u8> declaration_words = borrow_bytes(declaration_names);
        const array<u8, 36> scope_names = "namespace;this;template;Scalar;enum;";
        const builtin::span<const u8> scope_words = borrow_bytes(scope_names);
        if (word_list_matches(source, token, flow_words) || word_list_matches(source, token, declaration_words)
            || word_list_matches(source, token, scope_words)) {
            return ParseStatus::reserved_identifier;
        }
        return ParseStatus::success;
    }
    auto type_query(builtin::span<const u8> source, ParseToken token) -> bool {
        const array<u8, 28> names = "size_of;type_id;field_count;";
        const builtin::span<const u8> words = borrow_bytes(names);
        return word_list_matches(source, token, words);
    }
    auto reserved_type_name(builtin::span<const u8> source, ParseToken token) -> bool {
        const array<u8, 49> names0 = "fn;let;mut;auto;const;class;unsafe;struct;extern;";
        const builtin::span<const u8> words0 = borrow_bytes(names0);
        const array<u8, 43> names1 = "int;void;char;float;double;new;delete;enum;";
        const builtin::span<const u8> words1 = borrow_bytes(names1);
        return word_list_matches(source, token, words0) || word_list_matches(source, token, words1);
    }
    auto builtin_type_name(builtin::span<const u8> source, ParseToken token) -> bool {
        const array<u8, 66> names0 = "IommuEventSession;IommuEventSample;EventPollResult;EventAckResult;";
        const builtin::span<const u8> words0 = borrow_bytes(names0);
        const array<u8, 72> names1 = "EventIntakeCompletion;DisplaySession;DisplayPutResult;DisplayCompletion;";
        const builtin::span<const u8> words1 = borrow_bytes(names1);
        const array<u8, 64> names2 = "ConsoleSession;ConsoleSample;ConsolePutResult;ConsoleCompletion;";
        const builtin::span<const u8> words2 = borrow_bytes(names2);
        const array<u8, 22> names3 = "ByteRegion;OwnedBytes;";
        const builtin::span<const u8> words3 = borrow_bytes(names3);
        return word_list_matches(source, token, words0) || word_list_matches(source, token, words1)
            || word_list_matches(source, token, words2) || word_list_matches(source, token, words3);
    }
    enum class TypeWord {
        invalid,
        i64_type,
        u64_type,
        u8_type,
        bool_type,
        array_type,
        builtin_type,
        span_type,
        owned_values,
        own_type,
        ref_type,
        mutref_type,
        const_type
    };
    auto type_word(builtin::span<const u8> source, ParseToken token) -> TypeWord {
        const array<u8, 68> names = "i64;u64;u8;bool;array;builtin;span;OwnedValues;own;ref;mutref;const;";
        const builtin::span<const u8> words = borrow_bytes(names);
        if (word_matches(source, token, words, 0, 3)) {
            return TypeWord::i64_type;
        }
        if (word_matches(source, token, words, 4, 7)) {
            return TypeWord::u64_type;
        }
        if (word_matches(source, token, words, 8, 10)) {
            return TypeWord::u8_type;
        }
        if (word_matches(source, token, words, 11, 15)) {
            return TypeWord::bool_type;
        }
        if (word_matches(source, token, words, 16, 21)) {
            return TypeWord::array_type;
        }
        if (word_matches(source, token, words, 22, 29)) {
            return TypeWord::builtin_type;
        }
        if (word_matches(source, token, words, 30, 34)) {
            return TypeWord::span_type;
        }
        if (word_matches(source, token, words, 35, 46)) {
            return TypeWord::owned_values;
        }
        if (word_matches(source, token, words, 47, 50)) {
            return TypeWord::own_type;
        }
        if (word_matches(source, token, words, 51, 54)) {
            return TypeWord::ref_type;
        }
        if (word_matches(source, token, words, 55, 61)) {
            return TypeWord::mutref_type;
        }
        if (word_matches(source, token, words, 62, 67)) {
            return TypeWord::const_type;
        }
        return TypeWord::invalid;
    }
    auto parameter(builtin::span<const u8> source, ParseToken token, TypeContext context, bool capacity) -> bool {
        i64 begin = 0;
        i64 end = 2;
        if (capacity) {
            begin = 2;
            end = 3;
        }
        while (begin < end) {
            if (context.end(begin) > context.begin(begin) && word_matches(source, token, source, context.begin(begin),
                context.end(begin))) {
                return true;
            }
            begin = begin + 1;
        }
        return false;
    }
    auto valid_context(builtin::span<const u8> source, TypeContext context) -> bool {
        if (context.mode() < 0 || context.mode() > 2) {
            return false;
        }
        i64 index = 0;
        while (index < 3) {
            const i64 first = context.begin(index);
            const i64 last = context.end(index);
            if (first != 0 || last != 0) {
                if (first < 0 || last <= first || last > source.size()) {
                    return false;
                }
                const ParseToken token = ParseToken(compiler_lexer::Event::token, first, last, 1, 0, 0);
                if (identifier_status(source, token, false) != ParseStatus::success) {
                    return false;
                }
                const array<u8, 31> reserved = "i64;u64;u8;bool;own;ref;mutref;";
                const builtin::span<const u8> reserved_words = borrow_bytes(reserved);
                if (word_list_matches(source, token, reserved_words)) {
                    return false;
                }
                i64 at = first + 1;
                while (at < last) {
                    if (!compiler_lexer::letter(source.at(at)) && !compiler_lexer::digit(source.at(at))) {
                        return false;
                    }
                    at = at + 1;
                }
                i64 before = 0;
                while (before < index) {
                    if (context.end(before) > context.begin(before) && word_matches(source, token, source,
                        context.begin(before), context.end(before))) {
                        return false;
                    }
                    before = before + 1;
                }
            }
            index = index + 1;
        }
        if (context.mode() == 0) {
            return context.end(0) == 0 && context.end(1) == 0 && context.end(2) == 0;
        }
        if (context.end(0) == 0 || (context.end(1) != 0 && context.end(2) != 0)) {
            return false;
        }
        return context.mode() != 2 || context.end(2) == 0;
    }
    auto decimal_capacity(builtin::span<const u8> source, ParseToken token, i64 limit) -> i64 {
        i64 value = 0;
        i64 index = token.first();
        while (index < token.last()) {
            const u8 digit = source.at(index);
            if (!compiler_lexer::digit(digit) || value > limit) {
                return -1;
            }
            value = value * 10 + i64(digit) - 48;
            index = index + 1;
        }
        if (value < 1 || value > limit) {
            return -1;
        }
        return value;
    }
    auto type_close(builtin::span<const u8> source, ParseToken token) -> ParseToken {
        if (pair(source, token, '>')) {
            ParseToken next = token;
            next.split();
            return next;
        }
        const ParseToken next = advance(source, token);
        return next;
    }
    auto type_error(const AstArena& arena, ParseToken token) -> TypeResult {
        ParseStatus status = ParseStatus::invalid;
        if (arena.failure() == ArenaFailure::allocation) {
            status = ParseStatus::allocation_failure;
        }
        const TypeResult result = TypeResult(status, -1, token);
        return result;
    }
    // One iterative parser serves declaration/local types, reflected types and template-ids.
    // The existing grammar's two-argument bound is independent of arena growth.
    auto parse_type_frames(AstArena& arena, builtin::span<const u8> source, ParseToken initial, TypeContext context,
        ParseFrame first) -> TypeResult {
        ParseToken token = initial;
        const i64 base = arena.stack_size();
        i64 type_depth = 0;
        i64 template_depth = 0;
        i64 value = -1;
        i64 allowance = 0;
        if (first.state() == FrameState::type_arguments) {
            allowance = 1;
        }
        if (!arena.push(first)) {
            const TypeResult error = type_error(arena, token);
            return error;
        }
        while (arena.stack_size() > base) {
            const ParseFrame frame = arena.frame();
            if (frame.state() == FrameState::type_arguments) {
                if (template_depth >= 4 + allowance) {
                    ParseStatus status = ParseStatus::template_nesting_limit;
                    if (allowance == 1) {
                        status = ParseStatus::call_template_nesting_limit;
                    }
                    return TypeResult(status, -1, token);
                }
                template_depth = template_depth + 1;
                if (context.mode() == 1) {
                    return TypeResult(ParseStatus::template_context, -1, token);
                }
                if (!single(source, token, '<')) {
                    return TypeResult(ParseStatus::expected_angle_open, -1, token);
                }
                const ParseToken next = advance(source, token);
                token.update(next);
                ParseFrame parent = ParseFrame(FrameState::type_argument_first, frame.min(), -1, frame.token());
                parent.designate(frame.field());
                const ParseFrame child = ParseFrame(FrameState::type_start, 1, -1, -1);
                if (!arena.replace(parent) || !arena.push(child)) {
                    const TypeResult error = type_error(arena, token);
                    return error;
                }
            } else {
                if (frame.state() == FrameState::type_argument_first || frame.state()
                    == FrameState::type_argument_second) {
                    if (single(source, token, ',')) {
                        const ParseToken next = advance(source, token);
                        token.update(next);
                        if (frame.state() == FrameState::type_argument_second) {
                            return TypeResult(ParseStatus::template_arity, -1, token);
                        }
                        ParseFrame parent = ParseFrame(FrameState::type_argument_second, frame.min(), value,
                            frame.token());
                        parent.designate(frame.field());
                        const ParseFrame child = ParseFrame(FrameState::type_start, 1, -1, -1);
                        if (!arena.replace(parent) || !arena.push(child)) {
                            const TypeResult error = type_error(arena, token);
                            return error;
                        }
                    } else {
                        if (!single(source, token, '>') && !pair(source, token, '>')) {
                            return TypeResult(ParseStatus::expected_angle_close, -1, token);
                        }
                        const i64 close = token.index() * 2 + token.half();
                        const ParseToken next = type_close(source, token);
                        token.update(next);
                        i64 left = value;
                        i64 right = -1;
                        if (frame.state() == FrameState::type_argument_second) {
                            left = frame.lhs();
                            right = value;
                        }
                        value = arena.append_type(TypeKind::named, frame.token(), frame.field(), close, left, right);
                        if (value < 0) {
                            const TypeResult error = type_error(arena, token);
                            return error;
                        }
                        template_depth = template_depth - 1;
                        if (frame.min() == 1) {
                            type_depth = type_depth - 1;
                        }
                        arena.pop();
                    }
                } else {
                    if (frame.state() == FrameState::type_array_element || frame.state()
                        == FrameState::type_owned_element) {
                        const TypeSyntax element = arena.type_at(value);
                        const i64 element_index = value;
                        i64 length_index = -1;
                        i64 length = 0;
                        TypeKind kind = TypeKind::owned_values;
                        if (frame.state() == FrameState::type_owned_element) {
                            if ((element.kind() != TypeKind::named && element.kind() != TypeKind::builtin_class)
                                || element.first() >= 0) {
                                return TypeResult(ParseStatus::owned_element, -1, token);
                            }
                        } else {
                            kind = TypeKind::array_type;
                            if (element.kind() != TypeKind::i64_type && element.kind() != TypeKind::u64_type
                                && element.kind() != TypeKind::u8_type && element.kind() != TypeKind::bool_type
                                && element.kind() != TypeKind::parameter && element.kind() != TypeKind::named
                                && element.kind() != TypeKind::builtin_class) {
                                return TypeResult(ParseStatus::array_element, -1, token);
                            }
                            if (!single(source, token, ',')) {
                                return TypeResult(ParseStatus::expected_comma, -1, token);
                            }
                            const ParseToken count = advance(source, token);
                            const ParseToken next = advance(source, count);
                            token.update(next);
                            TypeKind count_kind = TypeKind::capacity;
                            if (parameter(source, count, context, true)) {
                                count_kind = TypeKind::length_parameter;
                            } else {
                                length = decimal_capacity(source, count, 4096);
                                if (length < 0) {
                                    return TypeResult(ParseStatus::array_length, -1, token);
                                }
                            }
                            length_index = arena.append_type(count_kind, count.index(), count.index(), count.index()
                                * 2, -1, -1);
                            if (length_index < 0) {
                                const TypeResult error = type_error(arena, token);
                                return error;
                            }
                        }
                        if (!single(source, token, '>') && !pair(source, token, '>')) {
                            return TypeResult(ParseStatus::expected_angle_close, -1, token);
                        }
                        const i64 close = token.index() * 2 + token.half();
                        const ParseToken next = type_close(source, token);
                        token.update(next);
                        if (kind == TypeKind::array_type && (element.kind() == TypeKind::named || element.kind()
                            == TypeKind::builtin_class) && length > 64) {
                            return TypeResult(ParseStatus::class_array_length, -1, token);
                        }
                        value = arena.append_type(kind, frame.token(), frame.field(), close, element_index,
                            length_index);
                        if (value < 0) {
                            const TypeResult error = type_error(arena, token);
                            return error;
                        }
                        type_depth = type_depth - 1;
                        arena.pop();
                    } else {
                        if (frame.state() != FrameState::type_start) {
                            return TypeResult(ParseStatus::invalid, -1, token);
                        }
                        const bool argument = frame.min() == 1;
                        if (!argument) {
                            if (type_depth >= 64) {
                                return TypeResult(ParseStatus::type_nesting_limit, -1, token);
                            }
                            type_depth = type_depth + 1;
                            if (reserved_type_name(source, token)) {
                                return TypeResult(ParseStatus::reserved_type, -1, token);
                            }
                        }
                        const ParseToken original = token;
                        TypeKind kind = TypeKind::invalid;
                        if ((type_word(source, token) == TypeWord::i64_type)) {
                            kind = TypeKind::i64_type;
                        }
                        if ((type_word(source, token) == TypeWord::u64_type)) {
                            kind = TypeKind::u64_type;
                        }
                        if ((type_word(source, token) == TypeWord::u8_type)) {
                            kind = TypeKind::u8_type;
                        }
                        if ((type_word(source, token) == TypeWord::bool_type)) {
                            kind = TypeKind::bool_type;
                        }
                        if (argument && token.kind() == compiler_lexer::Event::token
                            && compiler_lexer::digit(source.at(token.first()))) {
                            const ParseToken next = advance(source, token);
                            token.update(next);
                            if (decimal_capacity(source, original, 64) < 0) {
                                return TypeResult(ParseStatus::capacity_argument, -1, token);
                            }
                            kind = TypeKind::capacity;
                        } else {
                            if (argument && kind == TypeKind::invalid) {
                                const array<u8, 40> excluded = "own;ref;mutref;array;builtin;true;false;";
                                const builtin::span<const u8> excluded_words = borrow_bytes(excluded);
                                if (word_list_matches(source, token, excluded_words)) {
                                    return TypeResult(ParseStatus::template_argument, -1, token);
                                }
                                const ParseStatus status = identifier_status(source, token, false);
                                if (status != ParseStatus::success) {
                                    return TypeResult(status, -1, token);
                                }
                            }
                            const ParseToken next = advance(source, token);
                            token.update(next);
                        }
                        if (kind != TypeKind::invalid) {
                            value = arena.append_type(kind, original.index(), original.index(), original.index() * 2,
                                -1, -1);
                            if (value < 0) {
                                const TypeResult error = type_error(arena, token);
                                return error;
                            }
                            if (!argument) {
                                type_depth = type_depth - 1;
                            }
                            arena.pop();
                        } else {
                            i64 name_last = original.index();
                            bool is_array = !argument && (type_word(source, original) == TypeWord::array_type);
                            bool owned = false;
                            bool is_builtin = !argument && (type_word(source, original) == TypeWord::builtin_type);
                            bool atomic = false;
                            if (is_builtin) {
                                if (!pair(source, token, ':')) {
                                    return TypeResult(ParseStatus::expected_scope, -1, token);
                                }
                                const ParseToken member = advance(source, token);
                                token.update(member);
                                name_last = token.index();
                                if ((type_word(source, token) == TypeWord::span_type)) {
                                    kind = TypeKind::byte_span;
                                } else {
                                    if ((type_word(source, token) == TypeWord::owned_values)) {
                                        owned = true;
                                    } else {
                                        if ((type_word(source, token) == TypeWord::array_type)) {
                                            is_array = true;
                                        } else {
                                            if (!builtin_type_name(source, token)) {
                                                return TypeResult(ParseStatus::expected_array, -1, token);
                                            }
                                            kind = TypeKind::builtin_type;
                                            const array<u8, 31> samples = "ConsoleSample;IommuEventSample;";
                                            const builtin::span<const u8> samples_words = borrow_bytes(samples);
                                            if (word_list_matches(source, token, samples_words)) {
                                                kind = TypeKind::builtin_class;
                                            }
                                            atomic = true;
                                        }
                                    }
                                }
                                const ParseToken next = advance(source, token);
                                token.update(next);
                            } else {
                                if (!argument && parameter(source, original, context, false)) {
                                    kind = TypeKind::parameter;
                                    atomic = true;
                                }
                                if (!argument && (type_word(source, original) == TypeWord::own_type)) {
                                    kind = TypeKind::own_type;
                                }
                                if (!argument && (type_word(source, original) == TypeWord::ref_type)) {
                                    kind = TypeKind::ref_type;
                                }
                                if (!argument && (type_word(source, original) == TypeWord::mutref_type)) {
                                    kind = TypeKind::mutref_type;
                                }
                            }
                            if (is_array || owned) {
                                if (!single(source, token, '<')) {
                                    return TypeResult(ParseStatus::expected_angle_open, -1, token);
                                }
                                const ParseToken next = advance(source, token);
                                token.update(next);
                                FrameState state = FrameState::type_array_element;
                                if (owned) {
                                    state = FrameState::type_owned_element;
                                }
                                ParseFrame parent = ParseFrame(state, 0, -1, original.index());
                                parent.designate(name_last);
                                const ParseFrame child = ParseFrame(FrameState::type_start, 0, -1, -1);
                                if (!arena.replace(parent) || !arena.push(child)) {
                                    const TypeResult error = type_error(arena, token);
                                    return error;
                                }
                            } else {
                                if (kind == TypeKind::own_type || kind == TypeKind::ref_type || kind
                                    == TypeKind::mutref_type || kind == TypeKind::byte_span) {
                                    if (!single(source, token, '<')) {
                                        return TypeResult(ParseStatus::expected_angle_open, -1, token);
                                    }
                                    const ParseToken next = advance(source, token);
                                    token.update(next);
                                    if (kind == TypeKind::byte_span) {
                                        if (!(type_word(source, token) == TypeWord::const_type)) {
                                            return TypeResult(ParseStatus::expected_const, -1, token);
                                        }
                                        const ParseToken after_const = advance(source, token);
                                        token.update(after_const);
                                        if (!(type_word(source, token) == TypeWord::u8_type)) {
                                            return TypeResult(ParseStatus::expected_u8, -1, token);
                                        }
                                    } else {
                                        if (!(type_word(source, token) == TypeWord::i64_type)) {
                                            return TypeResult(ParseStatus::expected_i64, -1, token);
                                        }
                                    }
                                    const ParseToken after_element = advance(source, token);
                                    token.update(after_element);
                                    if (!single(source, token, '>')) {
                                        return TypeResult(ParseStatus::expected_angle_close, -1, token);
                                    }
                                    const i64 close = token.index() * 2 + token.half();
                                    const ParseToken after_close = advance(source, token);
                                    token.update(after_close);
                                    value = arena.append_type(kind, original.index(), name_last, close, -1, -1);
                                    if (value < 0) {
                                        const TypeResult error = type_error(arena, token);
                                        return error;
                                    }
                                    type_depth = type_depth - 1;
                                    arena.pop();
                                } else {
                                    if (!atomic) {
                                        if (original.kind() != compiler_lexer::Event::token
                                            || !compiler_lexer::letter(source.at(original.first()))) {
                                            return TypeResult(ParseStatus::expected_type, -1, token);
                                        }
                                        while (pair(source, token, ':')) {
                                            const ParseToken component = advance(source, token);
                                            token.update(component);
                                            const ParseStatus status = identifier_status(source, token, true);
                                            if (status != ParseStatus::success) {
                                                return TypeResult(status, -1, token);
                                            }
                                            name_last = token.index();
                                            const ParseToken next = advance(source, token);
                                            token.update(next);
                                        }
                                        kind = TypeKind::named;
                                        if (argument && name_last == original.index() && parameter(source, original,
                                            context, false)) {
                                            if (template_depth != 1 || single(source, token, '<')) {
                                                return TypeResult(ParseStatus::nested_dependent, -1, token);
                                            }
                                            kind = TypeKind::parameter;
                                        }
                                    }
                                    if (!atomic && single(source, token, '<')) {
                                        i64 full = 0;
                                        if (!argument) {
                                            full = 1;
                                        }
                                        ParseFrame parent = ParseFrame(FrameState::type_arguments, full, -1,
                                            original.index());
                                        parent.designate(name_last);
                                        if (!arena.replace(parent)) {
                                            const TypeResult error = type_error(arena, token);
                                            return error;
                                        }
                                    } else {
                                        value = arena.append_type(kind, original.index(), name_last, name_last * 2, -1,
                                            -1);
                                        if (value < 0) {
                                            const TypeResult error = type_error(arena, token);
                                            return error;
                                        }
                                        if (!argument) {
                                            type_depth = type_depth - 1;
                                        }
                                        arena.pop();
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        return TypeResult(ParseStatus::success, value, token);
    }
    // Restore the caller's body/expression continuations on every type exit,
    // including failures after one or more type frames have been pushed.
    auto parse_type(AstArena& arena, builtin::span<const u8> source, ParseToken initial, TypeContext context,
        ParseFrame first) -> TypeResult {
        const i64 base = arena.stack_size();
        const TypeResult parsed = parse_type_frames(arena, source, initial, context, first);
        const ParseToken token = parsed.token();
        if (!arena.truncate_stack(base)) {
            return TypeResult(ParseStatus::invalid, -1, token);
        }
        return TypeResult(parsed.status(), parsed.root(), token);
    }
    // Replace the former eligibility walk with one linear candidate index.
    // Prefix frames are scratch only; primary/type parsing owns the grammar.
    auto prepare_templates(AstArena& arena, builtin::span<const u8> source, ParseToken begin, Stop stop) -> TypeResult {
        ParseToken token = begin;
        i64 head = -1;
        i64 groups = 0;
        i64 braces = 0;
        i64 boundary = -1;
        bool finished = false;
        while (!finished && token.kind() == compiler_lexer::Event::token) {
            const ParseToken next = advance(source, token);
            if (single(source, token, ';') || (single(source, token, '=') && braces == 0)) {
                finished = true;
            } else {
                if (single(source, token, '{')) {
                    if (boundary >= 0) {
                        finished = true;
                    }
                    braces = braces + 1;
                    head = -1;
                } else {
                    if (single(source, token, '}')) {
                        if (braces == 0) {
                            finished = true;
                        } else {
                            braces = braces - 1;
                            head = -1;
                            if (braces == 0 && stop == Stop::constructor_braces) {
                                finished = true;
                            }
                        }
                    } else {
                        if (single(source, token, '=')) {
                            head = -1;
                        } else {
                            if (single(source, token, '(')) {
                                if (boundary >= 0) {
                                    finished = true;
                                }
                                groups = groups + 1;
                                head = -1;
                            } else {
                                if (single(source, token, ')')) {
                                    if (groups > 0) {
                                        groups = groups - 1;
                                    } else {
                                        if (head < 0) {
                                            finished = true;
                                        } else {
                                            if (boundary < 0) {
                                                boundary = token.index();
                                            }
                                        }
                                    }
                                } else {
                                    if (single(source, token, '<')) {
                                        const ParseFrame opening = ParseFrame(FrameState::template_opening, head, -1,
                                            token.index());
                                        const i64 index = arena.stack_size();
                                        if (!arena.push(opening)) {
                                            const TypeResult error = type_error(arena, token);
                                            return error;
                                        }
                                        head = index;
                                    } else {
                                        if (single(source, token, '>') || pair(source, token, '>')) {
                                            i64 match = head;
                                            if (match >= 0) {
                                                const ParseFrame inside = arena.scratch_at(match);
                                                head = inside.min();
                                                if (pair(source, token, '>')) {
                                                    match = head;
                                                    if (match >= 0) {
                                                        const ParseFrame outer = arena.scratch_at(match);
                                                        head = outer.min();
                                                    }
                                                }
                                            }
                                            if (match < 0) {
                                                head = -1;
                                            } else {
                                                const ParseFrame opening = arena.scratch_at(match);
                                                if ((single(source, next, '(') || single(source, next, '{'))
                                                    && (boundary < 0 || opening.token() < boundary)) {
                                                    const ParseFrame candidate = ParseFrame(
                                                        FrameState::template_candidate, opening.min(), token.index(),
                                                        opening.token());
                                                    if (!arena.replace_scratch(match, candidate)) {
                                                        const TypeResult error = type_error(arena, token);
                                                        return error;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if (boundary >= 0 && head < 0) {
                finished = true;
            }
            token.update(next);
        }
        return TypeResult(ParseStatus::success, arena.stack_size(), begin);
    }
    auto finish_parse(AstArena& arena, ParseStatus status, i64 root, ParseToken token, i64 base) -> TypeResult {
        if (!arena.truncate_stack(base)) {
            return TypeResult(ParseStatus::invalid, -1, token);
        }
        return TypeResult(status, root, token);
    }
    auto failure(AstArena& arena, ParseToken token, i64 base) -> TypeResult {
        ParseStatus status = ParseStatus::invalid;
        if (arena.failure() == ArenaFailure::depth) {
            status = ParseStatus::depth_limit;
        }
        if (arena.failure() == ArenaFailure::allocation) {
            status = ParseStatus::allocation_failure;
        }
        const TypeResult result = finish_parse(arena, status, -1, token, base);
        return result;
    }
    // Append into a body arena without disturbing its continuation frames.
    // Token indices remain relative to the original invocation, not this expression.
    auto parse_into(AstArena& arena, builtin::span<const u8> source, ParseToken begin, Stop stop,
        TypeContext context) -> TypeResult {
        ParseToken token = begin;
        const i64 base = arena.stack_size();
        const TypeResult candidates = prepare_templates(arena, source, token, stop);
        if (candidates.status() != ParseStatus::success) {
            const ParseToken at = candidates.token();
            const TypeResult result = finish_parse(arena, candidates.status(), -1, at, base);
            return result;
        }
        const i64 scratch_count = candidates.root();
        i64 candidate_index = base;
        ParseFrame initial = ParseFrame(FrameState::expression_start, 1, -1, -1);
        if (stop == Stop::constructor_braces) {
            const ParseStatus status = identifier_status(source, token, false);
            if (status != ParseStatus::success) {
                const TypeResult result = finish_parse(arena, status, -1, token, base);
                return result;
            }
            const ParseToken opening = advance(source, token);
            token.update(opening);
            if (!single(source, token, '{')) {
                const TypeResult result = finish_parse(arena, ParseStatus::expected_brace_open, -1, token, base);
                return result;
            }
            const ParseToken first = advance(source, token);
            token.update(first);
            if (single(source, token, '}')) {
                const i64 root = arena.append_list(NodeKind::array_zero, begin.index(), begin.index(), token.index(),
                    -1);
                if (root < 0) {
                    const TypeResult error = failure(arena, token, base);
                    return error;
                }
                const ParseToken after = advance(source, token);
                const TypeResult result = finish_parse(arena, ParseStatus::success, root, after, base);
                return result;
            }
            const ParseFrame aggregate = ParseFrame(FrameState::constructor_arguments, begin.index(), -1,
                begin.index());
            if (!arena.push(aggregate)) {
                const TypeResult error = failure(arena, token, base);
                return error;
            }
        }
        if (!arena.push(initial)) {
            const TypeResult error = failure(arena, token, base);
            return error;
        }
        i64 value = -1;
        i64 nesting = 0;
        while (arena.stack_size() > scratch_count) {
            if (token.kind() != compiler_lexer::Event::token && token.kind() != compiler_lexer::Event::end_of_input) {
                const TypeResult result = finish_parse(arena, ParseStatus::invalid, -1, token, base);
                return result;
            }
            const ParseFrame frame = arena.frame();
            bool handled = false;
            if (frame.state() == FrameState::expression_start) {
                handled = true;
                const ParseFrame next = ParseFrame(FrameState::expression_left, frame.min(), -1, -1);
                const ParseFrame child = ParseFrame(FrameState::primary_start, 0, -1, -1);
                if (!arena.replace(next) || !arena.push(child)) {
                    const TypeResult error = failure(arena, token, base);
                    return error;
                }
            }
            if (frame.state() == FrameState::expression_left || frame.state() == FrameState::expression_right) {
                handled = true;
                if (frame.state() == FrameState::expression_right) {
                    value = arena.append(NodeKind::binary, frame.token(), frame.lhs(), value);
                    if (value < 0) {
                        const TypeResult error = failure(arena, token, base);
                        return error;
                    }
                }
                const i64 priority = precedence(source, token);
                if (priority >= frame.min()) {
                    const ParseFrame next = ParseFrame(FrameState::expression_right, frame.min(), value, token.index());
                    const ParseFrame child = ParseFrame(FrameState::expression_start, priority + 1, -1, -1);
                    const ParseToken next_token = advance(source, token);
                    token.update(next_token);
                    const AstNode left = arena.at(value);
                    if (left.depth() >= 128) {
                        const TypeResult result = finish_parse(arena, ParseStatus::depth_limit, -1, token, base);
                        return result;
                    }
                    if (!arena.replace(next) || !arena.push(child)) {
                        const TypeResult error = failure(arena, token, base);
                        return error;
                    }
                } else {
                    arena.pop();
                }
            }
            if (frame.state() == FrameState::primary_group) {
                handled = true;
                if (!single(source, token, ')')) {
                    const TypeResult result = finish_parse(arena, ParseStatus::expected_close, -1, token, base);
                    return result;
                }
                const ParseToken next_token = advance(source, token);
                token.update(next_token);
                const ParseFrame next = ParseFrame(FrameState::primary_postfix, 0, value, -1);
                if (!arena.replace(next)) {
                    const TypeResult error = failure(arena, token, base);
                    return error;
                }
            }
            if (frame.state() == FrameState::primary_unary) {
                handled = true;
                value = arena.append(NodeKind::unary, frame.token(), value, -1);
                if (value < 0) {
                    const TypeResult error = failure(arena, token, base);
                    return error;
                }
                nesting = nesting - 1;
                arena.pop();
            }
            if (frame.state() == FrameState::construct_field) {
                handled = true;
                if (!single(source, token, '.')) {
                    const TypeResult result = finish_parse(arena, ParseStatus::expected_dot, -1, token, base);
                    return result;
                }
                const ParseToken field = advance(source, token);
                token.update(field);
                const ParseStatus status = identifier_status(source, token, false);
                if (status != ParseStatus::success) {
                    const TypeResult result = finish_parse(arena, status, -1, token, base);
                    return result;
                }
                const i64 label = token.index();
                const ParseToken equals = advance(source, token);
                token.update(equals);
                if (!single(source, token, '=')) {
                    const TypeResult result = finish_parse(arena, ParseStatus::expected_equal, -1, token, base);
                    return result;
                }
                const ParseToken child_token = advance(source, token);
                token.update(child_token);
                ParseFrame next = ParseFrame(FrameState::construct_arguments, frame.min(), frame.lhs(), frame.token());
                next.designate(label);
                const ParseFrame child = ParseFrame(FrameState::expression_start, 1, -1, -1);
                if (!arena.replace(next) || !arena.push(child)) {
                    const TypeResult error = failure(arena, token, base);
                    return error;
                }
            }
            if (frame.state() == FrameState::call_arguments || frame.state() == FrameState::method_arguments
                || frame.state() == FrameState::array_arguments || frame.state() == FrameState::construct_arguments
                || frame.state() == FrameState::constructor_arguments) {
                handled = true;
                const i64 head = arena.append_field(frame.lhs(), value, frame.field());
                if (head < 0) {
                    const TypeResult error = failure(arena, token, base);
                    return error;
                }
                if (single(source, token, ',')) {
                    const ParseToken next_token = advance(source, token);
                    token.update(next_token);
                    FrameState state = frame.state();
                    if (state == FrameState::construct_arguments) {
                        state = FrameState::construct_field;
                    }
                    const ParseFrame next = ParseFrame(state, frame.min(), head, frame.token());
                    if (!arena.replace(next)) {
                        const TypeResult error = failure(arena, token, base);
                        return error;
                    }
                    if (state != FrameState::construct_field) {
                        const ParseFrame child = ParseFrame(FrameState::expression_start, 1, -1, -1);
                        if (!arena.push(child)) {
                            const TypeResult error = failure(arena, token, base);
                            return error;
                        }
                    }
                } else {
                    NodeKind kind = NodeKind::call;
                    u8 close = ')';
                    if (frame.state() == FrameState::method_arguments) {
                        kind = NodeKind::method_call;
                    }
                    if (frame.state() == FrameState::array_arguments || frame.state()
                        == FrameState::constructor_arguments) {
                        kind = NodeKind::array_literal;
                        close = '}';
                    }
                    if (frame.state() == FrameState::construct_arguments) {
                        kind = NodeKind::construct;
                        close = '}';
                    }
                    if (!single(source, token, close)) {
                        ParseStatus status = ParseStatus::expected_close;
                        if (close == '}') {
                            status = ParseStatus::expected_brace_close;
                        }
                        const TypeResult result = finish_parse(arena, status, -1, token, base);
                        return result;
                    }
                    value = arena.append_list(kind, frame.token(), frame.min(), token.index(), head);
                    if (value < 0) {
                        const TypeResult error = failure(arena, token, base);
                        return error;
                    }
                    const ParseToken next_token = advance(source, token);
                    token.update(next_token);
                    if (frame.state() == FrameState::constructor_arguments) {
                        arena.pop();
                    } else {
                        const ParseFrame next = ParseFrame(FrameState::primary_postfix, 0, value, -1);
                        if (!arena.replace(next)) {
                            const TypeResult error = failure(arena, token, base);
                            return error;
                        }
                    }
                }
            }
            if (frame.state() == FrameState::index_expression) {
                handled = true;
                const AstNode index = arena.at(value);
                if (index.depth() >= 128) {
                    const TypeResult result = finish_parse(arena, ParseStatus::depth_limit, -1, token, base);
                    return result;
                }
                if (!single(source, token, ']')) {
                    const TypeResult result = finish_parse(arena, ParseStatus::expected_index_close, -1, token, base);
                    return result;
                }
                value = arena.append_index(frame.token(), token.index(), frame.lhs(), value);
                if (value < 0) {
                    const TypeResult error = failure(arena, token, base);
                    return error;
                }
                const ParseToken next_token = advance(source, token);
                token.update(next_token);
                const ParseFrame next = ParseFrame(FrameState::primary_postfix, 0, value, -1);
                if (!arena.replace(next)) {
                    const TypeResult error = failure(arena, token, base);
                    return error;
                }
            }
            if (frame.state() == FrameState::primary_postfix) {
                handled = true;
                value = frame.lhs();
                if (single(source, token, '.')) {
                    const ParseToken member_token = advance(source, token);
                    token.update(member_token);
                    const ParseStatus status = identifier_status(source, token, false);
                    if (status != ParseStatus::success) {
                        const TypeResult result = finish_parse(arena, status, -1, token, base);
                        return result;
                    }
                    const i64 member = token.index();
                    const ParseToken next_token = advance(source, token);
                    token.update(next_token);
                    const AstNode receiver = arena.at(value);
                    if (receiver.depth() >= 128) {
                        const TypeResult result = finish_parse(arena, ParseStatus::depth_limit, -1, token, base);
                        return result;
                    }
                    if (single(source, token, '(')) {
                        const i64 head = arena.append_argument(-1, value);
                        if (head < 0) {
                            const TypeResult error = failure(arena, token, base);
                            return error;
                        }
                        const ParseToken argument_token = advance(source, token);
                        token.update(argument_token);
                        if (single(source, token, ')')) {
                            value = arena.append_list(NodeKind::method_call, member, member, token.index(), head);
                            if (value < 0) {
                                const TypeResult error = failure(arena, token, base);
                                return error;
                            }
                            const ParseToken after_call = advance(source, token);
                            token.update(after_call);
                            const ParseFrame next = ParseFrame(FrameState::primary_postfix, 0, value, -1);
                            if (!arena.replace(next)) {
                                const TypeResult error = failure(arena, token, base);
                                return error;
                            }
                        } else {
                            const ParseFrame next = ParseFrame(FrameState::method_arguments, member, head, member);
                            const ParseFrame child = ParseFrame(FrameState::expression_start, 1, -1, -1);
                            if (!arena.replace(next) || !arena.push(child)) {
                                const TypeResult error = failure(arena, token, base);
                                return error;
                            }
                        }
                    } else {
                        value = arena.append(NodeKind::member, member, value, -1);
                        if (value < 0) {
                            const TypeResult error = failure(arena, token, base);
                            return error;
                        }
                        const ParseFrame next = ParseFrame(FrameState::primary_postfix, 0, value, -1);
                        if (!arena.replace(next)) {
                            const TypeResult error = failure(arena, token, base);
                            return error;
                        }
                    }
                } else {
                    if (single(source, token, '[')) {
                        const i64 opening = token.index();
                        const ParseToken next_token = advance(source, token);
                        token.update(next_token);
                        const AstNode index_base = arena.at(value);
                        if (index_base.depth() >= 128) {
                            const TypeResult result = finish_parse(arena, ParseStatus::depth_limit, -1, token, base);
                            return result;
                        }
                        const ParseFrame next = ParseFrame(FrameState::index_expression, 0, value, opening);
                        const ParseFrame child = ParseFrame(FrameState::expression_start, 1, -1, -1);
                        if (!arena.replace(next) || !arena.push(child)) {
                            const TypeResult error = failure(arena, token, base);
                            return error;
                        }
                    } else {
                        nesting = nesting - 1;
                        arena.pop();
                    }
                }
            }
            if (frame.state() == FrameState::primary_start) {
                handled = true;
                if (nesting >= 128) {
                    const TypeResult result = finish_parse(arena, ParseStatus::nesting_limit, -1, token, base);
                    return result;
                }
                nesting = nesting + 1;
                const ParseToken original = token;
                const ParseToken next_token = advance(source, token);
                token.update(next_token);
                if (single(source, original, '(')) {
                    const ParseFrame next = ParseFrame(FrameState::primary_group, 0, -1, -1);
                    const ParseFrame child = ParseFrame(FrameState::expression_start, 1, -1, -1);
                    if (!arena.replace(next) || !arena.push(child)) {
                        const TypeResult error = failure(arena, token, base);
                        return error;
                    }
                } else {
                    if (single(source, original, '{')) {
                        if (single(source, token, '}')) {
                            value = arena.append_list(NodeKind::array_literal, original.index(), original.index(),
                                token.index(), -1);
                            if (value < 0) {
                                const TypeResult error = failure(arena, token, base);
                                return error;
                            }
                            const ParseToken after = advance(source, token);
                            token.update(after);
                            const ParseFrame next = ParseFrame(FrameState::primary_postfix, 0, value, -1);
                            if (!arena.replace(next)) {
                                const TypeResult error = failure(arena, token, base);
                                return error;
                            }
                        } else {
                            const ParseFrame next = ParseFrame(FrameState::array_arguments, original.index(), -1,
                                original.index());
                            const ParseFrame child = ParseFrame(FrameState::expression_start, 1, -1, -1);
                            if (!arena.replace(next) || !arena.push(child)) {
                                const TypeResult error = failure(arena, token, base);
                                return error;
                            }
                        }
                    } else {
                        if (single(source, original, '-') || single(source, original, '!') || single(source, original,
                            '~')) {
                            const ParseFrame next = ParseFrame(FrameState::primary_unary, 0, -1, original.index());
                            const ParseFrame child = ParseFrame(FrameState::primary_start, 0, -1, -1);
                            if (!arena.replace(next) || !arena.push(child)) {
                                const TypeResult error = failure(arena, token, base);
                                return error;
                            }
                        } else {
                            NodeKind kind = NodeKind::invalid;
                            if (original.kind() == compiler_lexer::Event::token) {
                                const u8 first = source.at(original.first());
                                if (compiler_lexer::letter(first)) {
                                    kind = NodeKind::name;
                                }
                                if (compiler_lexer::digit(first) || first == '\'' || first == '"'
                                    || boolean_literal(source, original)) {
                                    kind = NodeKind::literal;
                                }
                            }
                            if (kind == NodeKind::invalid) {
                                const TypeResult result = finish_parse(arena, ParseStatus::expected_expression, -1,
                                    token, base);
                                return result;
                            }
                            if (kind == NodeKind::literal) {
                                value = arena.append(kind, original.index(), -1, -1);
                                if (value < 0) {
                                    const TypeResult error = failure(arena, token, base);
                                    return error;
                                }
                                nesting = nesting - 1;
                                arena.pop();
                            } else {
                                i64 last = original.index();
                                while (pair(source, token, ':')) {
                                    const ParseToken component = advance(source, token);
                                    token.update(component);
                                    const ParseStatus status = identifier_status(source, token, true);
                                    if (status != ParseStatus::success) {
                                        const TypeResult result = finish_parse(arena, status, -1, token, base);
                                        return result;
                                    }
                                    last = token.index();
                                    const ParseToken after_name = advance(source, token);
                                    token.update(after_name);
                                }
                                bool seeking = true;
                                while (candidate_index < scratch_count && seeking) {
                                    const ParseFrame candidate = arena.scratch_at(candidate_index);
                                    if (candidate.token() >= token.index()) {
                                        seeking = false;
                                    } else {
                                        candidate_index = candidate_index + 1;
                                    }
                                }
                                if (single(source, token, '<') && candidate_index < scratch_count) {
                                    const ParseFrame candidate = arena.scratch_at(candidate_index);
                                    if (candidate.token() == token.index() && candidate.state()
                                        == FrameState::template_candidate) {
                                        ParseFrame type_start = ParseFrame(FrameState::type_arguments, 0, -1,
                                            original.index());
                                        type_start.designate(last);
                                        const TypeResult typed = parse_type(arena, source, token, context, type_start);
                                        const ParseToken after_type = typed.token();
                                        token.update(after_type);
                                        if (typed.status() != ParseStatus::success) {
                                            const TypeResult result = finish_parse(arena, typed.status(), -1, token,
                                                base);
                                            return result;
                                        }
                                        if (!arena.own_type(typed.root(), original.index(), 1)) {
                                            const TypeResult error = failure(arena, token, base);
                                            return error;
                                        }
                                    }
                                }
                                if (single(source, token, '(')) {
                                    const ParseToken argument_token = advance(source, token);
                                    token.update(argument_token);
                                    if (last == original.index() && type_query(source, original)) {
                                        const ParseFrame type_start = ParseFrame(FrameState::type_start, 0, -1, -1);
                                        const TypeResult reflected = parse_type(arena, source, token, context,
                                            type_start);
                                        const ParseToken after_type = reflected.token();
                                        token.update(after_type);
                                        if (reflected.status() != ParseStatus::success) {
                                            const TypeResult result = finish_parse(arena, reflected.status(), -1, token,
                                                base);
                                            return result;
                                        }
                                        if (!single(source, token, ')')) {
                                            const TypeResult result = finish_parse(arena, ParseStatus::expected_close,
                                                -1, token, base);
                                            return result;
                                        }
                                        if (!arena.own_type(reflected.root(), original.index(), 2)) {
                                            const TypeResult error = failure(arena, token, base);
                                            return error;
                                        }
                                    }
                                    if (single(source, token, ')')) {
                                        value = arena.append_list(NodeKind::call, original.index(), last, token.index(),
                                            -1);
                                        if (value < 0) {
                                            const TypeResult error = failure(arena, token, base);
                                            return error;
                                        }
                                        const ParseToken after_call = advance(source, token);
                                        token.update(after_call);
                                        const ParseFrame next = ParseFrame(FrameState::primary_postfix, 0, value, -1);
                                        if (!arena.replace(next)) {
                                            const TypeResult error = failure(arena, token, base);
                                            return error;
                                        }
                                    } else {
                                        const ParseFrame next = ParseFrame(FrameState::call_arguments, last, -1,
                                            original.index());
                                        const ParseFrame child = ParseFrame(FrameState::expression_start, 1, -1, -1);
                                        if (!arena.replace(next) || !arena.push(child)) {
                                            const TypeResult error = failure(arena, token, base);
                                            return error;
                                        }
                                    }
                                } else {
                                    if (single(source, token, '{')) {
                                        const ParseToken first = advance(source, token);
                                        token.update(first);
                                        if (single(source, token, '}')) {
                                            value = arena.append_list(NodeKind::construct, original.index(), last,
                                                token.index(), -1);
                                            if (value < 0) {
                                                const TypeResult error = failure(arena, token, base);
                                                return error;
                                            }
                                            const ParseToken after = advance(source, token);
                                            token.update(after);
                                            const ParseFrame next = ParseFrame(FrameState::primary_postfix, 0, value,
                                                -1);
                                            if (!arena.replace(next)) {
                                                const TypeResult error = failure(arena, token, base);
                                                return error;
                                            }
                                        } else {
                                            const ParseFrame next = ParseFrame(FrameState::construct_field, last, -1,
                                                original.index());
                                            if (!arena.replace(next)) {
                                                const TypeResult error = failure(arena, token, base);
                                                return error;
                                            }
                                        }
                                    } else {
                                        value = arena.append_name(original.index(), last);
                                        if (value < 0) {
                                            const TypeResult error = failure(arena, token, base);
                                            return error;
                                        }
                                        const ParseFrame next = ParseFrame(FrameState::primary_postfix, 0, value, -1);
                                        if (!arena.replace(next)) {
                                            const TypeResult error = failure(arena, token, base);
                                            return error;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if (!handled) {
                const TypeResult result = finish_parse(arena, ParseStatus::invalid, -1, token, base);
                return result;
            }
        }
        if (stop != Stop::constructor_braces && !stopped(source, token, stop)) {
            const TypeResult result = finish_parse(arena, ParseStatus::expected_end, -1, token, base);
            return result;
        }
        const TypeResult result = finish_parse(arena, ParseStatus::success, value, token, base);
        return result;
    }
    auto body_word(builtin::span<const u8> source, ParseToken token) -> SyntaxKind {
        const array<u8, 30> names = "return;static_assert;if;while;";
        const builtin::span<const u8> words = borrow_bytes(names);
        if (word_matches(source, token, words, 0, 6)) {
            return SyntaxKind::return_value;
        }
        if (word_matches(source, token, words, 7, 20)) {
            return SyntaxKind::static_assertion;
        }
        if (word_matches(source, token, words, 21, 23)) {
            return SyntaxKind::conditional;
        }
        if (word_matches(source, token, words, 24, 29)) {
            return SyntaxKind::loop;
        }
        return SyntaxKind::invalid;
    }
    auto body_else(builtin::span<const u8> source, ParseToken token) -> bool {
        const array<u8, 5> name = "else;";
        const builtin::span<const u8> words = borrow_bytes(name);
        return word_matches(source, token, words, 0, 4);
    }
    // Preserve the declaration/expression ambiguity rule of ordinary bodies.
    // This is lookahead only: the shared type parser validates the syntax.
    // Only a first-token return/if/while forces a statement. const still enters
    // type parsing, and static_assert can be a named declaration type here.
    auto starts_declaration(builtin::span<const u8> source, ParseToken begin) -> bool {
        const TypeWord kind = type_word(source, begin);
        if (kind == TypeWord::const_type || kind == TypeWord::i64_type || kind == TypeWord::u64_type || kind
            == TypeWord::u8_type || kind == TypeWord::bool_type || kind == TypeWord::own_type || kind
            == TypeWord::ref_type || kind == TypeWord::mutref_type || kind == TypeWord::array_type) {
            return true;
        }
        const SyntaxKind flow = body_word(source, begin);
        if (flow == SyntaxKind::return_value || flow == SyntaxKind::conditional || flow == SyntaxKind::loop) {
            return false;
        }
        ParseToken look = advance(source, begin);
        while (pair(source, look, ':')) {
            const ParseToken component = advance(source, look);
            const ParseToken next = advance(source, component);
            look.update(next);
        }
        if (single(source, look, '<')) {
            i64 depth = 0;
            bool finished = false;
            while (!finished) {
                if (single(source, look, '<')) {
                    depth = depth + 1;
                } else {
                    if (single(source, look, '>') || pair(source, look, '>')) {
                        depth = depth - 1;
                        if (pair(source, look, '>')) {
                            depth = depth - 1;
                        }
                        if (depth < 0) {
                            return false;
                        }
                        if (depth == 0) {
                            finished = true;
                        }
                    } else {
                        if (look.kind() != compiler_lexer::Event::token || single(source, look, ';') || single(source,
                            look, '}') || single(source, look, '(') || single(source, look, '{') || single(source, look,
                            '=')) {
                            return false;
                        }
                    }
                }
                const ParseToken next = advance(source, look);
                look.update(next);
            }
        }
        return look.kind() == compiler_lexer::Event::token && compiler_lexer::letter(source.at(look.first()));
    }
    auto body_expression(AstArena& arena, builtin::span<const u8> source, ParseToken begin, Stop stop,
        TypeContext context) -> TypeResult {
        const TypeResult parsed = parse_into(arena, source, begin, stop, context);
        const ParseToken token = parsed.token();
        if (parsed.status() == ParseStatus::expected_end) {
            ParseStatus status = ParseStatus::expected_semicolon;
            if (stop == Stop::close_parenthesis) {
                status = ParseStatus::expected_close;
            }
            return TypeResult(status, -1, token);
        }
        return TypeResult(parsed.status(), parsed.root(), token);
    }
    auto finish_statement(AstArena& arena, SyntaxNode statement, ParseToken token, i64 base) -> TypeResult {
        const i64 root = arena.append_syntax(statement);
        if (root < 0) {
            const TypeResult error = failure(arena, token, base);
            return error;
        }
        const TypeResult result = finish_parse(arena, ParseStatus::success, root, token, base);
        return result;
    }
    // Non-control statements finish before their enclosing reverse list advances.
    auto body_statement(AstArena& arena, builtin::span<const u8> source, ParseToken begin, TypeContext context,
        i64 previous) -> TypeResult {
        const i64 base = arena.stack_size();
        ParseToken token = begin;
        if (starts_declaration(source, begin)) {
            i64 mutable_binding = 1;
            if (type_word(source, token) == TypeWord::const_type) {
                mutable_binding = 0;
                const ParseToken after_const = advance(source, token);
                token.update(after_const);
            }
            const ParseFrame type_start = ParseFrame(FrameState::type_start, 0, -1, -1);
            const TypeResult typed = parse_type(arena, source, token, context, type_start);
            const ParseToken binding = typed.token();
            token.update(binding);
            if (typed.status() != ParseStatus::success) {
                const TypeResult error = finish_parse(arena, typed.status(), -1, token, base);
                return error;
            }
            if (!arena.own_type(typed.root(), begin.index(), 3)) {
                const TypeResult error = failure(arena, token, base);
                return error;
            }
            const ParseStatus binding_status = identifier_status(source, token, false);
            if (binding_status != ParseStatus::success) {
                const TypeResult error = finish_parse(arena, binding_status, -1, token, base);
                return error;
            }
            const ParseToken equals = advance(source, token);
            token.update(equals);
            if (!single(source, token, '=')) {
                const TypeResult error = finish_parse(arena, ParseStatus::expected_equal, -1, token, base);
                return error;
            }
            const ParseToken initializer = advance(source, token);
            const TypeResult expression = body_expression(arena, source, initializer, Stop::semicolon, context);
            const ParseToken end = expression.token();
            token.update(end);
            if (expression.status() != ParseStatus::success) {
                const TypeResult error = finish_parse(arena, expression.status(), -1, token, base);
                return error;
            }
            if (!single(source, token, ';')) {
                const TypeResult error = finish_parse(arena, ParseStatus::expected_semicolon, -1, token, base);
                return error;
            }
            SyntaxNode statement = SyntaxNode(SyntaxKind::local, begin.index(), token.index() + 1, previous);
            statement.bind_expression(expression.root(), -1);
            statement.bind_declaration(typed.root(), binding.index(), mutable_binding);
            const ParseToken after = advance(source, token);
            const TypeResult result = finish_statement(arena, statement, after, base);
            return result;
        }
        SyntaxKind kind = body_word(source, begin);
        if (kind == SyntaxKind::return_value || kind == SyntaxKind::static_assertion) {
            const ParseToken next = advance(source, token);
            token.update(next);
            Stop stop = Stop::semicolon;
            if (kind == SyntaxKind::static_assertion) {
                if (!single(source, token, '(')) {
                    const TypeResult error = finish_parse(arena, ParseStatus::expected_open, -1, token, base);
                    return error;
                }
                const ParseToken argument = advance(source, token);
                token.update(argument);
                stop = Stop::close_parenthesis;
            }
            const TypeResult expression = body_expression(arena, source, token, stop, context);
            const ParseToken end = expression.token();
            token.update(end);
            if (expression.status() != ParseStatus::success) {
                const TypeResult error = finish_parse(arena, expression.status(), -1, token, base);
                return error;
            }
            if (kind == SyntaxKind::static_assertion) {
                if (!single(source, token, ')')) {
                    const TypeResult error = finish_parse(arena, ParseStatus::expected_close, -1, token, base);
                    return error;
                }
                const ParseToken after_close = advance(source, token);
                token.update(after_close);
            }
            if (!single(source, token, ';')) {
                const TypeResult error = finish_parse(arena, ParseStatus::expected_semicolon, -1, token, base);
                return error;
            }
            SyntaxNode statement = SyntaxNode(kind, begin.index(), token.index() + 1, previous);
            statement.bind_expression(expression.root(), -1);
            const ParseToken after = advance(source, token);
            const TypeResult result = finish_statement(arena, statement, after, base);
            return result;
        }
        kind = SyntaxKind::expression;
        const TypeResult left = body_expression(arena, source, token, Stop::assignment, context);
        const ParseToken delimiter = left.token();
        token.update(delimiter);
        if (left.status() != ParseStatus::success) {
            const TypeResult error = finish_parse(arena, left.status(), -1, token, base);
            return error;
        }
        i64 expression = left.root();
        i64 target = -1;
        if (single(source, token, '=')) {
            const ParseToken right = advance(source, token);
            token.update(right);
            target = left.root();
            const AstNode node = arena.at(target);
            if (node.kind() == NodeKind::index) {
                kind = SyntaxKind::index_assign;
            } else {
                if (node.kind() == NodeKind::member) {
                    const AstNode receiver = arena.at(node.first());
                    if (receiver.kind() == NodeKind::name) {
                        kind = SyntaxKind::field_assign;
                    }
                } else {
                    if (node.kind() == NodeKind::name) {
                        kind = SyntaxKind::assign;
                    }
                }
            }
            // The '=' is consumed before this diagnostic, as in the host grammar.
            if (kind == SyntaxKind::expression) {
                const TypeResult error = finish_parse(arena, ParseStatus::assignment_target, -1, token, base);
                return error;
            }
            const TypeResult value = body_expression(arena, source, token, Stop::semicolon, context);
            const ParseToken end = value.token();
            token.update(end);
            if (value.status() != ParseStatus::success) {
                const TypeResult error = finish_parse(arena, value.status(), -1, token, base);
                return error;
            }
            expression = value.root();
        }
        if (!single(source, token, ';')) {
            const TypeResult error = finish_parse(arena, ParseStatus::expected_semicolon, -1, token, base);
            return error;
        }
        SyntaxNode statement = SyntaxNode(kind, begin.index(), token.index() + 1, previous);
        statement.bind_expression(expression, target);
        const ParseToken after = advance(source, token);
        const TypeResult result = finish_statement(arena, statement, after, base);
        return result;
    }
    auto open_body(AstArena& arena, builtin::span<const u8> source, ParseToken token, i64 previous,
        i64 nesting) -> TypeResult {
        // Check the block guard before requiring '{', including then/else bodies.
        if (nesting >= 128) {
            return TypeResult(ParseStatus::block_nesting_limit, -1, token);
        }
        if (!single(source, token, '{')) {
            return TypeResult(ParseStatus::expected_brace_open, -1, token);
        }
        const ParseFrame block = ParseFrame(FrameState::body_block, previous, -1, token.index());
        if (!arena.push(block)) {
            const TypeResult error = type_error(arena, token);
            return error;
        }
        const ParseToken next = advance(source, token);
        return TypeResult(ParseStatus::success, -1, next);
    }
    auto parse_body(AstArena& arena, builtin::span<const u8> source, ParseToken begin,
        TypeContext context) -> TypeResult {
        const i64 base = arena.stack_size();
        const TypeResult opening = open_body(arena, source, begin, -1, 0);
        ParseToken token = opening.token();
        if (opening.status() != ParseStatus::success) {
            const TypeResult error = finish_parse(arena, opening.status(), -1, token, base);
            return error;
        }
        // Count braces, not frames: if/while continuations do not add block depth.
        // At depth d there are at most d blocks and d-1 control continuations.
        i64 nesting = 1;
        i64 value = -1;
        bool completed = false;
        while (arena.stack_size() > base) {
            const ParseFrame frame = arena.frame();
            if (frame.state() == FrameState::body_block) {
                if (completed) {
                    const ParseFrame next = ParseFrame(FrameState::body_block, frame.min(), value, frame.token());
                    if (!arena.replace(next)) {
                        const TypeResult error = failure(arena, token, base);
                        return error;
                    }
                    completed = false;
                } else {
                    if (single(source, token, '}')) {
                        SyntaxNode block = SyntaxNode(SyntaxKind::block, frame.token(), token.index() + 1, frame.min());
                        block.bind_body(frame.lhs(), -1);
                        value = arena.append_syntax(block);
                        if (value < 0) {
                            const TypeResult error = failure(arena, token, base);
                            return error;
                        }
                        arena.pop();
                        nesting = nesting - 1;
                        completed = true;
                        const ParseToken after = advance(source, token);
                        token.update(after);
                    } else {
                        if (token.kind() == compiler_lexer::Event::end_of_input) {
                            const TypeResult error = finish_parse(arena, ParseStatus::unterminated_block, -1, token,
                                base);
                            return error;
                        }
                        if (token.kind() != compiler_lexer::Event::token) {
                            const TypeResult error = finish_parse(arena, ParseStatus::invalid, -1, token, base);
                            return error;
                        }
                        if (single(source, token, '{')) {
                            const TypeResult child = open_body(arena, source, token, frame.lhs(), nesting);
                            const ParseToken next = child.token();
                            token.update(next);
                            if (child.status() != ParseStatus::success) {
                                const TypeResult error = finish_parse(arena, child.status(), -1, token, base);
                                return error;
                            }
                            nesting = nesting + 1;
                        } else {
                            const SyntaxKind kind = body_word(source, token);
                            if (kind == SyntaxKind::conditional || kind == SyntaxKind::loop) {
                                const i64 first = token.index();
                                const ParseToken after_keyword = advance(source, token);
                                token.update(after_keyword);
                                if (!single(source, token, '(')) {
                                    const TypeResult error = finish_parse(arena, ParseStatus::expected_open, -1, token,
                                        base);
                                    return error;
                                }
                                const ParseToken condition = advance(source, token);
                                const TypeResult expression = body_expression(arena, source, condition,
                                    Stop::close_parenthesis, context);
                                const ParseToken end = expression.token();
                                token.update(end);
                                if (expression.status() != ParseStatus::success) {
                                    const TypeResult error = finish_parse(arena, expression.status(), -1, token, base);
                                    return error;
                                }
                                if (!single(source, token, ')')) {
                                    const TypeResult error = finish_parse(arena, ParseStatus::expected_close, -1, token,
                                        base);
                                    return error;
                                }
                                const ParseToken after_close = advance(source, token);
                                token.update(after_close);
                                FrameState state = FrameState::body_if_then;
                                if (kind == SyntaxKind::loop) {
                                    state = FrameState::body_while;
                                }
                                const ParseFrame control = ParseFrame(state, frame.lhs(), expression.root(), first);
                                if (!arena.push(control)) {
                                    const TypeResult error = failure(arena, token, base);
                                    return error;
                                }
                                const TypeResult child = open_body(arena, source, token, -1, nesting);
                                const ParseToken next = child.token();
                                token.update(next);
                                if (child.status() != ParseStatus::success) {
                                    const TypeResult error = finish_parse(arena, child.status(), -1, token, base);
                                    return error;
                                }
                                nesting = nesting + 1;
                            } else {
                                const TypeResult statement = body_statement(arena, source, token, context, frame.lhs());
                                const ParseToken next = statement.token();
                                token.update(next);
                                if (statement.status() != ParseStatus::success) {
                                    const TypeResult error = finish_parse(arena, statement.status(), -1, token, base);
                                    return error;
                                }
                                const ParseFrame next_frame = ParseFrame(FrameState::body_block, frame.min(),
                                    statement.root(), frame.token());
                                if (!arena.replace(next_frame)) {
                                    const TypeResult error = failure(arena, token, base);
                                    return error;
                                }
                            }
                        }
                    }
                }
            } else {
                if (!completed || (frame.state() != FrameState::body_if_then && frame.state()
                    != FrameState::body_if_else && frame.state() != FrameState::body_while)) {
                    const TypeResult error = finish_parse(arena, ParseStatus::invalid, -1, token, base);
                    return error;
                }
                if (frame.state() == FrameState::body_if_then && body_else(source, token)) {
                    ParseFrame control = ParseFrame(FrameState::body_if_else, frame.min(), frame.lhs(), frame.token());
                    control.designate(value);
                    if (!arena.replace(control)) {
                        const TypeResult error = failure(arena, token, base);
                        return error;
                    }
                    const ParseToken after_else = advance(source, token);
                    token.update(after_else);
                    const TypeResult child = open_body(arena, source, token, -1, nesting);
                    const ParseToken next = child.token();
                    token.update(next);
                    if (child.status() != ParseStatus::success) {
                        const TypeResult error = finish_parse(arena, child.status(), -1, token, base);
                        return error;
                    }
                    nesting = nesting + 1;
                    completed = false;
                } else {
                    SyntaxKind kind = SyntaxKind::conditional;
                    i64 body = value;
                    i64 other = -1;
                    if (frame.state() == FrameState::body_while) {
                        kind = SyntaxKind::loop;
                    }
                    if (frame.state() == FrameState::body_if_else) {
                        body = frame.field();
                        other = value;
                    }
                    SyntaxNode statement = SyntaxNode(kind, frame.token(), token.index(), frame.min());
                    statement.bind_expression(frame.lhs(), -1);
                    statement.bind_body(body, other);
                    value = arena.append_syntax(statement);
                    if (value < 0) {
                        const TypeResult error = failure(arena, token, base);
                        return error;
                    }
                    arena.pop();
                }
            }
        }
        const TypeResult result = finish_parse(arena, ParseStatus::success, value, token, base);
        return result;
    }
    // Complete field grammar precedes declaration admission in the host.
    auto parse_field(AstArena& arena, builtin::span<const u8> source, ParseToken begin,
        TypeContext context) -> TypeResult {
        const i64 base = arena.stack_size();
        const ParseFrame type_start = ParseFrame(FrameState::type_start, 0, -1, -1);
        const TypeResult typed = parse_type(arena, source, begin, context, type_start);
        const ParseToken binding = typed.token();
        if (typed.status() != ParseStatus::success) {
            const TypeResult error = finish_parse(arena, typed.status(), -1, binding, base);
            return error;
        }
        const ParseStatus identifier = identifier_status(source, binding, false);
        if (identifier != ParseStatus::success) {
            const TypeResult error = finish_parse(arena, identifier, -1, binding, base);
            return error;
        }
        const ParseToken semicolon = advance(source, binding);
        if (!single(source, semicolon, ';')) {
            const TypeResult error = finish_parse(arena, ParseStatus::expected_semicolon, -1, semicolon, base);
            return error;
        }
        if (!arena.own_type(typed.root(), begin.index(), 3)) {
            const TypeResult error = failure(arena, semicolon, base);
            return error;
        }
        const ParseToken after = advance(source, semicolon);
        SyntaxNode field = SyntaxNode(SyntaxKind::field, begin.index(), after.index(), -1);
        field.bind_declaration(typed.root(), binding.index(), 0);
        const TypeResult result = finish_statement(arena, field, after, base);
        return result;
    }
    // Parameters and initializer lists are flat reverse-linked syntax lists.
    // Admission is deliberately deferred until the complete callable grammar
    // succeeds; no service or resolved ownership policy lives in this parser.
    auto callable_parameters(AstArena& arena, builtin::span<const u8> source, ParseToken begin,
        TypeContext context) -> TypeResult {
        const i64 base = arena.stack_size();
        ParseToken token = begin;
        i64 tail = -1;
        if (!single(source, token, '(')) {
            return TypeResult(ParseStatus::expected_open, -1, token);
        }
        const ParseToken first = advance(source, token);
        token.update(first);
        if (!single(source, token, ')')) {
            bool more = true;
            while (more) {
                const i64 start = token.index();
                i64 readonly = 0;
                if (type_word(source, token) == TypeWord::const_type) {
                    readonly = 1;
                    const ParseToken after = advance(source, token);
                    token.update(after);
                }
                const ParseFrame type_start = ParseFrame(FrameState::type_start, 0, -1, -1);
                const TypeResult typed = parse_type(arena, source, token, context, type_start);
                const ParseToken after_type = typed.token();
                token.update(after_type);
                if (typed.status() != ParseStatus::success) {
                    return TypeResult(typed.status(), -1, token);
                }
                if (!arena.own_type(typed.root(), start, 3)) {
                    return TypeResult(ParseStatus::invalid, -1, token);
                }
                i64 borrowed = -1;
                if (single(source, token, '&')) {
                    borrowed = token.index();
                    const ParseToken after = advance(source, token);
                    token.update(after);
                }
                const ParseStatus identifier = identifier_status(source, token, false);
                if (identifier != ParseStatus::success) {
                    return TypeResult(identifier, -1, token);
                }
                const i64 binding = token.index();
                const ParseToken after_name = advance(source, token);
                token.update(after_name);
                SyntaxNode parameter = SyntaxNode(SyntaxKind::parameter, start, token.index(), tail);
                parameter.bind_declaration(typed.root(), binding, readonly);
                parameter.bind_borrow(borrowed);
                tail = arena.append_syntax(parameter);
                if (tail < 0) {
                    const TypeResult error = failure(arena, token, base);
                    return error;
                }
                more = single(source, token, ',');
                if (more) {
                    const ParseToken after = advance(source, token);
                    token.update(after);
                }
            }
        }
        if (!single(source, token, ')')) {
            return TypeResult(ParseStatus::expected_close, -1, token);
        }
        const ParseToken after = advance(source, token);
        return TypeResult(ParseStatus::success, tail, after);
    }
    auto constructor_initializers(AstArena& arena, builtin::span<const u8> source, ParseToken begin,
        TypeContext context) -> TypeResult {
        const i64 base = arena.stack_size();
        ParseToken token = begin;
        i64 tail = -1;
        if (single(source, token, ':')) {
            const ParseToken first = advance(source, token);
            token.update(first);
            bool more = true;
            while (more) {
                const ParseToken field = token;
                const ParseStatus identifier = identifier_status(source, field, false);
                if (identifier != ParseStatus::success) {
                    return TypeResult(identifier, -1, field);
                }
                const ParseToken after_field = advance(source, field);
                token.update(after_field);
                i64 expression = -1;
                if (single(source, token, '{')) {
                    const TypeResult parsed = parse_into(arena, source, field, Stop::constructor_braces, context);
                    const ParseToken after = parsed.token();
                    token.update(after);
                    if (parsed.status() != ParseStatus::success) {
                        return TypeResult(parsed.status(), -1, token);
                    }
                    expression = parsed.root();
                } else {
                    if (!single(source, token, '(')) {
                        return TypeResult(ParseStatus::expected_open, -1, token);
                    }
                    const ParseToken first_value = advance(source, token);
                    const TypeResult parsed = body_expression(arena, source, first_value, Stop::close_parenthesis,
                        context);
                    const ParseToken after = parsed.token();
                    token.update(after);
                    if (parsed.status() != ParseStatus::success) {
                        return TypeResult(parsed.status(), -1, token);
                    }
                    expression = parsed.root();
                    if (!single(source, token, ')')) {
                        return TypeResult(ParseStatus::expected_close, -1, token);
                    }
                    const ParseToken close = advance(source, token);
                    token.update(close);
                }
                SyntaxNode initializer = SyntaxNode(SyntaxKind::initializer, field.index(), token.index(), tail);
                initializer.bind_expression(expression, -1);
                tail = arena.append_syntax(initializer);
                if (tail < 0) {
                    const TypeResult error = failure(arena, token, base);
                    return error;
                }
                more = single(source, token, ',');
                if (more) {
                    const ParseToken after = advance(source, token);
                    token.update(after);
                }
            }
        }
        if (!single(source, token, '{')) {
            return TypeResult(ParseStatus::expected_brace_open, -1, token);
        }
        const ParseToken close = advance(source, token);
        if (!single(source, close, '}')) {
            return TypeResult(ParseStatus::expected_brace_close, -1, close);
        }
        const ParseToken after = advance(source, close);
        return TypeResult(ParseStatus::success, tail, after);
    }
    auto parse_callable(AstArena& arena, builtin::span<const u8> source, ParseToken begin, Stop stop,
        TypeContext context) -> TypeResult {
        const i64 base = arena.stack_size();
        ParseToken token = begin;
        if (stop != Stop::constructor) {
            const array<u8, 4> spelling = "auto";
            const builtin::span<const u8> word = borrow_bytes(spelling);
            if (!word_matches(source, token, word, 0, 4)) {
                return TypeResult(ParseStatus::expected_auto, -1, token);
            }
            const ParseToken after = advance(source, token);
            token.update(after);
        }
        const ParseStatus identifier = identifier_status(source, token, stop == Stop::constructor);
        if (identifier != ParseStatus::success) {
            return TypeResult(identifier, -1, token);
        }
        const i64 name = token.index();
        const ParseToken first = advance(source, token);
        const TypeResult parameters = callable_parameters(arena, source, first, context);
        const ParseToken after_parameters = parameters.token();
        token.update(after_parameters);
        if (parameters.status() != ParseStatus::success) {
            return TypeResult(parameters.status(), -1, token);
        }
        i64 declared_type = -1;
        i64 readonly = 0;
        i64 body = -1;
        SyntaxKind kind = SyntaxKind::constructor;
        if (stop == Stop::constructor) {
            const TypeResult initializers = constructor_initializers(arena, source, token, context);
            const ParseToken after = initializers.token();
            token.update(after);
            if (initializers.status() != ParseStatus::success) {
                return TypeResult(initializers.status(), -1, token);
            }
            body = initializers.root();
        } else {
            kind = SyntaxKind::function;
            if (stop == Stop::method) {
                kind = SyntaxKind::method;
                if (type_word(source, token) == TypeWord::const_type) {
                    readonly = 1;
                    const ParseToken after = advance(source, token);
                    token.update(after);
                }
            }
            if (token.last() - token.first() != 2 || source.at(token.first()) != '-' || source.at(token.first() + 1)
                != '>') {
                return TypeResult(ParseStatus::expected_arrow, -1, token);
            }
            const ParseToken first_type = advance(source, token);
            const ParseFrame type_start = ParseFrame(FrameState::type_start, 0, -1, -1);
            const TypeResult typed = parse_type(arena, source, first_type, context, type_start);
            const ParseToken after_type = typed.token();
            token.update(after_type);
            if (typed.status() != ParseStatus::success) {
                return TypeResult(typed.status(), -1, token);
            }
            declared_type = typed.root();
            if (!arena.own_type(declared_type, name, 3)) {
                return TypeResult(ParseStatus::invalid, -1, token);
            }
            const TypeResult parsed = parse_body(arena, source, token, context);
            const ParseToken after_body = parsed.token();
            token.update(after_body);
            if (parsed.status() != ParseStatus::success) {
                return TypeResult(parsed.status(), -1, token);
            }
            body = parsed.root();
        }
        SyntaxNode callable = SyntaxNode(kind, name, token.index(), -1);
        callable.bind_declaration(declared_type, -1, readonly);
        callable.bind_body(body, parameters.root());
        const i64 root = arena.append_syntax(callable);
        if (root < 0) {
            const TypeResult error = failure(arena, token, base);
            return error;
        }
        return TypeResult(ParseStatus::success, root, token);
    }
}

export namespace compiler_parser {
    auto parse(AstArena& arena, builtin::span<const u8> source, compiler_lexer::Cursor cursor, Stop stop,
        TypeContext context) -> ParseResult {
        const ParseToken token = read_token(source, cursor, 0);
        if ((stop != Stop::semicolon && stop != Stop::close_parenthesis && stop != Stop::assignment && stop
            != Stop::constructor_braces && stop != Stop::body && stop != Stop::type && stop != Stop::function && stop
            != Stop::method && stop != Stop::constructor && stop != Stop::field) || arena.size() != 0
            || arena.stack_size() != 0 || arena.arguments() != 0 || arena.types() != 0 || arena.syntax_size() != 0) {
            return ParseResult(ParseStatus::invalid, -1, arena.size(), 0, token.first(), token.half());
        }
        if (!arena.ok()) {
            return ParseResult(ParseStatus::allocation_failure, -1, 0, 0, token.first(), token.half());
        }
        if (!valid_context(source, context)) {
            return ParseResult(ParseStatus::invalid, -1, 0, 0, token.first(), token.half());
        }
        if (stop == Stop::field) {
            const TypeResult result = parse_field(arena, source, token, context);
            const ParseToken at = result.token();
            return ParseResult(result.status(), result.root(), arena.size(), at.index(), at.first(), at.half());
        }
        if (stop == Stop::function || stop == Stop::method || stop == Stop::constructor) {
            const TypeResult result = parse_callable(arena, source, token, stop, context);
            const ParseToken at = result.token();
            return ParseResult(result.status(), result.root(), arena.size(), at.index(), at.first(), at.half());
        }
        if (stop == Stop::type) {
            const ParseFrame first = ParseFrame(FrameState::type_start, 0, -1, -1);
            const TypeResult result = parse_type(arena, source, token, context, first);
            const ParseToken at = result.token();
            if (result.status() == ParseStatus::success && !arena.own_type(result.root(), 0, 3)) {
                return ParseResult(ParseStatus::invalid, -1, 0, at.index(), at.first(), at.half());
            }
            return ParseResult(result.status(), result.root(), arena.size(), at.index(), at.first(), at.half());
        }
        if (stop == Stop::body) {
            const TypeResult result = parse_body(arena, source, token, context);
            const ParseToken at = result.token();
            return ParseResult(result.status(), result.root(), arena.size(), at.index(), at.first(), at.half());
        }
        const TypeResult result = parse_into(arena, source, token, stop, context);
        const ParseToken at = result.token();
        return ParseResult(result.status(), result.root(), arena.size(), at.index(), at.first(), at.half());
    }
    auto create(builtin::ByteRegion region, i64 capacity) -> AstArena {
        AstArena arena = make_arena(region, capacity);
        return move(arena);
    }
    auto node_count(const AstArena& arena) -> i64 {
        return arena.size();
    }
    auto read_node(const AstArena& arena, i64 index) -> AstNode {
        const AstNode node = arena.at(index);
        return node;
    }
    auto edge_count(const AstArena& arena) -> i64 {
        return arena.arguments();
    }
    auto read_edge(const AstArena& arena, i64 index) -> ChildEdge {
        const ChildEdge edge = arena.edge(index);
        return edge;
    }
    auto type_count(const AstArena& arena) -> i64 {
        return arena.types();
    }
    auto read_type(const AstArena& arena, i64 index) -> TypeSyntax {
        const TypeSyntax type = arena.type_at(index);
        return type;
    }
    auto syntax_count(const AstArena& arena) -> i64 {
        return arena.syntax_size();
    }
    auto read_syntax(const AstArena& arena, i64 index) -> SyntaxNode {
        const SyntaxNode statement = arena.syntax_at(index);
        return statement;
    }
    auto release(builtin::ByteRegion region, AstArena arena) -> i64 {
        return 0;
    }
}
