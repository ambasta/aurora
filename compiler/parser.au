                                return error;
                            }
                        } else {
                            NodeKind kind = NodeKind::invalid;
                            if (original.kind() == compiler_lexer::Event::token) {
                                const u8 first = source.at(original.first());
                                if (compiler_lexer::letter(first)) {
                                    kind = NodeKind::name;
                                }
                                if (compiler_lexer::digit(first) || first == '\'' || first == '"'
                                    || boolean_literal(source, original)) {
                                    kind = NodeKind::literal;
                                }
                            }
                            if (kind == NodeKind::invalid) {
                                const TypeResult result = finish_parse(arena, ParseStatus::expected_expression, -1,
                                    token, base);
                                return result;
                            }
                            if (kind == NodeKind::literal) {
                                value = arena.append(kind, original.index(), -1, -1);
                                if (value < 0) {
                                    const TypeResult error = failure(arena, token, base);
                                    return error;
                                }
                                nesting = nesting - 1;
                                arena.pop();
                            } else {
                                i64 last = original.index();
                                while (pair(source, token, ':')) {
                                    token.update(advance(source, token));
                                    const ParseStatus status = identifier_status(source, token, true);
                                    if (status != ParseStatus::success) {
                                        const TypeResult result = finish_parse(arena, status, -1, token, base);
                                        return result;
                                    }
                                    last = token.index();
                                    token.update(advance(source, token));
                                }
                                bool seeking = true;
                                while (candidate_index < scratch_count && seeking) {
                                    const ParseFrame candidate = arena.scratch_at(candidate_index);
                                    if (candidate.token() >= token.index()) {
                                        seeking = false;
                                    } else {
                                        candidate_index = candidate_index + 1;
                                    }
                                }
                                if (single(source, token, '<') && candidate_index < scratch_count) {
                                    const ParseFrame candidate = arena.scratch_at(candidate_index);
                                    if (candidate.token() == token.index() && candidate.state()
                                        == FrameState::template_candidate) {
                                        ParseFrame type_start = ParseFrame(FrameState::type_arguments, 0, -1,
                                            original.index());
                                        type_start.designate(last);
                                        const TypeResult typed = parse_type(arena, source, token, context, type_start);
                                        token.update(typed.token());
                                        if (typed.status() != ParseStatus::success) {
                                            const TypeResult result = finish_parse(arena, typed.status(), -1, token,
                                                base);
                                            return result;
                                        }
                                        if (!arena.own_type(typed.root(), original.index(), 1)) {
                                            const TypeResult error = failure(arena, token, base);
                                            return error;
                                        }
                                    }
                                }
                                if (single(source, token, '(')) {
                                    token.update(advance(source, token));
                                    if (last == original.index() && type_query(source, original)) {
                                        const ParseFrame type_start = ParseFrame(FrameState::type_start, 0, -1, -1);
                                        const TypeResult reflected = parse_type(arena, source, token, context,
                                            type_start);
                                        token.update(reflected.token());
                                        if (reflected.status() != ParseStatus::success) {
                                            const TypeResult result = finish_parse(arena, reflected.status(), -1, token,
                                                base);
                                            return result;
                                        }
                                        if (!single(source, token, ')')) {
                                            const TypeResult result = finish_parse(arena, ParseStatus::expected_close,
                                                -1, token, base);
                                            return result;
                                        }
                                        if (!arena.own_type(reflected.root(), original.index(), 2)) {
                                            const TypeResult error = failure(arena, token, base);
                                            return error;
                                        }
                                    }
                                    if (single(source, token, ')')) {
                                        value = arena.append_list(NodeKind::call, original.index(), last, token.index(),
                                            -1);
                                        if (value < 0) {
                                            const TypeResult error = failure(arena, token, base);
                                            return error;
                                        }
                                        token.update(advance(source, token));
                                        const ParseFrame next = ParseFrame(FrameState::primary_postfix, 0, value, -1);
                                        if (!arena.replace(next)) {
                                            const TypeResult error = failure(arena, token, base);
                                            return error;
                                        }
                                    } else {
                                        const ParseFrame next = ParseFrame(FrameState::call_arguments, last, -1,
                                            original.index());
                                        const ParseFrame child = ParseFrame(FrameState::expression_start, 1, -1, -1);
                                        if (!arena.replace(next) || !arena.push(child)) {
                                            const TypeResult error = failure(arena, token, base);
                                            return error;
                                        }
                                    }
                                } else {
                                    if (single(source, token, '{')) {
                                        token.update(advance(source, token));
                                        if (single(source, token, '}')) {
                                            value = arena.append_list(NodeKind::construct, original.index(), last,
                                                token.index(), -1);
                                            if (value < 0) {
                                                const TypeResult error = failure(arena, token, base);
                                                return error;
                                            }
                                            token.update(advance(source, token));
                                            const ParseFrame next = ParseFrame(FrameState::primary_postfix, 0, value,
                                                -1);
                                            if (!arena.replace(next)) {
                                                const TypeResult error = failure(arena, token, base);
                                                return error;
                                            }
                                        } else {
                                            const ParseFrame next = ParseFrame(FrameState::construct_field, last, -1,
                                                original.index());
                                            if (!arena.replace(next)) {
                                                const TypeResult error = failure(arena, token, base);
                                                return error;
                                            }
                                        }
                                    } else {
                                        value = arena.append_name(original.index(), last);
                                        if (value < 0) {
                                            const TypeResult error = failure(arena, token, base);
                                            return error;
                                        }
                                        const ParseFrame next = ParseFrame(FrameState::primary_postfix, 0, value, -1);
                                        if (!arena.replace(next)) {
                                            const TypeResult error = failure(arena, token, base);
                                            return error;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if (!handled) {
                const TypeResult result = finish_parse(arena, ParseStatus::invalid, -1, token, base);
                return result;
            }
        }
        if (stop != Stop::constructor_braces && !stopped(source, token, stop)) {
            const TypeResult result = finish_parse(arena, ParseStatus::expected_end, -1, token, base);
            return result;
        }
        const TypeResult result = finish_parse(arena, ParseStatus::success, value, token, base);
        return result;
    }
    auto body_word(builtin::span<const u8> source, ParseToken token) -> SyntaxKind {
        const array<u8, 30> names = "return;static_assert;if;while;";
        const builtin::span<const u8> words = borrow_bytes(names);
        if (word_matches(source, token, words, 0, 6)) {
            return SyntaxKind::return_value;
        }
        if (word_matches(source, token, words, 7, 20)) {
            return SyntaxKind::static_assertion;
        }
        if (word_matches(source, token, words, 21, 23)) {
            return SyntaxKind::conditional;
        }
        if (word_matches(source, token, words, 24, 29)) {
            return SyntaxKind::loop;
        }
        return SyntaxKind::invalid;
    }
    auto body_else(builtin::span<const u8> source, ParseToken token) -> bool {
        const array<u8, 5> name = "else;";
        const builtin::span<const u8> words = borrow_bytes(name);
        return word_matches(source, token, words, 0, 4);
    }
    // Preserve the declaration/expression ambiguity rule of ordinary bodies.
    // This is lookahead only: the shared type parser validates the syntax.
    // Only a first-token return/if/while forces a statement. const still enters
    // type parsing, and static_assert can be a named declaration type here.
    auto starts_declaration(builtin::span<const u8> source, ParseToken begin) -> bool {
        const TypeWord kind = type_word(source, begin);
        if (kind == TypeWord::const_type || kind == TypeWord::i64_type || kind == TypeWord::u64_type || kind
            == TypeWord::u8_type || kind == TypeWord::bool_type || kind == TypeWord::own_type || kind
            == TypeWord::ref_type || kind == TypeWord::mutref_type || kind == TypeWord::array_type) {
            return true;
        }
        const SyntaxKind flow = body_word(source, begin);
        if (flow == SyntaxKind::return_value || flow == SyntaxKind::conditional || flow == SyntaxKind::loop) {
            return false;
        }
        ParseToken look = advance(source, begin);
        while (pair(source, look, ':')) {
            const ParseToken component = advance(source, look);
            look.update(advance(source, component));
        }
        if (single(source, look, '<')) {
            i64 depth = 0;
            bool finished = false;
            while (!finished) {
                if (single(source, look, '<')) {
                    depth = depth + 1;
                } else {
                    if (single(source, look, '>') || pair(source, look, '>')) {
                        depth = depth - 1;
                        if (pair(source, look, '>')) {
                            depth = depth - 1;
                        }
                        if (depth < 0) {
                            return false;
                        }
                        if (depth == 0) {
                            finished = true;
                        }
                    } else {
                        if (look.kind() != compiler_lexer::Event::token || single(source, look, ';') || single(source,
                            look, '}') || single(source, look, '(') || single(source, look, '{') || single(source, look,
                            '=')) {
                            return false;
                        }
                    }
                }
                look.update(advance(source, look));
            }
        }
        return look.kind() == compiler_lexer::Event::token && compiler_lexer::letter(source.at(look.first()));
    }
    auto body_expression(AstArena& arena, builtin::span<const u8> source, ParseToken begin, Stop stop,
        TypeContext context) -> TypeResult {
        const TypeResult parsed = parse_into(arena, source, begin, stop, context);
        const ParseToken token = parsed.token();
        if (parsed.status() == ParseStatus::expected_end) {
            ParseStatus status = ParseStatus::expected_semicolon;
            if (stop == Stop::close_parenthesis) {
                status = ParseStatus::expected_close;
            }
            return TypeResult(status, -1, token);
        }
        return TypeResult(parsed.status(), parsed.root(), token);
    }
    auto finish_statement(AstArena& arena, SyntaxNode statement, ParseToken token, i64 base) -> TypeResult {
        const i64 root = arena.append_syntax(statement);
        if (root < 0) {
            const TypeResult error = failure(arena, token, base);
            return error;
        }
        const TypeResult result = finish_parse(arena, ParseStatus::success, root, token, base);
        return result;
    }
    // Non-control statements finish before their enclosing reverse list advances.
    auto body_statement(AstArena& arena, builtin::span<const u8> source, ParseToken begin, TypeContext context,
        i64 previous) -> TypeResult {
        const i64 base = arena.stack_size();
        ParseToken token = begin;
        if (starts_declaration(source, begin)) {
            i64 mutable_binding = 1;
            if (type_word(source, token) == TypeWord::const_type) {
                mutable_binding = 0;
                token.update(advance(source, token));
            }
            const ParseFrame type_start = ParseFrame(FrameState::type_start, 0, -1, -1);
            const TypeResult typed = parse_type(arena, source, token, context, type_start);
            const ParseToken binding = typed.token();
            token.update(binding);
            if (typed.status() != ParseStatus::success) {
                const TypeResult error = finish_parse(arena, typed.status(), -1, token, base);
                return error;
            }
            if (!arena.own_type(typed.root(), begin.index(), 3)) {
                const TypeResult error = failure(arena, token, base);
                return error;
            }
            const ParseStatus binding_status = identifier_status(source, token, false);
            if (binding_status != ParseStatus::success) {
                const TypeResult error = finish_parse(arena, binding_status, -1, token, base);
                return error;
            }
            token.update(advance(source, token));
            if (!single(source, token, '=')) {
                const TypeResult error = finish_parse(arena, ParseStatus::expected_equal, -1, token, base);
                return error;
            }
            const ParseToken initializer = advance(source, token);
            const TypeResult expression = body_expression(arena, source, initializer, Stop::semicolon, context);
            token.update(expression.token());
            if (expression.status() != ParseStatus::success) {
                const TypeResult error = finish_parse(arena, expression.status(), -1, token, base);
                return error;
            }
            if (!single(source, token, ';')) {
                const TypeResult error = finish_parse(arena, ParseStatus::expected_semicolon, -1, token, base);
                return error;
            }
            SyntaxNode statement = SyntaxNode(SyntaxKind::local, begin.index(), token.index() + 1, previous);
            statement.bind_expression(expression.root(), -1);
            statement.bind_declaration(typed.root(), binding.index(), mutable_binding);
            const ParseToken after = advance(source, token);
            const TypeResult result = finish_statement(arena, statement, after, base);
            return result;
        }
        SyntaxKind kind = body_word(source, begin);
        if (kind == SyntaxKind::return_value || kind == SyntaxKind::static_assertion) {
            token.update(advance(source, token));
            Stop stop = Stop::semicolon;
            if (kind == SyntaxKind::static_assertion) {
                if (!single(source, token, '(')) {
                    const TypeResult error = finish_parse(arena, ParseStatus::expected_open, -1, token, base);
                    return error;
                }
                token.update(advance(source, token));
                stop = Stop::close_parenthesis;
            }
            const TypeResult expression = body_expression(arena, source, token, stop, context);
            token.update(expression.token());
            if (expression.status() != ParseStatus::success) {
                const TypeResult error = finish_parse(arena, expression.status(), -1, token, base);
                return error;
            }
            if (kind == SyntaxKind::static_assertion) {
                if (!single(source, token, ')')) {
                    const TypeResult error = finish_parse(arena, ParseStatus::expected_close, -1, token, base);
                    return error;
                }
                token.update(advance(source, token));
            }
            if (!single(source, token, ';')) {
                const TypeResult error = finish_parse(arena, ParseStatus::expected_semicolon, -1, token, base);
                return error;
            }
            SyntaxNode statement = SyntaxNode(kind, begin.index(), token.index() + 1, previous);
            statement.bind_expression(expression.root(), -1);
            const ParseToken after = advance(source, token);
            const TypeResult result = finish_statement(arena, statement, after, base);
            return result;
        }
        kind = SyntaxKind::expression;
        const TypeResult left = body_expression(arena, source, token, Stop::assignment, context);
        token.update(left.token());
        if (left.status() != ParseStatus::success) {
            const TypeResult error = finish_parse(arena, left.status(), -1, token, base);
            return error;
        }
        i64 expression = left.root();
        i64 target = -1;
        if (single(source, token, '=')) {
            token.update(advance(source, token));
            target = left.root();
            const AstNode node = arena.at(target);
            if (node.kind() == NodeKind::index) {
                kind = SyntaxKind::index_assign;
            } else {
                if (node.kind() == NodeKind::member) {
                    const AstNode receiver = arena.at(node.first());
                    if (receiver.kind() == NodeKind::name) {
                        kind = SyntaxKind::field_assign;
                    }
                } else {
                    if (node.kind() == NodeKind::name) {
                        kind = SyntaxKind::assign;
                    }
                }
            }
            // The '=' is consumed before this diagnostic, as in the host grammar.
            if (kind == SyntaxKind::expression) {
                const TypeResult error = finish_parse(arena, ParseStatus::assignment_target, -1, token, base);
                return error;
            }
            const TypeResult value = body_expression(arena, source, token, Stop::semicolon, context);
            token.update(value.token());
            if (value.status() != ParseStatus::success) {
                const TypeResult error = finish_parse(arena, value.status(), -1, token, base);
                return error;
            }
            expression = value.root();
        }
        if (!single(source, token, ';')) {
            const TypeResult error = finish_parse(arena, ParseStatus::expected_semicolon, -1, token, base);
            return error;
        }
        SyntaxNode statement = SyntaxNode(kind, begin.index(), token.index() + 1, previous);
        statement.bind_expression(expression, target);
        const ParseToken after = advance(source, token);
        const TypeResult result = finish_statement(arena, statement, after, base);
        return result;
    }
    auto open_body(AstArena& arena, builtin::span<const u8> source, ParseToken token, i64 previous,
        i64 nesting) -> TypeResult {
        // Check the block guard before requiring '{', including then/else bodies.
        if (nesting >= 128) {
            return TypeResult(ParseStatus::block_nesting_limit, -1, token);
        }
        if (!single(source, token, '{')) {
            return TypeResult(ParseStatus::expected_brace_open, -1, token);
        }
        const ParseFrame block = ParseFrame(FrameState::body_block, previous, -1, token.index());
        if (!arena.push(block)) {
            const TypeResult error = type_error(arena, token);
            return error;
        }
        const ParseToken next = advance(source, token);
        return TypeResult(ParseStatus::success, -1, next);
    }
    auto parse_body(AstArena& arena, builtin::span<const u8> source, ParseToken begin,
        TypeContext context) -> TypeResult {
        const i64 base = arena.stack_size();
        const TypeResult opening = open_body(arena, source, begin, -1, 0);
        ParseToken token = opening.token();
        if (opening.status() != ParseStatus::success) {
            const TypeResult error = finish_parse(arena, opening.status(), -1, token, base);
            return error;
        }
        // Count braces, not frames: if/while continuations do not add block depth.
        // At depth d there are at most d blocks and d-1 control continuations.
        i64 nesting = 1;
        i64 value = -1;
        bool completed = false;
        while (arena.stack_size() > base) {
            const ParseFrame frame = arena.frame();
            if (frame.state() == FrameState::body_block) {
                if (completed) {
                    const ParseFrame next = ParseFrame(FrameState::body_block, frame.min(), value, frame.token());
                    if (!arena.replace(next)) {
                        const TypeResult error = failure(arena, token, base);
                        return error;
                    }
                    completed = false;
                } else {
                    if (single(source, token, '}')) {
                        SyntaxNode block = SyntaxNode(SyntaxKind::block, frame.token(), token.index() + 1, frame.min());
                        block.bind_body(frame.lhs(), -1);
                        value = arena.append_syntax(block);
                        if (value < 0) {
                            const TypeResult error = failure(arena, token, base);
                            return error;
                        }
                        arena.pop();
                        nesting = nesting - 1;
                        completed = true;
                        token.update(advance(source, token));
                    } else {
                        if (token.kind() == compiler_lexer::Event::end_of_input) {
                            const TypeResult error = finish_parse(arena, ParseStatus::unterminated_block, -1, token,
                                base);
                            return error;
                        }
                        if (token.kind() != compiler_lexer::Event::token) {
                            const TypeResult error = finish_parse(arena, ParseStatus::invalid, -1, token, base);
                            return error;
                        }
                        if (single(source, token, '{')) {
                            const TypeResult child = open_body(arena, source, token, frame.lhs(), nesting);
                            token.update(child.token());
                            if (child.status() != ParseStatus::success) {
                                const TypeResult error = finish_parse(arena, child.status(), -1, token, base);
                                return error;
                            }
                            nesting = nesting + 1;
                        } else {
                            const SyntaxKind kind = body_word(source, token);
                            if (kind == SyntaxKind::conditional || kind == SyntaxKind::loop) {
                                const i64 first = token.index();
                                token.update(advance(source, token));
                                if (!single(source, token, '(')) {
                                    const TypeResult error = finish_parse(arena, ParseStatus::expected_open, -1, token,
                                        base);
                                    return error;
                                }
                                const ParseToken condition = advance(source, token);
                                const TypeResult expression = body_expression(arena, source, condition,
                                    Stop::close_parenthesis, context);
                                token.update(expression.token());
                                if (expression.status() != ParseStatus::success) {
                                    const TypeResult error = finish_parse(arena, expression.status(), -1, token, base);
                                    return error;
                                }
                                if (!single(source, token, ')')) {
                                    const TypeResult error = finish_parse(arena, ParseStatus::expected_close, -1, token,
                                        base);
                                    return error;
                                }
                                token.update(advance(source, token));
                                FrameState state = FrameState::body_if_then;
                                if (kind == SyntaxKind::loop) {
                                    state = FrameState::body_while;
                                }
                                const ParseFrame control = ParseFrame(state, frame.lhs(), expression.root(), first);
                                if (!arena.push(control)) {
                                    const TypeResult error = failure(arena, token, base);
                                    return error;
                                }
                                const TypeResult child = open_body(arena, source, token, -1, nesting);
                                token.update(child.token());
                                if (child.status() != ParseStatus::success) {
                                    const TypeResult error = finish_parse(arena, child.status(), -1, token, base);
                                    return error;
                                }
                                nesting = nesting + 1;
                            } else {
                                const TypeResult statement = body_statement(arena, source, token, context, frame.lhs());
                                token.update(statement.token());
                                if (statement.status() != ParseStatus::success) {
                                    const TypeResult error = finish_parse(arena, statement.status(), -1, token, base);
                                    return error;
                                }
                                const ParseFrame next_frame = ParseFrame(FrameState::body_block, frame.min(),
                                    statement.root(), frame.token());
                                if (!arena.replace(next_frame)) {
                                    const TypeResult error = failure(arena, token, base);
                                    return error;
                                }
                            }
                        }
                    }
                }
            } else {
                if (!completed || (frame.state() != FrameState::body_if_then && frame.state()
                    != FrameState::body_if_else && frame.state() != FrameState::body_while)) {
                    const TypeResult error = finish_parse(arena, ParseStatus::invalid, -1, token, base);
                    return error;
                }
                if (frame.state() == FrameState::body_if_then && body_else(source, token)) {
                    ParseFrame control = ParseFrame(FrameState::body_if_else, frame.min(), frame.lhs(), frame.token());
                    control.designate(value);
                    if (!arena.replace(control)) {
                        const TypeResult error = failure(arena, token, base);
                        return error;
                    }
                    token.update(advance(source, token));
                    const TypeResult child = open_body(arena, source, token, -1, nesting);
                    token.update(child.token());
                    if (child.status() != ParseStatus::success) {
                        const TypeResult error = finish_parse(arena, child.status(), -1, token, base);
                        return error;
                    }
                    nesting = nesting + 1;
                    completed = false;
                } else {
                    SyntaxKind kind = SyntaxKind::conditional;
                    i64 body = value;
                    i64 other = -1;
                    if (frame.state() == FrameState::body_while) {
                        kind = SyntaxKind::loop;
                    }
                    if (frame.state() == FrameState::body_if_else) {
                        body = frame.field();
                        other = value;
                    }
                    SyntaxNode statement = SyntaxNode(kind, frame.token(), token.index(), frame.min());
                    statement.bind_expression(frame.lhs(), -1);
                    statement.bind_body(body, other);
                    value = arena.append_syntax(statement);
                    if (value < 0) {
                        const TypeResult error = failure(arena, token, base);
                        return error;
                    }
                    arena.pop();
                }
            }
        }
        const TypeResult result = finish_parse(arena, ParseStatus::success, value, token, base);
        return result;
    }
    // Shared module/import spelling. The copied root is the last name token;
    // trivia does not contribute to the module's qualified-name byte limit.
    auto module_name(builtin::span<const u8> source, ParseToken begin, bool limited) -> TypeResult {
        ParseToken token = begin;
        const ParseStatus identifier = identifier_status(source, token, false);
        if (identifier != ParseStatus::success) {
            return TypeResult(identifier, -1, token);
        }
        i64 bytes = token.last() - token.first();
        i64 last = token.index();
        token.update(advance(source, token));
        while (single(source, token, '.')) {
            token.update(advance(source, token));
            const ParseStatus status = identifier_status(source, token, true);
            if (status != ParseStatus::success) {
                return TypeResult(status, -1, token);
            }
            bytes = bytes + (token.last() - token.first()) + 1;
            last = token.index();
            token.update(advance(source, token));
        }
        if (limited && bytes > 4096) {
            return TypeResult(ParseStatus::module_name_limit, -1, token);
        }
        return TypeResult(ParseStatus::success, last, token);
    }
    auto parse_preamble(AstArena& arena, builtin::span<const u8> source, ParseToken begin) -> TypeResult {
        const i64 base = arena.stack_size();
        const array<u8, 21> names = "export;module;import;";
        const builtin::span<const u8> words = borrow_bytes(names);
        ParseToken token = begin;
        i64 interface_unit = 0;
        if (word_matches(source, token, words, 0, 6)) {
            interface_unit = 1;
            token.update(advance(source, token));
        }
        if (!word_matches(source, token, words, 7, 13)) {
            return TypeResult(ParseStatus::expected_module, -1, token);
        }
        const ParseToken first = advance(source, token);
        const TypeResult module_name_result = module_name(source, first, true);
        token.update(module_name_result.token());
        if (module_name_result.status() != ParseStatus::success) {
            return TypeResult(module_name_result.status(), -1, token);
        }
        if (!single(source, token, ';')) {
            return TypeResult(ParseStatus::expected_semicolon, -1, token);
        }
        token.update(advance(source, token));
        i64 tail = -1;
        while (word_matches(source, token, words, 14, 20)) {
            const ParseToken name = advance(source, token);
            const TypeResult imported = module_name(source, name, false);
            token.update(imported.token());
            if (imported.status() != ParseStatus::success) {
                return TypeResult(imported.status(), -1, token);
            }
            if (!single(source, token, ';')) {
                return TypeResult(ParseStatus::expected_semicolon, -1, token);
            }
            token.update(advance(source, token));
            SyntaxNode import_node = SyntaxNode(SyntaxKind::import_name, name.index(), imported.root() + 1, tail);
            tail = arena.append_syntax(import_node);
            if (tail < 0) {
                const TypeResult error = failure(arena, token, base);
                return error;
            }
        }
        SyntaxNode preamble = SyntaxNode(SyntaxKind::preamble, first.index(), token.index(), -1);
        preamble.bind_declaration(-1, module_name_result.root(), interface_unit);
        preamble.bind_body(tail, -1);
        const TypeResult result = finish_statement(arena, preamble, token, base);
        return result;
    }
    auto parse_enum(AstArena& arena, builtin::span<const u8> source, ParseToken begin, i64 enum_count) -> TypeResult {
        const i64 base = arena.stack_size();
        const array<u8, 11> names = "enum;class;";
        const builtin::span<const u8> words = borrow_bytes(names);
        ParseToken token = begin;
        if (!word_matches(source, token, words, 0, 4)) {
            const TypeResult error = finish_parse(arena, ParseStatus::expected_enum, -1, token, base);
            return error;
        }
        token.update(advance(source, token));
        if (!word_matches(source, token, words, 5, 10)) {
            const TypeResult error = finish_parse(arena, ParseStatus::expected_class, -1, token, base);
            return error;
        }
        const ParseToken name = advance(source, token);
        token.update(name);
        const ParseStatus identifier = identifier_status(source, token, false);
        if (identifier != ParseStatus::success) {
            const TypeResult error = finish_parse(arena, identifier, -1, token, base);
            return error;
        }
        token.update(advance(source, token));
        if (enum_count >= 64) {
            const TypeResult error = finish_parse(arena, ParseStatus::module_enum_limit, -1, token, base);
            return error;
        }
        if (!single(source, token, '{')) {
            const TypeResult error = finish_parse(arena, ParseStatus::expected_brace_open, -1, token, base);
            return error;
        }
        token.update(advance(source, token));
        if (single(source, token, '}')) {
            const TypeResult error = finish_parse(arena, ParseStatus::empty_enum, -1, token, base);
            return error;
        }
        i64 tail = -1;
        bool more = true;
        while (more) {
            if (arena.stack_size() - base >= 256) {
                const TypeResult error = finish_parse(arena, ParseStatus::enum_case_limit, -1, token, base);
                return error;
            }
            const ParseToken case_name = token;
            const ParseStatus status = identifier_status(source, token, false);
            if (status != ParseStatus::success) {
                const TypeResult error = finish_parse(arena, status, -1, token, base);
                return error;
            }
            token.update(advance(source, token));
            i64 previous = base;
            while (previous < arena.stack_size()) {
                const ParseFrame seen = arena.scratch_at(previous);
                if (word_matches(source, case_name, source, seen.min(), seen.lhs())) {
                    const TypeResult error = finish_parse(arena, ParseStatus::duplicate_enum_case, -1, token, base);
                    return error;
                }
                previous = previous + 1;
            }
            if (single(source, token, '=')) {
                const TypeResult error = finish_parse(arena, ParseStatus::explicit_enum_value, -1, token, base);
                return error;
            }
            // Case spellings stay only in bounded scratch, never in the published forest.
            const ParseFrame seen = ParseFrame(FrameState::enum_case, case_name.first(), case_name.last(), -1);
            if (!arena.push(seen)) {
                const TypeResult error = failure(arena, token, base);
                return error;
            }
            SyntaxNode case_node = SyntaxNode(SyntaxKind::enum_case, case_name.index(), case_name.index() + 1, tail);
            tail = arena.append_syntax(case_node);
            if (tail < 0) {
                const TypeResult error = failure(arena, token, base);
                return error;
            }
            more = single(source, token, ',');
            if (more) {
                token.update(advance(source, token));
                more = !single(source, token, '}');
            }
        }
        if (!single(source, token, '}')) {
            const TypeResult error = finish_parse(arena, ParseStatus::expected_brace_close, -1, token, base);
            return error;
        }
        token.update(advance(source, token));
        if (!single(source, token, ';')) {
            const TypeResult error = finish_parse(arena, ParseStatus::expected_semicolon, -1, token, base);
            return error;
        }
        const ParseToken after = advance(source, token);
        SyntaxNode definition = SyntaxNode(SyntaxKind::enum_definition, name.index(), after.index(), -1);
        definition.bind_body(tail, -1);
        const TypeResult result = finish_statement(arena, definition, after, base);
        return result;
    }
    // Complete field grammar precedes declaration admission in the host.
    auto parse_field(AstArena& arena, builtin::span<const u8> source, ParseToken begin,
        TypeContext context) -> TypeResult {
        const i64 base = arena.stack_size();
        const ParseFrame type_start = ParseFrame(FrameState::type_start, 0, -1, -1);
        const TypeResult typed = parse_type(arena, source, begin, context, type_start);
        const ParseToken binding = typed.token();
        if (typed.status() != ParseStatus::success) {
            const TypeResult error = finish_parse(arena, typed.status(), -1, binding, base);
            return error;
        }
        const ParseStatus identifier = identifier_status(source, binding, false);
        if (identifier != ParseStatus::success) {
            const TypeResult error = finish_parse(arena, identifier, -1, binding, base);
            return error;
        }
        const ParseToken semicolon = advance(source, binding);
        if (!single(source, semicolon, ';')) {
            const TypeResult error = finish_parse(arena, ParseStatus::expected_semicolon, -1, semicolon, base);
            return error;
        }
        if (!arena.own_type(typed.root(), begin.index(), 3)) {
            const TypeResult error = failure(arena, semicolon, base);
            return error;
        }
        const ParseToken after = advance(source, semicolon);
        SyntaxNode field = SyntaxNode(SyntaxKind::field, begin.index(), after.index(), -1);
        field.bind_declaration(typed.root(), binding.index(), 0);
        const TypeResult result = finish_statement(arena, field, after, base);
        return result;
    }
    // Parameters and initializer lists are flat reverse-linked syntax lists.
    // Admission is deliberately deferred until the complete callable grammar
    // succeeds; no service or resolved ownership policy lives in these grammar routines.
    auto callable_parameters(AstArena& arena, builtin::span<const u8> source, ParseToken begin,
        TypeContext context) -> TypeResult {
        const i64 base = arena.stack_size();
        ParseToken token = begin;
        i64 tail = -1;
        if (!single(source, token, '(')) {
            return TypeResult(ParseStatus::expected_open, -1, token);
        }
        token.update(advance(source, token));
        if (!single(source, token, ')')) {
            bool more = true;
            while (more) {
                const i64 start = token.index();
                i64 readonly = 0;
                if (type_word(source, token) == TypeWord::const_type) {
                    readonly = 1;
                    token.update(advance(source, token));
                }
                const ParseFrame type_start = ParseFrame(FrameState::type_start, 0, -1, -1);
                const TypeResult typed = parse_type(arena, source, token, context, type_start);
                token.update(typed.token());
                if (typed.status() != ParseStatus::success) {
                    return TypeResult(typed.status(), -1, token);
                }
                if (!arena.own_type(typed.root(), start, 3)) {
                    return TypeResult(ParseStatus::invalid, -1, token);
                }
                i64 borrowed = -1;
                if (single(source, token, '&')) {
                    borrowed = token.index();
                    token.update(advance(source, token));
                }
                const ParseStatus identifier = identifier_status(source, token, false);
                if (identifier != ParseStatus::success) {
                    return TypeResult(identifier, -1, token);
                }
                const i64 binding = token.index();
                token.update(advance(source, token));
                SyntaxNode parameter = SyntaxNode(SyntaxKind::parameter, start, token.index(), tail);
                parameter.bind_declaration(typed.root(), binding, readonly);
                parameter.bind_borrow(borrowed);
                tail = arena.append_syntax(parameter);
                if (tail < 0) {
                    const TypeResult error = failure(arena, token, base);
                    return error;
                }
                more = single(source, token, ',');
                if (more) {
                    token.update(advance(source, token));
                }
            }
        }
        if (!single(source, token, ')')) {
            return TypeResult(ParseStatus::expected_close, -1, token);
        }
        const ParseToken after = advance(source, token);
        return TypeResult(ParseStatus::success, tail, after);
    }
    auto constructor_initializers(AstArena& arena, builtin::span<const u8> source, ParseToken begin,
        TypeContext context) -> TypeResult {
        const i64 base = arena.stack_size();
        ParseToken token = begin;
        i64 tail = -1;
        if (single(source, token, ':')) {
            token.update(advance(source, token));
            bool more = true;
            while (more) {
                const ParseToken field = token;
                const ParseStatus identifier = identifier_status(source, field, false);
                if (identifier != ParseStatus::success) {
                    return TypeResult(identifier, -1, field);
                }
                token.update(advance(source, field));
                i64 expression = -1;
                if (single(source, token, '{')) {
                    const TypeResult parsed = parse_into(arena, source, field, Stop::constructor_braces, context);
                    token.update(parsed.token());
                    if (parsed.status() != ParseStatus::success) {
                        return TypeResult(parsed.status(), -1, token);
                    }
                    expression = parsed.root();
                } else {
                    if (!single(source, token, '(')) {
                        return TypeResult(ParseStatus::expected_open, -1, token);
                    }
                    const ParseToken first_value = advance(source, token);
                    const TypeResult parsed = body_expression(arena, source, first_value, Stop::close_parenthesis,
                        context);
                    token.update(parsed.token());
                    if (parsed.status() != ParseStatus::success) {
                        return TypeResult(parsed.status(), -1, token);
                    }
                    expression = parsed.root();
                    if (!single(source, token, ')')) {
                        return TypeResult(ParseStatus::expected_close, -1, token);
                    }
                    token.update(advance(source, token));
                }
                SyntaxNode initializer = SyntaxNode(SyntaxKind::initializer, field.index(), token.index(), tail);
                initializer.bind_expression(expression, -1);
                tail = arena.append_syntax(initializer);
                if (tail < 0) {
                    const TypeResult error = failure(arena, token, base);
                    return error;
                }
                more = single(source, token, ',');
                if (more) {
                    token.update(advance(source, token));
                }
            }
        }
        if (!single(source, token, '{')) {
            return TypeResult(ParseStatus::expected_brace_open, -1, token);
        }
        const ParseToken close = advance(source, token);
        if (!single(source, close, '}')) {
            return TypeResult(ParseStatus::expected_brace_close, -1, close);
        }
        const ParseToken after = advance(source, close);
        return TypeResult(ParseStatus::success, tail, after);
    }
    auto parse_callable(AstArena& arena, builtin::span<const u8> source, ParseToken begin, Stop stop,
        TypeContext context) -> TypeResult {
        const i64 base = arena.stack_size();
        ParseToken token = begin;
        if (stop != Stop::constructor) {
            const array<u8, 4> spelling = "auto";
            const builtin::span<const u8> word = borrow_bytes(spelling);
            if (!word_matches(source, token, word, 0, 4)) {
                return TypeResult(ParseStatus::expected_auto, -1, token);
            }
            token.update(advance(source, token));
        }
        const ParseStatus identifier = identifier_status(source, token, stop == Stop::constructor);
        if (identifier != ParseStatus::success) {
            return TypeResult(identifier, -1, token);
        }
        const i64 name = token.index();
        const ParseToken first = advance(source, token);
        const TypeResult parameters = callable_parameters(arena, source, first, context);
        token.update(parameters.token());
        if (parameters.status() != ParseStatus::success) {
            return TypeResult(parameters.status(), -1, token);
        }
        i64 declared_type = -1;
        i64 readonly = 0;
        i64 body = -1;
        SyntaxKind kind = SyntaxKind::constructor;
        if (stop == Stop::constructor) {
            const TypeResult initializers = constructor_initializers(arena, source, token, context);
            token.update(initializers.token());
            if (initializers.status() != ParseStatus::success) {
                return TypeResult(initializers.status(), -1, token);
            }
            body = initializers.root();
        } else {
            kind = SyntaxKind::function;
            if (stop == Stop::method) {
                kind = SyntaxKind::method;
                if (type_word(source, token) == TypeWord::const_type) {
                    readonly = 1;
                    token.update(advance(source, token));
                }
            }
            if (token.last() - token.first() != 2 || source.at(token.first()) != '-' || source.at(token.first() + 1)
                != '>') {
                return TypeResult(ParseStatus::expected_arrow, -1, token);
            }
            const ParseToken first_type = advance(source, token);
            const ParseFrame type_start = ParseFrame(FrameState::type_start, 0, -1, -1);
            const TypeResult typed = parse_type(arena, source, first_type, context, type_start);
            token.update(typed.token());
            if (typed.status() != ParseStatus::success) {
                return TypeResult(typed.status(), -1, token);
            }
            declared_type = typed.root();
            if (!arena.own_type(declared_type, name, 3)) {
                return TypeResult(ParseStatus::invalid, -1, token);
            }
            const TypeResult parsed = parse_body(arena, source, token, context);
            token.update(parsed.token());
            if (parsed.status() != ParseStatus::success) {
                return TypeResult(parsed.status(), -1, token);
            }
            body = parsed.root();
        }
        SyntaxNode callable = SyntaxNode(kind, name, token.index(), -1);
        callable.bind_declaration(declared_type, -1, readonly);
        callable.bind_body(body, parameters.root());
        const i64 root = arena.append_syntax(callable);
        if (root < 0) {
            const TypeResult error = failure(arena, token, base);
            return error;
        }
        return TypeResult(ParseStatus::success, root, token);
    }
    enum class DeclarationWord {
        invalid,
        export_declaration,
        import_declaration,
        namespace_declaration,
        enum_declaration,
        template_declaration,
        class_declaration,
        auto_declaration,
        public_access,
        private_access,
        scalar_parameter,
        value_parameter,
        capacity_parameter
    };
    auto declaration_word(builtin::span<const u8> source, ParseToken token) -> DeclarationWord {
        const array<u8, 81> names = "export;import;namespace;enum;template;class;auto;public;private;Scalar;Value;i64;";
        const builtin::span<const u8> words = borrow_bytes(names);
        if (word_matches(source, token, words, 0, 6)) {
            return DeclarationWord::export_declaration;
        }
        if (word_matches(source, token, words, 7, 13)) {
            return DeclarationWord::import_declaration;
        }
        if (word_matches(source, token, words, 14, 23)) {
            return DeclarationWord::namespace_declaration;
        }
        if (word_matches(source, token, words, 24, 28)) {
            return DeclarationWord::enum_declaration;
        }
        if (word_matches(source, token, words, 29, 37)) {
            return DeclarationWord::template_declaration;
        }
        if (word_matches(source, token, words, 38, 43)) {
            return DeclarationWord::class_declaration;
        }
        if (word_matches(source, token, words, 44, 48)) {
            return DeclarationWord::auto_declaration;
        }
        if (word_matches(source, token, words, 49, 55)) {
            return DeclarationWord::public_access;
        }
        if (word_matches(source, token, words, 56, 63)) {
            return DeclarationWord::private_access;
        }
        if (word_matches(source, token, words, 64, 70)) {
            return DeclarationWord::scalar_parameter;
        }
        if (word_matches(source, token, words, 71, 76)) {
            return DeclarationWord::value_parameter;
        }
        if (word_matches(source, token, words, 77, 80)) {
            return DeclarationWord::capacity_parameter;
        }
        return DeclarationWord::invalid;
    }
    // A declaration wrapper owns exactly one completed leaf/container root.
    // Its token is descriptive, not a unique allocation charge: the separate
    // declaration keyword (or constructor '(' / field ';') pays for this node.
    auto wrap_declaration(AstArena& arena, i64 root, i64 previous, i64 parameters, i64 qualifier) -> i64 {
        const SyntaxNode leaf = arena.syntax_at(root);
        SyntaxNode declaration = SyntaxNode(SyntaxKind::declaration, leaf.token(), leaf.end(), previous);
        declaration.bind_declaration(-1, -1, qualifier);
        declaration.bind_body(root, parameters);
        return arena.append_syntax(declaration);
    }
    // This ordinary copied value carries the optional header's names; it owns
    // no storage and is not part of the host parser boundary.
    class HeaderResult {
        TypeResult parsed_header;
        TypeContext type_context;
    public:
        HeaderResult(TypeResult parsed, TypeContext context) : parsed_header(parsed), type_context(context) {
        }
        auto parsed() const -> TypeResult {
            const TypeResult value = parsed_header;
            return value;
        }
        auto context() const -> TypeContext {
            const TypeContext value = type_context;
            return value;
        }
    };
    // Headers contribute source-backed names only. A fresh context is returned
    // for each declaration, so no parameter leaks into its successor. An absent
    // template header succeeds without consuming tokens and has an empty context.
    auto parse_template(AstArena& arena, builtin::span<const u8> source, ParseToken begin) -> HeaderResult {
        const i64 base = arena.stack_size();
        TypeContext context = TypeContext();
        if (declaration_word(source, begin) != DeclarationWord::template_declaration) {
            return HeaderResult(TypeResult(ParseStatus::success, -1, begin), context);
        }
        ParseToken token = advance(source, begin);
        if (!single(source, token, '<')) {
            return HeaderResult(TypeResult(ParseStatus::expected_angle_open, -1, token), context);
        }
        token.update(advance(source, token));
        i64 count = 0;
        i64 types = 0;
        i64 tail = -1;
        SyntaxKind first_kind = SyntaxKind::invalid;
        SyntaxKind last_kind = SyntaxKind::invalid;
        bool more = true;
        while (more) {
            if (count >= 2) {
                return HeaderResult(TypeResult(ParseStatus::template_parameter_limit, -1, token), context);
            }
            const DeclarationWord word = declaration_word(source, token);
            SyntaxKind kind = SyntaxKind::invalid;
            if (word == DeclarationWord::scalar_parameter) {
                kind = SyntaxKind::template_scalar;
            }
            if (word == DeclarationWord::value_parameter) {
                kind = SyntaxKind::template_value;
            }
            if (word == DeclarationWord::capacity_parameter) {
                kind = SyntaxKind::template_capacity;
            }
            if (kind == SyntaxKind::invalid) {
                return HeaderResult(TypeResult(ParseStatus::template_parameter_kind, -1, token), context);
            }
            const ParseToken name = advance(source, token);
            const ParseStatus identifier = identifier_status(source, name, false);
            if (identifier != ParseStatus::success) {
                return HeaderResult(TypeResult(identifier, -1, name), context);
            }
            token.update(advance(source, name));
            const array<u8, 31> reserved = "i64;u64;u8;bool;own;ref;mutref;";
            const builtin::span<const u8> reserved_words = borrow_bytes(reserved);
            if (word_list_matches(source, name, reserved_words) || parameter(source, name, context, false)
                || parameter(source, name, context, true)) {
                return HeaderResult(TypeResult(ParseStatus::template_parameter_name, -1, token), context);
            }
            if (kind == SyntaxKind::template_capacity) {
                context.bind_parameter(2, name.first(), name.last());
            } else {
                context.bind_parameter(types, name.first(), name.last());
                types = types + 1;
            }
            if (count == 0) {
                first_kind = kind;
            }
            last_kind = kind;
            count = count + 1;
            tail = arena.append_syntax(SyntaxNode(kind, name.index(), name.index() + 1, tail));
            if (tail < 0) {
                const TypeResult error = failure(arena, token, base);
                return HeaderResult(error, context);
            }
            more = single(source, token, ',');
            if (more) {
                token.update(advance(source, token));
            }
        }
        if (!single(source, token, '>')) {
            return HeaderResult(TypeResult(ParseStatus::expected_angle_close, -1, token), context);
        }
        token.update(advance(source, token));
        if (context.end(2) != 0 && (count != 2 || first_kind != SyntaxKind::template_scalar || last_kind
            != SyntaxKind::template_capacity)) {
            return HeaderResult(TypeResult(ParseStatus::template_capacity_order, -1, token), context);
        }
        const DeclarationWord declaration = declaration_word(source, token);
        if (declaration != DeclarationWord::class_declaration && declaration != DeclarationWord::auto_declaration) {
            return HeaderResult(TypeResult(ParseStatus::template_declaration_kind, -1, token), context);
        }
        context.set_mode(1);
        if (declaration == DeclarationWord::auto_declaration) {
            if (context.end(2) != 0) {
                return HeaderResult(TypeResult(ParseStatus::function_template_capacity, -1, token), context);
            }
            context.set_mode(2);
        }
        return HeaderResult(TypeResult(ParseStatus::success, tail, token), context);
    }
    auto parse_class(AstArena& arena, builtin::span<const u8> source, ParseToken begin, TypeContext context,
        bool allow_array) -> TypeResult {
        const i64 base = arena.stack_size();
        const ParseToken name = advance(source, begin);
        const ParseStatus identifier = identifier_status(source, name, allow_array);
        if (identifier != ParseStatus::success) {
            return TypeResult(identifier, -1, name);
        }
        ParseToken token = advance(source, name);
        if (parameter(source, name, context, false) || parameter(source, name, context, true)) {
            return TypeResult(ParseStatus::class_template_shadow, -1, token);
        }
        if (!single(source, token, '{')) {
            return TypeResult(ParseStatus::expected_brace_open, -1, token);
        }
        token.update(advance(source, token));
        i64 public_access = 0;
        i64 tail = -1;
        while (!single(source, token, '}')) {
            const DeclarationWord word = declaration_word(source, token);
            if (word == DeclarationWord::public_access || word == DeclarationWord::private_access) {
                token.update(advance(source, token));
                if (!single(source, token, ':')) {
                    const TypeResult error = finish_parse(arena, ParseStatus::expected_colon, -1, token, base);
                    return error;
                }
                public_access = 0;
                if (word == DeclarationWord::public_access) {
                    public_access = 1;
                }
                token.update(advance(source, token));
            } else {
                // Constructor recognition is exactly the class spelling followed
                // by '('. Other names retain the field parser's old diagnostics.
                const ParseToken lookahead = advance(source, token);
                const bool constructor = word_matches(source, token, source, name.first(), name.last())
                    && single(source, lookahead, '(');
                i64 root = -1;
                if (constructor || word == DeclarationWord::auto_declaration) {
                    Stop stop = Stop::constructor;
                    if (word == DeclarationWord::auto_declaration) {
                        stop = Stop::method;
                    }
                    const TypeResult parsed = parse_callable(arena, source, token, stop, context);
                    token.update(parsed.token());
                    if (parsed.status() != ParseStatus::success) {
                        const TypeResult error = finish_parse(arena, parsed.status(), -1, token, base);
                        return error;
                    }
                    root = parsed.root();
                } else {
                    const TypeResult parsed = parse_field(arena, source, token, context);
                    token.update(parsed.token());
                    if (parsed.status() != ParseStatus::success) {
                        const TypeResult error = finish_parse(arena, parsed.status(), -1, token, base);
                        return error;
                    }
                    root = parsed.root();
                }
                tail = wrap_declaration(arena, root, tail, -1, public_access);
                if (tail < 0) {
                    const TypeResult error = failure(arena, token, base);
                    return error;
                }
            }
        }
        token.update(advance(source, token));
        if (!single(source, token, ';')) {
            const TypeResult error = finish_parse(arena, ParseStatus::expected_semicolon, -1, token, base);
            return error;
        }
        const ParseToken after = advance(source, token);
        SyntaxNode definition = SyntaxNode(SyntaxKind::class_definition, name.index(), after.index(), -1);
        definition.bind_body(tail, -1);
        const TypeResult result = finish_statement(arena, definition, after, base);
        return result;
    }
    // Whole-module syntax is parsed before host admission. Namespace traversal
    // is iterative: each active block uses exactly two existing scratch frames.
    // Qualified components, not braces, consume the 32-component nesting limit.
    auto parse_module(AstArena& arena, builtin::span<const u8> source, ParseToken begin) -> TypeResult {
        const i64 base = arena.stack_size();
        const TypeResult parsed_preamble = parse_preamble(arena, source, begin);
        ParseToken token = parsed_preamble.token();
        if (parsed_preamble.status() != ParseStatus::success) {
            const TypeResult error = finish_parse(arena, parsed_preamble.status(), -1, token, base);
            return error;
        }
        const SyntaxNode preamble = arena.syntax_at(parsed_preamble.root());
        i64 tail = -1;
        i64 components = 0;
        i64 exact_std = 0;
        i64 enum_count = 0;
        while (token.kind() != compiler_lexer::Event::end_of_input) {
            if (arena.stack_size() > base && single(source, token, '}')) {
                const ParseFrame header = arena.frame();
                arena.pop();
                const ParseFrame parent = arena.frame();
                arena.pop();
                token.update(advance(source, token));
                SyntaxNode definition = SyntaxNode(SyntaxKind::namespace_definition, header.lhs(), token.index(), -1);
                definition.bind_declaration(-1, header.token(), 0);
                definition.bind_body(tail, -1);
                const i64 root = arena.append_syntax(definition);
                if (root < 0) {
                    const TypeResult error = failure(arena, token, base);
                    return error;
                }
                tail = wrap_declaration(arena, root, parent.lhs(), -1, header.min());
                if (tail < 0) {
                    const TypeResult error = failure(arena, token, base);
                    return error;
                }
                components = parent.min();
                exact_std = parent.token();
            } else {
                i64 exported = 0;
                if (declaration_word(source, token) == DeclarationWord::export_declaration) {
                    exported = 1;
                    token.update(advance(source, token));
                    if (preamble.mutable_binding() == 0) {
                        const TypeResult error = finish_parse(arena, ParseStatus::export_interface_required, -1, token,
                            base);
                        return error;
                    }
                }
                const DeclarationWord word = declaration_word(source, token);
                if (word == DeclarationWord::import_declaration) {
                    ParseStatus status = ParseStatus::imports_after_declarations;
                    if (exported == 1) {
                        status = ParseStatus::module_reexport;
                    }
                    const TypeResult error = finish_parse(arena, status, -1, token, base);
                    return error;
                }
                if (word == DeclarationWord::namespace_declaration) {
                    const ParseToken first_name = advance(source, token);
                    token.update(first_name);
                    i64 last_name = token.index();
                    i64 added = 0;
                    bool more = true;
                    while (more) {
                        const ParseStatus identifier = identifier_status(source, token, false);
                        if (identifier != ParseStatus::success) {
                            const TypeResult error = finish_parse(arena, identifier, -1, token, base);
                            return error;
                        }
                        last_name = token.index();
                        added = added + 1;
                        token.update(advance(source, token));
                        more = pair(source, token, ':');
                        if (more) {
                            token.update(advance(source, token));
                        }
                    }
                    if (!single(source, token, '{')) {
                        const TypeResult error = finish_parse(arena, ParseStatus::expected_brace_open, -1, token, base);
                        return error;
                    }
                    token.update(advance(source, token));
                    // The old recursive entry checks the limit after '{'.
                    if (components + added > 32) {
                        const TypeResult error = finish_parse(arena, ParseStatus::namespace_nesting_limit, -1, token,
                            base);
                        return error;
                    }
                    const ParseFrame parent = ParseFrame(FrameState::namespace_parent, components, tail, exact_std);
                    const ParseFrame header = ParseFrame(FrameState::namespace_header, exported, first_name.index(),
                        last_name);
                    if (!arena.push(parent) || !arena.push(header)) {
                        const TypeResult error = failure(arena, token, base);
                        return error;
                    }
                    exact_std = 0;
                    const array<u8, 3> standard = "std";
                    const builtin::span<const u8> standard_word = borrow_bytes(standard);
                    if (components == 0 && added == 1 && word_matches(source, first_name, standard_word, 0, 3)) {
                        exact_std = 1;
                    }
                    components = components + added;
                    tail = -1;
                } else {
                    i64 root = -1;
                    i64 templates = -1;
                    if (word == DeclarationWord::enum_declaration) {
                        const TypeResult parsed = parse_enum(arena, source, token, enum_count);
                        token.update(parsed.token());
                        if (parsed.status() != ParseStatus::success) {
                            const TypeResult error = finish_parse(arena, parsed.status(), -1, token, base);
                            return error;
                        }
                        enum_count = enum_count + 1;
                        root = parsed.root();
                    } else {
                        const HeaderResult header = parse_template(arena, source, token);
                        const TypeResult parameters = header.parsed();
                        token.update(parameters.token());
                        if (parameters.status() != ParseStatus::success) {
                            const TypeResult error = finish_parse(arena, parameters.status(), -1, token, base);
                            return error;
                        }
                        templates = parameters.root();
                        const TypeContext context = header.context();
                        if (declaration_word(source, token) == DeclarationWord::class_declaration) {
                            const TypeResult parsed = parse_class(arena, source, token, context, exact_std == 1);
                            token.update(parsed.token());
                            if (parsed.status() != ParseStatus::success) {
                                const TypeResult error = finish_parse(arena, parsed.status(), -1, token, base);
                                return error;
                            }
                            root = parsed.root();
                        } else {
                            const TypeResult parsed = parse_callable(arena, source, token, Stop::function, context);
                            token.update(parsed.token());
                            if (parsed.status() != ParseStatus::success) {
                                const TypeResult error = finish_parse(arena, parsed.status(), -1, token, base);
                                return error;
                            }
                            root = parsed.root();
                        }
                    }
                    tail = wrap_declaration(arena, root, tail, templates, exported);
                    if (tail < 0) {
                        const TypeResult error = failure(arena, token, base);
                        return error;
                    }
                }
            }
        }
        if (arena.stack_size() > base) {
            const TypeResult error = finish_parse(arena, ParseStatus::expected_brace_close, -1, token, base);
            return error;
        }
        SyntaxNode module_node = SyntaxNode(SyntaxKind::module_definition, begin.index(), token.index(), -1);
        module_node.bind_body(parsed_preamble.root(), tail);
        const TypeResult result = finish_statement(arena, module_node, token, base);
        return result;
    }
}

namespace compiler_parser {
    // Admission reads only spellings absent from syntax tags. One forward cursor
    // skips bodies without retaining tokens or replaying child-before-parent type
    // storage as source order. Diagnostic ordinals never move this cursor back.
    auto admission_seek(builtin::span<const u8> source, ParseToken start, i64 ordinal) -> ParseToken {
        ParseToken token = start;
        if (ordinal < token.index() || token.kind() == compiler_lexer::Event::invalid_cursor) {
            return ParseToken(compiler_lexer::Event::invalid_cursor, 0, 0, 1, 0, 0);
        }
        while (token.index() < ordinal) {
            if (token.kind() == compiler_lexer::Event::end_of_input) {
                return ParseToken(compiler_lexer::Event::invalid_cursor, 0, 0, 1, 0, 0);
            }
            token.update(advance(source, token));
        }
        return token;
    }
    auto admission_result(AdmissionStatus status) -> AdmissionResult {
        return AdmissionResult(status, -1, -1, -1, 0);
    }
    auto admission_at(AdmissionStatus status, i64 ordinal) -> AdmissionResult {
        return AdmissionResult(status, ordinal, ordinal + 1, -1, 0);
    }
    auto admission_failure(const AstArena& arena) -> AdmissionStatus {
        if (arena.failure() == ArenaFailure::allocation) {
            return AdmissionStatus::allocation_failure;
        }
        return AdmissionStatus::invalid;
    }
    class AdmissionProgress {
        AdmissionResult result;
        ParseToken next_token;
    public:
        AdmissionProgress(AdmissionResult value, ParseToken next) : result(value), next_token(next) {
        }
        auto outcome() const -> AdmissionResult {
            const AdmissionResult value = result;
            return value;
        }
        auto token() const -> ParseToken {
            const ParseToken value = next_token;
            return value;
        }
    };
    auto admission_done(AdmissionStatus status, ParseToken token) -> AdmissionProgress {
        return AdmissionProgress(admission_result(status), token);
    }
    auto admission_reject(AdmissionStatus status, i64 ordinal, ParseToken token) -> AdmissionProgress {
        return AdmissionProgress(admission_at(status, ordinal), token);
    }
    enum class AdmissionKind {
        invalid,
        copied,
        class_value,
        span,
        region,
        owner,
        service,
        unsupported
    };
    class AdmissionType {
        AdmissionKind category;
        i64 service_bit;
        ParseToken next_token;
    public:
        AdmissionType(AdmissionKind kind, i64 service, ParseToken next) : category(kind), service_bit(service),
            next_token(next) {
        }
        auto kind() const -> AdmissionKind {
            return category;
        }
        auto service() const -> i64 {
            return service_bit;
        }
        auto token() const -> ParseToken {
            const ParseToken value = next_token;
            return value;
        }
    };
    class AdmissionScope {
        TypeContext type_context;
        i64 class_begin;
        i64 class_end;
        i64 public_access;
    public:
        AdmissionScope(TypeContext context, i64 begin, i64 end, i64 access) : type_context(context), class_begin(begin),
            class_end(end), public_access(access) {
        }
        auto context() const -> TypeContext {
            const TypeContext value = type_context;
            return value;
        }
        auto begin() const -> i64 {
            return class_begin;
        }
        auto end() const -> i64 {
            return class_end;
        }
        auto access() const -> i64 {
            return public_access;
        }
    };
    auto admission_type(const AstArena& arena, builtin::span<const u8> source, ParseToken start, i64 root,
        AdmissionConfig configuration) -> AdmissionType {
        if (root < 0 || root >= arena.types()) {
            return AdmissionType(AdmissionKind::invalid, 0, start);
        }
        const TypeSyntax type = arena.type_at(root);
        const TypeKind kind = type.kind();
        if (kind == TypeKind::i64_type || kind == TypeKind::u64_type || kind == TypeKind::u8_type || kind
            == TypeKind::bool_type || kind == TypeKind::parameter) {
            return AdmissionType(AdmissionKind::copied, 0, start);
        }
        // Named types remain unresolved classes. Grammar tags only the two
        // sample classes as builtin_class; builtin result enums remain below.
        // Resolver identity and owning-class eligibility stay outside admission.
        if (kind == TypeKind::named || kind == TypeKind::builtin_class) {
            return AdmissionType(AdmissionKind::class_value, 0, start);
        }
        if (kind == TypeKind::byte_span || kind == TypeKind::value_span) {
            return AdmissionType(AdmissionKind::span, 0, start);
        }
        if (kind == TypeKind::owned_values) {
            return AdmissionType(AdmissionKind::owner, 0, start);
        }
        if (kind == TypeKind::array_type || kind == TypeKind::own_type || kind == TypeKind::ref_type || kind
            == TypeKind::mutref_type) {
            return AdmissionType(AdmissionKind::unsupported, 0, start);
        }
        if (kind != TypeKind::builtin_type) {
            return AdmissionType(AdmissionKind::invalid, 0, start);
        }
        const ParseToken token = admission_seek(source, start, type.last());
        if (token.kind() == compiler_lexer::Event::invalid_cursor) {
            return AdmissionType(AdmissionKind::invalid, 0, token);
        }
        const array<u8,
            96> names =
            "ByteRegion;OwnedBytes;ConsoleSession;DisplaySession;IommuEventSession;CallSession;Com1UartGrant;";
        const builtin::span<const u8> words = borrow_bytes(names);
        if (word_matches(source, token, words, 0, 10)) {
            return AdmissionType(AdmissionKind::region, 0, token);
        }
        if (word_matches(source, token, words, 11, 21)) {
            return AdmissionType(AdmissionKind::owner, 0, token);
        }
        if (word_matches(source, token, words, 22, 36)) {
            return AdmissionType(AdmissionKind::service, configuration.service_mask(0), token);
        }
        if (word_matches(source, token, words, 37, 51)) {
            return AdmissionType(AdmissionKind::service, configuration.service_mask(1), token);
        }
        if (word_matches(source, token, words, 52, 69)) {
            return AdmissionType(AdmissionKind::service, configuration.service_mask(2), token);
        }
        if (word_matches(source, token, words, 70, 81)) {
            return AdmissionType(AdmissionKind::service, configuration.service_mask(3), token);
        }
        if (word_matches(source, token, words, 82, 95)) {
            return AdmissionType(AdmissionKind::service, configuration.service_mask(4), token);
        }
        const array<u8, 12> serve_name = "ServeSession";
        const builtin::span<const u8> serve_word = borrow_bytes(serve_name);
        if (word_matches(source, token, serve_word, 0, 12)) {
            return AdmissionType(AdmissionKind::service, configuration.service_mask(5), token);
        }
        const array<u8, 70> enums = "ConsolePutResult;ConsoleCompletion;DisplayPutResult;DisplayCompletion;";
        const array<u8,
            92> event_enums =
            "EventPollResult;EventAckResult;EventIntakeCompletion;CallStatus;PortWriteResult;ServeStatus;";
        const builtin::span<const u8> enum_words = borrow_bytes(enums);
        const builtin::span<const u8> event_words = borrow_bytes(event_enums);
        if (word_list_matches(source, token, enum_words) || word_list_matches(source, token, event_words)) {
            return AdmissionType(AdmissionKind::copied, 0, token);
        }
        return AdmissionType(AdmissionKind::invalid, 0, token);
    }
    auto admission_copied(AdmissionKind kind) -> bool {
        return kind == AdmissionKind::copied || kind == AdmissionKind::class_value;
    }
    auto admission_push(AstArena& arena, i64 tail, SyntaxKind kind, FrameState state, i64 base) -> AdmissionStatus {
        i64 index = tail;
        while (index != -1) {
            if (index < 0 || index >= arena.syntax_size() || arena.stack_size() - base >= arena.syntax_size()) {
                return AdmissionStatus::invalid;
            }
            const SyntaxNode node = arena.syntax_at(index);
            if (node.kind() != kind || node.previous() < -1 || node.previous() >= index) {
                return AdmissionStatus::invalid;
            }
            if (!arena.push(ParseFrame(state, 0, index, node.token()))) {
                return admission_failure(arena);
            }
            index = node.previous();
        }
        return AdmissionStatus::success;
    }
    auto admission_templates(const AstArena& arena, builtin::span<const u8> source, ParseToken start,
        i64 tail) -> HeaderResult {
        TypeContext context = TypeContext();
        ParseToken token = start;
        i64 first = tail;
        i64 second = -1;
        if (tail != -1) {
            if (tail < 0 || tail >= arena.syntax_size()) {
                return HeaderResult(TypeResult(ParseStatus::invalid, -1, token), context);
            }
            const SyntaxNode last = arena.syntax_at(tail);
            if (last.previous() != -1) {
                if (last.previous() < 0 || last.previous() >= tail) {
                    return HeaderResult(TypeResult(ParseStatus::invalid, -1, token), context);
                }
                first = last.previous();
                second = tail;
            }
        }
        i64 count = 0;
        while (first != -1) {
            const SyntaxNode name = arena.syntax_at(first);
            if ((count == 0 && name.previous() != -1) || (name.kind() != SyntaxKind::template_scalar && name.kind()
                != SyntaxKind::template_value && name.kind() != SyntaxKind::template_capacity)) {
                return HeaderResult(TypeResult(ParseStatus::invalid, -1, token), context);
            }
            token.update(admission_seek(source, token, name.token()));
            if (token.kind() == compiler_lexer::Event::invalid_cursor) {
                return HeaderResult(TypeResult(ParseStatus::invalid, -1, token), context);
            }
            if (name.kind() == SyntaxKind::template_capacity) {
                if (count != 1) {
                    return HeaderResult(TypeResult(ParseStatus::invalid, -1, token), context);
                }
                context.bind_parameter(2, token.first(), token.last());
            } else {
                context.bind_parameter(count, token.first(), token.last());
            }
            context.set_mode(1);
            first = second;
            second = -1;
            count = count + 1;
        }
        return HeaderResult(TypeResult(ParseStatus::success, -1, token), context);
    }
    auto admission_callable(AstArena& arena, builtin::span<const u8> source, ParseToken start, SyntaxNode callable,
        AdmissionScope scope, AdmissionConfig configuration) -> AdmissionProgress {
        ParseToken token = start;
        const SyntaxKind kind = callable.kind();
        const bool function = kind == SyntaxKind::function;
        const bool method = kind == SyntaxKind::method;
        const TypeContext context = scope.context();
        if (!function && !method && kind != SyntaxKind::constructor) {
            return admission_done(AdmissionStatus::invalid, token);
        }
        if ((function && context.end(0) != 0) || method) {
            token.update(admission_seek(source, token, callable.token()));
            if (token.kind() == compiler_lexer::Event::invalid_cursor) {
                return admission_done(AdmissionStatus::invalid, token);
            }
            if (function && parameter(source, token, context, false)) {
                return admission_reject(AdmissionStatus::function_shadow, callable.token() + 1, token);
            }
            if (method && word_matches(source, token, source, scope.begin(), scope.end())) {
                return admission_reject(AdmissionStatus::typed_constructor, callable.token() + 1, token);
            }
        }
        const i64 base = arena.stack_size();
        const AdmissionStatus pushed = admission_push(arena, callable.other(), SyntaxKind::parameter,
            FrameState::admission_parameter, base);
        if (pushed != AdmissionStatus::success) {
            return admission_done(pushed, token);
        }
        i64 index = 0;
        i64 first_service = 0;
        bool first_borrowed = false;
        bool owning_prefix = false;
        while (arena.stack_size() > base) {
            const ParseFrame frame = arena.frame();
            arena.pop();
            const SyntaxNode parameter_node = arena.syntax_at(frame.lhs());
            const AdmissionType type = admission_type(arena, source, token, parameter_node.type(), configuration);
            token.update(type.token());
            if (type.kind() == AdmissionKind::invalid) {
                return admission_done(AdmissionStatus::invalid, token);
            }
            const TypeSyntax syntax = arena.type_at(parameter_node.type());
            const bool borrowed = parameter_node.borrow_site() >= 0;
            if (borrowed) {
                const u64 group = u64(first_service) | u64(type.service());
                const bool continuation = type.kind() == AdmissionKind::service && index == 1 && first_borrowed
                    && first_service != 0 && first_service != type.service() && (u64(configuration.groups()) & (1u64
                    << i64(group))) != 0u64;
                const bool owning_continuation = index > 0 && owning_prefix && type.kind() == AdmissionKind::class_value
                    && parameter_node.mutable_binding() == 1;
                const bool borrowed_values = index == 0 && syntax.kind() == TypeKind::owned_values
                    && parameter_node.mutable_binding() == 0;
                if (!function || (index != 0 && !continuation && !owning_continuation) || context.end(0) != 0
                    || (!borrowed_values && (type.kind() != AdmissionKind::class_value && type.kind()
                    != AdmissionKind::service)) || (!borrowed_values && syntax.first() != -1)) {
                    return admission_reject(AdmissionStatus::borrowed_parameter, parameter_node.binding(), token);
                }
            } else {
                if (parameter_node.mutable_binding() != 0) {
                    return admission_reject(AdmissionStatus::const_parameter, parameter_node.binding(), token);
                }
            }
            if (!admission_copied(type.kind()) && type.kind() != AdmissionKind::span && type.kind()
                != AdmissionKind::service && (method || (type.kind() != AdmissionKind::region && type.kind()
                != AdmissionKind::owner))) {
                AdmissionStatus status = AdmissionStatus::function_parameter;
                if (method) {
                    status = AdmissionStatus::method_parameter;
                }
                return admission_reject(status, parameter_node.end(), token);
            }
            if (index == 0) {
                first_service = type.service();
                first_borrowed = borrowed;
            }
            owning_prefix = borrowed && type.kind() == AdmissionKind::class_value && (index == 0 || owning_prefix);
            index = index + 1;
        }
        if (function || method) {
            const AdmissionType type = admission_type(arena, source, token, callable.type(), configuration);
            token.update(type.token());
            if (type.kind() == AdmissionKind::invalid || callable.body() < 0 || callable.body()
                >= arena.syntax_size()) {
                return admission_done(AdmissionStatus::invalid, token);
            }
            const SyntaxNode body = arena.syntax_at(callable.body());
            if (body.kind() != SyntaxKind::block) {
                return admission_done(AdmissionStatus::invalid, token);
            }
            if (!admission_copied(type.kind()) && ((function && type.kind() != AdmissionKind::owner) || (method
                && type.kind() != AdmissionKind::span))) {
                AdmissionStatus status = AdmissionStatus::function_result;
                if (method) {
                    status = AdmissionStatus::method_result;
                }
                return admission_reject(status, body.token(), token);
            }
        }
        return admission_done(AdmissionStatus::success, token);
    }
    auto admission_field(const AstArena& arena, builtin::span<const u8> source, ParseToken start, SyntaxNode field,
        AdmissionScope scope, AdmissionConfig configuration) -> AdmissionProgress {
        ParseToken token = start;
        if (field.type() < 0 || field.type() >= arena.types()) {
            return admission_done(AdmissionStatus::invalid, token);
        }
        const TypeSyntax syntax = arena.type_at(field.type());
        const i64 at = field.end() - 1;
        if (syntax.kind() == TypeKind::array_type) {
            if (scope.access() != 0) {
                return admission_reject(AdmissionStatus::public_array, at, token);
            }
            if (syntax.first() < 0 || syntax.second() < 0 || syntax.first() >= field.type() || syntax.second()
                >= field.type()) {
                return admission_done(AdmissionStatus::invalid, token);
            }
            const TypeSyntax element = arena.type_at(syntax.first());
            const TypeSyntax capacity = arena.type_at(syntax.second());
            if (capacity.kind() != TypeKind::length_parameter) {
                if (capacity.kind() != TypeKind::capacity) {
                    return admission_done(AdmissionStatus::invalid, token);
                }
                token.update(admission_seek(source, token, capacity.token()));
                if (token.kind() == compiler_lexer::Event::invalid_cursor) {
                    return admission_done(AdmissionStatus::invalid, token);
                }
                const i64 value = decimal_capacity(source, token, 4096);
                const i64 limit = configuration.array_limit(element.kind() == TypeKind::u8_type);
                if (value < 1 || value > limit) {
                    return AdmissionProgress(AdmissionResult(AdmissionStatus::array_capacity, at, at + 1, -1, limit),
                        token);
                }
            }
        } else {
            const AdmissionType type = admission_type(arena, source, token, field.type(), configuration);
            token.update(type.token());
            if (type.kind() == AdmissionKind::invalid) {
                return admission_done(AdmissionStatus::invalid, token);
            }
            if (type.kind() == AdmissionKind::owner) {
                if (scope.access() != 0) {
                    return admission_reject(AdmissionStatus::public_owner, at, token);
                }
                const TypeContext context = scope.context();
                if (context.mode() != 0) {
                    return admission_reject(AdmissionStatus::templated_owner, at, token);
                }
            } else {
                if (!admission_copied(type.kind())) {
                    return AdmissionProgress(AdmissionResult(AdmissionStatus::unsupported_field, syntax.token(),
                        field.binding(), field.type(), 0), token);
                }
            }
        }
        return admission_done(AdmissionStatus::success, token);
    }
    // Admission policy may restrict the closed group set. Unlike the lowering
    // seed catalogue, a subset is intentional (for example disabling a pair).
    // Only the appended singleton Serve bit is new; mixed/high bits stay closed.
    auto admission_service_groups(i64 groups) -> bool {
        return groups >= 0 && (u64(groups) & 4295033150u64) == u64(groups);
    }
    auto admission_module(AstArena& arena, builtin::span<const u8> source, i64 root,
        AdmissionConfig configuration) -> AdmissionResult {
        if (!arena.ok()) {
            return admission_result(AdmissionStatus::allocation_failure);
        }
        if (root < 0 || root != arena.syntax_size() - 1 || configuration.array_limit(false) < 1
            || configuration.array_limit(true) < 1 || !admission_service_groups(configuration.groups())) {
            return admission_result(AdmissionStatus::invalid);
        }
        u64 masks = 0u64;
        i64 service = 0;
        while (service < 6) {
            const i64 mask = configuration.service_mask(service);
            if ((mask != 1 && mask != 2 && mask != 4 && mask != 8 && mask != 16 && mask != 32) || (masks & u64(mask))
                != 0u64) {
                return admission_result(AdmissionStatus::invalid);
            }
            masks = masks | u64(mask);
            service = service + 1;
        }
        const SyntaxNode module_node = arena.syntax_at(root);
        if (module_node.kind() != SyntaxKind::module_definition || module_node.body() < 0 || module_node.body()
            >= root) {
            return admission_result(AdmissionStatus::invalid);
        }
        const SyntaxNode preamble = arena.syntax_at(module_node.body());
        if (preamble.kind() != SyntaxKind::preamble) {
            return admission_result(AdmissionStatus::invalid);
        }
        bool present = preamble.body() >= 0 || preamble.mutable_binding() != 0;
        const i64 base = arena.stack_size();
        const AdmissionStatus pushed = admission_push(arena, module_node.other(), SyntaxKind::declaration,
            FrameState::admission_declaration, base);
        if (pushed != AdmissionStatus::success) {
            return admission_result(pushed);
        }
        ParseToken token = read_token(source, compiler_lexer::Cursor(0, 1, 0), 0);
        TypeContext context = TypeContext();
        i64 class_begin = 0;
        i64 class_end = 0;
        i64 visited = 0;
        while (arena.stack_size() > base) {
            const ParseFrame frame = arena.frame();
            arena.pop();
            visited = visited + 1;
            if (visited > arena.syntax_size()) {
                return admission_result(AdmissionStatus::invalid);
            }
            if (frame.state() == FrameState::admission_class_end) {
                class_begin = 0;
                class_end = 0;
                context.update(TypeContext());
            } else {
                if (frame.state() != FrameState::admission_declaration) {
                    return admission_result(AdmissionStatus::invalid);
                }
                const SyntaxNode wrapper = arena.syntax_at(frame.lhs());
                if (wrapper.body() < 0 || wrapper.body() >= frame.lhs()) {
                    return admission_result(AdmissionStatus::invalid);
                }
                const SyntaxNode declaration = arena.syntax_at(wrapper.body());
                if (class_end == 0) {
                    const HeaderResult header = admission_templates(arena, source, token, wrapper.other());
                    const TypeResult parsed = header.parsed();
                    token.update(parsed.token());
                    if (parsed.status() != ParseStatus::success) {
                        return admission_result(AdmissionStatus::invalid);
                    }
                    context.update(header.context());
                } else {
                    if (wrapper.other() != -1) {
                        return admission_result(AdmissionStatus::invalid);
                    }
                }
                if (declaration.kind() == SyntaxKind::namespace_definition) {
                    if (class_end != 0 || wrapper.other() != -1) {
                        return admission_result(AdmissionStatus::invalid);
                    }
                    const AdmissionStatus children = admission_push(arena, declaration.body(), SyntaxKind::declaration,
                        FrameState::admission_declaration, base);
                    if (children != AdmissionStatus::success) {
                        return admission_result(children);
                    }
                } else {
                    if (declaration.kind() == SyntaxKind::class_definition) {
                        if (class_end != 0) {
                            return admission_result(AdmissionStatus::invalid);
                        }
                        token.update(admission_seek(source, token, declaration.token()));
                        if (token.kind() == compiler_lexer::Event::invalid_cursor) {
                            return admission_result(AdmissionStatus::invalid);
                        }
                        class_begin = token.first();
                        class_end = token.last();
                        if (!arena.push(ParseFrame(FrameState::admission_class_end, 0, wrapper.body(), 0))) {
                            return admission_result(admission_failure(arena));
                        }
                        const AdmissionStatus children = admission_push(arena, declaration.body(),
                            SyntaxKind::declaration, FrameState::admission_declaration, base);
                        if (children != AdmissionStatus::success) {
                            return admission_result(children);
                        }
                    } else {
                        const AdmissionScope scope = AdmissionScope(context, class_begin, class_end,
                            wrapper.mutable_binding());
                        if (declaration.kind() == SyntaxKind::field) {
                            if (class_end == 0) {
                                return admission_result(AdmissionStatus::invalid);
                            }
                            const AdmissionProgress progress = admission_field(arena, source, token, declaration, scope,
                                configuration);
                            const AdmissionResult outcome = progress.outcome();
                            token.update(progress.token());
                            if (outcome.status() != AdmissionStatus::success) {
                                return outcome;
                            }
                        } else {
                            if (declaration.kind() == SyntaxKind::function || declaration.kind() == SyntaxKind::method
                                || declaration.kind() == SyntaxKind::constructor) {
                                const bool function = declaration.kind() == SyntaxKind::function;
                                if (function != (class_end == 0)) {
                                    return admission_result(AdmissionStatus::invalid);
                                }
                                const i64 pending = arena.stack_size();
                                const AdmissionProgress progress = admission_callable(arena, source, token, declaration,
                                    scope, configuration);
                                const AdmissionResult outcome = progress.outcome();
                                token.update(progress.token());
                                if (!arena.truncate_stack(pending)) {
                                    return admission_result(AdmissionStatus::invalid);
                                }
                                if (outcome.status() != AdmissionStatus::success) {
                                    return outcome;
                                }
                                if (function && wrapper.other() == -1) {
                                    present = true;
                                }
                            } else {
                                if (declaration.kind() != SyntaxKind::enum_definition || class_end != 0
                                    || wrapper.other() != -1) {
                                    return admission_result(AdmissionStatus::invalid);
                                }
                            }
                        }
                    }
                }
            }
        }
        if (!present) {
            return admission_at(AdmissionStatus::missing_function, module_node.end());
        }
        return admission_result(AdmissionStatus::success);
    }
}

export namespace compiler_parser {
    auto admit(AstArena& arena, builtin::span<const u8> source, i64 root,
        AdmissionConfig configuration) -> AdmissionResult {
        // Production admission starts after grammar leaves scratch at zero.
        // New frames above the saved base charge unique declaration wrappers,
        // parameter nodes and one class node per class-end marker, at most
        // syntax_size() in total. Namespace children replace their popped wrapper;
        // callable parameters temporarily share this owner. No sixth owner or
        // source-sized index is needed. The existing geometric quota covers the
        // production phase peak; arbitrary preexisting scratch is only preserved.
        const i64 base = arena.stack_size();
        const AdmissionResult result = admission_module(arena, source, root, configuration);
        if (!arena.truncate_stack(base)) {
            return admission_result(AdmissionStatus::invalid);
        }
        return result;
    }
    auto parse(AstArena& arena, builtin::span<const u8> source, compiler_lexer::Cursor cursor, Stop stop,
        TypeContext context, i64 enum_count) -> ParseResult {
        const ParseToken token = read_token(source, cursor, 0);
        if ((stop != Stop::semicolon && stop != Stop::close_parenthesis && stop != Stop::assignment && stop
            != Stop::constructor_braces && stop != Stop::body && stop != Stop::type && stop != Stop::function && stop
            != Stop::method && stop != Stop::constructor && stop != Stop::field && stop != Stop::preamble && stop
            != Stop::enum_definition && stop != Stop::module_definition) || enum_count < 0 || enum_count > 64 || (stop
            != Stop::enum_definition && enum_count != 0) || arena.size() != 0 || arena.stack_size() != 0
            || arena.arguments() != 0 || arena.types() != 0 || arena.syntax_size() != 0) {
            return ParseResult(ParseStatus::invalid, -1, arena.size(), 0, token.first(), token.half());
        }
        if (!arena.ok()) {
            return ParseResult(ParseStatus::allocation_failure, -1, 0, 0, token.first(), token.half());
        }
        if (!valid_context(source, context) || (stop == Stop::module_definition && context.mode() != 0)) {
            return ParseResult(ParseStatus::invalid, -1, 0, 0, token.first(), token.half());
        }
        if (stop == Stop::module_definition) {
            const TypeResult result = parse_module(arena, source, token);
            const ParseToken at = result.token();
            return ParseResult(result.status(), result.root(), arena.size(), at.index(), at.first(), at.half());
        }
        if (stop == Stop::preamble) {
            const TypeResult result = parse_preamble(arena, source, token);
            const ParseToken at = result.token();
            return ParseResult(result.status(), result.root(), arena.size(), at.index(), at.first(), at.half());
        }
        if (stop == Stop::enum_definition) {
            const TypeResult result = parse_enum(arena, source, token, enum_count);
            const ParseToken at = result.token();
            return ParseResult(result.status(), result.root(), arena.size(), at.index(), at.first(), at.half());
        }
        if (stop == Stop::field) {
            const TypeResult result = parse_field(arena, source, token, context);
            const ParseToken at = result.token();
            return ParseResult(result.status(), result.root(), arena.size(), at.index(), at.first(), at.half());
        }
        if (stop == Stop::function || stop == Stop::method || stop == Stop::constructor) {
            const TypeResult result = parse_callable(arena, source, token, stop, context);
            const ParseToken at = result.token();
            return ParseResult(result.status(), result.root(), arena.size(), at.index(), at.first(), at.half());
        }
        if (stop == Stop::type) {
            const TypeResult result = parse_type(arena, source, token, context, ParseFrame(FrameState::type_start, 0,
                -1, -1));
            const ParseToken at = result.token();
            if (result.status() == ParseStatus::success && !arena.own_type(result.root(), 0, 3)) {
                return ParseResult(ParseStatus::invalid, -1, 0, at.index(), at.first(), at.half());
            }
            return ParseResult(result.status(), result.root(), arena.size(), at.index(), at.first(), at.half());
        }
        if (stop == Stop::body) {
            const TypeResult result = parse_body(arena, source, token, context);
            const ParseToken at = result.token();
            return ParseResult(result.status(), result.root(), arena.size(), at.index(), at.first(), at.half());
        }
        const TypeResult result = parse_into(arena, source, token, stop, context);
        const ParseToken at = result.token();
        return ParseResult(result.status(), result.root(), arena.size(), at.index(), at.first(), at.half());
    }
    auto create(builtin::ByteRegion region, i64 capacity) -> AstArena {
        AstArena arena = make_arena(region, capacity);
        return move(arena);
    }
    auto node_count(const AstArena& arena) -> i64 {
        return arena.size();
    }
    auto read_node(const AstArena& arena, i64 index) -> AstNode {
        const AstNode node = arena.at(index);
        return node;
    }
    auto edge_count(const AstArena& arena) -> i64 {
        return arena.arguments();
    }
    auto read_edge(const AstArena& arena, i64 index) -> ChildEdge {
        const ChildEdge edge = arena.edge(index);
        return edge;
    }
    auto type_count(const AstArena& arena) -> i64 {
        return arena.types();
    }
    auto read_type(const AstArena& arena, i64 index) -> TypeSyntax {
        const TypeSyntax type = arena.type_at(index);
        return type;
    }
    auto syntax_count(const AstArena& arena) -> i64 {
        return arena.syntax_size();
    }
    auto read_syntax(const AstArena& arena, i64 index) -> SyntaxNode {
        const SyntaxNode statement = arena.syntax_at(index);
        return statement;
    }
    auto release(builtin::ByteRegion region, AstArena arena) -> i64 {
        return 0;
    }
}
