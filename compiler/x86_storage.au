            while (at < retainedSize) {
                const IndexRow id = retained.at(at);
                if (id.value() < 0 || id.value() >= callable_count) {
                    return fail();
                }
                retained.set(retainedSize + at, id);
                at = at + 1;
            }
            at = retainedSize / 2;
            while (at > 0) {
                at = at - 1;
                retained_sift(at, retainedSize);
