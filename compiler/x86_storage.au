        }
        auto left_in_rcx() const -> bool {
            return leftInRcx;
        }
        auto set_left_in_rcx(bool value) -> bool {
            leftInRcx = value;
            return ok();
        }
        auto owned_span_runtime() const -> bool {
            return ownedSpanRuntime;
        }
        auto set_owned_span_runtime(bool value) -> bool {
            ownedSpanRuntime = value;
            return ok();
        }
        auto set_saves(i64 receiver, i64 record, i64 result) -> bool {
            receiverSave = receiver;
            callRecordSave = record;
            resultSave = result;
            return ok();
        }
        auto next_division() -> i64 {
            const i64 result = divisionIndex;
            divisionIndex = divisionIndex + 1;
            return result;
        }
        auto set_copy(i64 source, i64 destination, i64 source_first, i64 destination_first) -> bool {
            copySource = source;
            copyDestination = destination;
            copySourceFirst = source_first;
            copyDestinationFirst = destination_first;
            return ok();
        }
        auto add_retained(i64 callable) -> bool {
            if (outcome != EmitStatus::pending || callable < 0) {
                return fail();
            }
            if (retainedSize == retained.size()) {
                const IndexRow fill = IndexRow(-1);
                const i64 capacity = grow_capacity(retainedSize, retainedSize + 1, 9223372036854775807 / 8, 16);
                if (capacity < 0) {
                    return limit_failure();
                }
                if (!retained.try_resize(capacity, fill)) {
                    return allocation_failure();
                }
            }
            const IndexRow value = IndexRow(callable);
            retained.set(retainedSize, value);
            retainedSize = retainedSize + 1;
            return true;
        }
        auto retained_count() const -> i64 {
            return retainedSize;
        }
        auto retained_at(i64 at) const -> i64 {
            const IndexRow value = retained.at(at);
            return value.value();
        }
        auto retained_sift(i64 first, i64 count) -> bool {
            i64 root = first;
            while (root < count / 2) {
                i64 child = root * 2 + 1;
                const IndexRow left = retained.at(retainedSize + child);
