    }
    auto emit_direct_runtime(EmitWorkspace& w, ObjectWorkspace& object, i64 symbol) -> bool {
        if (!emit_object_status(w, object) || symbol < 0 || symbol >= w.runtime_count()) {
            return w.fail();
        }
        w.record_call(2, symbol);
        const NameRow name = w.runtime_name(symbol);
        if (object.object_mode()) {
            if (!object.has_runtime_symbol(symbol)) {
                object.begin_runtime_symbol(symbol);
                i64 at = 0;
                while (at < name.count() && object.ok()) {
                    const i64 value = w.name_byte(name.begin() + at);
                    object.object_name_byte(u8(value));
                    at = at + 1;
                }
                object.end_object_symbol_name();
            }
            object.object_call_runtime(symbol);
            return emit_object_status(w, object);
        }
        w.text("    call ");
        i64 at = 0;
        while (at < name.count() && w.ok()) {
            const i64 value = w.name_byte(name.begin() + at);
            w.byte(u8(value));
            at = at + 1;
        }
        return w.end_line();
    }
    auto emit_call_runtime(EmitWorkspace& w, ObjectWorkspace& object, i64 symbol) -> bool {
        emit_prepare_call(w, object);
        emit_direct_runtime(w, object, symbol);
        return emit_finish_call(w, object);
    }
    auto emit_service_completion(EmitWorkspace& w, ObjectWorkspace& object, i64 symbol, i64 arguments,
        i64 maximum) -> bool {
        if (!w.record_service(symbol, arguments, maximum)) {
            return false;
        }
        emit_alu_imm(w, object, AluOp::compare, maximum, Register::rax);
        return emit_branch(w, object, 7, 4, 0);
    }
    auto finish_assembly(EmitWorkspace& w, ObjectWorkspace& object) -> bool {
        if (!emit_object_status(w, object)) {
            return false;
        }
        if (object.object_mode()) {
            if (!w.executable_empty()) {
                return w.unsupported_object();
            }
            if (!object.seal()) {
                return emit_object_status(w, object);
            }
            w.select_object();
            const i64 width = object.maximum_name_width();
            if (!w.object_name_width(width)) {
                return false;
            }
            const i64 size = object.size();
            i64 offset = 0;
            while (offset < size && w.ok()) {
                const EmitChunk chunk = object.chunk(offset);
                if (chunk.size() <= 0 || chunk.size() > size - offset) {
                    return w.fail();
                }
                i64 at = 0;
                while (at < chunk.size() && w.ok()) {
                    w.byte(chunk.at(at));
                    at = at + 1;
                }
                offset = offset + chunk.size();
            }
        }
        return w.finish_assembly();
    }
    auto create(builtin::ByteRegion region) -> EmitWorkspace {
        EmitWorkspace result = EmitWorkspace(region);
        return move(result);
    }
    auto release(builtin::ByteRegion region, EmitWorkspace workspace) -> i64 {
        return 0;
    }
}
