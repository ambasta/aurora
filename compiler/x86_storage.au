                    return fail();
                }
                at = at + 1;
            }
            return ok();
        }
        auto sort_prepare() -> bool {
            const IndexRow empty = IndexRow(-1);
            const i64 maximum = 9223372036854775807 / 8;
            if (functionSize > maximum - retainedSize || callSize > maximum - retainedSize - functionSize) {
                return limit_failure();
