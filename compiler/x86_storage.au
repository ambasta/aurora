    class EmitChunk {
        builtin::array<u8, 512> payload;
        i64 byteCount;
    public:
        EmitChunk() : payload{}, byteCount(0) {
        }
        auto size() const -> i64 {
            return byteCount;
        }
        auto at(i64 index) const -> u8 {
            return payload[index];
        }
        auto append(u8 value) -> bool {
            if (byteCount >= 512) {
                return false;
            }
            payload[byteCount] = value;
            byteCount = byteCount + 1;
            return true;
        }
        auto invalidate() -> bool {
            byteCount = -1;
            return false;
        }
    };
    // Checked geometric growth. Limits come from byte extents, not a row quota.
    auto grow_capacity(i64 current, i64 required, i64 maximum, i64 minimum) -> i64 {
        if (current < 0 || required < 0 || maximum < 0 || minimum < 0 || current > maximum || required > maximum) {
            return -1;
        }
        if (required <= current) {
            return current;
        }
        i64 capacity = minimum;
        if (current > 0) {
            capacity = maximum;
            if (current <= maximum / 2) {
                capacity = current * 2;
            }
        }
        if (capacity > maximum) {
            capacity = maximum;
        }
        if (capacity < required) {
            capacity = required;
        }
        return capacity;
    }
    auto stack_byte_bound(i64 assembly, i64 function_count, i64 call_count) -> i64 {
        if (assembly < 0 || function_count < 0 || call_count < 0) {
            return -1;
        }
        if (assembly > (9223372036854775807 - 1024) / 2) {
            return -1;
        }
        i64 result = assembly * 2 + 1024;
        if (function_count > (9223372036854775807 - result) / 1024) {
            return -1;
        }
        result = result + function_count * 1024;
        if (call_count > (9223372036854775807 - result) / 128) {
            return -1;
        }
        return result + call_count * 128;
    }
    class EmitWorkspace {
