        i64 outputSize;
        i64 artifactBegin;
        i64 artifactLimit;
        i64 assemblySize;
        i64 stackSize;
        i64 abiSize;
        i64 nameSize;
        i64 retainedSize;
        i64 functionSize;
        i64 callSize;
        i64 callBegin;
        i64 loanSize;
        i64 runtimeSize;
        i64 abiNameSize;
        i64 currentCallable;
        i64 currentFunction;
        i64 functionIndex;
        i64 divisionIndex;
        i64 stackDepth;
        i64 liveStackBytes;
        i64 receiverSave;
        i64 callRecordSave;
        i64 resultSave;
        i64 copySource;
        i64 copyDestination;
        i64 copySourceFirst;
        i64 copyDestinationFirst;
        bool directResult;
        bool leftInRcx;
        bool ownedSpanRuntime;
    public:
        EmitWorkspace(builtin::ByteRegion region) : output(region.try_allocate(0)), names(region.try_allocate(0)),
            retained(IndexRow_pool(region)), functions(FunctionFact_pool(region)), calls(CallFact_pool(region)),
            loans(LoanRow_pool(region)), runtimeNames(NameRow_pool(region)), abiNames(AbiNameRow_pool(region)),
            outcome(EmitStatus::pending), outputSize(0), artifactBegin(0), artifactLimit(67108864), assemblySize(0),
            stackSize(0), abiSize(0), nameSize(0), retainedSize(0), functionSize(0), callSize(0), callBegin(0),
            loanSize(0), runtimeSize(0), abiNameSize(0), currentCallable(-1), currentFunction(-1), functionIndex(0),
            divisionIndex(0), stackDepth(0), liveStackBytes(8), receiverSave(0), callRecordSave(0), resultSave(0),
            copySource(0), copyDestination(0), copySourceFirst(0), copyDestinationFirst(0), directResult(false),
            leftInRcx(false), ownedSpanRuntime(false) {
        }
        auto allocated() const -> bool {
            return output.ok() && names.ok() && retained.ok() && functions.ok() && calls.ok() && loans.ok()
                && runtimeNames.ok() && abiNames.ok();
        }
        auto status() const -> EmitStatus {
            return outcome;
        }
        auto ok() const -> bool {
            return outcome == EmitStatus::pending || outcome == EmitStatus::running || outcome == EmitStatus::complete;
        }
        auto fail() -> bool {
            if (ok()) {
                outcome = EmitStatus::invalid;
            }
            return false;
        }
        auto allocation_failure() -> bool {
            if (ok()) {
                outcome = EmitStatus::allocation;
            }
            return false;
        }
        auto limit_failure() -> bool {
            if (ok()) {
                outcome = EmitStatus::limit;
            }
            return false;
        }
        auto reserve_output(i64 count) -> bool {
            if (!ok()) {
                return false;
            }
            if (count < 0) {
                return fail();
            }
            if (count > artifactLimit - (outputSize - artifactBegin) || count > 9223372036854775807 - outputSize) {
                return limit_failure();
            }
            const i64 required = outputSize + count;
            if (required <= output.size()) {
                return true;
            }
            const i64 capacity = grow_capacity(output.size(), required, 9223372036854775807, 4096);
            if (capacity < 0) {
                return limit_failure();
            }
            if (!output.try_resize(capacity)) {
                return allocation_failure();
            }
            return true;
        }
        auto byte(u8 value) -> bool {
            if (!reserve_output(1)) {
                return false;
            }
            if (!output.set(outputSize, value)) {
                return fail();
            }
            outputSize = outputSize + 1;
            return true;
        }
        auto text(builtin::span<const u8> value) -> bool {
            if (!reserve_output(value.size())) {
                return false;
            }
            i64 at = 0;
            while (at < value.size()) {
                if (!output.set(outputSize + at, value.at(at))) {
                    return fail();
                }
                at = at + 1;
            }
            outputSize = outputSize + value.size();
            return true;
        }
        auto begin_line() -> bool {
            return text("    ");
        }
        auto end_line() -> bool {
            return byte('\n');
        }
        auto line(builtin::span<const u8> value) -> bool {
            begin_line();
            text(value);
            return end_line();
        }
        auto unsigned_number(u64 value) -> bool {
            i64 place = std_decimal::width_u64(value);
            while (place > 0) {
                place = place - 1;
                byte(std_decimal::digit_at_u64(value, place));
            }
            return ok();
        }
        auto number(i64 value) -> bool {
            if (value < 0) {
                text("-");
                return unsigned_number(u64(-(value + 1)) + 1u64);
            }
            return unsigned_number(u64(value));
        }
        auto line_number(builtin::span<const u8> prefix, i64 value, builtin::span<const u8> suffix) -> bool {
            begin_line();
            text(prefix);
            number(value);
            text(suffix);
            return end_line();
        }
        // Tokens never cross a base boundary. Every construction/advance marks
        // sticky failure before returning -1; invalid tokens cannot be revived.
        auto pack_address(i64 base, i64 offset) -> i64 {
            if (!ok()) {
                return -1;
            }
            if (base < 0 || base > 4 || offset < 0 || offset >= 1000000000) {
                fail();
                return -1;
            }
            return base * 1000000000 + offset;
        }
        auto advance_address(i64 token, i64 bytes) -> i64 {
            if (!ok()) {
                return -1;
            }
            if (token < 0 || token >= 5000000000 || bytes < 0 || bytes >= 1000000000) {
                fail();
                return -1;
            }
            const i64 base = token / 1000000000;
            const i64 offset = token % 1000000000;
            if (base == 0) {
                if (bytes > offset) {
                    fail();
                    return -1;
                }
                return pack_address(base, offset - bytes);
            }
            if (bytes >= 1000000000 - offset) {
                fail();
                return -1;
            }
            return pack_address(base, offset + bytes);
        }
        auto address(i64 offset) -> bool {
            if (!ok()) {
                return false;
            }
            if (offset < 0 || offset >= 1000000000) {
                return fail();
            }
            text("-");
            number(offset);
            return text("(%rbp)");
        }
        auto line_address(builtin::span<const u8> prefix, i64 offset, builtin::span<const u8> suffix) -> bool {
            begin_line();
            text(prefix);
            address(offset);
            text(suffix);
            return end_line();
        }
        auto memory(i64 token) -> bool {
            if (!ok()) {
                return false;
            }
            if (token < 0 || token >= 5000000000) {
                return fail();
            }
            if (token < 1000000000) {
                return address(token);
            }
            const i64 base = token / 1000000000;
            number(token % 1000000000);
            if (base == 1) {
                return text("(%rsp)");
            }
            if (base == 2) {
                return text("(%r10)");
            }
            if (base == 3) {
                return text("(%r11)");
            }
            if (base == 4) {
                return text("(%rax)");
            }
            return fail();
        }
        auto reg(Register value) -> bool {
            if (value == Register::rax) {
                return text("%rax");
            }
            if (value == Register::rbx) {
                return text("%rbx");
            }
            if (value == Register::rcx) {
                return text("%rcx");
            }
            if (value == Register::rdx) {
                return text("%rdx");
            }
            if (value == Register::rsi) {
                return text("%rsi");
            }
            if (value == Register::rdi) {
                return text("%rdi");
            }
            if (value == Register::r8) {
                return text("%r8");
            }
            if (value == Register::r9) {
                return text("%r9");
            }
            if (value == Register::r10) {
                return text("%r10");
            }
            if (value == Register::r11) {
                return text("%r11");
            }
            return fail();
        }
        auto argument_register(i64 index, bool narrow) -> bool {
            if (index == 0) {
                if (narrow) {
                    return text("%dil");
                }
                return text("%rdi");
            }
            if (index == 1) {
                if (narrow) {
                    return text("%sil");
                }
                return text("%rsi");
            }
            if (index == 2) {
                if (narrow) {
                    return text("%dl");
                }
                return text("%rdx");
            }
            if (index == 3) {
                if (narrow) {
                    return text("%cl");
                }
                return text("%rcx");
            }
            if (index == 4) {
                if (narrow) {
                    return text("%r8b");
                }
                return text("%r8");
            }
            if (index == 5) {
                if (narrow) {
                    return text("%r9b");
                }
                return text("%r9");
            }
            return fail();
        }
        auto label(i64 id) -> bool {
            text(".Lau");
            number(functionIndex);
            text("_");
            return number(id);
        }
        auto return_label() -> bool {
            text(".Lreturn");
            return number(functionIndex);
        }
        auto current_callable() const -> i64 {
