            i64 at = 0;
            while (at < functionSize) {
                const IndexRow value = IndexRow(at);
                retained.set(retainedSize + at, value);
                at = at + 1;
            }
            at = 0;
            while (at < callSize) {
                const IndexRow value = IndexRow(at);
                retained.set(retainedSize + functionSize + at, value);
                at = at + 1;
            }
            return ok();
        }
        auto sort_at(i64 at) const -> i64 {
            const IndexRow value = retained.at(retainedSize + at);
            return value.value();
