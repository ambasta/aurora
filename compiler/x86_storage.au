export module aurora.compiler.x86_storage;
import std.decimal_digits;
import aurora.compiler.x86_object_storage;

// Bounded x86 output and emission facts. The workspace retains only selected
// callable IDs and optional ABI names; executable IR stays in the source stores.
export namespace compiler_x86 {
    enum class Artifact {
        assembly,
        stack,
        abi
    };
    class IndexRow {
        i64 valueValue;
    public:
        IndexRow(i64 value) : valueValue(value) {
        }
        auto value() const -> i64 {
            return valueValue;
        }
    };
    auto IndexRow_pool(builtin::ByteRegion region) -> builtin::OwnedValues<IndexRow> {
        const IndexRow fill = IndexRow(0);
        builtin::OwnedValues<IndexRow> result = region.try_allocate(0, fill);
        return move(result);
    }
    class FunctionFact {
        i64 kindValue;
        i64 symbolValue;
        i64 localValue;
        i64 copiedValue;
        i64 serviceValue;
    public:
        FunctionFact(i64 kind, i64 symbol, i64 local, i64 copied, i64 service) : kindValue(kind), symbolValue(symbol),
            localValue(local), copiedValue(copied), serviceValue(service) {
        }
        auto kind() const -> i64 {
            return kindValue;
        }
        auto symbol() const -> i64 {
            return symbolValue;
        }
        auto local() const -> i64 {
            return localValue;
        }
        auto copied() const -> i64 {
            return copiedValue;
        }
        auto service() const -> i64 {
            return serviceValue;
        }
    };
    auto FunctionFact_pool(builtin::ByteRegion region) -> builtin::OwnedValues<FunctionFact> {
        const FunctionFact fill = FunctionFact(0, 0, 0, 0, 0);
        builtin::OwnedValues<FunctionFact> result = region.try_allocate(0, fill);
        return move(result);
    }
    class CallFact {
        i64 functionValue;
        i64 kindValue;
        i64 symbolValue;
        i64 liveValue;
        i64 argumentsValue;
        i64 maximumValue;
    public:
        CallFact(i64 function, i64 kind, i64 symbol, i64 live, i64 arguments, i64 maximum) : functionValue(function),
            kindValue(kind), symbolValue(symbol), liveValue(live), argumentsValue(arguments), maximumValue(maximum) {
        }
        auto function() const -> i64 {
            return functionValue;
        }
        auto kind() const -> i64 {
            return kindValue;
        }
        auto symbol() const -> i64 {
            return symbolValue;
        }
        auto live() const -> i64 {
            return liveValue;
        }
        auto arguments() const -> i64 {
            return argumentsValue;
        }
        auto maximum() const -> i64 {
            return maximumValue;
        }
    };
    auto CallFact_pool(builtin::ByteRegion region) -> builtin::OwnedValues<CallFact> {
        const CallFact fill = CallFact(0, 0, 0, 0, 0, 0);
        builtin::OwnedValues<CallFact> result = region.try_allocate(0, fill);
        return move(result);
    }
    class LoanRow {
        i64 idValue;
        i64 offsetValue;
    public:
        LoanRow(i64 id, i64 offset) : idValue(id), offsetValue(offset) {
        }
        auto id() const -> i64 {
            return idValue;
        }
        auto offset() const -> i64 {
            return offsetValue;
        }
    };
    auto LoanRow_pool(builtin::ByteRegion region) -> builtin::OwnedValues<LoanRow> {
        const LoanRow fill = LoanRow(0, 0);
        builtin::OwnedValues<LoanRow> result = region.try_allocate(0, fill);
        return move(result);
    }
    class NameRow {
        i64 beginValue;
        i64 countValue;
    public:
        NameRow(i64 begin, i64 count) : beginValue(begin), countValue(count) {
        }
        auto begin() const -> i64 {
            return beginValue;
        }
        auto count() const -> i64 {
            return countValue;
        }
    };
    auto NameRow_pool(builtin::ByteRegion region) -> builtin::OwnedValues<NameRow> {
        const NameRow fill = NameRow(0, 0);
        builtin::OwnedValues<NameRow> result = region.try_allocate(0, fill);
        return move(result);
    }
    class AbiNameRow {
        i64 categoryValue;
        i64 identityValue;
        i64 memberValue;
        i64 beginValue;
        i64 countValue;
    public:
        AbiNameRow(i64 category, i64 identity, i64 member, i64 begin, i64 count) : categoryValue(category),
            identityValue(identity), memberValue(member), beginValue(begin), countValue(count) {
        }
        auto category() const -> i64 {
            return categoryValue;
        }
        auto identity() const -> i64 {
            return identityValue;
        }
        auto member() const -> i64 {
            return memberValue;
        }
        auto begin() const -> i64 {
            return beginValue;
        }
        auto count() const -> i64 {
            return countValue;
        }
    };
    auto AbiNameRow_pool(builtin::ByteRegion region) -> builtin::OwnedValues<AbiNameRow> {
        const AbiNameRow fill = AbiNameRow(0, 0, 0, 0, 0);
        builtin::OwnedValues<AbiNameRow> result = region.try_allocate(0, fill);
        return move(result);
    }
    auto stack_byte_bound(i64 assembly, i64 function_count, i64 call_count) -> i64 {
        if (assembly < 0 || function_count < 0 || call_count < 0) {
            return -1;
        }
        if (assembly > (9223372036854775807 - 1024) / 2) {
            return -1;
        }
        i64 result = assembly * 2 + 1024;
        if (function_count > (9223372036854775807 - result) / 1024) {
            return -1;
        }
        result = result + function_count * 1024;
        if (call_count > (9223372036854775807 - result) / 128) {
            return -1;
        }
        return result + call_count * 128;
    }
    class EmitWorkspace {
        builtin::OwnedBytes output;
        builtin::OwnedBytes names;
        builtin::OwnedValues<IndexRow> retained;
        builtin::OwnedValues<FunctionFact> functions;
        builtin::OwnedValues<CallFact> calls;
        builtin::OwnedValues<LoanRow> loans;
        builtin::OwnedValues<NameRow> runtimeNames;
        builtin::OwnedValues<AbiNameRow> abiNames;
        EmitStatus outcome;
        i64 outputSize;
        i64 artifactBegin;
        i64 artifactLimit;
        i64 assemblySize;
        i64 stackSize;
        i64 abiSize;
        i64 nameSize;
        i64 retainedSize;
        i64 functionSize;
        i64 callSize;
        i64 callBegin;
        i64 loanSize;
        i64 runtimeSize;
        i64 abiNameSize;
        i64 currentCallable;
        i64 currentFunction;
        i64 functionIndex;
        i64 divisionIndex;
        i64 stackDepth;
        i64 liveStackBytes;
        i64 receiverSave;
        i64 callRecordSave;
        i64 resultSave;
        i64 copySource;
        i64 copyDestination;
        i64 copySourceFirst;
        i64 copyDestinationFirst;
        bool directResult;
        bool leftInRcx;
        // Bit 0: owner-backed spans may be fragmented (kind 1); bit 1: the
        // hosted memory runtime; bit 2: code for --target aurora (the class
        // is at its 520-byte bound).
        i64 runtimeMode;
        bool objectMode;
        i64 objectNameWidth;
    public:
        EmitWorkspace(builtin::ByteRegion region) : output(region.try_allocate(0)), names(region.try_allocate(0)),
            retained(IndexRow_pool(region)), functions(FunctionFact_pool(region)), calls(CallFact_pool(region)),
            loans(LoanRow_pool(region)), runtimeNames(NameRow_pool(region)), abiNames(AbiNameRow_pool(region)),
            outcome(EmitStatus::pending), outputSize(0), artifactBegin(0), artifactLimit(67108864), assemblySize(0),
            stackSize(0), abiSize(0), nameSize(0), retainedSize(0), functionSize(0), callSize(0), callBegin(0),
            loanSize(0), runtimeSize(0), abiNameSize(0), currentCallable(-1), currentFunction(-1), functionIndex(0),
            divisionIndex(0), stackDepth(0), liveStackBytes(8), receiverSave(0), callRecordSave(0), resultSave(0),
            copySource(0), copyDestination(0), copySourceFirst(0), copyDestinationFirst(0), directResult(false),
            leftInRcx(false), runtimeMode(0), objectMode(false), objectNameWidth(0) {
        }
        auto allocated() const -> bool {
            return output.ok() && names.ok() && retained.ok() && functions.ok() && calls.ok() && loans.ok()
                && runtimeNames.ok() && abiNames.ok();
        }
        auto label_spelling(i64 kind, i64 identity) -> bool {
            if (kind == 0) {
                return label(identity);
            }
            if (kind == 1) {
                return return_label();
            }
            if (kind == 4) {
                if (identity == 0) {
                    return text(".Laurora_bounds_trap");
                }
                if (identity == 1) {
                    return text(".Laurora_overflow_trap");
                }
                if (identity == 2) {
                    return text(".Laurora_division_zero_trap");
                }
                if (identity == 3) {
                    return text(".Laurora_shift_count_trap");
                }
                return fail();
            }
            if (kind == 2) {
                text(".Ldivision_ready_");
            } else {
                if (kind == 3) {
                    text(".Ldivision_done_");
                } else {
                    if (kind == 5) {
                        text(".Lelide_copy_");
                    } else {
                        if (kind == 6) {
                            text(".Lelide_done_");
                        } else {
                            if (kind == 7) {
                                text(".Lspan_array_");
                            } else {
                                if (kind == 8) {
                                    text(".Lspan_done_");
                                } else {
                                    return fail();
                                }
                            }
                        }
                    }
                }
            }
            number(functionIndex);
            text("_");
            return number(identity);
        }
        auto condition_spelling(i64 condition) -> bool {
            if (condition == 0) {
                return text("o");
            }
            if (condition == 1) {
                return text("no");
            }
            if (condition == 2) {
                return text("b");
            }
            if (condition == 3) {
                return text("ae");
            }
            if (condition == 4) {
                return text("e");
            }
            if (condition == 5) {
                return text("ne");
            }
            if (condition == 6) {
                return text("be");
            }
            if (condition == 7) {
                return text("a");
            }
            if (condition == 8) {
                return text("s");
            }
            if (condition == 9) {
                return text("ns");
            }
            if (condition == 10) {
                return text("p");
            }
            if (condition == 11) {
                return text("np");
            }
            if (condition == 12) {
                return text("l");
            }
            if (condition == 13) {
                return text("ge");
            }
            if (condition == 14) {
                return text("le");
            }
            if (condition == 15) {
                return text("g");
            }
            return fail();
        }
        auto argument_register_id(i64 index) -> Register {
            if (index == 0) {
                return Register::rdi;
            }
            if (index == 1) {
                return Register::rsi;
            }
            if (index == 2) {
                return Register::rdx;
            }
            if (index == 3) {
                return Register::rcx;
            }
            if (index == 4) {
                return Register::r8;
            }
            if (index == 5) {
                return Register::r9;
            }
            fail();
            return Register::rax;
        }
        auto argument_reg(i64 index) -> Register {
            return argument_register_id(index);
        }
        auto byte_register(Register value) -> bool {
            if (value == Register::rax) {
                return text("%al");
            }
            if (value == Register::rbx) {
                return text("%bl");
            }
            if (value == Register::rcx) {
                return text("%cl");
            }
            if (value == Register::rdx) {
                return text("%dl");
            }
            if (value == Register::rsi) {
                return text("%sil");
            }
            if (value == Register::rdi) {
                return text("%dil");
            }
            if (value == Register::rbp) {
                return text("%bpl");
            }
            if (value == Register::rsp) {
                return text("%spl");
            }
            if (value == Register::r8) {
                return text("%r8b");
            }
            if (value == Register::r9) {
                return text("%r9b");
            }
            if (value == Register::r10) {
                return text("%r10b");
            }
            if (value == Register::r11) {
                return text("%r11b");
            }
            return fail();
        }
        auto indexed_spelling(Register base, Register index, i64 scale, i64 displacement) -> bool {
            if (displacement != 0) {
                number(displacement);
            }
            text("(");
            reg(base);
            text(",");
            reg(index);
            text(",");
            number(scale);
            return text(")");
        }
        auto alu_spelling(AluOp operation) -> bool {
            if (operation == AluOp::add) {
                return text("addq");
            }
            if (operation == AluOp::bit_or) {
                return text("orq");
            }
            if (operation == AluOp::bit_and) {
                return text("andq");
            }
            if (operation == AluOp::subtract) {
                return text("subq");
            }
            if (operation == AluOp::bit_xor) {
                return text("xorq");
            }
            if (operation == AluOp::compare) {
                return text("cmpq");
            }
            if (operation == AluOp::test) {
                return text("testq");
            }
            if (operation == AluOp::multiply) {
                return text("imulq");
            }
            return fail();
        }
        auto mov_rr(Register source, Register target) -> bool {
            text("    movq ");
            reg(source);
            text(", ");
            reg(target);
            return end_line();
        }
        auto mov_imm(i64 value, Register target) -> bool {
            // A 32-bit register write zero-extends without changing flags.
            if (value >= 0 && value <= 4294967295) {
                text("    movl $");
                number(value);
                text(", ");
                dword_register(target);
                return end_line();
            }
            if (value < -2147483648 || value > 2147483647) {
                text("    movabsq $");
            } else {
                text("    movq $");
            }
            number(value);
            text(", ");
            reg(target);
            return end_line();
        }
        auto mov_abs(i64 value, Register target) -> bool {
            return mov_imm(value, target);
        }
        auto mov_uimm(u64 value, Register target) -> bool {
            if (value <= 4294967295u64) {
                return mov_imm(i64(value), target);
            }
            if (value >= 18446744071562067968u64) {
                // The difference is at most INT32_MAX, so conversion is checked
                // and the signed spelling preserves the original 64-bit pattern.
                return mov_imm(-1 - i64(18446744073709551615u64 - value), target);
            }
            text("    movabsq $");
            if (value > 9223372036854775807u64) {
                text("-");
                unsigned_number(18446744073709551615u64 - value + 1u64);
            } else {
                unsigned_number(value);
            }
            text(", ");
            reg(target);
            return end_line();
        }
        auto load(i64 token, Register target, bool narrow) -> bool {
            if (narrow) {
                text("    movzbq ");
            } else {
                text("    movq ");
            }
            memory(token);
            text(", ");
            reg(target);
            return end_line();
        }
        auto store(Register source, i64 token, bool narrow) -> bool {
            if (narrow) {
                text("    movb ");
                byte_register(source);
            } else {
                text("    movq ");
                reg(source);
            }
            text(", ");
            memory(token);
            return end_line();
        }
        auto lea(i64 token, Register target) -> bool {
            text("    leaq ");
            memory(token);
            text(", ");
            reg(target);
            return end_line();
        }
        auto indexed_load(Register base, Register index, i64 scale, i64 displacement, Register target,
            bool narrow) -> bool {
            if (narrow) {
                text("    movzbq ");
            } else {
                text("    movq ");
            }
            indexed_spelling(base, index, scale, displacement);
            text(", ");
            reg(target);
            return end_line();
        }
        auto indexed_store(Register source, Register base, Register index, i64 scale, i64 displacement,
            bool narrow) -> bool {
            if (narrow) {
                text("    movb ");
                byte_register(source);
            } else {
                text("    movq ");
                reg(source);
            }
            text(", ");
            indexed_spelling(base, index, scale, displacement);
            return end_line();
        }
        auto indexed_lea(Register base, Register index, i64 scale, i64 displacement, Register target) -> bool {
            text("    leaq ");
            indexed_spelling(base, index, scale, displacement);
            text(", ");
            reg(target);
            return end_line();
        }
        auto alu_rr(AluOp operation, Register source, Register target) -> bool {
            begin_line();
            alu_spelling(operation);
            text(" ");
            reg(source);
            text(", ");
            reg(target);
            return end_line();
        }
        auto alu_imm(AluOp operation, i64 value, Register target) -> bool {
            begin_line();
            alu_spelling(operation);
            text(" $");
            number(value);
            text(", ");
            reg(target);
            return end_line();
        }
        auto alu_load(AluOp operation, i64 token, Register target) -> bool {
            begin_line();
            alu_spelling(operation);
            text(" ");
            memory(token);
            text(", ");
            reg(target);
            return end_line();
        }
        auto alu_mem_imm(AluOp operation, i64 value, i64 token) -> bool {
            begin_line();
            alu_spelling(operation);
            text(" $");
            number(value);
            text(", ");
            memory(token);
            return end_line();
        }
        auto store_imm_width(i64 value, i64 token, i64 width) -> bool {
            if (width != 1 && width != 2 && width != 4 && width != 8) {
                return fail();
            }

            text("    mov");
            if (width == 1) {
                text("b");
            } else {
                if (width == 2) {
                    text("w");
                } else {
                    if (width == 4) {
                        text("l");
                    } else {
                        text("q");
                    }
                }
            }
            text(" $");
            number(value);
            text(", ");
            memory(token);
            return end_line();
        }
        auto imul_imm(i64 value, Register source, Register target) -> bool {
            text("    imulq $");
            number(value);
            text(", ");
            reg(source);
            text(", ");
            reg(target);
            return end_line();
        }
        auto shift(bool left, Register target) -> bool {
            if (left) {
                text("    shlq %cl, ");
            } else {
                text("    shrq %cl, ");
            }
            reg(target);
            return end_line();
        }
        auto shift_imm(bool left, i64 count, Register target) -> bool {
            if (count < 0 || count > 63) {
                return fail();
            }
            if (left) {
                text("    shlq $");
            } else {
                text("    shrq $");
            }
            number(count);
            text(", ");
            reg(target);
            return end_line();
        }
        auto unary(UnaryOp operation, Register target) -> bool {
            i64 group = 0;
            if (operation == UnaryOp::negate) {
                group = 3;
            } else {
                if (operation == UnaryOp::bit_not) {
                    group = 2;
                } else {
                    if (operation == UnaryOp::divide) {
                        group = 7;
                    } else {
                        if (operation == UnaryOp::unsigned_divide) {
                            group = 6;
                        } else {
                            if (operation == UnaryOp::unsigned_multiply) {
                                group = 4;
                            } else {
                                return fail();
                            }
                        }
                    }
                }
            }

            if (group == 3) {
                text("    negq ");
            } else {
                if (group == 2) {
                    text("    notq ");
                } else {
                    if (group == 7) {
                        text("    idivq ");
                    } else {
                        if (group == 6) {
                            text("    divq ");
                        } else {
                            text("    mulq ");
                        }
                    }
                }
            }
            reg(target);
            return end_line();
        }
        auto push_register(Register source) -> bool {
            text("    pushq ");
            reg(source);
            return end_line();
        }
        auto pop_register(Register target) -> bool {
            text("    popq ");
            reg(target);
            return end_line();
        }
        auto set_condition(i64 condition, Register target) -> bool {
            if (condition < 0 || condition > 15) {
                return fail();
            }
            text("    set");
            condition_spelling(condition);
            text(" ");
            byte_register(target);
            return end_line();
        }
        auto zero_extend_byte(Register source, Register target) -> bool {
            text("    movzbq ");
            byte_register(source);
            text(", ");
            reg(target);
            return end_line();
        }
        auto cqto() -> bool {
            return line("cqto");
        }
        auto cld() -> bool {
            return line("cld");
        }
        auto rep_movsb() -> bool {
            return line("rep movsb");
        }
        auto rep_stosb() -> bool {
            return line("rep stosb");
        }
        auto system_call() -> bool {
            return line("syscall");
        }
        auto interrupt(i64 vector) -> bool {
            if (vector < 0 || vector > 255) {
                return fail();
            }
            return line_number("int $", vector, "");
        }
        auto return_instruction() -> bool {
            return line("ret");
        }
        auto leave_instruction() -> bool {
            return line("leave");
        }
        auto trap_instruction() -> bool {
            return line("ud2");
        }
        auto lea_base(Register base, i64 displacement, Register target) -> bool {
            text("    leaq ");
            number(displacement);
            text("(");
            reg(base);
            text("), ");
            reg(target);
            return end_line();
        }
        auto store_imm(i64 value, i64 token, bool narrow) -> bool {
            if (narrow) {
                return store_imm_width(value, token, 1);
            }
            return store_imm_width(value, token, 8);
        }
        auto cmp_imm_memory(i64 value, i64 token) -> bool {
            return alu_mem_imm(AluOp::compare, value, token);
        }
        auto bind_label(i64 kind, i64 id) -> bool {
            label_spelling(kind, id);
            return text(":\n");
        }
        auto branch(i64 cc, i64 kind, i64 id) -> bool {
            text("    j");
            if (cc == 4 && kind == 4 && id == 2) {
                text("z");
            } else {
                if (cc == -1) {
                    text("mp");
                } else {
                    condition_spelling(cc);
                }
            }
            text(" ");
            label_spelling(kind, id);
            return end_line();
        }
        auto lea_literal(i64 instruction, Register target) -> bool {
            text("    leaq .Laurora_literal_");
            number(instruction);
            text("(%rip), ");
            reg(target);
            return end_line();
        }
        auto unsupported_object() -> bool {
            if (ok()) {
                outcome = EmitStatus::unsupported;
            }
            return false;
        }
        auto object_failure(EmitStatus failure) -> bool {
            if (ok()) {
                outcome = failure;
            }
            return false;
        }
        auto select_object() -> bool {
            objectMode = true;
            return ok();
        }
        auto object_name_width(i64 width) -> bool {
            if (!objectMode || width < 0 || width > 67108864) {
                return fail();
            }
            objectNameWidth = width;
            return ok();
        }
        auto executable_empty() const -> bool {
            return outputSize == 0;
        }
        auto push_fact() -> bool {
            stackDepth = stackDepth + 1;
            return grow_stack(8);
        }
        auto pop_fact() -> bool {
            if (stackDepth <= 0) {
                return fail();
            }
            stackDepth = stackDepth - 1;
            return shrink_stack(8);
        }
        auto status() const -> EmitStatus {
            return outcome;
        }
        auto ok() const -> bool {
            return outcome == EmitStatus::pending || outcome == EmitStatus::running || outcome == EmitStatus::complete;
        }
        auto fail() -> bool {
            if (ok()) {
                outcome = EmitStatus::invalid;
            }
            return false;
        }
        auto allocation_failure() -> bool {
            if (ok()) {
                outcome = EmitStatus::allocation;
            }
            return false;
        }
        auto limit_failure() -> bool {
            if (ok()) {
                outcome = EmitStatus::limit;
            }
            return false;
        }
        auto reserve_output(i64 count) -> bool {
            if (!ok()) {
                return false;
            }
            if (count < 0) {
                return fail();
            }
            if (count > artifactLimit - (outputSize - artifactBegin) || count > 9223372036854775807 - outputSize) {
                return limit_failure();
            }
            const i64 required = outputSize + count;
            if (required <= output.size()) {
