        auto grow_stack(i64 bytes) -> bool {
            if (!ok() || currentFunction < 0 || bytes < 0 || bytes > 2147483647 - liveStackBytes) {
                return fail();
            }
            liveStackBytes = liveStackBytes + bytes;
            const FunctionFact old = functions.at(currentFunction);
            if (old.local() < liveStackBytes) {
                const FunctionFact value = FunctionFact(old.kind(), old.symbol(), liveStackBytes, old.copied(),
                    old.service());
                if (!functions.set(currentFunction, value)) {
                    return fail();
                }
            }
            return true;
        }
        auto shrink_stack(i64 bytes) -> bool {
            if (bytes < 0 || bytes > liveStackBytes - 8) {
                return fail();
            }
            liveStackBytes = liveStackBytes - bytes;
            return ok();
        }
        auto reserve_stack(i64 bytes) -> bool {
            if (!grow_stack(bytes)) {
                return false;
            }
            if (bytes == 0) {
                return line("subq $0, %rsp");
            }
            i64 remaining = bytes;
            while (remaining > 0) {
                i64 step = remaining;
                if (step > 4096) {
                    step = 4096;
                }
                line_number("subq $", step, ", %rsp");
                line("orq $0, (%rsp)");
                remaining = remaining - step;
            }
            return ok();
        }
        auto release_stack(i64 bytes) -> bool {
            line_number("addq $", bytes, ", %rsp");
            return shrink_stack(bytes);
        }
        auto push() -> bool {
            line("pushq %rax");
            stackDepth = stackDepth + 1;
            return grow_stack(8);
        }
        auto pop(builtin::span<const u8> target) -> bool {
            if (stackDepth <= 0) {
                return fail();
            }
            begin_line();
            text("popq ");
            text(target);
            end_line();
            stackDepth = stackDepth - 1;
            return shrink_stack(8);
        }
        auto pop_argument(i64 index) -> bool {
            if (stackDepth <= 0) {
                return fail();
            }
            begin_line();
            text("popq ");
            argument_register(index, false);
            end_line();
            stackDepth = stackDepth - 1;
            return shrink_stack(8);
        }
        auto prepare_call() -> bool {
            if (stackDepth % 2 != 0) {
                line("subq $8, %rsp");
                return grow_stack(8);
            }
            return ok();
        }
        auto finish_call() -> bool {
            if (stackDepth % 2 != 0) {
                return release_stack(8);
            }
            return ok();
        }
        auto record_call(i64 kind, i64 symbol) -> bool {
            if (!ok() || currentFunction < 0) {
                return fail();
            }
            i64 at = callBegin;
            while (at < callSize) {
                const CallFact old = calls.at(at);
                if (old.function() == currentFunction && old.kind() == kind && old.symbol() == symbol) {
                    if (old.live() < liveStackBytes) {
                        const CallFact value = CallFact(currentFunction, kind, symbol, liveStackBytes, old.arguments(),
                            old.maximum());
                        if (!calls.set(at, value)) {
                            return fail();
                        }
                    }
                    return true;
                }
                at = at + 1;
            }
            if (callSize == calls.size()) {
                const CallFact fill = CallFact(-1, -1, -1, 0, -1, -1);
                const i64 capacity = grow_capacity(callSize, callSize + 1, 9223372036854775807 / 48, 16);
                if (capacity < 0) {
                    return limit_failure();
                }
                if (!calls.try_resize(capacity, fill)) {
                    return allocation_failure();
                }
            }
            const CallFact value = CallFact(currentFunction, kind, symbol, liveStackBytes, -1, -1);
            calls.set(callSize, value);
            callSize = callSize + 1;
            return true;
        }
        auto call_count() const -> i64 {
            return callSize;
        }
        auto call_at(i64 at) const -> CallFact {
            const CallFact value = calls.at(at);
            return value;
        }
        auto append_name(builtin::span<const u8> name) -> i64 {
            if (!ok() || name.size() > 67174400 - nameSize) {
                limit_failure();
                return -1;
            }
            const i64 first = nameSize;
            const i64 required = nameSize + name.size();
            if (required > names.size()) {
                i64 capacity = 256;
                if (names.size() > 0) {
                    capacity = names.size() * 2;
                }
                if (capacity < required) {
                    capacity = required;
                }
                if (capacity > 67174400) {
                    capacity = 67174400;
                }
                if (!names.try_resize(capacity)) {
                    allocation_failure();
                    return -1;
                }
            }
            i64 at = 0;
            while (at < name.size()) {
                names.set(first + at, name.at(at));
                at = at + 1;
            }
            nameSize = required;
            return first;
        }
        auto name_byte(i64 at) const -> i64 {
            return i64(names.at(at));
        }
        auto runtime_name(i64 at) const -> NameRow {
            const NameRow value = runtimeNames.at(at);
            return value;
        }
        auto runtime_count() const -> i64 {
            return runtimeSize;
        }
        auto intern_runtime(builtin::span<const u8> name) -> i64 {
            // The closed runtime vocabulary has 15 names; reserve an independent
            // 64 KiB prefix so these names cannot consume the ABI-name budget.
            if (name.size() > 1024) {
                limit_failure();
                return -1;
            }
            i64 at = 0;
            while (at < runtimeSize) {
                const NameRow old = runtimeNames.at(at);
                bool equal = old.count() == name.size();
                i64 index = 0;
                while (equal && index < name.size()) {
                    equal = names.at(old.begin() + index) == name.at(index);
                    index = index + 1;
                }
                if (equal) {
                    return at;
                }
                at = at + 1;
            }
            if (runtimeSize >= 64) {
                limit_failure();
                return -1;
            }
            if (runtimeSize == runtimeNames.size()) {
                const NameRow fill = NameRow(0, 0);
                if (!runtimeNames.try_resize(64, fill)) {
                    allocation_failure();
                    return -1;
                }
            }
            const i64 first = append_name(name);
            if (first < 0) {
                return -1;
            }
            const NameRow value = NameRow(first, name.size());
            runtimeNames.set(runtimeSize, value);
            const i64 result = runtimeSize;
            runtimeSize = runtimeSize + 1;
            return result;
        }
        auto direct_runtime(builtin::span<const u8> name) -> bool {
            const i64 symbol = intern_runtime(name);
            if (symbol < 0) {
                return false;
            }
            record_call(2, symbol);
            begin_line();
            text("call ");
            text(name);
            return end_line();
        }
        auto call_runtime(builtin::span<const u8> name) -> bool {
            prepare_call();
            direct_runtime(name);
            return finish_call();
        }
        auto record_service(i64 runtime_name, i64 arguments, i64 maximum) -> bool {
            i64 at = callBegin;
            while (at < callSize) {
                const CallFact old = calls.at(at);
                if (old.function() == currentFunction && old.kind() == 2 && old.symbol() == runtime_name) {
                    const CallFact value = CallFact(currentFunction, 2, runtime_name, old.live(), arguments, maximum);
                    return calls.set(at, value);
                }
                at = at + 1;
            }
            return fail();
        }
        auto service_completion(builtin::span<const u8> name, i64 arguments, i64 maximum) -> bool {
            const i64 symbol = intern_runtime(name);
            record_service(symbol, arguments, maximum);
            line_number("cmpq $", maximum, ", %rax");
            return line("ja .Laurora_bounds_trap");
        }
        auto add_loan(i64 id, i64 offset) -> bool {
            if (loanSize == loans.size()) {
                const LoanRow fill = LoanRow(-1, -1);
                const i64 capacity = grow_capacity(loanSize, loanSize + 1, 9223372036854775807 / 16, 16);
                if (capacity < 0) {
                    return limit_failure();
                }
                if (!loans.try_resize(capacity, fill)) {
                    return allocation_failure();
                }
            }
            const LoanRow value = LoanRow(id, offset);
            loans.set(loanSize, value);
            loanSize = loanSize + 1;
            return ok();
        }
        auto loan_offset(i64 id) const -> i64 {
            i64 at = 0;
            while (at < loanSize) {
                const LoanRow row = loans.at(at);
                if (row.id() == id) {
                    return row.offset();
                }
                at = at + 1;
            }
            return -1;
        }
        auto add_abi_name(AbiNameRow value) -> bool {
            if (!ok() || value.begin() < 0 || value.count() < 0 || value.begin() > nameSize || value.count() > nameSize
                - value.begin()) {
                return fail();
            }
            // Every accepted name row contributes at least one ABI JSON byte.
            // This bound therefore follows from the requested artifact budget.
            if (abiNameSize >= 67108864) {
                return limit_failure();
            }
            if (abiNameSize == abiNames.size()) {
                const AbiNameRow fill = AbiNameRow(-1, -1, -1, 0, 0);
                const i64 capacity = grow_capacity(abiNameSize, abiNameSize + 1, 9223372036854775807 / 40, 16);
                if (capacity < 0) {
                    return limit_failure();
                }
                if (!abiNames.try_resize(capacity, fill)) {
                    return allocation_failure();
                }
            }
            abiNames.set(abiNameSize, value);
            abiNameSize = abiNameSize + 1;
            return ok();
        }
        auto abi_name_count() const -> i64 {
            return abiNameSize;
        }
        auto abi_name_at(i64 at) const -> AbiNameRow {
            const AbiNameRow row = abiNames.at(at);
            return row;
        }
        auto finish_assembly() -> bool {
            if (outcome != EmitStatus::running) {
                return fail();
            }
            assemblySize = outputSize;
            artifactBegin = outputSize;
            outcome = EmitStatus::complete;
            return true;
        }
        auto prepare_facts(Artifact artifact) -> bool {
            // Only a successfully sealed assembly permits an optional request.
            // Discard the prior optional suffix, never the executable or facts.
            // A failed optional request can be retried against the same module.
            if (assemblySize <= 0 || (artifact != Artifact::stack && artifact != Artifact::abi)) {
                return fail();
            }
            outcome = EmitStatus::running;
            outputSize = assemblySize;
            artifactBegin = assemblySize;
            stackSize = 0;
            abiSize = 0;
            artifactLimit = 67108864;
            if (artifact == Artifact::stack) {
                // Admitted ASCII symbols have disjoint assembly occurrences;
                // a service call can print twice. Fixed JSON/numeric overhead
                // is <=652/function, <=101/call and 29 wrapper bytes.
                artifactLimit = stack_byte_bound(assemblySize, functionSize, callSize);
                if (artifactLimit < 0) {
                    return limit_failure();
                }
                stackSize = -1;
            } else {
                abiSize = -1;
            }
            abiNameSize = 0;
            nameSize = 0;
            if (runtimeSize > 0) {
                const NameRow last = runtimeNames.at(runtimeSize - 1);
                nameSize = last.begin() + last.count();
            }
            return true;
        }
        auto begin_stack() -> bool {
            if (outcome != EmitStatus::running || stackSize != -1 || outputSize != artifactBegin) {
                return fail();
            }
            return true;
        }
        auto begin_abi() -> bool {
            if (outcome != EmitStatus::running || abiSize != -1 || outputSize != artifactBegin) {
                return fail();
            }
            return true;
        }
        auto finish_stack() -> bool {
            if (!ok()) {
                return false;
            }
            stackSize = outputSize - artifactBegin;
            artifactBegin = outputSize;
            outcome = EmitStatus::complete;
            return true;
        }
        auto finish_abi() -> bool {
            if (!ok()) {
                return false;
            }
            abiSize = outputSize - artifactBegin;
            outcome = EmitStatus::complete;
            return true;
        }
        auto artifact_size(Artifact artifact) const -> i64 {
            if (outcome != EmitStatus::complete) {
                return -1;
            }
            if (artifact == Artifact::assembly) {
                return assemblySize;
            }
            if (artifact == Artifact::stack && stackSize > 0) {
                return stackSize;
            }
            if (artifact == Artifact::abi && abiSize > 0) {
                return abiSize;
            }
            return -1;
        }
        auto chunk(Artifact artifact, i64 offset) const -> EmitChunk {
            EmitChunk result = EmitChunk();
            i64 count = artifact_size(artifact);
            i64 first = 0;
            if (artifact != Artifact::assembly) {
                first = assemblySize;
            }
            if (offset < 0 || offset > count) {
                result.invalidate();
                return result;
            }
            count = count - offset;
            if (count > 512) {
                count = 512;
            }
            i64 at = 0;
            while (at < count) {
                result.append(output.at(first + offset + at));
                at = at + 1;
            }
            return result;
        }
    };
    auto create(builtin::ByteRegion region) -> EmitWorkspace {
        EmitWorkspace result = EmitWorkspace(region);
        return move(result);
    }
    auto release(builtin::ByteRegion region, EmitWorkspace workspace) -> i64 {
        return 0;
    }
}
