                return fail();
            }
            if (!allocated()) {
                return allocation_failure();
            }
            outcome = EmitStatus::running;
            return true;
        }
        auto begin_function(i64 kind, i64 symbol, i64 callable) -> bool {
            if (functionSize == functions.size()) {
                const FunctionFact fill = FunctionFact(-1, -1, 8, 0, 0);
                const i64 capacity = grow_capacity(functionSize, functionSize + 1, 9223372036854775807 / 40, 16);
                if (capacity < 0) {
                    return limit_failure();
                }
                if (!functions.try_resize(capacity, fill)) {
                    return allocation_failure();
                }
            }
            const FunctionFact value = FunctionFact(kind, symbol, 8, 0, 0);
            functions.set(functionSize, value);
            currentFunction = functionSize;
            functionSize = functionSize + 1;
            currentCallable = callable;
            callBegin = callSize;
            loanSize = 0;
            divisionIndex = 0;
            stackDepth = 0;
            liveStackBytes = 8;
            receiverSave = 0;
            callRecordSave = 0;
            resultSave = 0;
            directResult = false;
            leftInRcx = false;
            return true;
        }
        auto finish_function() -> bool {
            functionIndex = functionIndex + 1;
            return ok();
        }
        auto function_count() const -> i64 {
            return functionSize;
