export module aurora.compiler.lowering_kinds;

// Closed typed lowering vocabulary. Generated facts define its bridge values;
// no host ordinal table or integer conversion supplies a second authority.
export namespace compiler_lowering {
    enum class InstructionForm {
        BindServiceParameter,
        AcquireServiceLoan,
        ReleaseServiceLoan,
        ServiceOperation,
        ServiceCall,
        Constant,
        EnumConstant,
        Load,
        Store,
        Push,
        Pop,
        UnaryValue,
        BinaryValue,
        Convert,
        Compare,
        BoundsGuard,
        IndexLoad,
        IndexStore,
        BorrowHandle,
        Call,
        AggregateCall,
        BeginObject,
        InitializeEmptyObject,
        EndObject,
        CopyObject,
        ObjectFieldCopy,
        AssignObjectField,
        InitializeObjectField,
        InitializeClassArray,
        ClassArrayBoundsGuard,
        ClassArrayCopy,
        ClassArrayAssign,
        ReceiverLoad,
        ReceiverStore,
        ReceiverArrayZero,
        ReceiverBoundsGuard,
        ReceiverIndexLoad,
        ReceiverIndexStore,
        MethodCall,
        MetadataQuery,
        Label,
        Jump,
        BranchFalse,
        Return,
        ReturnObject,
        BindParameter,
        BindObjectParameter,
        BeginArray,
        EndArray,
        BorrowSpan,
        BorrowReceiverArraySpan,
        BorrowLiteralSpan,
        BorrowOwnedSpan,
        ReturnSpan,
        ReborrowSpan,
        Subspan,
        EndSpan,
        SpanLength,
        SpanLoad,
        BindSpanParameter,
        BeginBytes,
        AllocateBytes,
        AllocateValues,
        ValuesLoad,
        ValuesStore,
        ValuesResize,
        MoveBytes,
        BytesOk,
        BytesLength,
        BytesLoad,
        BytesStore,
        BytesResize,
        EndBytes,
        BindRegionParameter,
        BindBytesParameter,
        ResourceCall,
        ReturnBytes,
        InitializeBytesField,
        MoveObject,
        BindOwnedObjectParameter,
        ReturnOwnedObject,
        AcquireObjectLoan,
        ReleaseObjectLoan,
        BorrowedCall,
        SpanValuesLoad
    };
    enum class Unary {
        CheckedNegate,
        LogicalNot,
        BitNot
    };
    enum class Binary {
        CheckedAdd,
        CheckedSubtract,
        CheckedMultiply,
        CheckedDivide,
        CheckedRemainder,
        BitAnd,
        BitOr,
        BitXor,
        ShiftLeft,
        ShiftRight
    };
    enum class Comparison {
        Equal,
        NotEqual,
        Less,
        Greater,
        LessEqual,
        GreaterEqual
    };
    enum class Query {
        Size,
        PublicFieldCount
    };
    // Fill rows are invalid records; InstructionForm has exactly the 85 IR forms.
    enum class RecordKind {
        invalid,
        Instruction,
        DiscardedInstruction,
        DiagnosticPayload,
        Configuration,
        ScalarContract,
        ServiceContract,
        InitialLayoutOrder,
        Module,
        Function,
        ScalarSlot,
        ObjectSlot,
        ArraySlot,
        SpanSlot,
        ServiceSlot,
        RegionSlot,
        ByteSlot,
        OwnedValueType,
        Receiver,
        Class,
        ClassField,
        ClassStorage,
        Carrier,
        Descriptor,
        DescriptorView,
        EnumCases,
        UnreadLocal,
        SpanValueType
    };
    // A role selects one signed, unsigned, slice, or explicitly absent payload.
    // Flat lists use their declared scalar-entry role, never raw field numbers.
    enum class OperandRole {
        invalid,
        Index,
        Offset,
        ServiceKindId,
        LoanId,
        ServiceOperationId,
        ResultOffset,
        CalleeSymbolId,
        SpanArguments,
        AdditionalServices,
        SignedConstant,
        UnsignedConstant,
        TypeId,
        CaseIndex,
        OperandTypeId,
        SourceTypeId,
        ResultTypeId,
        Length,
        ElementTypeId,
        OwnerOffset,
        ReferenceTypeId,
        ObjectArguments,
        SourceOffset,
        FieldIndex,
        ObjectOffset,
        Sources,
        ReceiverOffset,
        ReceiverFieldIndex,
        ModuleScope,
        LabelId,
        Target,
        ClassNominalId,
        ArrayOffset,
        LiteralBytes,
        RegionOffset,
        FillOffset,
        ValueOffset,
        OwnerArguments,
        Root,
        MutableValue,
        Functions,
        Classes,
        Carriers,
        Descriptors,
        DescriptorViews,
        Enumerations,
        LintDiagnostics,
        FunctionSymbolId,
        ParameterTypes,
        Slots,
        ReceiverRef,
        NoReceiver,
        BorrowedParameter, // retired; ordinal reserved, never an active payload
        ReceiverSpanField,
        NoReceiverSpan,
        FrameBytes,
        Code,
        CarrierId,
        Constructor,
        PublicAccess,
        LeafTypes,
        Fields,
        StorageRef,
        FirstLeaf,
        Array,
        ElementCount,
        LeafOffsets,
        FieldOffsets,
        SizeBytes,
        Alignment,
        ReservedBytes,
        PublicDescriptorId,
        Size,
        PublicFields,
        VisibleDescriptors,
        EnumNominalId,
        CaseCount,
        IdentifierSourceRef,
        OutputRowId,
        ServiceLoanId,
        DiagnosticSourceRef,
        DiagnosticSyntheticRef,
        NoDiagnosticSource,
        DiagnosticNameId,
        DiagnosticTypeId,
        DiagnosticInteger,
        NoDiagnosticValue,
        MaximumCopiedByteLeaves,
        MaximumCopiedNonByteLeaves,
        MaximumCopiedLeaves,
        MaximumCopiedBytes,
        MaximumByteArrayLength,
        MaximumScalarArrayLength,
        AnalysisMode,
        SupportedServiceGroups,
        InitialLayoutSymbols,
        // Retired paired-root roles retain their published ordinals only.
        SecondReceiverRef,
        NoSecondReceiver,
        SecondReceiverOffset,
        SecondLoanId,
        // Durable instruction names are resolved MetadataStore byte ranges.
        CalleeName,
        ClassName,
        BorrowedRoots,
        BorrowedRootCount,
        FirstBorrowedMutable
    };
    // Origin identity is frozen before a Local is published.
    enum class SpanOriginKind {
        none,
        incoming_parameter,
        receiver,
        literal,
        local
    };
    enum class ContinuationKind {
        invalid,
        function,
        expression,
        block,
        if_statement,
        while_statement,
        class_layout
    };
    // The two else phases retain the then branch return fact without a raw flag.
    enum class ContinuationPhase {
        start,
        child,
        logical_right,
        condition,
        then_branch,
        else_after_continuing_then,
        else_after_returning_then,
        loop_body,
        argument,
        select_call,
        emit_call,
        cleanup,
        next_statement,
        returning
    };
    enum class ArgumentKind {
        absent,
        scalar,
        object,
        span,
        owner,
        service,
        borrowed_receiver
    };
    enum class CleanupKind {
        none,
        object,
        span,
        owner,
        service_loan,
        object_loan
    };
}
