    class IndexRow {
        i64 domain;
        i64 key0;
        i64 key1;
        i64 key2;
        i64 key3;
        i64 payload;
        i64 left;
        i64 right;
        i64 parent;
        i64 height;
    public:
        IndexRow(i64 kind, i64 first, i64 second, i64 third, i64 fourth, i64 value) : domain(kind), key0(first),
            key1(second), key2(third), key3(fourth), payload(value), left(-1), right(-1), parent(-1), height(1) {
        }
        auto key_domain() const -> i64 {
            return domain;
        }
        auto first_key() const -> i64 {
            return key0;
        }
        auto second_key() const -> i64 {
            return key1;
        }
        auto value() const -> i64 {
            return payload;
        }
        auto left_child() const -> i64 {
            return left;
        }
        auto right_child() const -> i64 {
            return right;
        }
        auto parent_node() const -> i64 {
            return parent;
        }
        auto tree_height() const -> i64 {
            return height;
        }
        auto set_value(i64 value) -> bool {
            payload = value;
            return true;
        }
        auto set_left(i64 value) -> bool {
            left = value;
            return true;
        }
        auto set_right(i64 value) -> bool {
            right = value;
            return true;
        }
        auto set_parent(i64 value) -> bool {
            parent = value;
            return true;
        }
        auto set_height(i64 value) -> bool {
            height = value;
            return true;
        }
        auto key_order(i64 wanted, i64 first, i64 second, i64 third, i64 fourth) const -> i64 {
            if (wanted < domain) {
                return -1;
            }
            if (wanted > domain) {
                return 1;
            }
            if (first < key0) {
                return -1;
            }
            if (first > key0) {
                return 1;
            }
            if (second < key1) {
                return -1;
            }
            if (second > key1) {
                return 1;
            }
            if (third < key2) {
                return -1;
            }
            if (third > key2) {
                return 1;
            }
            if (fourth < key3) {
                return -1;
            }
            if (fourth > key3) {
                return 1;
            }
            return 0;
        }
    };

