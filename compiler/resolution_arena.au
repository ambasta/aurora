            }
            if (slot == 10) {
                return value10;
            }
            if (slot == 11) {
                return value11;
            }
            if (slot == 12) {
                return value12;
            }
            if (slot == 13) {
                return value13;
            }
            if (slot == 14) {
                return value14;
