export module aurora.compiler.resolution_arena;
import aurora.compiler.lexer;
import aurora.compiler.resolution_kinds;
import aurora.compiler.syntax_arena;
import aurora.compiler.lowering_kinds;
import aurora.compiler.lowering_errors;
import aurora.compiler.lowering_storage;
import aurora.compiler.resolution_rows;

// The host owns the granting region. Every pointer-free row and every source
// byte below belongs to this single move-only Session until explicit release.
//
// Storage charge ledger, before semantic rows and semantic index entries:
// Metadata: 64 + U + E + Q + A + P + L + H.
// Indexes: U + Q + A + P + N + L + H + 2G, in their separate typed pool.
// U is sparse projected coordinates; E seeded text references; Q new identifier
// coordinates (interned against U); A atoms; P prefixes; N name-cache entries;
// L inclusive name ranges; H import bindings; G nonempty import lists.
// U <= 3*expressions + edges + 4*types + 4*declarations <= 12*source bytes.
// Q and A are bounded by source plus seed byte counts. Each index entry and
// every referenced range has an explicit producer charge; nothing charges a
// guessed number of rows per declaration. Namespace/name candidate bounds and
// semantic metadata/worklist counts are supplied by the resolver producer.
// Scratch projection uses in-place heapsort and at most 12*one-file bytes.
// Prefix helpers add name depth (or two depths for comparison) to their caller's
// saved scratch base, then restore it; AVL balancing uses parent links, no stack.
// Count publication always follows successful set; all eleven allocation results,
// including inert failures, remain owned until ordinary consuming cleanup.
export namespace compiler_resolver {
    auto make_index_pool(builtin::ByteRegion region) -> builtin::OwnedValues<IndexRow> {
        const IndexRow fill = IndexRow(0, -1, -1, -1, -1, -1);
        builtin::OwnedValues<IndexRow> result = region.try_allocate(0, fill);
        return move(result);
    }

    class Session {
        builtin::OwnedBytes sources;
        builtin::OwnedValues<SyntaxRow> forest;
        builtin::OwnedValues<MetaRow> metadata;
        builtin::OwnedValues<ResolvedRow> resolutions;
        builtin::OwnedValues<WorkRow> scratch;
        builtin::OwnedValues<IndexRow> indexes;
        i64 source_used;
        i64 graph_source_used;
        i64 syntax_used;
        i64 meta_used;
        i64 resolved_used;
        i64 work_used;
        i64 index_used;
        i64 modules;
        i64 index_root;
        StorageStatus failure;
        SemanticError diagnostic;
        i64 diagnostic_node;
        i64 diagnostic_first;
        i64 diagnostic_second;
        // Keep the six resolver owners and all their fields in their existing order.
        // Five typed owners plus five counts add 200 bytes; the two final report
        // words bring the predicted Session extent from 304 to 520 bytes.
        builtin::OwnedValues<compiler_lowering::OutputRow> outputRows;
        builtin::OwnedValues<compiler_lowering::OperandRow> outputOperands;
        builtin::OwnedValues<compiler_lowering::LocalRow> loweringLocals;
        builtin::OwnedValues<compiler_lowering::SnapshotRow> loweringSnapshots;
        builtin::OwnedValues<compiler_lowering::ContinuationRow> loweringContinuations;
        i64 output_used;
        i64 operand_used;
        i64 local_used;
        i64 snapshot_used;
        i64 continuation_used;
        compiler_lowering::LoweringError loweringError;
        i64 diagnosticPayloadRow;

        auto next_capacity(i64 current, i64 required) -> i64 {
            if (current < 0 || required < 0) {
                fail_storage(StorageStatus::invalid);
                return -1;
            }
            i64 target = 8;
            if (current > 4) {
                if (current > 4611686018427387903) {
                    target = required;
                } else {
                    target = current * 2;
                }
            }
            if (target < required) {
                target = required;
            }
            return target;
        }
        // The capacity a pool must grow to before it holds count elements of width
        // bytes; 0 when they fit already, or -1 after latching failure. Lowering
        // widths must agree with generated ABI facts before execution; resolver
        // pools pass 1. Geometric spare capacity may shrink to the exact request at
        // i64's byte boundary. Arithmetic failure is distinct from allocation exhaustion.
        auto growth(i64 size, i64 count, i64 width) -> i64 {
            if (!good()) {
                return -1;
            }
            if (count < 0 || count > 9223372036854775807 / width) {
                return fail_storage(StorageStatus::invalid);
            }
            if (count <= size) {
                return 0;
            }
            i64 next = next_capacity(size, count);
            if (next > 9223372036854775807 / width) {
                next = count;
            }
            if (next < count) {
                return fail_storage(StorageStatus::invalid);
            }
            return next;
        }
        auto grown(bool resized) -> bool {
            if (!resized) {
                fail_storage(StorageStatus::allocation);
            }
            return resized;
        }
        auto reserve_forest(i64 count) -> bool {
            const i64 next = growth(forest.size(), count, 1);
            if (next <= 0) {
                return next == 0;
            }
            const SyntaxRow fill = SyntaxRow(SyntaxTag::invalid);
            return grown(forest.try_resize(next, fill));
        }
        auto reserve_metadata(i64 count) -> bool {
            const i64 next = growth(metadata.size(), count, 1);
            if (next <= 0) {
                return next == 0;
            }
            const MetaRow fill = MetaRow(MetaTag::invalid);
            return grown(metadata.try_resize(next, fill));
        }
        auto reserve_indexes(i64 count) -> bool {
            const i64 next = growth(indexes.size(), count, 1);
            if (next <= 0) {
                return next == 0;
            }
            const IndexRow fill = IndexRow(0, -1, -1, -1, -1, -1);
            return grown(indexes.try_resize(next, fill));
        }
        auto reserve_resolutions(i64 count) -> bool {
            const i64 next = growth(resolutions.size(), count, 1);
            if (next <= 0) {
                return next == 0;
            }
            const ResolvedRow fill = ResolvedRow();
            return grown(resolutions.try_resize(next, fill));
        }
        auto reserve_scratch(i64 count) -> bool {
            const i64 next = growth(scratch.size(), count, 1);
            if (next <= 0) {
                return next == 0;
            }
            const WorkRow fill = WorkRow(-1, -1, -1, -1, -1, -1);
            return grown(scratch.try_resize(next, fill));
        }
        auto reserve_output_rows(i64 count) -> bool {
            const i64 next = growth(outputRows.size(), count, 64);
            if (next <= 0) {
                return next == 0;
            }
            const compiler_lowering::OutputRow fill = compiler_lowering::OutputRow(
                compiler_lowering::RecordKind::invalid, compiler_lowering::InstructionForm::BindServiceParameter, 0, 0);
            return grown(outputRows.try_resize(next, fill));
        }
        auto reserve_output_operands(i64 count) -> bool {
            const i64 next = growth(outputOperands.size(), count, 40);
            if (next <= 0) {
                return next == 0;
            }
            const compiler_lowering::OperandRow fill = compiler_lowering::OperandRow(
                compiler_lowering::OperandRole::invalid, 0, 0u64, 0, 0);
            return grown(outputOperands.try_resize(next, fill));
        }
        auto reserve_lowering_locals(i64 count) -> bool {
            const i64 next = growth(loweringLocals.size(), count, 160);
            if (next <= 0) {
                return next == 0;
            }
            const compiler_lowering::LocalRow fill = compiler_lowering::LocalRow(-1, -1, 0, -1, -1, false);
            return grown(loweringLocals.try_resize(next, fill));
        }
        auto reserve_lowering_snapshots(i64 count) -> bool {
            const i64 next = growth(loweringSnapshots.size(), count, 48);
            if (next <= 0) {
                return next == 0;
            }
            const compiler_lowering::SnapshotRow fill = compiler_lowering::SnapshotRow(0, 0, false, false, false,
                false);
            return grown(loweringSnapshots.try_resize(next, fill));
        }
        auto reserve_lowering_continuations(i64 count) -> bool {
            const i64 next = growth(loweringContinuations.size(), count, 496);
            if (next <= 0) {
                return next == 0;
            }
            const compiler_lowering::ArgumentLane empty_argument = compiler_lowering::ArgumentLane(-1,
                compiler_lowering::ArgumentKind::absent, -1, -1, -1, -1);
            const compiler_lowering::ContinuationRow fill = compiler_lowering::ContinuationRow(
                compiler_lowering::ContinuationKind::invalid, -1, -1, empty_argument);
            return grown(loweringContinuations.try_resize(next, fill));
        }
        // One AVL index serves the small set of resolver key domains. Atom keys
        // compare their checked source bytes; all other domains compare integers.
        auto compare_atom(i64 first, i64 second, i64 old_begin, i64 old_length) -> i64 {
            if (first < 0 || second < 0 || first > source_used || second > source_used - first || old_begin < 0
                || old_length < 0 || old_begin > source_used || old_length > source_used - old_begin) {
                fail_storage(StorageStatus::invalid);
                return 0;
            }
            i64 at = 0;
            while (at < second && at < old_length) {
                const u8 left = sources.at(first + at);
                const u8 right = sources.at(old_begin + at);
                if (left < right) {
                    return -1;
                }
                if (left > right) {
                    return 1;
                }
                at = at + 1;
            }
            if (second < old_length) {
                return -1;
            }
            if (second > old_length) {
                return 1;
            }
            return 0;
        }
        auto valid_index_id(i64 node) -> bool {
            if (!good() || node < 0 || node >= index_used || node >= indexes.size()) {
                fail_storage(StorageStatus::invalid);
                return false;
            }
            return true;
        }
        auto set_index_row(i64 node, IndexRow row) -> bool {
            if (!good() || node < 0 || node >= index_used || row.key_domain() < 1 || !indexes.set(node, row)) {
                fail_storage(StorageStatus::invalid);
                return false;
            }
            return true;
        }
        auto append_index_row(IndexRow row) -> i64 {
            if (!good()) {
                return -1;
            }
            if (row.key_domain() < 1 || index_used == 9223372036854775807) {
                return fail_storage(StorageStatus::invalid);
            }
            if (!reserve_indexes(index_used + 1)) {
                return -1;
            }
            const i64 result = index_used;
            if (!indexes.set(result, row)) {
                return fail_storage(StorageStatus::invalid);
            }
            index_used = index_used + 1;
            return result;
        }
        auto index_height(i64 node) -> i64 {
            if (node == -1) {
                return 0;
            }
            if (!valid_index_id(node)) {
                return -1;
            }
            const IndexRow row = indexes.at(node);
            const i64 height = row.tree_height();
            if (row.key_domain() < 1 || height < 1) {
                return fail_storage(StorageStatus::invalid);
            }
            return height;
        }
        auto update_height(i64 node) -> bool {
            IndexRow row = index_row(node);
            if (!good()) {
                fail_storage(StorageStatus::invalid);
                return false;
            }
            const i64 left = index_height(row.left_child());
            const i64 right = index_height(row.right_child());
            i64 height = left;
            if (right > height) {
                height = right;
            }
            if (!good() || height == 9223372036854775807) {
                fail_storage(StorageStatus::invalid);
                return false;
            }
            row.set_height(height + 1);
            return set_index_row(node, row);
        }
        auto replace_child(i64 parent, i64 previous, i64 next) -> bool {
            if (parent == -1) {
                if (index_root != previous) {
                    fail_storage(StorageStatus::invalid);
                    return false;
                }
                index_root = next;
                return true;
            }
            IndexRow row = index_row(parent);
            if (!good()) {
                fail_storage(StorageStatus::invalid);
                return false;
            }
            if (row.left_child() == previous) {
                row.set_left(next);
            } else {
                if (row.right_child() != previous) {
                    fail_storage(StorageStatus::invalid);
                    return false;
                }
                row.set_right(next);
            }
            return set_index_row(parent, row);
        }
        auto rotate_left(i64 node) -> i64 {
            IndexRow root = index_row(node);
            const i64 child_id = root.right_child();
            IndexRow child = index_row(child_id);
            if (!good() || child.parent_node() != node) {
                return fail_storage(StorageStatus::invalid);
            }
            const i64 parent = root.parent_node();
            const i64 middle = child.left_child();
            if (middle >= 0) {
                IndexRow branch = index_row(middle);
                if (!good() || branch.parent_node() != child_id) {
                    return fail_storage(StorageStatus::invalid);
                }
                branch.set_parent(node);
                if (!set_index_row(middle, branch)) {
                    return -1;
                }
            }
            root.set_right(middle);
            root.set_parent(child_id);
            child.set_left(node);
            child.set_parent(parent);
            if (!set_index_row(node, root) || !set_index_row(child_id, child) || !replace_child(parent, node, child_id)
                || !update_height(node) || !update_height(child_id)) {
                return -1;
            }
            return child_id;
        }
        auto rotate_right(i64 node) -> i64 {
            IndexRow root = index_row(node);
            const i64 child_id = root.left_child();
            IndexRow child = index_row(child_id);
            if (!good() || child.parent_node() != node) {
                return fail_storage(StorageStatus::invalid);
            }
            const i64 parent = root.parent_node();
            const i64 middle = child.right_child();
            if (middle >= 0) {
                IndexRow branch = index_row(middle);
                if (!good() || branch.parent_node() != child_id) {
                    return fail_storage(StorageStatus::invalid);
                }
                branch.set_parent(node);
                if (!set_index_row(middle, branch)) {
                    return -1;
                }
            }
            root.set_left(middle);
            root.set_parent(child_id);
            child.set_right(node);
            child.set_parent(parent);
            if (!set_index_row(node, root) || !set_index_row(child_id, child) || !replace_child(parent, node, child_id)
                || !update_height(node) || !update_height(child_id)) {
                return -1;
            }
            return child_id;
        }
        // The matching node, or its value when value is set; -1 when absent.
        auto find(i64 domain, i64 first, i64 second, i64 third, i64 fourth, bool value) -> i64 {
            if (!good()) {
                return -1;
            }
            if (domain < 1) {
                return fail_storage(StorageStatus::invalid);
            }
            i64 node = index_root;
            i64 steps = 0;
            // Between checked row reads, only atom comparison can change sticky status.
            // Keep each node checked before its direct read, without replaying status guards.
            while (node >= 0) {
                if (steps >= index_used || node >= index_used || node >= indexes.size()) {
                    return fail_storage(StorageStatus::invalid);
                }
                steps = steps + 1;
                const IndexRow row = indexes.at(node);
                if (row.key_domain() < 1) {
                    return fail_storage(StorageStatus::invalid);
                }
                i64 order = 0;
                if (domain == 1 && row.key_domain() == 1) {
                    order = compare_atom(first, second, row.first_key(), row.second_key());
                    if (!good()) {
                        return -1;
                    }
                } else {
                    order = row.key_order(domain, first, second, third, fourth);
                }
                if (order == 0) {
                    if (value) {
                        return row.value();
                    }
                    return node;
                }
                if (order < 0) {
                    node = row.left_child();
                } else {
                    node = row.right_child();
                }
                if (node < -1) {
                    return fail_storage(StorageStatus::invalid);
                }
            }
            return -1;
        }
    public:
        Session(builtin::ByteRegion region, builtin::OwnedBytes bytes, builtin::OwnedValues<SyntaxRow> syntax,
            builtin::OwnedValues<MetaRow> meta, builtin::OwnedValues<ResolvedRow> resolved,
            builtin::OwnedValues<WorkRow> work) : sources(move(bytes)), forest(move(syntax)), metadata(move(meta)),
            resolutions(move(resolved)), scratch(move(work)), indexes(make_index_pool(region)), source_used(0),
            graph_source_used(0), syntax_used(0), meta_used(64), resolved_used(0), work_used(0), index_used(0),
            modules(0), index_root(-1), failure(StorageStatus::none), diagnostic(SemanticError::none),
            diagnostic_node(-1), diagnostic_first(-1), diagnostic_second(-1),
            outputRows(compiler_lowering::make_output_pool(region)),
            outputOperands(compiler_lowering::make_operand_pool(region)),
            loweringLocals(compiler_lowering::make_local_pool(region)),
            loweringSnapshots(compiler_lowering::make_snapshot_pool(region)),
            loweringContinuations(compiler_lowering::make_continuation_pool(region)), output_used(0), operand_used(0),
            local_used(0), snapshot_used(0), continuation_used(0),
            loweringError(compiler_lowering::LoweringError::none), diagnosticPayloadRow(-1) {
        }
        // create() checks every owner before publication; every failed resize latches failure.
        // New owner mutation or construction paths must preserve this invariant.
        auto good() const -> bool {
            return failure == StorageStatus::none && diagnostic == SemanticError::none && loweringError
                == compiler_lowering::LoweringError::none;
        }
        auto storage_status() const -> StorageStatus {
            if (failure == StorageStatus::none && (!sources.ok() || !forest.ok() || !metadata.ok() || metadata.size()
                < 64 || !resolutions.ok() || !scratch.ok() || !indexes.ok() || !outputRows.ok() || !outputOperands.ok()
                || !loweringLocals.ok() || !loweringSnapshots.ok() || !loweringContinuations.ok())) {
                return StorageStatus::allocation;
            }
            return failure;
        }
        auto fail_storage(StorageStatus code) -> i64 {
            if (failure == StorageStatus::none && diagnostic == SemanticError::none && loweringError
                == compiler_lowering::LoweringError::none) {
                failure = code;
            }
            return -1;
        }
        auto reject(SemanticError code, i64 node, i64 first, i64 second) -> i64 {
            if (diagnostic == SemanticError::none && failure == StorageStatus::none && loweringError
                == compiler_lowering::LoweringError::none) {
                if (code == SemanticError::none) {
                    failure = StorageStatus::invalid;
                } else {
                    diagnostic = code;
                    diagnostic_node = node;
                    diagnostic_first = first;
                    diagnostic_second = second;
                }
            }
            return -1;
        }
        auto error_code() const -> SemanticError {
            return diagnostic;
        }
        auto error_node() const -> i64 {
            return diagnostic_node;
        }
        auto error_first() const -> i64 {
            return diagnostic_first;
        }
        auto error_second() const -> i64 {
            return diagnostic_second;
        }
        auto lowering_error() const -> compiler_lowering::LoweringError {
            return loweringError;
        }
        auto diagnostic_payload_row() const -> i64 {
            return diagnosticPayloadRow;
        }
        auto output_count() const -> i64 {
            return output_used;
        }
        auto operand_count() const -> i64 {
            return operand_used;
        }
        auto local_count() const -> i64 {
            return local_used;
        }
        auto snapshot_count() const -> i64 {
            return snapshot_used;
        }
        auto continuation_count() const -> i64 {
            return continuation_used;
        }
        // A fixed reservation is the one-shot lowering entry marker. Reserve both
        // owners, initialize all four rows, then publish counts and the marker.
        // No source-semantic pass or success root is implemented by this operation.
        auto reserve_diagnostic_payload() -> bool {
            if (!good()) {
                return false;
            }
            if (diagnosticPayloadRow != -1 || work_used != 0 || output_used != 0 || operand_used != 0 || local_used != 0
                || snapshot_used != 0 || continuation_used != 0) {
                fail_storage(StorageStatus::invalid);
                return false;
            }
            if (!reserve_output_rows(1) || !reserve_output_operands(3)) {
                return false;
            }
            const compiler_lowering::OperandRow source = compiler_lowering::OperandRow(
                compiler_lowering::OperandRole::NoDiagnosticSource, 0, 0u64, 0, 0);
            const compiler_lowering::OperandRow value = compiler_lowering::OperandRow(
                compiler_lowering::OperandRole::NoDiagnosticValue, 0, 0u64, 0, 0);
            const compiler_lowering::OutputRow row = compiler_lowering::OutputRow(
                compiler_lowering::RecordKind::DiagnosticPayload,
                compiler_lowering::InstructionForm::BindServiceParameter, 0, 3);
            if (!outputOperands.set(0, source) || !outputOperands.set(1, value) || !outputOperands.set(2, value)
                || !outputRows.set(0, row)) {
                fail_storage(StorageStatus::invalid);
                return false;
            }
            operand_used = 3;
            output_used = 1;
            diagnosticPayloadRow = 0;
            return true;
        }
        // Payload IDs already exist at the decision site. This path never grows a
        // pool. An impossible write latches storage failure before the reason.
        auto reject_lowering(compiler_lowering::LoweringError reason, compiler_lowering::OperandRow source,
            compiler_lowering::OperandRow first, compiler_lowering::OperandRow second) -> i64 {
            if (!good()) {
                return -1;
            }
            if (reason == compiler_lowering::LoweringError::none || diagnosticPayloadRow != 0 || output_used < 1
                || operand_used < 3 || outputRows.size() < output_used || outputOperands.size() < operand_used) {
                return fail_storage(StorageStatus::invalid);
            }
            const compiler_lowering::OutputRow report = outputRows.at(0);
            if (report.kind() != compiler_lowering::RecordKind::DiagnosticPayload || report.operand_begin() != 0
                || report.operand_count() != 3) {
                return fail_storage(StorageStatus::invalid);
            }
            if (source.role() != compiler_lowering::OperandRole::NoDiagnosticSource && source.role()
                != compiler_lowering::OperandRole::DiagnosticSourceRef && source.role()
                != compiler_lowering::OperandRole::DiagnosticSyntheticRef) {
                return fail_storage(StorageStatus::invalid);
            }
            if (first.role() != compiler_lowering::OperandRole::NoDiagnosticValue && first.role()
                != compiler_lowering::OperandRole::DiagnosticNameId && first.role()
                != compiler_lowering::OperandRole::DiagnosticTypeId && first.role()
                != compiler_lowering::OperandRole::DiagnosticInteger) {
                return fail_storage(StorageStatus::invalid);
            }
            if (second.role() != compiler_lowering::OperandRole::NoDiagnosticValue && second.role()
                != compiler_lowering::OperandRole::DiagnosticNameId && second.role()
                != compiler_lowering::OperandRole::DiagnosticTypeId && second.role()
                != compiler_lowering::OperandRole::DiagnosticInteger) {
                return fail_storage(StorageStatus::invalid);
            }
            if ((source.role() != compiler_lowering::OperandRole::NoDiagnosticSource && source.signed_value() < 0)
                || (first.role() != compiler_lowering::OperandRole::NoDiagnosticValue && first.signed_value() < 0)
                || (second.role() != compiler_lowering::OperandRole::NoDiagnosticValue && second.signed_value() < 0)) {
                return fail_storage(StorageStatus::invalid);
            }
            if (!outputOperands.set(0, source) || !outputOperands.set(1, first) || !outputOperands.set(2, second)) {
                return fail_storage(StorageStatus::invalid);
            }
            loweringError = reason;
            return -1;
        }
        // Copied result views remain readable after a selected failure. Mutating
        // access below stops on the first storage, resolver, or lowering failure.
        auto view_output(i64 index) const -> compiler_lowering::OutputRow {
            if (!outputRows.ok() || index < 0 || index >= output_used || index >= outputRows.size()) {
                const compiler_lowering::OutputRow empty = compiler_lowering::OutputRow(
                    compiler_lowering::RecordKind::invalid, compiler_lowering::InstructionForm::BindServiceParameter, 0,
                    0);
                return empty;
            }
            const compiler_lowering::OutputRow row = outputRows.at(index);
            return row;
        }
        auto view_operand(i64 index) const -> compiler_lowering::OperandRow {
            if (!outputOperands.ok() || index < 0 || index >= operand_used || index >= outputOperands.size()) {
                const compiler_lowering::OperandRow empty = compiler_lowering::OperandRow(
                    compiler_lowering::OperandRole::invalid, 0, 0u64, 0, 0);
                return empty;
            }
            const compiler_lowering::OperandRow row = outputOperands.at(index);
            return row;
        }
        auto append_output(compiler_lowering::OutputRow row) -> i64 {
            if (!good()) {
                return -1;
            }
            if (diagnosticPayloadRow != 0 || row.kind() == compiler_lowering::RecordKind::invalid || row.kind()
                == compiler_lowering::RecordKind::DiagnosticPayload || row.kind()
                == compiler_lowering::RecordKind::DiscardedInstruction || row.operand_begin() < 0 || row.operand_count()
                < 0 || row.operand_begin() > operand_used || row.operand_count() > operand_used - row.operand_begin()
                || output_used == 9223372036854775807) {
                return fail_storage(StorageStatus::invalid);
            }
            if (!reserve_output_rows(output_used + 1)) {
                return -1;
            }
            const i64 result = output_used;
            if (!outputRows.set(result, row)) {
                return fail_storage(StorageStatus::invalid);
            }
            output_used = output_used + 1;
            return result;
        }
        auto append_operand(compiler_lowering::OperandRow row) -> i64 {
            if (!good()) {
                return -1;
            }
