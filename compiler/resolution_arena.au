        i64 value4;
        i64 value5;
        i64 value6;
        i64 value7;
        i64 value8;
        i64 value9;
        i64 value10;
        i64 value11;
    public:
        SyntaxRow(SyntaxTag kind) : tag(kind), expression_tag(compiler_parser::NodeKind::invalid),
