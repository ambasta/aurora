            }
            if (slot == 1) {
                value1 = value;
                return true;
            }
            if (slot == 2) {
                value2 = value;
                return true;
            }
            if (slot == 3) {
                value3 = value;
                return true;
            }
            if (slot == 4) {
                value4 = value;
                return true;
            }
            if (slot == 5) {
                value5 = value;
                return true;
            }
            if (slot == 6) {
                value6 = value;
                return true;
            }
            if (slot == 7) {
                value7 = value;
                return true;
            }
            if (slot == 8) {
                value8 = value;
                return true;
            }
            if (slot == 9) {
                value9 = value;
                return true;
            }
            if (slot == 10) {
                value10 = value;
