                    truncate_work(base);
                    return fail_storage(StorageStatus::invalid);
                }
                steps = steps + 1;
                const MetaRow row = meta(part);
                if (row.kind() != MetaTag::prefix) {
                    truncate_work(base);
                    return fail_storage(StorageStatus::invalid);
                }
                const WorkRow item = WorkRow(row.word(1), -1, -1, -1, -1, -1);
