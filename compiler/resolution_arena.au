        auto set_declaration_kind(compiler_parser::SyntaxKind kind) -> bool {
            declaration_tag = kind;
            return true;
        }
        auto word(i64 slot) const -> i64 {
            if (slot == 0) {
                return value0;
            }
            if (slot == 1) {
                return value1;
            }
            if (slot == 2) {
                return value2;
            }
            if (slot == 3) {
                return value3;
            }
            if (slot == 4) {
                return value4;
            }
            if (slot == 5) {
                return value5;
            }
            if (slot == 6) {
                return value6;
            }
            if (slot == 7) {
                return value7;
            }
            if (slot == 8) {
                return value8;
            }
            if (slot == 9) {
                return value9;
            }
            if (slot == 10) {
                return value10;
            }
            if (slot == 11) {
                return value11;
            }
            return -1;
        }
        auto set_word(i64 slot, i64 value) -> bool {
            if (slot == 0) {
                value0 = value;
                return true;
            }
            if (slot == 1) {
                value1 = value;
                return true;
            }
            if (slot == 2) {
                value2 = value;
                return true;
            }
            if (slot == 3) {
                value3 = value;
                return true;
            }
            if (slot == 4) {
                value4 = value;
                return true;
            }
            if (slot == 5) {
                value5 = value;
                return true;
            }
            if (slot == 6) {
                value6 = value;
                return true;
            }
            if (slot == 7) {
                value7 = value;
                return true;
            }
            if (slot == 8) {
                value8 = value;
                return true;
            }
            if (slot == 9) {
                value9 = value;
                return true;
            }
            if (slot == 10) {
                value10 = value;
                return true;
            }
            if (slot == 11) {
                value11 = value;
                return true;
            }
            return false;
        }
    };
