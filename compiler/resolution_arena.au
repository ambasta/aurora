export module aurora.compiler.resolution_arena;
import aurora.compiler.lexer;
import aurora.compiler.resolution_kinds;
import aurora.compiler.syntax_arena;
import aurora.compiler.lowering_kinds;
import aurora.compiler.lowering_errors;
import aurora.compiler.lowering_storage;

// The host owns the granting region. Every pointer-free row and every source
// byte below belongs to this single move-only Session until explicit release.
//
// Source-row words (all optional indices use -1):
// expression: token, first, second, depth, last, close, attached-type, role, ..., source-module.
// edge: child, previous, count, depth, field-token, ..., source-module.
// type: token, last, half-close, first, second, owner-token, role, ..., source-module.
// declaration: token, end, previous, expression, target, type, binding, body,
//              other, qualifier, borrow-token, source-module.
// Import binding additionally projects its final name token. Ingest translates
// every child/list index to a Session row and each token to a source-reference.
//
// Metadata words owned here:
// module slot 0..63: source-start/length, four base/count pairs, root, module-id,
//                   graph-order, module-scope, root-flag.
// source-reference: module-id, begin/end bytes, begin line/column, ordinal/half,
//                   end line/column, synthetic-origin (zero for real modules).
// atom: source-start/length/reference. prefix: parent/atom/depth.
// index: domain, four keys, value, left/right/parent/height.
// import: defining-module, target-module, syntax, exact-name-reference, next.
// Remaining metadata variants belong to resolver.au's semantic ledger.
//
// Storage charge ledger, before semantic rows and semantic index entries:
// Metadata: 64 + U + E + Q + A + P + L + H.
// Indexes: U + Q + A + P + N + L + H + 2G, in their separate typed pool.
// U is sparse projected coordinates; E seeded text references; Q new identifier
// coordinates (interned against U); A atoms; P prefixes; N name-cache entries;
// L inclusive name ranges; H import bindings; G nonempty import lists.
// U <= 3*expressions + edges + 4*types + 4*declarations <= 12*source bytes.
// Q and A are bounded by source plus seed byte counts. Each index entry and
// every referenced range has an explicit producer charge; nothing charges a
// guessed number of rows per declaration. Namespace/name candidate bounds and
// semantic metadata/worklist counts are supplied by the resolver producer.
// Scratch projection uses in-place heapsort and at most 12*one-file bytes.
// Prefix helpers add name depth (or two depths for comparison) to their caller's
// saved scratch base, then restore it; AVL balancing uses parent links, no stack.
// Count publication always follows successful set; all eleven allocation results,
// including inert failures, remain owned until ordinary consuming cleanup.
export namespace compiler_resolver {
    enum class StorageStatus {
        none,
        allocation,
        invalid,
        limit
    };
    enum class SyntaxTag {
        invalid,
        expression,
        edge,
        type,
        declaration
    };
    enum class MetaTag {
        invalid,
        module_source,
        module_unit,
        source_reference,
        atom,
        prefix,
        import_name,
        symbol,
        overload,
        concrete_type,
        instance,
        signature,
        public_type,
        authority,
        visibility,
        request,
        link,
        context
    };
    class SyntaxRow {
        SyntaxTag tag;
