            }
            return false;
        }
    };
    class WorkRow {
        i64 value0;
        i64 value1;
        i64 value2;
        i64 value3;
        i64 value4;
        i64 value5;
    public:
        WorkRow(i64 a0, i64 a1, i64 a2, i64 a3, i64 a4, i64 a5) : value0(a0), value1(a1), value2(a2), value3(a3),
            value4(a4), value5(a5) {
        }
        // Source requests compare ordinal, residual half, row, then field.
        auto before_request(i64 ordinal, i64 half, i64 row, i64 slot) const -> bool {
            if (value0 != ordinal) {
                return value0 < ordinal;
            }
            if (value3 != half) {
                return value3 < half;
            }
            if (value1 != row) {
                return value1 < row;
            }
            return value2 < slot;
        }
        auto word(i64 slot) const -> i64 {
            if (slot == 0) {
                return value0;
            }
            if (slot == 1) {
                return value1;
            }
            if (slot == 2) {
                return value2;
            }
            if (slot == 3) {
                return value3;
            }
            if (slot == 4) {
                return value4;
            }
            if (slot == 5) {
                return value5;
            }
            return -1;
        }
        auto set_word(i64 slot, i64 value) -> bool {
            if (slot == 0) {
                value0 = value;
                return true;
            }
            if (slot == 1) {
                value1 = value;
                return true;
            }
            if (slot == 2) {
                value2 = value;
                return true;
            }
            if (slot == 3) {
                value3 = value;
                return true;
            }
            if (slot == 4) {
                value4 = value;
                return true;
            }
            if (slot == 5) {
                value5 = value;
                return true;
            }
            return false;
        }
    };
    class SessionStatus {
        StorageStatus storage;
        SemanticError diagnostic;
        i64 node;
        i64 first;
        i64 second;
    public:
        SessionStatus(StorageStatus state, SemanticError code, i64 at, i64 a, i64 b) : storage(state), diagnostic(code),
            node(at), first(a), second(b) {
        }
        auto storage_status() const -> StorageStatus {
            return storage;
        }
        auto error_code() const -> SemanticError {
            return diagnostic;
        }
        auto error_node() const -> i64 {
            return node;
        }
        auto error_first() const -> i64 {
            return first;
        }
        auto error_second() const -> i64 {
            return second;
        }
    };

    auto make_index_pool(builtin::ByteRegion region) -> builtin::OwnedValues<IndexRow> {
        const IndexRow fill = IndexRow(0, -1, -1, -1, -1, -1);
        builtin::OwnedValues<IndexRow> result = region.try_allocate(0, fill);
        return move(result);
    }

    class Session {
        builtin::OwnedBytes sources;
        builtin::OwnedValues<SyntaxRow> forest;
        builtin::OwnedValues<MetaRow> metadata;
        builtin::OwnedValues<ResolvedRow> resolutions;
        builtin::OwnedValues<WorkRow> scratch;
        builtin::OwnedValues<IndexRow> indexes;
        i64 source_used;
        i64 graph_source_used;
        i64 syntax_used;
        i64 meta_used;
        i64 resolved_used;
        i64 work_used;
        i64 index_used;
        i64 modules;
        i64 index_root;
        StorageStatus failure;
        SemanticError diagnostic;
        i64 diagnostic_node;
        i64 diagnostic_first;
        i64 diagnostic_second;
        // Keep the six resolver owners and all their fields in their existing order.
        // Five typed owners plus five counts add 200 bytes; the two final report
        // words bring the predicted Session extent from 304 to 520 bytes.
        builtin::OwnedValues<compiler_lowering::OutputRow> outputRows;
        builtin::OwnedValues<compiler_lowering::OperandRow> outputOperands;
        builtin::OwnedValues<compiler_lowering::LocalRow> loweringLocals;
        builtin::OwnedValues<compiler_lowering::SnapshotRow> loweringSnapshots;
        builtin::OwnedValues<compiler_lowering::ContinuationRow> loweringContinuations;
        i64 output_used;
        i64 operand_used;
        i64 local_used;
        i64 snapshot_used;
        i64 continuation_used;
        compiler_lowering::LoweringError loweringError;
        i64 diagnosticPayloadRow;

        auto next_capacity(i64 current, i64 required) -> i64 {
            if (current < 0 || required < 0) {
                fail_storage(StorageStatus::invalid);
                return -1;
            }
            i64 target = 8;
            if (current > 4) {
                if (current > 4611686018427387903) {
                    target = required;
                } else {
                    target = current * 2;
                }
            }
            if (target < required) {
                target = required;
            }
            return target;
        }
        auto reserve_forest(i64 count) -> bool {
            if (!good() || count < 0) {
                return false;
            }
            if (count <= forest.size()) {
                return true;
            }
            const i64 next = next_capacity(forest.size(), count);
            if (next < count) {
                fail_storage(StorageStatus::invalid);
                return false;
            }
            const SyntaxRow fill = SyntaxRow(SyntaxTag::invalid);
            if (!forest.try_resize(next, fill)) {
                fail_storage(StorageStatus::allocation);
                return false;
            }
            return true;
        }
        auto reserve_metadata(i64 count) -> bool {
            if (!good() || count < 0) {
                return false;
            }
            if (count <= metadata.size()) {
                return true;
            }
            const i64 next = next_capacity(metadata.size(), count);
            if (next < count) {
                fail_storage(StorageStatus::invalid);
                return false;
            }
            const MetaRow fill = MetaRow(MetaTag::invalid);
            if (!metadata.try_resize(next, fill)) {
                fail_storage(StorageStatus::allocation);
                return false;
            }
            return true;
        }
        auto reserve_indexes(i64 count) -> bool {
            if (!good() || count < 0) {
                return false;
            }
            if (count <= indexes.size()) {
                return true;
            }
            const i64 next = next_capacity(indexes.size(), count);
            if (next < count) {
                fail_storage(StorageStatus::invalid);
                return false;
            }
            const IndexRow fill = IndexRow(0, -1, -1, -1, -1, -1);
            if (!indexes.try_resize(next, fill)) {
                fail_storage(StorageStatus::allocation);
                return false;
            }
            return true;
        }
        auto reserve_resolutions(i64 count) -> bool {
            if (!good() || count < 0) {
                return false;
            }
            if (count <= resolutions.size()) {
                return true;
            }
            const i64 next = next_capacity(resolutions.size(), count);
            if (next < count) {
                fail_storage(StorageStatus::invalid);
                return false;
            }
            const ResolvedRow fill = ResolvedRow();
            if (!resolutions.try_resize(next, fill)) {
                fail_storage(StorageStatus::allocation);
                return false;
            }
            return true;
        }
        auto reserve_scratch(i64 count) -> bool {
            if (!good() || count < 0) {
                return false;
            }
            if (count <= scratch.size()) {
                return true;
            }
            const i64 next = next_capacity(scratch.size(), count);
            if (next < count) {
                fail_storage(StorageStatus::invalid);
                return false;
            }
            const WorkRow fill = WorkRow(-1, -1, -1, -1, -1, -1);
            if (!scratch.try_resize(next, fill)) {
                fail_storage(StorageStatus::allocation);
                return false;
            }
            return true;
        }
        // These widths must agree with generated ABI facts before execution.
        // Geometric spare capacity may shrink to the exact request at i64's byte
        // boundary. Arithmetic failure is distinct from allocation exhaustion.
        auto next_lowering_capacity(i64 current, i64 required, i64 width) -> i64 {
            if (current < 0 || required < 0 || width < 1 || required > 9223372036854775807 / width) {
                return fail_storage(StorageStatus::invalid);
            }
            i64 target = next_capacity(current, required);
            if (target > 9223372036854775807 / width) {
                target = required;
            }
            return target;
        }
        auto reserve_output_rows(i64 count) -> bool {
            if (!good()) {
                return false;
            }
            if (count < 0 || count > 9223372036854775807 / 64) {
                fail_storage(StorageStatus::invalid);
                return false;
            }
            if (count <= outputRows.size()) {
                return true;
            }
            const i64 next = next_lowering_capacity(outputRows.size(), count, 64);
            if (next < count) {
                fail_storage(StorageStatus::invalid);
                return false;
            }
            const compiler_lowering::OutputRow fill = compiler_lowering::OutputRow(
                compiler_lowering::RecordKind::invalid, compiler_lowering::InstructionForm::BindServiceParameter, 0, 0);
            if (!outputRows.try_resize(next, fill)) {
                fail_storage(StorageStatus::allocation);
                return false;
            }
            return true;
        }
        auto reserve_output_operands(i64 count) -> bool {
            if (!good()) {
                return false;
            }
            if (count < 0 || count > 9223372036854775807 / 40) {
                fail_storage(StorageStatus::invalid);
                return false;
            }
            if (count <= outputOperands.size()) {
                return true;
            }
            const i64 next = next_lowering_capacity(outputOperands.size(), count, 40);
            if (next < count) {
                fail_storage(StorageStatus::invalid);
                return false;
            }
            const compiler_lowering::OperandRow fill = compiler_lowering::OperandRow(
                compiler_lowering::OperandRole::invalid, 0, 0u64, 0, 0);
            if (!outputOperands.try_resize(next, fill)) {
                fail_storage(StorageStatus::allocation);
                return false;
            }
            return true;
        }
        auto reserve_lowering_locals(i64 count) -> bool {
            if (!good()) {
                return false;
            }
