        i64 value1;
        i64 value2;
        i64 value3;
        i64 value4;
        i64 value5;
    public:
        WorkRow(i64 a0, i64 a1, i64 a2, i64 a3, i64 a4, i64 a5) : value0(a0), value1(a1), value2(a2), value3(a3),
            value4(a4), value5(a5) {
        }
        auto word(i64 slot) const -> i64 {
            if (slot == 0) {
                return value0;
            }
            if (slot == 1) {
