    class SessionStatus {
        StorageStatus storage;
        SemanticError diagnostic;
        i64 node;
        i64 first;
        i64 second;
    public:
        SessionStatus(StorageStatus state, SemanticError code, i64 at, i64 a, i64 b) : storage(state), diagnostic(code),
            node(at), first(a), second(b) {
        }
        auto storage_status() const -> StorageStatus {
            return storage;
        }
        auto error_code() const -> SemanticError {
            return diagnostic;
        }
        auto error_node() const -> i64 {
            return node;
        }
        auto error_first() const -> i64 {
            return first;
        }
        auto error_second() const -> i64 {
            return second;
        }
    };

    class Session {
        builtin::OwnedBytes sources;
        builtin::OwnedValues<SyntaxRow> forest;
        builtin::OwnedValues<MetaRow> metadata;
        builtin::OwnedValues<ResolvedRow> resolutions;
        builtin::OwnedValues<WorkRow> scratch;
        i64 source_used;
        i64 graph_source_used;
        i64 syntax_used;
        i64 meta_used;
        i64 resolved_used;
        i64 work_used;
        i64 modules;
        i64 index_root;
        StorageStatus failure;
        SemanticError diagnostic;
        i64 diagnostic_node;
        i64 diagnostic_first;
        i64 diagnostic_second;

        auto next_capacity(i64 current, i64 required) -> i64 {
            if (current < 0 || required < 0) {
                fail_storage(StorageStatus::invalid);
                return -1;
            }
            i64 target = 8;
            if (current > 4) {
                if (current > 4611686018427387903) {
                    target = required;
                } else {
                    target = current * 2;
                }
            }
            if (target < required) {
                target = required;
            }
            return target;
        }
        auto reserve_forest(i64 count) -> bool {
            if (!good() || count < 0) {
                return false;
            }
            if (count <= forest.size()) {
                return true;
            }
            const i64 next = next_capacity(forest.size(), count);
            if (next < count) {
                fail_storage(StorageStatus::invalid);
                return false;
            }
            const SyntaxRow fill = SyntaxRow(SyntaxTag::invalid);
            if (!forest.try_resize(next, fill)) {
                fail_storage(StorageStatus::allocation);
                return false;
            }
            return true;
        }
        auto reserve_metadata(i64 count) -> bool {
            if (!good() || count < 0) {
                return false;
            }
            if (count <= metadata.size()) {
                return true;
            }
            const i64 next = next_capacity(metadata.size(), count);
            if (next < count) {
                fail_storage(StorageStatus::invalid);
                return false;
            }
            const MetaRow fill = MetaRow(MetaTag::invalid);
            if (!metadata.try_resize(next, fill)) {
                fail_storage(StorageStatus::allocation);
                return false;
            }
            return true;
        }
        auto reserve_resolutions(i64 count) -> bool {
            if (!good() || count < 0) {
                return false;
            }
            if (count <= resolutions.size()) {
                return true;
            }
            const i64 next = next_capacity(resolutions.size(), count);
            if (next < count) {
                fail_storage(StorageStatus::invalid);
                return false;
            }
            const ResolvedRow fill = ResolvedRow();
            if (!resolutions.try_resize(next, fill)) {
                fail_storage(StorageStatus::allocation);
                return false;
            }
            return true;
        }
        auto reserve_scratch(i64 count) -> bool {
            if (!good() || count < 0) {
                return false;
            }
            if (count <= scratch.size()) {
                return true;
            }
            const i64 next = next_capacity(scratch.size(), count);
            if (next < count) {
                fail_storage(StorageStatus::invalid);
                return false;
            }
            const WorkRow fill = WorkRow(-1, -1, -1, -1, -1, -1);
            if (!scratch.try_resize(next, fill)) {
                fail_storage(StorageStatus::allocation);
                return false;
            }
            return true;
        }
    public:
        Session(builtin::ByteRegion region, builtin::OwnedBytes bytes, builtin::OwnedValues<SyntaxRow> syntax,
            builtin::OwnedValues<MetaRow> meta, builtin::OwnedValues<ResolvedRow> resolved,
            builtin::OwnedValues<WorkRow> work) : sources(move(bytes)), forest(move(syntax)), metadata(move(meta)),
            resolutions(move(resolved)), scratch(move(work)), source_used(0), graph_source_used(0), syntax_used(0),
            meta_used(64), resolved_used(0), work_used(0), modules(0), index_root(-1), failure(StorageStatus::none),
            diagnostic(SemanticError::none), diagnostic_node(-1), diagnostic_first(-1), diagnostic_second(-1) {
        }
        auto good() const -> bool {
            return failure == StorageStatus::none && diagnostic == SemanticError::none && sources.ok() && forest.ok()
                && metadata.ok() && metadata.size() >= 64 && resolutions.ok() && scratch.ok();
        }
        auto storage_status() const -> StorageStatus {
            if (failure == StorageStatus::none && (!sources.ok() || !forest.ok() || !metadata.ok() || metadata.size()
                < 64 || !resolutions.ok() || !scratch.ok())) {
                return StorageStatus::allocation;
            }
            return failure;
        }
        auto fail_storage(StorageStatus code) -> i64 {
            if (failure == StorageStatus::none && diagnostic == SemanticError::none) {
                failure = code;
            }
            return -1;
        }
        auto reject(SemanticError code, i64 node, i64 first, i64 second) -> i64 {
            if (diagnostic == SemanticError::none && failure == StorageStatus::none) {
                if (code == SemanticError::none) {
                    failure = StorageStatus::invalid;
                } else {
                    diagnostic = code;
                    diagnostic_node = node;
                    diagnostic_first = first;
                    diagnostic_second = second;
                }
            }
            return -1;
        }
        auto error_code() const -> SemanticError {
            return diagnostic;
        }
        auto error_node() const -> i64 {
            return diagnostic_node;
        }
        auto error_first() const -> i64 {
            return diagnostic_first;
        }
        auto error_second() const -> i64 {
            return diagnostic_second;
        }
        auto source_size() const -> i64 {
            return source_used;
        }
        auto syntax_count() const -> i64 {
            return syntax_used;
        }
        auto meta_count() const -> i64 {
            if (!metadata.ok()) {
                return 0;
            }
            return meta_used;
        }
        auto resolved_count() const -> i64 {
            return resolved_used;
        }
        auto work_count() const -> i64 {
            return work_used;
        }
        auto module_count() const -> i64 {
            return modules;
        }
        auto view_source(i64 index) const -> i64 {
            if (!sources.ok() || index < 0 || index >= source_used || index >= sources.size()) {
                return -1;
            }
            return i64(sources.at(index));
        }
        auto source_byte(i64 index) -> u8 {
            if (!good() || index < 0 || index >= source_used) {
                fail_storage(StorageStatus::invalid);
                return 0u8;
            }
            return sources.at(index);
        }
        auto view_syntax(i64 index) const -> SyntaxRow {
            if (!forest.ok() || index < 0 || index >= syntax_used || index >= forest.size()) {
                const SyntaxRow empty = SyntaxRow(SyntaxTag::invalid);
                return empty;
            }
            const SyntaxRow row = forest.at(index);
            return row;
        }
        auto syntax(i64 index) -> SyntaxRow {
            if (!good() || index < 0 || index >= syntax_used || index >= forest.size()) {
                fail_storage(StorageStatus::invalid);
                const SyntaxRow empty = SyntaxRow(SyntaxTag::invalid);
                return empty;
            }
            const SyntaxRow row = forest.at(index);
            return row;
        }
        auto set_syntax(i64 index, SyntaxRow row) -> bool {
            if (!good() || index < 0 || index >= syntax_used || !forest.set(index, row)) {
                fail_storage(StorageStatus::invalid);
                return false;
            }
            return true;
        }
        auto view_meta(i64 index) const -> MetaRow {
            if (!metadata.ok() || index < 0 || index >= meta_used || index >= metadata.size()) {
                const MetaRow empty = MetaRow(MetaTag::invalid);
                return empty;
            }
            const MetaRow row = metadata.at(index);
            return row;
        }
        auto meta(i64 index) -> MetaRow {
            if (!good() || index < 0 || index >= meta_used || index >= metadata.size()) {
                fail_storage(StorageStatus::invalid);
                const MetaRow empty = MetaRow(MetaTag::invalid);
                return empty;
            }
            const MetaRow row = metadata.at(index);
            return row;
        }
        auto set_meta(i64 index, MetaRow row) -> bool {
            if (!good() || index < 0 || index >= meta_used || !metadata.set(index, row)) {
                fail_storage(StorageStatus::invalid);
                return false;
            }
            return true;
        }
        auto append_meta(MetaRow row) -> i64 {
            if (!good()) {
                return -1;
            }
            if (meta_used == 9223372036854775807) {
                return fail_storage(StorageStatus::invalid);
            }
            if (!reserve_metadata(meta_used + 1)) {
                return -1;
            }
            const i64 result = meta_used;
            if (!metadata.set(result, row)) {
                return fail_storage(StorageStatus::invalid);
            }
            meta_used = meta_used + 1;
            return result;
        }
        auto view_resolved(i64 index) const -> ResolvedRow {
            if (!resolutions.ok() || index < 0 || index >= resolved_used || index >= resolutions.size()) {
                const ResolvedRow empty = ResolvedRow();
                return empty;
            }
            const ResolvedRow row = resolutions.at(index);
            return row;
        }
        auto resolved(i64 index) -> ResolvedRow {
            if (!good() || index < 0 || index >= resolved_used || index >= resolutions.size()) {
                fail_storage(StorageStatus::invalid);
                const ResolvedRow empty = ResolvedRow();
                return empty;
            }
            const ResolvedRow row = resolutions.at(index);
            return row;
        }
        auto set_resolved(i64 index, ResolvedRow row) -> bool {
            if (!good() || index < 0 || index >= resolved_used || !resolutions.set(index, row)) {
                fail_storage(StorageStatus::invalid);
                return false;
            }
            return true;
        }
        auto view_work(i64 index) const -> WorkRow {
            if (!scratch.ok() || index < 0 || index >= work_used || index >= scratch.size()) {
                const WorkRow empty = WorkRow(-1, -1, -1, -1, -1, -1);
                return empty;
            }
            const WorkRow row = scratch.at(index);
            return row;
        }
        auto work(i64 index) -> WorkRow {
            if (!good() || index < 0 || index >= work_used || index >= scratch.size()) {
                fail_storage(StorageStatus::invalid);
                const WorkRow empty = WorkRow(-1, -1, -1, -1, -1, -1);
                return empty;
            }
            const WorkRow row = scratch.at(index);
            return row;
        }
        auto set_work(i64 index, WorkRow row) -> bool {
            if (!good() || index < 0 || index >= work_used || !scratch.set(index, row)) {
                fail_storage(StorageStatus::invalid);
                return false;
            }
