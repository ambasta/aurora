        auto source_prefix(i64 reference, builtin::span<const u8> text) -> bool {
            const MetaRow row = meta(reference);
            if (row.kind() != MetaTag::source_reference || row.word(1) < 0 || row.word(2) < row.word(1) || row.word(2)
                > source_used) {
                fail_storage(StorageStatus::invalid);
                return false;
            }
            if (text.size() > row.word(2) - row.word(1)) {
                return false;
            }
            i64 at = 0;
            while (at < text.size()) {
                if (sources.at(row.word(1) + at) != text.at(at)) {
                    return false;
                }
                at = at + 1;
            }
            return true;
        }
        auto scan_range(i64 begin, i64 length, compiler_lexer::Cursor cursor) const -> compiler_lexer::Lexeme {
            if (!sources.ok() || begin < 0 || length < 0 || begin > source_used || length > source_used - begin) {
                return compiler_lexer::Lexeme(compiler_lexer::Event::invalid_cursor, 0, 1, 0);
            }
            const builtin::span<const u8> all = borrow_bytes(sources);
            const builtin::span<const u8> text = all.subspan(begin, length);
            const compiler_lexer::Lexeme result = compiler_lexer::next_lexeme(text, cursor);
            return result;
        }
        auto compare_components(i64 first, i64 second, bool left_more, bool right_more) -> i64 {
            if (first == second) {
                return 0;
            }
            const MetaRow left = meta(first);
            const MetaRow right = meta(second);
            if (left.kind() != MetaTag::atom || right.kind() != MetaTag::atom || left.word(0) < 0 || right.word(0) < 0
                || left.word(1) < 1 || right.word(1) < 1 || left.word(0) > source_used || right.word(0) > source_used
                || left.word(1) > source_used - left.word(0) || right.word(1) > source_used - right.word(0)) {
                fail_storage(StorageStatus::invalid);
                return 0;
            }
            i64 at = 0;
            while (at < left.word(1) && at < right.word(1)) {
                const u8 a = sources.at(left.word(0) + at);
                const u8 b = sources.at(right.word(0) + at);
                if (a < b) {
                    return -1;
                }
                if (a > b) {
                    return 1;
                }
                at = at + 1;
            }
            if (left.word(1) < right.word(1)) {
                if (left_more && ':' > sources.at(right.word(0) + at)) {
                    return 1;
                }
                return -1;
            }
            if (left.word(1) > right.word(1)) {
                if (right_more && sources.at(left.word(0) + at) < ':') {
                    return -1;
                }
                return 1;
            }
            return 0;
        }
        // Decoded literal payload has no new module/source-reference identity.
        // Existing graph offsets stay fixed while the same owner grows safely.
        auto append_literal_byte(u8 value) -> i64 {
            if (!good()) {
                return -1;
            }
            if (source_used == 9223372036854775807) {
                return fail_storage(StorageStatus::limit);
            }
            const i64 required = source_used + 1;
            if (required > sources.size()) {
                const i64 capacity = next_capacity(sources.size(), required);
                if (capacity < required || !sources.try_resize(capacity)) {
                    return fail_storage(StorageStatus::allocation);
                }
            }
            const i64 result = source_used;
            if (!sources.set(result, value)) {
                return fail_storage(StorageStatus::invalid);
            }
            source_used = required;
            return result;
        }
        auto append_text(builtin::span<const u8> text) -> i64 {
            if (!good()) {
                return -1;
            }
            const i64 count = text.size();
            if (count < 0 || count > 2147483646 || count > 9223372036854775807 - source_used) {
                return fail_storage(StorageStatus::invalid);
            }
            const i64 required = source_used + count;
            if (required > sources.size()) {
                const i64 capacity = next_capacity(sources.size(), required);
                if (capacity < required || !sources.try_resize(capacity)) {
                    return fail_storage(StorageStatus::allocation);
                }
            }
            i64 at = 0;
            i64 line = 1;
            i64 column = 1;
            while (at < count) {
                const u8 byte = text.at(at);
                if (!sources.set(source_used + at, byte)) {
                    return fail_storage(StorageStatus::invalid);
                }
                if (byte == '\n') {
                    line = line + 1;
                    column = 1;
                } else {
                    column = column + 1;
                }
                at = at + 1;
            }
            MetaRow row = MetaRow(MetaTag::source_reference);
            row.set_word(0, -1);
            row.set_word(1, source_used);
            row.set_word(2, required);
            row.set_word(3, 1);
            row.set_word(4, 1);
            row.set_word(5, 0);
            row.set_word(6, 0);
            row.set_word(7, line);
            row.set_word(8, column);
            row.set_word(9, meta_used);
            source_used = required;
            return append_meta(row);
        }
    };
}

export namespace compiler_resolver {
    auto create(builtin::ByteRegion region) -> Session {
        builtin::OwnedBytes bytes = region.try_allocate(0);
        const SyntaxRow syntax_fill = SyntaxRow(SyntaxTag::invalid);
        builtin::OwnedValues<SyntaxRow> syntax = region.try_allocate(0, syntax_fill);
        const MetaRow meta_fill = MetaRow(MetaTag::invalid);
        builtin::OwnedValues<MetaRow> meta = region.try_allocate(64, meta_fill);
        const ResolvedRow resolved_fill = ResolvedRow();
        builtin::OwnedValues<ResolvedRow> resolved = region.try_allocate(0, resolved_fill);
        const WorkRow work_fill = WorkRow(-1, -1, -1, -1, -1, -1);
        builtin::OwnedValues<WorkRow> work = region.try_allocate(0, work_fill);
        Session session = Session(region, move(bytes), move(syntax), move(meta), move(resolved), move(work));
        if (session.storage_status() != StorageStatus::none) {
            session.fail_storage(StorageStatus::allocation);
        }
        return move(session);
    }
    auto append_source(Session& session, builtin::span<const u8> source) -> i64 {
        return session.append_source(source);
    }
    auto append_text(Session& session, builtin::span<const u8> text) -> i64 {
        return session.append_text(text);
    }
    auto count(const Session& session, i64 pool) -> i64 {
        if (pool == 0) {
            return session.source_size();
        }
        if (pool == 1) {
            return session.syntax_count();
        }
        if (pool == 2) {
            return session.meta_count();
        }
        if (pool == 3) {
            return session.resolved_count();
        }
        if (pool == 4) {
            return session.work_count();
        }
        if (pool == 5) {
            return session.module_count();
        }
        return -1;
    }
    auto read_source(const Session& session, i64 index) -> i64 {
        return session.view_source(index);
    }
    auto read_syntax(const Session& session, i64 index) -> SyntaxRow {
        const SyntaxRow row = session.view_syntax(index);
        return row;
    }
    auto read_meta(const Session& session, i64 index) -> MetaRow {
        const MetaRow row = session.view_meta(index);
        return row;
    }
    auto read_resolved(const Session& session, i64 index) -> ResolvedRow {
        const ResolvedRow row = session.view_resolved(index);
        return row;
    }
    auto status(const Session& session) -> SessionStatus {
        const SessionStatus result = SessionStatus(session.storage_status(), session.error_code(), session.error_node(),
            session.error_first(), session.error_second());
        return result;
    }
    auto release(builtin::ByteRegion region, Session session) -> i64 {
        return 0;
    }
    auto release_pair(builtin::ByteRegion region, Session session, compiler_parser::AstArena parsed) -> i64 {
        return 0;
    }
}
