            if (row.kind() != MetaTag::prefix) {
                return fail_storage(StorageStatus::invalid);
            }
            return row.word(0);
        }
        auto name_atom(i64 prefix) -> i64 {
            const MetaRow row = meta(prefix);
            if (row.kind() != MetaTag::prefix) {
                return fail_storage(StorageStatus::invalid);
            }
            return row.word(1);
        }
        auto prefix_join(i64 scope, i64 name) -> i64 {
            if (name < -1 || scope < -1) {
                return fail_storage(StorageStatus::invalid);
            }
            if (name >= 0) {
                const MetaRow named = meta(name);
                if (named.kind() != MetaTag::prefix) {
                    return fail_storage(StorageStatus::invalid);
                }
            }
            if (scope >= 0) {
                const MetaRow parent = meta(scope);
                if (parent.kind() != MetaTag::prefix) {
                    return fail_storage(StorageStatus::invalid);
                }
            }
            if (name == -1) {
                return scope;
            }
            if (scope == -1) {
                return name;
            }
            const i64 base = work_used;
            i64 part = name;
            i64 steps = 0;
            while (part >= 0 && good()) {
                if (steps >= meta_used) {
                    truncate_work(base);
                    return fail_storage(StorageStatus::invalid);
                }
                steps = steps + 1;
                const MetaRow row = meta(part);
                if (row.kind() != MetaTag::prefix) {
                    truncate_work(base);
                    return fail_storage(StorageStatus::invalid);
                }
                const WorkRow item = WorkRow(row.word(1), -1, -1, -1, -1, -1);
                if (append_work(item) < 0) {
                    truncate_work(base);
                    return -1;
                }
                part = row.word(0);
            }
            i64 result = scope;
            i64 at = work_used;
            while (at > base && good()) {
                at = at - 1;
                const WorkRow item = work(at);
                result = intern_prefix(result, item.word(0));
            }
            truncate_work(base);
            return result;
        }
        auto compare_components(i64 first, i64 second, bool left_more, bool right_more) -> i64 {
            if (first == second) {
                return 0;
            }
            const MetaRow left = meta(first);
            const MetaRow right = meta(second);
            if (left.kind() != MetaTag::atom || right.kind() != MetaTag::atom || left.word(0) < 0 || right.word(0) < 0
                || left.word(1) < 1 || right.word(1) < 1 || left.word(0) > source_used || right.word(0) > source_used
                || left.word(1) > source_used - left.word(0) || right.word(1) > source_used - right.word(0)) {
                fail_storage(StorageStatus::invalid);
                return 0;
            }
            i64 at = 0;
            while (at < left.word(1) && at < right.word(1)) {
                const u8 a = sources.at(left.word(0) + at);
                const u8 b = sources.at(right.word(0) + at);
                if (a < b) {
                    return -1;
                }
                if (a > b) {
                    return 1;
                }
                at = at + 1;
            }
            if (left.word(1) < right.word(1)) {
                if (left_more && ':' > sources.at(right.word(0) + at)) {
                    return 1;
                }
                return -1;
            }
            if (left.word(1) > right.word(1)) {
                if (right_more && sources.at(left.word(0) + at) < ':') {
                    return -1;
                }
                return 1;
            }
            return 0;
        }
        auto prefix_compare(i64 first, i64 second) -> i64 {
            if (first == second) {
                return 0;
            }
            const i64 base = work_used;
            i64 part = first;
            i64 steps = 0;
            while (part >= 0 && good()) {
                if (steps >= meta_used) {
                    truncate_work(base);
                    return fail_storage(StorageStatus::invalid);
                }
                steps = steps + 1;
                const MetaRow row = meta(part);
                if (row.kind() != MetaTag::prefix) {
                    truncate_work(base);
                    return fail_storage(StorageStatus::invalid);
                }
                const WorkRow item = WorkRow(row.word(1), -1, -1, -1, -1, -1);
                if (append_work(item) < 0) {
                    truncate_work(base);
                    return 0;
                }
                part = row.word(0);
            }
            const i64 middle = work_used;
            part = second;
            steps = 0;
            while (part >= 0 && good()) {
                if (steps >= meta_used) {
                    truncate_work(base);
                    return fail_storage(StorageStatus::invalid);
                }
                steps = steps + 1;
                const MetaRow row = meta(part);
                if (row.kind() != MetaTag::prefix) {
                    truncate_work(base);
                    return fail_storage(StorageStatus::invalid);
                }
                const WorkRow item = WorkRow(row.word(1), -1, -1, -1, -1, -1);
                if (append_work(item) < 0) {
                    truncate_work(base);
                    return 0;
                }
                part = row.word(0);
            }
            i64 left = middle;
            i64 right = work_used;
            i64 result = 0;
            while (left > base && right > middle && result == 0 && good()) {
                left = left - 1;
                right = right - 1;
                const WorkRow a = work(left);
                const WorkRow b = work(right);
                result = compare_components(a.word(0), b.word(0), left > base, right > middle);
            }
            if (result == 0) {
                if (left > base) {
                    result = 1;
                }
                if (right > middle) {
                    result = -1;
                }
            }
            truncate_work(base);
            return result;
        }
        auto append_text(builtin::span<const u8> text) -> i64 {
            if (!good()) {
                return -1;
            }
            const i64 count = text.size();
            if (count < 0 || count > 2147483646 || count > 9223372036854775807 - source_used) {
                return fail_storage(StorageStatus::invalid);
            }
            const i64 required = source_used + count;
            if (required > sources.size()) {
                const i64 capacity = next_capacity(sources.size(), required);
                if (capacity < required || !sources.try_resize(capacity)) {
                    return fail_storage(StorageStatus::allocation);
                }
            }
            i64 at = 0;
            i64 line = 1;
            i64 column = 1;
            while (at < count) {
                const u8 byte = text.at(at);
                if (!sources.set(source_used + at, byte)) {
                    return fail_storage(StorageStatus::invalid);
                }
                if (byte == '\n') {
                    line = line + 1;
                    column = 1;
                } else {
                    column = column + 1;
                }
                at = at + 1;
            }
            MetaRow row = MetaRow(MetaTag::source_reference);
            row.set_word(0, -1);
            row.set_word(1, source_used);
            row.set_word(2, required);
            row.set_word(3, 1);
            row.set_word(4, 1);
            row.set_word(5, 0);
            row.set_word(6, 0);
            row.set_word(7, line);
            row.set_word(8, column);
            row.set_word(9, meta_used);
            source_used = required;
            return append_meta(row);
        }
        auto order_module(i64 module_id, i64 order, i64 scope, bool root) -> bool {
            if (!good() || module_id < 0 || module_id >= modules || order < 0 || order >= modules || scope < 0 || scope
                >= modules || (root && scope != 0) || (!root && scope == 0)) {
                fail_storage(StorageStatus::invalid);
                return false;
            }
            MetaRow row = meta(module_id);
            if (row.kind() != MetaTag::module_unit || row.word(12) != -1) {
                fail_storage(StorageStatus::invalid);
                return false;
            }
            i64 at = 0;
            while (at < modules) {
                const MetaRow existing = meta(at);
                if (existing.kind() == MetaTag::module_unit && existing.word(12) >= 0 && (existing.word(12) == order
                    || existing.word(13) == scope)) {
                    fail_storage(StorageStatus::invalid);
                    return false;
                }
                at = at + 1;
            }
            row.set_word(12, order);
            row.set_word(13, scope);
            if (root) {
                row.set_word(14, 1);
            } else {
                row.set_word(14, 0);
            }
            return set_meta(module_id, row);
        }
        auto import_head(i64 module_id) -> i64 {
            return index(3, module_id, 0, 0, 0);
        }
        auto bind_import(i64 module_id, i64 import_node, i64 target) -> bool {
            if (!good() || module_id < 0 || module_id >= modules || target < 0 || target >= modules) {
                fail_storage(StorageStatus::invalid);
                return false;
            }
            const MetaRow from = meta(module_id);
            const MetaRow to = meta(target);
            const SyntaxRow declaration = syntax(import_node);
            if (from.kind() != MetaTag::module_unit || to.kind() != MetaTag::module_unit || declaration.kind()
                != SyntaxTag::declaration || declaration.word(11) != module_id || declaration.declaration_kind()
                != compiler_parser::SyntaxKind::import_name || index(5, module_id, import_node, 0, 0) >= 0) {
                fail_storage(StorageStatus::invalid);
                return false;
            }
            // Ingestion projects the final identifier into the otherwise unused
            // import binding slot, so trailing trivia never widens its name span.
            const i64 reference = name_range(declaration.word(0), declaration.word(6));
            if (reference < 0) {
                return false;
            }
            MetaRow row = MetaRow(MetaTag::import_name);
            row.set_word(0, module_id);
            row.set_word(1, target);
            row.set_word(2, import_node);
            row.set_word(3, reference);
            const i64 result = append_meta(row);
            if (result < 0) {
                return false;
            }
            const i64 tail = index(4, module_id, 0, 0, 0);
            if (tail < 0) {
                if (index_insert(3, module_id, 0, 0, 0, result) < 0 || index_insert(4, module_id, 0, 0, 0, result)
                    < 0) {
                    return false;
                }
            } else {
                MetaRow previous = meta(tail);
                if (previous.kind() != MetaTag::import_name || previous.word(4) != -1) {
                    fail_storage(StorageStatus::invalid);
                    return false;
                }
                previous.set_word(4, result);
                if (!set_meta(tail, previous) || !index_replace(4, module_id, 0, 0, 0, result)) {
                    return false;
                }
            }
            return index_insert(5, module_id, import_node, 0, 0, result) == result;
        }
    };
}

export namespace compiler_resolver {
    auto create(builtin::ByteRegion region) -> Session {
        builtin::OwnedBytes bytes = region.try_allocate(0);
        const SyntaxRow syntax_fill = SyntaxRow(SyntaxTag::invalid);
        builtin::OwnedValues<SyntaxRow> syntax = region.try_allocate(0, syntax_fill);
        const MetaRow meta_fill = MetaRow(MetaTag::invalid);
        builtin::OwnedValues<MetaRow> meta = region.try_allocate(64, meta_fill);
        const ResolvedRow resolved_fill = ResolvedRow();
        builtin::OwnedValues<ResolvedRow> resolved = region.try_allocate(0, resolved_fill);
        const WorkRow work_fill = WorkRow(-1, -1, -1, -1, -1, -1);
        builtin::OwnedValues<WorkRow> work = region.try_allocate(0, work_fill);
        Session session = Session(region, move(bytes), move(syntax), move(meta), move(resolved), move(work));
        if (!session.good()) {
            session.fail_storage(StorageStatus::allocation);
        }
        return move(session);
    }
    auto append_source(Session& session, builtin::span<const u8> source) -> i64 {
        return session.append_source(source);
    }
    auto append_text(Session& session, builtin::span<const u8> text) -> i64 {
        return session.append_text(text);
    }
    auto order_module(Session& session, i64 module_id, i64 order, i64 scope, bool root) -> bool {
        return session.order_module(module_id, order, scope, root);
    }
    auto bind_import(Session& session, i64 module_id, i64 node, i64 target) -> bool {
        return session.bind_import(module_id, node, target);
    }
    auto count(const Session& session, i64 pool) -> i64 {
        if (pool == 0) {
            return session.source_size();
        }
        if (pool == 1) {
            return session.syntax_count();
        }
        if (pool == 2) {
            return session.meta_count();
        }
        if (pool == 3) {
            return session.resolved_count();
        }
        if (pool == 4) {
            return session.work_count();
        }
        if (pool == 5) {
            return session.module_count();
        }
        return -1;
    }
    auto read_source(const Session& session, i64 index) -> i64 {
        return session.view_source(index);
    }
    auto read_syntax(const Session& session, i64 index) -> SyntaxRow {
        const SyntaxRow row = session.view_syntax(index);
        return row;
    }
    auto read_meta(const Session& session, i64 index) -> MetaRow {
        const MetaRow row = session.view_meta(index);
        return row;
    }
    auto read_resolved(const Session& session, i64 index) -> ResolvedRow {
        const ResolvedRow row = session.view_resolved(index);
        return row;
    }
    auto status(const Session& session) -> SessionStatus {
        const SessionStatus result = SessionStatus(session.storage_status(), session.error_code(), session.error_node(),
            session.error_first(), session.error_second());
        return result;
    }
    auto release(builtin::ByteRegion region, Session session) -> i64 {
        return 0;
    }
    auto release_pair(builtin::ByteRegion region, Session session, compiler_parser::AstArena parsed) -> i64 {
        return 0;
    }
}

namespace compiler_resolver {
    auto translate_index(Session& session, i64 base, i64 count, i64 index) -> i64 {
        if (index == -1) {
            return -1;
        }
        if (base < 0 || count < 0 || index < 0 || index >= count || index > 9223372036854775807 - base) {
            return session.fail_storage(StorageStatus::invalid);
        }
        return base + index;
    }
    auto request_source(Session& session, i64 row, i64 slot, i64 ordinal, i64 half) -> bool {
        if (ordinal == -1 && half == 0) {
            return true;
        }
        if (ordinal < 0 || (half != 0 && half != 1)) {
            session.fail_storage(StorageStatus::invalid);
            return false;
        }
        const WorkRow request = WorkRow(ordinal, row, slot, half, -1, -1);
        return session.append_work(request) >= 0;
    }
    auto source_requests(Session& session, i64 begin, i64 end) -> bool {
        if (session.work_count() != 0 || begin < 0 || end < begin || end > session.syntax_count()) {
            session.fail_storage(StorageStatus::invalid);
            return false;
        }
        i64 at = begin;
        while (at < end && session.good()) {
            const SyntaxRow row = session.syntax(at);
            if (row.kind() == SyntaxTag::expression) {
                request_source(session, at, 0, row.word(0), 0);
                request_source(session, at, 4, row.word(4), 0);
                request_source(session, at, 5, row.word(5), 0);
            } else {
                if (row.kind() == SyntaxTag::edge) {
                    request_source(session, at, 4, row.word(4), 0);
                } else {
                    if (row.kind() == SyntaxTag::type) {
                        request_source(session, at, 0, row.word(0), 0);
                        request_source(session, at, 1, row.word(1), 0);
                        if (row.word(2) < 0) {
                            session.fail_storage(StorageStatus::invalid);
                        } else {
                            request_source(session, at, 2, row.word(2) / 2, row.word(2) % 2);
                        }
                        request_source(session, at, 5, row.word(5), 0);
                    } else {
                        if (row.kind() != SyntaxTag::declaration) {
                            session.fail_storage(StorageStatus::invalid);
                        } else {
                            request_source(session, at, 0, row.word(0), 0);
                            request_source(session, at, 1, row.word(1), 0);
                            request_source(session, at, 6, row.word(6), 0);
                            request_source(session, at, 10, row.word(10), 0);
                        }
                    }
                }
            }
            at = at + 1;
        }
        return session.good();
    }
    auto request_less(Session& session, i64 first, i64 second) -> bool {
        const WorkRow left = session.work(first);
        const WorkRow right = session.work(second);
        if (left.word(0) != right.word(0)) {
            return left.word(0) < right.word(0);
        }
        if (left.word(3) != right.word(3)) {
            return left.word(3) < right.word(3);
        }
        if (left.word(1) != right.word(1)) {
            return left.word(1) < right.word(1);
        }
        return left.word(2) < right.word(2);
    }
    auto swap_requests(Session& session, i64 first, i64 second) -> bool {
        const WorkRow left = session.work(first);
        const WorkRow right = session.work(second);
        return session.set_work(first, right) && session.set_work(second, left);
    }
    auto sift_requests(Session& session, i64 initial, i64 end) -> bool {
        i64 root = initial;
        bool finished = false;
        while (!finished && session.good()) {
            if (end <= 1 || root > (end - 2) / 2) {
                finished = true;
            } else {
                const i64 left = root * 2 + 1;
                i64 largest = root;
                if (request_less(session, largest, left)) {
                    largest = left;
                }
                if (left + 1 < end && request_less(session, largest, left + 1)) {
                    largest = left + 1;
                }
                if (largest == root) {
                    finished = true;
                } else {
                    if (!swap_requests(session, root, largest)) {
                        return false;
                    }
                    root = largest;
                }
            }
        }
        return session.good();
    }
    auto sort_requests(Session& session) -> bool {
        const i64 count = session.work_count();
        i64 root = count / 2;
        while (root > 0 && session.good()) {
            root = root - 1;
            sift_requests(session, root, count);
        }
        i64 end = count;
        while (end > 1 && session.good()) {
            end = end - 1;
            if (!swap_requests(session, 0, end) || !sift_requests(session, 0, end)) {
                return false;
            }
        }
        return session.good();
    }
    auto project_sources(Session& session, i64 module_id) -> bool {
        if (!sort_requests(session)) {
            session.truncate_work(0);
            return false;
        }
        const MetaRow source = session.meta(module_id);
        if (source.kind() != MetaTag::module_source) {
            session.fail_storage(StorageStatus::invalid);
            session.truncate_work(0);
            return false;
        }
        i64 request = 0;
        i64 offset = 0;
        i64 line = 1;
        i64 line_start = 0;
        i64 ordinal = 0;
        while (request < session.work_count() && session.good()) {
            const compiler_lexer::Cursor cursor = compiler_lexer::Cursor(offset, line, line_start);
            const compiler_lexer::Lexeme token = session.scan(module_id, cursor);
            if (token.kind() == compiler_lexer::Event::token || token.kind() == compiler_lexer::Event::end_of_input) {
                const WorkRow pending = session.work(request);
                if (pending.word(0) < ordinal || (token.kind() == compiler_lexer::Event::end_of_input && pending.word(0)
                    != ordinal)) {
                    session.fail_storage(StorageStatus::invalid);
                }
                i64 previous_half = -1;
                i64 reference = -1;
                bool complete = false;
                while (!complete && request < session.work_count() && session.good()) {
                    const WorkRow item = session.work(request);
                    if (item.word(0) != ordinal) {
                        complete = true;
                    } else {
                        const i64 half = item.word(3);
                        if (half < 0 || half > 1 || (half == 1 && (token.kind() != compiler_lexer::Event::token
                            || token.next_offset() - offset != 2 || session.source_byte(source.word(0) + offset) != '>'
                            || session.source_byte(source.word(0) + offset + 1) != '>'))) {
                            session.fail_storage(StorageStatus::invalid);
                        } else {
                            if (half != previous_half) {
                                MetaRow row = MetaRow(MetaTag::source_reference);
                                row.set_word(0, module_id);
                                row.set_word(1, source.word(0) + offset + half);
                                row.set_word(2, source.word(0) + token.next_offset());
                                row.set_word(3, line);
                                row.set_word(4, offset - line_start + 1 + half);
                                row.set_word(5, ordinal);
                                row.set_word(6, half);
                                row.set_word(7, token.next_line());
                                row.set_word(8, token.next_offset() - token.next_line_start() + 1);
                                row.set_word(9, 0);
                                reference = session.append_meta(row);
                                if (reference >= 0 && session.index_insert(9, module_id, ordinal, half, 0, reference)
                                    != reference) {
                                    session.fail_storage(StorageStatus::invalid);
                                }
                                previous_half = half;
                            }
                            if (session.good()) {
                                SyntaxRow row = session.syntax(item.word(1));
                                if (row.word(11) != module_id || !row.set_word(item.word(2), reference)
                                    || !session.set_syntax(item.word(1), row)) {
                                    session.fail_storage(StorageStatus::invalid);
                                }
                            }
                            request = request + 1;
                        }
                    }
                }
                if (token.kind() == compiler_lexer::Event::end_of_input) {
                    if (request != session.work_count()) {
                        session.fail_storage(StorageStatus::invalid);
                    }
                } else {
                    ordinal = ordinal + 1;
                }
            } else {
                if (token.kind() != compiler_lexer::Event::whitespace && token.kind()
                    != compiler_lexer::Event::line_comment) {
                    session.fail_storage(StorageStatus::invalid);
                }
            }
            if (session.good() && token.kind() != compiler_lexer::Event::end_of_input && (token.next_offset() <= offset
                || token.next_offset() > source.word(1))) {
                session.fail_storage(StorageStatus::invalid);
            }
            offset = token.next_offset();
            line = token.next_line();
            line_start = token.next_line_start();
        }
        session.truncate_work(0);
        return session.good();
    }
}

export namespace compiler_resolver {
    // Both owning inputs are transferred into distinct generated argument slots.
    // Every return transfers Session and normally drops parsed, including failure.
    auto ingest(builtin::ByteRegion region, Session session, compiler_parser::AstArena parsed, i64 module_id,
        i64 root) -> Session {
        if (!session.good()) {
            return move(session);
        }
        if (module_id < 0 || module_id >= session.module_count() || module_id != session.module_count() - 1
            || !parsed.ok() || parsed.stack_size() != 0 || session.work_count() != 0) {
            session.fail_storage(StorageStatus::invalid);
            return move(session);
        }
        MetaRow module_row = session.meta(module_id);
        const i64 expressions = parsed.size();
        const i64 edges = parsed.arguments();
        const i64 types = parsed.types();
        const i64 declarations = parsed.syntax_size();
        const i64 bytes = module_row.word(1);
        if (module_row.kind() != MetaTag::module_source || module_row.word(10) != -1 || bytes < 0 || bytes > 1048576
            || module_row.word(0) < 0 || module_row.word(0) > session.source_size() || bytes > session.source_size()
            - module_row.word(0) || expressions < 0 || edges < 0 || types < 0 || declarations < 1 || expressions > bytes
            || edges > bytes || types > bytes || declarations > bytes || root < 0 || root >= declarations) {
            session.fail_storage(StorageStatus::invalid);
            return move(session);
        }
        const compiler_parser::SyntaxNode parsed_root = parsed.syntax_at(root);
        if (parsed_root.kind() != compiler_parser::SyntaxKind::module_definition || parsed_root.previous() != -1) {
            session.fail_storage(StorageStatus::invalid);
            return move(session);
        }
        const i64 total = expressions + edges + types + declarations;
        const i64 first = session.syntax_count();
        if (total > 9223372036854775807 - first) {
            session.fail_storage(StorageStatus::invalid);
            return move(session);
        }
        const i64 expression_base = first;
        const i64 edge_base = first + expressions;
        const i64 type_base = edge_base + edges;
        const i64 declaration_base = type_base + types;
        module_row.set_word(2, expression_base);
        module_row.set_word(3, expressions);
        module_row.set_word(4, edge_base);
        module_row.set_word(5, edges);
        module_row.set_word(6, type_base);
        module_row.set_word(7, types);
        module_row.set_word(8, declaration_base);
        module_row.set_word(9, declarations);
        if (!session.set_meta(module_id, module_row)) {
            return move(session);
        }
        i64 at = 0;
        while (at < expressions && session.good()) {
            const compiler_parser::AstNode node = parsed.at(at);
            SyntaxRow row = SyntaxRow(SyntaxTag::expression);
            row.set_expression_kind(node.kind());
            row.set_word(0, node.token());
            row.set_word(3, node.depth());
            row.set_word(4, node.last());
            row.set_word(5, node.close());
            row.set_word(11, module_id);
            if (node.token() < 0 || node.last() < node.token() || node.close() < node.last() || node.depth() < 1
                || node.depth() > 128 || node.kind() == compiler_parser::NodeKind::invalid) {
                session.fail_storage(StorageStatus::invalid);
            } else {
                if (node.kind() == compiler_parser::NodeKind::literal || node.kind()
                    == compiler_parser::NodeKind::name) {
                    if (node.first() != -1 || node.second() != -1) {
                        session.fail_storage(StorageStatus::invalid);
                    }
                } else {
                    if (node.kind() == compiler_parser::NodeKind::unary || node.kind()
                        == compiler_parser::NodeKind::member) {
                        if (node.first() < 0 || node.first() >= at || node.second() != -1) {
                            session.fail_storage(StorageStatus::invalid);
                        }
                        row.set_word(1, translate_index(session, expression_base, expressions, node.first()));
                    } else {
                        if (node.kind() == compiler_parser::NodeKind::binary || node.kind()
                            == compiler_parser::NodeKind::index) {
                            if (node.first() < 0 || node.first() >= at || node.second() < 0 || node.second() >= at) {
                                session.fail_storage(StorageStatus::invalid);
                            }
                            row.set_word(1, translate_index(session, expression_base, expressions, node.first()));
                            row.set_word(2, translate_index(session, expression_base, expressions, node.second()));
                        } else {
                            if (node.kind() != compiler_parser::NodeKind::call && node.kind()
                                != compiler_parser::NodeKind::method_call && node.kind()
                                != compiler_parser::NodeKind::array_literal && node.kind()
                                != compiler_parser::NodeKind::construct && node.kind()
                                != compiler_parser::NodeKind::array_zero) {
                                session.fail_storage(StorageStatus::invalid);
                            }
                            if (node.second() < 0 || node.second() > edges || (node.first() == -1 && node.second() != 0)
                                || (node.first() >= 0 && node.second() == 0)) {
                                session.fail_storage(StorageStatus::invalid);
                            }
                            row.set_word(1, translate_index(session, edge_base, edges, node.first()));
                            row.set_word(2, node.second());
                        }
                    }
                }
            }
            if (session.good() && session.append_syntax(row) != expression_base + at) {
                session.fail_storage(StorageStatus::invalid);
            }
            at = at + 1;
        }
        at = 0;
        while (at < edges && session.good()) {
            const compiler_parser::ChildEdge node = parsed.edge(at);
            SyntaxRow row = SyntaxRow(SyntaxTag::edge);
            if (node.child() < 0 || node.child() >= expressions || node.previous() < -1 || node.previous() >= at
                || node.count() < 1 || node.count() > edges || node.depth() < 1 || node.depth() > 128 || node.field()
                < -1 || (node.previous() == -1 && node.count() != 1)) {
                session.fail_storage(StorageStatus::invalid);
            }
            row.set_word(0, translate_index(session, expression_base, expressions, node.child()));
            row.set_word(1, translate_index(session, edge_base, edges, node.previous()));
            row.set_word(2, node.count());
            row.set_word(3, node.depth());
            row.set_word(4, node.field());
            row.set_word(11, module_id);
            if (session.good() && session.append_syntax(row) != edge_base + at) {
                session.fail_storage(StorageStatus::invalid);
            }
            at = at + 1;
        }
        at = 0;
        while (at < types && session.good()) {
            const compiler_parser::TypeSyntax node = parsed.type_at(at);
            SyntaxRow row = SyntaxRow(SyntaxTag::type);
            if (node.kind() == compiler_parser::TypeKind::invalid || node.token() < 0 || node.last() < node.token()
                || node.last() > 4611686018427387903 || node.close() < node.last() * 2 || node.first() < -1
                || node.first() >= at || node.second() < -1 || node.second() >= at || (node.first() == -1
                && node.second() != -1) || (node.first() >= 0 && node.first() == node.second()) || node.owner() < -1
                || node.role() < 0 || node.role() > 3 || (node.owner() == -1 && node.role() != 0) || (node.owner() >= 0
                && node.role() == 0)) {
                session.fail_storage(StorageStatus::invalid);
            }
            row.set_type_kind(node.kind());
            row.set_word(0, node.token());
            row.set_word(1, node.last());
            row.set_word(2, node.close());
            row.set_word(3, translate_index(session, type_base, types, node.first()));
            row.set_word(4, translate_index(session, type_base, types, node.second()));
            row.set_word(5, node.owner());
            row.set_word(6, node.role());
            row.set_word(11, module_id);
            if (session.good() && session.append_syntax(row) != type_base + at) {
                session.fail_storage(StorageStatus::invalid);
            }
            at = at + 1;
        }
        at = 0;
        while (at < declarations && session.good()) {
            const compiler_parser::SyntaxNode node = parsed.syntax_at(at);
            SyntaxRow row = SyntaxRow(SyntaxTag::declaration);
            if (node.kind() == compiler_parser::SyntaxKind::invalid || node.token() < 0 || node.end() <= node.token()
                || node.previous() < -1 || node.previous() >= at || node.body() < -1 || node.body() >= at
                || node.other() < -1 || node.other() >= at || node.binding() < -1 || node.borrow_site() < -1
                || node.mutable_binding() < 0 || node.mutable_binding() > 1) {
                session.fail_storage(StorageStatus::invalid);
            }
            row.set_declaration_kind(node.kind());
            row.set_word(0, node.token());
            row.set_word(1, node.end());
            row.set_word(2, translate_index(session, declaration_base, declarations, node.previous()));
            row.set_word(3, translate_index(session, expression_base, expressions, node.expression()));
            row.set_word(4, translate_index(session, expression_base, expressions, node.target()));
            row.set_word(5, translate_index(session, type_base, types, node.type()));
            row.set_word(6, node.binding());
            if (node.kind() == compiler_parser::SyntaxKind::import_name) {
                row.set_word(6, node.end() - 1);
            }
            row.set_word(7, translate_index(session, declaration_base, declarations, node.body()));
            row.set_word(8, translate_index(session, declaration_base, declarations, node.other()));
            row.set_word(9, node.mutable_binding());
            row.set_word(10, node.borrow_site());
            row.set_word(11, module_id);
            if (session.good() && session.append_syntax(row) != declaration_base + at) {
                session.fail_storage(StorageStatus::invalid);
            }
            at = at + 1;
        }
        if (!session.good() || session.syntax_count() != first + total || !source_requests(session, first, first
            + total) || !project_sources(session, module_id)) {
            session.truncate_work(0);
            return move(session);
        }
        module_row.set_word(10, declaration_base + root);
        module_row.set_kind(MetaTag::module_unit);
        session.set_meta(module_id, module_row);
        return move(session);
    }
}
