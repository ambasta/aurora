export module aurora.compiler.x86_object_storage;

export namespace compiler_x86 {
    enum class EmitStatus {
        pending,
        running,
        complete,
        allocation,
        limit,
        invalid,
        unsupported
    };
    enum class Register {
        rax,
        rbx,
        rcx,
        rdx,
        rsi,
        rdi,
        r8,
        r9,
        r10,
        r11,
        rbp,
        rsp
    };
    enum class AluOp {
        add,
        bit_or,
        bit_and,
        subtract,
        bit_xor,
        compare,
        test,
        multiply
    };
    enum class UnaryOp {
        negate,
        bit_not,
        divide,
        unsigned_divide,
        unsigned_multiply
    };
    // ELF records retain identities and fixups, never an instruction stream.
    class ObjectSymbolRow {
        i64 kindValue;
        i64 identityValue;
        i64 nameValue;
        i64 nameSizeValue;
        i64 positionValue;
        i64 sizeValue;
        i64 localValue;
        i64 indexValue;
    public:
        ObjectSymbolRow(i64 kind, i64 identity, i64 name, i64 nameSize, i64 position, i64 local) : kindValue(kind),
            identityValue(identity), nameValue(name), nameSizeValue(nameSize), positionValue(position), sizeValue(0),
            localValue(local), indexValue(-1) {
        }
        auto set_size(i64 value) -> bool {
            sizeValue = value;
            return true;
        }
        auto set_index(i64 value) -> bool {
            indexValue = value;
            return true;
        }
        auto kind() const -> i64 {
            return kindValue;
        }
        auto identity() const -> i64 {
            return identityValue;
        }
        auto name() const -> i64 {
            return nameValue;
        }
        auto nameSize() const -> i64 {
            return nameSizeValue;
        }
        auto position() const -> i64 {
            return positionValue;
        }
        auto size() const -> i64 {
            return sizeValue;
        }
        auto local() const -> i64 {
            return localValue;
        }
        auto index() const -> i64 {
            return indexValue;
        }
    };
    auto ObjectSymbolRow_pool(builtin::ByteRegion region) -> builtin::OwnedValues<ObjectSymbolRow> {
        const ObjectSymbolRow fill = ObjectSymbolRow(0, 0, 0, 0, 0, 0);
        builtin::OwnedValues<ObjectSymbolRow> result = region.try_allocate(0, fill);
        return move(result);
    }
    // Direct slots carry semantic label families, not raw source label numbers.
    class ObjectLabelRow {
        i64 epochValue;
        i64 ordinaryValue;
        i64 divisionReady;
        i64 divisionDone;
        i64 copyReady;
        i64 copyDone;
        i64 spanReady;
        i64 spanDone;
    public:
        ObjectLabelRow(i64 epoch) : epochValue(epoch), ordinaryValue(-1), divisionReady(-1), divisionDone(-1),
            copyReady(-1), copyDone(-1), spanReady(-1), spanDone(-1) {
        }
        auto reset(i64 epoch) -> bool {
            epochValue = epoch;
            ordinaryValue = -1;
            divisionReady = -1;
            divisionDone = -1;
            copyReady = -1;
            copyDone = -1;
            spanReady = -1;
            spanDone = -1;
            return true;
        }
        auto epoch() const -> i64 {
            return epochValue;
        }
        auto position(i64 kind) const -> i64 {
            if (kind == 0) {
                return ordinaryValue;
            }
            if (kind == 2) {
                return divisionReady;
            }
            if (kind == 3) {
                return divisionDone;
            }
            if (kind == 5) {
                return copyReady;
            }
            if (kind == 6) {
                return copyDone;
            }
            if (kind == 7) {
                return spanReady;
            }
            if (kind == 8) {
                return spanDone;
            }
            return -1;
        }
        auto bind(i64 kind, i64 position) -> bool {
            if (kind == 0) {
                ordinaryValue = position;
            } else {
                if (kind == 2) {
                    divisionReady = position;
                } else {
                    if (kind == 3) {
                        divisionDone = position;
                    } else {
                        if (kind == 5) {
                            copyReady = position;
                        } else {
                            if (kind == 6) {
                                copyDone = position;
                            } else {
                                if (kind == 7) {
                                    spanReady = position;
                                } else {
                                    if (kind == 8) {
                                        spanDone = position;
                                    } else {
                                        return false;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            return true;
        }
    };
    auto ObjectLabelRow_pool(builtin::ByteRegion region) -> builtin::OwnedValues<ObjectLabelRow> {
        const ObjectLabelRow fill = ObjectLabelRow(-1);
        builtin::OwnedValues<ObjectLabelRow> result = region.try_allocate(0, fill);
        return move(result);
    }
    class ObjectIndexRow {
        i64 value;
    public:
        ObjectIndexRow(i64 index) : value(index) {
        }
        auto index() const -> i64 {
            return value;
        }
    };
    auto ObjectIndexRow_pool(builtin::ByteRegion region) -> builtin::OwnedValues<ObjectIndexRow> {
        const ObjectIndexRow fill = ObjectIndexRow(-1);
        builtin::OwnedValues<ObjectIndexRow> result = region.try_allocate(0, fill);
        return move(result);
    }
    class ObjectFixupRow {
        i64 kindValue;
        i64 scopeValue;
        i64 identityValue;
        i64 positionValue;
        i64 targetKindValue;
    public:
        ObjectFixupRow(i64 kind, i64 scope, i64 identity, i64 position, i64 targetKind) : kindValue(kind),
            scopeValue(scope), identityValue(identity), positionValue(position), targetKindValue(targetKind) {
        }
        auto kind() const -> i64 {
            return kindValue;
        }
        auto scope() const -> i64 {
            return scopeValue;
        }
        auto identity() const -> i64 {
            return identityValue;
        }
        auto position() const -> i64 {
            return positionValue;
        }
        auto targetKind() const -> i64 {
            return targetKindValue;
        }
    };
    auto ObjectFixupRow_pool(builtin::ByteRegion region) -> builtin::OwnedValues<ObjectFixupRow> {
        const ObjectFixupRow fill = ObjectFixupRow(0, 0, 0, 0, 0);
        builtin::OwnedValues<ObjectFixupRow> result = region.try_allocate(0, fill);
        return move(result);
    }
    class EmitChunk {
        builtin::array<u8, 512> payload;
        i64 byteCount;
    public:
        EmitChunk() : payload{}, byteCount(0) {
        }
        auto size() const -> i64 {
            return byteCount;
        }
        auto at(i64 index) const -> u8 {
            return payload[index];
        }
        auto append(u8 value) -> bool {
            if (byteCount >= 512) {
                return false;
            }
            payload[byteCount] = value;
            byteCount = byteCount + 1;
            return true;
        }
        auto invalidate() -> bool {
            byteCount = -1;
            return false;
        }
    };
    // Checked geometric growth. Limits come from byte extents, not a row quota.
    auto grow_capacity(i64 current, i64 required, i64 maximum, i64 minimum) -> i64 {
        if (current < 0 || required < 0 || maximum < 0 || minimum < 0 || current > maximum || required > maximum) {
            return -1;
        }
        if (required <= current) {
            return current;
        }
        i64 capacity = minimum;
        if (current > 0) {
            capacity = maximum;
            if (current <= maximum / 2) {
                capacity = current * 2;
            }
        }
        if (capacity > maximum) {
            capacity = maximum;
        }
        if (capacity < required) {
            capacity = required;
        }
        return capacity;
    }
    class ObjectWorkspace {
        builtin::OwnedBytes output;
        builtin::OwnedBytes objectNames;
        builtin::OwnedBytes objectCode;
        builtin::OwnedValues<ObjectSymbolRow> objectSymbols;
        builtin::OwnedValues<ObjectLabelRow> objectLabels;
        builtin::OwnedValues<ObjectFixupRow> objectFixups;
        builtin::OwnedValues<ObjectIndexRow> callableSymbols;
        // Runtime identities occupy [0, 64); kind-4 identities follow: scope * 2 +
        // query for the 256 module scopes, then _start at 512.
        builtin::OwnedValues<ObjectIndexRow> generatedSymbols;
        builtin::OwnedValues<ObjectIndexRow> literalSymbols;
        builtin::OwnedValues<ObjectIndexRow> trapPositions;
        builtin::OwnedBytes literalBytes;
        i64 literalSize;
        i64 literalCurrentSymbol;
        i64 returnPosition;
        i64 functionFixupStart;
        EmitStatus outcome;
        bool objectMode;
        bool hiddenDefinitions;
        bool objectNameCapture;
        i64 outputSize;
        i64 artifactLimit;
        i64 objectNameSize;
        i64 objectSymbolSize;
        i64 objectLabelSize;
        i64 objectLabelLimit;
        i64 objectFixupSize;
        i64 objectCurrentSymbol;
        i64 objectCaptureSymbol;
        i64 functionIndex;
    public:
        ObjectWorkspace(builtin::ByteRegion region) : output(region.try_allocate(0)),
            objectNames(region.try_allocate(0)), objectCode(region.try_allocate(0)),
            objectSymbols(ObjectSymbolRow_pool(region)), objectLabels(ObjectLabelRow_pool(region)),
            objectFixups(ObjectFixupRow_pool(region)), callableSymbols(ObjectIndexRow_pool(region)),
            generatedSymbols(ObjectIndexRow_pool(region)), literalSymbols(ObjectIndexRow_pool(region)),
            trapPositions(ObjectIndexRow_pool(region)), literalBytes(region.try_allocate(0)), literalSize(0),
            literalCurrentSymbol(-1), returnPosition(-1), functionFixupStart(0), outcome(EmitStatus::pending),
            objectMode(false), hiddenDefinitions(false), objectNameCapture(false), outputSize(0),
            artifactLimit(67108864), objectNameSize(0), objectSymbolSize(0), objectLabelSize(0), objectLabelLimit(0),
            objectFixupSize(0), objectCurrentSymbol(-1), objectCaptureSymbol(-1), functionIndex(0) {
        }
        auto allocated() const -> bool {
            return output.ok() && objectNames.ok() && objectCode.ok() && objectSymbols.ok() && objectLabels.ok()
                && objectFixups.ok() && callableSymbols.ok() && generatedSymbols.ok() && literalSymbols.ok()
                && trapPositions.ok() && literalBytes.ok();
        }
        auto enable_object() -> bool {
            if (outcome != EmitStatus::pending || outputSize != 0 || !allocated()) {
                return fail();
            }
            objectMode = true;
            outcome = EmitStatus::running;
            return object_name_byte(u8(0));
        }
        // Only the closed frontend wrapper recipe enables hidden definitions.
        // Ordinary source emission retains its existing visibility and layout.
        auto enable_wrapper() -> bool {
            if (!enable_object()) {
                return false;
            }
            hiddenDefinitions = true;
            return true;
        }
        auto configure_labels(i64 instructions, i64 functions, i64 descriptors) -> bool {
            if (descriptors < 0 || descriptors > 67108864 || instructions < 0 || instructions > 67108864 || functions
                < 0 || functions > 67108864 || objectSymbolSize != 0 || objectLabelLimit != 0) {
                return fail();
            }
            const ObjectIndexRow missing = ObjectIndexRow(-1);
            if (!callableSymbols.try_resize(functions, missing) || !generatedSymbols.try_resize(577, missing)
                || !literalSymbols.try_resize(instructions + 1, missing) || !trapPositions.try_resize(4, missing)) {
                return allocation_failure();
            }
            objectLabelLimit = instructions;
            if (descriptors > objectLabelLimit) {
                objectLabelLimit = descriptors;
            }
            return ok();
        }
        auto begin_function_labels(i64 instructions) -> bool {
            if (instructions < 0 || instructions > objectLabelLimit || instructions > 67108864 / 4) {
                return fail();
            }
            objectLabelSize = instructions;
            returnPosition = -1;
            functionFixupStart = objectFixupSize;
            return ok();
        }
        auto maximum_name_width() const -> i64 {
            i64 width = 0;
            i64 at = 0;
            while (at < objectSymbolSize) {
                const ObjectSymbolRow row = objectSymbols.at(at);
                if (row.nameSize() > width) {
                    width = row.nameSize();
                }
                at = at + 1;
            }
            return width;
        }
        auto object_mode() const -> bool {
            return objectMode;
        }
        auto object_name_byte(u8 value) -> bool {
            if (!ok() || objectNameSize >= 67108864 || (objectNameCapture && (value < u8(33) || value > u8(126)))) {
                return fail();
            }
            if (objectNameSize == objectNames.size()) {
                const i64 capacity = grow_capacity(objectNames.size(), objectNameSize + 1, 67108864, 256);
                if (capacity < 0) {
                    return limit_failure();
                }
                if (!objectNames.try_resize(capacity)) {
                    return allocation_failure();
                }
            }
            if (!objectNames.set(objectNameSize, value)) {
                return fail();
            }
            objectNameSize = objectNameSize + 1;
            return true;
        }
        auto object_name_text(builtin::span<const u8> text) -> bool {
            if (!objectNameCapture) {
                return fail();
            }
            i64 at = 0;
            while (at < text.size() && ok()) {
                object_name_byte(text.at(at));
                at = at + 1;
            }
            return ok();
        }
        auto object_symbol_index(i64 kind, i64 identity) const -> i64 {
            if (identity < 0) {
                return -1;
            }
            if (kind == 0 && identity < callableSymbols.size()) {
                const ObjectIndexRow row = callableSymbols.at(identity);
                return row.index();
            }
            if (kind == 1 && identity < 64) {
                const ObjectIndexRow row = generatedSymbols.at(identity);
                return row.index();
            }
            if (kind == 4 && identity < 513) {
                const ObjectIndexRow row = generatedSymbols.at(64 + identity);
                return row.index();
            }
            if (kind == 3 && identity > 0 && identity < literalSymbols.size()) {
                const ObjectIndexRow row = literalSymbols.at(identity);
                return row.index();
            }
            return -1;
        }
        auto has_object_symbol(i64 callable) const -> bool {
            return object_symbol_index(0, callable) >= 0;
        }
        auto append_object_symbol(ObjectSymbolRow row) -> bool {
            // Every symbol requires a 24-byte ELF symbol-table entry.
            if (objectSymbolSize >= 67108864 / 24 - 1) {
                return limit_failure();
            }
            if (objectSymbolSize == objectSymbols.size()) {
                const i64 capacity = grow_capacity(objectSymbols.size(), objectSymbolSize + 1, 67108864 / 24, 16);
                const ObjectSymbolRow fill = ObjectSymbolRow(0, 0, 0, 0, 0, 0);
                if (capacity < 0) {
                    return limit_failure();
                }
                if (!objectSymbols.try_resize(capacity, fill)) {
                    return allocation_failure();
                }
            }
            if (!objectSymbols.set(objectSymbolSize, row)) {
                return fail();
            }
            const ObjectIndexRow index = ObjectIndexRow(objectSymbolSize);
            bool stored = false;
            if (row.kind() == 0 && row.identity() >= 0 && row.identity() < callableSymbols.size()) {
                stored = callableSymbols.set(row.identity(), index);
            }
            if (row.kind() == 1 && row.identity() >= 0 && row.identity() < 64) {
                stored = generatedSymbols.set(row.identity(), index);
            }
            if (row.kind() == 4 && row.identity() >= 0 && row.identity() < 513) {
                stored = generatedSymbols.set(64 + row.identity(), index);
            }
            if (row.kind() == 3 && row.identity() > 0 && row.identity() < literalSymbols.size()) {
                stored = literalSymbols.set(row.identity(), index);
            }
            if (row.kind() == 2) {
                stored = true;
            }
            if (!stored) {
                return fail();
            }
            objectSymbolSize = objectSymbolSize + 1;
            return true;
        }
        // Kind 1 defines a runtime symbol in this object, such as a hosted
        // program's byte runtime entry; its calls then bind locally.
        auto begin_object_symbol(i64 kind, i64 identity, bool local) -> bool {
            if (!objectMode || objectNameCapture || identity < 0 || (kind != 0 && kind != 1 && kind != 4)) {
                return fail();
            }
            i64 binding = 0;
            if (local) {
                binding = 1;
            }
            const ObjectSymbolRow row = ObjectSymbolRow(kind, identity, objectNameSize, 0, outputSize, binding);
            i64 index = object_symbol_index(kind, identity);
            if (index >= 0) {
                const ObjectSymbolRow old = objectSymbols.at(index);
                if (old.position() >= 0 || !objectSymbols.set(index, row)) {
                    return fail();
                }
            } else {
                index = objectSymbolSize;
                if (!append_object_symbol(row)) {
                    return false;
                }
            }
            objectCurrentSymbol = index;
            objectCaptureSymbol = index;
            objectNameCapture = true;
            return true;
        }
        auto begin_object_external(i64 kind, i64 identity) -> bool {
            if (!objectMode || objectNameCapture || identity < 0 || (kind != 0 && kind != 4)
                || object_symbol_index(kind, identity) >= 0) {
                return fail();
            }
            const ObjectSymbolRow row = ObjectSymbolRow(kind, identity, objectNameSize, 0, -1, 0);
            objectCaptureSymbol = objectSymbolSize;
            if (!append_object_symbol(row)) {
                return false;
            }
            objectNameCapture = true;
            return true;
        }
        auto end_object_symbol_name() -> bool {
            if (!objectNameCapture || objectCaptureSymbol < 0) {
                return fail();
            }
            objectNameCapture = false;
            const ObjectSymbolRow old = objectSymbols.at(objectCaptureSymbol);
            const i64 count = objectNameSize - old.name();
            if (count <= 0) {
                return fail();
            }
            ObjectSymbolRow row = ObjectSymbolRow(old.kind(), old.identity(), old.name(), count, old.position(),
                old.local());
            row.set_size(old.size());
            row.set_index(old.index());
            if (!objectSymbols.set(objectCaptureSymbol, row)) {
                return fail();
            }
            return object_name_byte(u8(0));
        }
        auto end_object_symbol() -> bool {
            if (!objectMode || objectNameCapture || objectCurrentSymbol < 0) {
                return fail();
            }
            const ObjectSymbolRow old = objectSymbols.at(objectCurrentSymbol);
            if (old.position() < 0 || old.position() > outputSize) {
                return fail();
            }
            ObjectSymbolRow row = ObjectSymbolRow(old.kind(), old.identity(), old.name(), old.nameSize(),
                old.position(), old.local());
            row.set_size(outputSize - old.position());
            row.set_index(old.index());
            // Function-local branches cannot outlive this epoch. Compact only
            // this function's tail; module traps and symbol relocations survive.
            i64 scan = functionFixupStart;
            i64 retained = functionFixupStart;
            while (scan < objectFixupSize && ok()) {
                const ObjectFixupRow fix = objectFixups.at(scan);
                if (fix.targetKind() < 0 && fix.kind() != 4) {
                    if (!patch_relative(fix.position(), object_label_position(fix.kind(), fix.scope(),
                        fix.identity()))) {
                        return false;
                    }
                } else {
                    if (!objectFixups.set(retained, fix)) {
                        return fail();
                    }
                    retained = retained + 1;
                }
                scan = scan + 1;
            }
            objectFixupSize = retained;
            functionIndex = functionIndex + 1;
            if (!objectSymbols.set(objectCurrentSymbol, row)) {
                return fail();
            }
            return true;
        }
        auto has_runtime_symbol(i64 identity) const -> bool {
            return object_symbol_index(1, identity) >= 0;
        }
        auto begin_runtime_symbol(i64 identity) -> bool {
            if (!objectMode || objectNameCapture || identity < 0 || has_runtime_symbol(identity)) {
                return fail();
            }
            const ObjectSymbolRow row = ObjectSymbolRow(1, identity, objectNameSize, 0, -1, 0);
            objectCaptureSymbol = objectSymbolSize;
            if (!append_object_symbol(row)) {
                return false;
            }
            objectNameCapture = true;
            return true;
        }
        auto object_call_runtime(i64 identity) -> bool {
            if (!objectMode || !has_runtime_symbol(identity)) {
                return fail();
            }
            byte(u8(232));
            return object_fixup(0, -1, identity, 1);
        }
        auto object_call_query(i64 identity) -> bool {
            if (!objectMode || object_symbol_index(4, identity) < 0) {
                return fail();
            }
            byte(u8(232));
            return object_fixup(0, -1, identity, 4);
        }
        auto trap_symbol(i64 identity, builtin::span<const u8> name) -> bool {
            const i64 first = objectNameSize;
            i64 at = 0;
            while (at < name.size() && ok()) {
                object_name_byte(name.at(at));
                at = at + 1;
            }
            object_name_byte(u8(0));
            const ObjectSymbolRow row = ObjectSymbolRow(2, identity, first, name.size(), outputSize, 1);
            return append_object_symbol(row);
        }
        auto object_fixup(i64 kind, i64 scope, i64 identity, i64 target_kind) -> bool {
            // Each fixup consumes at least four code bytes.
            if (objectFixupSize >= 67108864 / 4) {
                return limit_failure();
            }
            if (objectFixupSize == objectFixups.size()) {
                const i64 capacity = grow_capacity(objectFixups.size(), objectFixupSize + 1, 67108864 / 4, 32);
                const ObjectFixupRow fill = ObjectFixupRow(0, 0, 0, 0, 0);
                if (capacity < 0) {
                    return limit_failure();
                }
                if (!objectFixups.try_resize(capacity, fill)) {
                    return allocation_failure();
                }
            }
            const ObjectFixupRow row = ObjectFixupRow(kind, scope, identity, outputSize, target_kind);
            if (!objectFixups.set(objectFixupSize, row)) {
                return fail();
            }
            objectFixupSize = objectFixupSize + 1;
            return emit_little(0u64, 4);
        }
        auto object_label_scope(i64 kind) const -> i64 {
            if (kind == 4) {
                return -1;
            }
            return functionIndex;
        }
        auto object_label_position(i64 kind, i64 scope, i64 identity) const -> i64 {
            if (kind == 4) {
                if (scope != -1 || identity < 0 || identity >= 4) {
                    return -1;
                }
                const ObjectIndexRow row = trapPositions.at(identity);
                return row.index();
            }
            if (scope != functionIndex || identity < 0) {
                return -1;
            }
            if (kind == 1) {
                if (identity == 0) {
                    return returnPosition;
                }
                return -1;
            }
            // A four-root call emits at most four generated label pairs.
            // Ordinary identities instead denote normalized body positions.
            i64 bound = objectLabelSize * 4;
            if (kind == 0) {
                bound = objectLabelSize;
            }
            if (identity >= bound || identity >= objectLabels.size()) {
                return -1;
            }
            const ObjectLabelRow row = objectLabels.at(identity);
            if (row.epoch() != functionIndex) {
                return -1;
            }
            return row.position(kind);
        }
        auto bind_label(i64 kind, i64 identity) -> bool {
            if (kind < 0 || kind > 8 || identity < 0 || object_label_position(kind, object_label_scope(kind), identity)
                >= 0) {
                return fail();
            }
            if (kind == 4) {
                const ObjectIndexRow position = ObjectIndexRow(outputSize);
                if (identity >= 4 || !trapPositions.set(identity, position)) {
                    return fail();
                }
                if (identity == 0) {
                    return trap_symbol(identity, ".Laurora_bounds_trap");
                }
                if (identity == 1) {
                    return trap_symbol(identity, ".Laurora_overflow_trap");
                }
                if (identity == 2) {
                    return trap_symbol(identity, ".Laurora_division_zero_trap");
                }
                return trap_symbol(identity, ".Laurora_shift_count_trap");
            }
            if (kind == 1) {
                if (identity != 0) {
                    return fail();
                }
                returnPosition = outputSize;
                return true;
            }
            i64 bound = objectLabelSize * 4;
            if (kind == 0) {
                bound = objectLabelSize;
            }
            if (identity >= bound) {
                return fail();
            }
            if (identity >= objectLabels.size()) {
                const i64 capacity = grow_capacity(objectLabels.size(), identity + 1, objectLabelLimit * 4, 32);
                if (capacity < 0) {
                    return limit_failure();
                }
                const ObjectLabelRow missing = ObjectLabelRow(-1);
                if (!objectLabels.try_resize(capacity, missing)) {
                    return allocation_failure();
                }
            }
            ObjectLabelRow row = objectLabels.at(identity);
            // Reusing an ordinal resets every family lazily, not a module table.
            if (row.epoch() != functionIndex) {
                row.reset(functionIndex);
            }
            if (!row.bind(kind, outputSize) || !objectLabels.set(identity, row)) {
                return fail();
            }
            return true;
        }
        auto branch(i64 condition, i64 kind, i64 identity) -> bool {
            if (condition < -1 || condition > 15 || kind < 0 || kind > 8 || identity < 0) {
                return fail();
            }

            if (condition == -1) {
                byte(u8(233));
            } else {
                byte(u8(15));
                byte(u8(128 + condition));
            }
            return object_fixup(kind, object_label_scope(kind), identity, -1);
        }
        auto object_call_symbol(i64 callable) -> bool {
            if (!objectMode || callable < 0) {
                return fail();
            }
            byte(u8(232));
            return object_fixup(0, -1, callable, 0);
        }
        auto object_tail_jump(i64 callable) -> bool {
            if (!hiddenDefinitions || !objectMode || callable < 0 || object_symbol_index(0, callable) < 0) {
                return fail();
            }
            const ObjectSymbolRow target = objectSymbols.at(object_symbol_index(0, callable));
            if (target.position() >= 0) {
                return fail();
            }
            byte(u8(233));
            return object_fixup(0, -1, callable, 0);
