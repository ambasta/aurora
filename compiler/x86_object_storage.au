            if (!objectCode.try_resize(code_size)) {
                return allocation_failure();
            }
            at = 0;
            while (at < code_size) {
                if (!objectCode.set(at, output.at(at))) {
                    return fail();
                }
                at = at + 1;
            }
            const i64 text_offset = 64;
            const i64 literal_offset = text_offset + code_size;
            const i64 relocation_offset = (literal_offset + literalSize + 7) / 8 * 8;
            const i64 symbol_offset = relocation_offset + relocation_count * 24;
            const i64 string_offset = symbol_offset + (objectSymbolSize + 1) * 24;
            const i64 section_string_offset = string_offset + objectNameSize;
            // Fixed section-name table below occupies 68 bytes.
            const i64 section_offset = (section_string_offset + 68 + 7) / 8 * 8;
            const i64 complete_size = section_offset + 8 * 64;
            if (complete_size > artifactLimit || complete_size < section_offset) {
                return limit_failure();
            }
            outputSize = 0;
            byte(u8(127));
            byte('E');
            byte('L');
            byte('F');
            byte(u8(2));
            byte(u8(1));
            byte(u8(1));
            object_zeroes(9);
            emit_little(1u64, 2);
            emit_little(62u64, 2);
            emit_little(1u64, 4);
            emit_little(0u64, 8);
            emit_little(0u64, 8);
            emit_little(u64(section_offset), 8);
            emit_little(0u64, 4);
            emit_little(64u64, 2);
            emit_little(0u64, 2);
            emit_little(0u64, 2);
            emit_little(64u64, 2);
            emit_little(8u64, 2);
            emit_little(5u64, 2);
            at = 0;
            while (at < code_size && ok()) {
                byte(objectCode.at(at));
                at = at + 1;
            }
            at = 0;
            while (at < literalSize && ok()) {
                byte(literalBytes.at(at));
                at = at + 1;
            }
            object_align(8);
            if (outputSize != relocation_offset) {
                return fail();
            }
            at = 0;
            while (at < objectFixupSize && ok()) {
                const ObjectFixupRow fix = objectFixups.at(at);
                if (fix.targetKind() >= 0) {
                    const i64 symbol = object_symbol_index(fix.targetKind(), fix.identity());
                    if (symbol < 0) {
                        return fail();
                    }
                    const ObjectSymbolRow row = objectSymbols.at(symbol);
                    emit_little(u64(fix.position()), 8);
                    // PLT32 calls and PC32 literal addresses use S + A - P.
                    // Displacement ends at the next instruction, hence A = -4.
                    u64 relocation = 4u64;
                    if (fix.targetKind() == 3) {
                        relocation = 2u64;
                    }
                    emit_little(u64(row.index()) * 4294967296u64 + relocation, 8);
                    emit_little(18446744073709551612u64, 8);
                }
                at = at + 1;
            }
            if (outputSize != symbol_offset) {
                return fail();
            }
            object_zeroes(24);
            i64 binding = 1;
            while (binding >= 0 && ok()) {
                at = 0;
                while (at < objectSymbolSize && ok()) {
                    const ObjectSymbolRow row = objectSymbols.at(at);
                    if (row.local() == binding) {
                        emit_little(u64(row.name()), 4);
                        i64 info = 0;
                        if (row.local() == 0) {
                            info = 16;
                        }
                        i64 section = 0;
                        i64 value = 0;
                        if (row.position() >= 0) {
                            if (row.kind() == 0 || row.kind() == 1 || row.kind() == 4) {
                                info = info + 2;
                            }
                            section = 1;
                            if (row.kind() == 3) {
                                section = 7;
                            }
                            value = row.position();
                        }
                        byte(u8(info));
                        i64 visibility = 0;
                        if (hiddenDefinitions && row.position() >= 0 && row.local() == 0) {
                            visibility = 2;
                        }
                        byte(u8(visibility));
                        emit_little(u64(section), 2);
                        emit_little(u64(value), 8);
                        emit_little(u64(row.size()), 8);
                    }
                    at = at + 1;
                }
                binding = binding - 1;
            }
            if (outputSize != string_offset) {
                return fail();
            }
            at = 0;
            while (at < objectNameSize && ok()) {
                byte(objectNames.at(at));
                at = at + 1;
            }
            if (outputSize != section_string_offset) {
                return fail();
            }
            object_literal_bytes("\0.text\0.rela.text\0.symtab\0.strtab\0.shstrtab\0.note.GNU-stack\0.rodata\0");
            object_align(8);
            if (outputSize != section_offset) {
                return fail();
            }
            object_zeroes(64);
            object_section(1, 1, text_offset, code_size, 0, 0);
            object_section(7, 4, relocation_offset, relocation_count * 24, 3, 1);
            object_section(18, 2, symbol_offset, (objectSymbolSize + 1) * 24, 4, local_count + 1);
            object_section(26, 3, string_offset, objectNameSize, 0, 0);
            object_section(34, 3, section_string_offset, 68, 0, 0);
            object_section(44, 1, section_string_offset + 68, 0, 0, 0);
            object_section(60, 1, literal_offset, literalSize, 0, 0);
            return ok() && outputSize == complete_size;
        }
        auto status() const -> EmitStatus {
            return outcome;
        }
        auto ok() const -> bool {
            return outcome == EmitStatus::pending || outcome == EmitStatus::running || outcome == EmitStatus::complete;
        }
        auto fail() -> bool {
            if (ok()) {
                outcome = EmitStatus::invalid;
            }
            return false;
        }
        auto allocation_failure() -> bool {
            if (ok()) {
                outcome = EmitStatus::allocation;
            }
            return false;
        }
        auto limit_failure() -> bool {
            if (ok()) {
                outcome = EmitStatus::limit;
            }
            return false;
        }
        auto reserve_output(i64 count) -> bool {
            if (!ok()) {
                return false;
            }
            if (count < 0) {
                return fail();
            }
            if (count > artifactLimit - outputSize || count > 9223372036854775807 - outputSize) {
                return limit_failure();
            }
            const i64 required = outputSize + count;
            if (required <= output.size()) {
                return true;
            }
            const i64 capacity = grow_capacity(output.size(), required, 9223372036854775807, 4096);
            if (capacity < 0) {
                return limit_failure();
            }
            if (!output.try_resize(capacity)) {
                return allocation_failure();
            }
            return true;
        }
        auto byte(u8 value) -> bool {
            if (objectNameCapture) {
                return object_name_byte(value);
            }
            if (!reserve_output(1) || !output.set(outputSize, value)) {
                return fail();
            }
            outputSize = outputSize + 1;
            return true;
        }
        auto unsupported_object() -> bool {
            if (ok()) {
                outcome = EmitStatus::unsupported;
            }
            return false;
        }
        auto size() const -> i64 {
            if (outcome != EmitStatus::complete) {
                return -1;
            }
            return outputSize;
        }
        // The sealed object; empty until it is complete.
        auto bytes() const -> builtin::span<const u8> {
            const builtin::span<const u8> all = borrow_bytes(output);
            i64 count = 0;
            if (outcome == EmitStatus::complete) {
                count = outputSize;
            }
            const builtin::span<const u8> result = all.subspan(0, count);
            return result;
        }
        auto chunk(i64 offset) const -> EmitChunk {
            EmitChunk result = EmitChunk();
            if (outcome != EmitStatus::complete || offset < 0 || offset > outputSize) {
                result.invalidate();
                return result;
            }
            i64 count = outputSize - offset;
            if (count > 512) {
                count = 512;
            }
            i64 at = 0;
            while (at < count) {
                result.append(output.at(offset + at));
                at = at + 1;
            }
            return result;
        }
        auto seal() -> bool {
            if (outcome != EmitStatus::running || !finish_object()) {
                return fail();
            }
            outcome = EmitStatus::complete;
            return true;
        }
    };
    auto object_create(builtin::ByteRegion region) -> ObjectWorkspace {
        ObjectWorkspace result = ObjectWorkspace(region);
        return move(result);
    }
    auto object_release(builtin::ByteRegion region, ObjectWorkspace workspace) -> i64 {
        return 0;
    }
}
