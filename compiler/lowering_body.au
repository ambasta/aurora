    auto argument_offsets(compiler_resolver::Session& session, ContinuationRow frame, OperandRole role, i64 first,
        bool present) -> OperandRow {
        const i64 begin = session.operand_count();
        i64 index = first;
        if (present) {
            while (index < frame.argument_count() && session.good()) {
                const ArgumentLane lane = frame.argument(index);
                i64 offset = 0;
                if ((role == OperandRole::SpanArguments && lane.kind() == ArgumentKind::span) || (role
                    == OperandRole::ObjectArguments && lane.kind() == ArgumentKind::object) || (role
                    == OperandRole::OwnerArguments && (lane.kind() == ArgumentKind::object || (lane.kind()
                    == ArgumentKind::owner && index > 0)))) {
                    offset = local_offset(session, lane.local_id());
                }
                put(session, OperandRole::Offset, offset);
                index = index + 1;
            }
        }
        const OperandRow result = slice(role, begin, session.operand_count() - begin);
        return result;
