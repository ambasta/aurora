    auto step_expression(compiler_resolver::Session& session, i64 frame_id) -> bool {
        ContinuationRow frame = session.continuation(frame_id);
        if (frame.phase() == ContinuationPhase::start) {
            return begin_expression(session, frame_id);
        }
        const i64 node = frame.syntax_node();
        const compiler_resolver::SyntaxRow syntax = session.syntax(node);
        const i64 source = source_ref(session, node);
        if (frame.output_mark() >= 0 && value_kind(session, frame.output_mark())
            == compiler_resolver::ResolvedTypeKind::array_value) {
            return step_array(session, frame_id);
        }
        if (syntax.expression_kind() == compiler_parser::NodeKind::construct) {
            return step_designated(session, frame_id);
        }
        if (syntax.expression_kind() == compiler_parser::NodeKind::index) {
            return finish_index(session, frame_id);
        }
        if (syntax.expression_kind() == compiler_parser::NodeKind::unary) {
            unary_instruction(session, node, frame.child_type_id());
            return finish_expression(session, frame.child_type_id(), -1);
        }
        if (syntax.expression_kind() == compiler_parser::NodeKind::binary) {
            const i64 boolean = scalar_id(session, compiler_resolver::ResolvedTypeKind::bool_value);
            const bool logical = session.source_equal(source, "&&") || session.source_equal(source, "||");
            if (frame.phase() == ContinuationPhase::child) {
                if (logical) {
                    match_type(session, frame.child_type_id(), boolean, source);
                    const i64 prefix = session.local_count();
                    const i64 base = session.capture_locals(prefix);
                    frame.set_scope(frame.scope_head(), prefix);
                    frame.set_snapshots(base, -1);
                    const i64 done = body_fresh_label(session);
                    i64 right = -1;
                    if (session.source_equal(source, "&&")) {
                        emit_BranchFalse(session, done);
                    } else {
                        right = body_fresh_label(session);
                        emit_BranchFalse(session, right);
                        emit_Jump(session, done);
                        emit_Label(session, right);
                    }
                    frame.set_labels(done, right);
                } else {
                    frame.set_cleanup_cursor(frame.child_type_id());
                    emit_Push(session);
                }
                frame.set_phase(ContinuationPhase::logical_right);
                session.set_continuation(frame_id, frame);
                return push_expression(session, syntax.word(2), -1, -1);
            }
            if (logical) {
                match_type(session, frame.child_type_id(), boolean, source);
                join_prefix(session, frame.incoming_snapshot_base(), frame.local_prefix_length(), source, true);
                session.truncate_snapshots(frame.incoming_snapshot_base());
                emit_Label(session, frame.first_label());
                return finish_expression(session, boolean, -1);
            }
            const i64 result = binary_instruction(session, node, frame.cleanup_cursor(), frame.child_type_id());
            return finish_expression(session, result, -1);
        }
        if (syntax.expression_kind() == compiler_parser::NodeKind::method_call && session.source_equal(source,
            "subspan") && frame.output_mark() >= 0 && value_kind(session, frame.output_mark())
            == compiler_resolver::ResolvedTypeKind::byte_span) {
            return step_subspan(session, frame_id);
        }
        if (frame.phase() == ContinuationPhase::argument) {
            return collect_call_argument(session, frame_id);
        }
        return finish_scalar_builtin(session, frame_id);
    }
    auto current_statement(compiler_resolver::Session& session, i64 frame_id) -> i64 {
        const ContinuationRow frame = session.continuation(frame_id);
        return frame.cursor();
    }
    auto local_declared_type(compiler_resolver::Session& session, i64 declaration) -> i64 {
        const i64 staged_row_134 = compiler_resolver::sw(session, declaration, 5);
        return compiler_resolver::rw(session, staged_row_134, 2);
    }
    auto lint_binding(compiler_resolver::Session& session, i64 declaration, i64 type) -> bool {
        const ContinuationRow root = session.continuation(0);
        if (root.operand_mark() != 1 || !compiler_resolver::scalar_value_kind(value_kind(session, type))) {
            return false;
        }
        const i64 name = compiler_resolver::sw(session, declaration, 6);
        const compiler_resolver::MetaRow source = session.meta(name);
        return source.word(0) >= 0 && session.source_byte(source.word(1)) != '_';
    }
    auto finish_local_scalar(compiler_resolver::Session& session, i64 frame_id, i64 owner) -> bool {
        const ContinuationRow frame = session.continuation(frame_id);
        const i64 declaration = frame.cursor();
        const i64 type = local_declared_type(session, declaration);
        const i64 name = compiler_resolver::sw(session, declaration, 6);
        const i64 source = source_ref(session, declaration);
        LocalRequest request = LocalRequest(name, type, source, compiler_resolver::sw(session, declaration, 9) == 1,
            true, true);
        request.set_origin(owner, SpanOriginKind::none, -1, -1, false);
        request.set_flags(false, lint_binding(session, declaration, type));
        const i64 local = add_local(session, request);
        const i64 staged_a0_135 = local_offset(session, local);
        const i64 staged_a1_136 = payload_type(session, type);
        emit_Store(session, staged_a0_135, staged_a1_136);
        return finish_statement(session, false);
    }
    auto begin_local(compiler_resolver::Session& session, i64 frame_id) -> bool {
        ContinuationRow frame = session.continuation(frame_id);
        const i64 declaration = frame.cursor();
        const i64 type = local_declared_type(session, declaration);
        const compiler_resolver::ResolvedTypeKind kind = value_kind(session, type);
        const i64 source = source_ref(session, declaration);
        const i64 node = compiler_resolver::sw(session, declaration, 3);
        if (compiler_resolver::service_kind(kind)) {
            return fail(session, LoweringError::local_service_capability, source);
        }
        if (kind == compiler_resolver::ResolvedTypeKind::byte_region) {
            return fail(session, LoweringError::region_parameter_position, source);
        }
        if (kind == compiler_resolver::ResolvedTypeKind::byte_span && compiler_resolver::sw(session, declaration, 9)
            == 1) {
            return fail(session, LoweringError::span_binding_requires_const, source);
        }
        frame.set_phase(ContinuationPhase::child);
        frame.set_call(-1, -1, -1, 0);
        session.set_continuation(frame_id, frame);
        if (compiler_resolver::scalar_value_kind(kind)) {
            return push_expression(session, node, -1, -1);
        }
        if (kind == compiler_resolver::ResolvedTypeKind::class_value || kind
            == compiler_resolver::ResolvedTypeKind::array_value || kind
            == compiler_resolver::ResolvedTypeKind::byte_span || is_owner_storage(session, type)) {
            return push_expression(session, node, type, declaration);
        }
        const compiler_resolver::SyntaxRow expression = session.syntax(node);
        if (expression.expression_kind() != compiler_parser::NodeKind::call) {
            return fail(session, LoweringError::ownership_binding_requires_constructor, source);
        }
        require_arity(session, node, 1);
        const i64 op = source_ref(session, node);
        const i64 argument = expression_argument(session, node, 0);
        if (kind == compiler_resolver::ResolvedTypeKind::owner && session.source_equal(op, "own")) {
            return push_expression(session, argument, -1, -1);
        }
        if (kind == compiler_resolver::ResolvedTypeKind::owner && session.source_equal(op, "move")) {
            const i64 original = named_source(session, argument);
            const LocalRow owner = session.local(original);
            const SnapshotRow state = owner.state();
            match_type(session, owner.concrete_type_id(), type, source);
            if (!owner.mutable_value() && compiler_resolver::sw(session, declaration, 9) == 1) {
                return fail(session, LoweringError::move_const_owner_to_mutable_binding, source);
            }
            if (state.shared_count() != 0 || state.exclusive()) {
                return fail(session, LoweringError::move_borrowed_owner, source);
            }
            set_live(session, original, false, state.resource_active());
            const i64 staged_a1_137 = payload_type(session, type);
            emit_Load(session, owner.offset(), staged_a1_137);
            return finish_local_scalar(session, frame_id, -1);
        }
        if ((kind == compiler_resolver::ResolvedTypeKind::reference && session.source_equal(op, "borrow")) || (kind
            == compiler_resolver::ResolvedTypeKind::mutable_reference && session.source_equal(op, "borrow_mut"))) {
            const i64 original = named_source(session, argument);
            const LocalRow owner = session.local(original);
            const SnapshotRow state = owner.state();
            const i64 staged_want_138 = scalar_id(session, compiler_resolver::ResolvedTypeKind::owner);
            match_type(session, owner.concrete_type_id(), staged_want_138, source);
            if (kind == compiler_resolver::ResolvedTypeKind::mutable_reference && !owner.mutable_value()) {
                return fail(session, LoweringError::mutable_borrow_of_const_owner, source);
            }
            if (state.exclusive() || (kind == compiler_resolver::ResolvedTypeKind::mutable_reference
                && state.shared_count() != 0)) {
                return fail(session, LoweringError::conflicting_borrow, source);
            }
            if (kind == compiler_resolver::ResolvedTypeKind::reference) {
