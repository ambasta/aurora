                    require_arity(session, node, 1);
                    if (binding) {
                        return fail(session, LoweringError::typed_owner_query_returns_scalar, reference);
                    }
                } else {
                    if (!session.source_equal(reference, "at") && !session.source_equal(reference, "set")
                        && !session.source_equal(reference, "try_resize")) {
                        return fail(session, LoweringError::unknown_typed_owner_operation, reference);
                    }
                    count = 2;
                    if (session.source_equal(reference, "at")) {
                        count = 1;
                    }
                    require_arity(session, node, count + 1);
                    if (count == 2 && !mutable_receiver) {
                        return fail(session, LoweringError::write_const_typed_owner, reference);
                    }
                    if (count == 1) {
                        if (!binding) {
                            return fail(session, LoweringError::typed_owner_access_requires_copied_destination,
                                reference);
                        }
                        if (frame.output_mark() >= 0) {
                            const i64 staged_want_61 = compiler_resolver::mw(session, type, 2);
                            match_type(session, frame.output_mark(), staged_want_61, reference);
                        }
                    } else {
                        if (binding) {
                            return fail(session, LoweringError::typed_owner_mutation_returns_bool, reference);
                        }
                    }
                }
            } else {
                if (kind == compiler_resolver::ResolvedTypeKind::owned_bytes) {
                    if (binding || implicit) {
                        return fail(session, LoweringError::byte_operation_requires_named_owner, reference);
                    }
                    if (session.source_equal(reference, "ok") || session.source_equal(reference, "size")) {
                        count = 0;
                    } else {
                        if (session.source_equal(reference, "at") || session.source_equal(reference, "set")
                            || session.source_equal(reference, "try_resize")) {
                            count = 1;
                            if (session.source_equal(reference, "set")) {
                                count = 2;
                            }
                            require_arity(session, node, count + 1);
                            if (!session.source_equal(reference, "at") && !mutable_receiver) {
                                return fail(session, LoweringError::write_const_byte_owner, reference);
                            }
                        } else {
                            return fail(session, LoweringError::unknown_owned_byte_operation, reference);
                        }
                    }
                } else {
                    if (kind == compiler_resolver::ResolvedTypeKind::byte_span) {
                        if (binding || implicit) {
                            return fail(session, LoweringError::span_operation_requires_named_live_span, reference);
                        }
                        if (session.source_equal(reference, "size")) {
                            if (actual != 0) {
                                return fail(session, LoweringError::span_size_argument_count, reference);
                            }
                        } else {
                            if (session.source_equal(reference, "at")) {
                                count = 1;
                                if (actual != 1) {
                                    return fail(session, LoweringError::span_at_argument_count, reference);
                                }
                            } else {
                                if (session.source_equal(reference, "subspan")) {
                                    return fail(session, LoweringError::subspan_requires_span_binding_or_argument,
                                        reference);
                                } else {
                                    return fail(session, LoweringError::unknown_readonly_span_operation, reference);
                                }
                            }
                        }
                    } else {
                        if (kind == compiler_resolver::ResolvedTypeKind::byte_region) {
                            if (!binding || !session.source_equal(reference, "try_allocate")
                                || !is_owner_storage(session, frame.output_mark())) {
                                return fail(session, LoweringError::region_allocation_requires_owned_bytes_initializer,
                                    reference);
                            }
                            count = 1;
                            if (value_kind(session, frame.output_mark())
                                == compiler_resolver::ResolvedTypeKind::owned_values) {
                                count = 2;
                            }
                        } else {
                            return fail(session, LoweringError::unknown_class_method, reference);
                        }
                    }
                }
            }
        }
        require_arity(session, node, count + 1);
        frame.set_call(target, frame.capability_root_local(), frame.receiver_field_index(), count);
        return session.set_continuation(frame_id, frame);
    }
    auto check_call_result(compiler_resolver::Session& session, i64 frame_id) -> bool {
        const ContinuationRow frame = session.continuation(frame_id);
        if (frame.call_target() < 0 || (is_method_expression(session, frame.syntax_node()) && value_kind(session,
            frame.cleanup_cursor()) != compiler_resolver::ResolvedTypeKind::class_value)) {
            return session.good();
        }
        const i64 callee = frame.call_target();
        const i64 reference = source_ref(session, frame.syntax_node());
        i64 result = signature_result(session, callee);
        const bool constructor = is_constructor_expression(session, frame.syntax_node());
        if (constructor) {
            const i64 staged_nominal_62 = compiler_resolver::mw(session, callee, 7);
            result = nominal_type(session, staged_nominal_62);
        }
        const bool span_destination = frame.output_mark() >= 0 && value_kind(session, frame.output_mark())
            == compiler_resolver::ResolvedTypeKind::byte_span;
        const bool inferred = argument_use(session, frame_id) && !span_destination;
        const bool binding = frame.scope_head() >= 0 || (frame.output_mark() >= 0 && !inferred);
        const bool method = is_method_expression(session, frame.syntax_node());
        if (inferred && is_resource_owner(session, result)) {
            return fail(session, LoweringError::copied_argument_consumes_owning_result, reference);
        }
        const i64 count = signature_count(session, callee);
        if (!method && !constructor && count > 0 && !binding && inferred && value_kind(session, result)
            == compiler_resolver::ResolvedTypeKind::class_value) {
            const i64 staged_type_63 = argument_type(session, callee, 0);
            const compiler_resolver::ResolvedTypeKind first = value_kind(session, staged_type_63);
            if (compiler_resolver::service_kind(first) || first == compiler_resolver::ResolvedTypeKind::byte_region
                || parameter_borrowed(session, callee, 0)) {
                return fail(session, LoweringError::copied_argument_requires_ordinary_call, reference);
            }
        }
        if (!method && !constructor && count > 0 && direct_return_use(session, frame_id)) {
            const i64 staged_type_64 = argument_type(session, callee, 0);
            const compiler_resolver::ResolvedTypeKind first = value_kind(session, staged_type_64);
            if (compiler_resolver::service_kind(first) || first == compiler_resolver::ResolvedTypeKind::byte_region
                || parameter_borrowed(session, callee, 0)) {
                return fail(session, LoweringError::direct_copied_return_requires_ordinary_call, reference);
            }
        }
        bool resource_result = !method && signature_count(session, callee) > 0;
        if (resource_result) {
            const i64 first_type = argument_type(session, callee, 0);
            resource_result = value_kind(session, first_type) == compiler_resolver::ResolvedTypeKind::byte_region
                && (value_kind(session, result) == compiler_resolver::ResolvedTypeKind::class_value
                || is_owner_storage(session, result) || constructor) && !binding;
        }
        if (resource_result) {
            return fail(session, LoweringError::resource_result_requires_typed_initializer, reference);
        }
        bool service_call = !method && count > 0;
        if (service_call) {
            const i64 first_type = argument_type(session, callee, 0);
            service_call = compiler_resolver::service_kind(value_kind(session, first_type));
        }
        if (service_call) {
            require_arity(session, frame.syntax_node(), count);
        }
        if (value_kind(session, result) == compiler_resolver::ResolvedTypeKind::class_value && !binding && !inferred) {
            if (method) {
                return fail(session, LoweringError::class_method_result_requires_typed_initializer, reference);
            }
            bool service_result = count > 0;
            if (service_result) {
                const i64 first_type = argument_type(session, callee, 0);
                service_result = compiler_resolver::service_kind(value_kind(session, first_type));
            }
            if (service_result) {
                return fail(session, LoweringError::service_report_requires_typed_initializer, reference);
            }
            return fail(session, LoweringError::class_call_result_requires_typed_initializer, reference);
        }
        if (inferred && method && value_kind(session, result) == compiler_resolver::ResolvedTypeKind::class_value
            && frame.receiver_field_index() >= 0 && owning_type(session, frame.cleanup_cursor())) {
            return fail(session, LoweringError::copied_argument_requires_complete_method_receiver, reference);
        }
        if (method && value_kind(session, result) == compiler_resolver::ResolvedTypeKind::byte_span) {
            if (!binding) {
                return fail(session, LoweringError::span_method_result_requires_initializer_or_argument, reference);
            }
            const i64 staged_type_65 = body_result_type(session);
            if (value_kind(session, staged_type_65) == compiler_resolver::ResolvedTypeKind::byte_span) {
                return fail(session, LoweringError::span_method_forwards_returned_view, reference);
            }
            if (frame.receiver_field_index() >= 0) {
                return fail(session, LoweringError::returned_span_requires_named_receiver, reference);
            }
            if (session.index(115, callee, 0, 0, 0) < 0) {
                return fail(session, LoweringError::span_method_requires_verified_field_summary, reference);
            }
        }
        if (binding) {
            match_type(session, result, frame.output_mark(), reference);
        }
        if (method && !method_const(session, callee)) {
            bool mutable_receiver = !body_receiver_const(session);
            if (frame.capability_root_local() >= 0) {
                const LocalRow receiver = session.local(frame.capability_root_local());
                mutable_receiver = receiver.mutable_value();
            }
            if (!mutable_receiver) {
                return fail(session, LoweringError::mutable_method_requires_mutable_receiver, reference);
            }
        }
        return session.good();
    }
    auto begin_call(compiler_resolver::Session& session, i64 frame_id) -> bool {
        ContinuationRow frame = session.continuation(frame_id);
        const i64 node = frame.syntax_node();
        const i64 reference = source_ref(session, node);
        const compiler_resolver::ResolvedRow resolved = session.resolved(node);
        const bool method = is_method_expression(session, node);
        const bool constructor = is_constructor_expression(session, node);
        if (method) {
            resolve_call_receiver(session, frame_id);
        } else {
            if (constructor) {
                const i64 type = resolved.word(2);
                if (argument_use(session, frame_id) && (value_kind(session, type)
                    != compiler_resolver::ResolvedTypeKind::class_value || owning_type(session, type))) {
                    return fail(session, LoweringError::class_argument_requires_copied_constructor, reference);
                }
                if (frame.output_mark() >= 0 && !argument_use(session, frame_id)) {
                    match_type(session, type, frame.output_mark(), reference);
                }
                const i64 callee = select_method(session, type, reference, true);
                frame.set_call(callee, -1, -1, signature_count(session, callee));
                session.set_continuation(frame_id, frame);
            } else {
                if (resolved.word(4) >= 0) {
                    const i64 arity = compiler_resolver::sw(session, node, 2);
                    i64 edge = compiler_resolver::mw(session, resolved.word(4), 0);
                    i64 ordinal = 0;
                    bool found = false;
                    while (edge >= 0 && session.good()) {
                        const i64 callee = compiler_resolver::mw(session, edge, 0);
                        if ((u64(resolved.word(5)) & (1u64 << ordinal)) != 0u64 && !admitted_function(session,
                            callee)) {
                            return fail(session, LoweringError::unknown_overload_candidate, reference);
                        }
                        if ((u64(resolved.word(5)) & (1u64 << ordinal)) != 0u64 && signature_count(session, callee)
                            == arity) {
                            found = true;
                        }
                        ordinal = ordinal + 1;
                        edge = compiler_resolver::mw(session, edge, 1);
                    }
                    if (!found) {
                        return require_arity(session, node, -1);
                    }
                    frame.set_call(-1, -1, -1, arity);
                    session.set_continuation(frame_id, frame);
                } else {
                    const i64 callee = resolved.word(1);
                    if (callee < 0 || !admitted_function(session, callee)) {
                        i64 name_id = resolved.word(0);
                        if (callee >= 0) {
                            name_id = callee;
                        }
                        const OperandRow name = scalar(OperandRole::DiagnosticNameId, name_id);
                        const OperandRow absent = scalar(OperandRole::NoDiagnosticValue, 0);
                        return fail_pair(session, LoweringError::unknown_function, reference, name, absent);
                    }
                    frame.set_call(callee, -1, -1, signature_count(session, callee));
                    session.set_continuation(frame_id, frame);
                }
            }
        }
        if (!session.good()) {
            return false;
        }
        check_call_result(session, frame_id);
        ContinuationRow checked_frame = session.continuation(frame_id);
        i64 actual = compiler_resolver::sw(session, node, 2);
        const compiler_resolver::SyntaxRow syntax = session.syntax(node);
        if (syntax.expression_kind() == compiler_parser::NodeKind::method_call) {
            actual = actual - 1;
        }
        if (actual != checked_frame.argument_count()) {
            if (method) {
                return fail(session, LoweringError::method_argument_count, reference);
            }
            return require_arity(session, node, checked_frame.argument_count());
        }
        checked_frame.set_phase(ContinuationPhase::argument);
        session.set_continuation(frame_id, checked_frame);
        return advance_call(session, frame_id);
    }
    auto intrinsic_argument_type(compiler_resolver::Session& session, ContinuationRow frame, i64 index) -> i64 {
        const i64 type = frame.cleanup_cursor();
        const compiler_resolver::ResolvedTypeKind kind = value_kind(session, type);
        if (compiler_resolver::service_kind(kind)) {
            const OperandRow parameters = record_slice(session, frame.call_target(), OperandRole::ParameterTypes);
            return list_value(session, parameters, index);
        }
        if (index == 0) {
            return scalar_id(session, compiler_resolver::ResolvedTypeKind::i64_value);
        }
        if (kind == compiler_resolver::ResolvedTypeKind::owned_values) {
            return compiler_resolver::mw(session, type, 2);
        }
        if (kind == compiler_resolver::ResolvedTypeKind::byte_region) {
            return compiler_resolver::mw(session, frame.output_mark(), 2);
        }
        return scalar_id(session, compiler_resolver::ResolvedTypeKind::u8_value);
    }
    auto intrinsic_method(compiler_resolver::Session& session, ContinuationRow frame) -> bool {
        return is_method_expression(session, frame.syntax_node()) && value_kind(session, frame.cleanup_cursor())
            != compiler_resolver::ResolvedTypeKind::class_value;
    }
    auto stage_direct_argument(compiler_resolver::Session& session, i64 frame_id, i64 type, i64 node) -> bool {
        ContinuationRow frame = session.continuation(frame_id);
        const i64 index = frame.next_argument();
        const i64 callee = frame.call_target();
        const i64 reference = source_ref(session, node);
        const compiler_resolver::ResolvedTypeKind kind = value_kind(session, type);
        if (kind == compiler_resolver::ResolvedTypeKind::byte_region) {
            const i64 local = named_source(session, node);
            const i64 staged_got_66 = local_type(session, local);
            const i64 staged_source_67 = source_ref(session, frame.syntax_node());
            match_type(session, staged_got_66, type, staged_source_67);
            const ArgumentLane lane = ArgumentLane(index, ArgumentKind::owner, type, local, -1, -1);
            frame.set_argument(index, lane);
            frame.set_call(callee, local, frame.receiver_field_index(), frame.argument_count());
        } else {
            if (compiler_resolver::service_kind(kind)) {
                const compiler_resolver::SyntaxRow syntax = session.syntax(node);
                if (syntax.expression_kind() != compiler_parser::NodeKind::name) {
                    return fail(session, LoweringError::service_forwarding_requires_named_exclusive_parameter,
                        reference);
                }
                const i64 local = named_source(session, node);
                const i64 staged_got_68 = local_type(session, local);
                match_type(session, staged_got_68, type, reference);
                const LocalRow root = session.local(local);
                const SnapshotRow state = root.state();
                if (state.exclusive()) {
                    return fail(session, LoweringError::service_authority_suspended, reference);
                }
                set_exclusive(session, local, true);
                const i64 loan = body_fresh_loan(session);
                const i64 service = service_type_id(session, type);
                emit_AcquireServiceLoan(session, loan, root.offset(), service);
                ArgumentLane lane = ArgumentLane(index, ArgumentKind::service, type, local, loan, service);
                lane.set_cleanup(CleanupKind::service_loan);
                frame.set_argument(index, lane);
            } else {
                if (index == 0 && parameter_borrowed(session, callee, 0)) {
                    const compiler_resolver::SyntaxRow syntax = session.syntax(node);
                    if (syntax.expression_kind() != compiler_parser::NodeKind::name) {
                        return fail(session, LoweringError::borrowed_argument_requires_complete_owner, reference);
                    }
                    const i64 local = named_source(session, node);
                    const i64 staged_got_69 = local_type(session, local);
                    match_type(session, staged_got_69, type, reference);
                    const LocalRow root = session.local(local);
                    const SnapshotRow state = root.state();
                    const bool mutable_loan = !parameter_const(session, callee, 0);
                    if (mutable_loan) {
                        if (!root.mutable_value()) {
                            return fail(session, LoweringError::mutable_borrowed_argument_requires_mutable_owner,
                                reference);
                        }
                        no_span_borrow(session, local, -1, reference);
                        change_object_loan(session, local, 0, true);
                    } else {
                        change_object_loan(session, local, 1, state.object_exclusive());
                    }
                    const i64 loan = body_fresh_loan(session);
                    i64 permission = 0;
                    if (mutable_loan) {
                        permission = 1;
                    }
                    emit_AcquireObjectLoan(session, loan, root.offset(), permission);
                    ArgumentLane lane = ArgumentLane(index, ArgumentKind::borrowed_receiver, type, local, loan, -1);
                    lane.set_cleanup(CleanupKind::object_loan);
                    frame.set_argument(index, lane);
                    frame.set_call(callee, local, frame.receiver_field_index(), frame.argument_count());
                } else {
                    if (is_resource_owner(session, type)) {
                        const i64 original = moved_source(session, node, type);
                        const LocalRow owner = session.local(original);
                        if (owner.owner_id() != frame.capability_root_local()) {
                            return fail(session, LoweringError::owner_region_mismatch, reference);
                        }
                        LocalRequest request = LocalRequest(-1, type, reference, true, false, true);
                        request.set_origin(owner.owner_id(), SpanOriginKind::none, -1, -1, false);
                        const i64 temporary = add_local(session, request);
                        emit_move(session, original, temporary);
                        ArgumentLane lane = ArgumentLane(index, ArgumentKind::owner, type, temporary, -1, -1);
                        lane.set_cleanup(CleanupKind::owner);
                        frame.set_argument(index, lane);
                    } else {
                        session.fail_storage(compiler_resolver::StorageStatus::invalid);
                        return false;
                    }
                }
            }
        }
        frame.set_next_argument(index + 1);
        return session.set_continuation(frame_id, frame);
    }
    auto advance_call(compiler_resolver::Session& session, i64 frame_id) -> bool {
        const ContinuationRow initial = session.continuation(frame_id);
        i64 next_argument = initial.next_argument();
        while (next_argument < initial.argument_count() && session.good()) {
            ContinuationRow frame = session.continuation(frame_id);
            const i64 index = frame.next_argument();
            const i64 node = call_argument_node(session, frame, index);
            const bool intrinsic = intrinsic_method(session, frame);
            i64 type = -1;
            if (intrinsic) {
                type = intrinsic_argument_type(session, frame, index);
            } else {
                if (frame.call_target() >= 0) {
                    type = argument_type(session, frame.call_target(), index);
                }
            }
            if (!intrinsic && type >= 0) {
                const compiler_resolver::ResolvedTypeKind kind = value_kind(session, type);
                if (compiler_resolver::service_kind(kind) || kind == compiler_resolver::ResolvedTypeKind::byte_region
                    || is_resource_owner(session, type) || (index == 0 && parameter_borrowed(session,
                    frame.call_target(), 0))) {
                    stage_direct_argument(session, frame_id, type, node);
                } else {
                    bool resource_constructor = kind == compiler_resolver::ResolvedTypeKind::class_value
                        && is_constructor_expression(session, frame.syntax_node()) && frame.argument_count() > 0;
                    if (resource_constructor) {
                        const i64 first_type = argument_type(session, frame.call_target(), 0);
                        resource_constructor = value_kind(session, first_type)
                            == compiler_resolver::ResolvedTypeKind::byte_region;
                    }
                    if (resource_constructor) {
                        const i64 original = named_source(session, node);
                        const i64 staged_got_70 = local_type(session, original);
                        const i64 staged_source_71 = source_ref(session, node);
                        match_type(session, staged_got_70, type, staged_source_71);
                        const i64 staged_source_72 = source_ref(session, node);
                        const i64 snapshot = copied_snapshot(session, original, staged_source_72);
                        ArgumentLane lane = ArgumentLane(index, ArgumentKind::object, type, snapshot, -1, -1);
                        lane.set_cleanup(CleanupKind::object);
                        frame.set_argument(index, lane);
                        frame.set_next_argument(index + 1);
                        session.set_continuation(frame_id, frame);
                    } else {
                        i64 expected = -1;
                        if (kind == compiler_resolver::ResolvedTypeKind::class_value || (kind
                            == compiler_resolver::ResolvedTypeKind::byte_span && !is_constructor_expression(session,
                            frame.syntax_node()))) {
                            expected = type;
                        }
                        return push_expression(session, node, expected, -1);
                    }
                }
            } else {
                if (intrinsic && index == 1 && value_kind(session, type)
                    == compiler_resolver::ResolvedTypeKind::class_value) {
                    const i64 original = named_source(session, node);
                    const i64 staged_got_73 = local_type(session, original);
                    const i64 staged_source_74 = source_ref(session, node);
                    match_type(session, staged_got_73, type, staged_source_74);
                    const i64 staged_source_75 = source_ref(session, node);
                    const i64 snapshot = copied_snapshot(session, original, staged_source_75);
                    ArgumentLane lane = ArgumentLane(index, ArgumentKind::object, type, snapshot, -1, -1);
                    lane.set_cleanup(CleanupKind::object);
                    frame.set_argument(index, lane);
                    frame.set_next_argument(index + 1);
                    session.set_continuation(frame_id, frame);
                    emit_Pop(session);
                } else {
                    i64 expected = -1;
                    if (type < 0 && span_expression(session, node)) {
                        expected = scalar_id(session, compiler_resolver::ResolvedTypeKind::byte_span);
                    }
                    return push_expression(session, node, expected, -1);
                }
            }
            const ContinuationRow advanced = session.continuation(frame_id);
            next_argument = advanced.next_argument();
        }
        if (!session.good()) {
            return false;
        }
        return finish_call(session, frame_id);
    }
    auto collect_call_argument(compiler_resolver::Session& session, i64 frame_id) -> bool {
        ContinuationRow frame = session.continuation(frame_id);
        const i64 index = frame.next_argument();
        const i64 node = call_argument_node(session, frame, index);
        const i64 type = frame.child_type_id();
        const i64 local = frame.child_local_id();
        const bool intrinsic = intrinsic_method(session, frame);
        i64 expected = -1;
        if (intrinsic) {
            expected = intrinsic_argument_type(session, frame, index);
        } else {
            if (frame.call_target() >= 0) {
                expected = argument_type(session, frame.call_target(), index);
            }
        }
        if (expected >= 0) {
            i64 reference = source_ref(session, node);
            bool copied_constructor = is_constructor_expression(session, frame.syntax_node());
            if (copied_constructor) {
                const i64 nominal = compiler_resolver::mw(session, frame.call_target(), 7);
                const i64 constructed_type = nominal_type(session, nominal);
                copied_constructor = !owning_type(session, constructed_type);
            }
            if (intrinsic || (copied_constructor && value_kind(session, expected)
                != compiler_resolver::ResolvedTypeKind::class_value)) {
                reference = source_ref(session, frame.syntax_node());
            }
            match_type(session, type, expected, reference);
        }
        ArgumentKind kind = ArgumentKind::scalar;
        CleanupKind cleanup = CleanupKind::none;
        if (value_kind(session, type) == compiler_resolver::ResolvedTypeKind::byte_span) {
            kind = ArgumentKind::span;
            cleanup = CleanupKind::span;
        } else {
            if (value_kind(session, type) == compiler_resolver::ResolvedTypeKind::class_value) {
                kind = ArgumentKind::object;
                cleanup = CleanupKind::object;
            }
        }
        ArgumentLane lane = ArgumentLane(index, kind, type, local, -1, -1);
        lane.set_cleanup(cleanup);
        frame.set_argument(index, lane);
        frame.set_next_argument(index + 1);
        session.set_continuation(frame_id, frame);
        if (kind == ArgumentKind::scalar) {
            if (!intrinsic) {
                emit_Push(session);
            } else {
                const compiler_resolver::ResolvedTypeKind receiver = value_kind(session, frame.cleanup_cursor());
                const i64 reference = source_ref(session, frame.syntax_node());
                if (compiler_resolver::service_kind(receiver)) {
                    if (session.source_equal(reference, "pixel")) {
                        emit_Push(session);
                    }
                } else {
                    if (frame.argument_count() > 1 && index == 0) {
                        if (receiver == compiler_resolver::ResolvedTypeKind::byte_region) {
