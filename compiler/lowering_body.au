export module aurora.compiler.lowering_body;
import aurora.compiler.lowering_values;
import aurora.compiler.lowering_common;
import aurora.compiler.lowering_types;
import aurora.compiler.lowering_configuration;
import aurora.compiler.lowering_storage;
import aurora.compiler.lowering_kinds;
import aurora.compiler.lowering_errors;
import aurora.compiler.resolver;
import aurora.compiler.resolution_arena;
import aurora.compiler.syntax_arena;

export namespace compiler_lowering {
    // Continuation meanings, by kind:
    // function: syntax=function symbol, scopeHead=parameter binding chain,
    // prefix=monotonic frame words, incoming=next loan, then=result type,
    // firstLabel=module label cursor, secondLabel=span-field summary,
    // outputMark=first function output, operandMark=lint eligibility.
    // block: syntax=block, cursor=current statement, scopeHead=binding chain,
    // outputMark=static_assert's first temporary output, child=(type,local).
    // if/while: syntax=statement, prefix=captured Local prefix; incoming/then
    // are six-field Snapshot slices, labels preserve source emission order.
    // expression: syntax=expression, cursor=forward child edge; scopeHead is
    // an optional real local-binding syntax identity; outputMark=expected type,
    // operandMark=diagnostic use-site source; child=(type,local), callTarget is
    // a selected callable identity, root/field identify receiver authority.
    // Expression use is derived from its typed parent's kind and phase. No
    // integer opcode, arbitrary-word stack or additional helper frame is used.

    auto empty_lane() -> ArgumentLane {
        const ArgumentLane result = ArgumentLane(-1, ArgumentKind::absent, -1, -1, -1, -1);
        return result;
    }
    auto push_frame(compiler_resolver::Session& session, ContinuationRow frame) -> bool {
        if (session.continuation_count() >= 384) {
            session.fail_storage(compiler_resolver::StorageStatus::limit);
            return false;
        }
        return session.append_continuation(frame) >= 0;
    }
    auto push_expression(compiler_resolver::Session& session, i64 node, i64 expected, i64 binding) -> bool {
        const ArgumentLane empty = empty_lane();
        ContinuationRow frame = ContinuationRow(ContinuationKind::expression, node, -1, empty);
        frame.set_scope(binding, 0);
        frame.set_marks(expected, source_ref(session, node));
        return push_frame(session, frame);
    }
    auto finish_expression(compiler_resolver::Session& session, i64 type, i64 local) -> bool {
        const i64 count = session.continuation_count();
        if (count < 2) {
            session.fail_storage(compiler_resolver::StorageStatus::invalid);
            return false;
        }
        session.truncate_continuations(count - 1);
        ContinuationRow parent = session.continuation(count - 2);
        parent.set_child(type, local);
        return session.set_continuation(count - 2, parent);
    }
    auto finish_statement(compiler_resolver::Session& session, bool terminal) -> bool {
        const i64 top = session.continuation_count() - 1;
        ContinuationRow block = session.continuation(top);
        if (block.kind() != ContinuationKind::block) {
            session.fail_storage(compiler_resolver::StorageStatus::invalid);
            return false;
        }
        i64 terminal_value = 0;
        if (terminal) { terminal_value = 1; }
        block.set_child(-1, terminal_value);
        const i64 last = compiler_resolver::sw(session, block.syntax_node(), 7);
        block.set_cursor(ordered_next(session, last, block.cursor(), 2));
        block.set_phase(ContinuationPhase::next_statement);
        return session.set_continuation(top, block);
    }
    auto push_block(compiler_resolver::Session& session, i64 syntax) -> bool {
        const ArgumentLane empty = empty_lane();
        ContinuationRow frame = ContinuationRow(ContinuationKind::block, syntax, -1, empty);
        frame.set_child(-1, 0);
        return push_frame(session, frame);
    }
    auto body_receiver_nominal(compiler_resolver::Session& session) -> i64 {
        return compiler_resolver::mw(session, body_function(session), 7);
    }
    auto body_receiver_const(compiler_resolver::Session& session) -> bool {
        const i64 declaration = compiler_resolver::mw(session, body_function(session), 5);
        return compiler_resolver::sw(session, declaration, 9) == 1;
    }
    auto body_constructor(compiler_resolver::Session& session) -> bool {
        return compiler_resolver::declaration_kind(session, body_function(session)) == compiler_resolver::DeclarationKind::constructor;
    }
    auto nominal_type(compiler_resolver::Session& session, i64 nominal) -> i64 {
        return compiler_resolver::concrete_type(session, compiler_resolver::ResolvedTypeKind::class_value, nominal, -1, 0);
    }
    auto require_visible_type(compiler_resolver::Session& session, i64 type, i64 reference) -> bool {
        i64 checked = type;
        if (value_kind(session, type) == compiler_resolver::ResolvedTypeKind::owned_values) {
            checked = compiler_resolver::mw(session, type, 2);
        }
        const compiler_resolver::ResolvedTypeKind kind = value_kind(session, checked);
        if (!compiler_resolver::nominal_kind(kind)) { return session.good(); }
        const i64 function = body_function(session);
        const i64 unit = compiler_resolver::mw(session, function, 1);
        const i64 scope = compiler_resolver::mw(session, function, 2);
        const compiler_resolver::BindContext context = compiler_resolver::BindContext(unit, scope, function, body_receiver_nominal(session), false, false);
        if (!compiler_resolver::body_visible(session, checked, context)) {
            return fail(session, LoweringError::method_signature_import, reference);
        }
        return session.good();
    }
    auto field_index(compiler_resolver::Session& session, i64 nominal, i64 reference) -> i64 {
        const i64 atom = session.intern_atom(reference);
        if (session.index(113, nominal, 0, 0, 0) < 0) {
            const i64 count = field_total(session, nominal);
            i64 at = 0;
            while (at < count && session.good()) {
                const i64 name = session.intern_atom(field_source(session, nominal, at));
                session.index_insert(114, nominal, name, 0, 0, at);
                at = at + 1;
            }
            session.index_insert(113, nominal, 0, 0, 0, 0);
        }
        return session.index(114, nominal, atom, 0, 0);
    }
    auto checked_field(compiler_resolver::Session& session, i64 type, i64 reference, bool synthetic) -> i64 {
        const i64 nominal = compiler_resolver::mw(session, type, 1);
        if (value_kind(session, type) != compiler_resolver::ResolvedTypeKind::class_value || nominal < 0) {
            if (synthetic) {
                const OperandRow value = scalar(OperandRole::DiagnosticTypeId, type);
                const OperandRow absent = scalar(OperandRole::NoDiagnosticValue, 0);
                fail_synthetic(session, LoweringError::unknown_class_type, reference, value, absent);
            } else { fail_type(session, LoweringError::unknown_class_type, reference, type); }
            return -1;
        }
        const i64 field = field_index(session, nominal, reference);
        if (field < 0) {
            const OperandRow name = scalar(OperandRole::DiagnosticNameId, reference);
            const OperandRow owner = scalar(OperandRole::DiagnosticTypeId, type);
            if (synthetic) { fail_synthetic(session, LoweringError::unknown_class_field, reference, name, owner); }
            else { fail_pair(session, LoweringError::unknown_class_field, reference, name, owner); }
            return -1;
        }
        if (!field_public(session, nominal, field) && body_receiver_nominal(session) != nominal) {
            if (synthetic) {
                const OperandRow absent = scalar(OperandRole::NoDiagnosticValue, 0);
                fail_synthetic(session, LoweringError::private_class_field, reference, absent, absent);
            } else { fail(session, LoweringError::private_class_field, reference); }
            return -1;
        }
        require_visible_type(session, field_type(session, nominal, field), reference);
        return field;
    }
    auto implicit_field(compiler_resolver::Session& session, i64 reference) -> i64 {
        const i64 nominal = body_receiver_nominal(session);
        if (nominal < 0) { return -1; }
        const i64 field = field_index(session, nominal, reference);
        if (field >= 0 && body_constructor(session)) {
            return error(session, LoweringError::initializer_receiver_field_access, reference);
        }
        return field;
    }
    auto field_displacement(compiler_resolver::Session& session, i64 type, i64 field) -> i64 {
        const i64 layout = class_row(session, type);
        const i64 storage = record_signed(session, layout, OperandRole::StorageRef);
        const OperandRow offsets = record_slice(session, storage, OperandRole::FieldOffsets);
        return list_value(session, offsets, field);
    }
    auto argument_use(compiler_resolver::Session& session, i64 frame_id) -> bool {
        if (frame_id == 0) { return false; }
        const ContinuationRow parent = session.continuation(frame_id - 1);
        return parent.kind() == ContinuationKind::expression && parent.phase() == ContinuationPhase::argument;
    }
    auto direct_return_use(compiler_resolver::Session& session, i64 frame_id) -> bool {
        if (frame_id == 0) { return false; }
        const ContinuationRow parent = session.continuation(frame_id - 1);
        return parent.kind() == ContinuationKind::block && parent.phase() == ContinuationPhase::returning;
    }
    auto expression_request(compiler_resolver::Session& session, ContinuationRow frame, i64 type, bool mutable_temporary) -> LocalRequest {
        i64 name = -1;
        i64 reference = frame.operand_mark();
        bool mutable_value = mutable_temporary;
        bool bind = false;
        if (frame.scope_head() >= 0) {
            const compiler_resolver::SyntaxRow declaration = session.syntax(frame.scope_head());
            name = declaration.word(6);
            reference = declaration.word(0);
            mutable_value = declaration.word(9) == 1;
            bind = true;
        }
        const LocalRequest result = LocalRequest(name, type, reference, mutable_value, bind, true);
        return result;
    }
    auto expression_destination(compiler_resolver::Session& session, ContinuationRow frame, i64 type, i64 owner) -> i64 {
        LocalRequest request = expression_request(session, frame, type, false);
        request.set_origin(owner, SpanOriginKind::none, -1, -1, false);
        return add_local(session, request);
    }
    auto select_method(compiler_resolver::Session& session, i64 type, i64 reference, bool constructor) -> i64 {
        const i64 nominal = compiler_resolver::mw(session, type, 1);
        if (value_kind(session, type) != compiler_resolver::ResolvedTypeKind::class_value || nominal < 0) {
            return error_type(session, LoweringError::unknown_class_type, reference, type);
        }
        i64 symbol = -1;
        if (constructor) {
            symbol = constructor_symbol(session, nominal);
        } else {
            const i64 prefix = session.source_name(reference);
            const i64 syntax = compiler_resolver::receiver_member(session, nominal, prefix);
            if (syntax >= 0) { symbol = compiler_resolver::rw(session, syntax, 1); }
        }
        if (symbol < 0) {
            if (constructor) { return error(session, LoweringError::missing_declared_constructor, reference); }
            return error(session, LoweringError::unknown_class_method, reference);
        }
        if (!method_public(session, symbol) && body_receiver_nominal(session) != nominal) {
            if (constructor) { return error(session, LoweringError::private_constructor, reference); }
            return error(session, LoweringError::private_method, reference);
        }
        return symbol;
    }
    auto method_const(compiler_resolver::Session& session, i64 symbol) -> bool {
        return compiler_resolver::sw(session, compiler_resolver::mw(session, symbol, 5), 9) == 1;
    }
    auto argument_type(compiler_resolver::Session& session, i64 symbol, i64 ordinal) -> i64 {
        return compiler_resolver::mw(session, signature_parameter(session, symbol, ordinal), 1);
    }
    auto body_parameter_borrowed(compiler_resolver::Session& session, i64 symbol, i64 ordinal) -> bool {
        const i64 syntax = compiler_resolver::mw(session, signature_parameter(session, symbol, ordinal), 2);
        return compiler_resolver::sw(session, syntax, 10) >= 0;
    }
    auto body_parameter_const(compiler_resolver::Session& session, i64 symbol, i64 ordinal) -> bool {
        const i64 syntax = compiler_resolver::mw(session, signature_parameter(session, symbol, ordinal), 2);
        return compiler_resolver::sw(session, syntax, 9) == 1;
    }
    auto unary_instruction(compiler_resolver::Session& session, i64 node, i64 type) -> bool {
        const i64 reference = source_ref(session, node);
        Unary operation = Unary::CheckedNegate;
        if (session.source_equal(reference, "!")) {
            operation = Unary::LogicalNot;
            match_type(session, type, scalar_id(session, compiler_resolver::ResolvedTypeKind::bool_value), reference);
        } else if (session.source_equal(reference, "~")) {
            operation = Unary::BitNot;
            const compiler_resolver::ResolvedTypeKind kind = value_kind(session, type);
            if (kind != compiler_resolver::ResolvedTypeKind::u64_value && kind != compiler_resolver::ResolvedTypeKind::u8_value) {
                return fail(session, LoweringError::bitwise_operand_type, reference);
            }
        } else {
            match_type(session, type, scalar_id(session, compiler_resolver::ResolvedTypeKind::i64_value), reference);
        }
        const i64 begin = session.operand_count();
        put(session, OperandRole::OperandTypeId, type);
        OutputRow row = OutputRow(RecordKind::Instruction, InstructionForm::UnaryValue, begin, 1);
        row.set_unary(operation);
        session.append_output(row);
        return session.good();
    }
    auto binary_instruction(compiler_resolver::Session& session, i64 node, i64 left, i64 right) -> i64 {
        const i64 source = source_ref(session, node);
        const compiler_resolver::ResolvedTypeKind kind = value_kind(session, left);
        const bool shift = session.source_equal(source, "<<") || session.source_equal(source, ">>");
        Binary operation = Binary::CheckedAdd;
        if (shift) {
            if (kind != compiler_resolver::ResolvedTypeKind::u64_value && kind != compiler_resolver::ResolvedTypeKind::u8_value) {
                return error(session, LoweringError::shift_operand_type, source);
            }
            match_type(session, right, scalar_id(session, compiler_resolver::ResolvedTypeKind::i64_value), source);
            operation = Binary::ShiftLeft;
            if (session.source_equal(source, ">>")) { operation = Binary::ShiftRight; }
        } else { match_type(session, right, left, source); }
        const bool bitwise = session.source_equal(source, "&") || session.source_equal(source, "|") || session.source_equal(source, "^");
        const bool arithmetic = session.source_equal(source, "+") || session.source_equal(source, "-") || session.source_equal(source, "*") || session.source_equal(source, "/") || session.source_equal(source, "%");
        if (shift || bitwise || arithmetic) {
            if (bitwise && kind != compiler_resolver::ResolvedTypeKind::u64_value && kind != compiler_resolver::ResolvedTypeKind::u8_value) {
                return error(session, LoweringError::bitwise_operands_type, source);
            }
            if (arithmetic && kind != compiler_resolver::ResolvedTypeKind::i64_value && kind != compiler_resolver::ResolvedTypeKind::u64_value && kind != compiler_resolver::ResolvedTypeKind::u8_value) {
                return error(session, LoweringError::arithmetic_operands_type, source);
            }
            if (session.source_equal(source, "-")) { operation = Binary::CheckedSubtract; }
            if (session.source_equal(source, "*")) { operation = Binary::CheckedMultiply; }
            if (session.source_equal(source, "/")) { operation = Binary::CheckedDivide; }
            if (session.source_equal(source, "%")) { operation = Binary::CheckedRemainder; }
            if (session.source_equal(source, "&")) { operation = Binary::BitAnd; }
            if (session.source_equal(source, "|")) { operation = Binary::BitOr; }
            if (session.source_equal(source, "^")) { operation = Binary::BitXor; }
            const i64 begin = session.operand_count();
            put(session, OperandRole::OperandTypeId, left);
            OutputRow row = OutputRow(RecordKind::Instruction, InstructionForm::BinaryValue, begin, 1);
            row.set_binary(operation);
            session.append_output(row);
            return left;
        }
        if (!session.source_equal(source, "==") && !session.source_equal(source, "!=") && kind != compiler_resolver::ResolvedTypeKind::i64_value && kind != compiler_resolver::ResolvedTypeKind::u64_value && kind != compiler_resolver::ResolvedTypeKind::u8_value) {
            return error(session, LoweringError::ordered_comparison_operands_type, source);
        }
        Comparison comparison = Comparison::Equal;
        if (session.source_equal(source, "!=")) { comparison = Comparison::NotEqual; }
        if (session.source_equal(source, "<")) { comparison = Comparison::Less; }
        if (session.source_equal(source, ">")) { comparison = Comparison::Greater; }
        if (session.source_equal(source, "<=")) { comparison = Comparison::LessEqual; }
        if (session.source_equal(source, ">=")) { comparison = Comparison::GreaterEqual; }
        const i64 begin = session.operand_count();
        put(session, OperandRole::OperandTypeId, left);
        OutputRow row = OutputRow(RecordKind::Instruction, InstructionForm::Compare, begin, 1);
        row.set_comparison(comparison);
        session.append_output(row);
        return scalar_id(session, compiler_resolver::ResolvedTypeKind::bool_value);
    }
    auto span_origin_root(LocalRow span) -> i64 {
        if (span.span_origin_kind() == SpanOriginKind::receiver) { return -2; }
        if (span.span_origin_kind() == SpanOriginKind::literal) { return -3; }
        if (span.span_origin_kind() == SpanOriginKind::incoming_parameter) { return -1; }
        return span.origin_local_id();
    }
    auto make_span(compiler_resolver::Session& session, ContinuationRow frame, i64 parent, i64 origin, i64 field, bool temporary) -> i64 {
        const i64 type = scalar_id(session, compiler_resolver::ResolvedTypeKind::byte_span);
        LocalRequest request = expression_request(session, frame, type, false);
        SpanOriginKind kind = SpanOriginKind::local;
        i64 root = origin;
        if (origin == -1) { kind = SpanOriginKind::incoming_parameter; root = -1; }
        if (origin == -2) { kind = SpanOriginKind::receiver; root = -1; }
        if (origin == -3) { kind = SpanOriginKind::literal; root = -1; }
        request.set_origin(parent, kind, root, field, temporary);
        const i64 result = add_local(session, request);
        if (parent >= 0) { change_shared(session, parent, 1); }
        if (origin >= 0) { change_shared(session, origin, 1); }
        return result;
    }
    auto begin_span(compiler_resolver::Session& session, i64 frame_id) -> bool {
        ContinuationRow frame = session.continuation(frame_id);
        const i64 node = frame.syntax_node();
        const compiler_resolver::SyntaxRow syntax = session.syntax(node);
        const i64 reference = source_ref(session, node);
        if (syntax.expression_kind() == compiler_parser::NodeKind::literal) {
            if (!argument_use(session, frame_id)) { return fail(session, LoweringError::invalid_span_initializer, reference); }
            const i64 count = decode_string(session, reference, false, false);
            const i64 destination = make_span(session, frame, -1, -3, -1, false);
            const i64 begin = session.source_size();
            decode_string(session, reference, true, false);
            const OperandRow bytes = slice(OperandRole::LiteralBytes, begin, count);
            emit_BorrowLiteralSpan(session, bytes, local_offset(session, destination));
            return finish_expression(session, scalar_id(session, compiler_resolver::ResolvedTypeKind::byte_span), destination);
        }
        if (syntax.expression_kind() == compiler_parser::NodeKind::name) {
            const i64 parent = named_source(session, node);
            if (!session.good()) { return false; }
            const LocalRow span = session.local(parent);
            if (value_kind(session, span.concrete_type_id()) != compiler_resolver::ResolvedTypeKind::byte_span) {
                return fail(session, LoweringError::invalid_span_initializer, reference);
            }
            const i64 destination = make_span(session, frame, parent, span_origin_root(span), span.span_field_index(), false);
            emit_ReborrowSpan(session, span.offset(), local_offset(session, destination));
            return finish_expression(session, span.concrete_type_id(), destination);
        }
        if (syntax.expression_kind() == compiler_parser::NodeKind::call && session.source_equal(reference, "borrow_bytes")) {
            require_arity(session, node, 1);
            const i64 target = expression_argument(session, node, 0);
            const compiler_resolver::SyntaxRow target_row = session.syntax(target);
            i64 origin = -2;
            i64 field = -1;
            i64 type = -1;
            if (target_row.expression_kind() == compiler_parser::NodeKind::name) {
                const i64 name = source_ref(session, target);
                if (lookup_local(session, name) < 0) { field = implicit_field(session, name); }
                if (field < 0) {
                    origin = named_source(session, target);
                    type = local_type(session, origin);
                } else { type = field_type(session, body_receiver_nominal(session), field); }
            } else if (target_row.expression_kind() == compiler_parser::NodeKind::member) {
                const i64 receiver = target_row.word(1);
                const compiler_resolver::SyntaxRow receiver_row = session.syntax(receiver);
                if (receiver_row.expression_kind() != compiler_parser::NodeKind::name) {
                    return fail(session, LoweringError::borrow_bytes_requires_named_storage_or_private_field, reference);
                }
                origin = named_source(session, receiver);
                const LocalRow local = session.local(origin);
                if (local.borrowed_object()) { return fail(session, LoweringError::borrowed_object_field_access, source_ref(session, target)); }
                field = checked_field(session, local.concrete_type_id(), source_ref(session, target), false);
                type = field_type(session, compiler_resolver::mw(session, local.concrete_type_id(), 1), field);
            } else { return fail(session, LoweringError::borrow_bytes_requires_named_storage_or_private_field, reference); }
            const bool receiver_array = origin == -2 && is_byte_array(session, type);
            if (field >= 0) {
                if (value_kind(session, type) != compiler_resolver::ResolvedTypeKind::owned_bytes && !receiver_array) {
                    return fail(session, LoweringError::borrow_bytes_field_storage, reference);
                }
            } else if (!is_byte_array(session, type) && value_kind(session, type) != compiler_resolver::ResolvedTypeKind::owned_bytes) {
                return fail(session, LoweringError::borrow_bytes_requires_named_storage, reference);
            }
            const i64 destination = make_span(session, frame, -1, origin, field, false);
            if (receiver_array) { emit_BorrowReceiverArraySpan(session, field, local_offset(session, destination)); }
            else if (field >= 0 || value_kind(session, type) == compiler_resolver::ResolvedTypeKind::owned_bytes) {
                i64 offset = 0;
                if (origin >= 0) { offset = local_offset(session, origin); }
                emit_BorrowOwnedSpan(session, offset, field, local_offset(session, destination));
            } else { emit_BorrowSpan(session, local_offset(session, origin), local_offset(session, destination)); }
            return finish_expression(session, scalar_id(session, compiler_resolver::ResolvedTypeKind::byte_span), destination);
        }
        if (syntax.expression_kind() == compiler_parser::NodeKind::method_call && session.source_equal(reference, "subspan")) {
            if (syntax.word(2) != 3) { return fail(session, LoweringError::subspan_argument_count, reference); }
            const i64 target = expression_argument(session, node, 0);
            const compiler_resolver::SyntaxRow target_row = session.syntax(target);
            if (target_row.expression_kind() == compiler_parser::NodeKind::name) {
                const i64 parent = named_source(session, target);
                if (value_kind(session, local_type(session, parent)) != compiler_resolver::ResolvedTypeKind::byte_span) {
                    return fail(session, LoweringError::subspan_requires_live_readonly_view, reference);
                }
                frame.set_call(-1, parent, -1, 2);
                frame.set_phase(ContinuationPhase::argument);
                session.set_continuation(frame_id, frame);
                return push_expression(session, expression_argument(session, node, 1), -1, -1);
            }
            frame.set_phase(ContinuationPhase::child);
            session.set_continuation(frame_id, frame);
            return push_expression(session, target, scalar_id(session, compiler_resolver::ResolvedTypeKind::byte_span), -1);
        }
        if (syntax.expression_kind() == compiler_parser::NodeKind::method_call || session.resolved(node).operation() == compiler_resolver::ResolvedOperation::implicit_method_call) {
            return begin_call(session, frame_id);
        }
        return fail(session, LoweringError::invalid_span_initializer, reference);
    }
    auto step_subspan(compiler_resolver::Session& session, i64 frame_id) -> bool {
        ContinuationRow frame = session.continuation(frame_id);
        const i64 reference = source_ref(session, frame.syntax_node());
        if (frame.phase() == ContinuationPhase::child) {
            const LocalRow parent = session.local(frame.child_local_id());
            const i64 origin = span_origin_root(parent);
            if (origin == -1 || (origin >= 0 && is_byte_array(session, local_type(session, origin)))) {
                return fail(session, LoweringError::temporary_subspan_requires_owned_origin, reference);
            }
            frame.set_call(-1, frame.child_local_id(), -1, 2);
            // A non-name parent is a fresh temporary; its Local identity remains
            // in capabilityRootLocal while both scalar operands are checked.
            frame.set_phase(ContinuationPhase::argument);
            session.set_continuation(frame_id, frame);
            return push_expression(session, expression_argument(session, frame.syntax_node(), 1), -1, -1);
        }
        match_type(session, frame.child_type_id(), scalar_id(session, compiler_resolver::ResolvedTypeKind::i64_value), reference);
        if (frame.next_argument() == 0) {
            emit_Push(session);
            frame.set_next_argument(1);
            session.set_continuation(frame_id, frame);
            return push_expression(session, expression_argument(session, frame.syntax_node(), 2), -1, -1);
        }
        const i64 parent_id = frame.capability_root_local();
        const LocalRow parent = session.local(parent_id);
        const i64 parent_node = expression_argument(session, frame.syntax_node(), 0);
        const compiler_resolver::SyntaxRow parent_syntax = session.syntax(parent_node);
        const bool temporary = parent_syntax.expression_kind() != compiler_parser::NodeKind::name;
        const i64 destination = make_span(session, frame, parent_id, span_origin_root(parent), parent.span_field_index(), temporary);
        emit_Subspan(session, parent.offset(), local_offset(session, destination));
        return finish_expression(session, parent.concrete_type_id(), destination);
    }
    auto span_expression(compiler_resolver::Session& session, i64 expression) -> bool {
        // subspan chains are followed iteratively, never adding helper frames.
        i64 node = expression;
        while (session.good()) {
            const compiler_resolver::SyntaxRow row = session.syntax(node);
            const i64 reference = source_ref(session, node);
            if (row.expression_kind() == compiler_parser::NodeKind::literal) {
                const compiler_resolver::MetaRow source = session.meta(reference);
                return session.source_byte(source.word(1)) == '"';
            }
            if (row.expression_kind() == compiler_parser::NodeKind::name) {
                const i64 local = lookup_local(session, reference);
                return local >= 0 && value_kind(session, local_type(session, local)) == compiler_resolver::ResolvedTypeKind::byte_span;
            }
            if (row.expression_kind() == compiler_parser::NodeKind::call && session.resolved(node).operation() != compiler_resolver::ResolvedOperation::implicit_method_call) {
                return session.source_equal(reference, "borrow_bytes");
            }
            if (row.expression_kind() == compiler_parser::NodeKind::method_call && session.source_equal(reference, "subspan") && row.word(2) > 0) {
                node = expression_argument(session, node, 0);
            } else {
                i64 type = -1;
                if (session.resolved(node).operation() == compiler_resolver::ResolvedOperation::implicit_method_call) {
                    if (body_receiver_nominal(session) < 0) { return false; }
                    type = nominal_type(session, body_receiver_nominal(session));
                } else if (row.expression_kind() == compiler_parser::NodeKind::method_call && row.word(2) > 0) {
                    const i64 receiver = expression_argument(session, node, 0);
                    const compiler_resolver::SyntaxRow receiver_row = session.syntax(receiver);
                    if (receiver_row.expression_kind() != compiler_parser::NodeKind::name) { return false; }
                    const i64 name = source_ref(session, receiver);
                    const i64 local = lookup_local(session, name);
                    if (local >= 0) { type = local_type(session, local); }
                    else {
                        const i64 field = implicit_field(session, name);
                        if (field < 0) { return false; }
                        type = field_type(session, body_receiver_nominal(session), field);
                    }
                } else { return false; }
                if (value_kind(session, type) != compiler_resolver::ResolvedTypeKind::class_value) { return false; }
                const i64 method = select_method(session, type, reference, false);
                return value_kind(session, signature_result(session, method)) == compiler_resolver::ResolvedTypeKind::byte_span;
            }
        }
        return false;
    }
    auto class_array_sources(compiler_resolver::Session& session, i64 node, i64 type) -> OperandRow {
        const compiler_resolver::SyntaxRow syntax = session.syntax(node);
        const i64 count = compiler_resolver::mw(session, type, 3);
        if (syntax.expression_kind() != compiler_parser::NodeKind::array_literal || syntax.word(2) != count) {
            fail(session, LoweringError::class_array_initializer_count, source_ref(session, node));
            const OperandRow empty = slice(OperandRole::Sources, 0, 0);
            return empty;
        }
        const i64 begin = session.operand_count();
        i64 edge = ordered_first(session, syntax.word(1), 1);
        while (edge >= 0 && session.good()) {
            const i64 child = compiler_resolver::sw(session, edge, 0);
            const compiler_resolver::SyntaxRow child_row = session.syntax(child);
            if (child_row.expression_kind() != compiler_parser::NodeKind::name) {
                fail(session, LoweringError::class_array_initializer_requires_complete_locals, source_ref(session, child));
                const OperandRow empty = slice(OperandRole::Sources, 0, 0);
                return empty;
            }
            const i64 original = named_source(session, child);
            match_type(session, local_type(session, original), compiler_resolver::mw(session, type, 2), source_ref(session, child));
            put(session, OperandRole::Offset, local_offset(session, original));
            edge = ordered_next(session, syntax.word(1), edge, 1);
        }
        const OperandRow result = slice(OperandRole::Sources, begin, count);
        return result;
    }
    auto begin_array(compiler_resolver::Session& session, i64 frame_id) -> bool {
        ContinuationRow frame = session.continuation(frame_id);
        const i64 type = frame.output_mark();
        const i64 node = frame.syntax_node();
        const i64 reference = source_ref(session, node);
        const compiler_resolver::SyntaxRow syntax = session.syntax(node);
        const i64 length = compiler_resolver::mw(session, type, 3);
        const i64 element = compiler_resolver::mw(session, type, 2);
        if (is_class_array(session, type)) { class_carrier(session, type, frame.operand_mark()); }
        if (syntax.expression_kind() == compiler_parser::NodeKind::name) {
            const i64 original = named_source(session, node);
            match_type(session, local_type(session, original), type, reference);
            const i64 destination = expression_destination(session, frame, type, -1);
            if (is_class_array(session, type)) {
                emit_CopyObject(session, local_offset(session, original), local_offset(session, destination));
            } else {
                i64 at = 0;
                while (at < length && session.good()) {
                    const i64 displacement = at * scalar_width(session, element);
                    emit_Load(session, local_offset(session, original) - displacement, element);
                    emit_Store(session, local_offset(session, destination) - displacement, element);
                    at = at + 1;
                }
            }
            return finish_expression(session, type, destination);
        }
        if (is_class_array(session, type)) {
            const OperandRow sources = class_array_sources(session, node, type);
            const i64 destination = expression_destination(session, frame, type, -1);
            emit_InitializeClassArray(session, local_offset(session, destination), 0, sources);
            return finish_expression(session, type, destination);
        }
        if (syntax.expression_kind() == compiler_parser::NodeKind::literal) {
            const compiler_resolver::MetaRow token = session.meta(reference);
            if (session.source_byte(token.word(1)) == '"') {
                if (value_kind(session, element) != compiler_resolver::ResolvedTypeKind::u8_value) {
                    return fail(session, LoweringError::byte_string_requires_byte_elements, reference);
                }
                const i64 decoded = decode_string(session, reference, false, false);
                if (decoded != length) {
                    const OperandRow expected = scalar(OperandRole::DiagnosticInteger, length);
                    const OperandRow actual = scalar(OperandRole::DiagnosticInteger, decoded);
                    return fail_pair(session, LoweringError::byte_array_initializer_length, reference, expected, actual);
                }
                decode_string(session, reference, false, true);
                const i64 destination = expression_destination(session, frame, type, -1);
                i64 at = length;
                while (at > 0 && session.good()) {
                    at = at - 1;
                    emit_Pop(session);
                    emit_Store(session, local_offset(session, destination) - at, element);
                }
                return finish_expression(session, type, destination);
            }
        }
        if (syntax.expression_kind() != compiler_parser::NodeKind::array_literal) {
            return fail(session, LoweringError::array_initializer_requires_literal_or_copy, reference);
        }
        if (syntax.word(2) != length) { return fail(session, LoweringError::array_initializer_length, reference); }
        const i64 first = ordered_first(session, syntax.word(1), 1);
        frame.set_cursor(first);
        frame.set_phase(ContinuationPhase::argument);
        session.set_continuation(frame_id, frame);
        return push_expression(session, compiler_resolver::sw(session, first, 0), -1, -1);
    }
    auto step_array(compiler_resolver::Session& session, i64 frame_id) -> bool {
        ContinuationRow frame = session.continuation(frame_id);
        const i64 type = frame.output_mark();
        const i64 element = compiler_resolver::mw(session, type, 2);
        const i64 child = compiler_resolver::sw(session, frame.cursor(), 0);
        match_type(session, frame.child_type_id(), element, source_ref(session, child));
        emit_Push(session);
        const i64 last = compiler_resolver::sw(session, frame.syntax_node(), 1);
        const i64 next = ordered_next(session, last, frame.cursor(), 1);
        if (next >= 0) {
            frame.set_cursor(next);
            session.set_continuation(frame_id, frame);
            return push_expression(session, compiler_resolver::sw(session, next, 0), -1, -1);
        }
        const i64 destination = expression_destination(session, frame, type, -1);
        i64 at = compiler_resolver::mw(session, type, 3);
        while (at > 0 && session.good()) {
            at = at - 1;
            emit_Pop(session);
            emit_Store(session, local_offset(session, destination) - at * scalar_width(session, element), element);
        }
        return finish_expression(session, type, destination);
    }
    auto is_method_expression(compiler_resolver::Session& session, i64 node) -> bool {
        const compiler_resolver::SyntaxRow syntax = session.syntax(node);
        const compiler_resolver::ResolvedRow resolved = session.resolved(node);
        return syntax.expression_kind() == compiler_parser::NodeKind::method_call || resolved.operation() == compiler_resolver::ResolvedOperation::implicit_method_call;
    }
    auto is_constructor_expression(compiler_resolver::Session& session, i64 node) -> bool {
        const compiler_resolver::ResolvedRow resolved = session.resolved(node);
        return resolved.operation() == compiler_resolver::ResolvedOperation::constructor_call;
    }
    auto call_argument_node(compiler_resolver::Session& session, ContinuationRow frame, i64 index) -> i64 {
        const compiler_resolver::SyntaxRow syntax = session.syntax(frame.syntax_node());
        i64 actual = index;
        if (syntax.expression_kind() == compiler_parser::NodeKind::method_call) { actual = actual + 1; }
        return expression_argument(session, frame.syntax_node(), actual);
    }
    auto service_operation_contract(compiler_resolver::Session& session, i64 type, i64 reference) -> i64 {
        i64 at = 0;
        while (at < service_contract_count(session) && session.good()) {
            const i64 row = service_contract(session, at);
            if (record_signed(session, row, OperandRole::TypeId) == type) {
                const i64 name = record_signed(session, row, OperandRole::IdentifierSourceRef);
                if (session.intern_atom(name) == session.intern_atom(reference)) { return row; }
            }
            at = at + 1;
        }
        return -1;
    }
    auto resolve_call_receiver(compiler_resolver::Session& session, i64 frame_id) -> bool {
        ContinuationRow frame = session.continuation(frame_id);
        const i64 node = frame.syntax_node();
        const i64 reference = source_ref(session, node);
        const compiler_resolver::ResolvedRow resolved = session.resolved(node);
        const bool implicit = resolved.operation() == compiler_resolver::ResolvedOperation::implicit_method_call;
        i64 root = -2;
        i64 type = -1;
        i64 field = -1;
        bool mutable_receiver = !body_receiver_const(session);
        if (implicit) {
            if (lookup_local(session, reference) >= 0) { return fail(session, LoweringError::local_shadows_method, reference); }
            type = nominal_type(session, body_receiver_nominal(session));
        } else {
            const i64 target = expression_argument(session, node, 0);
            const compiler_resolver::SyntaxRow target_row = session.syntax(target);
            if (target_row.expression_kind() == compiler_parser::NodeKind::name) {
                const i64 name = source_ref(session, target);
                if (lookup_local(session, name) < 0) { field = implicit_field(session, name); }
                if (field < 0) {
                    root = named_source(session, target);
                    const LocalRow local = session.local(root);
                    type = local.concrete_type_id();
                    mutable_receiver = local.mutable_value();
                } else { type = field_type(session, body_receiver_nominal(session), field); }
            } else if (target_row.expression_kind() == compiler_parser::NodeKind::member) {
                const i64 target_parent = target_row.word(1);
                const compiler_resolver::SyntaxRow parent_row = session.syntax(target_parent);
                if (parent_row.expression_kind() != compiler_parser::NodeKind::name) { return fail(session, LoweringError::method_receiver_requires_class_storage, reference); }
                root = named_source(session, target_parent);
                const LocalRow local = session.local(root);
                if (local.borrowed_object()) { return fail(session, LoweringError::borrowed_object_field_projection, source_ref(session, target)); }
                mutable_receiver = local.mutable_value();
                field = checked_field(session, local.concrete_type_id(), source_ref(session, target), false);
                type = field_type(session, compiler_resolver::mw(session, local.concrete_type_id(), 1), field);
            } else { return fail(session, LoweringError::method_receiver_requires_class_storage, reference); }
            if (field >= 0) {
                if (value_kind(session, type) != compiler_resolver::ResolvedTypeKind::class_value && !is_owner_storage(session, type)) {
                    return fail(session, LoweringError::nested_method_receiver_requires_owned_field, source_ref(session, target));
                }
                require_visible_type(session, type, source_ref(session, target));
            }
        }
        frame.set_call(-1, root, field, 0);
        frame.set_cleanup_cursor(type);
        // Receiver mutability is frozen in a typed lane until ordinary argument
        // staging starts; it is recomputed from the root/receiver for rechecks.
        session.set_continuation(frame_id, frame);
        const compiler_resolver::ResolvedTypeKind kind = value_kind(session, type);
        if (frame.output_mark() >= 0 && direct_return_use(session, frame_id) && value_kind(session, frame.output_mark()) == compiler_resolver::ResolvedTypeKind::class_value
            && (compiler_resolver::service_kind(kind) || (field >= 0 && kind != compiler_resolver::ResolvedTypeKind::owned_values && (kind != compiler_resolver::ResolvedTypeKind::class_value || owning_type(session, type))))) {
            return fail(session, LoweringError::direct_copied_return_requires_complete_method_receiver, reference);
        }
        if (kind == compiler_resolver::ResolvedTypeKind::class_value) {
            const i64 callee = select_method(session, type, reference, false);
            require_visible_type(session, signature_result(session, callee), reference);
            i64 at = 0;
            while (at < signature_count(session, callee) && session.good()) {
                require_visible_type(session, argument_type(session, callee, at), reference);
                at = at + 1;
            }
            if (!method_const(session, callee) && !mutable_receiver) { return fail(session, LoweringError::mutable_method_requires_mutable_receiver, reference); }
            frame.set_call(callee, root, field, signature_count(session, callee));
            return session.set_continuation(frame_id, frame);
        }
        return prepare_intrinsic_method(session, frame_id, mutable_receiver, implicit);
    }
    auto live_receiver(compiler_resolver::Session& session, ContinuationRow frame) -> bool {
        const i64 root = frame.capability_root_local();
        if (root >= 0) {
            const LocalRow local = session.local(root);
            const SnapshotRow state = local.state();
            if (!state.live()) { return fail(session, LoweringError::arguments_consumed_method_receiver, source_ref(session, frame.syntax_node())); }
            if (state.object_exclusive()) { return fail(session, LoweringError::owning_object_exclusively_borrowed, source_ref(session, frame.syntax_node())); }
        }
        return session.good();
    }
    auto receiver_offset(compiler_resolver::Session& session, ContinuationRow frame) -> i64 {
        if (frame.capability_root_local() < 0) { return 0; }
        return local_offset(session, frame.capability_root_local());
    }
    auto prepare_intrinsic_method(compiler_resolver::Session& session, i64 frame_id, bool mutable_receiver, bool implicit) -> bool {
        ContinuationRow frame = session.continuation(frame_id);
        const i64 type = frame.cleanup_cursor();
        const compiler_resolver::ResolvedTypeKind kind = value_kind(session, type);
        const i64 node = frame.syntax_node();
        const i64 reference = source_ref(session, node);
        const i64 actual = compiler_resolver::sw(session, node, 2) - 1;
        const bool binding = frame.scope_head() >= 0 || (frame.output_mark() >= 0 && !argument_use(session, frame_id));
        i64 count = 0;
        i64 target = -1;
        if (compiler_resolver::service_kind(kind)) {
            if (implicit || frame.capability_root_local() < 0 || frame.receiver_field_index() != -1) {
                return fail(session, LoweringError::service_operation_requires_active_exclusive_parameter, reference);
            }
            const LocalRow local = session.local(frame.capability_root_local());
            const SnapshotRow state = local.state();
            if (state.exclusive()) { return fail(session, LoweringError::service_operation_requires_active_exclusive_parameter, reference); }
            target = service_operation_contract(session, type, reference);
            if (target < 0) { return fail(session, LoweringError::unknown_service_operation, reference); }
            const OperandRow parameters = record_slice(session, target, OperandRole::ParameterTypes);
            count = parameters.count();
            const i64 result = record_signed(session, target, OperandRole::ResultTypeId);
            const bool copied = value_kind(session, result) == compiler_resolver::ResolvedTypeKind::class_value;
            if (copied && !binding) {
                if (session.source_equal(reference, "next")) { return fail(session, LoweringError::next_requires_console_sample_initializer, reference); }
                return fail(session, LoweringError::poll_requires_event_sample_initializer, reference);
            }
            if (!copied && binding) {
                if (session.source_equal(reference, "put")) { return fail(session, LoweringError::put_returns_scalar_enum, reference); }
                if (session.source_equal(reference, "pixel")) { return fail(session, LoweringError::pixel_returns_scalar_enum, reference); }
                return fail(session, LoweringError::acknowledge_returns_scalar_enum, reference);
            }
            if (binding) { match_type(session, frame.output_mark(), result, reference); }
        } else if (kind == compiler_resolver::ResolvedTypeKind::owned_values) {
            if (implicit) { return fail(session, LoweringError::typed_owner_operation_requires_named_owner, reference); }
            owned_element(session, type, reference);
            if (session.source_equal(reference, "ok") || session.source_equal(reference, "size")) {
                if (binding) { return fail(session, LoweringError::typed_owner_query_returns_scalar, reference); }
            } else {
                if (!session.source_equal(reference, "at") && !session.source_equal(reference, "set") && !session.source_equal(reference, "try_resize")) { return fail(session, LoweringError::unknown_typed_owner_operation, reference); }
                count = 2;
                if (session.source_equal(reference, "at")) { count = 1; }
                if (count == 2 && !mutable_receiver) { return fail(session, LoweringError::write_const_typed_owner, reference); }
                if (count == 1) {
                    if (!binding && !argument_use(session, frame_id)) { return fail(session, LoweringError::typed_owner_access_requires_copied_destination, reference); }
                    if (frame.output_mark() >= 0) { match_type(session, frame.output_mark(), compiler_resolver::mw(session, type, 2), reference); }
                } else if (binding) { return fail(session, LoweringError::typed_owner_mutation_returns_bool, reference); }
            }
        } else if (kind == compiler_resolver::ResolvedTypeKind::owned_bytes) {
            if (binding || implicit) { return fail(session, LoweringError::byte_operation_requires_named_owner, reference); }
            if (session.source_equal(reference, "ok") || session.source_equal(reference, "size")) { count = 0; }
            else if (session.source_equal(reference, "at") || session.source_equal(reference, "set") || session.source_equal(reference, "try_resize")) {
                count = 1;
                if (session.source_equal(reference, "set")) { count = 2; }
                if (!session.source_equal(reference, "at") && !mutable_receiver) { return fail(session, LoweringError::write_const_byte_owner, reference); }
            } else { return fail(session, LoweringError::unknown_owned_byte_operation, reference); }
        } else if (kind == compiler_resolver::ResolvedTypeKind::byte_span) {
            if (binding || implicit) { return fail(session, LoweringError::span_operation_requires_named_live_span, reference); }
            if (session.source_equal(reference, "size")) {
                if (actual != 0) { return fail(session, LoweringError::span_size_argument_count, reference); }
            } else if (session.source_equal(reference, "at")) {
                count = 1;
                if (actual != 1) { return fail(session, LoweringError::span_at_argument_count, reference); }
            } else if (session.source_equal(reference, "subspan")) { return fail(session, LoweringError::subspan_requires_span_binding_or_argument, reference); }
            else { return fail(session, LoweringError::unknown_readonly_span_operation, reference); }
        } else if (kind == compiler_resolver::ResolvedTypeKind::byte_region) {
            if (!binding || !session.source_equal(reference, "try_allocate") || !is_owner_storage(session, frame.output_mark())) { return fail(session, LoweringError::region_allocation_requires_owned_bytes_initializer, reference); }
            count = 1;
            if (value_kind(session, frame.output_mark()) == compiler_resolver::ResolvedTypeKind::owned_values) { count = 2; }
        } else { return fail(session, LoweringError::unknown_class_method, reference); }
        require_arity(session, node, count + 1);
        frame.set_call(target, frame.capability_root_local(), frame.receiver_field_index(), count);
        return session.set_continuation(frame_id, frame);
    }
    auto check_call_result(compiler_resolver::Session& session, i64 frame_id) -> bool {
        const ContinuationRow frame = session.continuation(frame_id);
        if (frame.call_target() < 0 || (is_method_expression(session, frame.syntax_node()) && value_kind(session, frame.cleanup_cursor()) != compiler_resolver::ResolvedTypeKind::class_value)) { return session.good(); }
        const i64 callee = frame.call_target();
        const i64 reference = source_ref(session, frame.syntax_node());
        i64 result = signature_result(session, callee);
        const bool constructor = is_constructor_expression(session, frame.syntax_node());
        if (constructor) { result = nominal_type(session, compiler_resolver::mw(session, callee, 7)); }
        const bool inferred = argument_use(session, frame_id);
        const bool binding = frame.scope_head() >= 0 || (direct_return_use(session, frame_id) && frame.output_mark() >= 0);
        const bool method = is_method_expression(session, frame.syntax_node());
        if (inferred && is_resource_owner(session, result)) { return fail(session, LoweringError::copied_argument_consumes_owning_result, reference); }
        const i64 count = signature_count(session, callee);
        if (!method && !constructor && count > 0 && !binding && inferred) {
            const compiler_resolver::ResolvedTypeKind first = value_kind(session, argument_type(session, callee, 0));
            if (compiler_resolver::service_kind(first) || first == compiler_resolver::ResolvedTypeKind::byte_region || parameter_borrowed(session, callee, 0)) {
                return fail(session, LoweringError::copied_argument_requires_ordinary_call, reference);
            }
        }
        if (!method && !constructor && count > 0 && direct_return_use(session, frame_id)) {
            const compiler_resolver::ResolvedTypeKind first = value_kind(session, argument_type(session, callee, 0));
            if (compiler_resolver::service_kind(first) || first == compiler_resolver::ResolvedTypeKind::byte_region || parameter_borrowed(session, callee, 0)) {
                return fail(session, LoweringError::direct_copied_return_requires_ordinary_call, reference);
            }
        }
        if (value_kind(session, result) == compiler_resolver::ResolvedTypeKind::class_value && !binding && !inferred) {
            if (method) { return fail(session, LoweringError::class_method_result_requires_typed_initializer, reference); }
            return fail(session, LoweringError::class_call_result_requires_typed_initializer, reference);
        }
        if (binding) { match_type(session, result, frame.output_mark(), reference); }
        if (method && value_kind(session, result) == compiler_resolver::ResolvedTypeKind::byte_span) {
            if (!binding && frame.output_mark() < 0) { return fail(session, LoweringError::span_method_result_requires_initializer_or_argument, reference); }
            if (value_kind(session, body_result_type(session)) == compiler_resolver::ResolvedTypeKind::byte_span) { return fail(session, LoweringError::span_method_forwards_returned_view, reference); }
            if (frame.receiver_field_index() >= 0) { return fail(session, LoweringError::returned_span_requires_named_receiver, reference); }
            if (session.index(115, callee, 0, 0, 0) < 0) { return fail(session, LoweringError::span_method_requires_verified_field_summary, reference); }
        }
        return session.good();
    }
    auto begin_call(compiler_resolver::Session& session, i64 frame_id) -> bool {
        ContinuationRow frame = session.continuation(frame_id);
        const i64 node = frame.syntax_node();
        const i64 reference = source_ref(session, node);
        const compiler_resolver::ResolvedRow resolved = session.resolved(node);
        const bool method = is_method_expression(session, node);
        const bool constructor = is_constructor_expression(session, node);
        if (method) {
            resolve_call_receiver(session, frame_id);
            frame = session.continuation(frame_id);
        } else if (constructor) {
            const i64 type = resolved.word(2);
            if (argument_use(session, frame_id) && (value_kind(session, type) != compiler_resolver::ResolvedTypeKind::class_value || owning_type(session, type))) {
                return fail(session, LoweringError::class_argument_requires_copied_constructor, reference);
            }
            if (frame.output_mark() >= 0 && !argument_use(session, frame_id)) { match_type(session, type, frame.output_mark(), reference); }
            const i64 callee = select_method(session, type, reference, true);
            frame.set_call(callee, -1, -1, signature_count(session, callee));
            session.set_continuation(frame_id, frame);
        } else if (resolved.word(4) >= 0) {
            const i64 arity = compiler_resolver::sw(session, node, 2);
            i64 edge = compiler_resolver::mw(session, resolved.word(4), 0);
            i64 ordinal = 0;
            bool found = false;
            while (edge >= 0 && session.good()) {
                const i64 callee = compiler_resolver::mw(session, edge, 0);
                if ((u64(resolved.word(5)) & (1u64 << ordinal)) != 0u64 && signature_count(session, callee) == arity) { found = true; }
                ordinal = ordinal + 1;
                edge = compiler_resolver::mw(session, edge, 1);
            }
            if (!found) { return require_arity(session, node, -1); }
            frame.set_call(-1, -1, -1, arity);
            session.set_continuation(frame_id, frame);
        } else {
            const i64 callee = resolved.word(1);
            if (callee < 0) {
                const OperandRow name = scalar(OperandRole::DiagnosticNameId, reference);
                const OperandRow absent = scalar(OperandRole::NoDiagnosticValue, 0);
                return fail_pair(session, LoweringError::unknown_function, reference, name, absent);
            }
            frame.set_call(callee, -1, -1, signature_count(session, callee));
            session.set_continuation(frame_id, frame);
        }
        if (!session.good()) { return false; }
        check_call_result(session, frame_id);
        frame = session.continuation(frame_id);
        i64 actual = compiler_resolver::sw(session, node, 2);
        const compiler_resolver::SyntaxRow syntax = session.syntax(node);
        if (syntax.expression_kind() == compiler_parser::NodeKind::method_call) { actual = actual - 1; }
        if (actual != frame.argument_count()) {
            if (method) { return fail(session, LoweringError::method_argument_count, reference); }
            return require_arity(session, node, frame.argument_count());
        }
        frame.set_phase(ContinuationPhase::argument);
        session.set_continuation(frame_id, frame);
        return advance_call(session, frame_id);
    }
    auto intrinsic_argument_type(compiler_resolver::Session& session, ContinuationRow frame, i64 index) -> i64 {
        const i64 type = frame.cleanup_cursor();
        const compiler_resolver::ResolvedTypeKind kind = value_kind(session, type);
        if (compiler_resolver::service_kind(kind)) {
            const OperandRow parameters = record_slice(session, frame.call_target(), OperandRole::ParameterTypes);
            return list_value(session, parameters, index);
        }
        if (index == 0) { return scalar_id(session, compiler_resolver::ResolvedTypeKind::i64_value); }
        if (kind == compiler_resolver::ResolvedTypeKind::owned_values) { return compiler_resolver::mw(session, type, 2); }
        if (kind == compiler_resolver::ResolvedTypeKind::byte_region) { return compiler_resolver::mw(session, frame.output_mark(), 2); }
        return scalar_id(session, compiler_resolver::ResolvedTypeKind::u8_value);
    }
    auto intrinsic_method(compiler_resolver::Session& session, ContinuationRow frame) -> bool {
        return is_method_expression(session, frame.syntax_node()) && value_kind(session, frame.cleanup_cursor()) != compiler_resolver::ResolvedTypeKind::class_value;
    }
    auto stage_direct_argument(compiler_resolver::Session& session, i64 frame_id, i64 type, i64 node) -> bool {
        ContinuationRow frame = session.continuation(frame_id);
        const i64 index = frame.next_argument();
        const i64 callee = frame.call_target();
        const i64 reference = source_ref(session, node);
        const compiler_resolver::ResolvedTypeKind kind = value_kind(session, type);
        if (kind == compiler_resolver::ResolvedTypeKind::byte_region) {
            const i64 local = named_source(session, node);
            match_type(session, local_type(session, local), type, source_ref(session, frame.syntax_node()));
            const ArgumentLane lane = ArgumentLane(index, ArgumentKind::owner, type, local, -1, -1);
            frame.set_argument(index, lane);
            frame.set_call(callee, local, frame.receiver_field_index(), frame.argument_count());
        } else if (compiler_resolver::service_kind(kind)) {
            const compiler_resolver::SyntaxRow syntax = session.syntax(node);
            if (syntax.expression_kind() != compiler_parser::NodeKind::name) { return fail(session, LoweringError::service_forwarding_requires_named_exclusive_parameter, reference); }
            const i64 local = named_source(session, node);
            match_type(session, local_type(session, local), type, reference);
            const LocalRow root = session.local(local);
            const SnapshotRow state = root.state();
            if (state.exclusive()) { return fail(session, LoweringError::service_authority_suspended, reference); }
            set_exclusive(session, local, true);
            const i64 loan = body_fresh_loan(session);
            const i64 service = service_type_id(session, type);
            emit_AcquireServiceLoan(session, loan, root.offset(), service);
            ArgumentLane lane = ArgumentLane(index, ArgumentKind::service, type, local, loan, service);
            lane.set_cleanup(CleanupKind::service_loan);
            frame.set_argument(index, lane);
        } else if (index == 0 && parameter_borrowed(session, callee, 0)) {
            const compiler_resolver::SyntaxRow syntax = session.syntax(node);
            if (syntax.expression_kind() != compiler_parser::NodeKind::name) { return fail(session, LoweringError::borrowed_argument_requires_complete_owner, reference); }
            const i64 local = named_source(session, node);
            match_type(session, local_type(session, local), type, reference);
            const LocalRow root = session.local(local);
            const SnapshotRow state = root.state();
            const bool mutable_loan = !parameter_const(session, callee, 0);
            if (mutable_loan) {
                if (!root.mutable_value()) { return fail(session, LoweringError::mutable_borrowed_argument_requires_mutable_owner, reference); }
                no_span_borrow(session, local, -1, reference);
                change_object_loan(session, local, 0, true);
            } else { change_object_loan(session, local, 1, state.object_exclusive()); }
            const i64 loan = body_fresh_loan(session);
            i64 permission = 0;
            if (mutable_loan) { permission = 1; }
            emit_AcquireObjectLoan(session, loan, root.offset(), permission);
            ArgumentLane lane = ArgumentLane(index, ArgumentKind::borrowed_receiver, type, local, loan, -1);
            lane.set_cleanup(CleanupKind::object_loan);
            frame.set_argument(index, lane);
            frame.set_call(callee, local, frame.receiver_field_index(), frame.argument_count());
        } else if (is_resource_owner(session, type)) {
            const i64 original = moved_source(session, node, type);
            const LocalRow owner = session.local(original);
            if (owner.owner_id() != frame.capability_root_local()) { return fail(session, LoweringError::owner_region_mismatch, reference); }
            LocalRequest request = LocalRequest(-1, type, reference, true, false, true);
            request.set_origin(owner.owner_id(), SpanOriginKind::none, -1, -1, false);
            const i64 temporary = add_local(session, request);
            emit_move(session, original, temporary);
            ArgumentLane lane = ArgumentLane(index, ArgumentKind::owner, type, temporary, -1, -1);
            lane.set_cleanup(CleanupKind::owner);
            frame.set_argument(index, lane);
        } else {
            session.fail_storage(compiler_resolver::StorageStatus::invalid);
            return false;
        }
        frame.set_next_argument(index + 1);
        return session.set_continuation(frame_id, frame);
    }
    auto advance_call(compiler_resolver::Session& session, i64 frame_id) -> bool {
        ContinuationRow frame = session.continuation(frame_id);
        while (frame.next_argument() < frame.argument_count() && session.good()) {
            const i64 index = frame.next_argument();
            const i64 node = call_argument_node(session, frame, index);
            const bool intrinsic = intrinsic_method(session, frame);
            i64 type = -1;
            if (intrinsic) { type = intrinsic_argument_type(session, frame, index); }
            else if (frame.call_target() >= 0) { type = argument_type(session, frame.call_target(), index); }
            if (!intrinsic && type >= 0) {
                const compiler_resolver::ResolvedTypeKind kind = value_kind(session, type);
                if (compiler_resolver::service_kind(kind) || kind == compiler_resolver::ResolvedTypeKind::byte_region
                    || is_resource_owner(session, type) || (index == 0 && parameter_borrowed(session, frame.call_target(), 0))) {
                    stage_direct_argument(session, frame_id, type, node);
                    frame = session.continuation(frame_id);
                } else {
                    i64 expected = -1;
                    if (kind == compiler_resolver::ResolvedTypeKind::class_value || kind == compiler_resolver::ResolvedTypeKind::byte_span) { expected = type; }
                    return push_expression(session, node, expected, -1);
                }
            } else if (intrinsic && index == 1 && value_kind(session, type) == compiler_resolver::ResolvedTypeKind::class_value) {
                const i64 original = named_source(session, node);
                match_type(session, local_type(session, original), type, source_ref(session, node));
                const i64 snapshot = copied_snapshot(session, original, source_ref(session, node));
                ArgumentLane lane = ArgumentLane(index, ArgumentKind::object, type, snapshot, -1, -1);
                lane.set_cleanup(CleanupKind::object);
                frame.set_argument(index, lane);
                frame.set_next_argument(index + 1);
                session.set_continuation(frame_id, frame);
                emit_Pop(session);
            } else {
                i64 expected = -1;
                if (type < 0 && span_expression(session, node)) { expected = scalar_id(session, compiler_resolver::ResolvedTypeKind::byte_span); }
                return push_expression(session, node, expected, -1);
            }
        }
        if (!session.good()) { return false; }
        return finish_call(session, frame_id);
    }
    auto collect_call_argument(compiler_resolver::Session& session, i64 frame_id) -> bool {
        ContinuationRow frame = session.continuation(frame_id);
        const i64 index = frame.next_argument();
        const i64 node = call_argument_node(session, frame, index);
        const i64 type = frame.child_type_id();
        const i64 local = frame.child_local_id();
        const bool intrinsic = intrinsic_method(session, frame);
        i64 expected = -1;
        if (intrinsic) { expected = intrinsic_argument_type(session, frame, index); }
        else if (frame.call_target() >= 0) { expected = argument_type(session, frame.call_target(), index); }
        if (expected >= 0) {
            i64 reference = source_ref(session, frame.syntax_node());
            if (value_kind(session, expected) == compiler_resolver::ResolvedTypeKind::class_value) { reference = source_ref(session, node); }
            match_type(session, type, expected, reference);
        }
        ArgumentKind kind = ArgumentKind::scalar;
        CleanupKind cleanup = CleanupKind::none;
        if (value_kind(session, type) == compiler_resolver::ResolvedTypeKind::byte_span) { kind = ArgumentKind::span; cleanup = CleanupKind::span; }
        else if (value_kind(session, type) == compiler_resolver::ResolvedTypeKind::class_value) { kind = ArgumentKind::object; cleanup = CleanupKind::object; }
        ArgumentLane lane = ArgumentLane(index, kind, type, local, -1, -1);
        lane.set_cleanup(cleanup);
        frame.set_argument(index, lane);
        frame.set_next_argument(index + 1);
        session.set_continuation(frame_id, frame);
        if (kind == ArgumentKind::scalar) {
            if (!intrinsic) { emit_Push(session); }
            else {
                const compiler_resolver::ResolvedTypeKind receiver = value_kind(session, frame.cleanup_cursor());
                const i64 reference = source_ref(session, frame.syntax_node());
                if (compiler_resolver::service_kind(receiver)) {
                    if (session.source_equal(reference, "pixel")) { emit_Push(session); }
                } else if (frame.argument_count() > 1 && index == 0) { emit_Push(session); }
                if (receiver == compiler_resolver::ResolvedTypeKind::owned_values) { live_receiver(session, frame); }
            }
        }
        return advance_call(session, frame_id);
    }
    auto select_overload(compiler_resolver::Session& session, i64 frame_id) -> bool {
        ContinuationRow frame = session.continuation(frame_id);
        const compiler_resolver::ResolvedRow resolved = session.resolved(frame.syntax_node());
        i64 edge = compiler_resolver::mw(session, resolved.word(4), 0);
        i64 ordinal = 0;
        i64 selected = -1;
        bool inaccessible = false;
        while (edge >= 0 && session.good()) {
            const i64 candidate = compiler_resolver::mw(session, edge, 0);
            if ((u64(resolved.word(5)) & (1u64 << ordinal)) != 0u64 && signature_count(session, candidate) == frame.argument_count()) {
                bool exact = true;
                i64 index = 0;
                while (index < frame.argument_count()) {
                    const ArgumentLane lane = frame.argument(index);
                    if (lane.concrete_type_id() != argument_type(session, candidate, index)) { exact = false; }
                    index = index + 1;
                }
                if (exact) {
                    if (selected >= 0) { return fail(session, LoweringError::ambiguous_exact_overload, source_ref(session, frame.syntax_node())); }
                    selected = candidate;
                    inaccessible = (u64(resolved.word(6)) & (1u64 << ordinal)) != 0u64;
                }
            }
            ordinal = ordinal + 1;
            edge = compiler_resolver::mw(session, edge, 1);
        }
        if (selected < 0) {
            const i64 reference = source_ref(session, frame.syntax_node());
            const OperandRow name = scalar(OperandRole::DiagnosticNameId, reference);
            const OperandRow absent = scalar(OperandRole::NoDiagnosticValue, 0);
            return fail_pair(session, LoweringError::no_exact_overload, reference, name, absent);
        }
        if (inaccessible) { return fail(session, LoweringError::function_signature_import, source_ref(session, frame.syntax_node())); }
        frame.set_call(selected, frame.capability_root_local(), frame.receiver_field_index(), frame.argument_count());
        session.set_continuation(frame_id, frame);
        return check_call_result(session, frame_id);
    }
    auto argument_offsets(compiler_resolver::Session& session, ContinuationRow frame, OperandRole role, i64 first, bool present) -> OperandRow {
        const i64 begin = session.operand_count();
        i64 index = first;
        if (present) {
            while (index < frame.argument_count() && session.good()) {
                const ArgumentLane lane = frame.argument(index);
                i64 offset = 0;
                if ((role == OperandRole::SpanArguments && lane.kind() == ArgumentKind::span)
                    || (role == OperandRole::ObjectArguments && lane.kind() == ArgumentKind::object)
                    || (role == OperandRole::OwnerArguments && (lane.kind() == ArgumentKind::object || (lane.kind() == ArgumentKind::owner && index > 0)))) {
                    offset = local_offset(session, lane.local_id());
                }
                put(session, OperandRole::Offset, offset);
                index = index + 1;
            }
        }
        const OperandRow result = slice(role, begin, session.operand_count() - begin);
        return result;
    }
    auto cleanup_call(compiler_resolver::Session& session, ContinuationRow frame, bool resources) -> bool {
        i64 index = frame.argument_count();
        while (index > 0 && session.good()) {
            index = index - 1;
            const ArgumentLane lane = frame.argument(index);
            if (lane.cleanup_kind() == CleanupKind::service_loan) {
                emit_ReleaseServiceLoan(session, lane.loan_id(), lane.service_kind_id());
                set_exclusive(session, lane.local_id(), false);
            }
            if (lane.cleanup_kind() == CleanupKind::object_loan) {
                emit_ReleaseObjectLoan(session, lane.loan_id());
                if (parameter_const(session, frame.call_target(), 0)) {
                    const LocalRow root = session.local(lane.local_id());
                    const SnapshotRow state = root.state();
                    change_object_loan(session, lane.local_id(), -1, state.object_exclusive());
                } else { change_object_loan(session, lane.local_id(), 0, false); }
            }
            if (resources && lane.cleanup_kind() == CleanupKind::owner) {
                end_owner(session, lane.local_id());
                set_live(session, lane.local_id(), false, false);
            }
        }
        index = 0;
        while (index < frame.argument_count() && session.good()) {
            const ArgumentLane lane = frame.argument(index);
            if (lane.cleanup_kind() == CleanupKind::object) { emit_EndObject(session, local_offset(session, lane.local_id())); }
            index = index + 1;
        }
        index = frame.argument_count();
        while (index > 0 && session.good()) {
            index = index - 1;
            const ArgumentLane lane = frame.argument(index);
            if (lane.cleanup_kind() == CleanupKind::span) { release_span(session, lane.local_id(), true); }
        }
        return session.good();
    }
    auto finish_call(compiler_resolver::Session& session, i64 frame_id) -> bool {
        ContinuationRow frame = session.continuation(frame_id);
        if (intrinsic_method(session, frame)) { return finish_intrinsic_method(session, frame_id); }
        const compiler_resolver::ResolvedRow resolved = session.resolved(frame.syntax_node());
        if (resolved.word(4) >= 0) {
            select_overload(session, frame_id);
            frame = session.continuation(frame_id);
        }
        const i64 callee = frame.call_target();
        const i64 reference = source_ref(session, frame.syntax_node());
        const bool constructor = is_constructor_expression(session, frame.syntax_node());
        const bool method = is_method_expression(session, frame.syntax_node());
        i64 result = signature_result(session, callee);
        if (constructor) { result = nominal_type(session, compiler_resolver::mw(session, callee, 7)); }
        bool resource = false;
        bool service = false;
        bool borrowed = false;
        if (frame.argument_count() > 0) {
            const ArgumentLane first = frame.argument(0);
            resource = value_kind(session, first.concrete_type_id()) == compiler_resolver::ResolvedTypeKind::byte_region;
            service = first.kind() == ArgumentKind::service;
            borrowed = first.kind() == ArgumentKind::borrowed_receiver;
        }
        bool aggregate = value_kind(session, result) == compiler_resolver::ResolvedTypeKind::class_value && !borrowed;
        bool spans = false;
        i64 index = 0;
        while (index < frame.argument_count()) {
            const ArgumentLane lane = frame.argument(index);
            if (lane.kind() == ArgumentKind::object || lane.kind() == ArgumentKind::span) { aggregate = true; }
            if (lane.kind() == ArgumentKind::span) { spans = true; }
            index = index + 1;
        }
        if (method) {
            live_receiver(session, frame);
            if (!method_const(session, callee)) { no_span_borrow(session, frame.capability_root_local(), frame.receiver_field_index(), reference); }
        }
        i64 destination = -1;
        i64 destination_offset = 0;
        if (value_kind(session, result) == compiler_resolver::ResolvedTypeKind::class_value || value_kind(session, result) == compiler_resolver::ResolvedTypeKind::byte_span || is_owner_storage(session, result)) {
            if (resource && frame.scope_head() < 0 && !constructor && !argument_use(session, frame_id) && frame.output_mark() < 0) { return fail(session, LoweringError::resource_result_requires_typed_initializer, reference); }
            if (value_kind(session, result) == compiler_resolver::ResolvedTypeKind::byte_span) {
                const i64 field = session.index(115, callee, 0, 0, 0);
                destination = make_span(session, frame, -1, frame.capability_root_local(), field, false);
            } else {
                i64 owner = -1;
                if (resource && is_resource_owner(session, result)) { owner = frame.capability_root_local(); }
                destination = expression_destination(session, frame, result, owner);
            }
            destination_offset = local_offset(session, destination);
        }
        if (resource) {
            const OperandRow owners = argument_offsets(session, frame, OperandRole::OwnerArguments, 0, true);
            i64 result_offset = destination_offset;
            i64 receiver = 0;
            if (constructor) { receiver = destination_offset; result_offset = 0; }
            emit_ResourceCall(session, callee, local_offset(session, frame.capability_root_local()), owners, result_offset, receiver);
        } else if (service) {
            const OperandRow span_arguments = argument_offsets(session, frame, OperandRole::SpanArguments, 0, true);
            const i64 extra_begin = session.operand_count();
            i64 service_index = 1;
            while (service_index < frame.argument_count()) {
                const ArgumentLane lane = frame.argument(service_index);
                if (lane.kind() == ArgumentKind::service) {
                    put(session, OperandRole::ServiceLoanId, lane.loan_id());
                    put(session, OperandRole::ServiceKindId, lane.service_kind_id());
                }
                service_index = service_index + 1;
            }
            const OperandRow additional = slice(OperandRole::AdditionalServices, extra_begin, session.operand_count() - extra_begin);
            const ArgumentLane first = frame.argument(0);
            const i64 begin = session.operand_count();
            put(session, OperandRole::CalleeSymbolId, callee);
            put(session, OperandRole::LoanId, first.loan_id());
            put(session, OperandRole::ResultOffset, destination_offset);
            session.append_operand(span_arguments);
            put(session, OperandRole::ServiceKindId, first.service_kind_id());
            session.append_operand(additional);
            emit(session, InstructionForm::ServiceCall, begin);
        } else if (method || constructor) {
            // Method packed object slices include zero scalar positions. A
            // constructor has no result offset and receives the pristine object.
            bool packed = false;
            index = 0;
            while (index < frame.argument_count()) {
                const ArgumentLane lane = frame.argument(index);
                if (lane.kind() == ArgumentKind::object || lane.kind() == ArgumentKind::span) { packed = true; }
                index = index + 1;
            }
            const OperandRow objects = argument_offsets(session, frame, OperandRole::ObjectArguments, 0, packed);
            const OperandRow span_arguments = argument_offsets(session, frame, OperandRole::SpanArguments, 0, spans);
            const i64 begin = session.operand_count();
            put(session, OperandRole::CalleeSymbolId, callee);
            i64 receiver = receiver_offset(session, frame);
            i64 result_offset = destination_offset;
            i64 field = frame.receiver_field_index();
            if (constructor) { receiver = destination_offset; result_offset = 0; field = -1; }
            put(session, OperandRole::ReceiverOffset, receiver);
            session.append_operand(objects);
            put(session, OperandRole::ResultOffset, result_offset);
            put(session, OperandRole::ReceiverFieldIndex, field);
            session.append_operand(span_arguments);
            emit(session, InstructionForm::MethodCall, begin);
        } else if (borrowed) {
            const ArgumentLane first = frame.argument(0);
            const OperandRow objects = argument_offsets(session, frame, OperandRole::ObjectArguments, 1, aggregate);
            const OperandRow span_arguments = argument_offsets(session, frame, OperandRole::SpanArguments, 1, spans);
            const i64 begin = session.operand_count();
            put(session, OperandRole::CalleeSymbolId, callee);
            put(session, OperandRole::ReceiverOffset, local_offset(session, first.local_id()));
            put(session, OperandRole::LoanId, first.loan_id());
            session.append_operand(objects);
            put(session, OperandRole::ResultOffset, destination_offset);
            session.append_operand(span_arguments);
            emit(session, InstructionForm::BorrowedCall, begin);
        } else if (aggregate) {
            const OperandRow objects = argument_offsets(session, frame, OperandRole::ObjectArguments, 0, true);
            const OperandRow span_arguments = argument_offsets(session, frame, OperandRole::SpanArguments, 0, true);
            emit_AggregateCall(session, callee, objects, destination_offset, span_arguments);
        } else { emit_Call(session, callee); }
        cleanup_call(session, frame, resource);
        return finish_expression(session, result, destination);
    }
    auto finish_intrinsic_method(compiler_resolver::Session& session, i64 frame_id) -> bool {
        const ContinuationRow frame = session.continuation(frame_id);
        const i64 type = frame.cleanup_cursor();
        const compiler_resolver::ResolvedTypeKind kind = value_kind(session, type);
        const i64 source = source_ref(session, frame.syntax_node());
        const i64 offset = receiver_offset(session, frame);
        const i64 field = frame.receiver_field_index();
        i64 result = scalar_id(session, compiler_resolver::ResolvedTypeKind::bool_value);
        i64 destination = -1;
        if (compiler_resolver::service_kind(kind)) {
            const i64 contract = frame.call_target();
            result = record_signed(session, contract, OperandRole::ResultTypeId);
            i64 result_offset = 0;
            if (value_kind(session, result) == compiler_resolver::ResolvedTypeKind::class_value) {
                destination = expression_destination(session, frame, result, -1);
                result_offset = local_offset(session, destination);
            }
            emit_ServiceOperation(session, offset, record_signed(session, contract, OperandRole::ServiceOperationId), result_offset,
                record_signed(session, contract, OperandRole::ServiceKindId));
        } else if (kind == compiler_resolver::ResolvedTypeKind::byte_region) {
            result = frame.output_mark();
            if (value_kind(session, result) == compiler_resolver::ResolvedTypeKind::owned_values) { owned_element(session, result, frame.operand_mark()); }
            destination = expression_destination(session, frame, result, frame.capability_root_local());
            if (frame.argument_count() == 2) {
                const ArgumentLane fill = frame.argument(1);
                emit_AllocateValues(session, offset, local_offset(session, destination), local_offset(session, fill.local_id()));
                emit_EndObject(session, local_offset(session, fill.local_id()));
            } else { emit_AllocateBytes(session, offset, local_offset(session, destination)); }
        } else if (kind == compiler_resolver::ResolvedTypeKind::byte_span) {
            if (session.source_equal(source, "size")) {
                emit_SpanLength(session, offset);
                result = scalar_id(session, compiler_resolver::ResolvedTypeKind::i64_value);
            } else {
                emit_SpanLoad(session, offset);
                result = scalar_id(session, compiler_resolver::ResolvedTypeKind::u8_value);
            }
        } else if (session.source_equal(source, "ok")) { emit_BytesOk(session, offset, field); }
        else if (session.source_equal(source, "size")) {
            emit_BytesLength(session, offset, field);
            result = scalar_id(session, compiler_resolver::ResolvedTypeKind::i64_value);
        } else {
            live_receiver(session, frame);
            if (kind == compiler_resolver::ResolvedTypeKind::owned_values) {
                if (session.source_equal(source, "at")) {
                    result = compiler_resolver::mw(session, type, 2);
                    destination = expression_destination(session, frame, result, -1);
                    emit_ValuesLoad(session, offset, field, local_offset(session, destination));
                } else {
                    no_span_borrow(session, frame.capability_root_local(), field, source);
                    const ArgumentLane fill = frame.argument(1);
                    if (session.source_equal(source, "set")) { emit_ValuesStore(session, offset, field, local_offset(session, fill.local_id())); }
                    else { emit_ValuesResize(session, offset, field, local_offset(session, fill.local_id())); }
                    emit_EndObject(session, local_offset(session, fill.local_id()));
                }
            } else if (session.source_equal(source, "at")) {
                emit_BytesLoad(session, offset, field);
                result = scalar_id(session, compiler_resolver::ResolvedTypeKind::u8_value);
            } else {
                no_span_borrow(session, frame.capability_root_local(), field, source);
                if (session.source_equal(source, "set")) { emit_BytesStore(session, offset, field); }
                else { emit_BytesResize(session, offset, field); }
            }
        }
        return finish_expression(session, result, destination);
    }
    class IndexedStorage {
        i64 rootId;
        i64 fieldId;
        i64 typeId;
    public:
        IndexedStorage(i64 root, i64 field, i64 type) : rootId(root), fieldId(field), typeId(type) {
        }
        auto root() const -> i64 { return rootId; }
        auto field() const -> i64 { return fieldId; }
        auto type() const -> i64 { return typeId; }
    };
    auto resolve_index(compiler_resolver::Session& session, i64 node) -> IndexedStorage {
        const i64 target = compiler_resolver::sw(session, node, 1);
        const compiler_resolver::SyntaxRow target_row = session.syntax(target);
        const i64 source = source_ref(session, node);
        if (target_row.expression_kind() != compiler_parser::NodeKind::name) {
            fail(session, LoweringError::indexing_requires_local_or_private_receiver_field, source);
            const IndexedStorage invalid = IndexedStorage(-1, -1, -1);
            return invalid;
        }
        const i64 name = source_ref(session, target);
        i64 root = -2;
        i64 field = -1;
        i64 type = -1;
        if (lookup_local(session, name) < 0) { field = implicit_field(session, name); }
        if (field >= 0) { type = field_type(session, body_receiver_nominal(session), field); }
        else {
            root = named_source(session, target);
            type = local_type(session, root);
        }
        if (value_kind(session, type) != compiler_resolver::ResolvedTypeKind::array_value) { fail(session, LoweringError::indexing_requires_local_or_receiver_field, source); }
        const IndexedStorage result = IndexedStorage(root, field, type);
        return result;
    }
    auto index_guard(compiler_resolver::Session& session, IndexedStorage storage) -> bool {
        if (is_class_array(session, storage.type())) {
            i64 offset = 0;
            i64 field = storage.field();
            if (storage.root() >= 0) { offset = local_offset(session, storage.root()); field = 0; }
            emit_ClassArrayBoundsGuard(session, offset, field);
        } else if (storage.field() >= 0) { emit_ReceiverBoundsGuard(session, storage.field()); }
        else { emit_BoundsGuard(session, local_offset(session, storage.root()), compiler_resolver::mw(session, storage.type(), 3), compiler_resolver::mw(session, storage.type(), 2)); }
        return session.good();
    }
    auto begin_index(compiler_resolver::Session& session, i64 frame_id) -> bool {
        ContinuationRow frame = session.continuation(frame_id);
        const IndexedStorage storage = resolve_index(session, frame.syntax_node());
        frame.set_call(-1, storage.root(), storage.field(), 0);
        frame.set_cleanup_cursor(storage.type());
        frame.set_phase(ContinuationPhase::child);
        session.set_continuation(frame_id, frame);
        return push_expression(session, compiler_resolver::sw(session, frame.syntax_node(), 2), -1, -1);
    }
    auto finish_index(compiler_resolver::Session& session, i64 frame_id) -> bool {
        const ContinuationRow frame = session.continuation(frame_id);
        const i64 source = source_ref(session, frame.syntax_node());
        match_type(session, frame.child_type_id(), scalar_id(session, compiler_resolver::ResolvedTypeKind::i64_value), source);
        const IndexedStorage storage = IndexedStorage(frame.capability_root_local(), frame.receiver_field_index(), frame.cleanup_cursor());
        index_guard(session, storage);
        const i64 element = compiler_resolver::mw(session, storage.type(), 2);
        if (is_class_array(session, storage.type())) {
            if (frame.output_mark() < 0) { return fail(session, LoweringError::class_array_copy_requires_typed_initializer, source); }
            match_type(session, element, frame.output_mark(), source);
            const i64 destination = expression_destination(session, frame, element, -1);
            i64 offset = 0;
            i64 field = storage.field();
            if (storage.root() >= 0) { offset = local_offset(session, storage.root()); field = 0; }
            emit_ClassArrayCopy(session, offset, field, local_offset(session, destination));
            return finish_expression(session, element, destination);
        }
        if (frame.output_mark() >= 0 && value_kind(session, frame.output_mark()) == compiler_resolver::ResolvedTypeKind::class_value) { return fail(session, LoweringError::class_projection_requires_copied_array, source); }
        if (storage.field() >= 0) { emit_ReceiverIndexLoad(session, storage.field()); }
        else { emit_IndexLoad(session, local_offset(session, storage.root()), compiler_resolver::mw(session, storage.type(), 3), element); }
        return finish_expression(session, element, -1);
    }
    auto begin_class(compiler_resolver::Session& session, i64 frame_id) -> bool {
        ContinuationRow frame = session.continuation(frame_id);
        const i64 node = frame.syntax_node();
        const i64 type = frame.output_mark();
        const i64 reference = source_ref(session, node);
        const compiler_resolver::SyntaxRow syntax = session.syntax(node);
        const bool argument = argument_use(session, frame_id);
        if (syntax.expression_kind() == compiler_parser::NodeKind::name && lookup_local(session, reference) >= 0) {
            const i64 original = named_source(session, node);
            match_type(session, local_type(session, original), type, reference);
            if (owning_type(session, local_type(session, original))) { return fail(session, LoweringError::owning_class_copy, reference); }
            const i64 destination = expression_destination(session, frame, type, -1);
            emit_CopyObject(session, local_offset(session, original), local_offset(session, destination));
            return finish_expression(session, type, destination);
        }
        if (is_constructor_expression(session, node) || is_method_expression(session, node)) { return begin_call(session, frame_id); }
        if (syntax.expression_kind() == compiler_parser::NodeKind::call) {
            if (owning_type(session, type) && session.source_equal(reference, "move")) {
                const i64 original = moved_source(session, node, type);
                const LocalRow owner = session.local(original);
                const i64 destination = expression_destination(session, frame, type, owner.owner_id());
                emit_move(session, original, destination);
                return finish_expression(session, type, destination);
            }
            const compiler_resolver::ResolvedRow resolved = session.resolved(node);
            if (resolved.word(1) < 0 && resolved.word(4) < 0) {
                if (argument) { return fail(session, LoweringError::class_argument_requires_complete_local, reference); }
                return fail(session, LoweringError::class_initializer_requires_class_result, reference);
            }
            return begin_call(session, frame_id);
        }
        if (argument) { return fail(session, LoweringError::class_argument_requires_complete_local, reference); }
        if (syntax.expression_kind() == compiler_parser::NodeKind::index) { return begin_index(session, frame_id); }
        if (syntax.expression_kind() == compiler_parser::NodeKind::member || syntax.expression_kind() == compiler_parser::NodeKind::name) {
            i64 original = 0;
            i64 field = -1;
            i64 nominal = body_receiver_nominal(session);
            if (syntax.expression_kind() == compiler_parser::NodeKind::member) {
                const compiler_resolver::SyntaxRow target = session.syntax(syntax.word(1));
                if (target.expression_kind() != compiler_parser::NodeKind::name) { return fail(session, LoweringError::class_projection_requires_named_receiver, reference); }
                const i64 local_id = named_source(session, syntax.word(1));
                const LocalRow local = session.local(local_id);
                if (local.borrowed_object()) { return fail(session, LoweringError::borrowed_object_field_projection, reference); }
                original = local.offset();
                nominal = compiler_resolver::mw(session, local.concrete_type_id(), 1);
                field = checked_field(session, local.concrete_type_id(), reference, false);
            } else {
                field = implicit_field(session, reference);
                if (field < 0) { return fail(session, LoweringError::class_projection_requires_class_field, reference); }
            }
            const i64 actual = field_type(session, nominal, field);
            match_type(session, actual, type, reference);
            if (owning_type(session, actual)) { return fail(session, LoweringError::owning_field_extraction, reference); }
            const i64 destination = expression_destination(session, frame, type, -1);
            emit_ObjectFieldCopy(session, original, field, local_offset(session, destination));
            return finish_expression(session, type, destination);
        }
        const i64 nominal = compiler_resolver::mw(session, type, 1);
        if (constructor_symbol(session, nominal) >= 0) { return fail(session, LoweringError::constructor_class_designated_initialization, reference); }
        i64 field = 0;
        while (field < field_total(session, nominal)) {
            if (!field_public(session, nominal, field)) { return fail(session, LoweringError::private_class_construction_requires_constructor, frame.operand_mark()); }
            field = field + 1;
        }
        if (syntax.expression_kind() != compiler_parser::NodeKind::construct) { return fail(session, LoweringError::class_initializer_requires_fields_or_copy, reference); }
        match_type(session, compiler_resolver::rw(session, node, 2), type, reference);
        const i64 first = ordered_first(session, syntax.word(1), 1);
        frame.set_cursor(first);
        frame.set_phase(ContinuationPhase::argument);
        session.set_continuation(frame_id, frame);
        if (first < 0) { return finish_designated(session, frame_id); }
        return advance_designated(session, frame_id);
    }
    auto advance_designated(compiler_resolver::Session& session, i64 frame_id) -> bool {
        const ContinuationRow frame = session.continuation(frame_id);
        const i64 field_source = compiler_resolver::sw(session, frame.cursor(), 4);
        const i64 field = checked_field(session, frame.output_mark(), field_source, true);
        if (session.index(116, body_function(session), frame.syntax_node(), field, 0) >= 0) {
            const OperandRow absent = scalar(OperandRole::NoDiagnosticValue, 0);
            return fail_synthetic(session, LoweringError::duplicate_field_initializer, field_source, absent, absent);
        }
        session.index_insert(116, body_function(session), frame.syntax_node(), field, 0, 0);
        return push_expression(session, compiler_resolver::sw(session, frame.cursor(), 0), -1, -1);
    }
    auto finish_designated(compiler_resolver::Session& session, i64 frame_id) -> bool {
        const ContinuationRow frame = session.continuation(frame_id);
        const i64 type = frame.output_mark();
        const i64 nominal = compiler_resolver::mw(session, type, 1);
        const i64 count = compiler_resolver::sw(session, frame.syntax_node(), 2);
        if (count != field_total(session, nominal)) { return fail(session, LoweringError::incomplete_class_field_initialization, source_ref(session, frame.syntax_node())); }
        const i64 destination = expression_destination(session, frame, type, -1);
        if (count == 0) { emit_InitializeEmptyObject(session, local_offset(session, destination)); }
        i64 edge = compiler_resolver::sw(session, frame.syntax_node(), 1);
        while (edge >= 0 && session.good()) {
            const i64 field_source = compiler_resolver::sw(session, edge, 4);
            const i64 field = checked_field(session, type, field_source, true);
            emit_Pop(session);
            emit_Store(session, local_offset(session, destination) - field_displacement(session, type, field), field_type(session, nominal, field));
            edge = compiler_resolver::sw(session, edge, 1);
        }
        return finish_expression(session, type, destination);
    }
    auto step_designated(compiler_resolver::Session& session, i64 frame_id) -> bool {
        ContinuationRow frame = session.continuation(frame_id);
        const i64 field_source = compiler_resolver::sw(session, frame.cursor(), 4);
        const i64 field = checked_field(session, frame.output_mark(), field_source, true);
        const i64 nominal = compiler_resolver::mw(session, frame.output_mark(), 1);
        const i64 expected = field_type(session, nominal, field);
        if (frame.child_type_id() != expected) {
            const OperandRow wanted = scalar(OperandRole::DiagnosticTypeId, expected);
            const OperandRow got = scalar(OperandRole::DiagnosticTypeId, frame.child_type_id());
            return fail_synthetic(session, LoweringError::type_mismatch, field_source, wanted, got);
        }
        emit_Push(session);
        const i64 last = compiler_resolver::sw(session, frame.syntax_node(), 1);
        frame.set_cursor(ordered_next(session, last, frame.cursor(), 1));
        session.set_continuation(frame_id, frame);
        if (frame.cursor() < 0) { return finish_designated(session, frame_id); }
        return advance_designated(session, frame_id);
    }
}
