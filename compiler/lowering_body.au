                match_type(session, frame.child_type_id(), type, source);
                const LocalRow local = session.local(root);
                i64 offset = local.offset();
                if (field >= 0) {
                    const SnapshotRow state = local.state();
                    if (!state.live()) {
                        return fail(session, LoweringError::field_assignment_consumed_object, source);
                    }
                    no_object_loan(session, root, source);
                    offset = offset - field_displacement(session, local.concrete_type_id(), field);
                }
                const i64 staged_a1_161 = payload_type(session, type);
                emit_Store(session, offset, staged_a1_161);
            }
        }
        return finish_statement(session, false);
    }
    auto constant_leaf(compiler_resolver::Session& session, i64 type, i64 value) -> LiteralValue {
        if (value_kind(session, type) == compiler_resolver::ResolvedTypeKind::bool_value) {
            const LiteralValue result = LiteralValue(type, value, 0u64, true);
            return result;
        }
        const compiler_resolver::ResolvedRow resolved = session.resolved(value);
        if (resolved.operation() == compiler_resolver::ResolvedOperation::enum_case) {
            const LiteralValue result = LiteralValue(type, resolved.word(3), 0u64, true);
            return result;
        }
        const compiler_resolver::SyntaxRow syntax = session.syntax(value);
        if (syntax.expression_kind() == compiler_parser::NodeKind::call) {
            const LiteralValue result = LiteralValue(type, reflected_value(session, value), 0u64, true);
            return result;
        }
        const LiteralValue result = decode_literal(session, value);
        return result;
    }
    auto constant_comparison(compiler_resolver::Session& session, i64 source, LiteralValue left,
        LiteralValue right) -> bool {
        if (value_kind(session, left.type()) == compiler_resolver::ResolvedTypeKind::u64_value) {
            if (session.source_equal(source, "==")) {
                return left.unsigned_value() == right.unsigned_value();
            }
            if (session.source_equal(source, "!=")) {
                return left.unsigned_value() != right.unsigned_value();
            }
            if (session.source_equal(source, "<")) {
                return left.unsigned_value() < right.unsigned_value();
            }
            if (session.source_equal(source, ">")) {
                return left.unsigned_value() > right.unsigned_value();
            }
            if (session.source_equal(source, "<=")) {
                return left.unsigned_value() <= right.unsigned_value();
            }
            return left.unsigned_value() >= right.unsigned_value();
        }
        if (session.source_equal(source, "==")) {
            return left.signed_value() == right.signed_value();
        }
        if (session.source_equal(source, "!=")) {
            return left.signed_value() != right.signed_value();
        }
        if (session.source_equal(source, "<")) {
            return left.signed_value() < right.signed_value();
        }
        if (session.source_equal(source, ">")) {
            return left.signed_value() > right.signed_value();
        }
        if (session.source_equal(source, "<=")) {
            return left.signed_value() <= right.signed_value();
        }
        return left.signed_value() >= right.signed_value();
    }
    auto push_constant(compiler_resolver::Session& session, i64 node) -> bool {
        const ArgumentLane empty = empty_lane();
        ContinuationRow frame = ContinuationRow(ContinuationKind::expression, node, -1, empty);
        frame.set_phase(ContinuationPhase::cleanup);
        frame.set_call(-1, -1, -1, 1);
        return push_frame(session, frame);
    }
    auto evaluate_static_assert(compiler_resolver::Session& session, i64 expression) -> bool {
        // Restricted constant evaluation starts only after the entire ordinary
        // expression has been typed and its lifetime effects checked. Numeric
        // leaves retain source-expression identities; only bool intermediates
        // need a value. No U64 is narrowed or packed into a signed scratch word.
        const i64 base = session.continuation_count();
        push_constant(session, expression);
        while (session.continuation_count() > base && session.good()) {
            const i64 top = session.continuation_count() - 1;
            ContinuationRow frame = session.continuation(top);
            const i64 node = frame.syntax_node();
            const compiler_resolver::SyntaxRow syntax = session.syntax(node);
            const compiler_resolver::ResolvedRow resolved = session.resolved(node);
            const i64 source = source_ref(session, node);
            const i64 boolean = scalar_id(session, compiler_resolver::ResolvedTypeKind::bool_value);
            if (frame.phase() == ContinuationPhase::cleanup) {
                if (syntax.expression_kind() == compiler_parser::NodeKind::literal || resolved.operation()
                    == compiler_resolver::ResolvedOperation::capacity_constant) {
                    const LiteralValue literal = decode_literal(session, node);
                    i64 payload = node;
                    if (literal.type() == boolean) {
                        payload = literal.signed_value();
                    }
                    finish_expression(session, literal.type(), payload);
                } else {
                    if (resolved.operation() == compiler_resolver::ResolvedOperation::enum_case) {
                        finish_expression(session, resolved.word(2), node);
                    } else {
                        if (syntax.expression_kind() == compiler_parser::NodeKind::call && (session.source_equal(source,
                            "size_of") || session.source_equal(source, "type_id") || session.source_equal(source,
                            "field_count"))) {
                            reflected_value(session, node);
                            const i64 staged_type_162 = scalar_id(session,
                                compiler_resolver::ResolvedTypeKind::i64_value);
                            finish_expression(session, staged_type_162, node);
                        } else {
                            if (syntax.expression_kind() == compiler_parser::NodeKind::binary) {
                                frame.set_phase(ContinuationPhase::then_branch);
                                session.set_continuation(top, frame);
                                push_constant(session, syntax.word(1));
                            } else {
                                if (syntax.expression_kind() == compiler_parser::NodeKind::unary
                                    && session.source_equal(source, "!")) {
                                    frame.set_phase(ContinuationPhase::condition);
                                    session.set_continuation(top, frame);
                                    push_constant(session, syntax.word(1));
                                } else {
                                    return fail(session, LoweringError::unsupported_static_assert_expression, source);
                                }
                            }
                        }
                    }
                }
            } else {
                if (frame.phase() == ContinuationPhase::condition) {
                    match_type(session, frame.child_type_id(), boolean, source);
                    i64 value = 0;
                    if (frame.child_local_id() == 0) {
                        value = 1;
                    }
                    finish_expression(session, boolean, value);
                } else {
                    if (frame.phase() == ContinuationPhase::then_branch) {
                        const ArgumentLane left = ArgumentLane(0, ArgumentKind::scalar, frame.child_type_id(),
                            frame.child_local_id(), -1, -1);
                        frame.set_argument(0, left);
                        frame.set_phase(ContinuationPhase::else_after_continuing_then);
                        session.set_continuation(top, frame);
                        push_constant(session, syntax.word(2));
                    } else {
                        const ArgumentLane left_lane = frame.argument(0);
                        const LiteralValue left = constant_leaf(session, left_lane.concrete_type_id(),
                            left_lane.local_id());
                        const LiteralValue right = constant_leaf(session, frame.child_type_id(),
                            frame.child_local_id());
                        match_type(session, right.type(), left.type(), source);
                        bool value = false;
                        if (session.source_equal(source, "&&") || session.source_equal(source, "||")) {
                            match_type(session, left.type(), boolean, source);
                            if (session.source_equal(source, "&&")) {
                                value = left.signed_value() != 0 && right.signed_value() != 0;
                            } else {
                                value = left.signed_value() != 0 || right.signed_value() != 0;
                            }
                        } else {
                            if (!session.source_equal(source, "==") && !session.source_equal(source, "!=")
                                && !session.source_equal(source, "<") && !session.source_equal(source, ">")
                                && !session.source_equal(source, "<=") && !session.source_equal(source, ">=")) {
                                return fail(session, LoweringError::unsupported_static_assert_expression, source);
                            }
                            value = constant_comparison(session, source, left, right);
                        }
                        i64 payload = 0;
                        if (value) {
                            payload = 1;
                        }
                        finish_expression(session, boolean, payload);
                    }
                }
            }
        }
        return session.good();
    }
    auto push_control(compiler_resolver::Session& session, i64 statement, bool loop) -> bool {
        const ArgumentLane empty = empty_lane();
        ContinuationKind kind = ContinuationKind::if_statement;
        if (loop) {
            kind = ContinuationKind::while_statement;
        }
        const ContinuationRow frame = ContinuationRow(kind, statement, -1, empty);
        return push_frame(session, frame);
    }
    auto step_if(compiler_resolver::Session& session, i64 frame_id) -> bool {
        ContinuationRow frame = session.continuation(frame_id);
        const i64 statement = frame.syntax_node();
        const i64 source = source_ref(session, statement);
        if (frame.phase() == ContinuationPhase::start) {
            frame.set_phase(ContinuationPhase::condition);
            session.set_continuation(frame_id, frame);
            const i64 staged_node_163 = compiler_resolver::sw(session, statement, 3);
            return push_expression(session, staged_node_163, -1, -1);
        }
        if (frame.phase() == ContinuationPhase::condition) {
            const i64 staged_want_164 = scalar_id(session, compiler_resolver::ResolvedTypeKind::bool_value);
            match_type(session, frame.child_type_id(), staged_want_164, source);
            const i64 no = body_fresh_label(session);
            const i64 done = body_fresh_label(session);
            emit_BranchFalse(session, no);
            const i64 prefix = session.local_count();
            const i64 incoming = session.capture_locals(prefix);
            frame.set_scope(-1, prefix);
            frame.set_snapshots(incoming, -1);
            frame.set_labels(no, done);
            frame.set_phase(ContinuationPhase::then_branch);
            session.set_continuation(frame_id, frame);
            const i64 staged_syntax_165 = compiler_resolver::sw(session, statement, 7);
            return push_block(session, staged_syntax_165);
        }
        if (frame.phase() == ContinuationPhase::then_branch) {
            const i64 yes = session.capture_locals(frame.local_prefix_length());
            frame.set_snapshots(frame.incoming_snapshot_base(), yes);
            emit_Jump(session, frame.second_label());
            emit_Label(session, frame.first_label());
            session.restore_locals(frame.incoming_snapshot_base(), frame.local_prefix_length());
            if (frame.child_local_id() == 1) {
                frame.set_phase(ContinuationPhase::else_after_returning_then);
            } else {
                frame.set_phase(ContinuationPhase::else_after_continuing_then);
            }
            frame.set_child(-1, 0);
            session.set_continuation(frame_id, frame);
            const i64 other = compiler_resolver::sw(session, statement, 8);
            if (other >= 0) {
                return push_block(session, other);
            }
            return session.good();
        }
        const bool yes_return = frame.phase() == ContinuationPhase::else_after_returning_then;
        const bool no_return = frame.child_local_id() == 1;
        if (no_return && !yes_return) {
            session.restore_locals(frame.then_snapshot_base(), frame.local_prefix_length());
        } else {
            if (!yes_return && !no_return) {
                join_prefix(session, frame.then_snapshot_base(), frame.local_prefix_length(), source, false);
            }
        }
        emit_Label(session, frame.second_label());
        session.truncate_snapshots(frame.incoming_snapshot_base());
        i64 terminal = 0;
        if (yes_return && no_return) {
            terminal = 1;
        }
        return finish_expression(session, -1, terminal);
    }
    auto step_while(compiler_resolver::Session& session, i64 frame_id) -> bool {
        ContinuationRow frame = session.continuation(frame_id);
        const i64 statement = frame.syntax_node();
        const i64 source = source_ref(session, statement);
        if (frame.phase() == ContinuationPhase::start) {
            const i64 start = body_fresh_label(session);
            const i64 done = body_fresh_label(session);
            const i64 prefix = session.local_count();
            const i64 incoming = session.capture_locals(prefix);
            frame.set_scope(-1, prefix);
            frame.set_snapshots(incoming, -1);
            frame.set_labels(start, done);
            frame.set_phase(ContinuationPhase::condition);
            emit_Label(session, start);
            session.set_continuation(frame_id, frame);
            const i64 staged_node_166 = compiler_resolver::sw(session, statement, 3);
            return push_expression(session, staged_node_166, -1, -1);
        }
        if (frame.phase() == ContinuationPhase::condition) {
            const i64 staged_want_167 = scalar_id(session, compiler_resolver::ResolvedTypeKind::bool_value);
            match_type(session, frame.child_type_id(), staged_want_167, source);
            i64 at = 0;
            while (at < frame.local_prefix_length() && session.good()) {
                const LocalRow local = session.local(at);
                const SnapshotRow current = local.state();
                const SnapshotRow incoming = session.snapshot(frame.incoming_snapshot_base() + at);
                if (is_resource_owner(session, local.concrete_type_id()) && current.live() != incoming.live()) {
                    return fail(session, LoweringError::loop_condition_transfers_outer_owner, source);
                }
                at = at + 1;
            }
            emit_BranchFalse(session, frame.second_label());
            frame.set_phase(ContinuationPhase::loop_body);
            session.set_continuation(frame_id, frame);
            const i64 staged_syntax_168 = compiler_resolver::sw(session, statement, 7);
            return push_block(session, staged_syntax_168);
        }
        if (frame.child_local_id() != 1) {
            i64 at = 0;
            while (at < frame.local_prefix_length() && session.good()) {
                const LocalRow local = session.local(at);
                const SnapshotRow current = local.state();
                const SnapshotRow incoming = session.snapshot(frame.incoming_snapshot_base() + at);
                if (current.live() != incoming.live()) {
                    return fail(session, LoweringError::loop_backedge_moves_outer_owner, source);
                }
                if (!same_borrows(current, incoming)) {
                    return fail(session, LoweringError::loop_backedge_borrow_state_mismatch, source);
                }
                at = at + 1;
            }
            emit_Jump(session, frame.first_label());
        }
        session.restore_locals(frame.incoming_snapshot_base(), frame.local_prefix_length());
        session.truncate_snapshots(frame.incoming_snapshot_base());
        emit_Label(session, frame.second_label());
        return finish_expression(session, -1, 0);
    }
    auto step_block(compiler_resolver::Session& session, i64 frame_id) -> bool {
        ContinuationRow frame = session.continuation(frame_id);
        if (frame.phase() == ContinuationPhase::start) {
            const i64 staged_last_169 = compiler_resolver::sw(session, frame.syntax_node(), 7);
            frame.set_cursor(ordered_first(session, staged_last_169, 2));
            frame.set_phase(ContinuationPhase::next_statement);
            session.set_continuation(frame_id, frame);
        }
        if (frame.phase() == ContinuationPhase::next_statement) {
            if (frame.cursor() < 0) {
                const bool terminal = frame.child_local_id() == 1;
                cleanup_scope(session, frame_id, terminal);
                return finish_expression(session, -1, frame.child_local_id());
            }
            if (frame.child_local_id() == 1) {
                const i64 staged_source_170 = source_ref(session, frame.cursor());
                return fail(session, LoweringError::unreachable_statement, staged_source_170);
            }
            const compiler_resolver::SyntaxRow statement = session.syntax(frame.cursor());
            const compiler_parser::SyntaxKind kind = statement.declaration_kind();
            if (kind == compiler_parser::SyntaxKind::local) {
                return begin_local(session, frame_id);
            }
            if (kind == compiler_parser::SyntaxKind::return_value) {
                return begin_return(session, frame_id);
            }
            if (kind == compiler_parser::SyntaxKind::assign || kind == compiler_parser::SyntaxKind::field_assign || kind
                == compiler_parser::SyntaxKind::index_assign) {
                return begin_assignment(session, frame_id);
            }
            if (kind == compiler_parser::SyntaxKind::block || kind == compiler_parser::SyntaxKind::conditional || kind
                == compiler_parser::SyntaxKind::loop) {
                frame.set_phase(ContinuationPhase::then_branch);
                session.set_continuation(frame_id, frame);
                if (kind == compiler_parser::SyntaxKind::block) {
                    return push_block(session, frame.cursor());
                }
                return push_control(session, frame.cursor(), kind == compiler_parser::SyntaxKind::loop);
            }
            frame.set_phase(ContinuationPhase::child);
            if (kind == compiler_parser::SyntaxKind::static_assertion) {
                frame.set_marks(session.output_count(), frame.operand_mark());
            }
            session.set_continuation(frame_id, frame);
            return push_expression(session, statement.word(3), -1, -1);
        }
        if (frame.phase() == ContinuationPhase::then_branch) {
            return finish_statement(session, frame.child_local_id() == 1);
        }
        if (frame.phase() == ContinuationPhase::returning) {
            return emit_return(session, frame_id, frame.child_type_id(), frame.child_local_id());
        }
        const compiler_resolver::SyntaxRow statement = session.syntax(frame.cursor());
        const compiler_parser::SyntaxKind kind = statement.declaration_kind();
        if (kind == compiler_parser::SyntaxKind::assign || kind == compiler_parser::SyntaxKind::field_assign || kind
            == compiler_parser::SyntaxKind::index_assign) {
            return finish_assignment(session, frame_id);
        }
        if (kind == compiler_parser::SyntaxKind::local) {
            const i64 type = local_declared_type(session, frame.cursor());
            const compiler_resolver::ResolvedTypeKind type_kind = value_kind(session, type);
            if (compiler_resolver::scalar_value_kind(type_kind) || type_kind
                == compiler_resolver::ResolvedTypeKind::owner) {
                const i64 staged_want_171 = payload_type(session, type);
                const i64 staged_source_172 = source_ref(session, frame.cursor());
                match_type(session, frame.child_type_id(), staged_want_171, staged_source_172);
                return finish_local_scalar(session, frame_id, -1);
            }
            return finish_statement(session, false);
        }
        if (kind == compiler_parser::SyntaxKind::static_assertion) {
            const i64 staged_want_173 = scalar_id(session, compiler_resolver::ResolvedTypeKind::bool_value);
            const i64 staged_source_174 = source_ref(session, frame.cursor());
            match_type(session, frame.child_type_id(), staged_want_173, staged_source_174);
            evaluate_static_assert(session, statement.word(3));
            const ContinuationRow checked = session.continuation(frame_id);
            i64 at = frame.output_mark();
            while (at < session.output_count() && session.good()) {
                const OutputRow row = session.view_output(at);
                if (row.kind() == RecordKind::Instruction) {
                    session.discard_instruction(at);
                }
                at = at + 1;
            }
            if (checked.child_local_id() == 0) {
                const i64 staged_source_175 = source_ref(session, frame.cursor());
                return fail(session, LoweringError::static_assertion_failed, staged_source_175);
            }
        }
        return finish_statement(session, false);
    }
    auto publish_receiver(compiler_resolver::Session& session, i64 function) -> i64 {
        i64 nominal = compiler_resolver::mw(session, function, 7);
        bool mutable_receiver = false;
        bool constructor = false;
        bool public_access = true;
        if (nominal >= 0) {
            mutable_receiver = !method_const(session, function);
            constructor = compiler_resolver::declaration_kind(session, function)
                == compiler_resolver::DeclarationKind::constructor;
            public_access = method_public(session, function);
        } else {
            bool borrowed_receiver = signature_count(session, function) > 0 && parameter_borrowed(session, function, 0);
            if (borrowed_receiver) {
                const i64 first_type = argument_type(session, function, 0);
                borrowed_receiver = !compiler_resolver::service_kind(value_kind(session, first_type));
            }
            if (borrowed_receiver) {
                const i64 staged_row_176 = argument_type(session, function, 0);
                nominal = compiler_resolver::mw(session, staged_row_176, 1);
                mutable_receiver = !parameter_const(session, function, 0);
            }
        }
        if (nominal < 0) {
            return -1;
        }
        const i64 begin = session.operand_count();
        put(session, OperandRole::ClassNominalId, nominal);
        i64 permission = 0;
        i64 constructor_flag = 0;
        i64 public_flag = 0;
        if (mutable_receiver) {
            permission = 1;
        }
        if (constructor) {
            constructor_flag = 1;
        }
        if (public_access) {
            public_flag = 1;
        }
        put(session, OperandRole::MutableValue, permission);
        put(session, OperandRole::Constructor, constructor_flag);
        put(session, OperandRole::PublicAccess, public_flag);
        return emit_record(session, RecordKind::Receiver, begin);
    }
    auto bind_parameters(compiler_resolver::Session& session, i64 function) -> bool {
        const i64 count = signature_count(session, function);
        const i64 function_source = compiler_resolver::mw(session, function, 4);
        i64 ordinal = 0;
        i64 parameter_index = 0;
        while (ordinal < count && session.good()) {
            const i64 signature = signature_parameter(session, function, ordinal);
            const i64 type = compiler_resolver::mw(session, signature, 1);
            const i64 syntax = compiler_resolver::mw(session, signature, 2);
            const i64 name = compiler_resolver::sw(session, syntax, 6);
            const compiler_resolver::ResolvedTypeKind kind = value_kind(session, type);
            const bool service = compiler_resolver::service_kind(kind);
            const bool alias = parameter_borrowed(session, function, ordinal) && !service;
            bool mutable_value = is_resource_owner(session, type);
            if (alias) {
                mutable_value = !parameter_const(session, function, ordinal);
            }
            const bool begin = kind != compiler_resolver::ResolvedTypeKind::class_value && !is_owner_storage(session,
                type);
            LocalRequest request = LocalRequest(name, type, function_source, mutable_value, true, begin);
            request.set_flags(alias, false);
            if (!alias && is_resource_owner(session, type)) {
                request.set_origin(0, SpanOriginKind::none, -1, -1, false);
            }
            if (kind == compiler_resolver::ResolvedTypeKind::byte_span) {
                request.set_origin(-1, SpanOriginKind::incoming_parameter, -1, -1, false);
            }
            const i64 local = add_local(session, request);
            if (!alias) {
                const i64 offset = local_offset(session, local);
                if (service) {
                    const i64 staged_a2_177 = service_type_id(session, type);
                    emit_BindServiceParameter(session, parameter_index, offset, staged_a2_177);
                } else {
                    if (kind == compiler_resolver::ResolvedTypeKind::byte_region) {
                        emit_BindRegionParameter(session, parameter_index, offset);
                    } else {
                        if (is_owner_storage(session, type)) {
                            emit_BindBytesParameter(session, parameter_index, offset);
                        } else {
                            if (kind == compiler_resolver::ResolvedTypeKind::byte_span) {
                                emit_BindSpanParameter(session, parameter_index, offset);
                            } else {
                                if (owning_type(session, type)) {
                                    const i64 staged_a2_178 = compiler_resolver::mw(session, type, 1);
                                    emit_BindOwnedObjectParameter(session, parameter_index, offset, staged_a2_178);
                                } else {
                                    if (kind == compiler_resolver::ResolvedTypeKind::class_value) {
                                        const i64 staged_a2_179 = compiler_resolver::mw(session, type, 1);
                                        emit_BindObjectParameter(session, parameter_index, offset, staged_a2_179);
                                    } else {
                                        emit_BindParameter(session, parameter_index, offset, type);
                                    }
                                }
                            }
                        }
                    }
                }
                parameter_index = parameter_index + 1;
            }
            ordinal = ordinal + 1;
        }
        return session.good();
    }
    auto prepare_constructor(compiler_resolver::Session& session, i64 function) -> bool {
        const i64 nominal = compiler_resolver::mw(session, function, 7);
        const i64 syntax = compiler_resolver::mw(session, function, 5);
        const i64 last = compiler_resolver::sw(session, syntax, 7);
        i64 edge = ordered_first(session, last, 2);
        i64 count = 0;
        while (edge >= 0 && session.good()) {
            const i64 source = source_ref(session, edge);
            const i64 field = field_index(session, nominal, source);
            if (field < 0) {
                return fail(session, LoweringError::unknown_constructor_field_initializer, source);
            }
            if (session.index(118, function, field, 0, 0) >= 0) {
                return fail(session, LoweringError::duplicate_constructor_field_initializer, source);
            }
            session.index_insert(118, function, field, 0, 0, compiler_resolver::sw(session, edge, 3));
            count = count + 1;
            edge = ordered_next(session, last, edge, 2);
        }
        if (count != field_total(session, nominal)) {
            const i64 staged_source_180 = compiler_resolver::mw(session, function, 4);
            return fail(session, LoweringError::incomplete_constructor_field_initialization, staged_source_180);
        }
        ContinuationRow root = session.continuation(0);
        root.set_cursor(0);
        root.set_phase(ContinuationPhase::next_statement);
        return session.set_continuation(0, root);
    }
    auto finish_constructor_field(compiler_resolver::Session& session, i64 local) -> bool {
        ContinuationRow root = session.continuation(0);
        const i64 nominal = compiler_resolver::mw(session, root.syntax_node(), 7);
        const i64 type = field_type(session, nominal, root.cursor());
        const i64 expression = session.index(118, root.syntax_node(), root.cursor(), 0, 0);
        if (is_owner_storage(session, type)) {
            const LocalRow value = session.local(local);
            if (value.owner_id() != 0) {
                const i64 staged_source_181 = source_ref(session, expression);
                return fail(session, LoweringError::constructor_byte_field_region_mismatch, staged_source_181);
            }
            emit_InitializeBytesField(session, 0, root.cursor(), value.offset());
            const SnapshotRow state = value.state();
            set_live(session, local, false, state.resource_active());
        } else {
            const i64 staged_source_182 = field_source(session, nominal, root.cursor());
            match_type(session, root.child_type_id(), type, staged_source_182);
            emit_ReceiverStore(session, root.cursor(), type);
        }
        root.set_cursor(root.cursor() + 1);
        root.set_phase(ContinuationPhase::next_statement);
        return session.set_continuation(0, root);
    }
    auto step_constructor(compiler_resolver::Session& session) -> bool {
        ContinuationRow root = session.continuation(0);
        if (root.phase() == ContinuationPhase::child) {
            return finish_constructor_field(session, root.child_local_id());
        }
        const i64 nominal = compiler_resolver::mw(session, root.syntax_node(), 7);
        if (root.cursor() == field_total(session, nominal)) {
            const i64 staged_type_183 = scalar_id(session, compiler_resolver::ResolvedTypeKind::i64_value);
            emit_signed(session, 0, staged_type_183);
            return_owners(session, -1);
            emit_Return(session);
            root.set_phase(ContinuationPhase::cleanup);
            return session.set_continuation(0, root);
        }
        const i64 field = root.cursor();
        const i64 type = field_type(session, nominal, field);
        const i64 node = session.index(118, root.syntax_node(), field, 0, 0);
        const compiler_resolver::SyntaxRow syntax = session.syntax(node);
        const compiler_resolver::ResolvedTypeKind kind = value_kind(session, type);
        if (is_owner_storage(session, type)) {
            if (syntax.expression_kind() == compiler_parser::NodeKind::call && expression_spelling(session, node,
                "move")) {
                const i64 original = moved_source(session, node, type);
                return finish_constructor_field(session, original);
            }
            root.set_phase(ContinuationPhase::child);
            session.set_continuation(0, root);
            return push_expression(session, node, type, -1);
        }
        if (kind == compiler_resolver::ResolvedTypeKind::class_value) {
            if (syntax.expression_kind() != compiler_parser::NodeKind::name) {
                const i64 staged_source_184 = source_ref(session, node);
                return fail(session, LoweringError::class_field_initializer_requires_complete_local, staged_source_184);
            }
            const i64 original = named_source(session, node);
            const i64 staged_got_185 = local_type(session, original);
            const i64 staged_source_186 = source_ref(session, node);
            match_type(session, staged_got_185, type, staged_source_186);
            const i64 staged_a2_187 = local_offset(session, original);
            emit_InitializeObjectField(session, 0, field, staged_a2_187);
        } else {
            if (is_class_array(session, type)) {
                const OperandRow sources = class_array_sources(session, node, type);
                emit_InitializeClassArray(session, 0, field, sources);
            } else {
                if (kind == compiler_resolver::ResolvedTypeKind::array_value) {
                    if (syntax.expression_kind() != compiler_parser::NodeKind::array_zero) {
                        const i64 staged_source_188 = field_source(session, nominal, field);
                        return fail(session, LoweringError::array_field_requires_empty_initialization,
                            staged_source_188);
                    }
                    emit_ReceiverArrayZero(session, field);
                } else {
                    if (syntax.expression_kind() == compiler_parser::NodeKind::array_zero) {
                        const i64 staged_source_189 = field_source(session, nominal, field);
                        return fail(session, LoweringError::empty_initialization_requires_array_field,
                            staged_source_189);
                    }
                    root.set_phase(ContinuationPhase::child);
                    session.set_continuation(0, root);
                    return push_expression(session, node, -1, -1);
                }
            }
        }
        root.set_cursor(field + 1);
        return session.set_continuation(0, root);
    }
    auto function_lint_enabled(compiler_resolver::Session& session, i64 function, bool mode) -> bool {
        if (!mode) {
            return false;
        }
        const i64 unit = compiler_resolver::mw(session, function, 1);
        if (compiler_resolver::mw(session, unit, 13) != 0 || compiler_resolver::mw(session, function, 9) >= 0
            || compiler_resolver::declaration_kind(session, function)
            == compiler_resolver::DeclarationKind::constructor) {
            return false;
        }
        const i64 receiver = compiler_resolver::mw(session, function, 7);
        return receiver < 0 || compiler_resolver::mw(session, receiver, 9) < 0;
    }
    auto function_slot_kind(RecordKind kind) -> bool {
        return kind == RecordKind::ScalarSlot || kind == RecordKind::ObjectSlot || kind == RecordKind::ArraySlot || kind
            == RecordKind::SpanSlot || kind == RecordKind::ServiceSlot || kind == RecordKind::RegionSlot || kind
            == RecordKind::ByteSlot || kind == RecordKind::OwnedValueType;
    }
    auto publish_function(compiler_resolver::Session& session, i64 receiver) -> i64 {
        const ContinuationRow root = session.continuation(0);
        const i64 function = root.syntax_node();
        const i64 output_end = session.output_count();
        const i64 parameter_begin = session.operand_count();
        i64 parameter = 0;
        i64 parameter_count = 0;
        bool borrowed = false;
        while (parameter < signature_count(session, function) && session.good()) {
            const i64 type = argument_type(session, function, parameter);
            if (parameter_borrowed(session, function, parameter) && !compiler_resolver::service_kind(value_kind(session,
                type))) {
                borrowed = true;
            } else {
                put(session, OperandRole::TypeId, type);
                parameter_count = parameter_count + 1;
            }
            parameter = parameter + 1;
        }
        const i64 slots_begin = session.operand_count();
        i64 slot_count = 0;
        i64 at = root.output_mark();
        while (at < output_end && session.good()) {
            const OutputRow row = session.view_output(at);
            if (function_slot_kind(row.kind())) {
                put(session, OperandRole::OutputRowId, at);
                slot_count = slot_count + 1;
            }
            at = at + 1;
        }
        // One forward interval scan finalizes Code. Discarded static_assert
        // instructions remain owned/charged records but are never published.
        const i64 code_begin = session.operand_count();
        i64 code_count = 0;
        at = root.output_mark();
        while (at < output_end && session.good()) {
            const OutputRow row = session.view_output(at);
            if (row.kind() == RecordKind::Instruction) {
                put(session, OperandRole::OutputRowId, at);
                code_count = code_count + 1;
            }
            at = at + 1;
        }
        const i64 begin = session.operand_count();
        put(session, OperandRole::FunctionSymbolId, function);
        const i64 staged_row_190 = compiler_resolver::mw(session, function, 1);
        const i64 staged_value_191 = compiler_resolver::mw(session, staged_row_190, 13);
        put(session, OperandRole::ModuleScope, staged_value_191);
        put(session, OperandRole::ResultTypeId, root.then_snapshot_base());
        put_slice(session, OperandRole::ParameterTypes, parameter_begin, parameter_count);
        put_slice(session, OperandRole::Slots, slots_begin, slot_count);
        if (receiver >= 0) {
            put(session, OperandRole::ReceiverRef, receiver);
        } else {
            put(session, OperandRole::NoReceiver, 0);
        }
        i64 borrowed_flag = 0;
        if (borrowed) {
            borrowed_flag = 1;
        }
        put(session, OperandRole::BorrowedParameter, borrowed_flag);
        if (root.second_label() >= 0) {
            put(session, OperandRole::ReceiverSpanField, root.second_label());
        } else {
            put(session, OperandRole::NoReceiverSpan, 0);
        }
        put(session, OperandRole::FrameBytes,((root.local_prefix_length() * 8 + 15) / 16) * 16);
        put_slice(session, OperandRole::Code, code_begin, code_count);
        const i64 result = emit_record(session, RecordKind::Function, begin);
        at = 0;
        while (at < session.local_count() && session.good()) {
            const LocalRow local = session.local(at);
            if (local.lint_eligible() && !local.was_read()) {
                const i64 lint_begin = session.operand_count();
                put(session, OperandRole::IdentifierSourceRef, local.name_source_id());
                emit_record(session, RecordKind::UnreadLocal, lint_begin);
            }
            at = at + 1;
        }
        return result;
    }
    class FunctionBodyResult {
        i64 functionRow;
        i64 nextLabel;
    public:
        FunctionBodyResult(i64 row, i64 label) : functionRow(row), nextLabel(label) {
        }
        auto function_row() const -> i64 {
            return functionRow;
        }
        auto next_label() const -> i64 {
            return nextLabel;
        }
    };
    auto lower_function_body(compiler_resolver::Session& session, i64 function, i64 next_label,
        bool lint_mode) -> FunctionBodyResult {
        if (!session.good() || session.continuation_count() != 0 || session.snapshot_count() != 0
            || session.local_count() != 0) {
            session.fail_storage(compiler_resolver::StorageStatus::invalid);
            const FunctionBodyResult invalid = FunctionBodyResult(-1, next_label);
            return invalid;
        }
        const ArgumentLane empty = empty_lane();
        ContinuationRow root = ContinuationRow(ContinuationKind::function, function, -1, empty);
        root.set_scope(-1, 0);
        root.set_snapshots(1, signature_result(session, function));
        root.set_labels(next_label, -1);
        i64 lint = 0;
        if (function_lint_enabled(session, function, lint_mode)) {
            lint = 1;
        }
        root.set_marks(session.output_count(), lint);
        push_frame(session, root);
        const i64 receiver = publish_receiver(session, function);
        bind_parameters(session, function);
        const bool constructor = compiler_resolver::declaration_kind(session, function)
            == compiler_resolver::DeclarationKind::constructor;
        if (constructor) {
            prepare_constructor(session, function);
        } else {
            ContinuationRow body_root = session.continuation(0);
            body_root.set_phase(ContinuationPhase::child);
            session.set_continuation(0, body_root);
            const i64 staged_row_192 = compiler_resolver::mw(session, function, 5);
            const i64 staged_syntax_193 = compiler_resolver::sw(session, staged_row_192, 7);
            push_block(session, staged_syntax_193);
        }
        bool complete = false;
        while (session.good() && !complete) {
            const i64 top = session.continuation_count() - 1;
            const ContinuationRow frame = session.continuation(top);
            if (frame.kind() == ContinuationKind::expression) {
                step_expression(session, top);
            } else {
                if (frame.kind() == ContinuationKind::block) {
                    step_block(session, top);
                } else {
                    if (frame.kind() == ContinuationKind::if_statement) {
                        step_if(session, top);
                    } else {
                        if (frame.kind() == ContinuationKind::while_statement) {
                            step_while(session, top);
                        } else {
                            if (frame.kind() == ContinuationKind::function && top == 0) {
                                if (constructor && frame.phase() != ContinuationPhase::cleanup) {
                                    step_constructor(session);
                                } else {
                                    if (!constructor && frame.child_local_id() != 1) {
                                        const i64 staged_source_194 = compiler_resolver::mw(session, function, 4);
                                        fail(session, LoweringError::missing_return_path, staged_source_194);
                                    }
                                    complete = true;
                                }
                            } else {
                                session.fail_storage(compiler_resolver::StorageStatus::invalid);
                            }
                        }
                    }
                }
            }
        }
        i64 row = -1;
        i64 final_label = next_label;
        if (session.good()) {
            const ContinuationRow completed_root = session.continuation(0);
            if (value_kind(session, completed_root.then_snapshot_base())
                == compiler_resolver::ResolvedTypeKind::byte_span) {
                if (completed_root.second_label() < 0) {
                    const i64 staged_source_195 = compiler_resolver::mw(session, function, 4);
                    fail(session, LoweringError::span_method_missing_field_return, staged_source_195);
                } else {
                    session.index_insert(115, function, 0, 0, 0, completed_root.second_label());
                }
            }
            row = publish_function(session, receiver);
            final_label = completed_root.first_label();
            session.truncate_continuations(0);
            session.truncate_snapshots(0);
            session.reset_lowering_locals();
        }
        const FunctionBodyResult result = FunctionBodyResult(row, final_label);
        return result;
    }
}
