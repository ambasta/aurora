            return push_expression(session, staged_node_28, -1, -1);
        }
        const i64 parent_id = frame.capability_root_local();
        const LocalRow parent = session.local(parent_id);
        const i64 parent_node = expression_argument(session, frame.syntax_node(), 0);
        const compiler_resolver::SyntaxRow parent_syntax = session.syntax(parent_node);
        const bool temporary = parent_syntax.expression_kind() != compiler_parser::NodeKind::name;
        const i64 destination = make_span(session, frame, parent_id, span_origin_root(parent),
            parent.span_field_index(), temporary);
