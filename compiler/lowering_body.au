            return push_expression(session, staged_node_26, -1, -1);
        }
        const i64 staged_want_27 = scalar_id(session, compiler_resolver::ResolvedTypeKind::i64_value);
        match_type(session, frame.child_type_id(), staged_want_27, reference);
        if (frame.next_argument() == 0) {
