    class IndexedStorage {
        i64 rootId;
        i64 fieldId;
        i64 typeId;
    public:
        IndexedStorage(i64 root, i64 field, i64 type) : rootId(root), fieldId(field), typeId(type) {
        }
        auto root() const -> i64 {
            return rootId;
        }
        auto field() const -> i64 {
            return fieldId;
