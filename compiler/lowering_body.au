            }
            const i64 target = expression_argument(session, node, 0);
            const compiler_resolver::SyntaxRow target_row = session.syntax(target);
            if (target_row.expression_kind() == compiler_parser::NodeKind::name) {
                const i64 parent = named_source(session, target);
                const i64 staged_type_23 = local_type(session, parent);
                if (value_kind(session, staged_type_23) != compiler_resolver::ResolvedTypeKind::byte_span) {
                    return fail(session, LoweringError::subspan_requires_live_readonly_view, reference);
                }
