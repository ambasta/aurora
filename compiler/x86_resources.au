export module aurora.compiler.x86_resources;
import aurora.compiler.x86_storage;
import aurora.compiler.x86_helpers;
import aurora.compiler.ir_instruction_storage;
import aurora.compiler.ir_instructions;
import aurora.compiler.ir_metadata_storage;
import aurora.compiler.ir_metadata;

// Resource and span lowering consumes the admitted stores directly. Descriptor
// transfers retain the old backend's instruction order, scalar preservation and
// call-alignment accounting; no serialized instruction stream is reconstructed.
export namespace compiler_x86 {
    auto resource_pop_argument(EmitWorkspace& w, i64 index) -> bool {
        if (index == 0) {
            return w.pop("%rdi");
        }
        if (index == 1) {
            return w.pop("%rsi");
        }
        if (index == 2) {
            return w.pop("%rdx");
        }
        if (index == 3) {
            return w.pop("%rcx");
        }
        if (index == 4) {
            return w.pop("%r8");
        }
        if (index == 5) {
            return w.pop("%r9");
        }
        return w.fail();
    }
    auto resource_target(const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 instruction) -> i64 {
        const compiler_ir_instructions::RawOperandRow operand = compiler_ir_instructions::call_operand(s, instruction,
            0);
        const compiler_ir_metadata::ByteRange name = compiler_ir_metadata::ByteRange(operand.begin(), operand.count());
        return compiler_ir_metadata::first_named_callable(m, name);
    }
    auto resource_receiver(const compiler_ir_metadata::MetadataStore& m, i64 callable) -> bool {
        const compiler_ir_metadata::CallableRow row = m.callable_at(callable);
        const compiler_ir_metadata::FlagMasks masks = compiler_ir_metadata::FlagMasks();
        return compiler_ir_metadata::callable_flag(row, masks.callable_receiver());
    }
    auto resource_array_length(const compiler_ir_metadata::MetadataStore& m, i64 callable, i64 offset) -> i64 {
        const i64 index = compiler_ir_instructions::entry_slot(m, callable, 12, offset);
        const compiler_ir_metadata::SlotRow slot = m.slot_at(index);
        return slot.length();
    }
    auto resource_owner_kind(const compiler_ir_metadata::MetadataStore& m, i64 callable, i64 offset, i64 field) -> i64 {
        const i64 type = owner_storage_type(m, callable, offset, field);
        if (type < 0) {
            return 13;
        }
        return type_kind(m, type);
    }
    auto pack_resources(EmitWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 instruction, i64 target) -> i64 {
        const i64 count = parameter_count(m, target);
        i64 index = count;
        while (index > 1) {
            const i64 type = parameter_type(m, target, index - 1);
            const i64 kind = type_kind(m, type);
            if (kind != 13 && kind != 17 && kind != 5) {
                resource_pop_argument(w, index - 1);
            }
            index = index - 1;
        }
        const i64 record_bytes =((record_offset(m, target, count) + 15) / 16) * 16;
        w.reserve_stack(record_bytes);
        const i64 packed_address54 = w.pack_address(1, 0);
        clear_bytes(w, 0, record_bytes, packed_address54);
        // Scalar argument registers are saved before descriptor copies reuse
        // RAX/RCX. The region root always occupies the first complete word.
        index = 1;
        while (index < count) {
            const i64 type = parameter_type(m, target, index);
            const i64 kind = type_kind(m, type);
            if (kind != 13 && kind != 17 && kind != 5) {
                const i64 packed_address55 = w.pack_address(1, record_offset(m, target, index));
                store_argument(w, m, type, index, packed_address55);
            }
            index = index + 1;
        }
        const i64 region = operand_value(s, instruction, 1);
        w.line_address("movq ", region, ", %rax");
        w.line("movq %rax, (%rsp)");
        index = 1;
        while (index < count) {
            const i64 type = parameter_type(m, target, index);
            const i64 kind = type_kind(m, type);
            if (kind == 13 || kind == 17) {
                const i64 source = operand_lane(s, instruction, 2, index);
                const i64 destination = record_offset(m, target, index);
                i64 byte = 0;
                while (byte < 32) {
                    w.line_address("movq ", source - byte, ", %rax");
                    w.line_number("movq %rax, ", destination + byte, "(%rsp)");
                    byte = byte + 8;
                }
                clear_bytes_owner(w, source);
            } else {
                if (kind == 5) {
                    const i64 source = operand_lane(s, instruction, 2, index);
                    const i64 destination = record_offset(m, target, index);
                    const i64 packed_address56 = w.pack_address(0, source);
                    const i64 packed_address57 = w.pack_address(1, destination);
                    transfer_object(w, m, type_class(m, type), packed_address56, packed_address57);
                }
            }
            index = index + 1;
        }
        w.line("movq %rsp, %r11");
        return record_bytes;
    }
    auto resource_return_jump(EmitWorkspace& w) -> bool {
        w.line("xorq %rax, %rax");
        w.begin_line();
        w.text("jmp ");
        w.return_label();
        return w.end_line();
    }
    auto resource_span_label(EmitWorkspace& w, i64 function, i64 division, bool done) -> bool {
        if (done) {
            w.text(".Lspan_done_");
        } else {
            w.text(".Lspan_array_");
        }
        w.number(function);
        w.text("_");
        return w.number(division);
    }
    auto emit_spans(EmitWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 instruction) -> bool {
        const compiler_ir_instructions::RawInstructionRow row = s.instruction_at(instruction);
        const i64 form = row.form();
        const i64 callable = w.current_callable();
        if (form == 47 || form == 48 || form == 56) {
            // BeginArray, EndArray and EndSpan change static lifetimes only.
            return true;
        }
        if (form == 49 || form == 50 || form == 51) {
            const i64 source = operand_value(s, instruction, 0);
            const i64 result = operand_value(s, instruction, 1);
            i64 length = 0;
            w.line_address("movq $0, ", result, "");
            if (form == 49) {
                w.line_address("leaq ", source, ", %rcx");
                length = resource_array_length(m, callable, source);
            } else {
                if (form == 50) {
                    const i64 receiver = receiver_class(m, callable);
                    const i64 byte = class_field_offset(m, receiver, source);
                    const i64 save = w.receiver_save();
                    w.line_address("movq ", save, ", %rcx");
                    w.line_number("leaq ", byte, "(%rcx), %rcx");
                    length = class_field_length(m, receiver, source);
                } else {
                    w.line_number("leaq .Laurora_literal_", instruction, "(%rip), %rcx");
                    length = operand_count(s, instruction, 0);
                }
            }
            w.line_address("movq %rcx, ", result - 8, "");
            i64 byte = 16;
            while (byte <= 40) {
                w.line_address("movq $0, ", result - byte, "");
                byte = byte + 8;
            }
            w.begin_line();
            w.text("movq $");
            w.number(length);
            w.text(", ");
            w.address(result - 48);
            w.end_line();
            return true;
        }
        if (form == 52) {
            const i64 offset = operand_value(s, instruction, 0);
            const i64 field = operand_value(s, instruction, 1);
            const i64 result = operand_value(s, instruction, 2);
            // Runtime borrow validation preserves the unrelated current scalar
            // and every operand, including their original stack parity.
            w.push();
            const i64 owner = bytes_owner_address(w, m, offset, field, 0);
            w.begin_line();
            w.text("leaq ");
            w.memory(owner);
            w.text(", %rdi");
            w.end_line();
            w.begin_line();
            w.text("leaq ");
            w.address(result);
            w.text(", %rsi");
            w.end_line();
            w.call_runtime("__au_runtime_bytes_borrow_span");
            const i64 stride = span_element_stride(m, callable, result);
            if (stride > 0) {
                // The runtime reports the owner's byte length; a typed owner's
                // length is always a whole number of elements.
                w.line_address("movq ", result - 48, ", %rax");
                divide_by_stride(w, stride);
                w.line_address("movq %rax, ", result - 48, "");
            }
            w.pop("%rax");
            return true;
        }
        if (form == 53) {
            const i64 offset = operand_value(s, instruction, 0);
            const i64 save = w.result_save();
            w.line_address("movq ", save, ", %r10");
            i64 byte = 0;
            while (byte < 56) {
                w.line_address("movq ", offset - byte, ", %rcx");
                w.line_number("movq %rcx, ", byte, "(%r10)");
                byte = byte + 8;
            }
            resource_return_jump(w);
            return true;
        }
        if (form == 54 || form == 55) {
            const i64 source = operand_value(s, instruction, 0);
            const i64 result = operand_value(s, instruction, 1);
            if (form == 55) {
                w.pop("%rcx");
                w.line_address("movq ", source - 48, ", %rdx");
                w.line("cmpq %rdx, %rcx");
                w.line("ja .Laurora_bounds_trap");
                w.line("subq %rcx, %rdx");
                w.line("cmpq %rdx, %rax");
                w.line("ja .Laurora_bounds_trap");
            }
            i64 byte = 0;
            while (byte < 56) {
                if (form == 54) {
                    w.line_address("movq ", source - byte, ", %rcx");
                    w.line_address("movq %rcx, ", result - byte, "");
                } else {
                    w.line_address("movq ", source - byte, ", %rdx");
                    w.line_address("movq %rdx, ", result - byte, "");
                }
                byte = byte + 8;
            }
            if (form == 55) {
                w.line_address("addq ", source - 40, ", %rcx");
                w.line_address("movq %rcx, ", result - 40, "");
                w.line_address("movq %rax, ", result - 48, "");
            }
            return true;
        }
        if (form == 57) {
            w.line_address("movq ", operand_value(s, instruction, 0) - 48, ", %rax");
            return true;
        }
        if (form == 58) {
            const i64 offset = operand_value(s, instruction, 0);
            w.line_address("cmpq ", offset - 48, ", %rax");
            w.line("jae .Laurora_bounds_trap");
            w.line_address("addq ", offset - 40, ", %rax");
            const i64 function = w.function_index();
            // The old backend consumes the label ordinal even when the module
            // contains no owners and the runtime branch is omitted.
            const i64 division = w.next_division();
            const bool owned = w.owned_span_runtime();
            if (owned) {
                w.line_address("cmpq $0, ", offset, "");
                w.begin_line();
                w.text("je ");
                resource_span_label(w, function, division, false);
                w.end_line();
                w.line_address("cmpq $1, ", offset, "");
                w.line("jne .Laurora_bounds_trap");
                w.line("movq %rax, %rsi");
                w.line_address("leaq ", offset - 8, ", %rdi");
                w.call_runtime("__au_runtime_bytes_at");
                w.begin_line();
                w.text("jmp ");
                resource_span_label(w, function, division, true);
                w.end_line();
                resource_span_label(w, function, division, false);
                w.text(":\n");
            }
            w.line_address("movq ", offset - 8, ", %rcx");
            w.line("movzbq (%rcx,%rax,1), %rax");
            if (owned) {
                resource_span_label(w, function, division, true);
                w.text(":\n");
            }
            return true;
        }
        if (form == 84) {
            const i64 offset = operand_value(s, instruction, 0);
            const i64 value = operand_value(s, instruction, 1);
            const i64 stride = span_element_stride(m, callable, offset);
            if (stride < 1) {
                return w.fail();
            }
            w.line_address("cmpq ", offset - 48, ", %rax");
            w.line("jae .Laurora_bounds_trap");
            w.line_address("addq ", offset - 40, ", %rax");
            const i64 function = w.function_index();
            const i64 division = w.next_division();
            // Kind 1 is a kernel owner snapshot read through the checked runtime;
            // kind 0 is contiguous payload, copied whole like the runtime's copy.
            // As for byte loads, a graph without owners has only kind-0 views.
            const bool owned = w.owned_span_runtime();
            if (owned) {
                w.line_address("cmpq $0, ", offset, "");
                w.begin_line();
                w.text("je ");
                resource_span_label(w, function, division, false);
                w.end_line();
                w.line_address("cmpq $1, ", offset, "");
                w.line("jne .Laurora_bounds_trap");
                w.line("movq %rax, %rsi");
                w.line_address("leaq ", offset - 8, ", %rdi");
                w.line_number("movq $", stride, ", %rdx");
                w.line_address("leaq ", value, ", %rcx");
                w.call_runtime("__au_runtime_values_at");
                w.begin_line();
                w.text("jmp ");
                resource_span_label(w, function, division, true);
                w.end_line();
                resource_span_label(w, function, division, false);
                w.text(":\n");
            }
            w.line_number("imulq $", stride, ", %rax, %rsi");
            w.line_address("addq ", offset - 8, ", %rsi");
            w.line_address("leaq ", value, ", %rdi");
            w.line_number("movq $", stride, ", %rcx");
            w.line("cld");
            w.line("rep movsb");
            if (owned) {
                resource_span_label(w, function, division, true);
                w.text(":\n");
            }
            return w.ok();
        }
        if (form == 59) {
            const i64 index = operand_value(s, instruction, 0);
            const i64 offset = operand_value(s, instruction, 1);
            const i64 save = w.call_record_save();
            w.line_address("movq ", save, ", %r11");
            const i64 source = record_offset(m, callable, index);
            i64 byte = 0;
            while (byte < 56) {
                w.line_number("movq ", source + byte, "(%r11), %rax");
                w.line_address("movq %rax, ", offset - byte, "");
                byte = byte + 8;
            }
            return true;
        }
        return false;
    }
    // An owned-value index is in bounds when (index + 1) * stride fits within the
    // byte length; a product beyond 64 bits exceeds every length. This is the
    // unsigned index < length / stride test without a division. The index stays
    // in %rsi; %rax and %rdx are clobbered, as the division clobbered them.
    auto values_bounds_check(EmitWorkspace& w, i64 length, i64 stride) -> bool {
        w.line_number("movq $", stride, ", %rax");
        w.line("mulq %rsi");
        w.line("jc .Laurora_bounds_trap");
        w.line_number("addq $", stride, ", %rax");
        w.line("jc .Laurora_bounds_trap");
        w.begin_line();
        w.text("cmpq ");
        w.memory(length);
        w.text(", %rax");
        w.end_line();
        return w.line("ja .Laurora_bounds_trap");
    }
    // Unsigned %rax / stride for a constant stride: a shift for powers of two,
    // otherwise Granlund-Montgomery multiplication by a 65-bit reciprocal with the
    // add-and-shift fixup, exact for every 64-bit dividend. Clobbers %rcx and %rdx.
    auto divide_by_stride(EmitWorkspace& w, i64 stride) -> bool {
        if (stride < 1 || stride > 1073741824) {
            w.line_number("movq $", stride, ", %rcx");
            w.line("xorq %rdx, %rdx");
            return w.line("divq %rcx");
        }
        i64 power = 1;
        i64 shift = 0;
        while (power < stride) {
            power = power * 2;
            shift = shift + 1;
        }
        if (power == stride) {
            if (shift != 0) {
                w.line_number("shrq $", shift, ", %rax");
            }
            return w.ok();
        }
        // floor(2^64 * (power - stride) / stride) + 1, by long division in 32-bit
        // digits; power - stride < stride < 2^30, so no step overflows.
        const u64 divisor = u64(stride);
        const u64 scaled = u64(power - stride) * 4294967296u64;
        const u64 high = scaled / divisor;
        const u64 low = (scaled % divisor) * 4294967296u64 / divisor;
        const u64 magic = high * 4294967296u64 + low + 1u64;
        w.line("movq %rax, %rcx");
        w.text("    movabsq $");
        if (magic > 9223372036854775807u64) {
            w.text("-");
            w.unsigned_number((18446744073709551615u64 - magic) + 1u64);
        } else {
            w.unsigned_number(magic);
        }
        w.text(", %rdx\n");
        w.line("mulq %rdx");
        w.line("movq %rcx, %rax");
        w.line("subq %rdx, %rax");
        w.line("shrq $1, %rax");
        w.line("addq %rdx, %rax");
        return w.line_number("shrq $", shift - 1, ", %rax");
    }
    auto emit_resources(EmitWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 instruction) -> bool {
        if (emit_spans(w, m, s, instruction)) {
            return true;
        }
        const compiler_ir_instructions::RawInstructionRow row = s.instruction_at(instruction);
        const i64 form = row.form();
        if (form < 60 || form > 80) {
            return false;
        }
        const i64 callable = w.current_callable();
        const i64 first = operand_value(s, instruction, 0);
        if (form == 60) {
            clear_bytes_owner(w, first);
            return true;
        }
        if (form == 61 || form == 62) {
            const i64 result = operand_value(s, instruction, 1);
            w.line("movq %rax, %rsi");
            w.line_address("movq ", first, ", %rdi");
            if (form == 61) {
                w.line_address("leaq ", result, ", %rdx");
                w.call_runtime("__au_runtime_bytes_allocate");
            } else {
                const i64 stride = owner_element_stride(m, callable, result, -1);
                w.line_number("movq $", stride, ", %rdx");
                w.line_address("leaq ", operand_value(s, instruction, 2), ", %rcx");
                w.line_address("leaq ", result, ", %r8");
                w.call_runtime("__au_runtime_values_allocate");
            }
            return true;
        }
        if (form == 63 || form == 64 || form == 65) {
            const i64 field = operand_value(s, instruction, 1);
            const i64 value = operand_value(s, instruction, 2);
            const i64 stride = owner_element_stride(m, callable, first, field);
            w.line("movq %rax, %rsi");
            if (form == 63) {
                const i64 length = bytes_owner_address(w, m, first, field, 16);
                values_bounds_check(w, length, stride);
            }
            const i64 owner = bytes_owner_address(w, m, first, field, 0);
            w.begin_line();
            w.text("leaq ");
            w.memory(owner);
            w.text(", %rdi");
            w.end_line();
            w.line_number("movq $", stride, ", %rdx");
            if (form == 63) {
                if (w.direct_result()) {
                    const i64 save = w.result_save();
                    w.line_address("movq ", save, ", %rcx");
                } else {
                    w.line_address("leaq ", value, ", %rcx");
                }
                w.call_runtime("__au_runtime_values_at");
            } else {
                w.line_address("leaq ", value, ", %rcx");
                if (form == 64) {
                    w.call_runtime("__au_runtime_values_set");
                } else {
                    w.call_runtime("__au_runtime_values_resize");
                }
            }
            return true;
        }
        if (form == 66) {
            move_bytes_owner(w, first, operand_value(s, instruction, 1));
            return true;
        }
        if (form == 67 || form == 68) {
            const i64 field = operand_value(s, instruction, 1);
            i64 byte = 16;
            if (form == 67) {
                byte = 24;
            }
            const i64 value = bytes_owner_address(w, m, first, field, byte);
            w.begin_line();
            w.text("movq ");
            w.memory(value);
            w.text(", %rax");
            w.end_line();
            if (form == 68 && resource_owner_kind(m, callable, first, field) == 17) {
                divide_by_stride(w, owner_element_stride(m, callable, first, field));
            }
            return true;
        }
        if (form == 69 || form == 70 || form == 71) {
            const i64 field = operand_value(s, instruction, 1);
            if (form == 69) {
                const i64 length = bytes_owner_address(w, m, first, field, 16);
                w.begin_line();
                w.text("cmpq ");
                w.memory(length);
                w.text(", %rax");
                w.end_line();
                w.line("jae .Laurora_bounds_trap");
                w.line("movq %rax, %rsi");
            } else {
                if (form == 70) {
                    w.line("movq %rax, %rdx");
                    w.pop("%rsi");
                } else {
                    w.line("movq %rax, %rsi");
                }
            }
            const i64 owner = bytes_owner_address(w, m, first, field, 0);
            w.begin_line();
            w.text("leaq ");
            w.memory(owner);
            w.text(", %rdi");
            w.end_line();
            if (form == 69) {
                w.call_runtime("__au_runtime_bytes_at");
            } else {
                if (form == 70) {
                    w.call_runtime("__au_runtime_bytes_set");
                } else {
                    w.call_runtime("__au_runtime_bytes_resize");
                }
            }
            return true;
        }
        if (form == 72) {
            w.push();
            w.line_address("leaq ", first, ", %rdi");
            w.call_runtime("__au_runtime_bytes_drop");
            w.pop("%rax");
            return true;
        }
        if (form == 73 || form == 74) {
            const i64 offset = operand_value(s, instruction, 1);
            const i64 save = w.call_record_save();
            w.line_address("movq ", save, ", %r11");
            if (form == 73) {
                const i64 source = record_offset(m, callable, first);
                if (source == 0) {
                    w.line("movq (%r11), %rax");
                } else {
                    w.line_number("movq ", source, "(%r11), %rax");
                }
                w.line_address("movq %rax, ", offset, "");
            } else {
                const i64 source = record_offset(m, callable, first);
                i64 byte = 0;
                while (byte < 32) {
                    w.line_number("movq ", source + byte, "(%r11), %rax");
                    w.line_address("movq %rax, ", offset - byte, "");
                    w.line_number("movq $0, ", source + byte, "(%r11)");
                    byte = byte + 8;
                }
            }
            return true;
        }
        if (form == 75) {
            const i64 target = resource_target(m, s, instruction);
            const i64 record_bytes = pack_resources(w, m, s, instruction, target);
            if (resource_receiver(m, target)) {
                w.line_address("leaq ", operand_value(s, instruction, 4), ", %r10");
            } else {
                const i64 result = result_type(m, target);
                const i64 kind = type_kind(m, result);
                if (kind == 13 || kind == 17 || kind == 5) {
                    w.line_address("leaq ", operand_value(s, instruction, 3), ", %r10");
                }
            }
            call_target(w, m, target);
            w.release_stack(record_bytes);
            return true;
        }
        if (form == 76) {
            const i64 save = w.result_save();
            w.line_address("movq ", save, ", %r10");
            i64 byte = 0;
            while (byte < 32) {
                w.line_address("movq ", first - byte, ", %rcx");
                w.line_number("movq %rcx, ", byte, "(%r10)");
                byte = byte + 8;
            }
            clear_bytes_owner(w, first);
            resource_return_jump(w);
            return true;
        }
        if (form == 77) {
            const i64 field = operand_value(s, instruction, 1);
            const i64 source = operand_value(s, instruction, 2);
            const i64 save = w.receiver_save();
            w.line_address("movq ", save, ", %r10");
            const i64 receiver = receiver_class(m, callable);
            const i64 destination = class_field_offset(m, receiver, field);
            i64 byte = 0;
            while (byte < 32) {
                w.line_address("movq ", source - byte, ", %rcx");
                w.line_number("movq %rcx, ", destination + byte, "(%r10)");
                byte = byte + 8;
            }
            clear_bytes_owner(w, source);
            return true;
        }
        if (form == 78) {
            const i64 result = operand_value(s, instruction, 1);
            const i64 name = slot_class(m, callable, first);
            const i64 packed_address58 = w.pack_address(0, first);
            const i64 packed_address59 = w.pack_address(0, result);
            transfer_object(w, m, name, packed_address58, packed_address59);
            return true;
        }
        if (form == 79) {
            const i64 offset = operand_value(s, instruction, 1);
            const i64 name = slot_class(m, callable, offset);
            const i64 save = w.call_record_save();
            w.line_address("movq ", save, ", %r11");
            const i64 source = record_offset(m, callable, first);
            clear_object(w, m, offset, name);
            const i64 packed_address60 = w.pack_address(3, source);
            const i64 packed_address61 = w.pack_address(0, offset);
            transfer_object(w, m, name, packed_address60, packed_address61);
            return true;
        }
        // ReturnOwnedObject transfers and clears each owned descriptor while
        // preserving scalar payload widths and the result's reserved padding.
        const i64 save = w.result_save();
        w.line_address("movq ", save, ", %r10");
        const i64 result = result_type(m, callable);
        const i64 packed_address62 = w.pack_address(0, first);
        const i64 packed_address63 = w.pack_address(2, 0);
        transfer_object(w, m, type_class(m, result), packed_address62, packed_address63);
        resource_return_jump(w);
        return true;
    }
}
