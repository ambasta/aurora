export module aurora.compiler.x86_resources;
import aurora.compiler.x86_storage;
import aurora.compiler.x86_object_storage;
import aurora.compiler.x86_helpers;
import aurora.compiler.ir_instruction_storage;
import aurora.compiler.ir_instructions;
import aurora.compiler.ir_metadata_storage;
import aurora.compiler.ir_metadata;

// Resource and span lowering consumes the admitted stores directly. Descriptor
// transfers retain the old backend's instruction order, scalar preservation and
// call-alignment accounting; no serialized instruction stream is reconstructed.
export namespace compiler_x86 {
    auto resource_pop_argument(EmitWorkspace& w, ObjectWorkspace& object, i64 index) -> bool {
        if (index == 0) {
            return emit_pop(w, object, Register::rdi);
        }
        if (index == 1) {
            return emit_pop(w, object, Register::rsi);
        }
        if (index == 2) {
            return emit_pop(w, object, Register::rdx);
        }
        if (index == 3) {
            return emit_pop(w, object, Register::rcx);
        }
        if (index == 4) {
            return emit_pop(w, object, Register::r8);
        }
        if (index == 5) {
            return emit_pop(w, object, Register::r9);
        }
        return w.fail();
    }
    auto resource_target(const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 instruction) -> i64 {
        const compiler_ir_instructions::RawOperandRow operand = compiler_ir_instructions::call_operand(s, instruction,
            0);
        const compiler_ir_metadata::ByteRange name = compiler_ir_metadata::ByteRange(operand.begin(), operand.count());
        return compiler_ir_metadata::first_named_callable(m, name);
    }
    auto resource_receiver(const compiler_ir_metadata::MetadataStore& m, i64 callable) -> bool {
        const compiler_ir_metadata::CallableRow row = m.callable_at(callable);
        const compiler_ir_metadata::FlagMasks masks = compiler_ir_metadata::FlagMasks();
        return compiler_ir_metadata::callable_flag(row, masks.callable_receiver());
    }
    auto resource_array_length(const compiler_ir_metadata::MetadataStore& m, i64 callable, i64 offset) -> i64 {
        const i64 index = compiler_ir_instructions::entry_slot(m, callable, 12, offset);
        const compiler_ir_metadata::SlotRow slot = m.slot_at(index);
        return slot.length();
    }
    auto resource_owner_kind(const compiler_ir_metadata::MetadataStore& m, i64 callable, i64 offset, i64 field) -> i64 {
        const i64 type = owner_storage_type(m, callable, offset, field);
        if (type < 0) {
            return 13;
        }
        return type_kind(m, type);
    }
    auto pack_resources(EmitWorkspace& w, ObjectWorkspace& object, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 instruction, i64 target) -> i64 {
        const i64 count = parameter_count(m, target);
        i64 index = count;
        while (index > 1) {
            const i64 type = parameter_type(m, target, index - 1);
            const i64 kind = type_kind(m, type);
            if (kind != 13 && kind != 17 && kind != 5) {
                resource_pop_argument(w, object, index - 1);
            }
            index = index - 1;
        }
        const i64 record_bytes = ((record_offset(m, target, count) + 15) / 16) * 16;
        emit_reserve_stack(w, object, record_bytes);
        const i64 packed_address54 = w.pack_address(1, 0);
        clear_bytes(w, object, 0, record_bytes, packed_address54);
        // Scalar argument registers are saved before descriptor copies reuse
        // RAX/RCX. The region root always occupies the first complete word.
        index = 1;
        while (index < count) {
            const i64 type = parameter_type(m, target, index);
            const i64 kind = type_kind(m, type);
            if (kind != 13 && kind != 17 && kind != 5) {
                const i64 packed_address55 = w.pack_address(1, record_offset(m, target, index));
                store_argument(w, object, m, type, index, packed_address55);
            }
            index = index + 1;
        }
        const i64 region = operand_value(s, instruction, 1);
        const i64 address_token1 = w.pack_address(0, region);
        emit_load(w, object, address_token1, Register::rax, false);
        const i64 address_token2 = w.pack_address(1, 0);
        emit_store(w, object, Register::rax, address_token2, false);
        index = 1;
        while (index < count) {
            const i64 type = parameter_type(m, target, index);
            const i64 kind = type_kind(m, type);
            if (kind == 13 || kind == 17) {
                const i64 source = operand_lane(s, instruction, 2, index);
                const i64 destination = record_offset(m, target, index);
                i64 byte = 0;
                while (byte < 32) {
                    const i64 address_token3 = w.pack_address(0, source - byte);
                    emit_load(w, object, address_token3, Register::rax, false);
                    const i64 address_token4 = w.pack_address(1, destination + byte);
                    emit_store(w, object, Register::rax, address_token4, false);
                    byte = byte + 8;
                }
                clear_bytes_owner(w, object, source);
            } else {
                if (kind == 5) {
                    const i64 source = operand_lane(s, instruction, 2, index);
                    const i64 destination = record_offset(m, target, index);
                    const i64 packed_address56 = w.pack_address(0, source);
                    const i64 packed_address57 = w.pack_address(1, destination);
                    transfer_object(w, object, m, type_class(m, type), packed_address56, packed_address57);
                }
            }
            index = index + 1;
        }
        emit_mov_rr(w, object, Register::rsp, Register::r11);
        return record_bytes;
    }
    auto resource_return_jump(EmitWorkspace& w, ObjectWorkspace& object) -> bool {
        emit_alu_rr(w, object, AluOp::bit_xor, Register::rax, Register::rax);
        return emit_branch(w, object, -1, 1, 0);
    }
    auto emit_spans(EmitWorkspace& w, ObjectWorkspace& object, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 instruction) -> bool {
        const compiler_ir_instructions::RawInstructionRow row = s.instruction_at(instruction);
        const i64 form = row.form();
        const i64 callable = w.current_callable();
        if (form == 47 || form == 48 || form == 56) {
            // BeginArray, EndArray and EndSpan change static lifetimes only.
            return true;
        }
        if (form == 49 || form == 50 || form == 51) {
            const i64 source = operand_value(s, instruction, 0);
            const i64 result = operand_value(s, instruction, 1);
            i64 length = 0;
            const i64 address_token5 = w.pack_address(0, result);
            emit_store_imm(w, object, 0, address_token5, false);
            if (form == 49) {
                const i64 address_token6 = w.pack_address(0, source);
                emit_lea(w, object, address_token6, Register::rcx);
                length = resource_array_length(m, callable, source);
            } else {
                if (form == 50) {
                    const i64 receiver = receiver_class(m, callable);
                    const i64 byte = class_field_offset(m, receiver, source);
                    const i64 save = w.receiver_save();
                    const i64 address_token7 = w.pack_address(0, save);
                    emit_load(w, object, address_token7, Register::rcx, false);
                    emit_lea_base(w, object, Register::rcx, byte, Register::rcx);
                    length = class_field_length(m, receiver, source);
                } else {
                    emit_lea_literal(w, object, instruction, Register::rcx);
                    length = operand_count(s, instruction, 0);
                }
            }
            const i64 address_token8 = w.pack_address(0, result - 8);
            emit_store(w, object, Register::rcx, address_token8, false);
            i64 byte = 16;
            while (byte <= 40) {
                const i64 address_token9 = w.pack_address(0, result - byte);
                emit_store_imm(w, object, 0, address_token9, false);
                byte = byte + 8;
            }
            const i64 address_token10 = w.pack_address(0, result - 48);
            emit_store_imm(w, object, length, address_token10, false);
            return true;
        }
        if (form == 52) {
            const i64 offset = operand_value(s, instruction, 0);
            const i64 field = operand_value(s, instruction, 1);
            const i64 result = operand_value(s, instruction, 2);
            // Runtime borrow validation preserves the unrelated current scalar
            // and every operand, including their original stack parity.
            emit_push(w, object);
            const i64 owner = bytes_owner_address(w, object, m, offset, field, 0);
            emit_lea(w, object, owner, Register::rdi);
            const i64 address_token11 = w.pack_address(0, result);
            emit_lea(w, object, address_token11, Register::rsi);
            const i64 runtime_symbol1 = w.intern_runtime("__au_runtime_bytes_borrow_span");
            emit_call_runtime(w, object, runtime_symbol1);
            const i64 stride = span_element_stride(m, callable, result);
            if (stride > 0) {
                // The runtime reports the owner's byte length; a typed owner's
                // length is always a whole number of elements.
                const i64 address_token12 = w.pack_address(0, result - 48);
                emit_load(w, object, address_token12, Register::rax, false);
                divide_by_stride(w, object, stride);
                const i64 address_token13 = w.pack_address(0, result - 48);
                emit_store(w, object, Register::rax, address_token13, false);
            }
            emit_pop(w, object, Register::rax);
            return true;
        }
        if (form == 53) {
            const i64 offset = operand_value(s, instruction, 0);
            const i64 save = w.result_save();
            const i64 address_token14 = w.pack_address(0, save);
            emit_load(w, object, address_token14, Register::r10, false);
            i64 byte = 0;
            while (byte < 56) {
                const i64 address_token15 = w.pack_address(0, offset - byte);
                emit_load(w, object, address_token15, Register::rcx, false);
                const i64 address_token16 = w.pack_address(2, byte);
                emit_store(w, object, Register::rcx, address_token16, false);
                byte = byte + 8;
            }
            resource_return_jump(w, object);
            return true;
        }
        if (form == 54 || form == 55) {
            const i64 source = operand_value(s, instruction, 0);
            const i64 result = operand_value(s, instruction, 1);
            if (form == 55) {
                emit_pop(w, object, Register::rcx);
                const i64 address_token17 = w.pack_address(0, source - 48);
                emit_load(w, object, address_token17, Register::rdx, false);
                emit_alu_rr(w, object, AluOp::compare, Register::rdx, Register::rcx);
                emit_branch(w, object, 7, 4, 0);
                emit_alu_rr(w, object, AluOp::subtract, Register::rcx, Register::rdx);
                emit_alu_rr(w, object, AluOp::compare, Register::rdx, Register::rax);
                emit_branch(w, object, 7, 4, 0);
            }
            i64 byte = 0;
            while (byte < 56) {
                if (form == 54) {
                    const i64 address_token18 = w.pack_address(0, source - byte);
                    emit_load(w, object, address_token18, Register::rcx, false);
                    const i64 address_token19 = w.pack_address(0, result - byte);
                    emit_store(w, object, Register::rcx, address_token19, false);
                } else {
                    const i64 address_token20 = w.pack_address(0, source - byte);
                    emit_load(w, object, address_token20, Register::rdx, false);
                    const i64 address_token21 = w.pack_address(0, result - byte);
                    emit_store(w, object, Register::rdx, address_token21, false);
                }
                byte = byte + 8;
            }
            if (form == 55) {
                const i64 address_token22 = w.pack_address(0, source - 40);
                emit_alu_load(w, object, AluOp::add, address_token22, Register::rcx);
                const i64 address_token23 = w.pack_address(0, result - 40);
                emit_store(w, object, Register::rcx, address_token23, false);
                const i64 address_token24 = w.pack_address(0, result - 48);
                emit_store(w, object, Register::rax, address_token24, false);
            }
            return true;
        }
        if (form == 57) {
            const i64 address_token25 = w.pack_address(0, operand_value(s, instruction, 0) - 48);
            emit_load(w, object, address_token25, Register::rax, false);
            return true;
        }
        if (form == 58) {
            const i64 offset = operand_value(s, instruction, 0);
            const i64 address_token26 = w.pack_address(0, offset - 48);
            emit_alu_load(w, object, AluOp::compare, address_token26, Register::rax);
            emit_branch(w, object, 3, 4, 0);
            const i64 address_token27 = w.pack_address(0, offset - 40);
            emit_alu_load(w, object, AluOp::add, address_token27, Register::rax);
            // The old backend consumes the label ordinal even when the module
            // contains no owners and the runtime branch is omitted.
            const i64 division = w.next_division();
            const bool owned = w.owned_span_runtime();
            if (owned) {
                const i64 address_token28 = w.pack_address(0, offset);
                emit_alu_mem_imm(w, object, AluOp::compare, 0, address_token28);
                emit_branch(w, object, 4, 7, division);
                const i64 address_token29 = w.pack_address(0, offset);
                emit_alu_mem_imm(w, object, AluOp::compare, 1, address_token29);
                emit_branch(w, object, 5, 4, 0);
                emit_mov_rr(w, object, Register::rax, Register::rsi);
                const i64 address_token30 = w.pack_address(0, offset - 8);
                emit_lea(w, object, address_token30, Register::rdi);
                const i64 runtime_symbol2 = w.intern_runtime("__au_runtime_bytes_at");
                emit_call_runtime(w, object, runtime_symbol2);
                emit_branch(w, object, -1, 8, division);
                emit_bind_label(w, object, 7, division);
            }
            const i64 address_token31 = w.pack_address(0, offset - 8);
            emit_load(w, object, address_token31, Register::rcx, false);
            emit_indexed_load(w, object, Register::rcx, Register::rax, indexed_address(1, 0), true);
            if (owned) {
                emit_bind_label(w, object, 8, division);
            }
            return true;
        }
        if (form == 84) {
            const i64 offset = operand_value(s, instruction, 0);
            const i64 value = operand_value(s, instruction, 1);
            const i64 stride = span_element_stride(m, callable, offset);
            if (stride < 1) {
                return w.fail();
            }
            const i64 address_token32 = w.pack_address(0, offset - 48);
            emit_alu_load(w, object, AluOp::compare, address_token32, Register::rax);
            emit_branch(w, object, 3, 4, 0);
            const i64 address_token33 = w.pack_address(0, offset - 40);
            emit_alu_load(w, object, AluOp::add, address_token33, Register::rax);
            const i64 division = w.next_division();
            // Kind 1 is a kernel owner snapshot read through the checked runtime;
            // kind 0 is contiguous payload, copied whole like the runtime's copy.
            // As for byte loads, a graph without owners has only kind-0 views.
            const bool owned = w.owned_span_runtime();
            if (owned) {
                const i64 address_token34 = w.pack_address(0, offset);
                emit_alu_mem_imm(w, object, AluOp::compare, 0, address_token34);
                emit_branch(w, object, 4, 7, division);
                const i64 address_token35 = w.pack_address(0, offset);
                emit_alu_mem_imm(w, object, AluOp::compare, 1, address_token35);
                emit_branch(w, object, 5, 4, 0);
                emit_mov_rr(w, object, Register::rax, Register::rsi);
                const i64 address_token36 = w.pack_address(0, offset - 8);
                emit_lea(w, object, address_token36, Register::rdi);
                emit_mov_imm(w, object, stride, Register::rdx);
                const i64 address_token37 = w.pack_address(0, value);
                emit_lea(w, object, address_token37, Register::rcx);
                const i64 runtime_symbol3 = w.intern_runtime("__au_runtime_values_at");
                emit_call_runtime(w, object, runtime_symbol3);
                emit_branch(w, object, -1, 8, division);
                emit_bind_label(w, object, 7, division);
            }
            emit_imul_imm(w, object, stride, Register::rax, Register::rsi);
            const i64 address_token38 = w.pack_address(0, offset - 8);
            emit_alu_load(w, object, AluOp::add, address_token38, Register::rsi);
            if (w.loan_offset(0 - value) == offset) {
                // In place (module_elidable): stash the element address instead.
                const i64 address_token39 = w.pack_address(0, value);
                emit_store(w, object, Register::rsi, address_token39, false);
            } else {
                const i64 address_token40 = w.pack_address(0, value);
                emit_lea(w, object, address_token40, Register::rdi);
                emit_mov_imm(w, object, stride, Register::rcx);
                emit_cld(w, object);
                emit_rep_movsb(w, object);
            }
            if (owned) {
                emit_bind_label(w, object, 8, division);
            }
            return w.ok();
        }
        if (form == 59) {
            const i64 index = operand_value(s, instruction, 0);
            const i64 offset = operand_value(s, instruction, 1);
            const i64 save = w.call_record_save();
            const i64 address_token41 = w.pack_address(0, save);
            emit_load(w, object, address_token41, Register::r11, false);
            const i64 source = record_offset(m, callable, index);
            i64 byte = 0;
            while (byte < 56) {
                const i64 address_token42 = w.pack_address(3, source + byte);
                emit_load(w, object, address_token42, Register::rax, false);
                const i64 address_token43 = w.pack_address(0, offset - byte);
                emit_store(w, object, Register::rax, address_token43, false);
                byte = byte + 8;
            }
            return true;
        }
        return false;
    }
    // An owned-value index is in bounds when (index + 1) * stride fits within the
    // byte length; a product beyond 64 bits exceeds every length. This is the
    // unsigned index < length / stride test without a division. The index stays
    // in %rsi; %rax and %rdx are clobbered, as the division clobbered them.
    auto values_bounds_check(EmitWorkspace& w, ObjectWorkspace& object, i64 length, i64 stride) -> bool {
        emit_mov_imm(w, object, stride, Register::rax);
        emit_unary(w, object, UnaryOp::unsigned_multiply, Register::rsi);
        emit_branch(w, object, 2, 4, 0);
        emit_alu_imm(w, object, AluOp::add, stride, Register::rax);
        emit_branch(w, object, 2, 4, 0);
        emit_alu_load(w, object, AluOp::compare, length, Register::rax);
        return emit_branch(w, object, 7, 4, 0);
    }
    // Unsigned %rax / stride for a constant stride: a shift for powers of two,
    // otherwise Granlund-Montgomery multiplication by a 65-bit reciprocal with the
    // add-and-shift fixup, exact for every 64-bit dividend. Clobbers %rcx and %rdx.
    auto divide_by_stride(EmitWorkspace& w, ObjectWorkspace& object, i64 stride) -> bool {
        if (stride < 1 || stride > 1073741824) {
            emit_mov_imm(w, object, stride, Register::rcx);
            emit_alu_rr(w, object, AluOp::bit_xor, Register::rdx, Register::rdx);
            return emit_unary(w, object, UnaryOp::unsigned_divide, Register::rcx);
        }
        i64 power = 1;
        i64 shift = 0;
        while (power < stride) {
            power = power * 2;
            shift = shift + 1;
        }
        if (power == stride) {
            if (shift != 0) {
                emit_shift_imm(w, object, false, shift, Register::rax);
            }
            return w.ok();
        }
        // floor(2^64 * (power - stride) / stride) + 1, by long division in 32-bit
        // digits; power - stride < stride < 2^30, so no step overflows.
        const u64 divisor = u64(stride);
        const u64 scaled = u64(power - stride) * 4294967296u64;
        const u64 high = scaled / divisor;
        const u64 low = (scaled % divisor) * 4294967296u64 / divisor;
        const u64 magic = high * 4294967296u64 + low + 1u64;
        emit_mov_rr(w, object, Register::rax, Register::rcx);
        emit_mov_uimm(w, object, magic, Register::rdx);
        emit_unary(w, object, UnaryOp::unsigned_multiply, Register::rdx);
        emit_mov_rr(w, object, Register::rcx, Register::rax);
        emit_alu_rr(w, object, AluOp::subtract, Register::rdx, Register::rax);
        emit_shift_imm(w, object, false, 1, Register::rax);
        emit_alu_rr(w, object, AluOp::add, Register::rdx, Register::rax);
        return emit_shift_imm(w, object, false, shift - 1, Register::rax);
    }
    auto emit_resources(EmitWorkspace& w, ObjectWorkspace& object, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 instruction) -> bool {
        if (emit_spans(w, object, m, s, instruction)) {
            return true;
        }
        const compiler_ir_instructions::RawInstructionRow row = s.instruction_at(instruction);
        const i64 form = row.form();
        if (form < 60 || form > 80) {
            return false;
        }
        const i64 callable = w.current_callable();
        const i64 first = operand_value(s, instruction, 0);
        if (form == 60) {
            clear_bytes_owner(w, object, first);
            return true;
        }
        if (form == 61 || form == 62) {
            const i64 result = operand_value(s, instruction, 1);
            emit_mov_rr(w, object, Register::rax, Register::rsi);
            const i64 address_token44 = w.pack_address(0, first);
            emit_load(w, object, address_token44, Register::rdi, false);
            if (form == 61) {
                const i64 address_token45 = w.pack_address(0, result);
                emit_lea(w, object, address_token45, Register::rdx);
                const i64 runtime_symbol4 = w.intern_runtime("__au_runtime_bytes_allocate");
                emit_call_runtime(w, object, runtime_symbol4);
            } else {
                const i64 stride = owner_element_stride(m, callable, result, -1);
                emit_mov_imm(w, object, stride, Register::rdx);
                const i64 address_token46 = w.pack_address(0, operand_value(s, instruction, 2));
                emit_lea(w, object, address_token46, Register::rcx);
                const i64 address_token47 = w.pack_address(0, result);
                emit_lea(w, object, address_token47, Register::r8);
                const i64 runtime_symbol5 = w.intern_runtime("__au_runtime_values_allocate");
                emit_call_runtime(w, object, runtime_symbol5);
            }
            return true;
        }
        if (form == 63 || form == 64 || form == 65) {
            const i64 field = operand_value(s, instruction, 1);
            const i64 value = operand_value(s, instruction, 2);
            const i64 stride = owner_element_stride(m, callable, first, field);
            emit_mov_rr(w, object, Register::rax, Register::rsi);
            if (form == 63) {
                const i64 length = bytes_owner_address(w, object, m, first, field, 16);
                values_bounds_check(w, object, length, stride);
            }
            const i64 owner = bytes_owner_address(w, object, m, first, field, 0);
            emit_lea(w, object, owner, Register::rdi);
            emit_mov_imm(w, object, stride, Register::rdx);
            if (form == 63) {
                if (w.direct_result()) {
                    const i64 save = w.result_save();
                    const i64 address_token48 = w.pack_address(0, save);
                    emit_load(w, object, address_token48, Register::rcx, false);
                } else {
                    const i64 address_token49 = w.pack_address(0, value);
                    emit_lea(w, object, address_token49, Register::rcx);
                }
                const i64 runtime_symbol6 = w.intern_runtime("__au_runtime_values_at");
                emit_call_runtime(w, object, runtime_symbol6);
            } else {
                const i64 address_token50 = w.pack_address(0, value);
                emit_lea(w, object, address_token50, Register::rcx);
                if (form == 64) {
                    const i64 runtime_symbol7 = w.intern_runtime("__au_runtime_values_set");
                    emit_call_runtime(w, object, runtime_symbol7);
                } else {
                    const i64 runtime_symbol8 = w.intern_runtime("__au_runtime_values_resize");
                    emit_call_runtime(w, object, runtime_symbol8);
                }
            }
            return true;
        }
        if (form == 66) {
            move_bytes_owner(w, object, first, operand_value(s, instruction, 1));
            return true;
        }
        if (form == 67 || form == 68) {
            const i64 field = operand_value(s, instruction, 1);
            i64 byte = 16;
            if (form == 67) {
                byte = 24;
            }
            const i64 value = bytes_owner_address(w, object, m, first, field, byte);
            emit_load(w, object, value, Register::rax, false);
            if (form == 68 && resource_owner_kind(m, callable, first, field) == 17) {
                divide_by_stride(w, object, owner_element_stride(m, callable, first, field));
            }
            return true;
        }
        if (form == 69 || form == 70 || form == 71) {
            const i64 field = operand_value(s, instruction, 1);
            if (form == 69) {
                const i64 length = bytes_owner_address(w, object, m, first, field, 16);
                emit_alu_load(w, object, AluOp::compare, length, Register::rax);
                emit_branch(w, object, 3, 4, 0);
                emit_mov_rr(w, object, Register::rax, Register::rsi);
            } else {
                if (form == 70) {
                    emit_mov_rr(w, object, Register::rax, Register::rdx);
                    emit_pop(w, object, Register::rsi);
                } else {
                    emit_mov_rr(w, object, Register::rax, Register::rsi);
                }
            }
            const i64 owner = bytes_owner_address(w, object, m, first, field, 0);
            emit_lea(w, object, owner, Register::rdi);
            if (form == 69) {
                const i64 runtime_symbol9 = w.intern_runtime("__au_runtime_bytes_at");
                emit_call_runtime(w, object, runtime_symbol9);
            } else {
                if (form == 70) {
                    const i64 runtime_symbol10 = w.intern_runtime("__au_runtime_bytes_set");
                    emit_call_runtime(w, object, runtime_symbol10);
                } else {
                    const i64 runtime_symbol11 = w.intern_runtime("__au_runtime_bytes_resize");
                    emit_call_runtime(w, object, runtime_symbol11);
                }
            }
            return true;
        }
        if (form == 72) {
            emit_push(w, object);
            const i64 address_token51 = w.pack_address(0, first);
            emit_lea(w, object, address_token51, Register::rdi);
            const i64 runtime_symbol12 = w.intern_runtime("__au_runtime_bytes_drop");
            emit_call_runtime(w, object, runtime_symbol12);
            emit_pop(w, object, Register::rax);
            return true;
        }
        if (form == 73 || form == 74) {
            const i64 offset = operand_value(s, instruction, 1);
            const i64 save = w.call_record_save();
            const i64 address_token52 = w.pack_address(0, save);
            emit_load(w, object, address_token52, Register::r11, false);
            if (form == 73) {
                const i64 source = record_offset(m, callable, first);
                if (source == 0) {
                    const i64 address_token53 = w.pack_address(3, 0);
                    emit_load(w, object, address_token53, Register::rax, false);
                } else {
                    const i64 address_token54 = w.pack_address(3, source);
                    emit_load(w, object, address_token54, Register::rax, false);
                }
                const i64 address_token55 = w.pack_address(0, offset);
                emit_store(w, object, Register::rax, address_token55, false);
            } else {
                const i64 source = record_offset(m, callable, first);
                i64 byte = 0;
                while (byte < 32) {
                    const i64 address_token56 = w.pack_address(3, source + byte);
                    emit_load(w, object, address_token56, Register::rax, false);
                    const i64 address_token57 = w.pack_address(0, offset - byte);
                    emit_store(w, object, Register::rax, address_token57, false);
                    const i64 address_token58 = w.pack_address(3, source + byte);
                    emit_store_imm(w, object, 0, address_token58, false);
                    byte = byte + 8;
                }
            }
            return true;
        }
        if (form == 75) {
            const i64 target = resource_target(m, s, instruction);
            const i64 record_bytes = pack_resources(w, object, m, s, instruction, target);
            if (resource_receiver(m, target)) {
                const i64 address_token59 = w.pack_address(0, operand_value(s, instruction, 4));
                emit_lea(w, object, address_token59, Register::r10);
            } else {
                const i64 result = result_type(m, target);
                const i64 kind = type_kind(m, result);
                if (kind == 13 || kind == 17 || kind == 5) {
                    const i64 address_token60 = w.pack_address(0, operand_value(s, instruction, 3));
                    emit_lea(w, object, address_token60, Register::r10);
                }
            }
            call_target(w, object, m, target);
            emit_release_stack(w, object, record_bytes);
            return true;
        }
        if (form == 76) {
            const i64 save = w.result_save();
            const i64 address_token61 = w.pack_address(0, save);
            emit_load(w, object, address_token61, Register::r10, false);
            i64 byte = 0;
            while (byte < 32) {
                const i64 address_token62 = w.pack_address(0, first - byte);
                emit_load(w, object, address_token62, Register::rcx, false);
                const i64 address_token63 = w.pack_address(2, byte);
                emit_store(w, object, Register::rcx, address_token63, false);
                byte = byte + 8;
            }
            clear_bytes_owner(w, object, first);
            resource_return_jump(w, object);
            return true;
        }
        if (form == 77) {
            const i64 field = operand_value(s, instruction, 1);
            const i64 source = operand_value(s, instruction, 2);
            const i64 save = w.receiver_save();
            const i64 address_token64 = w.pack_address(0, save);
            emit_load(w, object, address_token64, Register::r10, false);
            const i64 receiver = receiver_class(m, callable);
            const i64 destination = class_field_offset(m, receiver, field);
            const i64 field_type = class_field_type(m, receiver, field);
            const i64 extent = argument_bytes(m, field_type);
            i64 byte = 0;
            while (byte < extent) {
                const i64 address_token65 = w.pack_address(0, source - byte);
                emit_load(w, object, address_token65, Register::rcx, false);
                const i64 address_token66 = w.pack_address(2, destination + byte);
                emit_store(w, object, Register::rcx, address_token66, false);
                byte = byte + 8;
            }
            const i64 source_address = w.pack_address(0, source);
            clear_bytes(w, object, 0, extent, source_address);
            return true;
        }
        if (form == 78) {
            const i64 result = operand_value(s, instruction, 1);
            const i64 name = slot_class(m, callable, first);
            const i64 packed_address58 = w.pack_address(0, first);
            const i64 packed_address59 = w.pack_address(0, result);
            transfer_object(w, object, m, name, packed_address58, packed_address59);
            return true;
        }
        if (form == 79) {
            const i64 offset = operand_value(s, instruction, 1);
            const i64 name = slot_class(m, callable, offset);
            const i64 save = w.call_record_save();
            const i64 address_token67 = w.pack_address(0, save);
            emit_load(w, object, address_token67, Register::r11, false);
            const i64 source = record_offset(m, callable, first);
            clear_object(w, object, m, offset, name);
            const i64 packed_address60 = w.pack_address(3, source);
            const i64 packed_address61 = w.pack_address(0, offset);
            transfer_object(w, object, m, name, packed_address60, packed_address61);
            return true;
        }
        // ReturnOwnedObject transfers and clears each owned descriptor while
        // preserving scalar payload widths and the result's reserved padding.
        const i64 save = w.result_save();
        const i64 address_token68 = w.pack_address(0, save);
        emit_load(w, object, address_token68, Register::r10, false);
        const i64 result = result_type(m, callable);
        const i64 packed_address62 = w.pack_address(0, first);
        const i64 packed_address63 = w.pack_address(2, 0);
        transfer_object(w, object, m, type_class(m, result), packed_address62, packed_address63);
        resource_return_jump(w, object);
        return true;
    }
}
