export module aurora.compiler.ir_verification_services;
import aurora.compiler.ir_verification_values;
import aurora.compiler.ir_verification_common;
import aurora.compiler.ir_verification_storage;
import aurora.compiler.ir_verification_errors;
import aurora.compiler.ir_verification_initialization;
import aurora.compiler.ir_instructions;
import aurora.compiler.ir_instruction_storage;
import aurora.compiler.ir_metadata;
import aurora.compiler.ir_metadata_storage;
import aurora.compiler.builtin_catalog;

export namespace compiler_ir_verification {
    auto transfer_service_result(const compiler_ir_metadata::MetadataStore& m, i64 operation) -> TypeKey {
        i64 at = 0;
        while (at < m.enum_count()) {
            const compiler_ir_metadata::EnumRow row = m.enum_at(at);
            const compiler_ir_metadata::ByteRange name = row.name();
            if ((operation == 1 && compiler_ir_metadata::named(m, name, "__au_console_put_result")) || (operation == 2
                && compiler_ir_metadata::named(m, name, "__au_display_put_result")) || (operation == 4
                && compiler_ir_metadata::named(m, name, "__au_event_ack_result")) || (operation == 7
                && compiler_ir_metadata::named(m, name, "__au_port_write_result"))) {
                return TypeKey(9, at);
            }
            at = at + 1;
        }
        return TypeKey(-1, -1);
    }
    // An independent copy of the HostFiles primitive signatures (operations 9..31):
    // argument and result kinds in MetadataTypeKind ordinals (I64 0, U64 7, U8 10).
    auto host_argument_count(i64 operation) -> i64 {
        if (operation == 20) {
            return 0;
        }
        if (operation == 16 || operation == 31) {
            return 5;
        }
        if (operation == 13) {
            return 4;
        }
        if (operation == 10 || operation == 12 || operation == 14 || operation == 19 || operation == 21 || operation
            == 22 || operation == 24 || operation == 26 || operation == 30) {
            return 2;
        }
        if (operation == 15 || operation == 17 || operation == 25 || operation == 27 || operation == 28 || operation
            == 29) {
            return 3;
        }
        return 1;
    }
    auto host_argument_kind(i64 operation, i64 index) -> i64 {
        if ((operation == 12 && index == 1) || (operation == 27 && index == 2)) {
            return 10;
        }
        if (operation > 12 && operation < 21 && index == 0) {
            return 0;
        }
        return 7;
    }
    auto host_result_kind(i64 operation) -> i64 {
        if (operation == 9 || operation == 10 || operation == 24 || operation == 25 || operation == 28) {
            return 7;
        }
        if (operation == 11 || operation == 12 || operation == 26 || operation == 27) {
            return 10;
        }
        return 0;
    }
    // Operands of two or more arguments are all pushed; a single argument is the
    // current value. The chunk read fills a pristine HostChunk like a sample.
    auto transfer_host(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 id, i64 operation) -> bool {
        const i64 count = host_argument_count(operation);
        if (count == 1) {
            if (!transfer_current_kind(w, host_argument_kind(operation, 0))) {
                return false;
            }
        } else {
            i64 arg = count - 1;
            while (arg >= 0) {
                if (!transfer_pop_kind(w, host_argument_kind(operation, arg),
                    second_error(VerificationErrorSecond::service_scalar_argument_mismatch))) {
                    return false;
                }
                arg = arg - 1;
            }
        }
        if (operation != 14 && operation != 30) {
            return transfer_set_kind(w, host_result_kind(operation));
        }
        const i64 base = transfer_value(s, id, 2);
        if (!transfer_has(w, FactKind::object, base)) {
            return w.fail(second_error(VerificationErrorSecond::service_observation_requires_pristine_sample));
        }
        const i64 constructed = compiler_ir_initialization::object_was_constructed(w, m, base);
        if (constructed < 0 || !w.good()) {
            return false;
        }
        if (constructed == 1) {
            return w.fail(second_error(VerificationErrorSecond::service_observation_requires_pristine_sample));
        }
        const i64 pristine = compiler_ir_initialization::object_pristine(w, m, base);
        if (pristine < 0 || !w.good()) {
            return false;
        }
        if (pristine == 0) {
            return w.fail(second_error(
                VerificationErrorSecond::service_observation_cannot_overwrite_initialized_sample_storage));
        }
        if (!compiler_ir_initialization::mark_object(w, m, base)) {
            return false;
        }
        return w.clear_current();
    }
    // Active/dead: key=descriptor, site=immutable issuer slot. Used: key=issuer,
    // site=one issuing/forwarding instruction. Exact joins retain both records;
    // no token is borrowed from byte allocation or object ownership.
    auto service_origin_fact(FactKind kind, i64 key, i64 site) -> FactRow {
        FactRow result = object_fact(key, site);
        result.set_kind(kind);
        return result;
    }
    auto service_resource_pinned(VerificationWorkspace& w, i64 issuer) -> bool {
        i64 at = w.first_fact(FactKind::service_resource);
        while (at >= 0 && fact_kind_at(w, at, FactKind::service_resource)) {
            const FactRow fact = w.fact_at(at);
            if (fact.site() == issuer) {
                return true;
            }
            at = w.next_fact(at);
        }
        at = w.first_fact(FactKind::resident_field);
        while (at >= 0 && fact_kind_at(w, at, FactKind::resident_field)) {
            const FactRow field = w.fact_at(at);
            if (field.key() > 0 && field.site() == issuer && field.disposition() == ByteDisposition::live) {
                return true;
            }
            at = w.next_fact(at);
        }
        return false;
    }
    auto service_issuer_available(VerificationWorkspace& w, i64 issuer) -> bool {
        if (service_resource_pinned(w, issuer)) {
            return w.fail(second_error(VerificationErrorSecond::service_resource_issuer_is_pinned));
        }
        if (has_fact(w, FactKind::service_issuer_used, issuer, -1)) {
            return w.fail(second_error(VerificationErrorSecond::service_resource_issuer_already_used));
        }
        return w.good();
    }
    auto fresh_service_resource(VerificationWorkspace& w, i64 root) -> bool {
        if (has_fact(w, FactKind::service_resource, root, -1) || has_fact(w, FactKind::service_resource_dead, root,
            -1)) {
            return w.fail(second_error(VerificationErrorSecond::service_resource_requires_fresh_storage));
        }
        return w.good();
    }
    auto transfer_catalogue_type(const compiler_ir_metadata::MetadataStore& m, i64 type) -> TypeKey {
        const i64 kind = compiler_ir_metadata::catalogue_kind(type);
        i64 nominal = -1;
        if (kind == 5 || kind == 9) {
            nominal = compiler_ir_metadata::catalogue_nominal(m, type);
        }
        return TypeKey(kind, nominal);
    }
    auto resource_issuing_service(i64 issuer) -> bool {
        i64 resource = 0;
        while (resource < compiler_catalog::resource_count()) {
            if (compiler_catalog::resource_issuer(resource) == issuer) {
                return true;
            }
            resource = resource + 1;
        }
        return false;
    }
    auto transfer_service_resource(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 id) -> bool {
        const compiler_ir_instructions::RawInstructionRow op = s.instruction_at(id);
        const i64 form = op.form();
        const i64 root = transfer_value(s, id, 0);
        if (form == 85) {
            const i64 destination = transfer_value(s, id, 2);
            if (!service_issuer_available(w, root) || !fresh_service_resource(w, destination)) {
                return false;
            }
            const i64 issuer_kind = compiler_ir_instructions::service_resource_issuer(m, w.callable(), destination);
            if (issuer_kind < 0 || !compiler_ir_instructions::service_entry_matches(s, m, w.callable(), root,
                issuer_kind) || w.service_unsuspended(root) != 1) {
                return w.fail(second_error(VerificationErrorSecond::service_resource_provenance_mismatch));
            }
            const FactRow used = service_origin_fact(FactKind::service_issuer_used, root, id);
            const FactRow issued = service_origin_fact(FactKind::service_resource, destination, root);
            return w.fact_set(used) && w.fact_set(issued) && w.clear_current();
        }
        if (!has_fact(w, FactKind::service_resource, root, -1)) {
            return w.fail(second_error(VerificationErrorSecond::service_resource_requires_live_owner));
        }
        const FactRow resource = w.fact_find(FactKind::service_resource, root, -1);
        const i64 issuer = resource.site();
        const i64 resource_kind = compiler_ir_instructions::service_resource_kind_at(m, w.callable(), root);
        const i64 issuer_kind = compiler_ir_instructions::service_resource_issuer(m, w.callable(), root);
        const FactRow used = w.fact_find(FactKind::service_issuer_used, issuer, -1);
        const compiler_ir_instructions::RawInstructionRow issuance = s.instruction_at(used.site());
        if (issuer_kind < 0 || used.kind() != FactKind::service_issuer_used || used.site() <= 0 || issuance.form() != 85
            || transfer_value(s, used.site(), 0) != issuer || transfer_value(s, used.site(), 1)
            != compiler_catalog::resource_issue_operation(resource_kind) || transfer_value(s, used.site(), 3)
            != resource_kind || !compiler_ir_instructions::service_entry_matches(s, m, w.callable(), issuer,
            issuer_kind) || w.service_unsuspended(issuer) != 1) {
            return w.fail(second_error(VerificationErrorSecond::service_resource_provenance_mismatch));
        }
        if (form == 86) {
            const i64 destination = transfer_value(s, id, 1);
            if (!fresh_service_resource(w, destination)) {
                return false;
            }
            const FactRow moved = service_origin_fact(FactKind::service_resource, destination, issuer);
            const FactRow dead = service_origin_fact(FactKind::service_resource_dead, root, issuer);
            return w.fact_erase(FactKind::service_resource, root, -1) && w.fact_set(dead) && w.fact_set(moved)
                && w.clear_current();
        }
        const i64 method = transfer_value(s, id, 1);
        const i64 result_type = compiler_catalog::resource_method_result(resource_kind, method);
        const i64 parameter_count = compiler_catalog::resource_method_parameters(resource_kind, method);
        if (parameter_count == 1) {
            const i64 parameter = compiler_catalog::resource_method_parameter(resource_kind, method);
            const TypeKey argument_type = transfer_catalogue_type(m, parameter);
            const ValueRow argument = current(w, argument_type);
            if (!w.good()) {
                return false;
            }
        }
        const bool copied_result = compiler_ir_metadata::catalogue_kind(result_type) == 5;
        if (copied_result) {
            const i64 base = transfer_value(s, id, 2);
            if (!transfer_has(w, FactKind::object, base)) {
                return w.fail(second_error(VerificationErrorSecond::service_observation_requires_pristine_sample));
            }
            const i64 constructed = compiler_ir_initialization::object_was_constructed(w, m, base);
            if (constructed < 0 || !w.good()) {
                return false;
            }
            if (constructed == 1) {
                return w.fail(second_error(VerificationErrorSecond::service_observation_requires_pristine_sample));
            }
            const i64 pristine = compiler_ir_initialization::object_pristine(w, m, base);
            if (pristine < 0 || !w.good()) {
                return false;
            }
            if (pristine == 0) {
                return w.fail(second_error(
                    VerificationErrorSecond::service_observation_cannot_overwrite_initialized_sample_storage));
            }
            if (!compiler_ir_initialization::mark_object(w, m, base)) {
                return false;
            }
        }
        if (compiler_catalog::resource_method_effect(resource_kind, method) == 2) {
            const FactRow dead = service_origin_fact(FactKind::service_resource_dead, root, issuer);
            if (!w.fact_erase(FactKind::service_resource, root, -1) || !w.fact_set(dead)) {
                return false;
            }
        }
        if (copied_result) {
            return w.clear_current();
        }
        const TypeKey result_key = transfer_catalogue_type(m, result_type);
        const BoundsEvidence bounds = empty_bounds();
        const ValueRow result = ValueRow(result_key, bounds);
        return w.set_current(result);
    }
    auto transfer_retained_resource(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 id) -> bool {
        const compiler_ir_instructions::RawInstructionRow instruction = s.instruction_at(id);
        if (instruction.form() == 88) {
            const i64 offset = transfer_value(s, id, 1);
            if (has_fact(w, FactKind::resident_input, offset, -1)) {
                return w.fail(second_error(VerificationErrorSecond::service_resource_requires_fresh_storage));
            }
            const TokenRow empty = no_token();
            const FactRow input = semantic_fact(FactKind::resident_input, offset, -1, id, ByteDisposition::live, empty);
            return w.fact_set(input) && w.clear_current();
        }
        if (transfer_constructor(m, w.callable()) && !lexical_constructor_complete(w, m)) {
            return w.fail(second_error(
                VerificationErrorSecond::constructor_cannot_read_receiver_during_initialization));
        }
        const i64 ordinal = transfer_value(s, id, 1);
        const i64 method = transfer_value(s, id, 2);
        const i64 result_offset = transfer_value(s, id, 3);
        const i64 kind = transfer_value(s, id, 4);
        const i64 effect = compiler_catalog::resource_method_effect(kind, method);
        FactRow field = w.fact_find(FactKind::resident_field, 0, ordinal);
        const FactRow root = w.fact_find(FactKind::owned_object, 0, -1);
        if (!require(w, present(root) && root.disposition() == ByteDisposition::live && present(field)
            && field.disposition() == ByteDisposition::live,
            first_error(VerificationErrorFirst::resource_field_does_not_hold_live_ownership))) {
            return false;
        }
        AccessMode mode = AccessMode::read;
        if (effect != 0) {
            mode = AccessMode::write;
        }
        if (!owner_writable(w, s, 0, ordinal, mode)) {
            return false;
        }
        if (compiler_catalog::resource_method_parameters(kind, method) == 1) {
            const TypeKey expected = transfer_catalogue_type(m, compiler_catalog::resource_method_parameter(kind,
                method));
            const ValueRow argument = current(w, expected);
            if (!w.good()) {
                return false;
            }
        }
        const i64 result_type = compiler_catalog::resource_method_result(kind, method);
        const bool copied = compiler_ir_metadata::catalogue_kind(result_type) == 5;
        if (copied) {
            if (!transfer_has(w, FactKind::object, result_offset)
                || compiler_ir_initialization::object_was_constructed(w, m, result_offset) != 0
                || compiler_ir_initialization::object_pristine(w, m, result_offset) != 1) {
                return w.fail(second_error(VerificationErrorSecond::service_observation_requires_pristine_sample));
            }
            if (!compiler_ir_initialization::mark_object(w, m, result_offset)) {
                return false;
            }
        }
        if (effect == 2) {
            if (!compiler_ir_metadata::consuming_receiver(m.callable_at(w.callable()))) {
                return w.fail(second_error(VerificationErrorSecond::service_resource_provenance_mismatch));
            }
            field.set_disposition(ByteDisposition::consumed);
            if (!w.fact_set(field)) {
                return false;
            }
        }
        if (copied) {
            return w.clear_current();
        }
        const TypeKey type = transfer_catalogue_type(m, result_type);
        const BoundsEvidence bounds = empty_bounds();
        const ValueRow result = ValueRow(type, bounds);
        return w.set_current(result);
    }
    auto transfer_resource_object_call(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 id) -> bool {
        const i64 target_id = transfer_target(m, s, id);
        const compiler_ir_metadata::CallableRow target = m.callable_at(target_id);
        const i64 root_offset = transfer_value(s, id, 1);
        const i64 source = transfer_value(s, id, 2);
        const i64 result = transfer_value(s, id, 3);
        if (!transfer_has(w, FactKind::object, root_offset) || !owner_writable(w, s, root_offset, -2,
            AccessMode::write)) {
            return w.fail(second_error(VerificationErrorSecond::service_resource_requires_live_owner));
        }
        FactRow root = w.fact_find(FactKind::owned_object, root_offset, -1);
        const bool constructor = compiler_ir_metadata::resource_constructor(m, target);
        i64 issuer = 0;
        if (constructor) {
            if (root.disposition() != ByteDisposition::pristine || compiler_ir_initialization::object_was_constructed(w,
                m, root_offset) != 0 || compiler_ir_initialization::object_pristine(w, m, root_offset) != 1
                || !has_fact(w, FactKind::service_resource, source, -1)) {
                return w.fail(second_error(VerificationErrorSecond::service_resource_requires_live_owner));
            }
            const FactRow resource = w.fact_find(FactKind::service_resource, source, -1);
            issuer = resource.site();
            const FactRow used = w.fact_find(FactKind::service_issuer_used, issuer, -1);
            const compiler_ir_instructions::RawInstructionRow issuance = s.instruction_at(used.site());
            const i64 kind = compiler_ir_instructions::service_resource_kind_at(m, w.callable(), source);
            if (used.kind() != FactKind::service_issuer_used || used.site() <= 0 || issuance.form() != 85
                || transfer_value(s, used.site(), 0) != issuer || transfer_value(s, used.site(), 3) != kind
                || transfer_value(s, used.site(), 1) != compiler_catalog::resource_issue_operation(kind)
                || w.service_unsuspended(issuer) != 1) {
                return w.fail(second_error(VerificationErrorSecond::service_resource_provenance_mismatch));
            }
        } else {
            if (!live_owned_root(w, m, root_offset) || compiler_ir_initialization::object_initialized(w, m, root_offset)
                != 1) {
                return w.fail(second_error(VerificationErrorSecond::service_resource_requires_live_owner));
            }
        }
        i64 at = w.fact_lower_bound(FactKind::resident_field, root_offset, -1);
        bool found = false;
        while (at >= 0 && fact_key_at(w, at, FactKind::resident_field, root_offset)) {
            FactRow field = w.fact_at(at);
            ByteDisposition expected = ByteDisposition::live;
            if (constructor) {
                expected = ByteDisposition::pristine;
            }
            if (field.disposition() != expected) {
                return w.fail(second_error(VerificationErrorSecond::service_resource_requires_live_owner));
            }
            if (constructor) {
                field.set_disposition(ByteDisposition::live);
                field.set_site(issuer);
            } else {
                field.set_disposition(ByteDisposition::consumed);
            }
            if (!w.fact_set(field)) {
                return false;
            }
            found = true;
            at = w.next_fact(at);
        }
        if (!found) {
            return w.fail(second_error(VerificationErrorSecond::service_resource_provenance_mismatch));
        }
        if (constructor) {
            const FactRow dead = service_origin_fact(FactKind::service_resource_dead, source, issuer);
            root.set_disposition(ByteDisposition::live);
            return w.fact_erase(FactKind::service_resource, source, -1) && w.fact_set(dead) && w.fact_set(root)
                && compiler_ir_initialization::mark_object(w, m, root_offset) && w.clear_current();
        }
        root.set_disposition(ByteDisposition::consumed);
        if (!w.fact_set(root)) {
            return false;
        }
        const compiler_ir_metadata::IndexRange types = target.types();
        const compiler_ir_metadata::RawTypeRow output = m.type_at(types.begin());
        if (output.kind() == 5) {
            if (!transfer_has(w, FactKind::object, result) || compiler_ir_initialization::object_was_constructed(w, m,
                result) != 0 || compiler_ir_initialization::object_pristine(w, m, result) != 1) {
                return w.fail(second_error(VerificationErrorSecond::service_observation_requires_pristine_sample));
            }
            return compiler_ir_initialization::mark_object(w, m, result) && w.clear_current();
        }
        return transfer_set_type(w, m, types.begin());
    }
    auto transfer_services(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 id) -> bool {
        const compiler_ir_instructions::RawInstructionRow op = s.instruction_at(id);
        const i64 form = op.form();
        if (form == 0) {
            return true;
        }
        if (form >= 85 && form <= 87) {
            return transfer_service_resource(w, m, s, id);
        }
        if (form == 1) {
            const i64 issuer = transfer_value(s, id, 1);
            const i64 kind = transfer_value(s, id, 2);
            if (resource_issuing_service(kind)) {
                if (!service_issuer_available(w, issuer)) {
                    return false;
                }
                const FactRow used = service_origin_fact(FactKind::service_issuer_used, issuer, id);
                if (!w.fact_set(used)) {
                    return false;
                }
            }
            if (w.acquire_service_loan(transfer_value(s, id, 0), transfer_value(s, id, 1), transfer_value(s, id, 2))
                != 1) {
                return w.fail(second_error(
                    VerificationErrorSecond::service_loan_requires_unsuspended_parameter_authority));
            }
            return w.good();
        }
        if (form == 2) {
            if (w.release_service_loan(transfer_value(s, id, 0), transfer_value(s, id, 1)) != 1) {
                return w.fail(second_error(
                    VerificationErrorSecond::service_release_requires_exactly_one_completed_helper_call));
            }
            return w.good();
        }
        if (form == 3) {
            if (w.service_unsuspended(transfer_value(s, id, 0)) != 1) {
                return w.fail(second_error(
                    VerificationErrorSecond::service_operation_requires_active_unsuspended_capability_provenance));
            }
            const i64 operation = transfer_value(s, id, 1);
            if (operation == 44 || operation == 45) {
                return transfer_set_kind(w, 7);
            }
            if (operation == 42) {
                if (!transfer_pop_kind(w, 10, second_error(VerificationErrorSecond::service_scalar_argument_mismatch))
                    || !transfer_pop_kind(w, 7,
                    second_error(VerificationErrorSecond::service_scalar_argument_mismatch))) {
                    return false;
                }
                return transfer_set_kind(w, 7);
            }
            if (operation == 36 || operation == 37 || operation == 38 || operation == 39 || operation == 40 || operation
                == 41 || operation == 43) {
                if (!transfer_current_kind(w, 7)) {
                    return false;
                }
                if (operation == 37 || operation == 40) {
                    return transfer_set_kind(w, 10);
                }
                return transfer_set_kind(w, 7);
            }
            if (operation == 33 || operation == 35) {
                if (!transfer_current_kind(w, 7)) {
                    return false;
                }
                if (operation == 33) {
                    return transfer_set_kind(w, 10);
                }
                return transfer_set_kind(w, 7);
            }
            if (operation == 34) {
                if (!transfer_pop_kind(w, 10, second_error(VerificationErrorSecond::service_scalar_argument_mismatch))
                    || !transfer_pop_kind(w, 7,
                    second_error(VerificationErrorSecond::service_scalar_argument_mismatch))) {
                    return false;
                }
                return transfer_set_kind(w, 10);
            }
            if (operation > 8 && operation < 32) {
                return transfer_host(w, m, s, id, operation);
            }
            if (operation == 2) {
                i64 arg = 4;
                while (arg >= 0) {
                    i64 kind = 10;
                    if (arg < 2) {
                        kind = 7;
                    }
                    if (!transfer_pop_kind(w, kind,
                        second_error(VerificationErrorSecond::pixel_argument_type_mismatch))) {
                        return false;
                    }
                    arg = arg - 1;
                }
                const TypeKey result_type = transfer_service_result(m, operation);
                const BoundsEvidence guard = empty_bounds();
                const ValueRow result_value = ValueRow(result_type, guard);
                return w.set_current(result_value);
            }
            if (operation == 1) {
                if (!transfer_current_kind(w, 10)) {
                    return false;
                }
                const TypeKey result_type = transfer_service_result(m, operation);
                const BoundsEvidence guard = empty_bounds();
                const ValueRow result_value = ValueRow(result_type, guard);
                return w.set_current(result_value);
            }
            if (operation == 6) {
                if (!transfer_current_kind(w, 7)) {
                    return false;
                }
                return transfer_set_kind(w, 10);
            }
            if (operation == 7) {
                if (!transfer_pop_kind(w, 10,
                    second_error(VerificationErrorSecond::port_write_byte_argument_type_mismatch))
                    || !transfer_pop_kind(w, 7,
                    second_error(VerificationErrorSecond::port_write_offset_argument_type_mismatch))) {
                    return false;
                }
                const TypeKey result_type = transfer_service_result(m, operation);
                const BoundsEvidence guard = empty_bounds();
                const ValueRow result_value = ValueRow(result_type, guard);
                return w.set_current(result_value);
            }
            if (operation == 4) {
                const TypeKey result_type = transfer_service_result(m, operation);
                const BoundsEvidence guard = empty_bounds();
                const ValueRow result_value = ValueRow(result_type, guard);
                return w.set_current(result_value);
            }
            if (operation == 0 || operation == 3 || operation == 5 || operation == 8 || operation == 32) {
                if ((operation == 5 || operation == 8 || operation == 32) && !transfer_current_kind(w, 7)) {
                    return false;
                }
                const i64 base = transfer_value(s, id, 2);
                if (!transfer_has(w, FactKind::object, base)) {
                    return w.fail(second_error(VerificationErrorSecond::service_observation_requires_pristine_sample));
                }
                const i64 constructed = compiler_ir_initialization::object_was_constructed(w, m, base);
                if (constructed < 0 || !w.good()) {
                    return false;
                }
                if (constructed == 1) {
                    return w.fail(second_error(VerificationErrorSecond::service_observation_requires_pristine_sample));
                }
                const i64 pristine = compiler_ir_initialization::object_pristine(w, m, base);
                if (pristine < 0 || !w.good()) {
                    return false;
                }
                if (pristine == 0) {
                    return w.fail(second_error(
                        VerificationErrorSecond::service_observation_cannot_overwrite_initialized_sample_storage));
                }
                if (!compiler_ir_initialization::mark_object(w, m, base)) {
                    return false;
                }
                return w.clear_current();
            }
            return w.fail(second_error(VerificationErrorSecond::unknown_sealed_service_operation));
        }
        if (form == 4) {
            const compiler_ir_metadata::CallableRow target = m.callable_at(transfer_target(m, s, id));
            const i64 extra = compiler_ir_instructions::call_count(s, id, 5) / 2;
            const i64 count = 1 + extra;
            i64 second = 0;
            i64 second_kind = 0;
            if (extra != 0) {
                second = transfer_lane(s, id, 5, 0);
                second_kind = transfer_lane(s, id, 5, 1);
            }
            const i64 first = transfer_value(s, id, 1);
            const ServiceCallState loans = w.validate_service_call(first, transfer_value(s, id, 4), second,
                second_kind);
            if (loans == ServiceCallState::missing) {
                return w.fail(second_error(
                    VerificationErrorSecond::service_helper_requires_distinct_acquired_loans_in_leading_positions));
            }
            if (loans == ServiceCallState::provenance) {
                return w.fail(second_error(
                    VerificationErrorSecond::service_helper_requires_an_unused_loan_with_exact_provenance));
            }
            if (!w.good()) {
                return false;
            }
            i64 reverse = target.value_parameter_count();
            while (reverse > count) {
                reverse = reverse - 1;
                const i64 type_id = target.value_parameter_begin() + reverse;
                const compiler_ir_metadata::RawTypeRow type = m.type_at(type_id);
                const i64 base = transfer_lane(s, id, 3, reverse);
                if (type.kind() == 12) {
                    if (!active_region(w, transfer_value(s, id, 7))) {
                        return false;
                    }
                } else {
                    if (type.kind() == 11) {
                        if (!transfer_has(w, FactKind::span, base)) {
                            return w.fail(second_error(VerificationErrorSecond::service_span_argument_is_not_active));
                        }
                        if (!live_span(w, m, s, base, AccessMode::read)) {
                            return false;
                        }
                    } else {
                        if (type.kind() == 5) {
                            if (!live_copied_argument(w, m, transfer_lane(s, id, 6, reverse), ArgumentRole::service)) {
                                return false;
                            }
                        } else {
                            if (!transfer_pop_type(w, m, type_id, VerificationErrorFirst::none,
                                VerificationErrorSecond::service_scalar_argument_mismatch)) {
                                return false;
                            }
                        }
                    }
                }
            }
            const compiler_ir_metadata::IndexRange types = target.types();
            const compiler_ir_metadata::RawTypeRow result = m.type_at(types.begin());
            if (result.kind() == 5) {
                if (!live_copy_target(w, m, transfer_value(s, id, 2)) || !w.clear_current()) {
                    return false;
                }
            } else {
                if (!transfer_set_type(w, m, types.begin())) {
                    return false;
                }
            }
            return w.complete_service_call(first, second);
        }
        return w.fail(first_error(VerificationErrorFirst::internal));
    }
}
