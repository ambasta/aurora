export module aurora.compiler.ir_initialization;
import aurora.compiler.ir_metadata;
import aurora.compiler.ir_metadata_storage;

// Per-function initialization facts. Metadata owns the scalar, object and receiver
// field domains; this owner stores dense physical-initialization and logical-completion
// must/may words and bounded exact service-loan snapshots. Native verification
// retains object lifetime and ownership provenance, and binds every paired call
// to the same immutable MetadataStore.
export namespace compiler_ir_initialization {
    enum class InitializationStatus {
        pending,
        success,
        allocation,
        invalid
    };
    enum class InitializationJoin {
        error,
        unchanged,
        changed
    };
    enum class ObjectCompletion {
        invalid,
        whole,
        physical,
        missing_nested,
        missing_empty
    };
    enum class ReceiverCompletion {
        invalid,
        complete,
        missing_physical,
        missing_logical
    };
    enum class ServiceCallState {
        invalid,
        ready,
        missing,
        provenance
    };
    class ServiceLoan {
        i64 loanId;
        i64 rootOffset;
        i64 serviceKind;
        i64 calledValue;
    public:
        ServiceLoan(i64 id, i64 root, i64 kind, i64 called) : loanId(id), rootOffset(root), serviceKind(kind),
            calledValue(called) {
        }
        auto id() const -> i64 {
            return loanId;
        }
        auto root() const -> i64 {
            return rootOffset;
        }
        auto kind() const -> i64 {
            return serviceKind;
        }
        auto called() const -> i64 {
            return calledValue;
        }
        auto same(ServiceLoan other) const -> bool {
            return loanId == other.id() && rootOffset == other.root() && serviceKind == other.kind() && calledValue
                == other.called();
        }
    };
    class WordPair {
        u64 mustBits;
        u64 mayBits;
    public:
        WordPair(u64 must, u64 may) : mustBits(must), mayBits(may) {
        }
        auto must_bits() const -> u64 {
            return mustBits;
        }
        auto may_bits() const -> u64 {
            return mayBits;
        }
    };
    class CountPair {
        i64 mustCount;
        i64 mayCount;
    public:
        CountPair(i64 must, i64 may) : mustCount(must), mayCount(may) {
        }
        auto must_count() const -> i64 {
            return mustCount;
        }
        auto may_count() const -> i64 {
            return mayCount;
        }
    };
    auto word_pool(builtin::ByteRegion region) -> builtin::OwnedValues<WordPair> {
        const WordPair fill = WordPair(0u64, 0u64);
        builtin::OwnedValues<WordPair> result = region.try_allocate(0, fill);
        return move(result);
    }
    auto count_pool(builtin::ByteRegion region) -> builtin::OwnedValues<CountPair> {
        const CountPair fill = CountPair(0, 0);
        builtin::OwnedValues<CountPair> result = region.try_allocate(0, fill);
        return move(result);
    }
    auto service_pool(builtin::ByteRegion region) -> builtin::OwnedValues<ServiceLoan> {
        const ServiceLoan fill = ServiceLoan(0, 0, 0, 0);
        builtin::OwnedValues<ServiceLoan> result = region.try_allocate(0, fill);
        return move(result);
    }
    // Iterate changed bits only. Unsigned subtraction is guarded by nonzero,
    // including the isolated high bit; no signed bit-63 conversion is needed.
    auto changed_count(u64 bits) -> i64 {
        u64 remaining = bits;
        i64 count = 0;
        while (remaining != 0u64) {
            remaining = remaining & (remaining - 1u64);
            count = count + 1;
        }
        return count;
    }
    class InitializationWorkspace {
        builtin::OwnedValues<WordPair> currentWords;
        builtin::OwnedValues<WordPair> retainedWords;
        builtin::OwnedValues<CountPair> retainedCounts;
        builtin::OwnedValues<ServiceLoan> serviceLoans;
        i64 callableId;
        i64 scalarBegin;
        i64 scalarCount;
        i64 objectBegin;
        i64 objectCount;
        i64 receiverBegin;
        i64 receiverCount;
        i64 serviceCapacity;
        i64 factCount;
        i64 wordCount;
        i64 retainedCount;
        i64 retainedCapacity;
        i64 currentMust;
        i64 currentMay;
        InitializationStatus statusValue;

        auto allocation_failure() -> bool {
            if (statusValue == InitializationStatus::pending || statusValue == InitializationStatus::success) {
                statusValue = InitializationStatus::allocation;
            }
            return false;
        }
        auto valid_retained(i64 id) const -> bool {
            return statusValue == InitializationStatus::success && id >= 0 && id < retainedCount;
        }
        auto service_count(i64 first) const -> i64 {
            i64 count = 0;
            i64 at = 0;
            while (at < serviceCapacity) {
                const ServiceLoan loan = serviceLoans.at(first + at);
                if (loan.id() != 0) {
                    count = count + 1;
                }
                at = at + 1;
            }
            return count;
        }
        auto service_index(i64 id) const -> i64 {
            i64 at = 0;
            while (id > 0 && at < serviceCapacity) {
                const ServiceLoan loan = serviceLoans.at(at);
                if (loan.id() == id) {
                    return at;
                }
                at = at + 1;
            }
            return -1;
        }
        auto grow_retained() -> bool {
            if (statusValue != InitializationStatus::success || retainedCount < 0 || retainedCount > retainedCapacity
                || retainedCapacity < 0 || retainedCapacity > 65536) {
                return reject();
            }
            if (retainedCount < retainedCapacity) {
                return true;
            }
            if (retainedCapacity == 65536) {
                return reject();
            }
            i64 next = 1;
            if (retainedCapacity != 0) {
                next = retainedCapacity * 2;
            }
            if (next > 65536) {
                next = 65536;
            }
            if (wordCount < 0 || (wordCount != 0 && next > 9223372036854775807 / wordCount)) {
                return reject();
            }
            const i64 words = next * wordCount;
            // Both copied rows contain exactly two eight-byte scalar leaves.
            // Generated native layout facts separately pin these widths.
            if (words > 9223372036854775807 / 16 || next > 9223372036854775807 / 16) {
                return reject();
            }
            const WordPair empty_words = WordPair(0u64, 0u64);
            const CountPair empty_counts = CountPair(0, 0);
            // Each replacement preserves its old prefix. A later failure is
            // terminal; the actual, possibly enlarged owners still close normally.
            // With zero slots, the unchanged zero-length word owner never grows.
            if (!retainedWords.try_resize(words, empty_words)) {
                return allocation_failure();
            }
            if (!retainedCounts.try_resize(next, empty_counts)) {
                return allocation_failure();
            }
            // The current prefix and every retained row share one bounded pool.
            // Loan IDs are values, never indices or allocation extents.
            if (serviceCapacity != 0) {
                const ServiceLoan empty = ServiceLoan(0, 0, 0, 0);
                if (!serviceLoans.try_resize((next + 1) * serviceCapacity, empty)) {
                    return allocation_failure();
                }
            }
            retainedCapacity = next;
            return true;
        }
    public:
        InitializationWorkspace(builtin::ByteRegion region) : currentWords(word_pool(region)),
            retainedWords(word_pool(region)), retainedCounts(count_pool(region)), serviceLoans(service_pool(region)),
            callableId(-1), scalarBegin(0), scalarCount(0), objectBegin(0), objectCount(0), receiverBegin(-1),
            receiverCount(0), serviceCapacity(0), factCount(0), wordCount(0), retainedCount(0), retainedCapacity(0),
            currentMust(0), currentMay(0), statusValue(InitializationStatus::pending) {
        }
        auto allocated() const -> bool {
            return currentWords.ok() && retainedWords.ok() && retainedCounts.ok() && serviceLoans.ok();
        }
        auto status() const -> InitializationStatus {
            return statusValue;
        }
        auto reject() -> bool {
            if (statusValue == InitializationStatus::pending || statusValue == InitializationStatus::success) {
                statusValue = InitializationStatus::invalid;
            }
            return false;
        }
        auto prepare() -> bool {
            if (statusValue != InitializationStatus::pending) {
                return false;
            }
            if (!allocated()) {
                return allocation_failure();
            }
            return true;
        }
        // Only initialize(metadata, callable) supplies these canonical groups.
        // Their extents are not another offset index or native payload view.
        auto configure(i64 callable, compiler_ir_metadata::IndexRange scalars, compiler_ir_metadata::IndexRange objects,
            compiler_ir_metadata::IndexRange receiver, i64 services) -> bool {
            const i64 first = scalars.begin();
            const i64 count = scalars.count();
            const i64 object_first = objects.begin();
            const i64 object_count = objects.count();
            const i64 locals = compiler_ir_metadata::count_sum(count, object_count);
            const i64 facts = compiler_ir_metadata::count_sum(locals, receiver.count());
            if (statusValue != InitializationStatus::pending || callable < 0 || first < 0 || count < 0 || count > 65536
                || object_first < 0 || object_count < 0 || object_count > 8192 || receiver.begin() < -1
                || receiver.count() < 0 || (receiver.begin() == -1 && receiver.count() != 0) || facts < 0 || facts
                > 9223372036854775807 / 2 || callableId != -1 || currentWords.size() != 0 || retainedWords.size() != 0
                || retainedCounts.size() != 0 || serviceLoans.size() != 0 || services < 0 || services > 2) {
                return reject();
            }
            if (!prepare()) {
                return false;
            }
            i64 words = facts / 64;
            if (facts % 64 != 0) {
                words = words + 1;
            }
            const WordPair fill = WordPair(0u64, 0u64);
            if (!currentWords.try_resize(words, fill)) {
                return allocation_failure();
            }
            if (services != 0) {
                const ServiceLoan empty = ServiceLoan(0, 0, 0, 0);
                if (!serviceLoans.try_resize(services, empty)) {
                    return allocation_failure();
                }
            }
            callableId = callable;
            scalarBegin = first;
            scalarCount = count;
            objectBegin = object_first;
            objectCount = object_count;
            receiverBegin = receiver.begin();
            receiverCount = receiver.count();
            serviceCapacity = services;
            factCount = facts;
            wordCount = words;
            statusValue = InitializationStatus::success;
            return true;
        }
        auto callable() const -> i64 {
            return callableId;
        }
        auto scalar_begin() const -> i64 {
            return scalarBegin;
        }
        auto object_begin() const -> i64 {
            return objectBegin;
        }
        auto object_count() const -> i64 {
            return objectCount;
        }
        auto receiver_begin() const -> i64 {
            return receiverBegin;
        }
        auto receiver_count() const -> i64 {
            return receiverCount;
        }
        auto receiver_index(i64 field) const -> i64 {
            if (statusValue != InitializationStatus::success || receiverBegin < 0 || field < 0 || field
                >= receiverCount) {
                return -1;
            }
            return factCount - receiverCount + field;
        }
        auto slot_count() const -> i64 {
            if (statusValue != InitializationStatus::success) {
                return -1;
            }
            return scalarCount;
        }
        auto word_count() const -> i64 {
            if (statusValue != InitializationStatus::success) {
                return -1;
            }
            return wordCount;
        }
        auto retained_count() const -> i64 {
            if (statusValue != InitializationStatus::success) {
                return -1;
            }
            return retainedCount;
        }
        auto retained_capacity() const -> i64 {
            return retainedCapacity;
        }
        auto current_must_count() const -> i64 {
            if (statusValue != InitializationStatus::success) {
                return -1;
            }
            return currentMust;
        }
        auto current_may_count() const -> i64 {
            if (statusValue != InitializationStatus::success) {
                return -1;
            }
            return currentMay;
        }
        auto current_count() const -> i64 {
            if (statusValue != InitializationStatus::success) {
                return -1;
            }
            return compiler_ir_metadata::count_sum(currentMust + currentMay, service_count(0));
        }
        auto retained_must_count(i64 id) const -> i64 {
            if (!valid_retained(id)) {
                return -1;
            }
            const CountPair counts = retainedCounts.at(id);
            return counts.must_count();
        }
        auto retained_may_count(i64 id) const -> i64 {
            if (!valid_retained(id)) {
                return -1;
            }
            const CountPair counts = retainedCounts.at(id);
            return counts.may_count();
        }
        auto retained_count_at(i64 id) const -> i64 {
            if (!valid_retained(id)) {
                return -1;
            }
            const CountPair counts = retainedCounts.at(id);
            return compiler_ir_metadata::count_sum(counts.must_count() + counts.may_count(), service_count((id + 1)
                * serviceCapacity));
        }
        auto payload_bytes() const -> i64 {
            if (statusValue != InitializationStatus::success) {
                return -1;
            }
            // Generated layout validation independently pins these row widths.
            return compiler_ir_metadata::count_sum(wordCount * 16, serviceCapacity * 32);
        }
        auto acquire_service_loan(i64 id, i64 root, i64 kind) -> i64 {
            if (statusValue != InitializationStatus::success || id <= 0 || root <= 0 || kind < 0 || kind > 4) {
                reject();
                return -1;
            }
            if (service_index(id) >= 0 || service_unsuspended(root) == 0) {
                return 0;
            }
            const i64 count = service_count(0);
            if (count == serviceCapacity) {
                return 0;
            }
            const ServiceLoan acquired = ServiceLoan(id, root, kind, 0);
            i64 position = count;
            // At most two canonical records; opposite acquisition orders agree.
            if (count == 1) {
                const ServiceLoan first = serviceLoans.at(0);
                if (id < first.id()) {
                    if (!serviceLoans.set(1, first)) {
                        reject();
                        return -1;
                    }
                    position = 0;
                }
            }
            if (!serviceLoans.set(position, acquired)) {
                reject();
                return -1;
            }
            return 1;
        }
        auto release_service_loan(i64 id, i64 kind) -> i64 {
            if (statusValue != InitializationStatus::success) {
                return -1;
            }
            const i64 index = service_index(id);
            if (index < 0) {
                return 0;
            }
            const ServiceLoan loan = serviceLoans.at(index);
            if (loan.called() != 1 || loan.kind() != kind) {
                return 0;
            }
            const i64 last = service_count(0) - 1;
            if (index != last) {
                const ServiceLoan remaining = serviceLoans.at(last);
                if (!serviceLoans.set(index, remaining)) {
                    reject();
                    return -1;
                }
            }
            const ServiceLoan empty = ServiceLoan(0, 0, 0, 0);
            if (!serviceLoans.set(last, empty)) {
                reject();
                return -1;
            }
            return 1;
        }
        auto service_unsuspended(i64 root) const -> i64 {
            if (statusValue != InitializationStatus::success) {
                return -1;
            }
            i64 at = 0;
            while (at < serviceCapacity) {
                const ServiceLoan loan = serviceLoans.at(at);
                if (loan.id() != 0 && loan.root() == root) {
                    return 0;
                }
                at = at + 1;
            }
            return 1;
        }
        auto validate_service_call(i64 first, i64 first_kind, i64 second, i64 second_kind) const -> ServiceCallState {
            if (statusValue != InitializationStatus::success) {
                return ServiceCallState::invalid;
            }
            const i64 first_index = service_index(first);
            if (first_index < 0) {
                return ServiceCallState::missing;
            }
            const ServiceLoan first_loan = serviceLoans.at(first_index);
            if (first_loan.called() != 0 || first_loan.kind() != first_kind) {
                return ServiceCallState::provenance;
            }
            if (second != 0) {
                const i64 second_index = service_index(second);
                if (second_index < 0) {
                    return ServiceCallState::missing;
                }
                const ServiceLoan second_loan = serviceLoans.at(second_index);
                if (second_loan.called() != 0 || second_loan.kind() != second_kind || first_loan.root()
                    == second_loan.root()) {
                    return ServiceCallState::provenance;
                }
            }
            return ServiceCallState::ready;
        }
        auto complete_service_call(i64 first, i64 second) -> bool {
            if (statusValue != InitializationStatus::success) {
                return reject();
            }
            i64 count = 1;
            if (second != 0) {
                count = 2;
            }
            i64 at = 0;
            while (at < count) {
                i64 id = first;
                if (at == 1) {
                    id = second;
                }
                const i64 index = service_index(id);
                if (index < 0) {
                    return reject();
                }
                const ServiceLoan loan = serviceLoans.at(index);
                if (loan.called() != 0) {
                    return reject();
                }
                const ServiceLoan called = ServiceLoan(loan.id(), loan.root(), loan.kind(), 1);
                if (!serviceLoans.set(index, called)) {
                    return reject();
                }
                at = at + 1;
            }
            return true;
        }
        auto service_loans_closed() const -> i64 {
            if (statusValue != InitializationStatus::success) {
                return -1;
            }
            if (service_count(0) == 0) {
                return 1;
            }
            return 0;
        }
        auto same_service_loans(i64 id) const -> i64 {
            if (!valid_retained(id)) {
                return -1;
            }
            const i64 first =(id + 1) * serviceCapacity;
            i64 at = 0;
            while (at < serviceCapacity) {
                const ServiceLoan current = serviceLoans.at(at);
                const ServiceLoan retained = serviceLoans.at(first + at);
                if (!current.same(retained)) {
                    return 0;
                }
                at = at + 1;
            }
            return 1;
        }
        // Dense-index helpers are source-internal semantic operations. Native
        // callers use metadata-paired batches, never one bridge per bit.
        auto index_state(i64 index) -> i64 {
            if (statusValue != InitializationStatus::success || index < 0 || index >= factCount) {
                reject();
                return -1;
            }
            const WordPair word = currentWords.at(index / 64);
            const u64 mask = 1u64 << (index % 64);
            i64 state = 0;
            if ((word.must_bits() & mask) != 0u64) {
                state = state + 1;
            }
            if ((word.may_bits() & mask) != 0u64) {
                state = state + 2;
            }
            return state;
        }
        auto write_index(i64 index) -> i64 {
            if (statusValue != InitializationStatus::success || index < 0 || index >= factCount) {
                reject();
                return -1;
            }
            const WordPair old = currentWords.at(index / 64);
            const u64 mask = 1u64 << (index % 64);
            i64 previous = 0;
            if ((old.must_bits() & mask) != 0u64) {
                previous = previous + 1;
            }
            if ((old.may_bits() & mask) != 0u64) {
                previous = previous + 2;
            }
            if (previous == 3) {
                return previous;
            }
            const WordPair updated = WordPair(old.must_bits() | mask, old.may_bits() | mask);
            if (!currentWords.set(index / 64, updated)) {
                reject();
                return -1;
            }
            if (previous == 0 || previous == 2) {
                currentMust = currentMust + 1;
            }
            if (previous < 2) {
                currentMay = currentMay + 1;
            }
            return previous;
        }
        auto clear_index(i64 index) -> bool {
            if (statusValue != InitializationStatus::success || index < 0 || index >= factCount) {
                return reject();
            }
            const WordPair old = currentWords.at(index / 64);
            const u64 mask = 1u64 << (index % 64);
            const bool must =(old.must_bits() & mask) != 0u64;
            const bool may =(old.may_bits() & mask) != 0u64;
            if (!must && !may) {
                return true;
            }
            const WordPair updated = WordPair(old.must_bits() & ~mask, old.may_bits() & ~mask);
            if (!currentWords.set(index / 64, updated)) {
                return reject();
            }
            if (must) {
                currentMust = currentMust - 1;
            }
            if (may) {
                currentMay = currentMay - 1;
            }
            return true;
        }
        auto load(i64 id) -> bool {
            if (!valid_retained(id)) {
                return reject();
            }
            const i64 first = id * wordCount;
            i64 at = 0;
            while (at < wordCount) {
                const WordPair word = retainedWords.at(first + at);
                if (!currentWords.set(at, word)) {
                    return reject();
                }
                at = at + 1;
            }
            const CountPair counts = retainedCounts.at(id);
            currentMust = counts.must_count();
            currentMay = counts.may_count();
            at = 0;
            while (at < serviceCapacity) {
                const ServiceLoan loan = serviceLoans.at((id + 1) * serviceCapacity + at);
                if (!serviceLoans.set(at, loan)) {
                    return reject();
                }
                at = at + 1;
            }
            return true;
        }
        auto retain() -> i64 {
            if (statusValue != InitializationStatus::success) {
                reject();
                return -1;
            }
            if (!grow_retained()) {
                return -1;
            }
            const i64 first = retainedCount * wordCount;
            i64 at = 0;
            while (at < wordCount) {
                const WordPair word = currentWords.at(at);
                if (!retainedWords.set(first + at, word)) {
                    reject();
                    return -1;
                }
                at = at + 1;
            }
            const CountPair counts = CountPair(currentMust, currentMay);
            if (!retainedCounts.set(retainedCount, counts)) {
                reject();
                return -1;
            }
            at = 0;
            while (at < serviceCapacity) {
                const ServiceLoan loan = serviceLoans.at(at);
                if (!serviceLoans.set((retainedCount + 1) * serviceCapacity + at, loan)) {
                    reject();
                    return -1;
                }
                at = at + 1;
            }
            // Publish the monotonic ordinal only after all growths and all
            // copies succeed. Snapshots remain owned until function teardown.
            const i64 id = retainedCount;
            retainedCount = retainedCount + 1;
            return id;
        }
        auto join(i64 id) -> InitializationJoin {
            if (!valid_retained(id)) {
                reject();
                return InitializationJoin::error;
            }
            const CountPair old_counts = retainedCounts.at(id);
            i64 must = old_counts.must_count();
            i64 may = old_counts.may_count();
            bool changed = false;
            const i64 first = id * wordCount;
            i64 at = 0;
            while (at < wordCount) {
                const WordPair existing = retainedWords.at(first + at);
                const WordPair incoming = currentWords.at(at);
                const u64 next_must = existing.must_bits() & incoming.must_bits();
                const u64 next_may = existing.may_bits() | incoming.may_bits();
                const u64 removed = existing.must_bits() ^ next_must;
                const u64 added = existing.may_bits() ^ next_may;
                if (removed != 0u64 || added != 0u64) {
                    const WordPair updated = WordPair(next_must, next_may);
                    if (!retainedWords.set(first + at, updated)) {
                        reject();
                        return InitializationJoin::error;
                    }
                    must = must - changed_count(removed);
                    may = may + changed_count(added);
                    changed = true;
                }
                at = at + 1;
            }
            if (!changed) {
                return InitializationJoin::unchanged;
            }
            const CountPair counts = CountPair(must, may);
            if (!retainedCounts.set(id, counts)) {
                reject();
                return InitializationJoin::error;
            }
            // A lost must bit and gained may bit can cancel in the combined
            // cardinality. Change is a wordwise fact, never a count comparison.
            return InitializationJoin::changed;
        }
        // Only checked dense indices set bits. Zero-filled growth, independent
        // copies, clear, AND and OR preserve zero unused tail bits permanently.
    };
    auto create(builtin::ByteRegion region) -> InitializationWorkspace {
        InitializationWorkspace result = InitializationWorkspace(region);
        result.prepare();
        return move(result);
    }
    auto release(builtin::ByteRegion region, InitializationWorkspace workspace) -> i64 {
        return 0;
    }

    auto initialize(InitializationWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 callable) -> InitializationStatus {
        if (workspace.status() != InitializationStatus::pending) {
            workspace.reject();
            return workspace.status();
        }
        if (!workspace.prepare()) {
            return workspace.status();
        }
        if (metadata.status() != compiler_ir_metadata::MetadataStatus::success || callable < 0 || callable
            >= metadata.callable_count()) {
            workspace.reject();
            return workspace.status();
        }
        const compiler_ir_metadata::CallableRow declaration = metadata.callable_at(callable);
        const compiler_ir_metadata::IndexRange slots = compiler_ir_metadata::slot_group(metadata, declaration, 10);
        const compiler_ir_metadata::IndexRange objects = compiler_ir_metadata::slot_group(metadata, declaration, 11);
        if (declaration.frame_bytes() < 0 || declaration.frame_bytes() > 65536 || slots.count()
            > declaration.frame_bytes() || !compiler_ir_metadata::index_range(slots, metadata.slot_count())
            || objects.count() > declaration.frame_bytes() / 8 || !compiler_ir_metadata::index_range(objects,
            metadata.slot_count())) {
            workspace.reject();
            return workspace.status();
        }
        const compiler_ir_metadata::FlagMasks masks = compiler_ir_metadata::FlagMasks();
        i64 receiver_class = -1;
        bool seeded = false;
        if (declaration.borrowed_root_count() != 0) {
            const compiler_ir_metadata::RawTypeRow type = metadata.type_at(declaration.borrowed_root_type(0));
            if (type.kind() == 5) {
                receiver_class = compiler_ir_metadata::find_class(metadata, type.name());
                seeded = true;
            }
        } else {
            if (compiler_ir_metadata::callable_flag(declaration, masks.callable_receiver())) {
                const compiler_ir_metadata::ReceiverShape receiver = declaration.first_receiver();
                receiver_class = compiler_ir_metadata::find_class(metadata, receiver.name());
                seeded = !compiler_ir_metadata::receiver_flag(receiver, masks.receiver_constructor());
            }
        }
        i64 receiver_begin = -1;
        i64 receiver_count = 0;
        if (receiver_class >= 0) {
            const compiler_ir_metadata::ClassResultRow result = metadata.result_at(receiver_class);
            const compiler_ir_metadata::IndexRange fields = result.fields();
            receiver_begin = fields.begin();
            receiver_count = fields.count();
        }
        const compiler_ir_metadata::IndexRange fields = compiler_ir_metadata::IndexRange(receiver_begin,
            receiver_count);
        i64 services = 0;
        bool leading = true;
        while (leading && services < declaration.value_parameter_count()) {
            const compiler_ir_metadata::RawTypeRow type = metadata.type_at(declaration.value_parameter_begin()
                + services);
            if (compiler_ir_metadata::service_type(type)) {
                services = services + 1;
            } else {
                leading = false;
            }
        }
        if (!workspace.configure(callable, slots, objects, fields, services)) {
            return workspace.status();
        }
        if (seeded) {
            i64 field = 0;
            while (field < fields.count()) {
                const compiler_ir_metadata::FieldRow row = metadata.field_at(fields.begin() + field);
                const compiler_ir_metadata::RawTypeRow type = metadata.type_at(row.type());
                // Resource fields have no physical/logical initialization facts;
                // their live region tokens remain a separate native authority.
                if (row.length() > 0 || type.kind() == 5) {
                    if (workspace.write_index(workspace.receiver_index(field)) < 0) {
                        return workspace.status();
                    }
                }
                field = field + 1;
            }
        }
        return workspace.status();
    }
    auto ready(InitializationWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata) -> bool {
        if (workspace.status() != InitializationStatus::success || metadata.status()
            != compiler_ir_metadata::MetadataStatus::success || workspace.callable() < 0 || workspace.callable()
            >= metadata.callable_count()) {
            return workspace.reject();
        }
        return true;
    }
    auto scalar_index(InitializationWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 offset) -> i64 {
        if (!ready(workspace, metadata)) {
            return -1;
        }
        const compiler_ir_metadata::IndexRange slots = compiler_ir_metadata::IndexRange(workspace.scalar_begin(),
            workspace.slot_count());
        const i64 found = compiler_ir_metadata::find_slot(metadata, slots, offset);
        if (found < 0) {
            workspace.reject();
            return -1;
        }
        return found - slots.begin();
    }
    // A scalar query returns both facts in one crossing: must=1, may=2.
    auto scalar_state(InitializationWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 offset) -> i64 {
        if (!ready(workspace, metadata)) {
            return -1;
        }
        const compiler_ir_metadata::IndexRange slots = compiler_ir_metadata::IndexRange(workspace.scalar_begin(),
            workspace.slot_count());
        const i64 found = compiler_ir_metadata::find_slot(metadata, slots, offset);
        // Membership of an undeclared offset is false, matching the old fact
        // set's observation contract. Insertion still rejects an unknown slot.
        if (found < 0) {
            return 0;
        }
        return workspace.index_state(found - slots.begin());
    }
    // Return the previous pair while marking both, so immutable-write checks
    // need one crossing. A native rejection ends verification; no state is
    // subsequently retained or published after that diagnostic.
    auto write_scalar(InitializationWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 offset) -> i64 {
        const i64 index = scalar_index(workspace, metadata, offset);
        if (index < 0) {
            return -1;
        }
        return workspace.write_index(index);
    }
    auto object_index(InitializationWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 base) -> i64 {
        if (!ready(workspace, metadata)) {
            return -1;
        }
        const compiler_ir_metadata::IndexRange objects = compiler_ir_metadata::IndexRange(workspace.object_begin(),
            workspace.object_count());
        const i64 found = compiler_ir_metadata::find_slot(metadata, objects, base);
        if (found < 0) {
            workspace.reject();
        }
        return found;
    }
    // Local object completion has one must bit and one may-history bit. Every
    // complete copy/construction initializes all logical fields together, so no
    // per-field completion table is needed. Physical scalar writes do not mint it.
    auto object_was_constructed(InitializationWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 base) -> i64 {
        const i64 index = object_index(workspace, metadata, base);
        if (index < 0) {
            return -1;
        }
        const i64 state = workspace.index_state(workspace.slot_count() + index - workspace.object_begin());
        if (state < 0) {
            return -1;
        }
        if (state >= 2) {
            return 1;
        }
        return 0;
    }
    auto object_completion(InitializationWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 base) -> ObjectCompletion {
        const i64 index = object_index(workspace, metadata, base);
        if (index < 0) {
            return ObjectCompletion::invalid;
        }
        const i64 state = workspace.index_state(workspace.slot_count() + index - workspace.object_begin());
        if (state < 0) {
            return ObjectCompletion::invalid;
        }
        if (state == 3) {
            return ObjectCompletion::whole;
        }
        const compiler_ir_metadata::SlotRow object = metadata.slot_at(index);
        const compiler_ir_metadata::RawTypeRow type = metadata.type_at(object.type());
        const i64 class_index = compiler_ir_metadata::find_class(metadata, type.name());
        const compiler_ir_metadata::ClassResultRow result = metadata.result_at(class_index);
        const compiler_ir_metadata::IndexRange fields = result.fields();
        i64 at = 0;
        while (at < fields.count()) {
            const compiler_ir_metadata::FieldRow field = metadata.field_at(fields.begin() + at);
            const compiler_ir_metadata::RawTypeRow element = metadata.type_at(field.type());
            if (element.kind() == 5) {
                return ObjectCompletion::missing_nested;
            }
            at = at + 1;
        }
        const compiler_ir_metadata::ClassRow declaration = metadata.class_at(class_index);
        const compiler_ir_metadata::IndexRange leaves = declaration.leaves();
        if (leaves.count() == 0) {
            return ObjectCompletion::missing_empty;
        }
        return ObjectCompletion::physical;
    }
    // 0 checks all must bits, 1 checks no may bits, 2 marks both, 3 clears both.
    // The two queries remain physical-only. Mark/clear also update logical
    // completion; its separate query preserves diagnostic order and leafless
    // objects' distinct construction requirement.
    auto object_action(InitializationWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 base, i64 action) -> i64 {
        if (action < 0 || action > 3) {
            workspace.reject();
            return -1;
        }
        const i64 index = object_index(workspace, metadata, base);
        if (index < 0) {
            return -1;
        }
        const compiler_ir_metadata::SlotRow object = metadata.slot_at(index);
        const compiler_ir_metadata::StorageRow storage = compiler_ir_metadata::object_storage(metadata, object);
        const compiler_ir_metadata::IndexRange leaves = storage.leaf_offsets();
        i64 at = 0;
        while (at < leaves.count()) {
            const compiler_ir_metadata::IndexRow leaf = metadata.index_at(leaves.begin() + at);
            const i64 scalar = scalar_index(workspace, metadata, base - leaf.value());
            if (scalar < 0) {
                return -1;
            }
            if (action == 2) {
                if (workspace.write_index(scalar) < 0) {
                    return -1;
                }
            } else {
                if (action == 3) {
                    if (!workspace.clear_index(scalar)) {
                        return -1;
                    }
                } else {
                    const i64 state = workspace.index_state(scalar);
                    if (state < 0) {
                        return -1;
                    }
                    if ((action == 0 && (state == 0 || state == 2)) || (action == 1 && state >= 2)) {
                        return 0;
                    }
                }
            }
            at = at + 1;
        }
        const i64 completion = workspace.slot_count() + index - workspace.object_begin();
        if (action == 2 && workspace.write_index(completion) < 0) {
            return -1;
        }
        if (action == 3 && !workspace.clear_index(completion)) {
            return -1;
        }
        return 1;
    }
    auto object_initialized(InitializationWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 base) -> i64 {
        return object_action(workspace, metadata, base, 0);
    }
    auto object_pristine(InitializationWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 base) -> i64 {
        return object_action(workspace, metadata, base, 1);
    }
    auto mark_object(InitializationWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 base) -> bool {
        return object_action(workspace, metadata, base, 2) == 1;
    }
    auto clear_object(InitializationWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 base) -> bool {
        return object_action(workspace, metadata, base, 3) == 1;
    }

    // Every receiver initializer writes a whole direct field. Disjoint admitted
    // leaf ranges and AND/OR joins preserve that invariant, including class
    // arrays. One field pair therefore replaces both physical-leaf and logical
    // class-field sets; zero-leaf class fields still have distinct bits.
    // Observation bits: physical must=1, physical may=2, logical must=4, logical may=8.
    auto receiver_action(InitializationWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 field, bool write) -> i64 {
        if (!ready(workspace, metadata)) {
            return -1;
        }
        const i64 index = workspace.receiver_index(field);
        if (index < 0) {
            workspace.reject();
            return -1;
        }
        const compiler_ir_metadata::FieldRow row = metadata.field_at(workspace.receiver_begin() + field);
        const compiler_ir_metadata::RawTypeRow type = metadata.type_at(row.type());
        const bool logical = type.kind() == 5;
        if (write && row.length() == 0 && !logical) {
            workspace.reject();
            return -1;
        }
        i64 state = 0;
        if (write) {
            state = workspace.write_index(index);
        } else {
            state = workspace.index_state(index);
        }
        if (state < 0) {
            return -1;
        }
        const bool must = state == 3;
        const bool may = state >= 2;
        i64 result = 0;
        if (row.length() == 0 || must) {
            result = result + 1;
        }
        if (row.length() > 0 && may) {
            result = result + 2;
        }
        if (logical && must) {
            result = result + 4;
        }
        if (logical && may) {
            result = result + 8;
        }
        return result;
    }
    auto receiver_field_state(InitializationWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 field) -> i64 {
        return receiver_action(workspace, metadata, field, false);
    }
    auto write_receiver_field(InitializationWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 field) -> i64 {
        return receiver_action(workspace, metadata, field, true);
    }
    auto receiver_completion(InitializationWorkspace& workspace,
        const compiler_ir_metadata::MetadataStore& metadata) -> ReceiverCompletion {
        if (!ready(workspace, metadata) || workspace.receiver_begin() < 0) {
            workspace.reject();
            return ReceiverCompletion::invalid;
        }
        bool missing_logical = false;
        i64 field = 0;
        while (field < workspace.receiver_count()) {
            const i64 state = workspace.index_state(workspace.receiver_index(field));
            if (state < 0) {
                return ReceiverCompletion::invalid;
            }
            if (state != 3) {
                const compiler_ir_metadata::FieldRow row = metadata.field_at(workspace.receiver_begin() + field);
                if (row.length() > 0) {
                    return ReceiverCompletion::missing_physical;
                }
                const compiler_ir_metadata::RawTypeRow type = metadata.type_at(row.type());
                missing_logical = missing_logical || type.kind() == 5;
            }
            field = field + 1;
        }
        if (missing_logical) {
            return ReceiverCompletion::missing_logical;
        }
        return ReceiverCompletion::complete;
    }

    auto array_range(InitializationWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 offset, i64 length, i64 width) -> bool {
        if (!ready(workspace, metadata)) {
            return false;
        }
        const compiler_ir_metadata::CallableRow declaration = metadata.callable_at(workspace.callable());
        if ((width != 1 && width != 8) || length < 0 || length > 65536 || offset < 0 || offset
            > declaration.frame_bytes() || (length != 0 && (offset == 0 || length - 1 > (offset - 1) / width))) {
            return workspace.reject();
        }
        return true;
    }
    // -2 denotes failure, -1 complete, otherwise the first forward element
    // ordinal. Native code interleaves its lifetime/loan checks through exactly
    // that element before reporting missing initialization.
    auto array_first_missing(InitializationWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 offset, i64 length, i64 width) -> i64 {
        if (!array_range(workspace, metadata, offset, length, width)) {
            return -2;
        }
        i64 element = 0;
        while (element < length) {
            const i64 scalar = scalar_index(workspace, metadata, offset - element * width);
            if (scalar < 0) {
                return -2;
            }
            const i64 state = workspace.index_state(scalar);
            if (state < 0) {
                return -2;
            }
            if (state == 0 || state == 2) {
                return element;
            }
            element = element + 1;
        }
        return -1;
    }
    auto clear_array(InitializationWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 offset, i64 length, i64 width) -> bool {
        if (!array_range(workspace, metadata, offset, length, width)) {
            return false;
        }
        i64 element = 0;
        while (element < length) {
            const i64 scalar = scalar_index(workspace, metadata, offset - element * width);
            if (scalar < 0 || !workspace.clear_index(scalar)) {
                return false;
            }
            element = element + 1;
        }
        return true;
    }
}
