export module aurora.compiler.ir_initialization;
import aurora.compiler.ir_metadata;
import aurora.compiler.ir_metadata_storage;

// Per-function initialization facts. Metadata owns the sole sorted scalar-slot
// domain; this owner stores only dense must/may words and retained cardinalities.
// Native verification retains lifetime, provenance and logical empty-object
// completion, and binds every paired call to the same immutable MetadataStore.
export namespace compiler_ir_initialization {
    enum class InitializationStatus { pending, success, allocation, invalid };
    enum class InitializationJoin { error, unchanged, changed };
    class WordPair {
        u64 mustBits;
        u64 mayBits;
    public:
        WordPair(u64 must, u64 may) : mustBits(must), mayBits(may) {}
        auto must_bits() const -> u64 { return mustBits; }
        auto may_bits() const -> u64 { return mayBits; }
    };
    class CountPair {
        i64 mustCount;
        i64 mayCount;
    public:
        CountPair(i64 must, i64 may) : mustCount(must), mayCount(may) {}
        auto must_count() const -> i64 { return mustCount; }
        auto may_count() const -> i64 { return mayCount; }
    };
    auto word_pool(builtin::ByteRegion region) -> builtin::OwnedValues<WordPair> {
        const WordPair fill = WordPair(0u64, 0u64);
        builtin::OwnedValues<WordPair> result = region.try_allocate(0, fill);
        return move(result);
    }
    auto count_pool(builtin::ByteRegion region) -> builtin::OwnedValues<CountPair> {
        const CountPair fill = CountPair(0, 0);
        builtin::OwnedValues<CountPair> result = region.try_allocate(0, fill);
        return move(result);
    }
    // Iterate changed bits only. Unsigned subtraction is guarded by nonzero,
    // including the isolated high bit; no signed bit-63 conversion is needed.
    auto changed_count(u64 bits) -> i64 {
        u64 remaining = bits;
        i64 count = 0;
        while (remaining != 0u64) {
            remaining = remaining & (remaining - 1u64);
            count = count + 1;
        }
        return count;
    }
    class InitializationWorkspace {
        builtin::OwnedValues<WordPair> currentWords;
        builtin::OwnedValues<WordPair> retainedWords;
        builtin::OwnedValues<CountPair> retainedCounts;
        i64 callableId;
        i64 scalarBegin;
        i64 scalarCount;
        i64 wordCount;
        i64 retainedCount;
        i64 retainedCapacity;
        i64 currentMust;
        i64 currentMay;
        InitializationStatus statusValue;

        auto allocation_failure() -> bool {
            if (statusValue == InitializationStatus::pending || statusValue == InitializationStatus::success) {
                statusValue = InitializationStatus::allocation;
            }
            return false;
        }
        auto valid_retained(i64 id) const -> bool {
            return statusValue == InitializationStatus::success && id >= 0 && id < retainedCount;
        }
        auto grow_retained() -> bool {
            if (statusValue != InitializationStatus::success || retainedCount < 0
                || retainedCount > retainedCapacity || retainedCapacity < 0 || retainedCapacity > 65536) {
                return reject();
            }
            if (retainedCount < retainedCapacity) { return true; }
            if (retainedCapacity == 65536) { return reject(); }
            i64 next = 1;
            if (retainedCapacity != 0) { next = retainedCapacity * 2; }
            if (next > 65536) { next = 65536; }
            if (wordCount < 0 || wordCount > 1024
                || (wordCount != 0 && next > 9223372036854775807 / wordCount)) { return reject(); }
            const i64 words = next * wordCount;
            // Both copied rows contain exactly two eight-byte scalar leaves.
            // Generated native layout facts separately pin these widths.
            if (words > 9223372036854775807 / 16 || next > 9223372036854775807 / 16) { return reject(); }
            const WordPair empty_words = WordPair(0u64, 0u64);
            const CountPair empty_counts = CountPair(0, 0);
            // Each replacement preserves its old prefix. A later failure is
            // terminal; the actual, possibly enlarged owners still close normally.
            // With zero slots, the unchanged zero-length word owner never grows.
            if (!retainedWords.try_resize(words, empty_words)) { return allocation_failure(); }
            if (!retainedCounts.try_resize(next, empty_counts)) { return allocation_failure(); }
            retainedCapacity = next;
            return true;
        }
    public:
        InitializationWorkspace(builtin::ByteRegion region) : currentWords(word_pool(region)),
            retainedWords(word_pool(region)), retainedCounts(count_pool(region)), callableId(-1), scalarBegin(0),
            scalarCount(0), wordCount(0), retainedCount(0), retainedCapacity(0), currentMust(0), currentMay(0),
            statusValue(InitializationStatus::pending) {}
        auto allocated() const -> bool {
            return currentWords.ok() && retainedWords.ok() && retainedCounts.ok();
        }
        auto status() const -> InitializationStatus { return statusValue; }
        auto reject() -> bool {
            if (statusValue == InitializationStatus::pending || statusValue == InitializationStatus::success) {
                statusValue = InitializationStatus::invalid;
            }
            return false;
        }
        auto prepare() -> bool {
            if (statusValue != InitializationStatus::pending) { return false; }
            if (!allocated()) { return allocation_failure(); }
            return true;
        }
        // Only initialize(metadata, callable) supplies this canonical group.
        // This is a scalar extent, never a second offset index or payload view.
        auto configure(i64 callable, i64 first, i64 count) -> bool {
            if (statusValue != InitializationStatus::pending || callable < 0 || first < 0
                || count < 0 || count > 65536 || callableId != -1
                || currentWords.size() != 0 || retainedWords.size() != 0 || retainedCounts.size() != 0) {
                return reject();
            }
            if (!prepare()) { return false; }
            i64 words = count / 64;
            if (count % 64 != 0) { words = words + 1; }
            const WordPair fill = WordPair(0u64, 0u64);
            if (!currentWords.try_resize(words, fill)) { return allocation_failure(); }
            callableId = callable;
            scalarBegin = first;
            scalarCount = count;
            wordCount = words;
            statusValue = InitializationStatus::success;
            return true;
        }
        auto callable() const -> i64 { return callableId; }
        auto scalar_begin() const -> i64 { return scalarBegin; }
        auto slot_count() const -> i64 {
            if (statusValue != InitializationStatus::success) { return -1; }
            return scalarCount;
        }
        auto word_count() const -> i64 {
            if (statusValue != InitializationStatus::success) { return -1; }
            return wordCount;
        }
        auto retained_count() const -> i64 {
            if (statusValue != InitializationStatus::success) { return -1; }
            return retainedCount;
        }
        auto retained_capacity() const -> i64 { return retainedCapacity; }
        auto current_must_count() const -> i64 {
            if (statusValue != InitializationStatus::success) { return -1; }
            return currentMust;
        }
        auto current_may_count() const -> i64 {
            if (statusValue != InitializationStatus::success) { return -1; }
            return currentMay;
        }
        auto current_count() const -> i64 {
            if (statusValue != InitializationStatus::success) { return -1; }
            return currentMust + currentMay;
        }
        auto retained_must_count(i64 id) const -> i64 {
            if (!valid_retained(id)) { return -1; }
            const CountPair counts = retainedCounts.at(id);
            return counts.must_count();
        }
        auto retained_may_count(i64 id) const -> i64 {
            if (!valid_retained(id)) { return -1; }
            const CountPair counts = retainedCounts.at(id);
            return counts.may_count();
        }
        auto retained_count_at(i64 id) const -> i64 {
            if (!valid_retained(id)) { return -1; }
            const CountPair counts = retainedCounts.at(id);
            return counts.must_count() + counts.may_count();
        }
        // Dense-index helpers are source-internal semantic operations. Native
        // callers use metadata-paired batches, never one bridge per bit.
        auto index_state(i64 index) -> i64 {
            if (statusValue != InitializationStatus::success || index < 0 || index >= scalarCount) {
                reject(); return -1;
            }
            const WordPair word = currentWords.at(index / 64);
            const u64 mask = 1u64 << (index % 64);
            i64 state = 0;
            if ((word.must_bits() & mask) != 0u64) { state = state + 1; }
            if ((word.may_bits() & mask) != 0u64) { state = state + 2; }
            return state;
        }
        auto write_index(i64 index) -> i64 {
            if (statusValue != InitializationStatus::success || index < 0 || index >= scalarCount) {
                reject(); return -1;
            }
            const WordPair old = currentWords.at(index / 64);
            const u64 mask = 1u64 << (index % 64);
            i64 previous = 0;
            if ((old.must_bits() & mask) != 0u64) { previous = previous + 1; }
            if ((old.may_bits() & mask) != 0u64) { previous = previous + 2; }
            if (previous == 3) { return previous; }
            const WordPair updated = WordPair(old.must_bits() | mask, old.may_bits() | mask);
            if (!currentWords.set(index / 64, updated)) { reject(); return -1; }
            if (previous == 0 || previous == 2) { currentMust = currentMust + 1; }
            if (previous < 2) { currentMay = currentMay + 1; }
            return previous;
        }
        auto clear_index(i64 index) -> bool {
            if (statusValue != InitializationStatus::success || index < 0 || index >= scalarCount) {
                return reject();
            }
            const WordPair old = currentWords.at(index / 64);
            const u64 mask = 1u64 << (index % 64);
            const bool must = (old.must_bits() & mask) != 0u64;
            const bool may = (old.may_bits() & mask) != 0u64;
            if (!must && !may) { return true; }
            const WordPair updated = WordPair(old.must_bits() & ~mask, old.may_bits() & ~mask);
            if (!currentWords.set(index / 64, updated)) { return reject(); }
            if (must) { currentMust = currentMust - 1; }
            if (may) { currentMay = currentMay - 1; }
            return true;
        }
        auto load(i64 id) -> bool {
            if (!valid_retained(id)) { return reject(); }
            const i64 first = id * wordCount;
            i64 at = 0;
            while (at < wordCount) {
                const WordPair word = retainedWords.at(first + at);
                if (!currentWords.set(at, word)) { return reject(); }
                at = at + 1;
            }
            const CountPair counts = retainedCounts.at(id);
            currentMust = counts.must_count();
            currentMay = counts.may_count();
            return true;
        }
        auto retain() -> i64 {
            if (statusValue != InitializationStatus::success) { reject(); return -1; }
            if (!grow_retained()) { return -1; }
            const i64 first = retainedCount * wordCount;
            i64 at = 0;
            while (at < wordCount) {
                const WordPair word = currentWords.at(at);
                if (!retainedWords.set(first + at, word)) { reject(); return -1; }
                at = at + 1;
            }
            const CountPair counts = CountPair(currentMust, currentMay);
            if (!retainedCounts.set(retainedCount, counts)) { reject(); return -1; }
            // Publish the monotonic ordinal only after both growths and all
            // copies succeed. Snapshots remain owned until function teardown.
            const i64 id = retainedCount;
            retainedCount = retainedCount + 1;
            return id;
        }
        auto join(i64 id) -> InitializationJoin {
            if (!valid_retained(id)) { reject(); return InitializationJoin::error; }
            const CountPair old_counts = retainedCounts.at(id);
            i64 must = old_counts.must_count();
            i64 may = old_counts.may_count();
            bool changed = false;
            const i64 first = id * wordCount;
            i64 at = 0;
            while (at < wordCount) {
                const WordPair existing = retainedWords.at(first + at);
                const WordPair incoming = currentWords.at(at);
                const u64 next_must = existing.must_bits() & incoming.must_bits();
                const u64 next_may = existing.may_bits() | incoming.may_bits();
                const u64 removed = existing.must_bits() ^ next_must;
                const u64 added = existing.may_bits() ^ next_may;
                if (removed != 0u64 || added != 0u64) {
                    const WordPair updated = WordPair(next_must, next_may);
                    if (!retainedWords.set(first + at, updated)) { reject(); return InitializationJoin::error; }
                    must = must - changed_count(removed);
                    may = may + changed_count(added);
                    changed = true;
                }
                at = at + 1;
            }
            if (!changed) { return InitializationJoin::unchanged; }
            const CountPair counts = CountPair(must, may);
            if (!retainedCounts.set(id, counts)) { reject(); return InitializationJoin::error; }
            // A lost must bit and gained may bit can cancel in the combined
            // cardinality. Change is a wordwise fact, never a count comparison.
            return InitializationJoin::changed;
        }
        // Only checked dense indices set bits. Zero-filled growth, independent
        // copies, clear, AND and OR preserve zero unused tail bits permanently.
    };
    auto create(builtin::ByteRegion region) -> InitializationWorkspace {
        InitializationWorkspace result = InitializationWorkspace(region);
        result.prepare();
        return move(result);
    }
    auto release(builtin::ByteRegion region, InitializationWorkspace workspace) -> i64 { return 0; }

    auto initialize(InitializationWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 callable) -> InitializationStatus {
        if (workspace.status() != InitializationStatus::pending) {
            workspace.reject(); return workspace.status();
        }
        if (!workspace.prepare()) { return workspace.status(); }
        if (metadata.status() != compiler_ir_metadata::MetadataStatus::success
            || callable < 0 || callable >= metadata.callable_count()) {
            workspace.reject(); return workspace.status();
        }
        const compiler_ir_metadata::CallableRow declaration = metadata.callable_at(callable);
        const compiler_ir_metadata::IndexRange slots = compiler_ir_metadata::slot_group(metadata, declaration, 10);
        if (declaration.frame_bytes() < 0 || declaration.frame_bytes() > 65536
            || slots.count() > declaration.frame_bytes()
            || !compiler_ir_metadata::index_range(slots, metadata.slot_count())) {
            workspace.reject(); return workspace.status();
        }
        workspace.configure(callable, slots.begin(), slots.count());
        return workspace.status();
    }
    auto ready(InitializationWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata) -> bool {
        if (workspace.status() != InitializationStatus::success
            || metadata.status() != compiler_ir_metadata::MetadataStatus::success
            || workspace.callable() < 0 || workspace.callable() >= metadata.callable_count()) {
            return workspace.reject();
        }
        return true;
    }
    auto scalar_index(InitializationWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 offset) -> i64 {
        if (!ready(workspace, metadata)) { return -1; }
        const compiler_ir_metadata::IndexRange slots =
            compiler_ir_metadata::IndexRange(workspace.scalar_begin(), workspace.slot_count());
        const i64 found = compiler_ir_metadata::find_slot(metadata, slots, offset);
        if (found < 0) { workspace.reject(); return -1; }
        return found - slots.begin();
    }
    // A scalar query returns both facts in one crossing: must=1, may=2.
    auto scalar_state(InitializationWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 offset) -> i64 {
        if (!ready(workspace, metadata)) { return -1; }
        const compiler_ir_metadata::IndexRange slots =
            compiler_ir_metadata::IndexRange(workspace.scalar_begin(), workspace.slot_count());
        const i64 found = compiler_ir_metadata::find_slot(metadata, slots, offset);
        // Membership of an undeclared offset is false, matching the old fact
        // set's observation contract. Insertion still rejects an unknown slot.
        if (found < 0) { return 0; }
        return workspace.index_state(found - slots.begin());
    }
    // Return the previous pair while marking both, so immutable-write checks
    // need one crossing. A native rejection ends verification; no state is
    // subsequently retained or published after that diagnostic.
    auto write_scalar(InitializationWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 offset) -> i64 {
        const i64 index = scalar_index(workspace, metadata, offset);
        if (index < 0) { return -1; }
        return workspace.write_index(index);
    }
    auto object_index(InitializationWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 base) -> i64 {
        if (!ready(workspace, metadata)) { return -1; }
        const compiler_ir_metadata::CallableRow declaration = metadata.callable_at(workspace.callable());
        const compiler_ir_metadata::IndexRange objects = compiler_ir_metadata::slot_group(metadata, declaration, 11);
        const i64 found = compiler_ir_metadata::find_slot(metadata, objects, base);
        if (found < 0) { workspace.reject(); }
        return found;
    }
    // 0 checks all must bits, 1 checks no may bits, 2 marks both, 3 clears both.
    // Physical leaves alone belong here; logical completion of empty/nested or
    // owning objects remains at its original native diagnostic position.
    auto object_action(InitializationWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 base, i64 action) -> i64 {
        if (action < 0 || action > 3) { workspace.reject(); return -1; }
        const i64 index = object_index(workspace, metadata, base);
        if (index < 0) { return -1; }
        const compiler_ir_metadata::SlotRow object = metadata.slot_at(index);
        const compiler_ir_metadata::StorageRow storage = compiler_ir_metadata::object_storage(metadata, object);
        const compiler_ir_metadata::IndexRange leaves = storage.leaf_offsets();
        i64 at = 0;
        while (at < leaves.count()) {
            const compiler_ir_metadata::IndexRow leaf = metadata.index_at(leaves.begin() + at);
            const i64 scalar = scalar_index(workspace, metadata, base - leaf.value());
            if (scalar < 0) { return -1; }
            if (action == 2) {
                if (workspace.write_index(scalar) < 0) { return -1; }
            } else {
                if (action == 3) {
                    if (!workspace.clear_index(scalar)) { return -1; }
                } else {
                    const i64 state = workspace.index_state(scalar);
                    if (state < 0) { return -1; }
                    if ((action == 0 && (state == 0 || state == 2)) || (action == 1 && state >= 2)) { return 0; }
                }
            }
            at = at + 1;
        }
        return 1;
    }
    auto object_initialized(InitializationWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 base) -> i64 { return object_action(workspace, metadata, base, 0); }
    auto object_pristine(InitializationWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 base) -> i64 { return object_action(workspace, metadata, base, 1); }
    auto mark_object(InitializationWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 base) -> bool { return object_action(workspace, metadata, base, 2) == 1; }
    auto clear_object(InitializationWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 base) -> bool { return object_action(workspace, metadata, base, 3) == 1; }

    auto array_range(InitializationWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 offset, i64 length, i64 width) -> bool {
        if (!ready(workspace, metadata)) { return false; }
        const compiler_ir_metadata::CallableRow declaration = metadata.callable_at(workspace.callable());
        if ((width != 1 && width != 8) || length < 0 || length > 65536
            || offset < 0 || offset > declaration.frame_bytes()
            || (length != 0 && (offset == 0 || length - 1 > (offset - 1) / width))) {
            return workspace.reject();
        }
        return true;
    }
    // -2 denotes failure, -1 complete, otherwise the first forward element
    // ordinal. Native code interleaves its lifetime/loan checks through exactly
    // that element before reporting missing initialization.
    auto array_first_missing(InitializationWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 offset, i64 length, i64 width) -> i64 {
        if (!array_range(workspace, metadata, offset, length, width)) { return -2; }
        i64 element = 0;
        while (element < length) {
            const i64 scalar = scalar_index(workspace, metadata, offset - element * width);
            if (scalar < 0) { return -2; }
            const i64 state = workspace.index_state(scalar);
            if (state < 0) { return -2; }
            if (state == 0 || state == 2) { return element; }
            element = element + 1;
        }
        return -1;
    }
    auto clear_array(InitializationWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        i64 offset, i64 length, i64 width) -> bool {
        if (!array_range(workspace, metadata, offset, length, width)) { return false; }
        i64 element = 0;
        while (element < length) {
            const i64 scalar = scalar_index(workspace, metadata, offset - element * width);
            if (scalar < 0 || !workspace.clear_index(scalar)) { return false; }
            element = element + 1;
        }
        return true;
    }
}
