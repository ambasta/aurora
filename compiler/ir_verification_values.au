export module aurora.compiler.ir_verification_values;
import aurora.compiler.ir_verification_common;
import aurora.compiler.ir_verification_storage;
import aurora.compiler.ir_verification_errors;
import aurora.compiler.ir_verification_initialization;
import aurora.compiler.ir_instructions;
import aurora.compiler.ir_instruction_storage;
import aurora.compiler.ir_metadata;
import aurora.compiler.ir_metadata_storage;

// Dynamic transfers operate on the original admitted stores. Numeric forms and
// operand positions are fixed by lowering_kinds' InstructionForm and OperandRole.
export namespace compiler_ir_verification {
    auto transfer_value(const compiler_ir_instructions::InstructionStore& s, i64 id, i64 field) -> i64 {
        return compiler_ir_instructions::call_value(s, id, field);
    }
    auto transfer_lane(const compiler_ir_instructions::InstructionStore& s, i64 id, i64 field, i64 lane) -> i64 {
        return compiler_ir_instructions::call_lane(s, id, field, lane);
    }
    auto transfer_target(const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 id) -> i64 {
        const compiler_ir_instructions::RawOperandRow operand = compiler_ir_instructions::call_operand(s, id, 0);
        const compiler_ir_metadata::ByteRange name = compiler_ir_metadata::ByteRange(operand.begin(), operand.count());
        return compiler_ir_metadata::first_named_callable(m, name);
    }
    auto transfer_has(VerificationWorkspace& w, FactKind kind, i64 key) -> bool {
        const FactRow fact = w.fact_find(kind, key, -1);
        return fact.kind() == kind;
    }
    auto transfer_empty(VerificationWorkspace& w, FactKind kind) -> bool {
        return w.first_fact(kind) < 0;
    }
    auto transfer_current_kind(VerificationWorkspace& w, i64 kind) -> bool {
        const ValueRow value = w.current();
        const TypeKey actual = value.type();
        if (!w.current_known() || actual.kind() != kind || actual.nominal() != -1) {
            return w.fail(first_error(VerificationErrorFirst::missing_or_mistyped_current_value));
        }
        return true;
    }
    auto transfer_current_type(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        i64 type) -> bool {
        const ValueRow value = w.current();
        const TypeKey actual = value.type();
        if (!w.current_known() || !same_type_key(m, actual, type)) {
            return w.fail(first_error(VerificationErrorFirst::missing_or_mistyped_current_value));
        }
        return true;
    }
    auto transfer_pop_kind(VerificationWorkspace& w, i64 kind, VerificationError error) -> bool {
        const ValueRow value = w.pop();
        if (!w.good()) {
            return false;
        }
        const TypeKey actual = value.type();
        if (actual.kind() != kind || actual.nominal() != -1) {
            return w.fail(error);
        }
        return true;
    }
    auto transfer_pop_type(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m, i64 type,
        VerificationErrorFirst first, VerificationErrorSecond second) -> bool {
        const ValueRow value = w.pop();
        if (!w.good()) {
            return false;
        }
        const TypeKey actual = value.type();
        if (!same_type_key(m, actual, type)) {
            const VerificationError error = VerificationError(first, second);
            return w.fail(error);
        }
        return true;
    }
    auto transfer_set_kind(VerificationWorkspace& w, i64 kind) -> bool {
        const TypeKey type = TypeKey(kind, -1);
        const BoundsEvidence evidence = empty_bounds();
        const ValueRow value = ValueRow(type, evidence);
        return w.set_current(value);
    }
    auto transfer_set_type(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m, i64 type) -> bool {
        const TypeKey key = type_key(m, type);
        const BoundsEvidence evidence = empty_bounds();
        const ValueRow value = ValueRow(key, evidence);
        return w.set_current(value);
    }
    auto transfer_slot(const compiler_ir_metadata::MetadataStore& m, i64 callable, i64 kind, i64 root) -> i64 {
        return compiler_ir_instructions::entry_slot(m, callable, kind, root);
    }
    auto transfer_object_class(const compiler_ir_metadata::MetadataStore& m, i64 callable, i64 root) -> i64 {
        const i64 index = transfer_slot(m, callable, 11, root);
        if (index < 0) {
            return -1;
        }
        const compiler_ir_metadata::SlotRow slot = m.slot_at(index);
        const TypeKey type = type_key(m, slot.type());
        return type.nominal();
    }
    auto transfer_receiver(const compiler_ir_metadata::MetadataStore& m, i64 callable) -> bool {
        return receiver_class(m, callable) >= 0;
    }
    auto transfer_constructor(const compiler_ir_metadata::MetadataStore& m, i64 callable) -> bool {
        return receiver_constructor(m, callable);
    }
    auto transfer_mutable_receiver(const compiler_ir_metadata::MetadataStore& m, i64 callable) -> bool {
        return receiver_mutable(m, callable);
    }
    auto transfer_class_field(const compiler_ir_metadata::MetadataStore& m, i64 nominal, i64 ordinal) -> i64 {
        return class_field(m, nominal, ordinal);
    }
    auto transfer_carrier(const compiler_ir_metadata::MetadataStore& m, i64 nominal) -> bool {
        const compiler_ir_metadata::ClassRow object = m.class_at(nominal);
        const compiler_ir_metadata::FlagMasks masks = compiler_ir_metadata::flag_masks();
        return compiler_ir_metadata::member(object, masks.class_array_carrier());
    }
    auto transfer_index_value(VerificationWorkspace& w, bool from_stack) -> ValueRow {
        if (from_stack) {
            return w.pop();
        }
        return w.current();
    }
    auto transfer_guard(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m, i64 offset, i64 length,
        i64 type, bool from_stack) -> bool {
        const ValueRow value = transfer_index_value(w, from_stack);
        if (!w.good()) {
            return false;
        }
        BoundsEvidence expected = empty_bounds();
        expected.set_kind(BoundsKind::local_array);
        expected.set_root(offset);
        expected.set_length(length);
        const TypeKey element_key = type_key(m, type);
        expected.set_element_type(element_key);
        const TypeKey actual = value.type();
        const BoundsEvidence guard = value.guard();
        if (actual.kind() != 0 || actual.nominal() != -1 || !guard.same(expected)) {
            return w.fail(first_error(VerificationErrorFirst::index_access_lacks_matching_dominating_bounds_token));
        }
        return true;
    }
    auto transfer_local_bounds(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m, i64 offset,
        i64 length, i64 type) -> bool {
        BoundsEvidence guard = empty_bounds();
        guard.set_kind(BoundsKind::local_array);
        guard.set_root(offset);
        guard.set_length(length);
        const TypeKey element_key = type_key(m, type);
        guard.set_element_type(element_key);
        const TypeKey key = TypeKey(0, -1);
        const ValueRow value = ValueRow(key, guard);
        return w.set_current(value);
    }
    auto transfer_scalar(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 id) -> bool {
        const compiler_ir_instructions::RawInstructionRow op = s.instruction_at(id);
        const i64 form = op.form();
        if (form == 5 || form == 6) {
            i64 field = 0;
            if (form == 5) {
                field = 1;
            }
            return transfer_set_type(w, m, transfer_value(s, id, field));
        }
        if (form == 7) {
            const i64 offset = transfer_value(s, id, 0);
            const i64 object = compiler_ir_metadata::object_leaf_root(m, w.callable(), offset);
            const i64 array_root = compiler_ir_metadata::byte_array_element_root(m, w.callable(), offset);
            if (!active_object_field(w, s, object) || !active_array_element(w, array_root)) {
                return false;
            }
            if (!initialization_flag(compiler_ir_initialization::scalar_state(w, m, offset), 1)) {
                return w.fail(first_error(VerificationErrorFirst::load_before_initialization));
            }
            return transfer_set_type(w, m, transfer_value(s, id, 1));
        }
        if (form == 8) {
            if (!transfer_current_type(w, m, transfer_value(s, id, 1))) {
                return false;
            }
            return store(w, m, s, transfer_value(s, id, 0));
        }
        if (form == 9) {
            if (!w.current_known()) {
                return w.fail(first_error(VerificationErrorFirst::push_without_current_value));
            }
            const ValueRow value = w.current();
            return w.push(value);
        }
        if (form == 10) {
            const ValueRow value = w.pop();
            if (!w.good()) {
                return false;
            }
            return w.set_current(value);
        }
        if (form == 11) {
            const i64 type = transfer_value(s, id, 0);
            if (!transfer_current_type(w, m, type)) {
                return false;
            }
            return transfer_set_type(w, m, type);
        }
        if (form == 12) {
            const i64 type = transfer_value(s, id, 0);
            if (op.binary_operation() == 8 || op.binary_operation() == 9) {
                if (!transfer_current_kind(w, 0)) {
                    return false;
                }
            } else {
                if (!transfer_current_type(w, m, type)) {
                    return false;
                }
            }
            if (!transfer_pop_type(w, m, type, VerificationErrorFirst::noninteger_left_operand_or_binary_type_mismatch,
                VerificationErrorSecond::none)) {
                return false;
            }
            return transfer_set_type(w, m, type);
        }
        if (form == 13) {
            if (!transfer_current_type(w, m, transfer_value(s, id, 0))) {
                return false;
            }
            return transfer_set_type(w, m, transfer_value(s, id, 1));
        }
        if (form == 14) {
            const i64 type = transfer_value(s, id, 0);
            if (!transfer_current_type(w, m, type) || !transfer_pop_type(w, m, type,
                VerificationErrorFirst::comparison_type_mismatch, VerificationErrorSecond::none)) {
                return false;
            }
            return transfer_set_kind(w, 1);
        }
        if (form >= 15 && form <= 17) {
            const i64 offset = transfer_value(s, id, 0);
            const i64 length = transfer_value(s, id, 1);
            const i64 type = transfer_value(s, id, 2);
            if (form == 15 && !transfer_current_kind(w, 0)) {
                return false;
            }
            if (!initialized_array(w, m, s, offset, length, type)) {
                return false;
            }
            if (form == 15) {
                return transfer_local_bounds(w, m, offset, length, type);
            }
            if (form == 16) {
                if (!transfer_current_kind(w, 0) || !transfer_guard(w, m, offset, length, type, false)) {
                    return false;
                }
                return transfer_set_type(w, m, type);
            }
            // Preserve range, operands, then write eligibility in this order.
            if (!transfer_current_type(w, m, type) || !transfer_guard(w, m, offset, length, type, true)) {
                return false;
            }
            return writable_array(w, m, s, offset, length, type);
        }
        if (form == 18) {
            if (!initialization_flag(compiler_ir_initialization::scalar_state(w, m, transfer_value(s, id, 0)), 1)) {
                return w.fail(first_error(VerificationErrorFirst::borrow_of_uninitialized_payload));
            }
            return transfer_set_type(w, m, transfer_value(s, id, 1));
        }
        if (form == 19) {
            const compiler_ir_metadata::CallableRow target = m.callable_at(transfer_target(m, s, id));
            i64 arg = target.value_parameter_count();
            while (arg > 0) {
                arg = arg - 1;
                if (!transfer_pop_type(w, m, target.value_parameter_begin() + arg,
                    VerificationErrorFirst::call_argument_type_mismatch, VerificationErrorSecond::none)) {
                    return false;
                }
            }
            const compiler_ir_metadata::IndexRange types = target.types();
            return transfer_set_type(w, m, types.begin());
        }
        if (form == 39) {
            if (op.query() != 0 && op.query() != 1) {
                return w.fail(second_error(VerificationErrorSecond::unknown_metadata_query));
            }
            const compiler_ir_metadata::CallableRow signature = m.callable_at(w.callable());
            if (transfer_value(s, id, 0) != signature.scope()) {
                return w.fail(second_error(VerificationErrorSecond::metadata_query_changes_defining_module_scope));
            }
            if (!transfer_current_kind(w, 0)) {
                return false;
            }
            return transfer_set_kind(w, 0);
        }
        if (form == 40 || form == 41) {
            return true;
        }
        if (form == 42) {
            return transfer_current_kind(w, 1);
        }
        if (form == 45) {
            const i64 prior = compiler_ir_initialization::write_scalar(w, m, transfer_value(s, id, 1));
            if (initialization_flag(prior, 2)) {
                return w.fail(first_error(VerificationErrorFirst::write_to_immutable_scalar_parameter));
            }
            return w.good();
        }
        return w.fail(first_error(VerificationErrorFirst::internal));
    }
    auto transfer_aggregate(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 id) -> bool {
        const compiler_ir_metadata::CallableRow target = m.callable_at(transfer_target(m, s, id));
        i64 arg = target.value_parameter_count();
        while (arg > 0) {
            arg = arg - 1;
            const i64 type_id = target.value_parameter_begin() + arg;
            const compiler_ir_metadata::RawTypeRow type = m.type_at(type_id);
            if (compiler_ir_metadata::span_type(type)) {
                if (!live_span(w, m, s, transfer_lane(s, id, 3, arg), AccessMode::read)) {
                    return false;
                }
            } else {
                if (compiler_ir_metadata::scalar_value(m, type)) {
                    if (!transfer_pop_type(w, m, type_id,
                        VerificationErrorFirst::aggregate_scalar_argument_type_mismatch,
                        VerificationErrorSecond::none)) {
                        return false;
                    }
                } else {
                    if (!live_copied_argument(w, m, transfer_lane(s, id, 1, arg), ArgumentRole::aggregate)) {
                        return false;
                    }
                }
            }
        }
        const compiler_ir_metadata::IndexRange types = target.types();
        const compiler_ir_metadata::RawTypeRow result = m.type_at(types.begin());
        if (result.kind() == 5) {
            const i64 base = transfer_value(s, id, 2);
            if (!transfer_has(w, FactKind::object, base)) {
                return w.fail(first_error(VerificationErrorFirst::aggregate_result_outside_active_object_lifetime));
            }
            if (compiler_ir_initialization::object_was_constructed(w, m, base) != 0) {
                return w.fail(first_error(VerificationErrorFirst::aggregate_result_object_already_initialized));
            }
            if (compiler_ir_initialization::object_pristine(w, m, base) != 1) {
                return w.fail(first_error(VerificationErrorFirst::aggregate_result_requires_uninitialized_object));
            }
            if (!compiler_ir_initialization::mark_object(w, m, base)) {
                return false;
            }
            return w.clear_current();
        }
        return transfer_set_type(w, m, types.begin());
    }
    auto transfer_objects(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 id) -> bool {
        const compiler_ir_instructions::RawInstructionRow op = s.instruction_at(id);
        const i64 form = op.form();
        const i64 base = transfer_value(s, id, 0);
        if (form == 21 || form == 23) {
            const i64 slot = transfer_slot(m, w.callable(), 11, base);
            if (slot < 0) {
                return w.fail(first_error(VerificationErrorFirst::lifetime_operation_requires_exact_object_slot));
            }
            if (form == 21) {
                if (entry_contains(s, w.callable(), 46, base) || entry_contains(s, w.callable(), 79, base)) {
                    return w.fail(first_error(VerificationErrorFirst::object_parameter_lifetime_cannot_restart));
                }
                if (transfer_has(w, FactKind::object, base)) {
                    return w.fail(first_error(VerificationErrorFirst::object_lifetime_already_active));
                }
                const ControlRow control = w.control();
                const FactRow fact = object_fact(base, control.instruction_id());
                if (!w.fact_set(fact)) {
                    return false;
                }
                const i64 nominal = slot_class(m, slot);
                if (compiler_ir_metadata::owning_class(m, nominal) && !begin_owned_object(w, m, base, nominal)) {
                    return false;
                }
            } else {
                if (!transfer_has(w, FactKind::object, base)) {
                    return w.fail(first_error(VerificationErrorFirst::object_lifetime_is_not_active));
                }
                if (!owner_writable(w, s, base, -2, AccessMode::write)) {
                    return false;
                }
                const i64 nominal = slot_class(m, slot);
                if (compiler_ir_metadata::retained_class(m, nominal)) {
                    if (!resident_fields_settled(w, base, false)) {
                        return false;
                    }
                    i64 at = w.fact_lower_bound(FactKind::resident_field, base, -1);
                    while (at >= 0 && fact_key_at(w, at, FactKind::resident_field, base)) {
                        const FactRow field = w.fact_at(at);
                        if (!w.fact_erase(FactKind::resident_field, base, field.field())) {
                            return false;
                        }
                        at = w.fact_lower_bound(FactKind::resident_field, base, -1);
                    }
                }
                if (!w.fact_erase(FactKind::object, base, -1) || !w.fact_erase(FactKind::owned_object, base, -1)) {
                    return false;
                }
            }
            if (!w.invalidate_class_array_evidence(base)) {
                return false;
            }
            return compiler_ir_initialization::clear_object(w, m, base);
        }
        if (form == 22) {
            const i64 slot = transfer_slot(m, w.callable(), 11, base);
            if (slot < 0) {
                return w.fail(first_error(VerificationErrorFirst::empty_initialization_requires_exact_object_slot));
            }
            const i64 nominal = slot_class(m, slot);
            const compiler_ir_metadata::ClassRow object = m.class_at(nominal);
            const compiler_ir_metadata::IndexRange leaves = object.leaves();
            const compiler_ir_metadata::IndexRange fields = object.fields();
            if (leaves.count() != 0 || fields.count() != 0 || compiler_ir_metadata::owning_class(m, nominal)
                || transfer_carrier(m, nominal)) {
                return w.fail(first_error(
                    VerificationErrorFirst::empty_initialization_requires_zero_logical_fields_and_leaves));
            }
            if (!copy_target(w, m, base, nominal)) {
                return false;
            }
            return w.clear_current();
        }
        if (form == 24) {
            const i64 result = transfer_value(s, id, 1);
            if (base == result) {
                return w.fail(first_error(VerificationErrorFirst::copy_source_aliases_result));
            }
            const i64 slot = complete_object(w, m, s, base, AccessMode::read);
            if (!w.good()) {
                return false;
            }
            const i64 nominal = slot_class(m, slot);
            if (compiler_ir_metadata::owning_class(m, nominal)) {
                return w.fail(first_error(VerificationErrorFirst::owning_class_cannot_be_implicitly_copied));
            }
            if (!copy_target(w, m, result, nominal)) {
                return false;
            }
            return w.clear_current();
        }
        if (form == 25) {
            const i64 ordinal = transfer_value(s, id, 1);
            const i64 result = transfer_value(s, id, 2);
            i64 field_index = -1;
            if (base == 0) {
                field_index = receiver_shape(w, m, s, ordinal);
                if (!w.good()) {
                    return false;
                }
                if (transfer_constructor(m, w.callable())) {
                    return w.fail(first_error(
                        VerificationErrorFirst::constructor_cannot_project_receiver_during_initialization));
                }
                if (!initialization_flag(compiler_ir_initialization::receiver_field_state(w, m, ordinal), 4)) {
                    return w.fail(first_error(VerificationErrorFirst::receiver_nested_class_field_not_initialized));
                }
            } else {
                if (base == result) {
                    return w.fail(second_error(VerificationErrorSecond::projection_source_aliases_result));
                }
                const i64 slot = complete_object(w, m, s, base, AccessMode::read);
                if (!w.good()) {
                    return false;
                }
                field_index = transfer_class_field(m, slot_class(m, slot), ordinal);
                if (field_index < 0) {
                    return w.fail(second_error(VerificationErrorSecond::projection_logical_field_index_out_of_range));
                }
            }
            const compiler_ir_metadata::FieldRow field = m.field_at(field_index);
            const TypeKey type = type_key(m, field.type());
            if (field.array_flag() != 0 || type.kind() != 5) {
                return w.fail(second_error(VerificationErrorSecond::projection_requires_class_field));
            }
            if (compiler_ir_metadata::owning_class(m, type.nominal())) {
                return w.fail(second_error(VerificationErrorSecond::owning_class_field_cannot_be_copied));
            }
            if (!copy_target(w, m, result, type.nominal())) {
                return false;
            }
            return w.clear_current();
        }
        if (form == 26 || form == 27) {
            const i64 ordinal = transfer_value(s, id, 1);
            const i64 source = transfer_value(s, id, 2);
            i64 field_index = -1;
            if (form == 26) {
                if (base == source) {
                    return w.fail(second_error(VerificationErrorSecond::class_field_assignment_source_aliases_root));
                }
                field_index = complete_class_field(w, m, s, base, ordinal, AccessMode::write);
            } else {
                if (base != 0) {
                    return w.fail(second_error(
                        VerificationErrorSecond::class_field_initialization_requires_bound_constructor_receiver));
                }
                field_index = receiver_shape(w, m, s, ordinal);
                if (!w.good()) {
                    return false;
                }
                if (!transfer_constructor(m, w.callable()) || !transfer_mutable_receiver(m, w.callable())) {
                    return w.fail(second_error(
                        VerificationErrorSecond::class_field_initialization_requires_constructor_receiver));
                }
                const compiler_ir_metadata::FieldRow shape = m.field_at(field_index);
                const compiler_ir_metadata::RawTypeRow type = m.type_at(shape.type());
                if (shape.array_flag() != 0 || type.kind() != 5) {
                    return w.fail(second_error(
                        VerificationErrorSecond::class_field_initialization_requires_class_field));
                }
            }
            if (!w.good()) {
                return false;
            }
            const compiler_ir_metadata::FieldRow field = m.field_at(field_index);
            const TypeKey type = type_key(m, field.type());
            const i64 slot = complete_object(w, m, s, source, AccessMode::read);
            if (!w.good()) {
                return false;
            }
            if (compiler_ir_metadata::owning_class(m, type.nominal())) {
                return w.fail(second_error(VerificationErrorSecond::owning_class_field_cannot_be_copied));
            }
            if (slot_class(m, slot) != type.nominal()) {
                if (form == 26) {
                    return w.fail(second_error(VerificationErrorSecond::class_field_assignment_nominal_class_mismatch));
                }
                return w.fail(second_error(VerificationErrorSecond::class_field_initializer_nominal_class_mismatch));
            }
            if (form == 27) {
                const i64 prior = compiler_ir_initialization::write_receiver_field(w, m, ordinal);
                if (initialization_flag(prior, 8)) {
                    return w.fail(second_error(
                        VerificationErrorSecond::constructor_class_field_initialized_more_than_once));
                }
                if (initialization_flag(prior, 2)) {
                    return w.fail(second_error(
                        VerificationErrorSecond::constructor_class_field_leaves_already_initialized));
                }
            }
            return w.clear_current();
        }
        if (form == 28) {
            const i64 ordinal = transfer_value(s, id, 1);
            if (base < 0) {
                return w.fail(second_error(VerificationErrorSecond::invalid_class_array_initialization_root));
            }
            i64 field_index = -1;
            if (base == 0) {
                field_index = receiver_shape(w, m, s, ordinal);
                if (!w.good()) {
                    return false;
                }
                if (!transfer_constructor(m, w.callable()) || !transfer_mutable_receiver(m, w.callable())) {
                    return w.fail(second_error(
                        VerificationErrorSecond::class_array_initialization_requires_constructor_receiver));
                }
            } else {
                const i64 slot = transfer_slot(m, w.callable(), 11, base);
                if (slot < 0) {
                    return w.fail(second_error(
                        VerificationErrorSecond::class_array_initialization_requires_exact_object_slot));
                }
                const i64 nominal = slot_class(m, slot);
                if (!transfer_carrier(m, nominal) || ordinal != 0) {
                    return w.fail(second_error(
                        VerificationErrorSecond::local_class_array_initialization_requires_declared_carrier_field));
                }
                field_index = transfer_class_field(m, nominal, 0);
            }
            const compiler_ir_metadata::FieldRow field = m.field_at(field_index);
            const TypeKey type = type_key(m, field.type());
            if (field.array_flag() == 0 || type.kind() != 5) {
                return w.fail(second_error(
                    VerificationErrorSecond::class_array_initialization_requires_class_array_field));
            }
            const i64 count = compiler_ir_instructions::call_count(s, id, 2);
            if (count != field.element_count()) {
                return w.fail(second_error(VerificationErrorSecond::class_array_initializer_element_count_mismatch));
            }
            i64 at = 0;
            while (at < count) {
                const i64 source = transfer_lane(s, id, 2, at);
                if (source == base) {
                    return w.fail(second_error(
                        VerificationErrorSecond::class_array_initialization_source_aliases_root));
                }
                const i64 slot = complete_object(w, m, s, source, AccessMode::read);
                if (!w.good()) {
                    return false;
                }
                if (slot_class(m, slot) != type.nominal()) {
                    return w.fail(second_error(
                        VerificationErrorSecond::class_array_initializer_nominal_class_mismatch));
                }
                at = at + 1;
            }
            if (base == 0) {
                const i64 prior = compiler_ir_initialization::write_receiver_field(w, m, ordinal);
                if (initialization_flag(prior, 8)) {
                    return w.fail(second_error(
                        VerificationErrorSecond::constructor_class_array_initialized_more_than_once));
                }
                if (initialization_flag(prior, 2)) {
                    return w.fail(second_error(
                        VerificationErrorSecond::constructor_class_array_leaves_already_initialized));
                }
            } else {
                const i64 target_class = transfer_object_class(m, w.callable(), base);
                if (!copy_target(w, m, base, target_class)) {
                    return false;
                }
            }
            return w.clear_current();
        }
        if (form >= 29 && form <= 31) {
            const i64 ordinal = transfer_value(s, id, 1);
            AccessMode mode = AccessMode::read;
            if (form == 31) {
                mode = AccessMode::write;
            }
            const i64 field_index = complete_class_array(w, m, s, base, ordinal, mode);
            if (!w.good()) {
                return false;
            }
            const compiler_ir_metadata::FieldRow field = m.field_at(field_index);
            if (form == 29) {
                if (!transfer_current_kind(w, 0)) {
                    return false;
                }
                const BoundsEvidence evidence = class_array_evidence(m, w.callable(), base, ordinal);
                const TypeKey key = TypeKey(0, -1);
                const ValueRow value = ValueRow(key, evidence);
                return w.set_current(value);
            }
            if (!checked_class_array(w, m, base, ordinal)) {
                return false;
            }
            const i64 other = transfer_value(s, id, 2);
            const TypeKey type = type_key(m, field.type());
            if (form == 30) {
                if (base == other) {
                    return w.fail(second_error(VerificationErrorSecond::class_array_projection_source_aliases_result));
                }
                if (!copy_target(w, m, other, type.nominal())) {
                    return false;
                }
            } else {
                if (base == other) {
                    return w.fail(second_error(VerificationErrorSecond::class_array_assignment_source_aliases_root));
                }
                const i64 slot = complete_object(w, m, s, other, AccessMode::read);
                if (!w.good()) {
                    return false;
                }
                if (slot_class(m, slot) != type.nominal()) {
                    return w.fail(second_error(VerificationErrorSecond::class_array_assignment_nominal_class_mismatch));
                }
            }
            return w.clear_current();
        }
        if (form == 46) {
            const i64 root = transfer_value(s, id, 1);
            const ControlRow control = w.control();
            const FactRow fact = object_fact(root, control.instruction_id());
            if (!w.fact_set(fact)) {
                return false;
            }
            return compiler_ir_initialization::mark_object(w, m, root);
        }
        return w.fail(first_error(VerificationErrorFirst::internal));
    }
    auto transfer_receivers(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 id) -> bool {
        const compiler_ir_instructions::RawInstructionRow op = s.instruction_at(id);
        const i64 form = op.form();
        const i64 ordinal = transfer_value(s, id, 0);
        if (form == 32 || form == 33) {
            const i64 type = transfer_value(s, id, 1);
            receiver_field(w, m, s, ordinal, type);
            if (!w.good()) {
                return false;
            }
            if (form == 32) {
                if (transfer_constructor(m, w.callable())) {
                    return w.fail(second_error(
                        VerificationErrorSecond::constructor_cannot_read_receiver_during_initialization));
                }
                if (!initialization_flag(compiler_ir_initialization::receiver_field_state(w, m, ordinal), 1)) {
                    return w.fail(second_error(VerificationErrorSecond::receiver_field_not_initialized));
                }
                return transfer_set_type(w, m, type);
            }
            if (!transfer_current_type(w, m, type)) {
                return false;
            }
            if (!transfer_mutable_receiver(m, w.callable())) {
                return w.fail(second_error(VerificationErrorSecond::write_through_const_receiver));
            }
            const i64 prior = compiler_ir_initialization::write_receiver_field(w, m, ordinal);
            if (transfer_constructor(m, w.callable()) && initialization_flag(prior, 2)) {
                return w.fail(second_error(VerificationErrorSecond::constructor_field_initialized_more_than_once));
            }
            return w.good();
        }
        const i64 field_index = receiver_array(w, m, s, ordinal, form != 34);
        if (!w.good()) {
            return false;
        }
        const compiler_ir_metadata::FieldRow field = m.field_at(field_index);
        if (form == 34) {
            if (!transfer_constructor(m, w.callable()) || !transfer_mutable_receiver(m, w.callable())) {
                return w.fail(second_error(VerificationErrorSecond::receiver_array_zero_requires_constructor_receiver));
            }
            const i64 prior = compiler_ir_initialization::write_receiver_field(w, m, ordinal);
            if (initialization_flag(prior, 2)) {
                return w.fail(second_error(VerificationErrorSecond::constructor_array_initialized_more_than_once));
            }
            return w.good();
        }
        const BoundsEvidence evidence = receiver_evidence(m, w.callable(), ordinal);
        if (form == 35) {
            if (!transfer_current_kind(w, 0)) {
                return false;
            }
            const TypeKey key = TypeKey(0, -1);
            const ValueRow value = ValueRow(key, evidence);
            return w.set_current(value);
        }
        if (form == 36) {
            if (!transfer_current_kind(w, 0)) {
                return false;
            }
            const ValueRow value = w.current();
            if (!receiver_guard(w, value, evidence)) {
                return false;
            }
            return transfer_set_type(w, m, field.type());
        }
        if (form == 37) {
            if (!transfer_mutable_receiver(m, w.callable())) {
                return w.fail(second_error(VerificationErrorSecond::write_through_const_receiver));
            }
            if (!transfer_current_type(w, m, field.type())) {
                return false;
            }
            const ValueRow index = w.pop();
            if (!w.good() || !receiver_guard(w, index, evidence)) {
                return false;
            }
            return owner_writable(w, s, 0, ordinal, AccessMode::write);
        }
        return w.fail(first_error(VerificationErrorFirst::internal));
    }
}
