        duplicate_class_field,
        class_field_limit,
        nested_owning_class_field,
        owned_byte_field_must_be_private,
        owning_class_template,
        class_array_field_storage,
        owning_class_array,
        class_field_requires_concrete_type,
        class_layout_frame_limit,
        composed_class_leaf_limit,
        composed_class_depth,
        aggregate_field_requires_constructor,
        private_class_field,
        unknown_class_field,
        owning_class_copy,
        reflection_span_capability,
        reflection_resource_capability,
        unknown_local,
        initializer_receiver_field_access,
        ownership_operation_requires_local,
        use_after_move,
        owning_object_exclusively_borrowed,
        call_argument_count,
        type_mismatch,
        duplicate_local,
        function_frame_limit,
        owning_object_mutation_while_borrowed,
        owner_mutation_while_span_live,
        invalid_byte_string_literal,
        subspan_argument_count,
        subspan_requires_live_readonly_view,
        temporary_subspan_requires_owned_origin,
        borrowed_object_field_access,
        borrow_bytes_requires_named_storage_or_private_field,
        borrow_bytes_field_storage,
        borrow_bytes_requires_named_storage,
        invalid_span_initializer,
        dependent_reborrow_lifetime,
        owning_transfer_requires_move,
        move_requires_owner,
        borrowed_object_ownership_transfer,
        move_const_owner,
        resource_result_requires_typed_initializer,
        owner_region_mismatch,
        owned_bytes_initializer,
        indexing_requires_local_or_private_receiver_field,
        indexing_requires_local_or_receiver_field,
        private_constructor,
        private_method,
        missing_declared_constructor,
        unknown_class_method,
        method_signature_import,
        local_shadows_method,
        borrowed_object_field_projection,
