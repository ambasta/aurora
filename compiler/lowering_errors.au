        assignment_requires_mutable_scalar,
        branch_borrow_state_mismatch,
        branch_byte_ownership_state_mismatch,
        nominal_type_id_limit,
        enum_declaration_limit,
        enum_name_or_case_count,
        duplicate_enum_case,
        duplicate_or_reserved_class_name,
        owning_class_template_argument,
