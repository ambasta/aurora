export module aurora.compiler.lowering_errors;

// The selected reason is semantic authority owned by Aurora. The host formats
// its bounded name/type/integer payload without repeating the decision.
// Each reason's message is the `//:` text above it; the frontend generator
// turns it into the host's message table. Continuation lines join with a
// space. {name}, {type} and {integer} take the payload values in order.
// [unlocated], [synthetic] and [integrity] select the payload's source kind;
// [integrity] reasons use status invalid.
export namespace compiler_lowering {
    enum class LoweringStatus {
        success,
        semantic_failure,
        storage_failure,
        invalid
    };

    enum class LoweringError {
        none,
        //: unknown class type '{type}'
        unknown_class_type,
        //: owned values require a bounded pointer-free copied class element
        owned_values_require_copied_element,
        //: class arrays require 1 to 64 concrete copied class elements
        class_array_requires_concrete_copied_elements,
        //: class array containment depth exceeds four
        class_array_containment_depth,
        //: class array exceeds copied class leaf limits
        class_array_copied_leaf_limit,
        //: class array storage exceeds 520 bytes
        class_array_storage_limit,
        //: unknown enum type '{type}'
        unknown_enum_type,
        //: [unlocated] unknown nested class type '{name}'
        unknown_nested_class_type,
        //: recursive class containment is unsupported
        recursive_class_containment,
        //: class containment depth exceeds four
        class_containment_depth,
        //: duplicate class field
        duplicate_class_field,
        //: nested owning class fields are unsupported
        nested_owning_class_field,
        //: owned byte fields must be private
        owned_byte_field_must_be_private,
        //: owning class templates are unsupported
        owning_class_template,
        //: class array fields require private concrete scalar or copied class storage of length 1 to 64, or 1 to 512
        //: for u8
        class_array_field_storage,
        //: arrays of owning classes are unsupported
        owning_class_array,
        //: class field must be concrete scalar, enum, class or private array
        class_field_requires_concrete_type,
        //: class layout exceeds 65536 bytes
        class_layout_frame_limit,
        //: composed classes are limited to 64 non-byte scalar leaves, 512 u8 leaves and 513 total leaves
        composed_class_leaf_limit,
        //: composed class exceeds depth four
        composed_class_depth,
        //: array or class fields require a declared complete constructor
        aggregate_field_requires_constructor,
        //: private class field is inaccessible
        private_class_field,
        //: unknown field '{name}' in {type}
        unknown_class_field,
        //: owning class cannot be copied; use move(named_local)
        owning_class_copy,
        //: span capabilities are unavailable to reflection
        reflection_span_capability,
        //: resource capabilities are unavailable to reflection
        reflection_resource_capability,
        //: unknown local '{name}'
        unknown_local,
        //: constructor initializer cannot access receiver fields
        initializer_receiver_field_access,
        //: ownership operation requires a local name
        ownership_operation_requires_local,
        //: use after move of '{name}'
        use_after_move,
        //: owning object is exclusively borrowed for a call
        owning_object_exclusively_borrowed,
        //: wrong argument count for {name}
        call_argument_count,
        //: expected {type}, got {type}
        type_mismatch,
        //: duplicate local '{name}'
        duplicate_local,
        //: function local stack frame exceeds 65536 bytes
        function_frame_limit,
        //: cannot mutate or move an owning object while borrowed
        owning_object_mutation_while_borrowed,
        //: cannot mutate or move an owner while a readonly span is live
        owner_mutation_while_span_live,
        //: invalid byte-string literal
        invalid_byte_string_literal,
        //: span subspan expects offset and count
        subspan_argument_count,
        //: subspan requires a named live readonly span or a directly derived temporary view
        subspan_requires_live_readonly_view,
        //: temporary subspan chains require an owned-byte origin; array and parameter views require a named parent span
        temporary_subspan_requires_owned_origin,
        //: borrowed object parameters support public methods, not field access
        borrowed_object_field_access,
        //: borrow_bytes requires a named local byte array, a named owned-byte value or a direct private owned-byte
        //: field
        borrow_bytes_requires_named_storage_or_private_field,
        //: borrow_bytes fields require private owned bytes or an implicit receiver u8 array
        borrow_bytes_field_storage,
        //: borrow_bytes requires a named local byte array or owned bytes
        borrow_bytes_requires_named_storage,
        //: span initializer requires borrow_bytes, a live span or its subspan
        invalid_span_initializer,
        //: [unlocated] span lifetime ended before a dependent reborrow
        dependent_reborrow_lifetime,
        //: owning transfer requires move(named_local)
        owning_transfer_requires_move,
        //: move requires an owning value
        move_requires_owner,
        //: borrowed object parameters cannot transfer ownership
        borrowed_object_ownership_transfer,
        //: cannot move a const owner
        move_const_owner,
        //: resource result requires a typed local initializer
        resource_result_requires_typed_initializer,
        //: owning value belongs to a different region
        owner_region_mismatch,
        //: owned bytes require region.try_allocate, move or an owned-result function call
        owned_bytes_initializer,
        //: indexing requires an array local or implicit private receiver field
        indexing_requires_local_or_private_receiver_field,
        //: indexing requires an array local or receiver field
        indexing_requires_local_or_receiver_field,
        //: private constructor is inaccessible
        private_constructor,
        //: private method is inaccessible
        private_method,
        //: class has no declared constructor
        missing_declared_constructor,
        //: unknown class method
        unknown_class_method,
        //: method signature type requires a direct visible import
        method_signature_import,
        //: local binding shadows method and is not callable
        local_shadows_method,
        //: borrowed object parameters support public methods, not field projections
        borrowed_object_field_projection,
        //: method receiver requires a class local or direct owned class field
        method_receiver_requires_class_storage,
        //: nested method receiver requires an owned class field or owned byte field
        nested_method_receiver_requires_owned_field,
        //: direct copied return requires an ordinary method on a complete receiver
        direct_copied_return_requires_complete_method_receiver,
        //: method arguments consumed the receiver or its containing object
        arguments_consumed_method_receiver,
        //: service operation requires an active named exclusive service parameter
        service_operation_requires_active_exclusive_parameter,
        //: next requires a typed ConsoleSample initializer
        next_requires_console_sample_initializer,
        //: poll requires a typed IommuEventSample initializer
        poll_requires_event_sample_initializer,
        //: acknowledge returns a scalar enum, not a copied report
        acknowledge_returns_scalar_enum,
        //: put returns a scalar enum, not a copied report
        put_returns_scalar_enum,
        //: pixel returns a scalar enum, not a copied report
        pixel_returns_scalar_enum,
        //: unknown operation for sealed service kind
        unknown_service_operation,
        //: typed owner operation requires a named owner
        typed_owner_operation_requires_named_owner,
        //: owner status and size return scalar values
        typed_owner_query_returns_scalar,
        //: unknown typed owner operation
        unknown_typed_owner_operation,
        //: cannot write a const typed owner
        write_const_typed_owner,
        //: typed owner access requires a typed copied local or direct copied return
        typed_owner_access_requires_copied_destination,
        //: typed owner mutation returns bool
        typed_owner_mutation_returns_bool,
        //: byte operation requires a named owner
        byte_operation_requires_named_owner,
        //: cannot write a const byte owner
        write_const_byte_owner,
        //: unknown owned byte operation
        unknown_owned_byte_operation,
        //: region allocation requires an OwnedBytes local initializer
        region_allocation_requires_owned_bytes_initializer,
        //: span operation requires a named live span
        span_operation_requires_named_live_span,
        //: span size expects no arguments
        span_size_argument_count,
        //: span at expects one index
        span_at_argument_count,
        //: subspan requires a span binding or span argument
        subspan_requires_span_binding_or_argument,
        //: span supports only readonly size, at and subspan operations
        unknown_readonly_span_operation,
        //: copied argument cannot consume an owning result
        copied_argument_consumes_owning_result,
        //: copied argument requires an ordinary method on a complete receiver
        copied_argument_requires_complete_method_receiver,
        //: class-returning method requires a typed local initializer
        class_method_result_requires_typed_initializer,
        //: span-returning method requires a typed local initializer or span argument
        span_method_result_requires_initializer_or_argument,
        //: span-result methods cannot forward another method's returned view
        span_method_forwards_returned_view,
        //: returned span requires a named receiver or the implicit receiver
        returned_span_requires_named_receiver,
        //: span-result method requires a verified receiver-field summary
        span_method_requires_verified_field_summary,
        //: mutable method requires a mutable receiver
        mutable_method_requires_mutable_receiver,
        //: wrong argument count for method
        method_argument_count,
        //: copied service report requires a typed local initializer
        service_report_requires_typed_initializer,
        //: service forwarding requires a named exclusive service parameter
        service_forwarding_requires_named_exclusive_parameter,
        //: service authority is suspended during synchronous forwarding
        service_authority_suspended,
        //: copied argument requires an ordinary function call
        copied_argument_requires_ordinary_call,
        //: direct copied return requires an ordinary function call
        direct_copied_return_requires_ordinary_call,
        //: class-returning call requires a typed local initializer
        class_call_result_requires_typed_initializer,
        //: borrowed object argument requires a complete named owning object
        borrowed_argument_requires_complete_owner,
        //: mutable borrowed parameter requires a mutable owning object
        mutable_borrowed_argument_requires_mutable_owner,
        //: unknown ordinary overload candidate
        unknown_overload_candidate,
        //: ambiguous exact ordinary overload
        ambiguous_exact_overload,
        //: no exact ordinary overload for {name}
        no_exact_overload,
        //: function signature type requires a direct visible import
        function_signature_import,
        //: invalid byte literal
        invalid_byte_literal,
        //: integer literal out of range or invalid suffix
        invalid_integer_literal_or_suffix,
        //: unknown enum case
        unknown_enum_case,
        //: class array element copy requires a typed local initializer
        class_array_copy_requires_typed_initializer,
        //: array literals require a typed local initializer
        array_literal_requires_typed_initializer,
        //: byte-string literals require a typed local u8 array initializer
        byte_string_requires_typed_array_initializer,
        //: field access currently requires a class local
        field_access_requires_class_local,
        //: aggregate fields require a fresh typed class projection or checked indexing
        aggregate_field_requires_projection_or_indexing,
        //: class construction requires a typed local initializer
        class_construction_requires_typed_initializer,
        //: array values are only supported in local initializers and indexing
        array_value_requires_initializer_or_indexing,
        //: class values are only supported in local initializers and field accesses
        class_value_requires_initializer_or_field_access,
        //: service capability is not a value
        service_capability_not_value,
        //: owned values cannot be implicitly copied; use move, read, or borrow
        implicit_owned_value_copy,
        //: span capability cannot be used as a scalar value
        span_capability_not_scalar,
        //: integer literal out of range
        integer_literal_range,
        //: expected u64 or u8 bitwise operand
        bitwise_operand_type,
        //: logical paths must preserve the same borrow state
        logical_borrow_state_mismatch,
        //: logical paths must preserve exact byte ownership state
        logical_byte_ownership_state_mismatch,
        //: expected u64 or u8 shift operand
        shift_operand_type,
        //: expected u64 or u8 bitwise operands
        bitwise_operands_type,
        //: expected i64, u64 or u8 arithmetic operands
        arithmetic_operands_type,
        //: expected i64, u64 or u8 ordered comparison operands
        ordered_comparison_operands_type,
        //: invalid expression
        invalid_expression,
        //: borrow_bytes requires a span binding or span argument
        borrow_bytes_requires_span_binding_or_argument,
        //: expected distinct i64, u64 or u8 conversion types
        integer_conversion_types,
        //: len requires an array local or receiver field
        len_requires_local_or_receiver_array,
        //: read requires own, ref, or mutref
        read_requires_ownership_reference,
        //: owner is exclusively borrowed
        owner_exclusively_borrowed,
        //: write requires a non-const mutable reference binding
        write_requires_mutable_reference,
        //: ownership constructors are only supported in typed local initializers
        ownership_constructor_requires_typed_initializer,
        //: unknown function '{name}'
        unknown_function,
        //: static_assert supports literals, reflection, comparisons, !, && and || only
        unsupported_static_assert_expression,
        //: unreachable statement
        unreachable_statement,
        //: [synthetic] byte array lifetime ends while borrowed
        byte_array_lifetime_while_borrowed,
        //: owning class field reassignment is unsupported
        owning_class_field_reassignment,
        //: class field assignment requires a complete local name
        class_field_assignment_requires_complete_local,
        //: direct copied return requires a class-returning function
        direct_copied_return_requires_class_result,
        //: class argument requires a copied constructor
        class_argument_requires_copied_constructor,
        //: class argument requires a complete local name
        class_argument_requires_complete_local,
        //: class projection requires a copied class array
        class_projection_requires_copied_array,
        //: class projection requires a named local receiver
        class_projection_requires_named_receiver,
        //: class projection requires a class field
        class_projection_requires_class_field,
        //: owning field extraction is unsupported
        owning_field_extraction,
        //: class initializer requires a class-returning function
        class_initializer_requires_class_result,
        //: constructor-bearing class rejects designated initialization
        constructor_class_designated_initialization,
        //: class construction requires public fields; private construction requires a declared constructor
        private_class_construction_requires_constructor,
        //: class local requires named-field construction or same-type class copy
        class_initializer_requires_fields_or_copy,
        //: [synthetic] duplicate field initializer
        duplicate_field_initializer,
        //: every class field must be initialized exactly once
        incomplete_class_field_initialization,
        //: class array initialization requires exactly one complete named value per element
        class_array_initializer_count,
        //: class array initializer elements require complete local names
        class_array_initializer_requires_complete_locals,
        //: byte-string initializers require u8 array elements
        byte_string_requires_byte_elements,
        //: array initializer length does not match its declared type: expected {integer} bytes, got {integer} decoded
        //: bytes
        byte_array_initializer_length,
        //: array local requires an array literal or same-type array copy
        array_initializer_requires_literal_or_copy,
        //: array initializer length does not match its declared type
        array_initializer_length,
        //: returned span must derive directly from one private receiver byte-storage field
        returned_span_requires_private_receiver_storage,
        //: all returned spans must derive from the same receiver byte-storage field
        returned_span_field_mismatch,
        //: class return requires a complete local name, direct copied-class constructor or ordinary call
        class_return_requires_local_constructor_or_call,
        //: static assertion failed
        static_assertion_failed,
        //: service capability cannot be stored in a local
        local_service_capability,
        //: region authority is available only as the first function parameter
        region_parameter_position,
        //: span bindings must be const and cannot be rebound
        span_binding_requires_const,
        //: ownership binding requires explicit constructor
        ownership_binding_requires_constructor,
        //: cannot move a const owner into a mutable binding
        move_const_owner_to_mutable_binding,
        //: cannot move a borrowed owner
        move_borrowed_owner,
        //: cannot mutably borrow a const owner
        mutable_borrow_of_const_owner,
        //: conflicting borrow
        conflicting_borrow,
        //: constructor does not match ownership type
        ownership_constructor_type,
        //: const method cannot write receiver arrays
        const_method_writes_receiver_array,
        //: index assignment requires a mutable array local
        index_assignment_requires_mutable_array,
        //: cannot mutate a byte array while a span is live
        byte_array_mutation_while_span_live,
        //: class array replacement requires a complete local name
        class_array_replacement_requires_complete_local,
        //: loop conditions cannot transfer an outer byte owner
        loop_condition_transfers_outer_owner,
        //: loop backedge cannot move an outer owner; moves require a returning path
        loop_backedge_moves_outer_owner,
        //: loop backedge must preserve outer borrow state
        loop_backedge_borrow_state_mismatch,
        //: borrowed object parameters support public methods, not field assignment
        borrowed_object_field_assignment,
        //: field assignment requires a mutable class local
        field_assignment_requires_mutable_class,
        //: whole aggregate or resource field assignment is unsupported
        aggregate_or_resource_field_assignment,
        //: field assignment value consumed the containing object
        field_assignment_consumed_object,
        //: [synthetic] const method cannot write receiver fields
        const_method_writes_receiver_field,
        //: assignment requires a mutable scalar local
        assignment_requires_mutable_scalar,
        //: continuing branches must preserve the same borrow state
        branch_borrow_state_mismatch,
        //: continuing branches must preserve exact byte ownership state
        branch_byte_ownership_state_mismatch,
        //: [unlocated] too many class types for bootstrap type IDs
        nominal_type_id_limit,
        //: [unlocated] module graph exceeds 64 enum declarations
        enum_declaration_limit,
        //: enum requires a unique name and 1 to 256 cases
        enum_name_or_case_count,
        //: duplicate enum case
        duplicate_enum_case,
        //: duplicate or reserved class name
        duplicate_or_reserved_class_name,
        //: owning classes cannot be template arguments
        owning_class_template_argument,
        //: composed or owning class storage exceeds 520 bytes
        composed_or_owning_class_storage_limit,
        //: duplicate or reserved function name
        duplicate_or_reserved_function_name,
        //: at most six parameters supported
        function_parameter_limit,
        //: service capabilities cannot be returned
        service_capability_result,
        //: service functions require one leading exclusive sealed service reference and copied result
        service_function_leading_parameter_or_result,
        //: service group requires distinct leading exclusive sealed references
        service_group_requires_distinct_leading_references,
        //: service functions require a leading exclusive sealed service group and copied result
        service_function_group_or_result,
        //: service helper parameters require scalars, enums or readonly byte spans
        service_helper_parameter_type,
        //: service capability must be the leading exclusive parameter
        service_capability_parameter_position,
        //: borrowed functions require one leading concrete owning-class reference and a scalar or copied result
        borrowed_function_boundary,
        //: borrowed parameters cannot name a class template
        borrowed_class_template_parameter,
        //: later borrowed-function parameters require scalar, copied class or readonly span values
        borrowed_function_later_parameter_type,
        //: const borrowed permission requires a borrowed parameter
        const_permission_requires_borrowed_parameter,
        //: resource functions and owning constructors require one first region parameter and scalar, copied class or
        //: owning result
        resource_function_region_or_result,
        //: resource arguments require scalar values or moved owners
        resource_argument_type,
        //: owning constructor requires its internal scalar result
        owning_constructor_result,
        //: span results require a const non-template class method
        span_result_method_boundary,
        //: methods require scalar, enum or copyable class results
        method_result_type,
        //: methods require scalar, enum or copyable class parameters
        method_parameter_type,
        //: function-boundary classes are limited to 64 scalar fields excluding u8, 512 u8 leaves and 513 total leaves
        function_class_leaf_limit,
        //: function-boundary class storage exceeds 520 bytes
        function_class_storage_limit,
        //: unknown constructor field initializer
        unknown_constructor_field_initializer,
        //: duplicate constructor field initializer
        duplicate_constructor_field_initializer,
        //: constructor must initialize every field exactly once
        incomplete_constructor_field_initialization,
        //: constructor byte field belongs to a different region
        constructor_byte_field_region_mismatch,
        //: class field initializer requires a complete named class value
        class_field_initializer_requires_complete_local,
        //: array fields require explicit empty-brace zero initialization
        array_field_requires_empty_initialization,
        //: empty-brace constructor initialization is restricted to array fields
        empty_initialization_requires_array_field,
        //: function must return on every path
        missing_return_path,
        //: span-result method has no verified receiver-field return
        span_method_missing_field_return,
        //: [unlocated] unknown nominal type in reflection view
        unknown_reflection_nominal,

        // Existing unlocated IR-layout integrity guards use status invalid.
        //: [integrity] IR: storage extent exceeds 65536 bytes
        ir_storage_extent_limit,
        //: [integrity] IR: cyclic or excessive class storage depth
        ir_class_storage_depth,
        //: [integrity] IR: missing logical class storage shape
        ir_missing_class_storage_shape,
        //: [integrity] IR: invalid class storage alignment
        ir_class_storage_alignment,
        //: [integrity] IR: invalid logical field range for storage
        ir_logical_field_storage_range,
        //: [integrity] IR: owned byte field requires one non-scalar descriptor
        ir_owned_byte_field_descriptor,
        //: [integrity] IR: nested owning class fields are unsupported
        ir_nested_owning_class_field,
        //: [integrity] IR: invalid nested field storage shape
        ir_nested_field_storage_shape,
        //: [integrity] IR: invalid scalar field storage shape
        ir_scalar_field_storage_shape,
        //: [integrity] IR: class storage exceeds 65536 bytes
        ir_class_storage_limit,
        //: [integrity] IR: class storage does not cover logical leaves
        ir_class_storage_leaf_coverage,

        //: paired borrowed roots cannot produce spans
        paired_borrowed_span_production
    };

    // Four eight-byte words in this order. Failure never publishes a module
    // root; -1 denotes an absent diagnostic reservation or module root.
    // Allocation/entry failures without a selected reason carry none.
    class LoweringResult {
        LoweringStatus result_status;
        LoweringError result_reason;
        i64 diagnostic_row;
        i64 root_row;
    public:
        LoweringResult(LoweringStatus status, LoweringError reason, i64 diagnosticPayloadRow,
            i64 moduleRoot) : result_status(status), result_reason(reason), diagnostic_row(diagnosticPayloadRow),
            root_row(moduleRoot) {
        }
        auto status() const -> LoweringStatus {
            return result_status;
        }
        auto reason() const -> LoweringError {
            return result_reason;
        }
        auto diagnostic_payload_row() const -> i64 {
            return diagnostic_row;
        }
        auto module_root() const -> i64 {
            return root_row;
        }
    };
}
