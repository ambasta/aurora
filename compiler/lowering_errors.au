        // Existing unlocated IR-layout integrity guards use status invalid.
        ir_storage_extent_limit,
        ir_class_storage_depth,
        ir_missing_class_storage_shape,
        ir_class_storage_alignment,
        ir_logical_field_storage_range,
        ir_owned_byte_field_descriptor,
