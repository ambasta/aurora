export module aurora.compiler.lowering_errors;

// The selected reason is semantic authority owned by Aurora; lowering_messages.au
// renders its message. Layout integrity reasons use status invalid.
export namespace compiler_lowering {
    enum class LoweringStatus {
        success,
        semantic_failure,
        storage_failure,
        invalid
    };

    enum class LoweringError {
        none,
        unknown_class_type,
        owned_values_require_copied_element,
        class_array_requires_concrete_copied_elements,
        class_array_containment_depth,
