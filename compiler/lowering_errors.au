    // Four eight-byte words in this order. Failure never publishes a module
    // root; -1 denotes an absent diagnostic reservation or module root.
    // Allocation/entry failures without a selected reason carry none.
    class LoweringResult {
        LoweringStatus result_status;
        LoweringError result_reason;
        i64 diagnostic_row;
        i64 root_row;
    public:
        LoweringResult(LoweringStatus status, LoweringError reason, i64 diagnosticPayloadRow,
            i64 moduleRoot) : result_status(status), result_reason(reason), diagnostic_row(diagnosticPayloadRow),
            root_row(moduleRoot) {
        }
        auto status() const -> LoweringStatus {
            return result_status;
        }
        auto reason() const -> LoweringError {
            return result_reason;
        }
        auto diagnostic_payload_row() const -> i64 {
            return diagnostic_row;
        }
        auto module_root() const -> i64 {
            return root_row;
        }
    };
}
