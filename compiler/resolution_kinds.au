export module aurora.compiler.resolution_kinds;

// Private generated bridge vocabulary. The emitted enum facts, rather than a
// handwritten host ordinal table, define these values.
export namespace compiler_resolver {
    enum class ResolvedTypeKind {
        invalid,
        i64_value,
        u64_value,
        u8_value,
        bool_value,
        owner,
        reference,
        mutable_reference,
        class_value,
        enum_value,
        array_value,
        parameter,
        byte_span,
        byte_region,
        owned_bytes,
        console_session,
        display_session,
        event_session,
        owned_values,
        call_session
    };
    enum class DeclarationKind {
        invalid,
        function,
        class_value,
        class_template,
        function_template,
        enumeration,
        method,
        constructor
    };
    enum class NativeMode {
        invalid,
        root_entry,
        function,
        value_function,
        ordinary_overload,
        class_value,
        class_template,
        function_template,
        enumeration,
        method,
        constructor,
        sealed_builtin
    };
    enum class ResolvedOperation {
        unchanged,
        constructor_call,
        implicit_method_call,
        enum_case,
        capacity_constant
    };
    enum class SemanticError {
        none,
        reserved_prefix,
        reserved_builtin,
        duplicate_member,
        namespace_collision,
        reserved_class,
        reserved_function,
        duplicate_class,
        duplicate_function,
        enum_count,
        enum_cases,
        duplicate_enum_case,
        template_count,
        overload_count,
        answer_overload,
        borrowed_overload,
        ambiguous_visible,
        wrong_kind,
        private_function,
        private_type,
        unknown_argument,
        argument_concrete,
        owned_named,
        unsubstituted_array,
        unsubstituted_parameter,
        template_static_type,
        template_function_call,
        template_static_body,
        unknown_function_template,
        function_arity,
        unexpanded_function,
        instance_count,
        template_depth,
        unknown_template,
        class_arity,
        template_nominal_depth,
        unexpanded_class,
        array_elements,
        unknown_array_element,
        class_array_capacity,
        unknown_resolved_type,
        resolved_import,
        array_explicit,
        concrete_type,
        type_import,
        unknown_class_declaration,
        method_parameter,
        constructor_parameter,
        class_signature_import,
        export_class_private,
        argument_import,
        function_fixed_unknown,
        function_signature_template,
        export_template_private,
        function_signature_concrete,
        function_signature_import,
        export_function_private,
        function_template_signature_import,
        export_function_template_private,
        unknown_signature,
        overload_parameters,
        duplicate_overload,
        array_constructor,
        template_expression,
        function_template_arguments,
        construction_import,
        field_callable,
        initializer_method,
        unknown_function,
        class_arguments,
        function_arguments,
        enum_named,
        unknown_builtin_case,
        unknown_enum_case,
        missing_function,
        class_parameters,
        duplicate_class_parameter,
        capacity_order,
        unresolved_nested_argument,
        class_scalar_argument,
        class_value_argument,
        class_capacity,
        shadow_capacity,
        class_body_template,
        unknown_class_parameter,
        array_scalar_parameter,
        unknown_capacity,
        invalid_substituted_array,
        dependent_array,
        dependent_conversion,
        capacity_callable,
        capacity_move,
        capacity_assign,
        function_nested_dependent,
