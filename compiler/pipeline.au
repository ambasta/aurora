// The message of every metadata, instruction and verification rejection the
// pipeline reports. Each table appends the text of its one selected reason r;
// a `typed` line is a typed-IR rejection, after "invalid typed IR: ".
export namespace compiler_ir_metadata {
    // The message of each MetadataError reason; none has none.
    auto metadata_text(compiler_resolver::Report report, MetadataError r) -> compiler_resolver::Report {
        compiler_resolver::Report value = report;
        value.when(r == MetadataError::integrity, "invalid hosted IR metadata transport");
        value.typed(r == MetadataError::descriptor, "invalid metadata descriptor");
        value.typed(r == MetadataError::root_scope, "missing root reflection scope");
        value.typed(r == MetadataError::scope, "invalid reflection scope");
        value.typed(r == MetadataError::view_descriptor, "reflection view references missing descriptor");
        value.typed(r == MetadataError::enum_count, "too many enum declarations");
        value.typed(r == MetadataError::enum_declaration, "invalid nominal enum declaration");
        value.typed(r == MetadataError::nominal_overlap, "class and enum nominal names overlap");
        value.typed(r == MetadataError::class_layout, "invalid nominal class layout");
        value.typed(r == MetadataError::class_field_limit, "class exceeds 8192 direct fields");
        value.typed(r == MetadataError::class_leaf, "non-scalar class layout field");
        value.typed(r == MetadataError::unknown_fields, "logical fields reference unknown class layout");
        value.typed(r == MetadataError::field_element_count, "noncanonical class array element count");
        value.typed(r == MetadataError::nested_carrier, "class array carrier cannot be nested element type");
        value.typed(r == MetadataError::field_shape, "invalid logical class field shape");
        value.typed(r == MetadataError::owner_leaves, "owned storage field requires zero scalar leaves");
        value.typed(r == MetadataError::owner_field_type, "invalid canonical owned value field type");
        value.typed(r == MetadataError::nested_owner, "nested owning class field is unsupported");
        value.typed(r == MetadataError::nested_type, "invalid nominal nested class field");
        value.typed(r == MetadataError::class_array_count, "class array element count exceeds 1..64");
        value.typed(r == MetadataError::nested_length, "nested class field length mismatch");
        value.typed(r == MetadataError::field_range, "logical class field range exceeds layout");
        value.typed(r == MetadataError::nested_leaf, "nested class field leaf type mismatch");
        value.typed(r == MetadataError::field_leaf, "logical class field leaf type mismatch");
        value.typed(r == MetadataError::leaf_coverage, "logical class fields do not cover complete layout");
        value.typed(r == MetadataError::class_leaf_limit,
            "composed or owning class exceeds 64 scalar leaves excluding u8, 512 u8 leaves or 513 total leaves");
        value.typed(r == MetadataError::unknown_carrier, "unknown class array carrier");
        value.typed(r == MetadataError::carrier_shape, "class array carrier requires exactly one class array field");
        value.typed(r == MetadataError::cycle, "cyclic nested class layout");
        value.typed(r == MetadataError::depth, "nested class layout exceeds depth 4");
        value.typed(r == MetadataError::console_layout, "noncanonical sealed ConsoleSample layout");
        value.typed(r == MetadataError::console_fields, "noncanonical sealed ConsoleSample fields");
        value.typed(r == MetadataError::console_field_shape, "noncanonical sealed ConsoleSample field shape");
        value.typed(r == MetadataError::event_layout, "noncanonical sealed IommuEventSample layout");
        value.typed(r == MetadataError::event_fields, "noncanonical sealed IommuEventSample fields");
        value.typed(r == MetadataError::event_field_shape, "noncanonical sealed IommuEventSample field shape");
        value.typed(r == MetadataError::event_enum, "noncanonical sealed event service enum");
        value.typed(r == MetadataError::service_enum, "noncanonical sealed service enum");
        value.when(r == MetadataError::storage_extent, "IR: storage extent exceeds 65536 bytes");
        value.when(r == MetadataError::storage_depth, "IR: cyclic or excessive class storage depth");
        value.when(r == MetadataError::storage_shape, "IR: missing logical class storage shape");
        value.when(r == MetadataError::storage_alignment, "IR: invalid class storage alignment");
        value.when(r == MetadataError::storage_field_range, "IR: invalid logical field range for storage");
        value.when(r == MetadataError::storage_owner_shape, "IR: owned byte field requires one non-scalar descriptor");
        value.when(r == MetadataError::storage_nested_owner, "IR: nested owning class fields are unsupported");
        value.when(r == MetadataError::storage_nested_shape, "IR: invalid nested field storage shape");
        value.when(r == MetadataError::storage_scalar_shape, "IR: invalid scalar field storage shape");
        value.when(r == MetadataError::storage_limit, "IR: class storage exceeds 65536 bytes");
        value.when(r == MetadataError::storage_coverage, "IR: class storage does not cover logical leaves");
        value.typed(r == MetadataError::owner_type, "invalid canonical owned value type");
        value.typed(r == MetadataError::owner_element_unknown,
            "owned value element requires known canonical class layout");
        value.typed(r == MetadataError::owner_element_kind,
            "owned value element must be a copied class, not an owner or carrier");
        value.typed(r == MetadataError::owner_element_leaves, "owned value element exceeds copied class leaf limits");
        value.typed(r == MetadataError::owner_element_storage, "owned value element storage exceeds 520 bytes");
        value.typed(r == MetadataError::class_storage_limit, "composed or owning class storage exceeds 520 bytes");
        value.typed(r == MetadataError::supplied_storage, "noncanonical class storage metadata");
        value.typed(r == MetadataError::empty_module, "empty module");
        value.typed(r == MetadataError::function_symbol, "invalid or reserved function symbol");
        value.typed(r == MetadataError::duplicate_function, "duplicate function");
        value.typed(r == MetadataError::function_scope, "unknown function module scope");
        value.typed(r == MetadataError::service_signature,
            "service signature requires a leading sealed group and no receiver or region");
        value.typed(r == MetadataError::service_duplicates, "service signature requires distinct capability kinds");
        value.typed(r == MetadataError::service_group, "unsupported service group");
        value.typed(r == MetadataError::service_parameters,
            "service signature requires later scalar, enum, copied value or readonly span arguments");
        value.typed(r == MetadataError::service_result, "service signature has unsupported result");
        value.typed(r == MetadataError::borrowed_shape, "borrowed roots require a free-function signature");
        value.typed(r == MetadataError::borrowed_result, "borrowed formal cannot have resource or borrowed result");
        value.typed(r == MetadataError::borrowed_parameters, "borrowed roots count toward six parameters");
        value.typed(r == MetadataError::borrowed_root_type, "borrowed root requires a canonical named class type");
        value.typed(r == MetadataError::service_resource_slot, "invalid service resource storage declaration");
        value.typed(r == MetadataError::borrowed_root_class,
            "borrowed root requires a complete concrete owning class or a single supported plain class");
        value.typed(r == MetadataError::borrowed_root_count, "borrowed root count exceeds the explicit formal prefix");
        value.typed(r == MetadataError::borrowed_root_values,
            "multi-root borrowed signature requires scalar or enum values");
        value.typed(r == MetadataError::resource_receiver,
            "resource signature only supports an owning constructor receiver");
        value.typed(r == MetadataError::resource_region, "resource signature requires its region parameter first");
        value.typed(r == MetadataError::resource_result,
            "resource signature requires scalar, owned byte or class result");
        value.typed(r == MetadataError::resource_parameters,
            "resource signature requires exactly one region and supported owning parameters");
        value.typed(r == MetadataError::service_boundary,
            "service capability cannot cross an ordinary boundary or return");
        value.typed(r == MetadataError::service_type, "invalid canonical service boundary type");
        value.typed(r == MetadataError::resource_boundary, "invalid resource boundary type");
        value.typed(r == MetadataError::span_boundary,
            "readonly span boundary requires ordinary parameter or const receiver result");
        value.typed(r == MetadataError::constructor_result, "constructor result must remain scalar");
        value.typed(r == MetadataError::value_type, "invalid value boundary type");
        value.typed(r == MetadataError::value_class, "unknown value boundary class");
        value.typed(r == MetadataError::value_carrier, "class array carrier cannot cross value boundary");
        value.typed(r == MetadataError::value_owner, "owning class requires an ordinary resource boundary");
        value.typed(r == MetadataError::value_resource,
            "only an owning constructor may take a copied class resource parameter");
        value.typed(r == MetadataError::value_leaves,
            "value boundary class exceeds 64 scalar fields excluding u8, 512 u8 leaves or 513 total leaves");
        value.typed(r == MetadataError::value_storage, "value boundary class storage exceeds 520 bytes");
        value.typed(r == MetadataError::span_result, "receiver span field summary requires span result");
        value.typed(r == MetadataError::parameter_count, "too many parameters");
        value.typed(r == MetadataError::receiver_signature, "receiver signature requires scalar, enum or class values");
        value.typed(r == MetadataError::aggregate_parameter, "invalid aggregate parameter type");
        value.typed(r == MetadataError::receiver_class, "unknown receiver class");
        value.typed(r == MetadataError::receiver_carrier, "class array carrier cannot be receiver");
        value.typed(r == MetadataError::receiver_span,
            "receiver span field summary requires exact direct byte-storage field or typed owner of the view element");
        value.typed(r == MetadataError::owner_spill, "owned value metadata requires exact owner spill");
        value.typed(r == MetadataError::service_spills, "service spills without a service signature");
        value.typed(r == MetadataError::frame_size, "invalid frame size");
        value.typed(r == MetadataError::slot_offset, "invalid slot offset");
        value.typed(r == MetadataError::slot_type, "invalid slot payload type");
        value.typed(r == MetadataError::slot_overlap, "overlapping scalar slot storage");
        value.typed(r == MetadataError::object_class, "unknown object class");
        value.typed(r == MetadataError::object_offset, "invalid object layout offset");
        value.typed(r == MetadataError::object_overlap, "overlapping object layouts");
        value.typed(r == MetadataError::object_leaf, "object field slot type/layout mismatch");
        value.typed(r == MetadataError::object_padding, "scalar slot overlaps empty object or padding");
        value.typed(r == MetadataError::array_extent, "invalid byte array origin extent");
        value.typed(r == MetadataError::array_leaf, "byte array origin requires exact u8 element slots");
        value.typed(r == MetadataError::array_object, "byte array origin overlaps object storage");
        value.typed(r == MetadataError::array_overlap, "overlapping byte array origins");
        value.typed(r == MetadataError::span_extent, "invalid span spill extent or alignment");
        value.typed(r == MetadataError::span_overlap, "span spill overlaps scalar, object or array storage");
        value.typed(r == MetadataError::span_spills, "overlapping span spills");
        value.typed(r == MetadataError::service_extent, "invalid service spill extent or alignment");
        value.typed(r == MetadataError::service_overlap,
            "service spill overlaps scalar, object, array or span storage");
        value.typed(r == MetadataError::region_extent, "invalid region spill extent or alignment");
        value.typed(r == MetadataError::region_overlap, "region spill overlaps scalar, object, array or span storage");
        value.typed(r == MetadataError::byte_extent, "invalid owned byte spill extent or alignment");
        value.typed(r == MetadataError::byte_overlap,
            "owned byte spill overlaps scalar, object, array or span storage");
        value.typed(r == MetadataError::resource_overlap, "overlapping region or owned byte spills");
        value.typed(r == MetadataError::call_layout, "noncanonical sealed CallResult layout");
        value.typed(r == MetadataError::call_fields, "noncanonical sealed CallResult fields");
        value.typed(r == MetadataError::bootstrap_layout, "noncanonical sealed bootstrap preparation layout");
        value.typed(r == MetadataError::execution_layout, "noncanonical sealed Execution observation layout");
        value.typed(r == MetadataError::execution_fields, "noncanonical sealed Execution observation fields");
        value.typed(r == MetadataError::span_value_type, "invalid canonical typed span type");
        value.typed(r == MetadataError::span_element_unknown,
            "typed span element requires known canonical class layout");
        value.typed(r == MetadataError::span_element_kind,
            "typed span element must be a copied class, not an owner or carrier");
        value.typed(r == MetadataError::span_element_leaves, "typed span element exceeds copied class leaf limits");
        value.typed(r == MetadataError::span_element_storage, "typed span element storage exceeds 520 bytes");
        value.typed(r == MetadataError::span_value_spill, "typed span metadata requires exact span spill");
        value.typed(r == MetadataError::host_layout, "noncanonical sealed HostFiles result layout");
        value.typed(r == MetadataError::host_fields, "noncanonical sealed HostFiles result fields");
        return value;
    }
}
export namespace compiler_ir_instructions {
    // The message of each InstructionError reason; none has none.
    auto instruction_text(compiler_resolver::Report report, InstructionError r) -> compiler_resolver::Report {
        compiler_resolver::Report value = report;
        value.when(r == InstructionError::integrity, "invalid hosted IR instruction transport");
        value.typed(r == InstructionError::service_resource_shape, "invalid service resource operation shape");
        value.typed(r == InstructionError::noncanonical_type, "noncanonical instruction type payload");
        value.typed(r == InstructionError::empty_body, "empty function body");
        value.typed(r == InstructionError::invalid_label, "duplicate or invalid label");
        value.typed(r == InstructionError::unknown_jump, "unknown jump target");
        value.typed(r == InstructionError::unknown_branch, "unknown branch target");
        value.typed(r == InstructionError::reachable_fallthrough, "reachable fallthrough without return");
        value.typed(r == InstructionError::unreachable_semantic, "unreachable semantic instruction");
        value.typed(r == InstructionError::service_prefix, "service bindings must form the leading entry group");
        value.typed(r == InstructionError::service_overlap, "service parameter bindings overlap");
        value.typed(r == InstructionError::region_prefix, "region parameter binding must begin the entry prefix");
        value.typed(r == InstructionError::owner_prefix, "owned byte parameter bindings must form the entry prefix");
        value.typed(r == InstructionError::owner_overlap, "owned byte parameter bindings overlap");
        value.typed(r == InstructionError::owning_prefix, "owning class parameter bindings must form the entry prefix");
        value.typed(r == InstructionError::owning_overlap, "owning class parameter bindings overlap");
        value.typed(r == InstructionError::object_prefix, "object parameter bindings must form the entry prefix");
        value.typed(r == InstructionError::object_overlap, "object parameter bindings overlap");
        value.typed(r == InstructionError::span_prefix, "span parameter bindings must form the entry prefix");
        value.typed(r == InstructionError::span_overlap, "span parameter bindings overlap");
        value.typed(r == InstructionError::scalar_prefix, "parameter bindings must form the entry prefix");
        value.typed(r == InstructionError::scalar_overlap, "scalar parameter bindings overlap");
        value.typed(r == InstructionError::late_binding, "parameter binding outside entry prefix");
        value.typed(r == InstructionError::service_binding,
            "service binding requires exact authorized leading parameter");
        value.typed(r == InstructionError::region_slot, "region parameter requires exact typed spill");
        value.typed(r == InstructionError::owner_type, "owned byte parameter type mismatch");
        value.typed(r == InstructionError::owner_region, "owned byte parameter requires bound region");
        value.typed(r == InstructionError::owner_slot, "owned byte parameter requires exact typed spill");
        value.typed(r == InstructionError::owner_mutable, "owned byte parameter must be mutable");
        value.typed(r == InstructionError::span_type, "span parameter type mismatch");
        value.typed(r == InstructionError::span_slot, "span parameter requires exact typed spill");
        value.typed(r == InstructionError::owning_type, "owning class parameter type mismatch");
        value.typed(r == InstructionError::owning_region, "owning class parameter requires bound region");
        value.typed(r == InstructionError::owning_slot, "owning class parameter requires exact nominal object slot");
        value.typed(r == InstructionError::owning_mutable, "owning class parameter must be mutable");
        value.typed(r == InstructionError::object_owner, "copied parameter cannot bind owning class");
        value.typed(r == InstructionError::object_type, "object parameter type mismatch");
        value.typed(r == InstructionError::object_slot, "object parameter requires exact object slot");
        value.typed(r == InstructionError::object_nominal, "object parameter nominal class mismatch");
        value.typed(r == InstructionError::object_readonly, "object parameter must be readonly");
        value.typed(r == InstructionError::scalar_type, "parameter type mismatch");
        value.typed(r == InstructionError::scalar_object, "parameter cannot bind object field storage");
        value.typed(r == InstructionError::scalar_array, "parameter cannot bind byte array origin storage");
        value.typed(r == InstructionError::scalar_slot, "slot type/layout mismatch");
        value.typed(r == InstructionError::call_runtime, "ordinary call cannot target runtime symbol");
        value.typed(r == InstructionError::call_target, "unknown call target");
        value.typed(r == InstructionError::call_receiver, "plain call cannot target receiver function");
        value.typed(r == InstructionError::call_service, "plain call cannot bypass a service loan");
        value.typed(r == InstructionError::call_resource, "plain call cannot target resource signature");
        value.typed(r == InstructionError::call_aggregate, "plain call cannot target aggregate signature");
        value.typed(r == InstructionError::aggregate_target, "unknown aggregate call target");
        value.typed(r == InstructionError::aggregate_receiver, "aggregate call cannot target receiver function");
        value.typed(r == InstructionError::aggregate_service, "aggregate call cannot bypass a service loan");
        value.typed(r == InstructionError::aggregate_resource, "aggregate call cannot target resource signature");
        value.typed(r == InstructionError::aggregate_signature, "aggregate call requires aggregate signature");
        value.typed(r == InstructionError::aggregate_vector, "aggregate call argument vector size mismatch");
        value.typed(r == InstructionError::aggregate_span_vector, "span call argument vector size mismatch");
        value.typed(r == InstructionError::aggregate_span_object, "span argument cannot name object storage");
        value.typed(r == InstructionError::aggregate_nonspan, "non-span argument cannot name span storage");
        value.typed(r == InstructionError::aggregate_scalar, "scalar argument cannot name object storage");
        value.typed(r == InstructionError::aggregate_parameter, "invalid aggregate parameter type");
        value.typed(r == InstructionError::aggregate_argument_slot, "aggregate argument requires exact object slot");
        value.typed(r == InstructionError::aggregate_argument_alias, "aggregate argument snapshots must be distinct");
        value.typed(r == InstructionError::aggregate_argument_nominal, "aggregate argument nominal class mismatch");
        value.typed(r == InstructionError::aggregate_argument_readonly, "aggregate argument snapshot must be readonly");
        value.typed(r == InstructionError::aggregate_result_slot, "aggregate result requires exact object slot");
        value.typed(r == InstructionError::aggregate_result_alias, "aggregate result aliases argument snapshot");
        value.typed(r == InstructionError::aggregate_result_nominal, "aggregate result nominal class mismatch");
        value.typed(r == InstructionError::aggregate_result_type, "invalid aggregate result type");
        value.typed(r == InstructionError::aggregate_scalar_result, "scalar result cannot name object storage");
        value.typed(r == InstructionError::resource_target, "unknown resource call target");
        value.typed(r == InstructionError::resource_signature,
            "resource call requires ordinary resource signature or owning constructor");
        value.typed(r == InstructionError::resource_private, "private constructor requires lexical class authority");
        value.typed(r == InstructionError::resource_receiver, "resource call receiver offset does not match target");
        value.typed(r == InstructionError::call_region_slot, "region requires exact typed spill");
        value.typed(r == InstructionError::resource_vector, "resource call argument vector size mismatch");
        value.typed(r == InstructionError::resource_constructor_argument,
            "constructor cannot take owning class arguments");
        value.typed(r == InstructionError::resource_argument_alias, "resource call argument storage must be distinct");
        value.typed(r == InstructionError::resource_receiver_alias,
            "resource constructor receiver aliases owning argument");
        value.typed(r == InstructionError::call_owner_slot, "owner type requires exact typed spill");
        value.typed(r == InstructionError::resource_argument_nominal,
            "resource call owner argument nominal type mismatch");
        value.typed(r == InstructionError::call_owner_mutable, "const owned byte binding cannot be mutated or moved");
        value.typed(r == InstructionError::call_owning_nominal, "owning object nominal class mismatch");
        value.typed(r == InstructionError::call_owning_mutable, "const owning object cannot be moved or mutated");
        value.typed(r == InstructionError::resource_copied_receiver,
            "constructor receiver aliases copied argument snapshot");
        value.typed(r == InstructionError::resource_copied_nominal,
            "constructor copied argument nominal class mismatch");
        value.typed(r == InstructionError::resource_copied_readonly,
            "constructor copied argument snapshot must be readonly");
        value.typed(r == InstructionError::resource_nonowner, "resource call non-owner argument cannot name storage");
        value.typed(r == InstructionError::resource_first, "resource call first argument must be region");
        value.typed(r == InstructionError::resource_parameter, "invalid resource call parameter type");
        value.typed(r == InstructionError::resource_constructor_result,
            "owning constructor requires scalar result and no result storage");
        value.typed(r == InstructionError::resource_constructor_root,
            "owning constructor requires exact nominal receiver root");
        value.typed(r == InstructionError::resource_result_alias, "resource call owning result aliases argument");
        value.typed(r == InstructionError::resource_result_nominal, "resource call owner result nominal type mismatch");
        value.typed(r == InstructionError::resource_copied_result_slot,
            "resource copied result requires exact object slot");
        value.typed(r == InstructionError::resource_copied_result_alias,
            "resource copied result aliases argument storage");
        value.typed(r == InstructionError::resource_copied_result_nominal,
            "resource copied result nominal class mismatch");
        value.typed(r == InstructionError::resource_result_type, "invalid resource call result type");
        value.typed(r == InstructionError::resource_scalar_result,
            "scalar resource call result cannot name owning storage");
        value.typed(r == InstructionError::call_copy_slot, "copy requires exact object slot");
        value.typed(r == InstructionError::call_copy_nominal, "copy nominal class mismatch");
        value.typed(r == InstructionError::method_target, "unknown method call target");
        value.typed(r == InstructionError::method_receiver, "method call requires receiver target");
        value.typed(r == InstructionError::borrowed_target, "borrowed call requires borrowed formal target");
        value.typed(r == InstructionError::borrowed_roots, "borrowed call root lanes do not match target");
        value.typed(r == InstructionError::borrowed_loan, "borrowed call requires active loan");
        value.typed(r == InstructionError::borrowed_root,
            "borrowed call root, lifetime, nominal type or authority mismatch");
        value.typed(r == InstructionError::borrowed_selector, "invalid borrowed object root");
        value.typed(r == InstructionError::borrowed_unbound, "borrowed object root is not bound");
        value.typed(r == InstructionError::method_borrowed, "method call cannot target borrowed free function");
        value.typed(r == InstructionError::method_private, "private method requires lexical class authority");
        value.typed(r == InstructionError::method_resource,
            "method call cannot target resource signature or owning constructor");
        value.typed(r == InstructionError::method_signature,
            "receiver signature requires scalar, enum or class values");
        value.typed(r == InstructionError::constructor_vector, "constructor object argument vector size mismatch");
        value.typed(r == InstructionError::method_vector, "receiver object argument vector size mismatch");
        value.typed(r == InstructionError::method_span_vector, "method span argument vector size mismatch");
        value.typed(r == InstructionError::method_span_object, "span method argument cannot name object storage");
        value.typed(r == InstructionError::method_nonspan, "non-span method argument cannot name span storage");
        value.typed(r == InstructionError::constructor_scalar,
            "scalar constructor argument cannot name object storage");
        value.typed(r == InstructionError::method_scalar, "scalar receiver argument cannot name object storage");
        value.typed(r == InstructionError::constructor_receiver_alias,
            "constructor receiver aliases argument snapshot");
        value.typed(r == InstructionError::method_receiver_alias, "receiver aliases argument snapshot");
        value.typed(r == InstructionError::constructor_argument_alias,
            "constructor argument snapshots must be distinct");
        value.typed(r == InstructionError::method_argument_alias, "receiver argument snapshots must be distinct");
        value.typed(r == InstructionError::constructor_argument_nominal, "constructor argument nominal class mismatch");
        value.typed(r == InstructionError::method_argument_nominal, "receiver argument nominal class mismatch");
        value.typed(r == InstructionError::constructor_argument_readonly,
            "constructor argument snapshot must be readonly");
        value.typed(r == InstructionError::method_argument_readonly, "receiver argument snapshot must be readonly");
        value.typed(r == InstructionError::method_offset, "invalid method receiver offset");
        value.typed(r == InstructionError::method_field_index, "invalid method receiver field index");
        value.typed(r == InstructionError::method_nested_constructor, "nested receiver cannot call constructor");
        value.typed(r == InstructionError::method_field_root, "invalid owned field root offset");
        value.typed(r == InstructionError::method_field_authority,
            "borrowed free formal grants no direct receiver field authority");
        value.typed(r == InstructionError::method_field_unbound, "receiver access without bound receiver");
        value.typed(r == InstructionError::method_field_layout, "receiver field type/layout mismatch");
        value.typed(r == InstructionError::method_field_constructor,
            "constructor cannot access owned field during initialization");
        value.typed(r == InstructionError::method_field_formal_mutable,
            "const receiver cannot supply mutable owned field");
