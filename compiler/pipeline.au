export namespace compiler_ir_verification {
    // The message of each VerificationErrorFirst reason; none has none.
    auto first_text(compiler_resolver::Report report, VerificationErrorFirst r) -> compiler_resolver::Report {
        compiler_resolver::Report value = report;
        value.when(r == VerificationErrorFirst::internal, "invalid hosted IR verification workspace");
        value.when(r == VerificationErrorFirst::allocation, "hosted IR verification allocation failed");
        value.typed(r == VerificationErrorFirst::block_entry_state_retention_limit_exceeds_65536,
            "block-entry state retention limit exceeds 65536");
        value.typed(r == VerificationErrorFirst::block_entry_operand_retention_limit_exceeds_262144,
            "block-entry operand retention limit exceeds 262144");
        value.typed(r == VerificationErrorFirst::builtin_owner_borrow_invalid_signature,
            "builtin owner borrow requires one mutable root, scalar return and no region authority");
        value.typed(r == VerificationErrorFirst::builtin_owner_borrow_supports_only_scalar_or_copied_tails,
            "builtin owner borrow supports only scalar or copied tails");
        value.typed(r == VerificationErrorFirst::borrowed_object_root_is_not_bound,
            "borrowed object root is not bound");
        value.typed(r == VerificationErrorFirst::builtin_owner_root_is_not_a_class_receiver,
            "builtin owner root is not a class receiver");
        value.typed(r == VerificationErrorFirst::owner_type_requires_exact_typed_spill,
            "owner type requires exact typed spill");
        value.typed(r == VerificationErrorFirst::literal_span_exceeds_byte_string_bound,
            "literal span exceeds byte-string bound");
        value.typed(r == VerificationErrorFirst::literal_span_requires_exact_typed_spill,
