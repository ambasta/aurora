export module aurora.compiler.lowering_calls;
import aurora.compiler.lexer;
import aurora.compiler.lowering_values;
import aurora.compiler.lowering_common;
import aurora.compiler.lowering_types;
import aurora.compiler.lowering_configuration;
import aurora.compiler.lowering_storage;
import aurora.compiler.lowering_kinds;
import aurora.compiler.lowering_errors;
import aurora.compiler.resolver;
import aurora.compiler.resolution_arena;
import aurora.compiler.resolution_rows;
import aurora.compiler.resolution_names;
import aurora.compiler.resolution_kinds;
import aurora.compiler.syntax_arena;
import aurora.compiler.lowering_frames;
import aurora.compiler.builtin_catalog;

// Span, array and call lowering; spans of call results make these one module.
export namespace compiler_lowering {
    auto span_origin_root(LocalRow span) -> i64 {
        if (span.span_origin_kind() == SpanOriginKind::receiver) {
            return -2;
        }
        if (span.span_origin_kind() == SpanOriginKind::literal) {
            return -3;
        }
        if (span.span_origin_kind() == SpanOriginKind::incoming_parameter) {
            return -1;
        }
        return span.origin_local_id();
    }
    // A span local for an expression of the given span type; the request carries
    // the destination (named binding or temporary) and the exact span type.
    auto add_span(compiler_resolver::Session& session, LocalRequest destination, i64 parent, i64 origin, i64 field,
        bool temporary) -> i64 {
        LocalRequest request = destination;
        SpanOriginKind kind = SpanOriginKind::local;
        i64 root = origin;
        if (origin == -1) {
            kind = SpanOriginKind::incoming_parameter;
            root = -1;
        }
        if (origin == -2) {
            kind = SpanOriginKind::receiver;
            root = -1;
        }
        if (origin == -3) {
            kind = SpanOriginKind::literal;
            root = -1;
        }
        request.set_origin(parent, kind, root, field, temporary);
        const i64 result = add_local(session, request);
        if (parent >= 0) {
            change_shared(session, parent, 1);
        }
        if (origin >= 0) {
            change_shared(session, origin, 1);
        }
        return result;
    }
    // borrow_values(owner): a readonly typed view of a named OwnedValues local or
    // a direct private OwnedValues field, including the implicit receiver field.
    auto borrow_values_span(compiler_resolver::Session& session, i64 frame_id) -> bool {
        const ContinuationRow frame = session.continuation(frame_id);
        const i64 node = frame.syntax_node();
        const i64 reference = source_ref(session, node);
        const i64 expected = frame.output_mark();
        if (span_element(session, expected) < 0) {
            return fail(session, LoweringError::invalid_span_initializer, reference);
        }
        require_arity(session, node, 1);
        const i64 target = expression_argument(session, node, 0);
        const compiler_resolver::SyntaxRow target_row = session.syntax(target);
        i64 origin = -2;
        i64 field = -1;
        i64 type = -1;
        if (target_row.expression_kind() == compiler_parser::NodeKind::name) {
            const i64 name = source_ref(session, target);
            if (lookup_local(session, name) < 0) {
                field = implicit_field(session, name);
            }
            if (field < 0) {
                origin = named_source(session, target);
                type = local_type(session, origin);
            } else {
                const i64 receiver_nominal = body_receiver_nominal(session);
                type = field_type(session, receiver_nominal, field);
            }
        } else {
            if (target_row.expression_kind() != compiler_parser::NodeKind::member) {
                return fail(session, LoweringError::borrow_values_requires_named_storage_or_private_field, reference);
            }
            const i64 receiver = target_row.word(1);
            const compiler_resolver::SyntaxRow receiver_row = session.syntax(receiver);
            if (receiver_row.expression_kind() != compiler_parser::NodeKind::name) {
                return fail(session, LoweringError::borrow_values_requires_named_storage_or_private_field, reference);
            }
            origin = named_source(session, receiver);
            const LocalRow local = session.local(origin);
            if (local.borrowed_object()) {
                const i64 member_source = source_ref(session, target);
                return fail(session, LoweringError::borrowed_object_field_access, member_source);
            }
            const i64 member_reference = source_ref(session, target);
            field = checked_field(session, local.concrete_type_id(), member_reference, false);
            const i64 nominal = compiler_resolver::mw(session, local.concrete_type_id(), 1);
            type = field_type(session, nominal, field);
        }
        if (!session.good() || !no_exclusive_object_loan(session, origin, reference)) {
            return false;
        }
        if (value_kind(session, type) != compiler_resolver::ResolvedTypeKind::owned_values) {
            return fail(session, LoweringError::borrow_values_requires_named_storage_or_private_field, reference);
        }
        const i64 owned = compiler_resolver::mw(session, type, 2);
        const i64 viewed = span_element(session, expected);
        if (!match_type(session, owned, viewed, reference)) {
            return false;
        }
        const LocalRequest span_request = expression_request(session, frame, expected, false);
        const i64 destination = add_span(session, span_request, -1, origin, field, false);
        i64 offset = 0;
        if (origin >= 0) {
            offset = local_offset(session, origin);
        }
        const i64 result_offset = local_offset(session, destination);
        emit_BorrowOwnedSpan(session, offset, field, result_offset);
        return finish_expression(session, expected, destination);
    }
    auto begin_span(compiler_resolver::Session& session, i64 frame_id) -> bool {
        ContinuationRow frame = session.continuation(frame_id);
        const i64 node = frame.syntax_node();
        const compiler_resolver::SyntaxRow syntax = session.syntax(node);
        const i64 reference = source_ref(session, node);
        if (syntax.expression_kind() == compiler_parser::NodeKind::literal) {
            const compiler_resolver::MetaRow token = session.meta(reference);
            if (!argument_use(session, frame_id) || session.source_byte(token.word(1)) != '"' || span_element(session,
                frame.output_mark()) >= 0) {
                return fail(session, LoweringError::invalid_span_initializer, reference);
            }
            const i64 count = decode_string(session, reference, false, false);
            const i64 byte_type = scalar_id(session, compiler_resolver::ResolvedTypeKind::byte_span);
            const LocalRequest span_request = expression_request(session, frame, byte_type, false);
            const i64 destination = add_span(session, span_request, -1, -3, -1, false);
            const i64 begin = session.source_size();
            decode_string(session, reference, true, false);
            const OperandRow bytes = slice(OperandRole::LiteralBytes, begin, count);
            const i64 staged_a1_11 = local_offset(session, destination);
            emit_BorrowLiteralSpan(session, bytes, staged_a1_11);
            const i64 staged_type_12 = scalar_id(session, compiler_resolver::ResolvedTypeKind::byte_span);
            return finish_expression(session, staged_type_12, destination);
        }
        if (syntax.expression_kind() == compiler_parser::NodeKind::name) {
            const i64 parent = named_source(session, node);
            if (!session.good()) {
                return false;
            }
            const LocalRow span = session.local(parent);
            if (!is_span(session, span.concrete_type_id())) {
                return fail(session, LoweringError::invalid_span_initializer, reference);
            }
            if (frame.output_mark() >= 0 && !match_type(session, span.concrete_type_id(), frame.output_mark(),
                reference)) {
                return false;
            }
            const LocalRequest span_request = expression_request(session, frame, span.concrete_type_id(), false);
            const i64 destination = add_span(session, span_request, parent, span_origin_root(span),
                span.span_field_index(), false);
            const i64 staged_a1_13 = local_offset(session, destination);
            emit_ReborrowSpan(session, span.offset(), staged_a1_13);
            return finish_expression(session, span.concrete_type_id(), destination);
        }
        if (syntax.expression_kind() == compiler_parser::NodeKind::call && session.source_equal(reference,
            "borrow_values")) {
            return borrow_values_span(session, frame_id);
        }
        if (syntax.expression_kind() == compiler_parser::NodeKind::call && session.source_equal(reference,
            "borrow_bytes")) {
            if (span_element(session, frame.output_mark()) >= 0) {
                return fail(session, LoweringError::invalid_span_initializer, reference);
            }
            require_arity(session, node, 1);
            const i64 target = expression_argument(session, node, 0);
            const compiler_resolver::SyntaxRow target_row = session.syntax(target);
            i64 origin = -2;
            i64 field = -1;
            i64 type = -1;
            if (target_row.expression_kind() == compiler_parser::NodeKind::name) {
                const i64 name = source_ref(session, target);
                if (lookup_local(session, name) < 0) {
                    field = implicit_field(session, name);
                }
                if (field < 0) {
                    origin = named_source(session, target);
                    type = local_type(session, origin);
                } else {
                    const i64 staged_nominal_14 = body_receiver_nominal(session);
                    type = field_type(session, staged_nominal_14, field);
                }
            } else {
                if (target_row.expression_kind() == compiler_parser::NodeKind::member) {
                    const i64 receiver = target_row.word(1);
                    const compiler_resolver::SyntaxRow receiver_row = session.syntax(receiver);
                    if (receiver_row.expression_kind() != compiler_parser::NodeKind::name) {
                        return fail(session, LoweringError::borrow_bytes_requires_named_storage_or_private_field,
                            reference);
                    }
                    origin = named_source(session, receiver);
                    const LocalRow local = session.local(origin);
                    if (local.borrowed_object()) {
                        const i64 staged_source_15 = source_ref(session, target);
                        return fail(session, LoweringError::borrowed_object_field_access, staged_source_15);
                    }
                    const i64 staged_reference_16 = source_ref(session, target);
                    field = checked_field(session, local.concrete_type_id(), staged_reference_16, false);
                    const i64 staged_nominal_17 = compiler_resolver::mw(session, local.concrete_type_id(), 1);
                    type = field_type(session, staged_nominal_17, field);
                } else {
                    return fail(session, LoweringError::borrow_bytes_requires_named_storage_or_private_field,
                        reference);
                }
            }
            if (!no_exclusive_object_loan(session, origin, reference)) {
                return false;
            }
            const bool receiver_array = origin == -2 && is_byte_array(session, type);
            if (field >= 0) {
                if (value_kind(session, type) != compiler_resolver::ResolvedTypeKind::owned_bytes && !receiver_array) {
                    return fail(session, LoweringError::borrow_bytes_field_storage, reference);
                }
            } else {
                if (!is_byte_array(session, type) && value_kind(session, type)
                    != compiler_resolver::ResolvedTypeKind::owned_bytes) {
                    return fail(session, LoweringError::borrow_bytes_requires_named_storage, reference);
                }
            }
            const i64 bytes_type = scalar_id(session, compiler_resolver::ResolvedTypeKind::byte_span);
            const LocalRequest span_request = expression_request(session, frame, bytes_type, false);
            const i64 destination = add_span(session, span_request, -1, origin, field, false);
            if (receiver_array) {
                const i64 staged_a1_18 = local_offset(session, destination);
                emit_BorrowReceiverArraySpan(session, field, staged_a1_18);
            } else {
                if (field >= 0 || value_kind(session, type) == compiler_resolver::ResolvedTypeKind::owned_bytes) {
                    i64 offset = 0;
                    if (origin >= 0) {
                        offset = local_offset(session, origin);
                    }
                    const i64 staged_a2_19 = local_offset(session, destination);
                    emit_BorrowOwnedSpan(session, offset, field, staged_a2_19);
                } else {
                    const i64 staged_a0_20 = local_offset(session, origin);
                    const i64 staged_a1_21 = local_offset(session, destination);
                    emit_BorrowSpan(session, staged_a0_20, staged_a1_21);
                }
            }
            const i64 staged_type_22 = scalar_id(session, compiler_resolver::ResolvedTypeKind::byte_span);
            return finish_expression(session, staged_type_22, destination);
        }
        if (syntax.expression_kind() == compiler_parser::NodeKind::method_call && session.source_equal(reference,
            "subspan")) {
            if (syntax.word(2) != 3) {
                return fail(session, LoweringError::subspan_argument_count, reference);
            }
            const i64 target = expression_argument(session, node, 0);
            const compiler_resolver::SyntaxRow target_row = session.syntax(target);
            if (target_row.expression_kind() == compiler_parser::NodeKind::name) {
                const i64 parent = named_source(session, target);
                const i64 staged_type_23 = local_type(session, parent);
                if (!is_span(session, staged_type_23)) {
                    return fail(session, LoweringError::subspan_requires_live_readonly_view, reference);
                }
                if (frame.output_mark() >= 0 && !match_type(session, staged_type_23, frame.output_mark(), reference)) {
                    return false;
                }
                frame.set_call(-1, parent, -1, 2);
                frame.set_phase(ContinuationPhase::argument);
                session.set_continuation(frame_id, frame);
                const i64 staged_node_24 = expression_argument(session, node, 1);
                return push_expression(session, staged_node_24, -1, -1);
            }
            frame.set_phase(ContinuationPhase::child);
            session.set_continuation(frame_id, frame);
            return push_expression(session, target, frame.output_mark(), -1);
        }
        const compiler_resolver::ResolvedRow resolved_span = session.resolved(node);
        if (syntax.expression_kind() == compiler_parser::NodeKind::method_call || resolved_span.operation()
            == compiler_resolver::ResolvedOperation::implicit_method_call) {
            return begin_call(session, frame_id);
        }
        return fail(session, LoweringError::invalid_span_initializer, reference);
    }
    auto step_subspan(compiler_resolver::Session& session, i64 frame_id) -> bool {
        ContinuationRow frame = session.continuation(frame_id);
        const i64 reference = source_ref(session, frame.syntax_node());
        if (frame.phase() == ContinuationPhase::child) {
            const LocalRow parent = session.local(frame.child_local_id());
            const i64 origin = span_origin_root(parent);
            bool invalid_origin = origin == -1;
            if (!invalid_origin && origin >= 0) {
                const i64 origin_type = local_type(session, origin);
                invalid_origin = is_byte_array(session, origin_type);
            }
            if (invalid_origin) {
                return fail(session, LoweringError::temporary_subspan_requires_owned_origin, reference);
            }
            frame.set_call(-1, frame.child_local_id(), -1, 2);
            // A non-name parent is a fresh temporary; its Local identity remains
            // in capabilityRootLocal while both scalar operands are checked.
            frame.set_phase(ContinuationPhase::argument);
            session.set_continuation(frame_id, frame);
            const i64 staged_node_26 = expression_argument(session, frame.syntax_node(), 1);
            return push_expression(session, staged_node_26, -1, -1);
        }
        const i64 staged_want_27 = scalar_id(session, compiler_resolver::ResolvedTypeKind::i64_value);
        match_type(session, frame.child_type_id(), staged_want_27, reference);
        if (frame.next_argument() == 0) {
            emit_Push(session);
            frame.set_next_argument(1);
            session.set_continuation(frame_id, frame);
            const i64 staged_node_28 = expression_argument(session, frame.syntax_node(), 2);
            return push_expression(session, staged_node_28, -1, -1);
        }
        const i64 parent_id = frame.capability_root_local();
        const LocalRow parent = session.local(parent_id);
        const i64 parent_node = expression_argument(session, frame.syntax_node(), 0);
        const compiler_resolver::SyntaxRow parent_syntax = session.syntax(parent_node);
        const bool temporary = parent_syntax.expression_kind() != compiler_parser::NodeKind::name;
        if (frame.output_mark() >= 0 && !match_type(session, parent.concrete_type_id(), frame.output_mark(),
            reference)) {
            return false;
        }
        const LocalRequest span_request = expression_request(session, frame, parent.concrete_type_id(), false);
        const i64 destination = add_span(session, span_request, parent_id, span_origin_root(parent),
            parent.span_field_index(), temporary);
        const i64 staged_a1_29 = local_offset(session, destination);
        emit_Subspan(session, parent.offset(), staged_a1_29);
        return finish_expression(session, parent.concrete_type_id(), destination);
    }
    auto span_expression(compiler_resolver::Session& session, i64 expression) -> bool {
        // subspan chains are followed iteratively, never adding helper frames.
        i64 node = expression;
        while (session.good()) {
            const compiler_resolver::SyntaxRow row = session.syntax(node);
            const compiler_resolver::ResolvedRow resolved = session.resolved(node);
            const i64 reference = source_ref(session, node);
            if (row.expression_kind() == compiler_parser::NodeKind::literal) {
                const compiler_resolver::MetaRow source = session.meta(reference);
                return session.source_byte(source.word(1)) == '"';
            }
            if (row.expression_kind() == compiler_parser::NodeKind::name) {
                const i64 local = lookup_local(session, reference);
                if (local < 0) {
                    return false;
                }
                const i64 type = local_type(session, local);
                return value_kind(session, type) == compiler_resolver::ResolvedTypeKind::byte_span;
            }
            if (row.expression_kind() == compiler_parser::NodeKind::call && resolved.operation()
                != compiler_resolver::ResolvedOperation::implicit_method_call) {
                return session.source_equal(reference, "borrow_bytes");
            }
            if (row.expression_kind() == compiler_parser::NodeKind::method_call && session.source_equal(reference,
                "subspan") && row.word(2) > 0) {
                node = expression_argument(session, node, 0);
            } else {
                i64 type = -1;
                if (resolved.operation() == compiler_resolver::ResolvedOperation::implicit_method_call) {
                    if (body_receiver_nominal(session) < 0) {
                        return false;
                    }
                    const i64 staged_nominal_30 = body_receiver_nominal(session);
                    type = nominal_type(session, staged_nominal_30);
                } else {
                    if (row.expression_kind() == compiler_parser::NodeKind::method_call && row.word(2) > 0) {
                        const i64 receiver = expression_argument(session, node, 0);
                        const compiler_resolver::SyntaxRow receiver_row = session.syntax(receiver);
                        if (receiver_row.expression_kind() != compiler_parser::NodeKind::name) {
                            return false;
                        }
                        const i64 name = source_ref(session, receiver);
                        const i64 local = lookup_local(session, name);
                        if (local >= 0) {
                            type = local_type(session, local);
                        } else {
                            const i64 field = implicit_field(session, name);
                            if (field < 0) {
                                return false;
                            }
                            const i64 staged_nominal_31 = body_receiver_nominal(session);
                            type = field_type(session, staged_nominal_31, field);
                        }
                    } else {
                        return false;
                    }
                }
                if (value_kind(session, type) != compiler_resolver::ResolvedTypeKind::class_value) {
                    return false;
                }
                const i64 method = select_method(session, type, reference, false);
                const i64 staged_type_32 = signature_result(session, method);
                return value_kind(session, staged_type_32) == compiler_resolver::ResolvedTypeKind::byte_span;
            }
        }
        return false;
    }
    auto class_array_sources(compiler_resolver::Session& session, i64 node, i64 type) -> OperandRow {
        const compiler_resolver::SyntaxRow syntax = session.syntax(node);
        const i64 count = compiler_resolver::mw(session, type, 3);
        if (syntax.expression_kind() != compiler_parser::NodeKind::array_literal || syntax.word(2) != count) {
            const i64 staged_source_33 = source_ref(session, node);
            fail(session, LoweringError::class_array_initializer_count, staged_source_33);
            const OperandRow empty = slice(OperandRole::Sources, 0, 0);
            return empty;
        }
        const i64 begin = session.operand_count();
        i64 edge = ordered_first(session, syntax.word(1), 1);
        while (edge >= 0 && session.good()) {
            const i64 child = compiler_resolver::sw(session, edge, 0);
            const compiler_resolver::SyntaxRow child_row = session.syntax(child);
            if (child_row.expression_kind() != compiler_parser::NodeKind::name) {
                const i64 staged_source_34 = source_ref(session, child);
                fail(session, LoweringError::class_array_initializer_requires_complete_locals, staged_source_34);
                const OperandRow empty = slice(OperandRole::Sources, 0, 0);
                return empty;
            }
            const i64 original = named_source(session, child);
            const LocalRow original_binding = session.local(original);
            if (original_binding.borrowed_object()) {
                const i64 source = source_ref(session, child);
                fail(session, LoweringError::borrowed_object_ownership_transfer, source);
                const OperandRow empty = slice(OperandRole::Sources, 0, 0);
                return empty;
            }
            const i64 staged_got_35 = local_type(session, original);
            const i64 staged_want_36 = compiler_resolver::mw(session, type, 2);
            const i64 staged_source_37 = source_ref(session, child);
            match_type(session, staged_got_35, staged_want_36, staged_source_37);
            const i64 staged_value_38 = local_offset(session, original);
            put(session, OperandRole::Offset, staged_value_38);
            edge = ordered_next(session, syntax.word(1), edge, 1);
        }
        const OperandRow result = slice(OperandRole::Sources, begin, count);
        return result;
    }
    auto begin_array(compiler_resolver::Session& session, i64 frame_id) -> bool {
        ContinuationRow frame = session.continuation(frame_id);
        const i64 type = frame.output_mark();
        const i64 node = frame.syntax_node();
        const i64 reference = source_ref(session, node);
        const compiler_resolver::SyntaxRow syntax = session.syntax(node);
        const i64 length = compiler_resolver::mw(session, type, 3);
        const i64 element = compiler_resolver::mw(session, type, 2);
        if (is_class_array(session, type)) {
            class_carrier(session, type, frame.operand_mark());
        }
        if (syntax.expression_kind() == compiler_parser::NodeKind::name) {
            const i64 original = named_source(session, node);
            const i64 staged_got_39 = local_type(session, original);
            match_type(session, staged_got_39, type, reference);
            const i64 destination = expression_destination(session, frame, type, -1);
            if (is_class_array(session, type)) {
                const i64 staged_a0_40 = local_offset(session, original);
                const i64 staged_a1_41 = local_offset(session, destination);
                emit_CopyObject(session, staged_a0_40, staged_a1_41);
            } else {
                i64 at = 0;
                while (at < length && session.good()) {
                    const i64 displacement = at * scalar_width(session, element);
                    const i64 staged_a0_42 = local_offset(session, original) - displacement;
                    emit_Load(session, staged_a0_42, element);
                    const i64 staged_a0_43 = local_offset(session, destination) - displacement;
                    emit_Store(session, staged_a0_43, element);
                    at = at + 1;
                }
            }
            return finish_expression(session, type, destination);
        }
        if (is_class_array(session, type)) {
            const OperandRow sources = class_array_sources(session, node, type);
            const i64 destination = expression_destination(session, frame, type, -1);
            const i64 staged_a0_44 = local_offset(session, destination);
            emit_InitializeClassArray(session, staged_a0_44, 0, sources);
            return finish_expression(session, type, destination);
        }
        if (syntax.expression_kind() == compiler_parser::NodeKind::literal) {
            const compiler_resolver::MetaRow token = session.meta(reference);
            if (session.source_byte(token.word(1)) == '"') {
                if (value_kind(session, element) != compiler_resolver::ResolvedTypeKind::u8_value) {
                    return fail(session, LoweringError::byte_string_requires_byte_elements, reference);
                }
                const i64 decoded = decode_string(session, reference, false, false);
                if (decoded != length) {
                    const OperandRow expected = scalar(OperandRole::DiagnosticInteger, length);
                    const OperandRow actual = scalar(OperandRole::DiagnosticInteger, decoded);
                    return fail_pair(session, LoweringError::byte_array_initializer_length, reference, expected,
                        actual);
                }
                decode_string(session, reference, false, true);
                const i64 destination = expression_destination(session, frame, type, -1);
                i64 at = length;
                while (at > 0 && session.good()) {
                    at = at - 1;
                    emit_Pop(session);
                    const i64 staged_a0_45 = local_offset(session, destination) - at;
                    emit_Store(session, staged_a0_45, element);
                }
                return finish_expression(session, type, destination);
            }
        }
        if (syntax.expression_kind() == compiler_parser::NodeKind::member && !is_class_array(session, type)) {
            // A whole scalar-array field of a copied class local, such as the
            // public HostChunk bytes, copied element by element.
            const i64 target = syntax.word(1);
            const compiler_resolver::SyntaxRow target_row = session.syntax(target);
            if (target_row.expression_kind() == compiler_parser::NodeKind::name) {
                const i64 original = named_source(session, target);
                const LocalRow local = session.local(original);
                if (local.borrowed_object()) {
                    return fail(session, LoweringError::borrowed_object_field_access, reference);
                }
                const i64 field = checked_field(session, local.concrete_type_id(), reference, false);
                const i64 nominal = compiler_resolver::mw(session, local.concrete_type_id(), 1);
                const i64 actual = field_type(session, nominal, field);
                if (!match_type(session, actual, type, reference)) {
                    return false;
                }
                const i64 base = local.offset() - field_displacement(session, local.concrete_type_id(), field);
                const i64 destination = expression_destination(session, frame, type, -1);
                i64 at = 0;
                while (at < length && session.good()) {
                    const i64 displacement = at * scalar_width(session, element);
                    emit_Load(session, base - displacement, element);
                    const i64 staged_a0_host = local_offset(session, destination) - displacement;
                    emit_Store(session, staged_a0_host, element);
                    at = at + 1;
                }
                return finish_expression(session, type, destination);
            }
        }
        if (syntax.expression_kind() != compiler_parser::NodeKind::array_literal) {
            return fail(session, LoweringError::array_initializer_requires_literal_or_copy, reference);
        }
        if (syntax.word(2) != length) {
            return fail(session, LoweringError::array_initializer_length, reference);
        }
        const i64 first = ordered_first(session, syntax.word(1), 1);
        frame.set_cursor(first);
        frame.set_phase(ContinuationPhase::argument);
        session.set_continuation(frame_id, frame);
        const i64 staged_node_46 = compiler_resolver::sw(session, first, 0);
        return push_expression(session, staged_node_46, -1, -1);
    }
    auto step_array(compiler_resolver::Session& session, i64 frame_id) -> bool {
        ContinuationRow frame = session.continuation(frame_id);
        const i64 type = frame.output_mark();
        const i64 element = compiler_resolver::mw(session, type, 2);
        const i64 child = compiler_resolver::sw(session, frame.cursor(), 0);
        const i64 staged_source_47 = source_ref(session, child);
        match_type(session, frame.child_type_id(), element, staged_source_47);
        emit_Push(session);
        const i64 last = compiler_resolver::sw(session, frame.syntax_node(), 1);
        const i64 next = ordered_next(session, last, frame.cursor(), 1);
        if (next >= 0) {
            frame.set_cursor(next);
            session.set_continuation(frame_id, frame);
            const i64 staged_node_48 = compiler_resolver::sw(session, next, 0);
            return push_expression(session, staged_node_48, -1, -1);
        }
        const i64 destination = expression_destination(session, frame, type, -1);
        i64 at = compiler_resolver::mw(session, type, 3);
        while (at > 0 && session.good()) {
            at = at - 1;
            emit_Pop(session);
            const i64 staged_a0_49 = local_offset(session, destination) - at * scalar_width(session, element);
            emit_Store(session, staged_a0_49, element);
        }
        return finish_expression(session, type, destination);
    }
    auto call_argument_node(compiler_resolver::Session& session, ContinuationRow frame, i64 index) -> i64 {
        const compiler_resolver::SyntaxRow syntax = session.syntax(frame.syntax_node());
        const compiler_resolver::ResolvedRow resolved = session.resolved(frame.syntax_node());
        i64 actual = index;
        if (syntax.expression_kind() == compiler_parser::NodeKind::method_call && resolved.operation()
            != compiler_resolver::ResolvedOperation::host_operation) {
            actual = actual + 1;
        }
        return expression_argument(session, frame.syntax_node(), actual);
    }
    auto service_operation_contract(compiler_resolver::Session& session, i64 type, i64 reference) -> i64 {
        i64 at = 0;
        while (at < service_contract_count(session) && session.good()) {
            const i64 row = service_contract(session, at);
            if (record_signed(session, row, OperandRole::TypeId) == type) {
                const i64 name = record_signed(session, row, OperandRole::IdentifierSourceRef);
                if (compiler_resolver::intern_atom(session, name) == compiler_resolver::intern_atom(session,
                    reference)) {
                    return row;
                }
            }
            at = at + 1;
        }
        return -1;
    }
    // The exported host::files_NAME function of the designated runtime module
    // implementing public HostFiles operation OPERATION, or -1.
    auto host_runtime_function(compiler_resolver::Session& session, i64 operation) -> i64 {
        i64 unit = 0;
        while (unit < session.module_count() && session.good()) {
            if (host_runtime_unit(session, unit)) {
                i64 symbol = compiler_resolver::first_symbol(session, unit,
                    compiler_resolver::DeclarationKind::function);
                while (symbol >= 0 && session.good()) {
                    const i64 name = compiler_resolver::mw(session, symbol, 3);
                    const i64 parent = compiler_resolver::prefix_parent(session, name);
                    const i64 atom = compiler_resolver::name_atom(session, name);
                    const i64 leaf = compiler_resolver::atom_source(session, atom);
                    const compiler_resolver::MetaRow spelling = session.meta(leaf);
                    if (compiler_resolver::plain_is(session, parent, "host") && compiler_resolver::exported(session,
                        symbol) && compiler_catalog::host_runtime_name(session, operation, spelling.word(1),
                        spelling.word(2)) == 1) {
                        return symbol;
                    }
                    symbol = compiler_resolver::mw(session, symbol, 14);
                }
            }
            unit = unit + 1;
        }
        return -1;
    }
    // A public HostFiles operation `files.NAME(arguments)` calls the runtime's
    // host::NAME(files, arguments): the same syntax node becomes an ordinary
    // service-helper call with the capability as its first argument.
    auto redirect_host_operation(compiler_resolver::Session& session, i64 frame_id) -> bool {
        const ContinuationRow frame = session.continuation(frame_id);
        const i64 node = frame.syntax_node();
        const compiler_resolver::SyntaxRow syntax = session.syntax(node);
        if (syntax.expression_kind() != compiler_parser::NodeKind::method_call || compiler_resolver::sw(session, node,
            2) < 1) {
            return session.good();
        }
        const i64 target = expression_argument(session, node, 0);
        const compiler_resolver::SyntaxRow target_row = session.syntax(target);
        if (target_row.expression_kind() != compiler_parser::NodeKind::name) {
            return session.good();
        }
        const i64 staged_name_host = source_ref(session, target);
        const i64 local = lookup_local(session, staged_name_host);
        if (local < 0) {
            return session.good();
        }
        const i64 staged_type_host = local_type(session, local);
        if (value_kind(session, staged_type_host) != compiler_resolver::ResolvedTypeKind::host_files) {
            return session.good();
        }
        const i64 reference = source_ref(session, node);
        const compiler_resolver::MetaRow spelling = session.meta(reference);
        i64 selected = -1;
        i64 operation = 0;
        while (operation < compiler_catalog::host_operation_count() && session.good()) {
            if (compiler_catalog::host_operation(session, operation, spelling.word(1), spelling.word(2)) == 1) {
                selected = operation;
            }
            operation = operation + 1;
        }
        if (selected < 0) {
            return session.good();
        }
        const i64 callee = host_runtime_function(session, selected);
        if (callee < 0) {
            return fail(session, LoweringError::host_operation_requires_runtime_module, reference);
        }
        compiler_resolver::ResolvedRow binding = session.resolved(node);
        binding.set_operation(compiler_resolver::ResolvedOperation::host_operation);
        binding.set_word(1, callee);
        return session.set_resolved(node, binding);
    }
    auto resolve_call_receiver(compiler_resolver::Session& session, i64 frame_id) -> bool {
        ContinuationRow frame = session.continuation(frame_id);
        const i64 node = frame.syntax_node();
        const i64 reference = source_ref(session, node);
        const compiler_resolver::ResolvedRow resolved = session.resolved(node);
        const bool implicit = resolved.operation() == compiler_resolver::ResolvedOperation::implicit_method_call;
        i64 root = -2;
        i64 type = -1;
        i64 field = -1;
        bool mutable_receiver = !body_receiver_const(session);
        if (implicit) {
            if (lookup_local(session, reference) >= 0) {
                return fail(session, LoweringError::local_shadows_method, reference);
            }
            const i64 staged_nominal_50 = body_receiver_nominal(session);
            type = nominal_type(session, staged_nominal_50);
        } else {
            const i64 target = expression_argument(session, node, 0);
            const compiler_resolver::SyntaxRow target_row = session.syntax(target);
            if (target_row.expression_kind() == compiler_parser::NodeKind::name) {
                const i64 name = source_ref(session, target);
                if (lookup_local(session, name) < 0) {
                    field = implicit_field(session, name);
                }
                if (field < 0) {
                    root = named_source(session, target);
                    const LocalRow local = session.local(root);
                    type = local.concrete_type_id();
                    mutable_receiver = local.mutable_value();
                } else {
                    const i64 staged_nominal_51 = body_receiver_nominal(session);
                    type = field_type(session, staged_nominal_51, field);
                }
            } else {
                if (target_row.expression_kind() == compiler_parser::NodeKind::member) {
                    const i64 target_parent = target_row.word(1);
                    const compiler_resolver::SyntaxRow parent_row = session.syntax(target_parent);
                    if (parent_row.expression_kind() != compiler_parser::NodeKind::name) {
                        return fail(session, LoweringError::method_receiver_requires_class_storage, reference);
                    }
                    root = named_source(session, target_parent);
                    const LocalRow local = session.local(root);
                    if (local.borrowed_object()) {
                        const i64 staged_source_52 = source_ref(session, target);
                        return fail(session, LoweringError::borrowed_object_field_projection, staged_source_52);
                    }
                    mutable_receiver = local.mutable_value();
                    const i64 staged_reference_53 = source_ref(session, target);
                    field = checked_field(session, local.concrete_type_id(), staged_reference_53, false);
                    const i64 staged_nominal_54 = compiler_resolver::mw(session, local.concrete_type_id(), 1);
                    type = field_type(session, staged_nominal_54, field);
                } else {
                    return fail(session, LoweringError::method_receiver_requires_class_storage, reference);
                }
            }
            if (field >= 0) {
                if (value_kind(session, type) != compiler_resolver::ResolvedTypeKind::class_value
                    && !is_owner_storage(session, type)) {
                    const i64 staged_source_55 = source_ref(session, target);
                    return fail(session, LoweringError::nested_method_receiver_requires_owned_field, staged_source_55);
                }
                const i64 staged_reference_56 = source_ref(session, target);
                require_visible_type(session, type, staged_reference_56);
            }
        }
        if (!no_exclusive_object_loan(session, root, reference)) {
            return false;
        }
        frame.set_call(-1, root, field, 0);
        frame.set_cleanup_cursor(type);
        // Receiver mutability is frozen in a typed lane until ordinary argument
        // staging starts; it is recomputed from the root/receiver for rechecks.
        session.set_continuation(frame_id, frame);
        const compiler_resolver::ResolvedTypeKind kind = value_kind(session, type);
        if (frame.output_mark() >= 0 && direct_return_use(session, frame_id) && value_kind(session, frame.output_mark())
            == compiler_resolver::ResolvedTypeKind::class_value && (compiler_resolver::service_kind(kind) || (field >= 0
            && kind != compiler_resolver::ResolvedTypeKind::owned_values && (kind
            != compiler_resolver::ResolvedTypeKind::class_value || owning_type(session, type))))) {
            return fail(session, LoweringError::direct_copied_return_requires_complete_method_receiver, reference);
        }
        if (kind == compiler_resolver::ResolvedTypeKind::class_value) {
            const i64 callee = select_method(session, type, reference, false);
            const i64 staged_type_57 = signature_result(session, callee);
            require_visible_type(session, staged_type_57, reference);
            i64 at = 0;
            while (at < signature_count(session, callee) && session.good()) {
                const i64 staged_type_58 = argument_type(session, callee, at);
                require_visible_type(session, staged_type_58, reference);
                at = at + 1;
            }
            frame.set_call(callee, root, field, signature_count(session, callee));
            return session.set_continuation(frame_id, frame);
        }
        return prepare_intrinsic_method(session, frame_id, mutable_receiver, implicit);
    }
    auto live_receiver(compiler_resolver::Session& session, ContinuationRow frame) -> bool {
        const i64 root = object_loan_local(session, frame.capability_root_local());
        if (root >= 0) {
            const LocalRow local = session.local(root);
            const SnapshotRow state = local.state();
            if (!state.live()) {
                const i64 staged_source_59 = source_ref(session, frame.syntax_node());
                return fail(session, LoweringError::arguments_consumed_method_receiver, staged_source_59);
            }
            if (state.object_exclusive()) {
                const i64 staged_source_60 = source_ref(session, frame.syntax_node());
                return fail(session, LoweringError::owning_object_exclusively_borrowed, staged_source_60);
            }
        }
        return session.good();
    }
    auto receiver_offset(compiler_resolver::Session& session, ContinuationRow frame) -> i64 {
        if (frame.capability_root_local() < 0) {
            return 0;
        }
        return local_offset(session, frame.capability_root_local());
    }
    auto prepare_intrinsic_method(compiler_resolver::Session& session, i64 frame_id, bool mutable_receiver,
        bool implicit) -> bool {
        ContinuationRow frame = session.continuation(frame_id);
        const i64 type = frame.cleanup_cursor();
        const compiler_resolver::ResolvedTypeKind kind = value_kind(session, type);
        const i64 node = frame.syntax_node();
        const i64 reference = source_ref(session, node);
        const i64 actual = compiler_resolver::sw(session, node, 2) - 1;
        const bool span_destination = frame.output_mark() >= 0 && is_span(session, frame.output_mark());
        const bool binding = frame.scope_head() >= 0 || span_destination || (frame.output_mark() >= 0
            && !argument_use(session, frame_id));
        i64 count = 0;
        i64 target = -1;
        if (compiler_resolver::service_kind(kind)) {
            if (implicit || frame.capability_root_local() < 0 || frame.receiver_field_index() != -1) {
                return fail(session, LoweringError::service_operation_requires_active_exclusive_parameter, reference);
            }
            const LocalRow local = session.local(frame.capability_root_local());
            const SnapshotRow state = local.state();
            if (state.exclusive()) {
                return fail(session, LoweringError::service_operation_requires_active_exclusive_parameter, reference);
            }
            target = service_operation_contract(session, type, reference);
            if (target < 0) {
                return fail(session, LoweringError::unknown_service_operation, reference);
            }
            const i64 operation = record_signed(session, target, OperandRole::ServiceOperationId);
            if (operation >= 39 && operation < 46) {
                const i64 caller = body_function(session);
                const i64 unit = compiler_resolver::mw(session, caller, 1);
                if (!runtime_unit(session, unit, "block_write")) {
                    return fail(session, LoweringError::block_runtime_operation_outside_runtime, reference);
                }
            }
            if (operation >= 36 && operation < 39) {
                const i64 caller = body_function(session);
                const i64 unit = compiler_resolver::mw(session, caller, 1);
                if (!runtime_unit(session, unit, "block")) {
                    return fail(session, LoweringError::block_runtime_operation_outside_runtime, reference);
                }
            }
            if (operation >= 32 && operation < 36) {
                const i64 caller = body_function(session);
                const i64 unit = compiler_resolver::mw(session, caller, 1);
                if (!endpoint_runtime_unit(session, unit)) {
                    return fail(session, LoweringError::endpoint_runtime_operation_outside_runtime, reference);
                }
            }
            if (record_signed(session, target, OperandRole::ServiceKindId) == 6) {
                // System and kernel primitives belong to aurora.host, memory
                // primitives (operations 21..28) to aurora.memory.
                const i64 caller = body_function(session);
                const i64 caller_unit = compiler_resolver::mw(session, caller, 1);
                const i64 primitive = record_signed(session, target, OperandRole::ServiceOperationId);
                const bool memory = primitive > 20 && primitive < 29;
                if (memory && !memory_runtime_unit(session, caller_unit)) {
                    return fail(session, LoweringError::memory_runtime_operation_outside_runtime, reference);
                }
                if (!memory && !host_runtime_unit(session, caller_unit)) {
                    return fail(session, LoweringError::host_runtime_operation_outside_runtime, reference);
                }
            }
            const OperandRow parameters = record_slice(session, target, OperandRole::ParameterTypes);
            count = parameters.count();
            if (actual != count) {
                return fail(session, LoweringError::method_argument_count, reference);
            }
            const i64 result = record_signed(session, target, OperandRole::ResultTypeId);
            const bool copied = value_kind(session, result) == compiler_resolver::ResolvedTypeKind::class_value;
            if (copied && !binding) {
                if (session.source_equal(reference, "next")) {
                    return fail(session, LoweringError::next_requires_console_sample_initializer, reference);
                }
                return fail(session, LoweringError::poll_requires_event_sample_initializer, reference);
            }
            if (!copied && binding) {
                if (session.source_equal(reference, "put")) {
                    return fail(session, LoweringError::put_returns_scalar_enum, reference);
                }
                if (session.source_equal(reference, "pixel")) {
                    return fail(session, LoweringError::pixel_returns_scalar_enum, reference);
                }
                return fail(session, LoweringError::acknowledge_returns_scalar_enum, reference);
            }
            if (binding) {
                match_type(session, frame.output_mark(), result, reference);
            }
        } else {
            if (kind == compiler_resolver::ResolvedTypeKind::owned_values) {
                if (implicit) {
                    return fail(session, LoweringError::typed_owner_operation_requires_named_owner, reference);
                }
                owned_element(session, type, reference);
                if (session.source_equal(reference, "ok") || session.source_equal(reference, "size")) {
                    require_arity(session, node, 1);
                    if (binding) {
                        return fail(session, LoweringError::typed_owner_query_returns_scalar, reference);
                    }
                } else {
                    if (!session.source_equal(reference, "at") && !session.source_equal(reference, "set")
                        && !session.source_equal(reference, "try_resize")) {
                        return fail(session, LoweringError::unknown_typed_owner_operation, reference);
                    }
                    count = 2;
                    if (session.source_equal(reference, "at")) {
                        count = 1;
                    }
                    require_arity(session, node, count + 1);
                    if (count == 2 && !mutable_receiver) {
                        return fail(session, LoweringError::write_const_typed_owner, reference);
                    }
                    if (count == 1) {
                        if (!binding) {
                            return fail(session, LoweringError::typed_owner_access_requires_copied_destination,
                                reference);
                        }
                        if (frame.output_mark() >= 0) {
                            const i64 staged_want_61 = compiler_resolver::mw(session, type, 2);
                            match_type(session, frame.output_mark(), staged_want_61, reference);
                        }
                    } else {
                        if (binding) {
                            return fail(session, LoweringError::typed_owner_mutation_returns_bool, reference);
                        }
                    }
                }
            } else {
                if (kind == compiler_resolver::ResolvedTypeKind::owned_bytes) {
                    if (binding || implicit) {
                        return fail(session, LoweringError::byte_operation_requires_named_owner, reference);
                    }
                    if (session.source_equal(reference, "ok") || session.source_equal(reference, "size")) {
                        count = 0;
                    } else {
                        if (session.source_equal(reference, "at") || session.source_equal(reference, "set")
                            || session.source_equal(reference, "try_resize")) {
                            count = 1;
                            if (session.source_equal(reference, "set")) {
                                count = 2;
                            }
                            require_arity(session, node, count + 1);
                            if (!session.source_equal(reference, "at") && !mutable_receiver) {
                                return fail(session, LoweringError::write_const_byte_owner, reference);
                            }
                        } else {
                            return fail(session, LoweringError::unknown_owned_byte_operation, reference);
                        }
                    }
                } else {
                    if (kind == compiler_resolver::ResolvedTypeKind::byte_span) {
                        if (binding || implicit) {
                            return fail(session, LoweringError::span_operation_requires_named_live_span, reference);
                        }
                        if (session.source_equal(reference, "size")) {
                            if (actual != 0) {
                                return fail(session, LoweringError::span_size_argument_count, reference);
                            }
                        } else {
                            if (session.source_equal(reference, "at")) {
                                count = 1;
                                if (actual != 1) {
                                    return fail(session, LoweringError::span_at_argument_count, reference);
                                }
                            } else {
                                if (session.source_equal(reference, "subspan")) {
                                    return fail(session, LoweringError::subspan_requires_span_binding_or_argument,
                                        reference);
                                } else {
                                    return fail(session, LoweringError::unknown_readonly_span_operation, reference);
                                }
                            }
                        }
                    } else {
                        if (kind == compiler_resolver::ResolvedTypeKind::value_span) {
                            // size() reads the count; at() copies one element to a typed destination.
                            if (implicit) {
                                return fail(session, LoweringError::span_operation_requires_named_live_span, reference);
                            }
                            if (session.source_equal(reference, "size")) {
                                if (binding) {
                                    return fail(session, LoweringError::span_operation_requires_named_live_span,
                                        reference);
                                }
                                if (actual != 0) {
                                    return fail(session, LoweringError::span_size_argument_count, reference);
                                }
                            } else {
                                if (session.source_equal(reference, "at")) {
                                    count = 1;
                                    if (actual != 1) {
                                        return fail(session, LoweringError::span_at_argument_count, reference);
                                    }
                                    if (!binding) {
                                        return fail(session,
                                            LoweringError::typed_span_access_requires_copied_destination, reference);
                                    }
                                    if (frame.output_mark() >= 0) {
                                        const i64 element = compiler_resolver::mw(session, type, 2);
                                        match_type(session, frame.output_mark(), element, reference);
                                    }
                                } else {
                                    if (session.source_equal(reference, "subspan")) {
                                        return fail(session, LoweringError::subspan_requires_span_binding_or_argument,
                                            reference);
                                    } else {
                                        return fail(session, LoweringError::unknown_readonly_span_operation, reference);
                                    }
                                }
                            }
                        } else {
                            if (kind == compiler_resolver::ResolvedTypeKind::byte_region) {
                                if (!binding || !session.source_equal(reference, "try_allocate")
                                    || !is_owner_storage(session, frame.output_mark())) {
                                    return fail(session,
                                        LoweringError::region_allocation_requires_owned_bytes_initializer, reference);
                                }
                                count = 1;
                                if (value_kind(session, frame.output_mark())
                                    == compiler_resolver::ResolvedTypeKind::owned_values) {
                                    count = 2;
                                }
                            } else {
                                return fail(session, LoweringError::unknown_class_method, reference);
                            }
                        }
                    }
                }
            }
        }
        require_arity(session, node, count + 1);
        frame.set_call(target, frame.capability_root_local(), frame.receiver_field_index(), count);
        return session.set_continuation(frame_id, frame);
    }
    auto check_call_result(compiler_resolver::Session& session, i64 frame_id) -> bool {
        const ContinuationRow frame = session.continuation(frame_id);
        if (frame.call_target() < 0 || (is_method_expression(session, frame.syntax_node()) && value_kind(session,
            frame.cleanup_cursor()) != compiler_resolver::ResolvedTypeKind::class_value)) {
            return session.good();
        }
        const i64 callee = frame.call_target();
        const i64 reference = source_ref(session, frame.syntax_node());
        i64 result = signature_result(session, callee);
        const bool constructor = is_constructor_expression(session, frame.syntax_node());
        if (constructor) {
            const i64 staged_nominal_62 = compiler_resolver::mw(session, callee, 7);
            result = nominal_type(session, staged_nominal_62);
        }
        const bool span_destination = frame.output_mark() >= 0 && is_span(session, frame.output_mark());
        const bool inferred = argument_use(session, frame_id) && !span_destination;
        const bool binding = frame.scope_head() >= 0 || (frame.output_mark() >= 0 && !inferred);
        const bool method = is_method_expression(session, frame.syntax_node());
        if (inferred && is_resource_owner(session, result)) {
            return fail(session, LoweringError::copied_argument_consumes_owning_result, reference);
        }
        const i64 count = signature_count(session, callee);
        if (!method && !constructor && count > 0 && !binding && inferred && value_kind(session, result)
            == compiler_resolver::ResolvedTypeKind::class_value) {
            const i64 staged_type_63 = argument_type(session, callee, 0);
            const compiler_resolver::ResolvedTypeKind first = value_kind(session, staged_type_63);
            if (compiler_resolver::service_kind(first) || first == compiler_resolver::ResolvedTypeKind::byte_region
                || parameter_borrowed(session, callee, 0)) {
                return fail(session, LoweringError::copied_argument_requires_ordinary_call, reference);
            }
        }
        if (!method && !constructor && count > 0 && direct_return_use(session, frame_id)) {
            const i64 staged_type_64 = argument_type(session, callee, 0);
            const compiler_resolver::ResolvedTypeKind first = value_kind(session, staged_type_64);
            if (compiler_resolver::service_kind(first) || first == compiler_resolver::ResolvedTypeKind::byte_region
                || parameter_borrowed(session, callee, 0)) {
                return fail(session, LoweringError::direct_copied_return_requires_ordinary_call, reference);
            }
        }
        bool resource_result = !method && signature_count(session, callee) > 0;
        if (resource_result) {
            const i64 first_type = argument_type(session, callee, 0);
            resource_result = value_kind(session, first_type) == compiler_resolver::ResolvedTypeKind::byte_region
                && (value_kind(session, result) == compiler_resolver::ResolvedTypeKind::class_value
                || is_owner_storage(session, result) || constructor) && !binding;
        }
        if (resource_result) {
            return fail(session, LoweringError::resource_result_requires_typed_initializer, reference);
        }
        bool service_call = !method && count > 0;
        if (service_call) {
            const i64 first_type = argument_type(session, callee, 0);
            service_call = compiler_resolver::service_kind(value_kind(session, first_type));
        }
        if (service_call) {
            // A HostFiles operation is method syntax; its arguments follow the capability.
            const compiler_resolver::ResolvedRow resolved = session.resolved(frame.syntax_node());
            if (resolved.operation() == compiler_resolver::ResolvedOperation::host_operation) {
                if (compiler_resolver::sw(session, frame.syntax_node(), 2) != count) {
                    return fail(session, LoweringError::method_argument_count, reference);
                }
            } else {
                require_arity(session, frame.syntax_node(), count);
            }
        }
        if (value_kind(session, result) == compiler_resolver::ResolvedTypeKind::class_value && !binding && !inferred) {
            if (method) {
                return fail(session, LoweringError::class_method_result_requires_typed_initializer, reference);
            }
            bool service_result = count > 0;
            if (service_result) {
                const i64 first_type = argument_type(session, callee, 0);
                service_result = compiler_resolver::service_kind(value_kind(session, first_type));
            }
            if (service_result) {
                return fail(session, LoweringError::service_report_requires_typed_initializer, reference);
            }
            return fail(session, LoweringError::class_call_result_requires_typed_initializer, reference);
        }
        if (inferred && method && value_kind(session, result) == compiler_resolver::ResolvedTypeKind::class_value
            && frame.receiver_field_index() >= 0 && owning_type(session, frame.cleanup_cursor())) {
            return fail(session, LoweringError::copied_argument_requires_complete_method_receiver, reference);
        }
        if (method && is_span(session, result)) {
            const i64 caller = body_function(session);
            if (borrowed_root_count(session, caller) > 1 && frame.capability_root_local() >= 0) {
                const LocalRow receiver = session.local(frame.capability_root_local());
                if (receiver.borrowed_object()) {
                    return fail(session, LoweringError::multiple_borrowed_span_production, reference);
                }
            }
            if (!binding) {
                return fail(session, LoweringError::span_method_result_requires_initializer_or_argument, reference);
            }
            const i64 staged_type_65 = body_result_type(session);
            if (is_span(session, staged_type_65)) {
                return fail(session, LoweringError::span_method_forwards_returned_view, reference);
            }
            if (frame.receiver_field_index() >= 0) {
                return fail(session, LoweringError::returned_span_requires_named_receiver, reference);
            }
            if (session.index(115, callee, 0, 0, 0) < 0) {
                return fail(session, LoweringError::span_method_requires_verified_field_summary, reference);
            }
        }
        if (binding) {
            match_type(session, result, frame.output_mark(), reference);
        }
        if (method && !method_const(session, callee)) {
            bool mutable_receiver = !body_receiver_const(session);
            if (frame.capability_root_local() >= 0) {
                const LocalRow receiver = session.local(frame.capability_root_local());
                mutable_receiver = receiver.mutable_value();
            }
            if (!mutable_receiver) {
                return fail(session, LoweringError::mutable_method_requires_mutable_receiver, reference);
            }
        }
        return session.good();
    }
    auto begin_call(compiler_resolver::Session& session, i64 frame_id) -> bool {
        if (!redirect_host_operation(session, frame_id)) {
            return false;
        }
        ContinuationRow frame = session.continuation(frame_id);
        const i64 node = frame.syntax_node();
        const i64 reference = source_ref(session, node);
        const compiler_resolver::ResolvedRow resolved = session.resolved(node);
        const bool method = is_method_expression(session, node);
        const bool constructor = is_constructor_expression(session, node);
        if (method) {
            resolve_call_receiver(session, frame_id);
        } else {
            if (constructor) {
                const i64 type = resolved.word(2);
                if (argument_use(session, frame_id) && (value_kind(session, type)
                    != compiler_resolver::ResolvedTypeKind::class_value || owning_type(session, type))) {
                    return fail(session, LoweringError::class_argument_requires_copied_constructor, reference);
                }
                if (frame.output_mark() >= 0 && !argument_use(session, frame_id)) {
                    match_type(session, type, frame.output_mark(), reference);
                }
                const i64 callee = select_method(session, type, reference, true);
                frame.set_call(callee, -1, -1, signature_count(session, callee));
                session.set_continuation(frame_id, frame);
            } else {
                if (resolved.word(4) >= 0) {
                    const i64 arity = compiler_resolver::sw(session, node, 2);
                    i64 edge = compiler_resolver::mw(session, resolved.word(4), 0);
                    i64 ordinal = 0;
                    bool found = false;
                    while (edge >= 0 && session.good()) {
                        const i64 callee = compiler_resolver::mw(session, edge, 0);
                        if ((u64(resolved.word(5)) & (1u64 << ordinal)) != 0u64 && !admitted_function(session,
                            callee)) {
                            return fail(session, LoweringError::unknown_overload_candidate, reference);
                        }
                        if ((u64(resolved.word(5)) & (1u64 << ordinal)) != 0u64 && signature_count(session, callee)
                            == arity) {
                            found = true;
                        }
                        ordinal = ordinal + 1;
                        edge = compiler_resolver::mw(session, edge, 1);
                    }
                    if (!found) {
                        return require_arity(session, node, -1);
                    }
                    frame.set_call(-1, -1, -1, arity);
                    session.set_continuation(frame_id, frame);
                } else {
                    const i64 callee = resolved.word(1);
                    if (callee < 0 || !admitted_function(session, callee)) {
                        i64 name_id = resolved.word(0);
                        if (callee >= 0) {
                            name_id = callee;
                        }
                        const OperandRow name = scalar(OperandRole::DiagnosticNameId, name_id);
                        const OperandRow absent = scalar(OperandRole::NoDiagnosticValue, 0);
                        return fail_pair(session, LoweringError::unknown_function, reference, name, absent);
                    }
                    frame.set_call(callee, -1, -1, signature_count(session, callee));
                    session.set_continuation(frame_id, frame);
                }
            }
        }
        if (!session.good()) {
            return false;
        }
        check_call_result(session, frame_id);
        ContinuationRow checked_frame = session.continuation(frame_id);
        i64 actual = compiler_resolver::sw(session, node, 2);
        const compiler_resolver::SyntaxRow syntax = session.syntax(node);
        if (syntax.expression_kind() == compiler_parser::NodeKind::method_call && resolved.operation()
            != compiler_resolver::ResolvedOperation::host_operation) {
            actual = actual - 1;
        }
        if (actual != checked_frame.argument_count()) {
            if (method) {
                return fail(session, LoweringError::method_argument_count, reference);
            }
            return require_arity(session, node, checked_frame.argument_count());
        }
        checked_frame.set_phase(ContinuationPhase::argument);
        session.set_continuation(frame_id, checked_frame);
        return advance_call(session, frame_id);
    }
    auto intrinsic_argument_type(compiler_resolver::Session& session, ContinuationRow frame, i64 index) -> i64 {
        const i64 type = frame.cleanup_cursor();
        const compiler_resolver::ResolvedTypeKind kind = value_kind(session, type);
        if (compiler_resolver::service_kind(kind)) {
            const OperandRow parameters = record_slice(session, frame.call_target(), OperandRole::ParameterTypes);
            return list_value(session, parameters, index);
        }
        if (index == 0) {
            return scalar_id(session, compiler_resolver::ResolvedTypeKind::i64_value);
        }
        if (kind == compiler_resolver::ResolvedTypeKind::owned_values) {
            return compiler_resolver::mw(session, type, 2);
        }
        if (kind == compiler_resolver::ResolvedTypeKind::byte_region) {
            return compiler_resolver::mw(session, frame.output_mark(), 2);
        }
        return scalar_id(session, compiler_resolver::ResolvedTypeKind::u8_value);
    }
    auto intrinsic_method(compiler_resolver::Session& session, ContinuationRow frame) -> bool {
        return is_method_expression(session, frame.syntax_node()) && value_kind(session, frame.cleanup_cursor())
            != compiler_resolver::ResolvedTypeKind::class_value;
    }
    auto stage_direct_argument(compiler_resolver::Session& session, i64 frame_id, i64 type, i64 node) -> bool {
        ContinuationRow frame = session.continuation(frame_id);
        const i64 index = frame.next_argument();
        const i64 callee = frame.call_target();
        const i64 reference = source_ref(session, node);
        const compiler_resolver::ResolvedTypeKind kind = value_kind(session, type);
        if (kind == compiler_resolver::ResolvedTypeKind::byte_region) {
            const i64 local = named_source(session, node);
            const i64 staged_got_66 = local_type(session, local);
            const i64 staged_source_67 = source_ref(session, frame.syntax_node());
            match_type(session, staged_got_66, type, staged_source_67);
            const ArgumentLane lane = ArgumentLane(index, ArgumentKind::owner, type, local, -1, -1);
            frame.set_argument(index, lane);
            frame.set_call(callee, local, frame.receiver_field_index(), frame.argument_count());
        } else {
            if (compiler_resolver::service_kind(kind)) {
                const compiler_resolver::SyntaxRow syntax = session.syntax(node);
                if (syntax.expression_kind() != compiler_parser::NodeKind::name) {
                    return fail(session, LoweringError::service_forwarding_requires_named_exclusive_parameter,
                        reference);
                }
                const i64 local = named_source(session, node);
                const i64 staged_got_68 = local_type(session, local);
                match_type(session, staged_got_68, type, reference);
                const LocalRow root = session.local(local);
                const SnapshotRow state = root.state();
                if (state.exclusive()) {
                    return fail(session, LoweringError::service_authority_suspended, reference);
                }
                set_exclusive(session, local, true);
                const i64 loan = body_fresh_loan(session);
                const i64 service = service_type_id(session, type);
                emit_AcquireServiceLoan(session, loan, root.offset(), service);
                ArgumentLane lane = ArgumentLane(index, ArgumentKind::service, type, local, loan, service);
                lane.set_cleanup(CleanupKind::service_loan);
                frame.set_argument(index, lane);
            } else {
                if (parameter_borrowed(session, callee, index)) {
                    const compiler_resolver::SyntaxRow syntax = session.syntax(node);
                    const bool typed_owner = kind == compiler_resolver::ResolvedTypeKind::owned_values;
                    i64 local = -2;
                    i64 field = -1;
                    i64 actual_type = -1;
                    bool mutable_root = !body_receiver_const(session);
                    if (syntax.expression_kind() == compiler_parser::NodeKind::name) {
                        if (typed_owner && lookup_local(session, reference) < 0) {
                            field = implicit_field(session, reference);
                        }
                        if (field >= 0) {
                            const i64 nominal = body_receiver_nominal(session);
                            actual_type = field_type(session, nominal, field);
                        } else {
                            local = named_source(session, node);
                            const LocalRow owner = session.local(local);
                            actual_type = owner.concrete_type_id();
                            mutable_root = owner.mutable_value();
                        }
                    } else {
                        return fail(session, LoweringError::borrowed_argument_requires_complete_owner, reference);
                    }
                    if (!session.good() || !no_exclusive_object_loan(session, local, reference) || !match_type(session,
                        actual_type, type, reference)) {
                        return false;
                    }
                    const i64 selector = object_root_offset(session, local);
                    // Distinctness is explicit even when every loan is readonly.
                    // Compare root identity, never type, extent or payload contents.
                    i64 prior = 0;
                    while (prior < index && session.good()) {
                        const ArgumentLane earlier = frame.argument(prior);
                        if (earlier.kind() != ArgumentKind::borrowed_receiver) {
                            session.fail_storage(compiler_resolver::StorageStatus::invalid);
                            return false;
                        }
                        if (object_root_offset(session, earlier.local_id()) == selector) {
                            return fail(session, LoweringError::borrowed_arguments_require_distinct_roots, reference);
                        }
                        prior = prior + 1;
                    }
                    const i64 authority = object_loan_local(session, local);
                    if (authority < 0) {
                        return fail(session, LoweringError::borrowed_argument_requires_complete_owner, reference);
                    }
                    const LocalRow root = session.local(authority);
                    const SnapshotRow state = root.state();
                    const bool mutable_loan = !parameter_const(session, callee, index);
                    if (mutable_loan) {
                        if (!mutable_root) {
                            return fail(session, LoweringError::mutable_borrowed_argument_requires_mutable_owner,
                                reference);
                        }
                        // A field loan locks its containing object, including all
                        // sibling fields and methods, while later arguments run.
                        if (!no_span_borrow(session, local, -1, reference)) {
                            return false;
                        }
                        change_object_loan(session, local, 0, true);
                    } else {
                        change_object_loan(session, local, 1, state.object_exclusive());
                    }
                    const i64 loan = body_fresh_loan(session);
                    i64 permission = 0;
                    if (mutable_loan) {
                        permission = 1;
                    }
                    emit_AcquireObjectLoan(session, loan, selector, permission, field);
                    ArgumentLane lane = ArgumentLane(index, ArgumentKind::borrowed_receiver, type, local, loan, field);
                    lane.set_cleanup(CleanupKind::object_loan);
                    frame.set_argument(index, lane);
                    if (index == 0) {
                        frame.set_call(callee, local, frame.receiver_field_index(), frame.argument_count());
                    }
                } else {
                    if (is_resource_owner(session, type)) {
                        const i64 original = moved_source(session, node, type);
                        const LocalRow owner = session.local(original);
                        if (owner.owner_id() != frame.capability_root_local()) {
                            return fail(session, LoweringError::owner_region_mismatch, reference);
                        }
                        LocalRequest request = LocalRequest(-1, type, reference, true, false, true);
                        request.set_origin(owner.owner_id(), SpanOriginKind::none, -1, -1, false);
                        const i64 temporary = add_local(session, request);
                        emit_move(session, original, temporary);
                        ArgumentLane lane = ArgumentLane(index, ArgumentKind::owner, type, temporary, -1, -1);
                        lane.set_cleanup(CleanupKind::owner);
                        frame.set_argument(index, lane);
                    } else {
                        session.fail_storage(compiler_resolver::StorageStatus::invalid);
                        return false;
                    }
                }
            }
        }
        frame.set_next_argument(index + 1);
        return session.set_continuation(frame_id, frame);
    }
    auto advance_call(compiler_resolver::Session& session, i64 frame_id) -> bool {
        const ContinuationRow initial = session.continuation(frame_id);
        i64 next_argument = initial.next_argument();
        while (next_argument < initial.argument_count() && session.good()) {
            ContinuationRow frame = session.continuation(frame_id);
            const i64 index = frame.next_argument();
            const i64 node = call_argument_node(session, frame, index);
            const bool intrinsic = intrinsic_method(session, frame);
            i64 type = -1;
            if (intrinsic) {
                type = intrinsic_argument_type(session, frame, index);
            } else {
                if (frame.call_target() >= 0) {
                    type = argument_type(session, frame.call_target(), index);
                }
            }
            if (!intrinsic && type >= 0) {
                const compiler_resolver::ResolvedTypeKind kind = value_kind(session, type);
                if (compiler_resolver::service_kind(kind) || kind == compiler_resolver::ResolvedTypeKind::byte_region
                    || is_resource_owner(session, type) || parameter_borrowed(session, frame.call_target(), index)) {
                    stage_direct_argument(session, frame_id, type, node);
                } else {
                    bool resource_constructor = kind == compiler_resolver::ResolvedTypeKind::class_value
                        && is_constructor_expression(session, frame.syntax_node()) && frame.argument_count() > 0;
                    if (resource_constructor) {
                        const i64 first_type = argument_type(session, frame.call_target(), 0);
                        resource_constructor = value_kind(session, first_type)
                            == compiler_resolver::ResolvedTypeKind::byte_region;
                    }
                    if (resource_constructor) {
                        const i64 original = named_source(session, node);
                        const i64 staged_got_70 = local_type(session, original);
                        const i64 staged_source_71 = source_ref(session, node);
                        match_type(session, staged_got_70, type, staged_source_71);
                        const i64 staged_source_72 = source_ref(session, node);
                        const i64 snapshot = copied_snapshot(session, original, staged_source_72);
                        ArgumentLane lane = ArgumentLane(index, ArgumentKind::object, type, snapshot, -1, -1);
                        lane.set_cleanup(CleanupKind::object);
                        frame.set_argument(index, lane);
                        frame.set_next_argument(index + 1);
                        session.set_continuation(frame_id, frame);
                    } else {
                        i64 expected = -1;
                        if (kind == compiler_resolver::ResolvedTypeKind::class_value || (is_span(session, type)
                            && !is_constructor_expression(session, frame.syntax_node()))) {
                            expected = type;
                        }
                        return push_expression(session, node, expected, -1);
                    }
                }
            } else {
                if (intrinsic && index == 1 && value_kind(session, type)
                    == compiler_resolver::ResolvedTypeKind::class_value) {
                    const i64 original = named_source(session, node);
                    const i64 staged_got_73 = local_type(session, original);
                    const i64 staged_source_74 = source_ref(session, node);
                    match_type(session, staged_got_73, type, staged_source_74);
                    const i64 staged_source_75 = source_ref(session, node);
                    const i64 snapshot = copied_snapshot(session, original, staged_source_75);
                    ArgumentLane lane = ArgumentLane(index, ArgumentKind::object, type, snapshot, -1, -1);
                    lane.set_cleanup(CleanupKind::object);
                    frame.set_argument(index, lane);
                    frame.set_next_argument(index + 1);
                    session.set_continuation(frame_id, frame);
                    emit_Pop(session);
                } else {
                    i64 expected = -1;
                    if (type < 0 && span_expression(session, node)) {
                        expected = scalar_id(session, compiler_resolver::ResolvedTypeKind::byte_span);
                    }
                    return push_expression(session, node, expected, -1);
                }
            }
            const ContinuationRow advanced = session.continuation(frame_id);
            next_argument = advanced.next_argument();
        }
        if (!session.good()) {
            return false;
        }
        return finish_call(session, frame_id);
    }
    auto collect_call_argument(compiler_resolver::Session& session, i64 frame_id) -> bool {
        ContinuationRow frame = session.continuation(frame_id);
        const i64 index = frame.next_argument();
        const i64 node = call_argument_node(session, frame, index);
        const i64 type = frame.child_type_id();
        const i64 local = frame.child_local_id();
        const bool intrinsic = intrinsic_method(session, frame);
        i64 expected = -1;
        if (intrinsic) {
            expected = intrinsic_argument_type(session, frame, index);
        } else {
            if (frame.call_target() >= 0) {
                expected = argument_type(session, frame.call_target(), index);
            }
        }
        if (expected >= 0) {
            i64 reference = source_ref(session, node);
            bool copied_constructor = is_constructor_expression(session, frame.syntax_node());
            if (copied_constructor) {
                const i64 nominal = compiler_resolver::mw(session, frame.call_target(), 7);
                const i64 constructed_type = nominal_type(session, nominal);
                copied_constructor = !owning_type(session, constructed_type);
            }
            if (intrinsic || (copied_constructor && value_kind(session, expected)
                != compiler_resolver::ResolvedTypeKind::class_value)) {
                reference = source_ref(session, frame.syntax_node());
            }
            match_type(session, type, expected, reference);
        }
        ArgumentKind kind = ArgumentKind::scalar;
        CleanupKind cleanup = CleanupKind::none;
        if (is_span(session, type)) {
            kind = ArgumentKind::span;
            cleanup = CleanupKind::span;
        } else {
            if (value_kind(session, type) == compiler_resolver::ResolvedTypeKind::class_value) {
                kind = ArgumentKind::object;
                cleanup = CleanupKind::object;
            }
        }
        ArgumentLane lane = ArgumentLane(index, kind, type, local, -1, -1);
        lane.set_cleanup(cleanup);
        frame.set_argument(index, lane);
        frame.set_next_argument(index + 1);
        session.set_continuation(frame_id, frame);
        if (kind == ArgumentKind::scalar) {
            if (!intrinsic) {
                emit_Push(session);
            } else {
                const compiler_resolver::ResolvedTypeKind receiver = value_kind(session, frame.cleanup_cursor());
                if (compiler_resolver::service_kind(receiver)) {
                    if (frame.argument_count() > 1) {
                        emit_Push(session);
                    }
                } else {
                    if (frame.argument_count() > 1 && index == 0) {
                        if (receiver == compiler_resolver::ResolvedTypeKind::byte_region) {
                            owned_element(session, frame.output_mark(), frame.operand_mark());
                        }
                        emit_Push(session);
                    }
                }
                if (receiver == compiler_resolver::ResolvedTypeKind::owned_values) {
                    live_receiver(session, frame);
                }
            }
        }
        return advance_call(session, frame_id);
    }
    auto select_overload(compiler_resolver::Session& session, i64 frame_id) -> bool {
        ContinuationRow frame = session.continuation(frame_id);
        const compiler_resolver::ResolvedRow resolved = session.resolved(frame.syntax_node());
        i64 edge = compiler_resolver::mw(session, resolved.word(4), 0);
        i64 ordinal = 0;
        i64 selected = -1;
        bool inaccessible = false;
        while (edge >= 0 && session.good()) {
            const i64 candidate = compiler_resolver::mw(session, edge, 0);
            if ((u64(resolved.word(5)) & (1u64 << ordinal)) != 0u64 && signature_count(session, candidate)
                == frame.argument_count()) {
                bool exact = true;
                i64 index = 0;
                while (index < frame.argument_count()) {
                    const ArgumentLane lane = frame.argument(index);
                    if (lane.concrete_type_id() != argument_type(session, candidate, index)) {
                        exact = false;
                    }
                    index = index + 1;
                }
                if (exact) {
                    if (selected >= 0) {
                        const i64 staged_source_76 = source_ref(session, frame.syntax_node());
                        return fail(session, LoweringError::ambiguous_exact_overload, staged_source_76);
                    }
                    selected = candidate;
                    inaccessible = (u64(resolved.word(6)) & (1u64 << ordinal)) != 0u64;
                }
            }
            ordinal = ordinal + 1;
            edge = compiler_resolver::mw(session, edge, 1);
        }
        if (selected < 0) {
            const i64 reference = source_ref(session, frame.syntax_node());
            const OperandRow name = scalar(OperandRole::DiagnosticNameId, resolved.word(0));
            const OperandRow absent = scalar(OperandRole::NoDiagnosticValue, 0);
            return fail_pair(session, LoweringError::no_exact_overload, reference, name, absent);
        }
        if (inaccessible) {
            const i64 staged_source_77 = source_ref(session, frame.syntax_node());
            return fail(session, LoweringError::function_signature_import, staged_source_77);
        }
        frame.set_call(selected, frame.capability_root_local(), frame.receiver_field_index(), frame.argument_count());
        session.set_continuation(frame_id, frame);
        return check_call_result(session, frame_id);
    }
    auto argument_offsets(compiler_resolver::Session& session, ContinuationRow frame, OperandRole role, i64 first,
        bool present) -> OperandRow {
        const i64 begin = session.operand_count();
        i64 index = first;
        if (present) {
            while (index < frame.argument_count() && session.good()) {
                const ArgumentLane lane = frame.argument(index);
                i64 offset = 0;
                if ((role == OperandRole::SpanArguments && lane.kind() == ArgumentKind::span) || (role
                    == OperandRole::ObjectArguments && lane.kind() == ArgumentKind::object) || (role
                    == OperandRole::OwnerArguments && (lane.kind() == ArgumentKind::object || (lane.kind()
                    == ArgumentKind::owner && index > 0)))) {
                    offset = local_offset(session, lane.local_id());
                }
                put(session, OperandRole::Offset, offset);
                index = index + 1;
            }
        }
        const OperandRow result = slice(role, begin, session.operand_count() - begin);
        return result;
    }
    auto cleanup_call(compiler_resolver::Session& session, ContinuationRow frame, bool resources) -> bool {
        i64 index = frame.argument_count();
        while (index > 0 && session.good()) {
            index = index - 1;
            const ArgumentLane lane = frame.argument(index);
            if (lane.cleanup_kind() == CleanupKind::service_loan) {
                emit_ReleaseServiceLoan(session, lane.loan_id(), lane.service_kind_id());
                set_exclusive(session, lane.local_id(), false);
            }
            if (lane.cleanup_kind() == CleanupKind::object_loan) {
                emit_ReleaseObjectLoan(session, lane.loan_id());
                if (parameter_const(session, frame.call_target(), index)) {
                    const i64 authority = object_loan_local(session, lane.local_id());
                    const LocalRow root = session.local(authority);
                    const SnapshotRow state = root.state();
                    change_object_loan(session, lane.local_id(), -1, state.object_exclusive());
                } else {
                    change_object_loan(session, lane.local_id(), 0, false);
                }
            }
            if (resources && lane.cleanup_kind() == CleanupKind::owner) {
                end_owner(session, lane.local_id());
                set_live(session, lane.local_id(), false, false);
            }
        }
        index = 0;
        while (index < frame.argument_count() && session.good()) {
            const ArgumentLane lane = frame.argument(index);
            if (lane.cleanup_kind() == CleanupKind::object) {
                const i64 staged_a0_78 = local_offset(session, lane.local_id());
                emit_EndObject(session, staged_a0_78);
            }
            index = index + 1;
        }
        index = frame.argument_count();
        while (index > 0 && session.good()) {
            index = index - 1;
            const ArgumentLane lane = frame.argument(index);
            if (lane.cleanup_kind() == CleanupKind::span) {
                release_span(session, lane.local_id(), true);
            }
        }
        return session.good();
    }
    auto finish_call(compiler_resolver::Session& session, i64 frame_id) -> bool {
        const ContinuationRow initial = session.continuation(frame_id);
        if (intrinsic_method(session, initial)) {
            return finish_intrinsic_method(session, frame_id);
        }
        const compiler_resolver::ResolvedRow resolved = session.resolved(initial.syntax_node());
        if (resolved.word(4) >= 0) {
            select_overload(session, frame_id);
        }
        const ContinuationRow frame = session.continuation(frame_id);
        const i64 callee = frame.call_target();
        const i64 reference = source_ref(session, frame.syntax_node());
        const bool constructor = is_constructor_expression(session, frame.syntax_node());
        const bool method = is_method_expression(session, frame.syntax_node());
        i64 result = signature_result(session, callee);
        if (constructor) {
            const i64 staged_nominal_79 = compiler_resolver::mw(session, callee, 7);
            result = nominal_type(session, staged_nominal_79);
        }
        bool resource = false;
        bool service = false;
        bool borrowed = false;
        if (frame.argument_count() > 0) {
            const ArgumentLane first = frame.argument(0);
            resource = value_kind(session, first.concrete_type_id())
                == compiler_resolver::ResolvedTypeKind::byte_region;
            service = first.kind() == ArgumentKind::service;
            borrowed = first.kind() == ArgumentKind::borrowed_receiver;
        }
        bool aggregate = value_kind(session, result) == compiler_resolver::ResolvedTypeKind::class_value && !borrowed;
        bool spans = false;
        i64 index = 0;
        while (index < frame.argument_count()) {
            const ArgumentLane lane = frame.argument(index);
            if (lane.kind() == ArgumentKind::object || lane.kind() == ArgumentKind::span) {
                aggregate = true;
            }
            if (lane.kind() == ArgumentKind::span) {
                spans = true;
            }
            index = index + 1;
        }
        if (method) {
            live_receiver(session, frame);
            if (!method_const(session, callee)) {
                no_span_borrow(session, frame.capability_root_local(), frame.receiver_field_index(), reference);
            }
        }
        i64 destination = -1;
        i64 destination_offset = 0;
        if (value_kind(session, result) == compiler_resolver::ResolvedTypeKind::class_value || is_span(session, result)
            || is_owner_storage(session, result)) {
            if (resource && frame.scope_head() < 0 && !constructor && !argument_use(session, frame_id)
                && frame.output_mark() < 0) {
                return fail(session, LoweringError::resource_result_requires_typed_initializer, reference);
            }
            if (is_span(session, result)) {
                const i64 field = session.index(115, callee, 0, 0, 0);
                const LocalRequest span_request = expression_request(session, frame, result, false);
                destination = add_span(session, span_request, -1, frame.capability_root_local(), field, false);
            } else {
                i64 owner = -1;
                if (resource && is_resource_owner(session, result)) {
                    owner = frame.capability_root_local();
                }
                destination = expression_destination(session, frame, result, owner);
            }
            destination_offset = local_offset(session, destination);
        }
        if (resource) {
            const OperandRow owners = argument_offsets(session, frame, OperandRole::OwnerArguments, 0, true);
            i64 result_offset = destination_offset;
            i64 receiver = 0;
            if (constructor) {
                receiver = destination_offset;
                result_offset = 0;
            }
            const i64 staged_a1_80 = local_offset(session, frame.capability_root_local());
            emit_ResourceCall(session, callee, staged_a1_80, owners, result_offset, receiver);
        } else {
            if (service) {
                const OperandRow span_arguments = argument_offsets(session, frame, OperandRole::SpanArguments, 0, true);
                const OperandRow object_arguments = argument_offsets(session, frame, OperandRole::ObjectArguments, 0,
                    true);
                const i64 extra_begin = session.operand_count();
                i64 service_index = 1;
                while (service_index < frame.argument_count()) {
                    const ArgumentLane lane = frame.argument(service_index);
                    if (lane.kind() == ArgumentKind::service) {
                        put(session, OperandRole::ServiceLoanId, lane.loan_id());
                        put(session, OperandRole::ServiceKindId, lane.service_kind_id());
                    }
                    service_index = service_index + 1;
                }
                const OperandRow additional = slice(OperandRole::AdditionalServices, extra_begin,
                    session.operand_count() - extra_begin);
                const ArgumentLane first = frame.argument(0);
                const i64 begin = session.operand_count();
                put(session, OperandRole::CalleeSymbolId, callee);
                put(session, OperandRole::LoanId, first.loan_id());
                put(session, OperandRole::ResultOffset, destination_offset);
                session.append_operand(span_arguments);
                put(session, OperandRole::ServiceKindId, first.service_kind_id());
                session.append_operand(additional);
                session.append_operand(object_arguments);
                i64 region_offset = 0;
                const i64 region_parameter = service_region_parameter(session, callee);
                if (region_parameter >= 0) {
                    const ArgumentLane region = frame.argument(region_parameter);
                    region_offset = local_offset(session, region.local_id());
                }
                put(session, OperandRole::RegionOffset, region_offset);
                emit(session, InstructionForm::ServiceCall, begin);
            } else {
                if (method || constructor) {
                    // Method packed object slices include zero scalar positions. A
                    // constructor has no result offset and receives the pristine object.
                    bool packed = false;
                    index = 0;
                    while (index < frame.argument_count()) {
                        const ArgumentLane lane = frame.argument(index);
                        if (lane.kind() == ArgumentKind::object || lane.kind() == ArgumentKind::span) {
                            packed = true;
                        }
                        index = index + 1;
                    }
                    const OperandRow objects = argument_offsets(session, frame, OperandRole::ObjectArguments, 0,
                        packed);
                    const OperandRow span_arguments = argument_offsets(session, frame, OperandRole::SpanArguments, 0,
                        spans);
                    const i64 begin = session.operand_count();
                    put(session, OperandRole::CalleeSymbolId, callee);
                    i64 receiver = receiver_offset(session, frame);
                    i64 result_offset = destination_offset;
                    i64 field = frame.receiver_field_index();
                    if (constructor) {
                        receiver = destination_offset;
                        result_offset = 0;
                        field = -1;
                    }
                    put(session, OperandRole::ReceiverOffset, receiver);
                    session.append_operand(objects);
                    put(session, OperandRole::ResultOffset, result_offset);
                    put(session, OperandRole::ReceiverFieldIndex, field);
                    session.append_operand(span_arguments);
                    emit(session, InstructionForm::MethodCall, begin);
                } else {
                    if (borrowed) {
                        const i64 leading = borrowed_root_count(session, callee);
                        const OperandRow objects = argument_offsets(session, frame, OperandRole::ObjectArguments,
                            leading, aggregate);
                        const OperandRow span_arguments = argument_offsets(session, frame, OperandRole::SpanArguments,
                            leading, spans);
                        const i64 roots_begin = session.operand_count();
                        i64 ordinal = 0;
                        while (ordinal < leading && session.good()) {
                            const ArgumentLane lane = frame.argument(ordinal);
                            const i64 selector = object_root_offset(session, lane.local_id());
                            put(session, OperandRole::Root, selector);
                            put(session, OperandRole::LoanId, lane.loan_id());
                            put(session, OperandRole::FieldIndex, lane.field_index());
                            ordinal = ordinal + 1;
                        }
                        const OperandRow roots = slice(OperandRole::BorrowedRoots, roots_begin, session.operand_count()
                            - roots_begin);
                        const i64 begin = session.operand_count();
                        put(session, OperandRole::CalleeSymbolId, callee);
                        session.append_operand(roots);
                        session.append_operand(objects);
                        put(session, OperandRole::ResultOffset, destination_offset);
                        session.append_operand(span_arguments);
                        emit(session, InstructionForm::BorrowedCall, begin);
                    } else {
                        if (aggregate) {
                            const OperandRow objects = argument_offsets(session, frame, OperandRole::ObjectArguments, 0,
                                true);
                            const OperandRow span_arguments = argument_offsets(session, frame,
                                OperandRole::SpanArguments, 0, true);
                            emit_AggregateCall(session, callee, objects, destination_offset, span_arguments);
                        } else {
                            emit_Call(session, callee);
                        }
                    }
                }
            }
        }
        cleanup_call(session, frame, resource);
        return finish_expression(session, result, destination);
    }
    auto finish_intrinsic_method(compiler_resolver::Session& session, i64 frame_id) -> bool {
        const ContinuationRow frame = session.continuation(frame_id);
        const i64 type = frame.cleanup_cursor();
        const compiler_resolver::ResolvedTypeKind kind = value_kind(session, type);
        const i64 source = source_ref(session, frame.syntax_node());
        if (!live_receiver(session, frame)) {
            return false;
        }
        const i64 offset = receiver_offset(session, frame);
        const i64 field = frame.receiver_field_index();
        i64 result = scalar_id(session, compiler_resolver::ResolvedTypeKind::bool_value);
        i64 destination = -1;
        if (compiler_resolver::service_kind(kind)) {
            const i64 contract = frame.call_target();
            result = record_signed(session, contract, OperandRole::ResultTypeId);
            i64 result_offset = 0;
            if (value_kind(session, result) == compiler_resolver::ResolvedTypeKind::class_value) {
                destination = expression_destination(session, frame, result, -1);
                result_offset = local_offset(session, destination);
            }
            const i64 staged_a1_82 = record_signed(session, contract, OperandRole::ServiceOperationId);
            const i64 staged_a3_83 = record_signed(session, contract, OperandRole::ServiceKindId);
            emit_ServiceOperation(session, offset, staged_a1_82, result_offset, staged_a3_83);
        } else {
            if (kind == compiler_resolver::ResolvedTypeKind::byte_region) {
                result = frame.output_mark();
                if (value_kind(session, result) == compiler_resolver::ResolvedTypeKind::owned_values) {
                    owned_element(session, result, frame.operand_mark());
                }
                destination = expression_destination(session, frame, result, frame.capability_root_local());
                if (frame.argument_count() == 2) {
                    const ArgumentLane fill = frame.argument(1);
                    const i64 staged_a1_84 = local_offset(session, destination);
                    const i64 staged_a2_85 = local_offset(session, fill.local_id());
                    emit_AllocateValues(session, offset, staged_a1_84, staged_a2_85);
                    const i64 staged_a0_86 = local_offset(session, fill.local_id());
                    emit_EndObject(session, staged_a0_86);
                } else {
                    const i64 staged_a1_87 = local_offset(session, destination);
                    emit_AllocateBytes(session, offset, staged_a1_87);
                }
            } else {
                if (is_span(session, type)) {
                    if (session.source_equal(source, "size")) {
                        emit_SpanLength(session, offset);
                        result = scalar_id(session, compiler_resolver::ResolvedTypeKind::i64_value);
                    } else {
                        if (kind == compiler_resolver::ResolvedTypeKind::value_span) {
                            result = compiler_resolver::mw(session, type, 2);
                            destination = expression_destination(session, frame, result, -1);
                            const i64 element_offset = local_offset(session, destination);
                            emit_SpanValuesLoad(session, offset, element_offset);
                        } else {
                            emit_SpanLoad(session, offset);
                            result = scalar_id(session, compiler_resolver::ResolvedTypeKind::u8_value);
                        }
                    }
                } else {
                    if (session.source_equal(source, "ok")) {
                        emit_BytesOk(session, offset, field);
                    } else {
                        if (session.source_equal(source, "size")) {
                            emit_BytesLength(session, offset, field);
                            result = scalar_id(session, compiler_resolver::ResolvedTypeKind::i64_value);
                        } else {
                            live_receiver(session, frame);
                            if (kind == compiler_resolver::ResolvedTypeKind::owned_values) {
                                if (session.source_equal(source, "at")) {
                                    result = compiler_resolver::mw(session, type, 2);
                                    destination = expression_destination(session, frame, result, -1);
                                    const i64 staged_a2_88 = local_offset(session, destination);
                                    emit_ValuesLoad(session, offset, field, staged_a2_88);
                                } else {
                                    no_span_borrow(session, frame.capability_root_local(), field, source);
                                    const ArgumentLane fill = frame.argument(1);
                                    if (session.source_equal(source, "set")) {
                                        const i64 staged_a2_89 = local_offset(session, fill.local_id());
                                        emit_ValuesStore(session, offset, field, staged_a2_89);
                                    } else {
                                        const i64 staged_a2_90 = local_offset(session, fill.local_id());
                                        emit_ValuesResize(session, offset, field, staged_a2_90);
                                    }
                                    const i64 staged_a0_91 = local_offset(session, fill.local_id());
                                    emit_EndObject(session, staged_a0_91);
                                }
                            } else {
                                if (session.source_equal(source, "at")) {
                                    emit_BytesLoad(session, offset, field);
                                    result = scalar_id(session, compiler_resolver::ResolvedTypeKind::u8_value);
                                } else {
                                    no_span_borrow(session, frame.capability_root_local(), field, source);
                                    if (session.source_equal(source, "set")) {
                                        emit_BytesStore(session, offset, field);
                                    } else {
                                        emit_BytesResize(session, offset, field);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        return finish_expression(session, result, destination);
    }
}
