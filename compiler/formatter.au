export module aurora.compiler.formatter;
import aurora.compiler.lexer;
import aurora.compiler.syntax_arena;
import aurora.compiler.parser;
import aurora.compiler.resolution_kinds;
import aurora.compiler.resolution_rows;
import aurora.compiler.resolution_ingest;
import aurora.compiler.diagnostics;
import aurora.compiler.x86_storage;
import aurora.compiler.x86_object_storage;

export namespace compiler_formatter {
    // Private fixed-width scratch and copied result row. Finding rows carry
    // code, begin/end offsets, line, begin/end columns; summary (-1) carries
    // status, output bytes and the source's and the output's finding counts.
    // No row contains an owner or pointer.
    class Row {
    public:
        i64 a;
        i64 b;
        i64 c;
        i64 d;
        i64 e;
        i64 f;
        Row(i64 first, i64 second, i64 third, i64 fourth, i64 fifth, i64 sixth) : a(first), b(second), c(third),
            d(fourth), e(fifth), f(sixth) {
        }
    };
    auto pool(builtin::ByteRegion region) -> builtin::OwnedValues<Row> {
        const Row empty = Row(0, 0, 0, 0, 0, 0);
        builtin::OwnedValues<Row> result = region.try_allocate(0, empty);
        return move(result);
    }
    auto rejections(builtin::ByteRegion region) -> builtin::OwnedValues<compiler_resolver::SourceResult> {
        const compiler_resolver::SourceResult empty = compiler_resolver::SourceResult();
        builtin::OwnedValues<compiler_resolver::SourceResult> result = region.try_allocate(0, empty);
        return move(result);
    }
    auto append_row(builtin::OwnedValues<Row>& rows, i64 count, Row row, Row fill) -> bool {
        if (count == rows.size()) {
            const i64 capacity = compiler_x86::grow_capacity(rows.size(), count + 1, 1048577, 8);
            if (!rows.try_resize(capacity, fill)) {
                return false;
            }
        }
        rows.set(count, row);
        return true;
    }
    auto row_field(Row row, i64 field) -> i64 {
        if (field == 0) {
            return row.a;
        }
        if (field == 1) {
            return row.b;
        }
        if (field == 2) {
            return row.c;
        }
        if (field == 3) {
            return row.d;
        }
        if (field == 4) {
            return row.e;
        }
        return row.f;
    }
    class Workspace {
        builtin::OwnedValues<Row> pieces;
        builtin::OwnedValues<Row> breaks;
        builtin::OwnedValues<Row> braces;
        builtin::OwnedValues<Row> findings;
        builtin::OwnedValues<Row> tokens;
        builtin::OwnedBytes marked;
        builtin::OwnedBytes output;
        builtin::OwnedBytes joined;
        builtin::OwnedBytes input;
        builtin::OwnedValues<compiler_resolver::SourceResult> rejected;
        i64 pieceCount;
        i64 tokenCount;
        i64 breakCount;
        i64 braceCount;
        i64 findingCount;
        i64 remainingCount;
        i64 outputSize;
        i64 column;
        i64 lineStart;
        i64 status;
    public:
        auto token_piece(i64 index) const -> i64 {
            const Row row = tokens.at(index);
            return row.a;
        }
        auto pieces_field(i64 index, i64 field) const -> i64 {
            const Row row = pieces.at(index);
            return row_field(row, field);
        }
        auto breaks_field(i64 index, i64 field) const -> i64 {
            const Row row = breaks.at(index);
            return row_field(row, field);
        }
        auto braces_field(i64 index, i64 field) const -> i64 {
            const Row row = braces.at(index);
            return row_field(row, field);
        }
        auto fail(i64 reason) -> bool {
            status = reason;
            return false;
        }
        auto piece(Row row) -> bool {
            const i64 count = pieceCount;
            const Row empty = Row(0, 0, 0, 0, 0, 0);
            if (!append_row(pieces, count, row, empty)) {
                return fail(1);
            }
            pieceCount = count + 1;
            return true;
        }
        auto token(i64 index) -> bool {
            const i64 count = tokenCount;
            const Row entry = Row(index, 0, 0, 0, 0, 0);
            if (!append_row(tokens, count, entry, entry)) {
                return fail(1);
            }
            tokenCount = count + 1;
            return true;
        }
        auto finding(Row row) -> bool {
            const i64 count = findingCount;
            const Row empty = Row(0, 0, 0, 0, 0, 0);
            if (!append_row(findings, count, row, empty)) {
                return fail(1);
            }
            findingCount = count + 1;
            return true;
        }
        auto breakpoint(Row row) -> bool {
            const i64 count = breakCount;
            const Row empty = Row(0, 0, 0, 0, 0, 0);
            if (!append_row(breaks, count, row, empty)) {
                return fail(1);
            }
            breakCount = count + 1;
            return true;
        }
        auto brace(Row row) -> bool {
            const i64 count = braceCount;
            const Row empty = Row(0, 0, 0, 0, 0, 0);
            if (!append_row(braces, count, row, empty)) {
                return fail(1);
            }
            braceCount = count + 1;
            return true;
        }
        auto reserve(i64 added) -> bool {
            if (added < 0 || added > 1048576 - outputSize) {
                return fail(2);
            }
            if (outputSize + added > output.size()) {
                const i64 capacity = compiler_x86::grow_capacity(output.size(), outputSize + added, 1048576, 64);
                if (!output.try_resize(capacity)) {
                    return fail(1);
                }
            }
            return true;
        }
        auto byte(u8 value) -> bool {
            if (!reserve(1)) {
                return false;
            }
            output.set(outputSize, value);
            outputSize = outputSize + 1;
            return true;
        }
        auto newline() -> bool {
            if (outputSize > 0 && output.at(outputSize - 1) != '\n') {
                if (!byte('\n')) {
                    return false;
                }
            }
            column = 0;
            lineStart = outputSize;
            breakCount = 0;
            return true;
        }
        auto blank_line() -> bool {
            if (!newline()) {
                return false;
            }
            if (outputSize > 0 && (outputSize < 2 || output.at(outputSize - 2) != '\n')) {
                if (!byte('\n')) {
                    return false;
                }
                lineStart = outputSize;
            }
            return true;
        }
        auto append(builtin::span<const u8> text, i64 depth) -> bool {
            i64 indent = 0;
            if (column == 0) {
                indent = depth * 4;
            }
            if (!reserve(text.size() + indent)) {
                return false;
            }
            // The complete append is reserved; each store still checks its owner and bounds.
            i64 at = 0;
            while (at < indent) {
                output.set(outputSize, ' ');
                outputSize = outputSize + 1;
                at = at + 1;
            }
            at = 0;
            while (at < text.size()) {
                output.set(outputSize, text.at(at));
                outputSize = outputSize + 1;
                at = at + 1;
            }
            column = column + indent + text.size();
            return true;
        }
        auto equal(i64 index, builtin::span<const u8> text) const -> bool {
            if (index < 0 || index >= pieceCount) {
                return false;
            }
            const Row row = pieces.at(index);
            if (row.b - row.a != text.size()) {
                return false;
            }
            i64 at = 0;
            while (at < text.size()) {
                if (input.at(row.a + at) != text.at(at)) {
                    return false;
                }
                at = at + 1;
            }
            return true;
        }
        auto flag(i64 tokenIndex, i64 bit) -> bool {
            if (tokenIndex < 0 || tokenIndex >= tokenCount) {
                return fail(3);
            }
            const i64 index = token_piece(tokenIndex);
            Row row = pieces.at(index);
            row.f = i64(u64(row.f) | u64(bit));
            return pieces.set(index, row);
        }
        auto initializer(i64 tokenIndex, i64 bit) -> bool {
            const array<u8, 1> open = "{";
            i64 at = tokenIndex;
            while (at < tokenCount) {
                if (equal(token_piece(at), borrow_bytes(open))) {
                    return flag(at, bit);
                }
                at = at + 1;
            }
            return fail(3);
        }
        auto mark(i64 index) -> bool {
            if (index < 0 || index >= marked.size()) {
                return fail(3);
            }
            return marked.set(index, 1u8);
        }
    public:
        auto prepare_marks(i64 count) -> bool {
            if (!marked.try_resize(count)) {
                return fail(1);
            }
            return true;
        }
        auto mark_at(i64 index) const -> u8 {
            return marked.at(index);
        }
    public:
        Workspace(builtin::ByteRegion region) : pieces(pool(region)), breaks(pool(region)), braces(pool(region)),
            findings(pool(region)), tokens(pool(region)), marked(region.try_allocate(0)),
            output(region.try_allocate(0)), joined(region.try_allocate(0)), input(region.try_allocate(0)),
            rejected(rejections(region)), pieceCount(0), tokenCount(0), breakCount(0), braceCount(0), findingCount(0),
            remainingCount(0), outputSize(0), column(0), lineStart(0), status(0) {
        }
        auto scan(builtin::span<const u8> source) -> bool {
            if (source.size() > 1048576 || pieceCount != 0 || tokenCount != 0 || status != 0) {
                return fail(3);
            }
            i64 offset = 0;
            i64 line = 1;
            i64 start = 0;
            while (offset < source.size()) {
                const compiler_lexer::Cursor cursor = compiler_lexer::Cursor(offset, line, start);
                const compiler_lexer::Lexeme next = compiler_lexer::next_lexeme(source, cursor);
                if (next.kind() == compiler_lexer::Event::token || next.kind() == compiler_lexer::Event::line_comment) {
                    i64 comment = 0;
                    if (next.kind() == compiler_lexer::Event::line_comment) {
                        comment = 1;
                    } else {
                        comment = classify(source, cursor.at(), next.next_offset());
                        if (!token(pieceCount)) {
                            return false;
                        }
                    }
                    const Row row = Row(cursor.at(), next.next_offset(), cursor.row(), next.next_line(), comment, 0);
                    if (!piece(row)) {
                        return false;
                    }
                } else {
                    if (next.kind() != compiler_lexer::Event::whitespace) {
                        // The parser reports the lexical error; formatting refuses to start.
                        status = 3;
                        return true;
                    }
                }
                offset = next.next_offset();
                line = next.next_line();
                start = next.next_line_start();
            }
            return true;
        }

        // Cache spelling once: 0 is other, 1 is comment, 2..24 are layout tokens.
        auto classify(builtin::span<const u8> source, i64 begin, i64 end) const -> i64 {
            if (end - begin == 1 && source.at(begin + 0) == '{') {
                return 2;
            }
            if (end - begin == 1 && source.at(begin + 0) == '}') {
                return 3;
            }
            if (end - begin == 6 && source.at(begin + 0) == 'p' && source.at(begin + 1) == 'u' && source.at(begin + 2)
                == 'b' && source.at(begin + 3) == 'l' && source.at(begin + 4) == 'i' && source.at(begin + 5) == 'c') {
                return 4;
            }
            if (end - begin == 7 && source.at(begin + 0) == 'p' && source.at(begin + 1) == 'r' && source.at(begin + 2)
                == 'i' && source.at(begin + 3) == 'v' && source.at(begin + 4) == 'a' && source.at(begin + 5) == 't'
                && source.at(begin + 6) == 'e') {
                return 5;
            }
            if (end - begin == 1 && source.at(begin + 0) == ':') {
                return 6;
            }
            if (end - begin == 1 && source.at(begin + 0) == ';') {
                return 7;
            }
            if (end - begin == 1 && source.at(begin + 0) == ',') {
                return 8;
            }
            if (end - begin == 1 && source.at(begin + 0) == ')') {
                return 9;
            }
            if (end - begin == 1 && source.at(begin + 0) == ']') {
                return 10;
            }
            if (end - begin == 4 && source.at(begin + 0) == 'e' && source.at(begin + 1) == 'l' && source.at(begin + 2)
                == 's' && source.at(begin + 3) == 'e') {
                return 11;
            }
            if (end - begin == 1 && source.at(begin + 0) == '(') {
                return 12;
            }
            if (end - begin == 1 && source.at(begin + 0) == '[') {
                return 13;
            }
            if (end - begin == 1 && source.at(begin + 0) == '.') {
                return 14;
            }
            if (end - begin == 2 && source.at(begin + 0) == ':' && source.at(begin + 1) == ':') {
                return 15;
            }
            if (end - begin == 1 && source.at(begin + 0) == '<') {
                return 16;
            }
            if (end - begin == 1 && source.at(begin + 0) == '>') {
                return 17;
            }
            if (end - begin == 2 && source.at(begin + 0) == '>' && source.at(begin + 1) == '>') {
                return 18;
            }
            if (end - begin == 2 && source.at(begin + 0) == 'i' && source.at(begin + 1) == 'f') {
                return 19;
            }
            if (end - begin == 5 && source.at(begin + 0) == 'w' && source.at(begin + 1) == 'h' && source.at(begin + 2)
                == 'i' && source.at(begin + 3) == 'l' && source.at(begin + 4) == 'e') {
                return 20;
            }
            if (end - begin == 6 && source.at(begin + 0) == 'r' && source.at(begin + 1) == 'e' && source.at(begin + 2)
                == 't' && source.at(begin + 3) == 'u' && source.at(begin + 4) == 'r' && source.at(begin + 5) == 'n') {
                return 21;
            }
            if (end - begin == 8 && source.at(begin + 0) == 't' && source.at(begin + 1) == 'e' && source.at(begin + 2)
                == 'm' && source.at(begin + 3) == 'p' && source.at(begin + 4) == 'l' && source.at(begin + 5) == 'a'
                && source.at(begin + 6) == 't' && source.at(begin + 7) == 'e') {
                return 22;
            }
            if (end - begin == 1 && source.at(begin + 0) == '=') {
                return 23;
            }
            if (end - begin == 2 && source.at(begin + 0) == '-' && source.at(begin + 1) == '>') {
                return 24;
            }
            return 0;
        }
        auto is(i64 index, i64 key) const -> bool {
            if (index < 0 || index >= pieceCount || key < 0 || key > 22) {
                return false;
            }
            const Row row = pieces.at(index);
            return row.e == key + 2;
        }
        auto joins(i64 left, i64 right) -> bool {
            if (left < 0) {
                return false;
            }
            const Row first = pieces.at(left);
            const Row second = pieces.at(right);
            const i64 length = first.b - first.a + second.b - second.a;
            if (joined.size() < length && !joined.try_resize(length)) {
                fail(1);
                return false;
            }
            i64 at = 0;
            while (at < first.b - first.a) {
                joined.set(at, input.at(first.a + at));
                at = at + 1;
            }
            i64 next = second.a;
            while (next < second.b) {
                joined.set(at, input.at(next));
                at = at + 1;
                next = next + 1;
            }
            const builtin::span<const u8> all = borrow_bytes(joined);
            const builtin::span<const u8> text = all.subspan(0, length);
            const compiler_lexer::Lexeme a = compiler_lexer::next_lexeme(text, compiler_lexer::Cursor(0, 1, 0));
            if (a.kind() != compiler_lexer::Event::token || a.next_offset() != first.b - first.a) {
                return false;
            }
            const compiler_lexer::Lexeme b = compiler_lexer::next_lexeme(text, compiler_lexer::Cursor(a.next_offset(),
                a.next_line(), a.next_line_start()));
            return b.kind() == compiler_lexer::Event::token && b.next_offset() == length;
        }
        auto layout() -> i64 {
            const array<u8, 1> gap = " ";
            i64 previous = -1;
            i64 previousKind = 0;
            i64 parentheses = 0;
            bool hardBreak = false;
            bool previousUnary = false;
            bool previousTemplateOpen = false;
            i64 index = 0;
            while (index < pieceCount) {
                const Row piece = pieces.at(index);
                // Reuse the checked row snapshot for all current-token predicates.
                const i64 kind = piece.e;
                const i64 textSize = piece.b - piece.a;
                i64 lines = 0;
                if (index > 0) {
                    i64 at = pieces_field(index - 1, 1);
                    while (at < piece.a) {
                        if (input.at(at) == '\n') {
                            lines = lines + 1;
                        }
                        at = at + 1;
                    }
                }
                const bool separated = lines >= 2;
                const bool afterOpeningBrace = index > 0 && pieces_field(index - 1, 4) != 1 && is(index - 1, 0);
                i64 depth = braceCount;
                if (piece.e == 1) {
                    const bool wasTrailing = previous >= 0 && pieces_field(previous, 3) == piece.c;
                    if ((!wasTrailing || column + 1 + textSize > 120) && !newline()) {
                        return status;
                    }
                    if (separated && !afterOpeningBrace && !blank_line()) {
                        return status;
                    }
                    if (column != 0 && !append(borrow_bytes(gap), depth)) {
                        return status;
                    }
                    if (!append_source(piece.a, piece.b, depth) || !newline()) {
                        return status;
                    }
                    hardBreak = false;
                } else {
                    const bool unary = (i64(u64(piece.f) & 1u64)) != 0;
                    const bool binary = (i64(u64(piece.f) & 2u64)) != 0;
                    const bool templateOpen = (kind == 16) && !binary;
                    const bool templateClose = ((kind == 17) || (kind == 18)) && !binary;
                    const bool initializer = (kind == 2) && (i64(u64(piece.f) & 4u64)) != 0 && (i64(u64(piece.f)
                        & 8u64)) == 0;
                    const bool emptyInitializer = initializer && is(index + 1, 1);
                    const bool closesEmpty = (kind == 3) && (previousKind == 2) && braceCount > 0
                        && braces_field(braceCount - 1, 0) == 1;
                    const bool label = ((kind == 4) || (kind == 5)) && is(index + 1, 4);
                    if ((kind == 3)) {
                        if (braceCount == 0) {
                            fail(3);
                            return status;
                        }
                        depth = depth - 1;
                    }
                    if (label && depth > 0) {
                        depth = depth - 1;
                    }
                    const bool structuralBreak = (hardBreak && !(kind == 7) && !(kind == 8) && !(kind == 9) && !(kind
                        == 10) && !(kind == 11)) || ((kind == 3) && !closesEmpty) || label;
                    if (structuralBreak && !newline()) {
                        return status;
                    }
                    if (separated && !afterOpeningBrace && !(kind == 3) && (structuralBreak || (index > 0
                        && pieces_field(index - 1, 4) == 1)) && !blank_line()) {
                        return status;
                    }
                    hardBreak = false;
                    bool space = previous >= 0;
                    if ((kind == 7) || (kind == 8) || (kind == 9) || (kind == 10) || (kind == 14) || (kind == 15)
                        || templateClose || (previousKind == 12) || (previousKind == 13) || (previousKind == 14)
                        || (previousKind == 15) || previousUnary || previousTemplateOpen || closesEmpty) {
                        space = false;
                    }
                    if ((i64(u64(piece.f) & 16u64)) != 0) {
                        space = false;
                    }
                    if ((kind == 12) || (kind == 13)) {
                        // A parenthesis is spaced after if, while, return, =, a comma or a binary operator.
                        space = (previousKind == 19) || (previousKind == 20) || ((kind == 12) && ((previousKind == 21)
                            || (previousKind == 23) || (previousKind == 8))) || ((kind == 12) && previous >= 0
                            && (i64(u64(pieces_field(previous, 5)) & 2u64)) != 0);
                    }
                    if (templateOpen) {
                        space = (previousKind == 22);
                    }
                    if ((kind == 6)) {
                        space = !(previousKind == 4) && !(previousKind == 5);
                    }
                    if (initializer && !(previousKind == 23) && !(previousKind == 8) && !(previousKind == 21)
                        && !is(previous, 10)) {
                        space = false;
                    }
                    if (column != 0 && !space && !joins(previous, index)) {
                        if (status != 0) {
                            return status;
                        }
                        space = true;
                    }
                    i64 priority = 0;
                    if (binary || (previousKind == 8)) {
                        priority = 2;
                    } else {
                        if ((previousKind == 23) || (previousKind == 21) || (previousKind == 24) || (((previousKind
                            == 12) || (previousKind == 13)) && !(kind == 9) && !(kind == 10))) {
                            priority = 1;
                        }
                    }
                    if (priority != 0 && column != 0) {
                        i64 width = 0;
                        if (space) {
                            width = 1;
                        }
                        if (!breakpoint(Row(outputSize, braceCount + 1, width, priority, 0, 0))) {
                            return status;
                        }
                    }
                    if (column != 0 && space && !append(borrow_bytes(gap), depth)) {
                        return status;
                    }
                    if (!append_source(piece.a, piece.b, depth)) {
                        return status;
                    }
                    while (column > 120 && breakCount > 0) {
                        i64 chosen = 0;
                        bool fits = false;
                        i64 at = 0;
                        while (at < breakCount && breaks_field(at, 0) - lineStart <= 120) {
                            if (!fits || breaks_field(at, 3) >= breaks_field(chosen, 3)) {
                                chosen = at;
                                fits = true;
                            }
                            at = at + 1;
                        }
                        const Row boundary = breaks.at(chosen);
                        const i64 added = 1 + boundary.b * 4 - boundary.c;
                        if (!reserve(added)) {
                            return status;
                        }
                        at = outputSize;
                        while (at > boundary.a + boundary.c) {
                            at = at - 1;
                            output.set(at + added, output.at(at));
                        }
                        output.set(boundary.a, '\n');
                        at = 0;
                        while (at < boundary.b * 4) {
                            output.set(boundary.a + 1 + at, ' ');
                            at = at + 1;
                        }
                        outputSize = outputSize + added;
                        at = chosen + 1;
                        while (at < breakCount) {
                            Row candidate = breaks.at(at);
                            candidate.a = candidate.a + added;
                            breaks.set(at - chosen - 1, candidate);
                            at = at + 1;
                        }
                        breakCount = breakCount - chosen - 1;
                        lineStart = boundary.a + 1;
                        column = outputSize - lineStart;
                    }
                    if ((kind == 12)) {
                        parentheses = parentheses + 1;
                    } else {
                        if ((kind == 9)) {
                            if (parentheses == 0) {
                                fail(3);
                                return status;
                            }
                            parentheses = parentheses - 1;
                        }
                    }
                    if ((kind == 2)) {
                        i64 init = 0;
                        if (initializer) {
                            init = 1;
                        }
                        if (!brace(Row(init, i64(u64(piece.f) & 8u64), parentheses, 0, 0, 0))) {
                            return status;
                        }
                        hardBreak = !emptyInitializer;
                    } else {
                        if ((kind == 3)) {
                            hardBreak = braces_field(braceCount - 1, 0) == 0;
                            braceCount = braceCount - 1;
                        } else {
                            if ((kind == 7) || ((kind == 6) && ((previousKind == 4) || (previousKind == 5)))) {
                                hardBreak = true;
                            } else {
                                if ((kind == 8) && braceCount > 0 && (braces_field(braceCount - 1, 0) == 1
                                    || braces_field(braceCount - 1, 1) != 0) && parentheses == braces_field(braceCount
                                    - 1, 2)) {
                                    hardBreak = true;
                                }
                            }
                        }
                    }
                    previous = index;
                    previousKind = kind;
                    previousUnary = unary;
                    previousTemplateOpen = templateOpen;
                }
                index = index + 1;
            }
            if (!newline()) {
                return status;
            }
            status = 4;
            return status;
        }
        auto style() -> bool {
            i64 begin = 0;
            i64 line = 1;
            i64 tokenAt = 0;
            while (begin < input.size()) {
                i64 end = begin;
                while (end < input.size() && input.at(end) != '\n') {
                    end = end + 1;
                }
                i64 first = begin;
                while (first < end && input.at(first) == ' ') {
                    first = first + 1;
                }
                while (tokenAt < tokenCount && pieces_field(token_piece(tokenAt), 0) < first) {
                    tokenAt = tokenAt + 1;
                }
                bool literal = false;
                if (tokenAt < tokenCount) {
                    const Row token = pieces.at(token_piece(tokenAt));
                    if (token.a == first && token.a < token.b && input.at(token.a) == '"' && token.b <= end) {
                        i64 suffix = token.b;
                        while (suffix < end && (input.at(suffix) == ';' || input.at(suffix) == ',' || input.at(suffix)
                            == ')' || input.at(suffix) == ']')) {
                            suffix = suffix + 1;
                        }
                        literal = suffix == end && first - begin + 2 + end - token.b <= 120;
                    }
                }
                if (end - begin > 120 && !literal) {
                    if (!finding(Row(1, begin + 120, end, line, 121, end - begin + 1))) {
                        return false;
                    }
                }
                i64 trailing = end;
                while (trailing > begin && (input.at(trailing - 1) == ' ' || input.at(trailing - 1) == '\t'
                    || input.at(trailing - 1) == '\r')) {
                    trailing = trailing - 1;
                }
                if (trailing != end && !finding(Row(2, trailing, end, line, trailing - begin + 1, end - begin + 1))) {
                    return false;
                }
                i64 leading = begin;
                bool tab = false;
                while (leading < trailing && (input.at(leading) == ' ' || input.at(leading) == '\t')) {
                    tab = tab || input.at(leading) == '\t';
                    leading = leading + 1;
                }
                if (leading != trailing && (tab || (leading - begin) % 4 != 0)) {
                    if (!finding(Row(3, begin, leading, line, 1, leading - begin + 1))) {
                        return false;
                    }
                }
                begin = end;
                if (begin < input.size()) {
                    begin = begin + 1;
                }
                line = line + 1;
            }
            return true;
        }
        auto begin(builtin::span<const u8> source) -> bool {
            if (status != 0) {
                return fail(3);
            }
            if (source.size() > 1048576 || !pieces.ok() || !breaks.ok() || !braces.ok() || !findings.ok()
                || !tokens.ok() || !marked.ok() || !output.ok() || !joined.ok() || !input.ok() || !rejected.ok()) {
                return fail(1);
            }
            if (!input.try_resize(source.size())) {
                return fail(1);
            }
            i64 at = 0;
            while (at < source.size()) {
                input.set(at, source.at(at));
                at = at + 1;
            }
            if (!scan(source)) {
                return false;
            }
            if (status == 0) {
                status = 5;
            }
            return true;
        }
        auto append_source(i64 begin, i64 end, i64 depth) -> bool {
            i64 indent = 0;
            if (column == 0) {
                indent = depth * 4;
            }
            if (!reserve(end - begin + indent)) {
                return false;
            }
            // The complete append is reserved; each store still checks its owner and bounds.
            i64 at = 0;
            while (at < indent) {
                output.set(outputSize, ' ');
                outputSize = outputSize + 1;
                at = at + 1;
            }
            at = begin;
            while (at < end) {
                output.set(outputSize, input.at(at));
                outputSize = outputSize + 1;
                at = at + 1;
            }
            column = column + indent + end - begin;
            return true;
        }
        auto start() -> bool {
            if (status != 5) {
                return fail(3);
            }
            status = 0;
            return true;
        }
        auto complete() -> i64 {
            if (status == 0) {
                status = 4;
            }
            return status;
        }
        auto state() const -> i64 {
            return status;
        }
        auto original() const -> builtin::span<const u8> {
            const builtin::span<const u8> all = borrow_bytes(input);
            return all;
        }
        auto formatted() const -> builtin::span<const u8> {
            const builtin::span<const u8> all = borrow_bytes(output);
            const builtin::span<const u8> visible = all.subspan(0, outputSize);
            return visible;
        }
        // Status 6 rejects the source, 7 the output (whose text stays readable).
        auto reject(compiler_resolver::SourceResult result, i64 reason) -> bool {
            if (!rejected.try_resize(1, result)) {
                return fail(1);
            }
            rejected.set(0, result);
            return fail(reason);
        }
        auto rejection() const -> compiler_resolver::SourceResult {
            if ((status != 6 && status != 7) || rejected.size() != 1) {
                const compiler_resolver::SourceResult invalid = compiler_resolver::SourceResult();
                return invalid;
            }
            const compiler_resolver::SourceResult result = rejected.at(0);
            return result;
        }
        // Appends a finding of the formatted output after the source's own.
        auto remaining(Row row) -> bool {
            const i64 count = findingCount + remainingCount;
            const Row empty = Row(0, 0, 0, 0, 0, 0);
            if (!append_row(findings, count, row, empty)) {
                return fail(1);
            }
            remainingCount = remainingCount + 1;
            return true;
        }
        auto report() const -> Row {
            const Row result = Row(status, outputSize, findingCount, remainingCount, 0, 0);
            return result;
        }
        auto read_finding(i64 index) const -> Row {
            if (index == -1) {
                const Row summary = report();
                return summary;
            }
            if (status != 4 || index < 0 || index >= findingCount + remainingCount) {
                const Row invalid = Row(-1, 0, 0, 0, 0, 0);
                return invalid;
            }
            const Row result = findings.at(index);
            return result;
        }
        auto chunk(i64 offset) const -> compiler_x86::EmitChunk {
            compiler_x86::EmitChunk result = compiler_x86::EmitChunk();
            if ((status != 4 && status != 7) || offset < 0 || offset > outputSize) {
                result.invalidate();
                return result;
            }
            i64 count = outputSize - offset;
            if (count > 512) {
                count = 512;
            }
            i64 at = 0;
            while (at < count) {
                result.append(output.at(offset + at));
                at = at + 1;
            }
            return result;
        }
    };
    auto roles(Workspace& workspace, const compiler_parser::AstArena& arena) -> bool {
        if (!workspace.prepare_marks(arena.size())) {
            return false;
        }
        i64 at = 0;
        while (at < arena.syntax_size()) {
            const compiler_parser::SyntaxNode row = arena.syntax_at(at);
            const compiler_parser::SyntaxKind kind = row.kind();
            if (kind == compiler_parser::SyntaxKind::parameter && row.borrow_site() >= 0) {
                if (!workspace.flag(row.borrow_site(), 16)) {
                    return false;
                }
            }
            if (kind == compiler_parser::SyntaxKind::enum_definition) {
                if (!workspace.initializer(row.token(), 8)) {
                    return false;
                }
            }
            if (kind == compiler_parser::SyntaxKind::local || kind == compiler_parser::SyntaxKind::return_value || kind
                == compiler_parser::SyntaxKind::static_assertion || kind == compiler_parser::SyntaxKind::expression
                || kind == compiler_parser::SyntaxKind::conditional || kind == compiler_parser::SyntaxKind::loop || kind
                == compiler_parser::SyntaxKind::assign || kind == compiler_parser::SyntaxKind::field_assign || kind
                == compiler_parser::SyntaxKind::index_assign || kind == compiler_parser::SyntaxKind::initializer) {
                if (!workspace.mark(row.expression())) {
                    return false;
                }
                if (kind == compiler_parser::SyntaxKind::index_assign && !workspace.mark(row.target())) {
                    return false;
                }
            }
            at = at + 1;
        }
        at = arena.size();
        while (at > 0) {
            at = at - 1;
            if (workspace.mark_at(at) != 0u8) {
                const compiler_parser::AstNode node = arena.at(at);
                const compiler_parser::NodeKind kind = node.kind();
                if (kind == compiler_parser::NodeKind::unary && !workspace.flag(node.token(), 1)) {
                    return false;
                }
                if (kind == compiler_parser::NodeKind::binary && !workspace.flag(node.token(), 2)) {
                    return false;
                }
                if (kind == compiler_parser::NodeKind::array_literal || kind == compiler_parser::NodeKind::construct
                    || kind == compiler_parser::NodeKind::array_zero) {
                    if (!workspace.initializer(node.token(), 4)) {
                        return false;
                    }
                }
                if (kind == compiler_parser::NodeKind::call || kind == compiler_parser::NodeKind::method_call || kind
                    == compiler_parser::NodeKind::array_literal || kind == compiler_parser::NodeKind::construct || kind
                    == compiler_parser::NodeKind::array_zero) {
                    i64 edge = node.first();
                    while (edge >= 0) {
                        const compiler_parser::ChildEdge child = arena.edge(edge);
                        if (!workspace.mark(child.child())) {
                            return false;
                        }
                        edge = child.previous();
                    }
                } else {
                    if (node.first() >= 0 && !workspace.mark(node.first())) {
                        return false;
                    }
                    if (node.second() >= 0 && !workspace.mark(node.second())) {
                        return false;
                    }
                }
            }
        }
        return true;
    }
    // Whether `after` spells the same tokens and line comments in the same
    // order as `before`: no token changed and no comment moved across a token.
    auto preserved(builtin::span<const u8> before, builtin::span<const u8> after) -> bool {
        i64 left = 0;
        i64 leftLine = 1;
        i64 leftStart = 0;
        i64 right = 0;
        i64 rightLine = 1;
        i64 rightStart = 0;
        bool scanning = true;
        while (scanning) {
            const compiler_lexer::Lexeme first = compiler_lexer::next_lexeme(before, compiler_lexer::Cursor(left,
                leftLine, leftStart));
            const compiler_lexer::Lexeme second = compiler_lexer::next_lexeme(after, compiler_lexer::Cursor(right,
                rightLine, rightStart));
            if (first.kind() == compiler_lexer::Event::whitespace) {
                left = first.next_offset();
                leftLine = first.next_line();
                leftStart = first.next_line_start();
            } else {
                if (second.kind() == compiler_lexer::Event::whitespace) {
                    right = second.next_offset();
                    rightLine = second.next_line();
                    rightStart = second.next_line_start();
                } else {
                    if (first.kind() != second.kind() || first.next_offset() - left != second.next_offset() - right) {
                        return false;
                    }
                    if (first.kind() == compiler_lexer::Event::end_of_input) {
                        return true;
                    }
                    if (first.kind() != compiler_lexer::Event::token && first.kind()
                        != compiler_lexer::Event::line_comment) {
                        return false;
                    }
                    i64 at = 0;
                    while (at < first.next_offset() - left) {
                        if (before.at(left + at) != after.at(right + at)) {
                            return false;
                        }
                        at = at + 1;
                    }
                    left = first.next_offset();
                    leftLine = first.next_line();
                    leftStart = first.next_line_start();
                    right = second.next_offset();
                    rightLine = second.next_line();
                    rightStart = second.next_line_start();
                }
            }
        }
        return false;
    }
    auto same(builtin::span<const u8> first, builtin::span<const u8> second) -> bool {
        if (first.size() != second.size()) {
            return false;
        }
        i64 at = 0;
        while (at < first.size()) {
            if (first.at(at) != second.at(at)) {
                return false;
            }
            at = at + 1;
        }
        return true;
    }
    auto lay_out(Workspace& workspace, const compiler_parser::AstArena& arena) -> bool {
        return workspace.start() && workspace.style() && roles(workspace, arena) && workspace.layout() == 4;
    }
    auto adopt(Workspace& workspace, const Workspace& again) -> bool {
        const Row summary = again.read_finding(-1);
        i64 at = 0;
        while (at < summary.c) {
            const Row row = again.read_finding(at);
            if (!workspace.remaining(row)) {
                return false;
            }
            at = at + 1;
        }
        return true;
    }
    // Formats the prepared source as one operation: parse and admit it, lay it
    // out, require the output to keep every token and line comment in place,
    // and require formatting the output to reproduce it. The output's style
    // findings follow the source's. Style findings alone need no parse.
    auto run(builtin::ByteRegion region, Workspace workspace, bool format) -> Workspace {
        if (!format) {
            if (workspace.start() && workspace.style()) {
                workspace.complete();
            }
            return move(workspace);
        }
        compiler_parser::AstArena arena = compiler_parser::create(region, 0);
        const compiler_resolver::SourceResult parsed = compiler_resolver::parse_source(arena, workspace.original());
        if (!parsed.admitted()) {
            workspace.reject(parsed, 6);
            return move(workspace);
        }
        if (!lay_out(workspace, arena)) {
            return move(workspace);
        }
        // As when the output was lexed first, its lexical errors precede a moved token.
        const compiler_resolver::SourceResult reparsed = compiler_resolver::parse_source(arena, workspace.formatted());
        if (reparsed.lexically_rejected()) {
            workspace.reject(reparsed, 7);
            return move(workspace);
        }
        if (!preserved(workspace.original(), workspace.formatted())) {
            workspace.fail(8);
            return move(workspace);
        }
        if (!reparsed.admitted()) {
            workspace.reject(reparsed, 7);
            return move(workspace);
        }
        Workspace again = Workspace(region);
        if (!again.begin(workspace.formatted())) {
            workspace.fail(1);
            return move(workspace);
        }
        if (!lay_out(again, arena)) {
            workspace.fail(again.state());
            return move(workspace);
        }
        if (!same(workspace.formatted(), again.formatted())) {
            workspace.fail(9);
            return move(workspace);
        }
        adopt(workspace, again);
        return move(workspace);
    }
    // A formatter diagnostic from its message offset on. Index -1 is the
    // failure of a run that did not complete: the rejected source (status 6)
    // or output (7, source 1), or an internal refusal. Other indices are the
    // style findings AUF1001-AUF1003 of a run, the output's (source 1) after
    // the source's.
    auto diagnostic(const Workspace& workspace, i64 index, i64 offset) -> compiler_resolver::Report {
        const Row summary = workspace.read_finding(-1);
        const i64 status = summary.a;
        if (index == -1 && status == 6) {
            const compiler_resolver::Report source = compiler_resolver::source_report(workspace.original(),
                workspace.rejection(), compiler_parser::Stop::module_definition, offset);
            return source;
        }
        if (index == -1 && status == 7) {
            compiler_resolver::Report output = compiler_resolver::source_report(workspace.formatted(),
                workspace.rejection(), compiler_parser::Stop::module_definition, offset);
            output.from_source(1);
            return output;
        }
        compiler_resolver::Report value = compiler_resolver::Report(offset);
        if (index == -1) {
            value.when(status == 8, "formatter refused a token/comment change");
            value.when(status == 9, "formatter refused non-idempotent output");
            value.when(status == 2, "formatted output exceeds 1 MiB bound");
            value.when(status == 1, "formatter workspace allocation failed");
            value.when(status != 1 && status != 2 && status != 8 && status != 9, "invalid hosted formatter result");
            return value;
        }
        const Row row = workspace.read_finding(index);
        if (row.a < 1 || row.a > 3) {
            value.invalidate();
            return value;
        }
        compiler_resolver::MetaRow span = compiler_resolver::report_row(0, 0);
        span.set_word(2, 0);
        if (index >= summary.c) {
            span.set_word(2, 1);
        }
        span.set_word(3, row.b);
        span.set_word(4, row.d);
        span.set_word(5, row.e);
        span.set_word(6, row.c);
        span.set_word(7, row.d);
        span.set_word(8, row.f);
        value.locate(span);
        value.classify(1000 + row.a, true);
        value.when(row.a == 1, "line exceeds 120 byte columns; comments and tokens are never split");
        value.when(row.a == 2, "trailing whitespace");
        value.when(row.a == 3, "indentation must use groups of four spaces");
        return value;
    }
    auto create(builtin::ByteRegion region) -> Workspace {
        Workspace result = Workspace(region);
        return move(result);
    }
    auto release(builtin::ByteRegion region, Workspace workspace) -> i64 {
        return 0;
    }
}
