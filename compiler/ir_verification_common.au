export module aurora.compiler.ir_verification_common;
import aurora.compiler.ir_verification_errors;
import aurora.compiler.ir_verification_storage;
import aurora.compiler.ir_verification_initialization;
import aurora.compiler.ir_metadata;
import aurora.compiler.ir_metadata_storage;
import aurora.compiler.ir_instructions;
import aurora.compiler.ir_instruction_storage;

// Dynamic semantic mechanisms operate on the original admitted stores. An access
// mode is instruction-local authority, never a retained fact or an IR operand.
export namespace compiler_ir_verification {
    enum class AccessMode {
        read,
        write,
        validated_read,
        validated_write
    };
    enum class ArgumentRole {
        aggregate,
        resource,
        method,
        borrowed,
        service
    };
    auto writable_mode(AccessMode mode) -> bool {
        return mode == AccessMode::write || mode == AccessMode::validated_write;
    }
    auto validated_mode(AccessMode mode) -> bool {
        return mode == AccessMode::validated_read || mode == AccessMode::validated_write;
    }
    auto read_mode(AccessMode mode) -> AccessMode {
        if (validated_mode(mode)) {
            return AccessMode::validated_read;
        }
        return AccessMode::read;
    }
    auto write_mode(AccessMode mode) -> AccessMode {
        if (validated_mode(mode)) {
            return AccessMode::validated_write;
        }
        return AccessMode::write;
    }
    // Source-internal flag observation. Callers use literal weights 1, 2, 4, 8.
    // Initialization returns -1 on terminal failure, otherwise scalar flags 0..3
    // or receiver flags 0..15. Preserve the -1 sentinel's set-bit observations.
    auto initialization_flag(i64 state, i64 weight) -> bool {
        return state == -1 || (state / weight) % 2 == 1;
    }
    auto require(VerificationWorkspace& w, bool condition, VerificationError error) -> bool {
        if (!w.good()) {
            return false;
        }
        if (!condition) {
            return w.fail(error);
        }
        return true;
    }
    auto no_token() -> TokenRow {
        return TokenRow(TokenKind::none, 0, 0, 0, -1);
    }
    auto semantic_fact(FactKind kind, i64 key, i64 field, i64 site, ByteDisposition disposition,
        TokenRow token) -> FactRow {
        const SpanPayload span = SpanPayload(SpanOrigin::local_array, 0, 0, 0, 0);
        const TypeKey type = TypeKey(0, -1);
        const LoanPayload loan = LoanPayload(0, 0, type, false, false, -1);
        FactRow row = FactRow(kind, key, field, token, span, loan);
        row.set_site(site);
        row.set_disposition(disposition);
        return row;
    }
    auto fact_kind_at(VerificationWorkspace& w, i64 at, FactKind kind) -> bool {
        const FactRow row = w.fact_at(at);
        return row.kind() == kind;
    }
    auto fact_key_at(VerificationWorkspace& w, i64 at, FactKind kind, i64 key) -> bool {
        const FactRow row = w.fact_at(at);
        return row.kind() == kind && row.key() == key;
    }
    auto span_owner_binding(VerificationWorkspace& w, SpanPayload capability) -> FactRow {
        if (capability.owned_field() == -1) {
            return w.fact_find(FactKind::bytes, capability.origin(), -1);
        }
        return w.fact_find(FactKind::owned_field, capability.origin(), capability.owned_field());
    }
    auto present(FactRow row) -> bool {
        return row.kind() != FactKind::none;
    }
    auto has_fact(VerificationWorkspace& w, FactKind kind, i64 key, i64 field) -> bool {
        const FactRow row = w.fact_find(kind, key, field);
        return present(row);
    }
    auto named_class(const compiler_ir_metadata::MetadataStore& m, compiler_ir_metadata::RawTypeRow type) -> i64 {
        const compiler_ir_metadata::ByteRange name = type.name();
        return compiler_ir_metadata::find_class(m, name);
    }
    auto named_enum(const compiler_ir_metadata::MetadataStore& m, compiler_ir_metadata::RawTypeRow type) -> i64 {
        const compiler_ir_metadata::ByteRange name = type.name();
        return compiler_ir_metadata::find_enum(m, name);
    }
    auto unnamed_type(compiler_ir_metadata::RawTypeRow type) -> bool {
        const compiler_ir_metadata::ByteRange name = type.name();
        return compiler_ir_metadata::name_length(name) == 0;
    }
    auto plain_key(TypeKey type, i64 kind) -> bool {
        return type.kind() == kind && type.nominal() == -1;
    }
    auto type_key(const compiler_ir_metadata::MetadataStore& m, i64 raw) -> TypeKey {
        const compiler_ir_metadata::RawTypeRow type = m.type_at(raw);
        i64 nominal = -1;
        if (type.kind() == 5 || type.kind() == 17) {
            nominal = named_class(m, type);
        }
        if (type.kind() == 9) {
            nominal = named_enum(m, type);
        }
        return TypeKey(type.kind(), nominal);
    }
    auto same_type_key(const compiler_ir_metadata::MetadataStore& m, TypeKey key, i64 raw) -> bool {
        const compiler_ir_metadata::RawTypeRow type = m.type_at(raw);
        if (!compiler_ir_metadata::canonical_tail(type) || key.kind() != type.kind()) {
            return false;
        }
        if (type.kind() == 5 || type.kind() == 17 || type.kind() == 9) {
            const TypeKey other = type_key(m, raw);
            return other.nominal() >= 0 && key.same(other);
        }
        return unnamed_type(type) && key.nominal() == -1;
    }
    auto exact_slot(const compiler_ir_metadata::MetadataStore& m, i64 callable, i64 kind, i64 base) -> i64 {
        return compiler_ir_instructions::entry_slot(m, callable, kind, base);
    }
    // The element class of a typed readonly span spill, or -1 for a byte span.
    auto span_class(const compiler_ir_metadata::MetadataStore& m, i64 callable, i64 base) -> i64 {
        const i64 annotation = exact_slot(m, callable, 27, base);
        if (annotation < 0) {
            return -1;
        }
        const compiler_ir_metadata::SlotRow slot = m.slot_at(annotation);
        const compiler_ir_metadata::RawTypeRow type = m.type_at(slot.type());
        return named_class(m, type);
    }
    auto slot_class(const compiler_ir_metadata::MetadataStore& m, i64 slot) -> i64 {
        const compiler_ir_metadata::SlotRow row = m.slot_at(slot);
        const compiler_ir_metadata::RawTypeRow type = m.type_at(row.type());
        return named_class(m, type);
    }
    auto class_field(const compiler_ir_metadata::MetadataStore& m, i64 nominal, i64 ordinal) -> i64 {
        if (nominal < 0) {
            return -1;
        }
        const compiler_ir_metadata::ClassResultRow result = m.result_at(nominal);
        const compiler_ir_metadata::IndexRange fields = result.fields();
        if (ordinal < 0 || ordinal >= fields.count()) {
            return -1;
        }
        return fields.begin() + ordinal;
    }
    auto class_field_offset(const compiler_ir_metadata::MetadataStore& m, i64 nominal, i64 ordinal) -> i64 {
        const compiler_ir_metadata::ClassResultRow result = m.result_at(nominal);
        const compiler_ir_metadata::StorageRow storage = m.storage_at(result.canonical_storage());
        const compiler_ir_metadata::IndexRange fields = storage.field_offsets();
        const compiler_ir_metadata::IndexRow offset = m.index_at(fields.begin() + ordinal);
        return offset.value();
    }
    auto receiver_class(const compiler_ir_metadata::MetadataStore& m, i64 callable) -> i64 {
        const compiler_ir_metadata::CallableRow signature = m.callable_at(callable);
        if (signature.borrowed_root_count() != 0) {
            const compiler_ir_metadata::RawTypeRow type = m.type_at(signature.borrowed_root_type(0));
            if (type.kind() != 5) {
                return -1;
            }
            return named_class(m, type);
        }
        const compiler_ir_metadata::ReceiverShape receiver = signature.first_receiver();
        if (!compiler_ir_metadata::callable_flag(signature, 1u64)) {
            return -1;
        }
        const compiler_ir_metadata::ByteRange name = receiver.name();
        return compiler_ir_metadata::find_class(m, name);
    }
    auto receiver_mutable(const compiler_ir_metadata::MetadataStore& m, i64 callable) -> bool {
        const compiler_ir_metadata::CallableRow signature = m.callable_at(callable);
        if (signature.borrowed_root_count() != 0) {
            return signature.borrowed_root_mutable(0);
        }
        const compiler_ir_metadata::ReceiverShape receiver = signature.first_receiver();
        return compiler_ir_metadata::receiver_flag(receiver, 1u64);
    }
    auto receiver_constructor(const compiler_ir_metadata::MetadataStore& m, i64 callable) -> bool {
        const compiler_ir_metadata::CallableRow signature = m.callable_at(callable);
        if (signature.borrowed_root_count() != 0) {
            return false;
        }
        const compiler_ir_metadata::ReceiverShape receiver = signature.first_receiver();
        return compiler_ir_metadata::receiver_flag(receiver, 2u64);
    }
    auto has_bound_root(VerificationWorkspace& w, i64 root) -> bool {
        const ControlRow control = w.control();
        if (root < -5 || root > 0) {
            return false;
        }
        if (control.borrowed_root_count() != 0) {
            return -root < control.borrowed_root_count();
        }
        return root == 0 && control.has_receiver();
    }
    auto bound_root_class(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m, i64 root) -> i64 {
        const bool condition_150 = has_bound_root(w, root);
        if (!require(w, condition_150, first_error(VerificationErrorFirst::borrowed_object_root_is_not_bound))) {
            return -1;
        }
        const compiler_ir_metadata::CallableRow signature = m.callable_at(w.callable());
        if (signature.borrowed_root_count() == 0) {
            return receiver_class(m, w.callable());
        }
        const compiler_ir_metadata::RawTypeRow type = m.type_at(signature.borrowed_root_type(-root));
        if (!require(w, type.kind() == 5,
            first_error(VerificationErrorFirst::builtin_owner_root_is_not_a_class_receiver))) {
            return -1;
        }
        return named_class(m, type);
    }
    auto bound_root_mutable(const compiler_ir_metadata::MetadataStore& m, i64 callable, i64 root) -> bool {
        const compiler_ir_metadata::CallableRow signature = m.callable_at(callable);
        if (signature.borrowed_root_count() == 0) {
            return receiver_mutable(m, callable);
        }
        return signature.borrowed_root_mutable(-root);
    }
    auto entry_root(const compiler_ir_instructions::InstructionStore& s, i64 callable, i64 position, i64 form) -> i64 {
        const compiler_ir_instructions::RawInstructionRow row = compiler_ir_instructions::entry_instruction(s, callable,
            position);
        if (row.form() != form) {
            return -1;
        }
        return compiler_ir_instructions::entry_value(s, row, 1);
    }
    auto entry_contains(const compiler_ir_instructions::InstructionStore& s, i64 callable, i64 form, i64 base) -> bool {
        i64 at = 0;
        while (at < 6) {
            const compiler_ir_instructions::RawInstructionRow row = compiler_ir_instructions::entry_instruction(s,
                callable, at);
            if (!compiler_ir_instructions::parameter_form(row.form())) {
                return false;
            }
            if (row.form() == form && compiler_ir_instructions::entry_value(s, row, 1) == base) {
                return true;
            }
            at = at + 1;
        }
        return false;
    }
    auto owner_key(const compiler_ir_metadata::MetadataStore& m, i64 callable, i64 base, i64 ordinal) -> TypeKey {
        if (ordinal == -1) {
            if (base == 0) {
                const compiler_ir_metadata::CallableRow signature = m.callable_at(callable);
                const TypeKey result_key = type_key(m, signature.borrowed_root_type(0));
                return result_key;
            }
            const i64 annotation = exact_slot(m, callable, 17, base);
            if (annotation >= 0) {
                const compiler_ir_metadata::SlotRow slot = m.slot_at(annotation);
                const TypeKey result_key = type_key(m, slot.type());
                return result_key;
            }
            return TypeKey(13, -1);
        }
        i64 nominal = receiver_class(m, callable);
        if (base != 0) {
            nominal = slot_class(m, exact_slot(m, callable, 11, base));
        }
        const compiler_ir_metadata::FieldRow field = m.field_at(class_field(m, nominal, ordinal));
        const TypeKey result_key = type_key(m, field.type());
        return result_key;
    }
    auto owner_type(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m, i64 base) -> bool {
        const bool condition_196 = exact_slot(m, w.callable(), 16, base) >= 0;
        return require(w, condition_196, first_error(VerificationErrorFirst::owner_type_requires_exact_typed_spill));
    }
    auto accessed_owner_type(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m, i64 base,
        i64 ordinal) -> bool {
        if (ordinal == -1) {
            const ControlRow control = w.control();
            if (base == 0 && control.builtin_borrowed_owner()) {
                return w.good();
            }
            return owner_type(w, m, base);
        }
        return require(w, ordinal >= 0 && base >= 0,
            first_error(VerificationErrorFirst::invalid_owned_storage_field_selector));
    }
    auto current(VerificationWorkspace& w, TypeKey expected) -> ValueRow {
        const ValueRow value = w.current();
        const TypeKey type = value.type();
        const bool condition_209 = w.current_known() && type.same(expected);
        require(w, condition_209, first_error(VerificationErrorFirst::missing_or_mistyped_current_value));
        return value;
    }
    auto pop(VerificationWorkspace& w) -> ValueRow {
        const bool condition_213 = w.operand_count() != 0;
        if (!require(w, condition_213, first_error(VerificationErrorFirst::value_stack_underflow))) {
            return empty_value();
        }
        return w.pop();
    }
    auto loan_access(VerificationWorkspace& w, const compiler_ir_instructions::InstructionStore& s, i64 root,
        AccessMode mode) -> bool {
        i64 at = w.first_fact(FactKind::object_loan);
        while (at >= 0 && fact_kind_at(w, at, FactKind::object_loan)) {
            const FactRow row = w.fact_at(at);
            const LoanPayload loan = row.loan();
            if (loan.root() == root) {
                bool exercised = false;
                if (validated_mode(mode)) {
                    const ControlRow control = w.control();
                    const compiler_ir_instructions::RawInstructionRow instruction = s.instruction_at(
                        control.instruction_id());
                    if (instruction.form() == 83) {
                        const compiler_ir_instructions::RawOperandRow roots = compiler_ir_instructions::call_operand(s,
                            control.instruction_id(), 1);
                        i64 lane = 0;
                        while (lane < roots.count() && !exercised) {
                            const compiler_ir_instructions::RawOperandRow lane_root = s.operand_at(roots.begin()
                                + lane);
                            const compiler_ir_instructions::RawOperandRow lane_loan = s.operand_at(roots.begin() + lane
                                + 1);
                            const compiler_ir_instructions::RawOperandRow lane_field = s.operand_at(roots.begin() + lane
                                + 2);
                            if (lane_root.signed_value() == root && lane_loan.signed_value() == row.key()
                                && lane_field.signed_value() == loan.field_index()) {
                                exercised = true;
                            }
                            lane = lane + 3;
                        }
                    }
                }
                if (!exercised && !require(w, !writable_mode(mode) && !loan.mutable_value(),
                    first_error(VerificationErrorFirst::object_access_conflicts_with_active_synchronous_loan))) {
                    return false;
                }
            }
            at = w.next_fact(at);
        }
        return w.good();
    }
    auto active_object_field(VerificationWorkspace& w, const compiler_ir_instructions::InstructionStore& s,
        i64 root) -> bool {
        if (root < 0) {
            return w.good();
        }
        const bool condition_251 = has_fact(w, FactKind::object, root, -1);
        if (!require(w, condition_251,
            first_error(VerificationErrorFirst::object_field_access_outside_active_lifetime))) {
            return false;
        }
        if (!loan_access(w, s, root, AccessMode::read)) {
            return false;
        }
        const FactRow owner = w.fact_find(FactKind::owned_object, root, -1);
        return require(w, !present(owner) || owner.disposition() != ByteDisposition::consumed,
            first_error(VerificationErrorFirst::field_access_through_consumed_owning_object));
    }
    auto active_array_element(VerificationWorkspace& w, i64 root) -> bool {
        const bool condition_258 = root < 0 || has_fact(w, FactKind::array_lifetime, root, -1);
        return require(w, condition_258,
            first_error(VerificationErrorFirst::array_element_access_outside_active_lifetime));
    }
    auto array_writable(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m, i64 offset,
        i64 object_root, i64 array_root) -> bool {
        if (object_root >= 0) {
            const i64 nominal = slot_class(m, exact_slot(m, w.callable(), 11, object_root));
            i64 at = w.first_fact(FactKind::span);
            while (at >= 0 && fact_kind_at(w, at, FactKind::span)) {
                const FactRow row = w.fact_at(at);
                const SpanPayload capability = row.span();
                if (capability.array_field() >= 0 && capability.origin() == object_root) {
                    const i64 first = class_field_offset(m, nominal, capability.array_field());
                    const compiler_ir_metadata::FieldRow field = m.field_at(class_field(m, nominal,
                        capability.array_field()));
                    if (!require(w, object_root - offset < first || object_root - offset >= first + field.length(),
                        first_error(VerificationErrorFirst::fixed_array_field_write_with_live_readonly_span))) {
                        return false;
                    }
                }
                at = w.next_fact(at);
            }
        }
        if (array_root < 0) {
            return w.good();
        }
        i64 at = w.first_fact(FactKind::span);
        while (at >= 0 && fact_kind_at(w, at, FactKind::span)) {
            const FactRow row = w.fact_at(at);
            const SpanPayload capability = row.span();
            const TokenRow token = row.token();
            if (!require(w, capability.origin_kind() == SpanOrigin::literal || token.kind() != TokenKind::none
                || capability.origin_kind() == SpanOrigin::parameter || capability.origin() != array_root,
                first_error(VerificationErrorFirst::write_to_byte_array_with_live_readonly_span))) {
                return false;
            }
            at = w.next_fact(at);
        }
        return w.good();
    }
    auto live_span(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 base, AccessMode mode) -> bool {
        const FactRow row = w.fact_find(FactKind::span, base, -1);
        if (!require(w, present(row), first_error(VerificationErrorFirst::span_capability_is_not_active))) {
            return false;
        }
        const SpanPayload capability = row.span();
        const TokenRow token = row.token();
        const ControlRow control = w.control();
        if (capability.origin_kind() == SpanOrigin::literal) {
            if (!require(w, token.kind() == TokenKind::none && capability.owned_field() == -1,
                first_error(VerificationErrorFirst::literal_span_cannot_carry_another_origin_kind))) {
                return false;
            }
            const compiler_ir_instructions::RawInstructionRow origin = s.instruction_at(capability.origin_site());
            if (!require(w, origin.form() == 51 && compiler_ir_instructions::call_value(s, capability.origin_site(), 1)
                == capability.origin() && compiler_ir_instructions::call_count(s, capability.origin_site(), 0) <= 4096,
                first_error(VerificationErrorFirst::literal_span_must_retain_its_exact_immutable_origin))) {
                return false;
            }
        } else {
            if (capability.array_field() >= 0) {
                if (!require(w, capability.origin_kind() != SpanOrigin::parameter && token.kind() == TokenKind::none
                    && capability.owned_field() == -1,
                    first_error(VerificationErrorFirst::fixed_array_span_cannot_carry_another_origin_kind))
                    || !loan_access(w, s, capability.origin(), read_mode(mode))) {
                    return false;
                }
                if (capability.origin() == 0) {
                    const bool condition_310 = control.has_receiver() && !receiver_constructor(m, w.callable())
                        && capability.origin_site() == 0;
                    if (!require(w, condition_310,
                        first_error(VerificationErrorFirst::fixed_array_span_receiver_lifetime_is_not_active))) {
                        return false;
                    }
                } else {
                    const FactRow object = w.fact_find(FactKind::object, capability.origin(), -1);
                    if (!require(w, present(object) && object.site() == capability.origin_site(),
                        first_error(VerificationErrorFirst::fixed_array_span_object_lifetime_is_not_active))) {
                        return false;
                    }
                }
                i64 nominal = control.receiver_class();
                if (capability.origin() != 0) {
                    nominal = slot_class(m, exact_slot(m, w.callable(), 11, capability.origin()));
                }
                const i64 field_index = class_field(m, nominal, capability.array_field());
                const compiler_ir_metadata::FieldRow field = m.field_at(field_index);
                const compiler_ir_metadata::RawTypeRow element = m.type_at(field.type());
                if (!require(w, field_index >= 0 && field.array_flag() != 0 && compiler_ir_metadata::plain_type(element,
                    10), first_error(VerificationErrorFirst::fixed_array_span_field_provenance_mismatch))) {
                    return false;
                }
            } else {
                if (token.kind() != TokenKind::none) {
                    if (!loan_access(w, s, capability.origin(), read_mode(mode)) || !require(w, capability.origin_kind()
                        != SpanOrigin::parameter,
                        first_error(VerificationErrorFirst::owned_span_cannot_have_parameter_origin))) {
                        return false;
                    }
                    const FactRow owner = span_owner_binding(w, capability);
                    if (capability.owned_field() == -1) {
                        if (!require(w, present(owner) && owner.site() == capability.origin_site(),
                            first_error(VerificationErrorFirst::span_owned_byte_origin_lifetime_is_not_active))) {
                            return false;
                        }
                    } else {
                        const FactRow object = w.fact_find(FactKind::owned_object, capability.origin(), -1);
                        if (!require(w, present(object) && object.site() == capability.origin_site()
                            && object.disposition() == ByteDisposition::live && present(owner),
                            first_error(VerificationErrorFirst::span_owning_root_lifetime_is_not_active))) {
                            return false;
                        }
                    }
                    const TokenRow owner_token = owner.token();
                    if (!require(w, owner.disposition() == ByteDisposition::live && owner_token.same(token),
                        first_error(VerificationErrorFirst::span_owner_token_is_not_active))) {
                        return false;
                    }
                    if (token.kind() == TokenKind::borrowed) {
                        if (!require(w, capability.origin() == 0 && capability.owned_field() >= 0
                            && control.has_receiver(),
                            first_error(VerificationErrorFirst::span_borrowed_receiver_provenance_mismatch))) {
                            return false;
                        }
                    } else {
                        if (!require(w, control.has_region() && control.region_offset() == token.region_root()
                            && control.region_site() == token.region_site(),
                            first_error(VerificationErrorFirst::span_owner_region_identity_is_not_active))) {
                            return false;
                        }
                    }
                } else {
                    if (capability.origin_kind() == SpanOrigin::parameter) {
                        const compiler_ir_metadata::CallableRow signature = m.callable_at(w.callable());
                        i64 parameter_root = -1;
                        if (capability.origin() >= 0 && capability.origin() < signature.value_parameter_count()) {
                            parameter_root = entry_root(s, w.callable(), capability.origin(), 59);
                        }
                        if (!require(w, parameter_root >= 0,
                            first_error(VerificationErrorFirst::span_parameter_origin_does_not_exist))) {
                            return false;
                        }
                        const FactRow root = w.fact_find(FactKind::span, parameter_root, -1);
                        const SpanPayload origin = root.span();
                        if (!require(w, present(root) && root.site() == capability.origin_site() && origin.origin_kind()
                            == SpanOrigin::parameter && origin.origin() == capability.origin() && origin.origin_site()
                            == capability.origin_site() && origin.parent() == 0,
                            first_error(VerificationErrorFirst::span_parameter_origin_lifetime_is_not_active))) {
                            return false;
                        }
                    } else {
                        const FactRow array_fact = w.fact_find(FactKind::array_lifetime, capability.origin(), -1);
                        if (!require(w, present(array_fact) && array_fact.site() == capability.origin_site(),
                            first_error(VerificationErrorFirst::span_array_origin_lifetime_is_not_active))) {
                            return false;
                        }
                    }
                }
            }
        }
        if (capability.parent() != 0) {
            const FactRow parent = w.fact_find(FactKind::span, capability.parent(), -1);
            if (!require(w, present(parent) && parent.site() == capability.parent_site(),
                first_error(VerificationErrorFirst::span_direct_parent_lifetime_is_not_active))) {
                return false;
            }
            const SpanPayload origin = parent.span();
            const TokenRow parent_token = parent.token();
            if (!require(w, origin.origin_kind() == capability.origin_kind() && origin.origin() == capability.origin()
                && origin.origin_site() == capability.origin_site() && parent_token.same(token) && origin.owned_field()
                == capability.owned_field() && origin.array_field() == capability.array_field(),
                first_error(VerificationErrorFirst::span_direct_parent_origin_mismatch))) {
                return false;
            }
        }
        return w.good();
    }
    auto span(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 base, AccessMode mode) -> bool {
        const bool condition_385 = exact_slot(m, w.callable(), 13, base) >= 0;
        if (!require(w, condition_385, first_error(VerificationErrorFirst::span_requires_exact_typed_spill))) {
            return false;
        }
        return live_span(w, m, s, base, mode);
    }
    auto inactive_span_target(VerificationWorkspace& w, i64 base) -> bool {
        const bool condition_389 = !has_fact(w, FactKind::span, base, -1);
        return require(w, condition_389, first_error(VerificationErrorFirst::span_spill_is_already_active));
    }
    auto span_target(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 base) -> bool {
        const bool condition_393 = exact_slot(m, w.callable(), 13, base) >= 0;
        if (!require(w, condition_393, first_error(VerificationErrorFirst::span_requires_exact_typed_spill))) {
            return false;
        }
        const bool condition_394 = !entry_contains(s, w.callable(), 59, base);
        if (!require(w, condition_394, first_error(VerificationErrorFirst::span_parameter_cannot_be_rebound))) {
            return false;
        }
        return inactive_span_target(w, base);
    }
    // -2 means the whole root, -1 the standalone owner, >=0 one direct field.
    auto owner_writable(VerificationWorkspace& w, const compiler_ir_instructions::InstructionStore& s, i64 root,
        i64 field, AccessMode mode) -> bool {
        if (!loan_access(w, s, root, write_mode(mode))) {
            return false;
        }
        i64 at = w.first_fact(FactKind::span);
        while (at >= 0 && fact_kind_at(w, at, FactKind::span)) {
            const FactRow row = w.fact_at(at);
            const SpanPayload capability = row.span();
            const TokenRow token = row.token();
            i64 ordinal = capability.owned_field();
            if (capability.array_field() >= 0) {
                ordinal = capability.array_field();
            }
            if (!require(w, (token.kind() == TokenKind::none && capability.array_field() < 0) || capability.origin()
                != root || (field != -2 && ordinal != field),
                first_error(VerificationErrorFirst::owned_byte_or_root_mutation_with_live_readonly_span))) {
                return false;
            }
            at = w.next_fact(at);
        }
        return w.good();
    }
    auto active_region(VerificationWorkspace& w, i64 base) -> bool {
        const ControlRow control = w.control();
        return require(w, control.has_region() && control.region_offset() == base,
            first_error(VerificationErrorFirst::region_authority_is_not_active));
    }
    auto region(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m, i64 base) -> bool {
        const bool condition_420 = exact_slot(m, w.callable(), 15, base) >= 0;
        if (!require(w, condition_420, first_error(VerificationErrorFirst::region_requires_exact_typed_spill))) {
            return false;
        }
        return active_region(w, base);
    }
    auto active_byte_binding(VerificationWorkspace& w, i64 base) -> bool {
        const bool condition_424 = has_fact(w, FactKind::bytes, base, -1);
        return require(w, condition_424, first_error(VerificationErrorFirst::owned_byte_lifetime_is_not_active));
    }
    auto byte_binding(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m, i64 base) -> bool {
        const bool condition_427 = exact_slot(m, w.callable(), 16, base) >= 0;
        if (!require(w, condition_427,
            first_error(VerificationErrorFirst::owned_byte_operation_requires_exact_typed_spill))) {
            return false;
        }
        return active_byte_binding(w, base);
    }
    auto live_bytes(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m, i64 base) -> bool {
        if (!active_byte_binding(w, base)) {
            return false;
        }
        const FactRow binding = w.fact_find(FactKind::bytes, base, -1);
        const TokenRow token = binding.token();
        if (!require(w, binding.disposition() == ByteDisposition::live && token.kind() != TokenKind::none,
            first_error(VerificationErrorFirst::owned_byte_binding_does_not_hold_live_ownership)) || !region(w, m,
            token.region_root())) {
            return false;
        }
        const ControlRow control = w.control();
        return require(w, token.kind() == TokenKind::owned && control.region_site() == token.region_site(),
            first_error(VerificationErrorFirst::owned_byte_region_identity_does_not_match_active_authority));
    }
    auto bytes(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 base, AccessMode mode) -> bool {
        const i64 slot = exact_slot(m, w.callable(), 16, base);
        if (!require(w, slot >= 0, first_error(VerificationErrorFirst::owned_byte_operation_requires_exact_typed_spill))
            || !live_bytes(w, m, base)) {
            return false;
        }
        const compiler_ir_metadata::SlotRow binding = m.slot_at(slot);
        if (!require(w, !writable_mode(mode) || binding.mutable_value() != 0,
            first_error(VerificationErrorFirst::const_owned_byte_binding_cannot_be_mutated_or_moved))) {
            return false;
        }
        if (writable_mode(mode)) {
            return owner_writable(w, s, base, -1, mode);
        }
        return w.good();
    }
    auto pristine_bytes(VerificationWorkspace& w, i64 base) -> bool {
        if (!active_byte_binding(w, base)) {
            return false;
        }
        const FactRow binding = w.fact_find(FactKind::bytes, base, -1);
        const TokenRow token = binding.token();
        return require(w, binding.disposition() == ByteDisposition::pristine && token.kind() == TokenKind::none,
            first_error(VerificationErrorFirst::owned_byte_result_requires_pristine_binding));
    }
    auto byte_target(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m, i64 base) -> bool {
        const bool condition_459 = exact_slot(m, w.callable(), 16, base) >= 0;
        if (!require(w, condition_459,
            first_error(VerificationErrorFirst::owned_byte_operation_requires_exact_typed_spill))) {
            return false;
        }
        return pristine_bytes(w, base);
    }
    auto distinct_token(VerificationWorkspace& w, FactRow binding, i64 ordinal) -> bool {
        const TokenRow token = binding.token();
        const ControlRow control = w.control();
        return require(w, token.kind() == TokenKind::none || token.kind() == TokenKind::borrowed || token.site()
            != control.instruction_id() || token.field_ordinal() != ordinal,
            first_error(VerificationErrorFirst::ownership_creation_site_still_has_a_live_token));
    }
    auto fresh_token(VerificationWorkspace& w, i64 region_root, i64 region_site, i64 ordinal) -> TokenRow {
        i64 at = w.first_fact(FactKind::bytes);
        while (at >= 0 && fact_kind_at(w, at, FactKind::bytes)) {
            const FactRow row = w.fact_at(at);
            if (!distinct_token(w, row, ordinal)) {
                return no_token();
            }
            at = w.next_fact(at);
        }
        at = w.first_fact(FactKind::owned_field);
        while (at >= 0 && fact_kind_at(w, at, FactKind::owned_field)) {
            const FactRow row = w.fact_at(at);
            if (!distinct_token(w, row, ordinal)) {
                return no_token();
            }
            at = w.next_fact(at);
        }
        const ControlRow control = w.control();
        return TokenRow(TokenKind::owned, control.instruction_id(), region_root, region_site, ordinal);
    }
    auto mint_byte_binding(VerificationWorkspace& w, i64 base, i64 region_root, i64 region_site) -> bool {
        const TokenRow token = fresh_token(w, region_root, region_site, -1);
        if (!w.good()) {
            return false;
        }
        FactRow binding = w.fact_find(FactKind::bytes, base, -1);
        binding.set_disposition(ByteDisposition::live);
        binding.set_token(token);
        return w.fact_set(binding);
    }
    auto mint_bytes(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m, i64 base, i64 region_root,
        i64 region_site) -> bool {
        return byte_target(w, m, base) && mint_byte_binding(w, base, region_root, region_site);
    }
    auto consume_byte_binding(VerificationWorkspace& w, i64 base) -> bool {
        FactRow binding = w.fact_find(FactKind::bytes, base, -1);
        binding.set_disposition(ByteDisposition::consumed);
        const TokenRow token = no_token();
        binding.set_token(token);
        return w.fact_set(binding);
    }
    auto consume_bytes(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 base) -> bool {
        return owner_writable(w, s, base, -1, AccessMode::write) && byte_binding(w, m, base) && consume_byte_binding(w,
            base);
    }
    auto store(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 offset) -> bool {
        const i64 object_root = compiler_ir_metadata::object_leaf_root(m, w.callable(), offset);
        const i64 array_root = compiler_ir_metadata::byte_array_element_root(m, w.callable(), offset);
        if (!active_object_field(w, s, object_root)) {
            return false;
        }
        if (object_root >= 0 && !loan_access(w, s, object_root, AccessMode::write)) {
            return false;
        }
        if (!active_array_element(w, array_root) || !array_writable(w, m, offset, object_root, array_root)) {
            return false;
        }
        const i64 prior = compiler_ir_initialization::write_scalar(w, m, offset);
        const bool condition_516 = !entry_contains(s, w.callable(), 45, offset) || !initialization_flag(prior, 2);
        if (!require(w, condition_516, first_error(VerificationErrorFirst::write_to_immutable_scalar_parameter))) {
            return false;
        }
        if (object_root >= 0) {
            const compiler_ir_metadata::SlotRow object = m.slot_at(exact_slot(m, w.callable(), 11, object_root));
            return require(w, object.mutable_value() != 0 || !initialization_flag(prior, 2),
                first_error(VerificationErrorFirst::write_to_initialized_const_object_field));
        }
        return w.good();
    }
    auto receiver_shape(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 ordinal) -> i64 {
        const compiler_ir_metadata::CallableRow signature = m.callable_at(w.callable());
        if (!require(w, signature.borrowed_root_count() == 0,
            first_error(VerificationErrorFirst::borrowed_free_formal_grants_no_direct_receiver_field_authority))
            || !loan_access(w, s, 0, AccessMode::read)) {
            return -1;
        }
        const ControlRow control = w.control();
        if (!require(w, control.has_receiver(),
            first_error(VerificationErrorFirst::receiver_access_without_bound_receiver))) {
            return -1;
        }
        const i64 field = class_field(m, control.receiver_class(), ordinal);
        if (!require(w, field >= 0, first_error(VerificationErrorFirst::receiver_field_type_layout_mismatch))) {
            return -1;
        }
        return field;
    }
    auto receiver_field(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 ordinal, i64 raw_type) -> i64 {
        const i64 index = receiver_shape(w, m, s, ordinal);
        if (!w.good()) {
            return -1;
        }
        const compiler_ir_metadata::FieldRow field = m.field_at(index);
        const compiler_ir_metadata::RawTypeRow type = m.type_at(field.type());
        const TypeKey key = type_key(m, field.type());
        if (!require(w, field.array_flag() == 0 && compiler_ir_metadata::scalar_value(m, type) && same_type_key(m, key,
            raw_type), first_error(VerificationErrorFirst::receiver_field_type_layout_mismatch))) {
            return -1;
        }
        return index;
    }
    auto receiver_array(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 ordinal, bool initialized) -> i64 {
        const i64 index = receiver_shape(w, m, s, ordinal);
        if (!w.good()) {
            return -1;
        }
        const compiler_ir_metadata::FieldRow field = m.field_at(index);
        const compiler_ir_metadata::RawTypeRow type = m.type_at(field.type());
        if (!require(w, field.array_flag() != 0,
            first_error(VerificationErrorFirst::receiver_array_operation_requires_array_field)) || !require(w,
            compiler_ir_metadata::scalar_type(type),
            first_error(VerificationErrorFirst::receiver_scalar_array_operation_requires_scalar_array_field))) {
            return -1;
        }
        if (initialized) {
            const bool condition_557 = !receiver_constructor(m, w.callable());
            if (!require(w, condition_557,
                first_error(VerificationErrorFirst::constructor_cannot_access_receiver_array_during_initialization))) {
                return -1;
            }
            const i64 state = compiler_ir_initialization::receiver_field_state(w, m, ordinal);
            if (!require(w, initialization_flag(state, 1),
                first_error(VerificationErrorFirst::receiver_array_element_not_initialized))) {
                return -1;
            }
        }
        return index;
    }
    auto receiver_evidence(const compiler_ir_metadata::MetadataStore& m, i64 callable, i64 ordinal) -> BoundsEvidence {
        const i64 nominal = receiver_class(m, callable);
        const compiler_ir_metadata::FieldRow field = m.field_at(class_field(m, nominal, ordinal));
        BoundsEvidence evidence = empty_bounds();
        evidence.set_kind(BoundsKind::receiver_array);
        evidence.set_nominal(nominal);
        evidence.set_field(ordinal);
        evidence.set_first_leaf(field.first_leaf());
        evidence.set_length(field.length());
        const TypeKey element_key = type_key(m, field.type());
        evidence.set_element_type(element_key);
        return evidence;
    }
    auto receiver_guard(VerificationWorkspace& w, ValueRow value, BoundsEvidence expected) -> bool {
        const TypeKey type = value.type();
        const BoundsEvidence evidence = value.guard();
        return require(w, plain_key(type, 0) && evidence.same(expected),
            first_error(VerificationErrorFirst::receiver_index_access_lacks_matching_dominating_bounds_token));
    }
    auto initialized_array(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 offset, i64 length, i64 raw_type) -> bool {
        const compiler_ir_metadata::RawTypeRow type = m.type_at(raw_type);
        const i64 width = compiler_ir_metadata::scalar_width(type);
        const i64 first_missing = compiler_ir_initialization::array_first_missing(w, m, offset, length, width);
        i64 element = 0;
        while (element < length) {
            const i64 element_offset = offset - element * width;
            const i64 object_root = compiler_ir_metadata::object_leaf_root(m, w.callable(), element_offset);
            const i64 array_root = compiler_ir_metadata::byte_array_element_root(m, w.callable(), element_offset);
            if (!active_object_field(w, s, object_root) || !active_array_element(w, array_root) || !require(w, element
                != first_missing, first_error(VerificationErrorFirst::array_element_not_initialized))) {
                return false;
            }
            element = element + 1;
        }
        return w.good();
    }
    auto writable_array(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 offset, i64 length, i64 raw_type) -> bool {
        const compiler_ir_metadata::RawTypeRow type = m.type_at(raw_type);
        const i64 width = compiler_ir_metadata::scalar_width(type);
        i64 element = 0;
        while (element < length) {
            const i64 element_offset = offset - element * width;
            const i64 object_root = compiler_ir_metadata::object_leaf_root(m, w.callable(), element_offset);
            const i64 array_root = compiler_ir_metadata::byte_array_element_root(m, w.callable(), element_offset);
            if (!array_writable(w, m, element_offset, object_root, array_root)) {
                return false;
            }
            if (object_root >= 0 && !loan_access(w, s, object_root, AccessMode::write)) {
                return false;
            }
            const bool condition_610 = !entry_contains(s, w.callable(), 45, element_offset);
            if (!require(w, condition_610,
                first_error(VerificationErrorFirst::indexed_write_to_immutable_scalar_parameter))) {
                return false;
            }
            if (object_root >= 0) {
                const compiler_ir_metadata::SlotRow object = m.slot_at(exact_slot(m, w.callable(), 11, object_root));
                if (!require(w, object.mutable_value() != 0,
                    first_error(VerificationErrorFirst::indexed_write_to_const_object_field))) {
                    return false;
                }
            }
            element = element + 1;
        }
        return w.good();
    }
    auto guard(VerificationWorkspace& w, ValueRow value, i64 offset, i64 length, TypeKey element_type) -> bool {
        const TypeKey type = value.type();
        const BoundsEvidence evidence = value.guard();
        BoundsEvidence expected = empty_bounds();
        expected.set_kind(BoundsKind::local_array);
        expected.set_root(offset);
        expected.set_length(length);
        expected.set_element_type(element_type);
        return require(w, plain_key(type, 0) && evidence.same(expected),
            first_error(VerificationErrorFirst::index_access_lacks_matching_dominating_bounds_token));
    }
    auto logical_complete(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        i64 base) -> ObjectCompletion {
        const FactRow object = w.fact_find(FactKind::owned_object, base, -1);
        if (present(object)) {
            if (!require(w, object.disposition() == ByteDisposition::live,
                first_error(VerificationErrorFirst::owning_object_does_not_hold_complete_live_ownership))) {
                return ObjectCompletion::invalid;
            }
            i64 at = w.fact_lower_bound(FactKind::owned_field, base, -1);
            while (at >= 0 && fact_key_at(w, at, FactKind::owned_field, base)) {
                const FactRow field = w.fact_at(at);
                const TokenRow token = field.token();
                bool live = field.disposition() == ByteDisposition::live && token.kind() == TokenKind::owned;
                if (live) {
                    if (!region(w, m, token.region_root())) {
                        return ObjectCompletion::invalid;
                    }
                    const ControlRow control = w.control();
                    live = control.region_site() == token.region_site();
                }
                if (!require(w, live,
                    first_error(VerificationErrorFirst::owning_object_field_lacks_live_region_ownership))) {
                    return ObjectCompletion::invalid;
                }
                at = w.next_fact(at);
            }
        }
        const ObjectCompletion completion = compiler_ir_initialization::object_completion(w, m, base);
        if (!require(w, completion != ObjectCompletion::missing_nested,
            first_error(VerificationErrorFirst::nested_class_field_not_completely_initialized)) || !require(w,
            completion != ObjectCompletion::missing_empty,
            first_error(VerificationErrorFirst::empty_object_not_completely_initialized))) {
            return ObjectCompletion::invalid;
        }
        return completion;
    }
    auto argument_lifetime_error(ArgumentRole role) -> VerificationError {
        if (role == ArgumentRole::aggregate) {
            return first_error(VerificationErrorFirst::aggregate_argument_outside_active_object_lifetime);
        }
        if (role == ArgumentRole::resource) {
            return first_error(VerificationErrorFirst::resource_argument_outside_active_object_lifetime);
        }
        if (role == ArgumentRole::method) {
            return first_error(VerificationErrorFirst::method_argument_outside_active_object_lifetime);
        }
        if (role == ArgumentRole::borrowed) {
            return first_error(VerificationErrorFirst::borrowed_argument_outside_active_object_lifetime);
        }
        return first_error(VerificationErrorFirst::service_argument_outside_active_object_lifetime);
    }
    auto argument_initialization_error(ArgumentRole role) -> VerificationError {
        if (role == ArgumentRole::aggregate) {
            return first_error(VerificationErrorFirst::aggregate_argument_object_not_fully_initialized);
        }
        if (role == ArgumentRole::resource) {
            return first_error(VerificationErrorFirst::resource_argument_object_not_fully_initialized);
        }
        if (role == ArgumentRole::method) {
            return first_error(VerificationErrorFirst::method_argument_object_not_fully_initialized);
        }
        if (role == ArgumentRole::borrowed) {
            return first_error(VerificationErrorFirst::borrowed_argument_object_not_fully_initialized);
        }
        return first_error(VerificationErrorFirst::service_argument_object_not_fully_initialized);
    }
    auto live_copied_argument(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m, i64 base,
        ArgumentRole role) -> bool {
        const bool condition_672 = has_fact(w, FactKind::object, base, -1);
        if (!require(w, condition_672, argument_lifetime_error(role))) {
            return false;
        }
        const i64 initialized = compiler_ir_initialization::object_initialized(w, m, base);
        if (!require(w, initialized == 1, argument_initialization_error(role))) {
            return false;
        }
        logical_complete(w, m, base);
        return w.good();
    }
    auto initialized_object(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m, i64 base) -> i64 {
        const bool condition_679 = has_fact(w, FactKind::object, base, -1);
        if (!require(w, condition_679, first_error(VerificationErrorFirst::copy_object_outside_active_lifetime))) {
            return -1;
        }
        const i64 object = exact_slot(m, w.callable(), 11, base);
        const i64 initialized = compiler_ir_initialization::object_initialized(w, m, base);
        if (!require(w, initialized == 1,
            first_error(VerificationErrorFirst::copy_source_object_not_fully_initialized))) {
            return -1;
        }
        logical_complete(w, m, base);
        if (!w.good()) {
            return -1;
        }
        return object;
    }
    auto live_object(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 base, AccessMode mode) -> i64 {
        if (!loan_access(w, s, base, read_mode(mode))) {
            return -1;
        }
        return initialized_object(w, m, base);
    }
    auto complete_object(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 base, AccessMode mode) -> i64 {
        if (!loan_access(w, s, base, read_mode(mode))) {
            return -1;
        }
        const bool condition_694 = exact_slot(m, w.callable(), 11, base) >= 0;
        if (!require(w, condition_694, first_error(VerificationErrorFirst::copy_requires_exact_object_slot))) {
            return -1;
        }
        return initialized_object(w, m, base);
    }
    auto live_owned_root(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m, i64 root) -> bool {
        const FactRow object = w.fact_find(FactKind::owned_object, root, -1);
        if (!require(w, present(object), first_error(VerificationErrorFirst::object_loan_requires_exact_owning_root))
            || !require(w, object.disposition() == ByteDisposition::live,
            first_error(VerificationErrorFirst::object_loan_requires_complete_live_root))) {
            return false;
        }
        i64 at = w.fact_lower_bound(FactKind::owned_field, root, -1);
        while (at >= 0 && fact_key_at(w, at, FactKind::owned_field, root)) {
            const FactRow field = w.fact_at(at);
            const TokenRow token = field.token();
            if (!require(w, field.disposition() == ByteDisposition::live && token.kind() != TokenKind::none
                && token.field_ordinal() == field.field(),
                first_error(VerificationErrorFirst::object_loan_field_lacks_live_ownership))) {
                return false;
            }
            if (root <= 0) {
                if (!require(w, token.kind() == TokenKind::borrowed && token.region_root() == root
                    && token.region_site() == 0,
                    first_error(VerificationErrorFirst::borrowed_root_field_provenance_mismatch))) {
                    return false;
                }
            } else {
                bool live = token.kind() != TokenKind::borrowed;
                if (live) {
                    if (!region(w, m, token.region_root())) {
                        return false;
                    }
                    const ControlRow control = w.control();
                    live = control.region_site() == token.region_site();
                }
                if (!require(w, live, first_error(VerificationErrorFirst::object_loan_field_region_is_not_active))) {
                    return false;
                }
            }
            at = w.next_fact(at);
        }
        return w.good();
    }
    // Returns the actual complete-object lifetime site, never an ownership
    // token. Bound plain roots are initialized by the trusted borrowed entry;
    // local roots prove exact slots and complete logical/physical initialization.
    auto plain_root_site(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m, i64 root,
        i64 nominal) -> i64 {
        if (!require(w, compiler_ir_metadata::plain_borrowed_class(m, nominal),
            first_error(VerificationErrorFirst::invalid_borrowed_object_root))) {
            return -1;
        }
        if (root <= 0) {
            const bool live = root == 0 && has_bound_root(w, root) && has_fact(w, FactKind::bound_plain_root, root, -1);
            if (!require(w, live, first_error(VerificationErrorFirst::object_loan_requires_complete_live_root))) {
                return -1;
            }
            return 0;
        }
        const i64 slot = initialized_object(w, m, root);
        if (!w.good() || !require(w, slot_class(m, slot) == nominal,
            first_error(VerificationErrorFirst::invalid_borrowed_object_root))) {
            return -1;
        }
        const FactRow object = w.fact_find(FactKind::object, root, -1);
        return object.site();
    }
    auto live_owning_root(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 root, AccessMode mode) -> bool {
        const bool condition_727 = root > 0 || has_bound_root(w, root);
        if (!require(w, condition_727, first_error(VerificationErrorFirst::invalid_borrowed_object_root))) {
            return false;
        }
        i64 nominal = -1;
        if (root <= 0) {
            nominal = bound_root_class(w, m, root);
        } else {
            nominal = slot_class(m, complete_object(w, m, s, root, mode));
        }
        if (!w.good() || !require(w, compiler_ir_metadata::owning_class(m, nominal),
            first_error(VerificationErrorFirst::object_loan_requires_exact_owning_root))) {
            return false;
        }
        return live_owned_root(w, m, root);
    }
    auto initialized_receiver_class_field(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        i64 ordinal) -> bool {
        const i64 state = compiler_ir_initialization::receiver_field_state(w, m, ordinal);
        return require(w, initialization_flag(state, 4),
            first_error(VerificationErrorFirst::receiver_nested_class_field_not_initialized));
    }
    auto live_class_field(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 base, i64 ordinal, AccessMode mode) -> bool {
        if (!loan_access(w, s, base, mode)) {
            return false;
        }
        if (base == 0) {
            return initialized_receiver_class_field(w, m, ordinal);
        }
        live_object(w, m, s, base, mode);
        return w.good();
    }
    auto complete_class_field(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 base, i64 ordinal, AccessMode mode) -> i64 {
        if (!loan_access(w, s, base, mode) || !require(w, base >= 0,
            first_error(VerificationErrorFirst::invalid_owned_field_root_offset))) {
            return -1;
        }
        i64 index = -1;
        if (base == 0) {
            index = receiver_shape(w, m, s, ordinal);
            if (!w.good()) {
                return -1;
            }
            const bool condition_753 = !receiver_constructor(m, w.callable());
            if (!require(w, condition_753,
                first_error(VerificationErrorFirst::constructor_cannot_access_owned_field_during_initialization))) {
                return -1;
            }
            const bool condition_755 = !writable_mode(mode) || receiver_mutable(m, w.callable());
            if (!require(w, condition_755,
                first_error(VerificationErrorFirst::const_receiver_cannot_supply_mutable_owned_field))) {
                return -1;
            }
            if (!initialized_receiver_class_field(w, m, ordinal)) {
                return -1;
            }
        } else {
            const i64 slot = complete_object(w, m, s, base, mode);
            if (!w.good()) {
                return -1;
            }
            const compiler_ir_metadata::SlotRow root = m.slot_at(slot);
            if (!require(w, !writable_mode(mode) || root.mutable_value() != 0,
                first_error(VerificationErrorFirst::const_object_cannot_supply_mutable_owned_field))) {
                return -1;
            }
            index = class_field(m, slot_class(m, slot), ordinal);
            if (!require(w, index >= 0, first_error(VerificationErrorFirst::owned_field_logical_index_out_of_range))) {
                return -1;
            }
        }
        const compiler_ir_metadata::FieldRow field = m.field_at(index);
        const compiler_ir_metadata::RawTypeRow type = m.type_at(field.type());
        if (!require(w, field.array_flag() == 0 && type.kind() == 5,
            first_error(VerificationErrorFirst::owned_field_operation_requires_class_field))) {
            return -1;
        }
        return index;
    }
    auto complete_class_array(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 base, i64 ordinal, AccessMode mode) -> i64 {
        if (!require(w, base >= 0, first_error(VerificationErrorFirst::invalid_class_array_root_offset))
            || !loan_access(w, s, base, mode)) {
            return -1;
        }
        i64 index = -1;
        if (base == 0) {
            index = receiver_shape(w, m, s, ordinal);
            if (!w.good()) {
                return -1;
            }
            const bool condition_780 = !receiver_constructor(m, w.callable());
            if (!require(w, condition_780,
                first_error(VerificationErrorFirst::constructor_cannot_access_class_array_during_initialization))) {
                return -1;
            }
            const bool condition_782 = !writable_mode(mode) || receiver_mutable(m, w.callable());
            if (!require(w, condition_782,
                first_error(VerificationErrorFirst::const_receiver_cannot_supply_mutable_class_array))) {
                return -1;
            }
            const i64 state = compiler_ir_initialization::receiver_field_state(w, m, ordinal);
            if (!require(w, initialization_flag(state, 4),
                first_error(VerificationErrorFirst::receiver_class_array_not_completely_initialized))) {
                return -1;
            }
        } else {
            const i64 slot = complete_object(w, m, s, base, mode);
            if (!w.good()) {
                return -1;
            }
            const compiler_ir_metadata::SlotRow root = m.slot_at(slot);
            if (!require(w, !writable_mode(mode) || root.mutable_value() != 0,
                first_error(VerificationErrorFirst::const_object_cannot_supply_mutable_class_array))) {
                return -1;
            }
            index = class_field(m, slot_class(m, slot), ordinal);
            if (!require(w, index >= 0,
                first_error(VerificationErrorFirst::class_array_logical_field_index_out_of_range))) {
                return -1;
            }
        }
        const compiler_ir_metadata::FieldRow field = m.field_at(index);
        const compiler_ir_metadata::RawTypeRow type = m.type_at(field.type());
        if (!require(w, field.array_flag() != 0 && type.kind() == 5,
            first_error(VerificationErrorFirst::class_array_operation_requires_class_array_field)) || !require(w,
            !compiler_ir_metadata::owning_class(m, named_class(m, type)),
            first_error(VerificationErrorFirst::class_array_elements_must_be_copied_values))) {
            return -1;
        }
        return index;
    }
    auto class_array_evidence(const compiler_ir_metadata::MetadataStore& m, i64 callable, i64 base,
        i64 ordinal) -> BoundsEvidence {
        i64 nominal = receiver_class(m, callable);
        if (base != 0) {
            nominal = slot_class(m, exact_slot(m, callable, 11, base));
        }
        const compiler_ir_metadata::FieldRow field = m.field_at(class_field(m, nominal, ordinal));
        BoundsEvidence evidence = empty_bounds();
        evidence.set_kind(BoundsKind::class_array);
        evidence.set_root(base);
        evidence.set_nominal(nominal);
        evidence.set_field(ordinal);
        const TypeKey element_key = type_key(m, field.type());
        evidence.set_element_type(element_key);
        evidence.set_element_count(field.element_count());
        return evidence;
    }
    auto checked_class_array(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m, i64 base,
        i64 ordinal) -> bool {
        const TypeKey key = TypeKey(0, -1);
        const ValueRow value = current(w, key);
        if (!w.good()) {
            return false;
        }
        const BoundsEvidence evidence = value.guard();
        const BoundsEvidence expected = class_array_evidence(m, w.callable(), base, ordinal);
        return require(w, evidence.same(expected),
            first_error(VerificationErrorFirst::class_array_access_lacks_matching_dominating_bounds_token));
    }
    auto initialize_object(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m, i64 base) -> bool {
        const i64 constructed = compiler_ir_initialization::object_was_constructed(w, m, base);
        if (!require(w, constructed == 0,
            first_error(VerificationErrorFirst::copy_result_object_already_initialized))) {
            return false;
        }
        const i64 pristine = compiler_ir_initialization::object_pristine(w, m, base);
        if (!require(w, pristine == 1, first_error(VerificationErrorFirst::copy_requires_pristine_result_object))) {
            return false;
        }
        const FactRow object = w.fact_find(FactKind::owned_object, base, -1);
        if (present(object)) {
            if (!require(w, object.disposition() == ByteDisposition::pristine,
                first_error(VerificationErrorFirst::owning_object_result_requires_pristine_root))) {
                return false;
            }
            i64 at = w.fact_lower_bound(FactKind::owned_field, base, -1);
            while (at >= 0 && fact_key_at(w, at, FactKind::owned_field, base)) {
                const FactRow field = w.fact_at(at);
                const TokenRow token = field.token();
                if (!require(w, field.disposition() == ByteDisposition::pristine && token.kind() == TokenKind::none,
                    first_error(VerificationErrorFirst::owning_object_result_requires_pristine_fields))) {
                    return false;
                }
                at = w.next_fact(at);
            }
        }
        return compiler_ir_initialization::mark_object(w, m, base);
    }
    auto copy_target(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m, i64 base,
        i64 nominal) -> bool {
        const i64 slot = exact_slot(m, w.callable(), 11, base);
        if (!require(w, slot >= 0, first_error(VerificationErrorFirst::copy_requires_exact_object_slot))) {
            return false;
        }
        const bool condition_851 = has_fact(w, FactKind::object, base, -1);
        if (!require(w, condition_851, first_error(VerificationErrorFirst::copy_object_outside_active_lifetime))) {
            return false;
        }
        if (!require(w, slot_class(m, slot) == nominal,
            first_error(VerificationErrorFirst::copy_nominal_class_mismatch))) {
            return false;
        }
        return initialize_object(w, m, base);
    }
    auto live_copy_target(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m, i64 base) -> bool {
        const bool condition_856 = has_fact(w, FactKind::object, base, -1);
        if (!require(w, condition_856, first_error(VerificationErrorFirst::copy_object_outside_active_lifetime))) {
            return false;
        }
        return initialize_object(w, m, base);
    }
    auto begin_owned_object(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m, i64 base,
        i64 nominal) -> bool {
        const bool condition_861 = !has_fact(w, FactKind::owned_object, base, -1);
        if (!require(w, condition_861, first_error(VerificationErrorFirst::owning_object_lifetime_already_active))) {
            return false;
        }
        const ControlRow control = w.control();
        const TokenRow token = no_token();
        const FactRow object = semantic_fact(FactKind::owned_object, base, -1, control.instruction_id(),
            ByteDisposition::pristine, token);
        if (!w.fact_set(object)) {
            return false;
        }
        const compiler_ir_metadata::ClassResultRow result = m.result_at(nominal);
        const compiler_ir_metadata::IndexRange fields = result.fields();
        i64 ordinal = 0;
        while (ordinal < fields.count()) {
            const compiler_ir_metadata::FieldRow field = m.field_at(fields.begin() + ordinal);
            const compiler_ir_metadata::RawTypeRow type = m.type_at(field.type());
            if (compiler_ir_metadata::owner_kind(type)) {
                const FactRow binding = semantic_fact(FactKind::owned_field, base, ordinal, control.instruction_id(),
                    ByteDisposition::pristine, token);
                if (!w.fact_set(binding)) {
                    return false;
                }
            }
            ordinal = ordinal + 1;
        }
        return w.good();
    }
    auto mint_object_fields(VerificationWorkspace& w, i64 base, i64 region_root, i64 region_site) -> bool {
        i64 at = w.fact_lower_bound(FactKind::owned_field, base, -1);
        while (at >= 0 && fact_key_at(w, at, FactKind::owned_field, base)) {
            FactRow field = w.fact_at(at);
            const TokenRow token = fresh_token(w, region_root, region_site, field.field());
            if (!w.good()) {
                return false;
            }
            field.set_token(token);
            field.set_disposition(ByteDisposition::live);
            if (!w.fact_set(field)) {
                return false;
            }
            at = w.next_fact(at);
        }
        FactRow object = w.fact_find(FactKind::owned_object, base, -1);
        object.set_disposition(ByteDisposition::live);
        return w.fact_set(object);
    }
    auto mint_live_object(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m, i64 base,
        i64 region_root, i64 region_site) -> bool {
        return live_copy_target(w, m, base) && mint_object_fields(w, base, region_root, region_site);
    }
    auto consume_object(VerificationWorkspace& w, const compiler_ir_instructions::InstructionStore& s,
        i64 base) -> bool {
        if (!owner_writable(w, s, base, -2, AccessMode::write)) {
            return false;
        }
        FactRow object = w.fact_find(FactKind::owned_object, base, -1);
        object.set_disposition(ByteDisposition::consumed);
        if (!w.fact_set(object)) {
            return false;
        }
        i64 at = w.fact_lower_bound(FactKind::owned_field, base, -1);
        while (at >= 0 && fact_key_at(w, at, FactKind::owned_field, base)) {
            FactRow field = w.fact_at(at);
            field.set_disposition(ByteDisposition::consumed);
            const TokenRow token = no_token();
            field.set_token(token);
            if (!w.fact_set(field)) {
                return false;
            }
            at = w.next_fact(at);
        }
        return w.good();
    }
    auto owned_object_region(VerificationWorkspace& w, const compiler_ir_instructions::InstructionStore& s, i64 base,
        AccessMode mode) -> bool {
        if (writable_mode(mode) && !owner_writable(w, s, base, -2, mode)) {
            return false;
        }
        TokenKind origin_kind = TokenKind::none;
        i64 origin_root = 0;
        i64 origin_site = 0;
        i64 at = w.fact_lower_bound(FactKind::owned_field, base, -1);
        while (at >= 0 && fact_key_at(w, at, FactKind::owned_field, base)) {
            const FactRow field = w.fact_at(at);
            const TokenRow token = field.token();
            if (!require(w, token.kind() != TokenKind::none,
                first_error(VerificationErrorFirst::owning_object_field_missing_token))) {
                return false;
            }
            if (origin_kind != TokenKind::none) {
                if (!require(w, origin_kind == token.kind() && origin_root == token.region_root() && origin_site
                    == token.region_site(),
                    first_error(VerificationErrorFirst::owning_object_fields_have_different_regions))) {
                    return false;
                }
            } else {
                origin_kind = token.kind();
                origin_root = token.region_root();
                origin_site = token.region_site();
            }
            at = w.next_fact(at);
        }
        return require(w, origin_kind != TokenKind::none,
            first_error(VerificationErrorFirst::owning_object_has_no_resource_fields));
    }
    auto owned_object_token(VerificationWorkspace& w, i64 base) -> TokenRow {
        const i64 at = w.fact_lower_bound(FactKind::owned_field, base, -1);
        if (at < 0) {
            return no_token();
        }
        const FactRow field = w.fact_at(at);
        if (field.kind() != FactKind::owned_field || field.key() != base) {
            return no_token();
        }
        return field.token();
    }
    auto owned_object(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 base, i64 nominal, AccessMode mode) -> bool {
        const i64 index = complete_object(w, m, s, base, mode);
        if (!w.good()) {
            return false;
        }
        const compiler_ir_metadata::SlotRow slot = m.slot_at(index);
        return require(w, slot_class(m, index) == nominal && compiler_ir_metadata::owning_class(m, nominal),
            first_error(VerificationErrorFirst::owning_object_nominal_class_mismatch)) && require(w,
            !writable_mode(mode) || slot.mutable_value() != 0,
            first_error(VerificationErrorFirst::const_owning_object_cannot_be_moved_or_mutated))
            && owned_object_region(w, s, base, mode);
    }
    auto live_resource_field(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 base, i64 ordinal, AccessMode mode) -> bool {
        const FactRow object = w.fact_find(FactKind::owned_object, base, -1);
        if (!require(w, present(object), first_error(VerificationErrorFirst::resource_field_requires_owning_root))) {
            return false;
        }
        const FactRow field = w.fact_find(FactKind::owned_field, base, ordinal);
        if (!require(w, object.disposition() == ByteDisposition::live && present(field),
            first_error(VerificationErrorFirst::resource_field_root_is_not_complete_and_live))) {
            return false;
        }
        const TokenRow token = field.token();
        if (!require(w, field.disposition() == ByteDisposition::live && token.kind() != TokenKind::none,
            first_error(VerificationErrorFirst::resource_field_does_not_hold_live_ownership))) {
            return false;
        }
        if (base == 0) {
            if (!require(w, token.kind() == TokenKind::borrowed,
                first_error(VerificationErrorFirst::borrowed_receiver_provenance_mismatch))) {
                return false;
            }
        } else {
            bool active = token.kind() != TokenKind::borrowed;
            if (active) {
                if (!region(w, m, token.region_root())) {
                    return false;
                }
                const ControlRow control = w.control();
                active = control.region_site() == token.region_site();
            }
            if (!require(w, active, first_error(VerificationErrorFirst::resource_field_region_is_not_active))) {
                return false;
            }
        }
        if (writable_mode(mode)) {
            return owner_writable(w, s, base, ordinal, mode);
        }
        return w.good();
    }
    auto access_bytes(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 base, i64 ordinal, AccessMode mode) -> bool {
        if (!loan_access(w, s, base, mode) || !require(w, ordinal >= -1,
            first_error(VerificationErrorFirst::invalid_owned_byte_field_selector))) {
            return false;
        }
        if (ordinal == -1) {
            if (base == 0) {
                const ControlRow control = w.control();
                const FactRow owner = w.fact_find(FactKind::borrowed_owner, 0, -1);
                const TokenRow token = owner.token();
                const TokenRow expected = TokenRow(TokenKind::borrowed, 0, 0, 0, -1);
                if (!require(w, control.builtin_borrowed_owner() && present(owner) && owner.disposition()
                    == ByteDisposition::live && token.same(expected),
                    first_error(VerificationErrorFirst::owner_access_requires_live_bound_builtin_formal))) {
                    return false;
                }
                const compiler_ir_metadata::CallableRow signature = m.callable_at(w.callable());
                if (!require(w, !writable_mode(mode) || signature.borrowed_root_mutable(0),
                    first_error(VerificationErrorFirst::shared_builtin_formal_cannot_supply_mutable_owner_access))) {
                    return false;
                }
                if (writable_mode(mode)) {
                    return owner_writable(w, s, base, -1, mode);
                }
                return w.good();
            }
            return bytes(w, m, s, base, mode);
        }
        if (!require(w, base >= 0, first_error(VerificationErrorFirst::invalid_owned_byte_object_root))) {
            return false;
        }
        if (base == 0) {
            const i64 index = receiver_shape(w, m, s, ordinal);
            if (!w.good()) {
                return false;
            }
            const compiler_ir_metadata::FieldRow field = m.field_at(index);
            const compiler_ir_metadata::RawTypeRow type = m.type_at(field.type());
            if (!require(w, compiler_ir_metadata::owner_kind(type) && field.array_flag() == 0,
                first_error(VerificationErrorFirst::owned_byte_access_requires_direct_resource_field))) {
                return false;
            }
            const bool condition_1009 = !receiver_constructor(m, w.callable());
            if (!require(w, condition_1009,
                first_error(VerificationErrorFirst::constructor_cannot_access_resource_field_during_initialization))) {
                return false;
            }
            const bool condition_1011 = !writable_mode(mode) || receiver_mutable(m, w.callable());
            if (!require(w, condition_1011,
                first_error(VerificationErrorFirst::const_receiver_cannot_mutate_resource_field))) {
                return false;
            }
        } else {
            const i64 index = complete_object(w, m, s, base, mode);
            if (!w.good()) {
                return false;
            }
            const compiler_ir_metadata::SlotRow object = m.slot_at(index);
            if (!require(w, !writable_mode(mode) || object.mutable_value() != 0,
                first_error(VerificationErrorFirst::const_object_cannot_mutate_resource_field))) {
                return false;
            }
            const i64 field_index = class_field(m, slot_class(m, index), ordinal);
            const compiler_ir_metadata::FieldRow field = m.field_at(field_index);
            const compiler_ir_metadata::RawTypeRow type = m.type_at(field.type());
            if (!require(w, field_index >= 0 && compiler_ir_metadata::owner_kind(type) && field.array_flag() == 0,
                first_error(VerificationErrorFirst::owned_byte_access_requires_direct_resource_field))) {
                return false;
            }
        }
        return live_resource_field(w, m, s, base, ordinal, mode);
    }
    auto copied_value(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 base, i64 owner_nominal, i64 root) -> bool {
        if (!require(w, base != root, first_error(VerificationErrorFirst::owned_value_snapshot_aliases_owner_root))) {
            return false;
        }
        const i64 index = complete_object(w, m, s, base, AccessMode::read);
        if (!w.good()) {
            return false;
        }
        const compiler_ir_metadata::SlotRow value = m.slot_at(index);
        if (!require(w, slot_class(m, index) == owner_nominal,
            first_error(VerificationErrorFirst::owned_value_snapshot_nominal_class_mismatch)) || !require(w,
            value.mutable_value() == 0, first_error(VerificationErrorFirst::owned_value_snapshot_must_be_readonly))) {
            return false;
        }
        const ObjectCompletion completion = compiler_ir_initialization::object_completion(w, m, base);
        return require(w, completion == ObjectCompletion::whole,
            first_error(VerificationErrorFirst::owned_value_snapshot_requires_complete_copied_or_constructed_value));
    }
    auto owner_binding(VerificationWorkspace& w, i64 root, i64 ordinal) -> FactRow {
        if (ordinal >= 0) {
            return w.fact_find(FactKind::owned_field, root, ordinal);
        }
        if (root == 0) {
            return w.fact_find(FactKind::borrowed_owner, 0, -1);
        }
        return w.fact_find(FactKind::bytes, root, -1);
    }
    auto publish_owned_borrow(VerificationWorkspace& w, i64 root, i64 ordinal, i64 result, FactRow binding) -> bool {
        i64 root_site = binding.site();
        if (ordinal != -1) {
            const FactRow object = w.fact_find(FactKind::owned_object, root, -1);
            root_site = object.site();
        }
        const ControlRow control = w.control();
        SpanPayload payload = SpanPayload(SpanOrigin::owned, root, root_site, 0, 0);
        payload.set_owned_field(ordinal);
        const TokenRow token = binding.token();
        FactRow capability = semantic_fact(FactKind::span, result, -1, control.instruction_id(),
            ByteDisposition::pristine, token);
        capability.set_span(payload);
        return w.fact_set(capability);
    }
    auto borrow_owned(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 root, i64 ordinal, i64 result) -> bool {
        if (!access_bytes(w, m, s, root, ordinal, AccessMode::read) || !accessed_owner_type(w, m, root, ordinal)) {
            return false;
        }
        const TypeKey type = owner_key(m, w.callable(), root, ordinal);
        const i64 element = span_class(m, w.callable(), result);
        if (!require(w, element >= 0 || plain_key(type, 13),
            first_error(VerificationErrorFirst::typed_owned_values_cannot_supply_a_byte_span)) || !require(w, element
            < 0 || (type.kind() == 17 && type.nominal() == element), first_error(VerificationErrorFirst::internal))
            || !span_target(w, m, s, result)) {
            return false;
        }
        const FactRow binding = owner_binding(w, root, ordinal);
        return publish_owned_borrow(w, root, ordinal, result, binding);
    }
    auto initialized_receiver_array(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        i64 ordinal) -> bool {
        const i64 state = compiler_ir_initialization::receiver_field_state(w, m, ordinal);
        return require(w, initialization_flag(state, 1),
            first_error(VerificationErrorFirst::receiver_array_span_requires_complete_initialization));
    }
    auto publish_array_borrow(VerificationWorkspace& w, i64 root, i64 ordinal, i64 result, i64 site) -> bool {
        const ControlRow control = w.control();
        SpanPayload payload = SpanPayload(SpanOrigin::array_field, root, site, 0, 0);
        payload.set_array_field(ordinal);
        const TokenRow token = no_token();
        FactRow capability = semantic_fact(FactKind::span, result, -1, control.instruction_id(),
            ByteDisposition::pristine, token);
        capability.set_span(payload);
        return w.fact_set(capability);
    }
    auto borrow_receiver_array_field(VerificationWorkspace& w, const compiler_ir_metadata::MetadataStore& m,
        const compiler_ir_instructions::InstructionStore& s, i64 ordinal, i64 result) -> bool {
        if (!require(w, ordinal >= 0, first_error(VerificationErrorFirst::invalid_fixed_array_span_root_or_field))
            || !loan_access(w, s, 0, AccessMode::read)) {
            return false;
        }
        const i64 index = receiver_shape(w, m, s, ordinal);
        if (!w.good()) {
            return false;
        }
        const bool condition_1086 = !receiver_constructor(m, w.callable());
        if (!require(w, condition_1086,
            first_error(VerificationErrorFirst::constructor_cannot_borrow_receiver_array))) {
            return false;
        }
        if (!initialized_receiver_array(w, m, ordinal)) {
            return false;
        }
        const compiler_ir_metadata::FieldRow field = m.field_at(index);
        const compiler_ir_metadata::RawTypeRow type = m.type_at(field.type());
        if (!require(w, field.array_flag() != 0 && compiler_ir_metadata::plain_type(type, 10),
            first_error(VerificationErrorFirst::fixed_array_span_requires_direct_u8_array_field)) || !span_target(w, m,
            s, result)) {
            return false;
        }
        return publish_array_borrow(w, 0, ordinal, result, 0);
    }
    auto closed_owned_objects(VerificationWorkspace& w) -> bool {
        const i64 first_resource = w.first_fact(FactKind::service_resource);
        if (first_resource >= 0) {
            const FactRow resource = w.fact_at(first_resource);
            if (resource.kind() == FactKind::service_resource) {
                return w.fail(second_error(VerificationErrorSecond::return_with_live_service_resource));
            }
        }
        const bool condition_1095 = w.service_loans_closed() == 1;
        if (!require(w, condition_1095,
            first_error(VerificationErrorFirst::return_with_active_synchronous_service_loan))) {
            return false;
        }
        const i64 first_loan = w.first_fact(FactKind::object_loan);
        if (first_loan >= 0) {
            const FactRow loan = w.fact_at(first_loan);
            if (!require(w, loan.kind() != FactKind::object_loan,
                first_error(VerificationErrorFirst::return_with_active_synchronous_object_loan))) {
                return false;
            }
        }
        i64 at = w.first_fact(FactKind::owned_object);
        while (at >= 0 && fact_kind_at(w, at, FactKind::owned_object)) {
            const FactRow object = w.fact_at(at);
            const bool condition_1104 = has_bound_root(w, object.key());
            if (!require(w, condition_1104,
                first_error(VerificationErrorFirst::return_with_active_owning_object_lifetime))) {
                return false;
            }
            at = w.next_fact(at);
        }
        return w.good();
    }
}
