            return rootValue;
        }
        auto set_root(i64 value) -> bool {
            rootValue = value;
            return true;
        }
        auto root_site() const -> i64 {
            return rootSite;
        }
        auto set_root_site(i64 value) -> bool {
            rootSite = value;
            return true;
        }
        auto type() const -> TypeKey {
            return typeValue;
        }
        auto set_type(TypeKey value) -> bool {
            typeValue = value;
            return true;
        }
        auto mutable_value() const -> bool {
            return mutableValue;
        }
        auto set_mutable_value(bool value) -> bool {
            mutableValue = value;
            return true;
        }
        auto called() const -> bool {
            return calledValue;
        }
        auto set_called(bool value) -> bool {
            calledValue = value;
            return true;
        }
        auto field_index() const -> i64 {
            return fieldIndex;
        }
        auto set_field_index(i64 value) -> bool {
            fieldIndex = value;
            return true;
        }
        auto same(LoanPayload other) const -> bool {
            return rootValue == other.root() && rootSite == other.root_site() && typeValue.same(other.type())
                && mutableValue == other.mutable_value() && calledValue == other.called() && fieldIndex
                == other.field_index();
        }
    };

    class FactRow {
        FactKind kindValue;
        i64 keyValue;
        i64 fieldValue;
        i64 siteValue;
        ByteDisposition dispositionValue;
