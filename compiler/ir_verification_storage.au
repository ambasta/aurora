    auto canonical_token(TokenRow token) -> bool {
        if (token.kind() == TokenKind::none) {
            return token.same(empty_token());
        }
        return token.kind() == TokenKind::owned || token.kind() == TokenKind::borrowed;
    }
    auto canonical_fact(FactRow fact) -> bool {
        const i64 kind = fact_kind_order(fact.kind());
        const TokenRow token = fact.token();
        const SpanPayload span = fact.span();
        const LoanPayload loan = fact.loan();
        const SpanPayload empty_span = SpanPayload(SpanOrigin::local_array, 0, 0, 0, 0);
        const LoanPayload empty_loan = LoanPayload(0, 0, TypeKey(0, -1), false, false, -1);
        if (kind <= 0 || !canonical_token(token)) {
            return false;
        }
        if (fact.kind() == FactKind::owned_field) {
            if (fact.field() < 0) {
                return false;
            }
        } else {
            if (fact.field() != -1) {
                return false;
            }
        }
        if (fact.kind() != FactKind::span && !span.same(empty_span)) {
            return false;
        }
        if (fact.kind() != FactKind::object_loan && !loan.same(empty_loan)) {
            return false;
        }
        if (fact.kind() == FactKind::object || fact.kind() == FactKind::array_lifetime || fact.kind()
            == FactKind::owned_object) {
            if (!token.same(empty_token())) {
                return false;
            }
        }
        if (fact.kind() == FactKind::object || fact.kind() == FactKind::array_lifetime || fact.kind() == FactKind::span
            || fact.kind() == FactKind::object_loan) {
            if (fact.disposition() != ByteDisposition::pristine) {
                return false;
            }
        }
        if (fact.kind() == FactKind::borrowed_owner && fact.key() != 0) {
            return false;
        }
        if (fact.kind() == FactKind::object_loan && fact.site() != 0) {
            return false;
        }
        if (fact.kind() == FactKind::span) {
            if (span.parent() < 0 || (span.parent() == 0 && span.parent_site() != 0)) {
                return false;
            }
            if (span.origin_kind() == SpanOrigin::owned) {
                if (token.kind() == TokenKind::none || span.array_field() != -1) {
                    return false;
                }
            } else {
                if (!token.same(empty_token()) || span.owned_field() != -1) {
                    return false;
                }
                if (span.origin_kind() == SpanOrigin::array_field) {
                    if (span.array_field() < 0) {
                        return false;
                    }
                } else {
                    if (span.array_field() != -1) {
                        return false;
                    }
                    if (span.origin_kind() != SpanOrigin::local_array && span.origin_kind() != SpanOrigin::parameter
                        && span.origin_kind() != SpanOrigin::literal) {
                        return false;
                    }
                }
            }
        }
        return true;
    }
    class VerificationWorkspace {
        builtin::OwnedValues<WordPair> currentWords;
        builtin::OwnedValues<WordPair> retainedWords;
        builtin::OwnedValues<CountPair> retainedCounts;
        builtin::OwnedValues<ServiceLoan> serviceLoans;
        builtin::OwnedValues<ActiveFact> currentFacts;
        builtin::OwnedValues<FactKey> currentKeys;
        builtin::OwnedValues<FactRow> retainedFacts;
        builtin::OwnedValues<ValueRow> currentOperands;
        builtin::OwnedValues<ValueRow> retainedOperands;
        builtin::OwnedValues<CodeStateRow> codeStates;
        builtin::OwnedValues<IndexRow> pendingQueue;
        builtin::OwnedValues<ControlRow> controls;
        i64 callableId;
        i64 scalarBegin;
        i64 objectBegin;
        i64 objectCount;
        i64 receiverBegin;
        i64 receiverCount;
        i64 serviceCapacity;
        i64 factCount;
        i64 wordCount;
        i64 retainedCount;
        i64 retainedCapacity;
        i64 currentMust;
        i64 currentMay;
        InitializationStatus statusValue;
        VerificationStatus verificationStatus;
        VerificationError verificationError;

        auto allocation_failure() -> bool {
            if (statusValue == InitializationStatus::pending || statusValue == InitializationStatus::success) {
                statusValue = InitializationStatus::allocation;
            }
            fail(first_error(VerificationErrorFirst::allocation));
            return false;
        }
        auto valid_retained(i64 id) const -> bool {
            return statusValue == InitializationStatus::success && id >= 0 && id < retainedCount;
        }
        auto service_count(i64 first) const -> i64 {
            i64 count = 0;
            i64 at = 0;
            while (at < serviceCapacity) {
                const ServiceLoan loan = serviceLoans.at(first + at);
                if (loan.id() != 0) {
                    count = count + 1;
                }
                at = at + 1;
            }
            return count;
        }
        auto service_index(i64 id) const -> i64 {
            i64 at = 0;
            while (id > 0 && at < serviceCapacity) {
                const ServiceLoan loan = serviceLoans.at(at);
                if (loan.id() == id) {
                    return at;
                }
                at = at + 1;
            }
            return -1;
        }
        // Preserve the old initialization-only region grant inside the combined
        // workspace. Charge each replacement's final live payload, not its
        // transient allocation peak or an uncommitted retainedCapacity.
        auto initialization_resize_allowed(i64 pool, i64 requested, i64 words) const -> bool {
            if (pool < 0 || pool > 3 || requested < 0 || words < 0) {
                return false;
            }
            // The actual try_resize still validates the owner on this no-op.
            if ((pool == 0 && requested == currentWords.size()) || (pool == 1 && requested == retainedWords.size())
                || (pool == 2 && requested == retainedCounts.size()) || (pool == 3 && requested
                == serviceLoans.size())) {
                return true;
            }
            i64 remaining = 1209026560;
            // At 1148 words the original checked formula reaches its cap.
            // Below it every intermediate is bounded by that same cap.
            if (words < 1148) {
                remaining = 65537 * (16 * words + 64) + 1048576;
            }
            i64 at = 0;
            while (at < 4) {
                i64 count = currentWords.size();
                i64 stride = 16;
                if (at == 1) {
                    count = retainedWords.size();
                }
                if (at == 2) {
                    count = retainedCounts.size();
                }
                if (at == 3) {
                    count = serviceLoans.size();
                    stride = 32;
                }
                if (at == pool) {
                    count = requested;
                }
                if (count < 0 || count > remaining / stride) {
                    return false;
                }
                remaining = remaining - count * stride;
                at = at + 1;
            }
            return true;
        }
        auto grow_retained() -> bool {
            if (statusValue != InitializationStatus::success || retainedCount < 0 || retainedCount > retainedCapacity
                || retainedCapacity < 0 || retainedCapacity > 65536) {
                return reject();
            }
            if (retainedCount < retainedCapacity) {
                return true;
            }
            if (retainedCapacity == 65536) {
                return reject();
            }
            i64 next = 1;
            if (retainedCapacity != 0) {
                next = retainedCapacity * 2;
            }
            if (next > 65536) {
                next = 65536;
            }
            if (wordCount < 0 || (wordCount != 0 && next > 9223372036854775807 / wordCount)) {
                return reject();
            }
            const i64 words = next * wordCount;
            // Both copied rows contain exactly two eight-byte scalar leaves.
            // Generated native layout facts separately pin these widths.
            if (words > 9223372036854775807 / 16 || next > 9223372036854775807 / 16) {
                return reject();
            }
            const WordPair empty_words = WordPair(0u64, 0u64);
            const CountPair empty_counts = CountPair(0, 0);
            // Each replacement preserves its old prefix. A later failure is
            // terminal; the actual, possibly enlarged owners still close normally.
            // With zero slots, the unchanged zero-length word owner never grows.
            if (!initialization_resize_allowed(1, words, wordCount)) {
                return allocation_failure();
            }
            if (!retainedWords.try_resize(words, empty_words)) {
                return allocation_failure();
            }
            if (!initialization_resize_allowed(2, next, wordCount)) {
                return allocation_failure();
            }
            if (!retainedCounts.try_resize(next, empty_counts)) {
                return allocation_failure();
            }
            // The current prefix and every retained row share one bounded pool.
            // Loan IDs are values, never indices or allocation extents.
            if (serviceCapacity != 0) {
                const ServiceLoan empty = ServiceLoan(0, 0, 0, 0);
                const i64 service_rows = (next + 1) * serviceCapacity;
                if (!initialization_resize_allowed(3, service_rows, wordCount)) {
                    return allocation_failure();
                }
                if (!serviceLoans.try_resize(service_rows, empty)) {
                    return allocation_failure();
                }
            }
            retainedCapacity = next;
            return true;
        }
        auto reserve_active_facts(i64 required, i64 limit) -> bool {
            if (required < 0 || required > limit) {
                return fail(first_error(VerificationErrorFirst::internal));
            }
            i64 next = pool_capacity(currentFacts.size(), required, 200);
            if (next > limit) {
                next = limit;
            }
            if (next < 0) {
                return fail(first_error(VerificationErrorFirst::internal));
            }
            if (currentKeys.size() != currentFacts.size()) {
                return fail(first_error(VerificationErrorFirst::internal));
            }
            if (next == currentFacts.size()) {
                return true;
            }
            const ActiveFact fill = ActiveFact(empty_fact());
            if (!currentFacts.try_resize(next, fill)) {
                return allocation_failure();
            }
            const FactKey empty_key = FactKey(FactKind::none, 0, -1);
            if (!currentKeys.try_resize(next, empty_key)) {
                return allocation_failure();
            }
            return true;
        }
        auto reserve_facts(i64 required) -> bool {
            const i64 next = pool_capacity(retainedFacts.size(), required, 192);
            if (next < 0) {
                return fail(first_error(VerificationErrorFirst::internal));
            }
            if (next == retainedFacts.size()) {
                return true;
            }
            const FactRow fill = empty_fact();
            if (!retainedFacts.try_resize(next, fill)) {
                return allocation_failure();
            }
            return true;
        }
        auto reserve_operands(i64 required, bool retained) -> bool {
            i64 old = currentOperands.size();
            if (retained) {
                old = retainedOperands.size();
            }
            const i64 next = pool_capacity(old, required, 88);
            if (next < 0) {
                return fail(first_error(VerificationErrorFirst::internal));
            }
            if (next == old) {
                return true;
            }
            const ValueRow fill = empty_value();
            if (retained) {
                if (!retainedOperands.try_resize(next, fill)) {
                    return allocation_failure();
                }
            } else {
                if (!currentOperands.try_resize(next, fill)) {
                    return allocation_failure();
                }
            }
            return true;
        }
        auto active_fact(i64 index, i64 count) -> ActiveFact {
            if (!good() || controls.size() != 1 || count < 0 || count > currentFacts.size() || index < 0 || index
                >= count) {
                fail(first_error(VerificationErrorFirst::internal));
                return ActiveFact(empty_fact());
            }
            const ActiveFact row = currentFacts.at(index);
            if (row.kind() == FactKind::none) {
                fail(first_error(VerificationErrorFirst::internal));
                return ActiveFact(empty_fact());
            }
            return row;
        }
        auto active_key(i64 index, i64 count) -> FactKey {
            if (!good() || controls.size() != 1 || count < 0 || count > currentKeys.size() || currentKeys.size()
                != currentFacts.size() || index < 0 || index >= count) {
                fail(first_error(VerificationErrorFirst::internal));
                return FactKey(FactKind::none, 0, -1);
            }
            const FactKey row = currentKeys.at(index);
            if (row.kind() == FactKind::none) {
                fail(first_error(VerificationErrorFirst::internal));
                return FactKey(FactKind::none, 0, -1);
            }
            return row;
        }
        auto set_active_fact(i64 index, i64 count, ActiveFact row) -> bool {
            if (!good() || controls.size() != 1 || count < 0 || count > currentFacts.size() || count
                > currentKeys.size() || index < 0 || index >= count || !currentFacts.set(index, row)) {
                return fail(first_error(VerificationErrorFirst::internal));
            }
            const FactKey key = row.key_row();
            if (!currentKeys.set(index, key)) {
                return fail(first_error(VerificationErrorFirst::internal));
            }
            return true;
        }
        // The caller has validated the control owner. A count is an extent,
        // never a cached alias to an element across owner growth.
        auto lower_fact(FactKind kind, i64 key, i64 field, i64 count) -> i64 {
            if (!good() || controls.size() != 1 || count < 0 || count > currentKeys.size() || currentKeys.size()
                != currentFacts.size()) {
                fail(first_error(VerificationErrorFirst::internal));
                return -1;
            }
            i64 begin = 0;
            i64 end = count;
            bool invalid = false;
            // An empty prefix needs no view (and an empty search never probes).
            if (count > 0) {
                const builtin::span<const FactKey> keys = borrow_values(currentKeys);
                while (begin < end && !invalid) {
                    const i64 middle = begin + (end - begin) / 2;
                    const FactKey row = keys.at(middle);
                    if (row.kind() == FactKind::none) {
                        invalid = true;
                    } else {
                        if (row.compare(kind, key, field) > 0) {
                            begin = middle + 1;
                        } else {
                            end = middle;
                        }
                    }
                }
            }
            if (invalid) {
                fail(first_error(VerificationErrorFirst::internal));
                return -1;
            }
            return begin;
        }
        auto find_fact(FactKind kind, i64 key, i64 field, i64 count) -> i64 {
            const i64 at = lower_fact(kind, key, field, count);
            if (at < 0 || at == count) {
                return -1;
            }
            const FactKey row = active_key(at, count);
            if (good() && row.compare(kind, key, field) == 0) {
                return at;
            }
            return -1;
        }
        // Shift first; the operation publishes its updated control count only
        // after all owner writes succeed, exactly as before.
        auto erase_fact(i64 index, i64 count) -> bool {
            const ActiveFact erased = active_fact(index, count);
            if (!good()) {
                return false;
            }
            i64 at = index;
            while (at + 1 < count) {
                const ActiveFact following = active_fact(at + 1, count);
                if (!set_active_fact(at, count, following)) {
                    return false;
                }
                at = at + 1;
            }
            const ActiveFact empty = ActiveFact(empty_fact());
            if (!set_active_fact(count - 1, count, empty)) {
                return false;
            }
            return true;
        }
        auto read_operand(i64 index, i64 count) -> ValueRow {
            if (!good() || index < 0 || index >= count || index >= currentOperands.size()) {
                fail(first_error(VerificationErrorFirst::internal));
                return empty_value();
            }
            return currentOperands.at(index);
        }
        auto write_operand(i64 index, i64 count, ValueRow value) -> bool {
            if (!good() || index < 0 || index >= count || !currentOperands.set(index, value)) {
                return fail(first_error(VerificationErrorFirst::internal));
            }
            return true;
        }
        auto read_code_state(i64 position, i64 count) -> CodeStateRow {
            if (!good() || position < 0 || position >= count || position >= codeStates.size()) {
                fail(first_error(VerificationErrorFirst::internal));
                return empty_code_state();
            }
            return codeStates.at(position);
        }
        auto write_code_state(i64 position, i64 count, CodeStateRow row) -> bool {
            if (!good() || position < 0 || position >= count || !codeStates.set(position, row)) {
                return fail(first_error(VerificationErrorFirst::internal));
            }
            return true;
        }
        auto first_fact_in_count(FactKind kind, i64 count) -> i64 {
            const i64 minimum = -9223372036854775807 - 1;
            const i64 at = lower_fact(kind, minimum, minimum, count);
            if (at < 0 || at == count) {
                return -1;
            }
            const FactKey row = active_key(at, count);
            if (!good() || row.kind() != kind) {
                return -1;
            }
            return at;
        }
        auto next_fact_in_count(i64 index, i64 count) -> i64 {
            const FactKey previous = active_key(index, count);
            if (!good() || index + 1 == count) {
                return -1;
            }
            const FactKey following = active_key(index + 1, count);
            if (!good()) {
                return -1;
            }
            return index + 1;
        }
        auto reverse_queue(i64 initial_begin, i64 initial_end) -> bool {
            i64 begin = initial_begin;
            i64 end = initial_end;
            while (begin < end) {
                end = end - 1;
                if (begin < end) {
                    const IndexRow first = pendingQueue.at(begin);
                    const IndexRow last = pendingQueue.at(end);
                    if (!pendingQueue.set(begin, last) || !pendingQueue.set(end, first)) {
                        return fail(first_error(VerificationErrorFirst::internal));
                    }
                    begin = begin + 1;
                }
            }
            return true;
        }
    public:
        VerificationWorkspace(builtin::ByteRegion region, VerificationError error) : currentWords(word_pool(region)),
            retainedWords(word_pool(region)), retainedCounts(count_pool(region)), serviceLoans(service_pool(region)),
            currentFacts(active_fact_pool(region)), currentKeys(fact_key_pool(region)),
            retainedFacts(fact_pool(region)), currentOperands(value_pool(region)), retainedOperands(value_pool(region)),
            codeStates(code_state_pool(region)), pendingQueue(index_pool(region)), controls(control_pool(region)),
            callableId(-1), scalarBegin(0), objectBegin(0), objectCount(0), receiverBegin(-1), receiverCount(0),
            serviceCapacity(0), factCount(0), wordCount(0), retainedCount(0), retainedCapacity(0), currentMust(0),
            currentMay(0), statusValue(InitializationStatus::pending), verificationStatus(VerificationStatus::pending),
            verificationError(error) {
        }
        auto good() const -> bool {
            return verificationStatus == VerificationStatus::pending || verificationStatus
                == VerificationStatus::success;
        }
        auto verification_status() const -> VerificationStatus {
            return verificationStatus;
        }
        auto verification_error() const -> VerificationError {
            return verificationError;
        }
        auto fail(VerificationError error) -> bool {
            if (good()) {
                if (!error.canonical() || error.empty()) {
                    const VerificationError internal_error = first_error(VerificationErrorFirst::internal);
                    verificationError = internal_error;
                    verificationStatus = VerificationStatus::invalid;
                } else {
                    verificationError = error;
                    verificationStatus = VerificationStatus::invalid;
                    if (error.allocation()) {
                        verificationStatus = VerificationStatus::allocation;
                    }
                }
            }
            return false;
        }
        auto finish() -> VerificationStatus {
            if (good() && statusValue == InitializationStatus::success && controls.size() == 1) {
                verificationStatus = VerificationStatus::success;
            } else {
                fail(first_error(VerificationErrorFirst::internal));
            }
            return verificationStatus;
        }
        auto complete_verification() -> VerificationStatus {
            return finish();
        }
        auto report() const -> VerificationReport {
            const VerificationError error = verificationError;
            if (controls.size() != 1) {
                return VerificationReport(verificationStatus, error, false, MetricsRow());
            }
            const ControlRow c = controls.at(0);
            return VerificationReport(verificationStatus, error, c.metrics_started(), c.metrics());
        }
        auto control() const -> ControlRow {
            if (controls.size() != 1) {
                return empty_control();
            }
            return controls.at(0);
        }
        auto update_control(ControlRow row) -> bool {
            if (!good() || controls.size() != 1 || !controls.set(0, row)) {
                return fail(first_error(VerificationErrorFirst::internal));
            }
            return true;
        }
        auto prepare_verification(i64 code_begin, i64 code_count, i64 fact_limit) -> bool {
            if (!good() || controls.size() != 0 || code_begin < 0 || code_count <= 0 || code_count > 9223372036854775807
                / 152 || code_begin > 9223372036854775807 - code_count || fact_limit < 0 || fact_limit
                > 9223372036854775807 / 200 || statusValue != InitializationStatus::success) {
                return fail(first_error(VerificationErrorFirst::internal));
            }
            ControlRow c = empty_control();
            c.set_code_begin(code_begin);
            c.set_code_count(code_count);
            c.set_dynamic_fact_limit(fact_limit);
            c.set_initialization_payload_per_snapshot(payload_bytes());
            if (!controls.try_resize(1, c)) {
                return allocation_failure();
            }
            const CodeStateRow state = empty_code_state();
            if (!codeStates.try_resize(code_count, state)) {
                return allocation_failure();
            }
            return true;
        }
        auto fact_find(FactKind kind, i64 key, i64 field) -> FactRow {
            const ControlRow c = control();
            const i64 count = c.active_fact_count();
            const i64 at = find_fact(kind, key, field, count);
            if (at < 0 || !good()) {
                return empty_fact();
            }
            const ActiveFact row = active_fact(at, count);
            return row.fact();
        }
        auto fact_at(i64 index) -> FactRow {
            const ControlRow c = control();
            const ActiveFact row = active_fact(index, c.active_fact_count());
            return row.fact();
        }
        auto fact_lower_bound(FactKind kind, i64 key, i64 field) -> i64 {
            const ControlRow c = control();
            const i64 at = lower_fact(kind, key, field, c.active_fact_count());
            if (at < 0 || at == c.active_fact_count()) {
                return -1;
            }
            return at;
        }
        // This range start is independent of signed root values, including -5.
        auto first_fact(FactKind kind) -> i64 {
            const ControlRow c = control();
            return first_fact_in_count(kind, c.active_fact_count());
        }
        // Global inorder successor. A kind-range caller checks the returned kind.
        auto next_fact(i64 index) -> i64 {
            const ControlRow c = control();
            return next_fact_in_count(index, c.active_fact_count());
        }
        auto fact_set(FactRow fact) -> bool {
            if (!good() || controls.size() != 1 || !canonical_fact(fact)) {
                return fail(first_error(VerificationErrorFirst::internal));
            }
            ControlRow c = control();
            const i64 count = c.active_fact_count();
            if (fact.kind() == FactKind::owned_field) {
                const i64 root = find_fact(FactKind::owned_object, fact.key(), -1, count);
                if (!good() || root < 0) {
                    return fail(first_error(VerificationErrorFirst::internal));
                }
            }
            const i64 at = lower_fact(fact.kind(), fact.key(), fact.field(), count);
            if (at < 0) {
                return false;
            }
            if (at < count) {
                const FactKey existing_key = active_key(at, count);
                if (!good()) {
                    return false;
                }
                if (existing_key.compare(fact.kind(), fact.key(), fact.field()) == 0) {
                    ActiveFact existing = active_fact(at, count);
                    if (!good()) {
                        return false;
                    }
                    existing.set_fact(fact);
                    return set_active_fact(at, count, existing);
                }
            }
            if (count == 9223372036854775807) {
                return fail(first_error(VerificationErrorFirst::internal));
            }
            if (!reserve_active_facts(count + 1, c.dynamic_fact_limit())) {
                return false;
            }
            // Allocation succeeds before publication; later owner-write failure
            // is terminal, with the real partially changed owner still released.
            c.set_active_fact_count(count + 1);
            if (!update_control(c)) {
                return false;
            }
            i64 destination = count;
            while (destination > at) {
                const ActiveFact moved = active_fact(destination - 1, count);
                if (!set_active_fact(destination, count + 1, moved)) {
                    return false;
                }
                destination = destination - 1;
            }
            const ActiveFact fresh = ActiveFact(fact);
            return set_active_fact(at, count + 1, fresh);
        }
        auto fact_erase(FactKind kind, i64 key, i64 field) -> bool {
            ControlRow c = control();
            i64 count = c.active_fact_count();
            const i64 found = find_fact(kind, key, field, count);
            if (!good()) {
                return false;
            }
            if (found < 0) {
                return true;
            }
            // Re-search after each erase because compaction changes ordinals.
            // Publish each completed erase before touching the next child.
            if (kind == FactKind::owned_object) {
                bool more = true;
                while (more && good()) {
                    const i64 child = lower_fact(FactKind::owned_field, key, -1, count);
                    if (child < 0 || child == count) {
                        more = false;
                    } else {
                        const ActiveFact row = active_fact(child, count);
                        if (!row.matches_root(FactKind::owned_field, key)) {
                            more = false;
                        } else {
                            if (!erase_fact(child, count)) {
                                return false;
                            }
                            count = count - 1;
                            c.set_active_fact_count(count);
                            if (!update_control(c)) {
                                return false;
                            }
                        }
                    }
                }
            }
            const i64 node = find_fact(kind, key, field, count);
            if (!good() || node < 0) {
                return fail(first_error(VerificationErrorFirst::internal));
            }
            if (!erase_fact(node, count)) {
                return false;
            }
            c.set_active_fact_count(count - 1);
            return update_control(c);
        }
        auto fact_count() const -> i64 {
            const ControlRow c = control();
            return c.active_fact_count();
        }
        auto current_known() const -> bool {
            const ControlRow c = control();
            return c.current_known();
        }
        auto current() const -> ValueRow {
            const ControlRow c = control();
            return c.current();
        }
        auto set_current(ValueRow value) -> bool {
            ControlRow c = control();
            c.set_current(value);
            c.set_current_known(true);
            return update_control(c);
        }
        auto clear_current() -> bool {
            ControlRow c = control();
            c.set_current(empty_value());
            c.set_current_known(false);
            return update_control(c);
        }
        auto operand_count() const -> i64 {
            const ControlRow c = control();
            return c.current_operand_count();
        }
        auto operand_at(i64 index) -> ValueRow {
            const ControlRow c = control();
            return read_operand(index, c.current_operand_count());
        }
        auto set_operand(i64 index, ValueRow value) -> bool {
            const ControlRow c = control();
            return write_operand(index, c.current_operand_count(), value);
        }
        auto push(ValueRow value) -> bool {
            ControlRow c = control();
            if (!good() || c.current_operand_count() < 0 || c.current_operand_count() >= c.code_count()) {
                return fail(first_error(VerificationErrorFirst::internal));
            }
            const i64 next = c.current_operand_count() + 1;
            if (!reserve_operands(next, false) || !currentOperands.set(next - 1, value)) {
                return fail(first_error(VerificationErrorFirst::internal));
            }
            c.set_current_operand_count(next);
            // Native metrics observe post-instruction depth, via observe_depth.
            return update_control(c);
        }
        auto pop() -> ValueRow {
            ControlRow c = control();
            if (!good() || c.current_operand_count() <= 0) {
                fail(first_error(VerificationErrorFirst::value_stack_underflow));
                return empty_value();
            }
            const i64 index = c.current_operand_count() - 1;
            const ValueRow value = read_operand(index, c.current_operand_count());
            if (!good()) {
                return empty_value();
            }
            c.set_current_operand_count(index);
            if (!update_control(c)) {
                return empty_value();
            }
            return value;
        }
        auto code_state(i64 position) -> CodeStateRow {
            const ControlRow c = control();
            return read_code_state(position, c.code_count());
        }
        auto set_code_state(i64 position, CodeStateRow row) -> bool {
            const ControlRow c = control();
            return write_code_state(position, c.code_count(), row);
        }
        auto observe_before(i64 position, i64 instruction) -> bool {
            ControlRow c = control();
            CodeStateRow row = read_code_state(position, c.code_count());
            if (!good() || instruction < 0) {
                return fail(first_error(VerificationErrorFirst::internal));
            }
            c.set_current_position(position);
            c.set_instruction_id(instruction);
            row.set_stack_before(c.current_operand_count());
            return update_control(c) && write_code_state(position, c.code_count(), row);
        }
        auto observe_after(i64 position) -> bool {
            ControlRow c = control();
            CodeStateRow row = read_code_state(position, c.code_count());
            if (!good()) {
                return false;
            }
            row.set_stack_after(c.current_operand_count());
            MetricsRow metrics = c.metrics();
            if (c.current_operand_count() > metrics.peak_operand_depth()) {
                metrics.set_peak_operand_depth(c.current_operand_count());
            }
            c.set_metrics(metrics);
            return update_control(c) && write_code_state(position, c.code_count(), row);
        }
        // Called at the original native reset point, after the entry snapshot
        // and first pending entry exist. Preflight failure keeps earlier metrics.
        auto start_metrics() -> bool {
            ControlRow c = control();
            MetricsRow metrics = MetricsRow();
            metrics.set_snapshots(c.block_snapshot_count());
            metrics.set_peak_retained_operand_facts(c.retained_operand_count());
            metrics.set_peak_retained_value_facts(c.retained_value_facts());
            metrics.set_peak_retained_initialization_payload_bytes(c.retained_initialization_payload());
            c.set_metrics(metrics);
            c.set_metrics_started(true);
            return update_control(c);
        }
        auto retain_state(i64 position) -> bool {
            ControlRow c = control();
            CodeStateRow row = read_code_state(position, c.code_count());
            if (!good() || row.snapshot() != -1) {
                return fail(first_error(VerificationErrorFirst::internal));
            }
            // Neither rejected budget changes any counter or allocates a snapshot.
            if (c.block_snapshot_count() >= 65536) {
                return fail(first_error(VerificationErrorFirst::block_entry_state_retention_limit_exceeds_65536));
            }
            if (c.retained_operand_count() > 262144 || c.current_operand_count() > 262144
                - c.retained_operand_count()) {
                return fail(first_error(VerificationErrorFirst::block_entry_operand_retention_limit_exceeds_262144));
            }
            const i64 next_facts = compiler_ir_metadata::count_sum(c.retained_fact_count(), c.active_fact_count());
            const i64 next_operands = compiler_ir_metadata::count_sum(c.retained_operand_count(),
                c.current_operand_count());
            if (next_facts < 0 || next_operands < 0 || !reserve_facts(next_facts) || !reserve_operands(next_operands,
                true)) {
                return fail(first_error(VerificationErrorFirst::internal));
            }
            const i64 snapshot = retain();
            if (snapshot < 0 || !good()) {
                return fail(first_error(VerificationErrorFirst::internal));
            }
            i64 at = 0;
            while (at < c.active_fact_count()) {
                const ActiveFact active = active_fact(at, c.active_fact_count());
                const FactRow fact = active.fact();
                if (!good() || !retainedFacts.set(c.retained_fact_count() + at, fact)) {
                    return fail(first_error(VerificationErrorFirst::internal));
                }
                at = at + 1;
            }
            at = 0;
            while (at < c.current_operand_count()) {
                const ValueRow value = currentOperands.at(at);
                if (!retainedOperands.set(c.retained_operand_count() + at, value)) {
                    return fail(first_error(VerificationErrorFirst::internal));
                }
                at = at + 1;
            }
            row.set_snapshot(snapshot);
            row.set_fact_begin(c.retained_fact_count());
            row.set_fact_count(c.active_fact_count());
            row.set_operand_begin(c.retained_operand_count());
            row.set_operand_count(c.current_operand_count());
            row.set_current_known(c.current_known());
            row.set_current(c.current());
            const i64 logical = compiler_ir_metadata::count_sum(c.active_fact_count(), c.current_operand_count());
            const i64 total = compiler_ir_metadata::count_sum(logical, retained_count_at(snapshot));
            const i64 retained_total = compiler_ir_metadata::count_sum(c.retained_value_facts(), total);
            const i64 payload = compiler_ir_metadata::count_sum(c.retained_initialization_payload(),
                c.initialization_payload_per_snapshot());
            if (logical < 0 || total < 0 || retained_total < 0 || payload < 0) {
                return fail(first_error(VerificationErrorFirst::internal));
            }
            c.set_retained_fact_count(next_facts);
            c.set_retained_operand_count(next_operands);
            c.set_block_snapshot_count(c.block_snapshot_count() + 1);
            c.set_retained_value_facts(retained_total);
            c.set_retained_initialization_payload(payload);
            MetricsRow metrics = c.metrics();
            metrics.set_snapshots(c.block_snapshot_count());
            metrics.set_peak_retained_operand_facts(next_operands);
            if (retained_total > metrics.peak_retained_value_facts()) {
                metrics.set_peak_retained_value_facts(retained_total);
            }
            if (payload > metrics.peak_retained_initialization_payload_bytes()) {
                metrics.set_peak_retained_initialization_payload_bytes(payload);
            }
            if (c.metrics_started()) {
                c.set_metrics(metrics);
            }
            return write_code_state(position, c.code_count(), row) && update_control(c);
        }
        auto load_state(i64 position) -> bool {
            ControlRow c = control();
            const CodeStateRow row = read_code_state(position, c.code_count());
            if (!good() || row.snapshot() < 0 || row.fact_begin() < 0 || row.fact_count() < 0 || row.fact_begin()
                > c.retained_fact_count() || row.fact_count() > c.retained_fact_count() - row.fact_begin()
                || row.operand_begin() < 0 || row.operand_count() < 0 || row.operand_begin()
                > c.retained_operand_count() || row.operand_count() > c.retained_operand_count()
                - row.operand_begin()) {
                return fail(first_error(VerificationErrorFirst::internal));
            }
            if (!load(row.snapshot()) || !reserve_operands(row.operand_count(), false)) {
                return fail(first_error(VerificationErrorFirst::internal));
            }
            // Every retained fact previously occupied this same active pool.
            // prepare_verification is single-use and reserve_active_facts never shrinks
            // its capacity, so loading a snapshot needs no active allocation.
            if (row.fact_count() > currentFacts.size() || row.fact_count() > currentKeys.size() || row.fact_count()
                > c.dynamic_fact_limit()) {
                return fail(first_error(VerificationErrorFirst::internal));
            }
            i64 at = 0;
            FactKind previous_kind = FactKind::none;
            i64 previous_key = 0;
            i64 previous_field = -1;
            i64 owner_at = -1;
            i64 owner_end = -1;
            while (at < row.fact_count()) {
                const FactRow fact = retainedFacts.at(row.fact_begin() + at);
                if (!canonical_fact(fact) || (at != 0 && compare_fact_key(previous_kind, previous_key, previous_field,
                    fact.kind(), fact.key(), fact.field()) >= 0)) {
                    return fail(first_error(VerificationErrorFirst::internal));
                }
                if (fact.kind() == FactKind::owned_object) {
                    if (owner_at < 0) {
                        owner_at = at;
                    }
                    owner_end = at + 1;
                }
                if (fact.kind() == FactKind::owned_field) {
                    if (owner_at < 0) {
                        return fail(first_error(VerificationErrorFirst::internal));
                    }
                    bool found = false;
                    while (owner_at < owner_end && !found) {
                        const FactRow owner = retainedFacts.at(row.fact_begin() + owner_at);
                        if (owner.key() < fact.key()) {
                            owner_at = owner_at + 1;
                        } else {
                            if (owner.key() != fact.key()) {
                                return fail(first_error(VerificationErrorFirst::internal));
                            }
                            found = true;
                        }
                    }
                    if (!found) {
                        return fail(first_error(VerificationErrorFirst::internal));
                    }
                }
                previous_kind = fact.kind();
                previous_key = fact.key();
                previous_field = fact.field();
                at = at + 1;
            }
            // The retained sequence is canonical. Restore it directly and
            // discard transient visit marks, without allocating another owner.
            c.set_active_fact_count(row.fact_count());
            c.set_current_operand_count(row.operand_count());
            c.set_current_known(row.current_known());
            c.set_current(row.current());
            if (!update_control(c)) {
                return false;
            }
            at = 0;
            while (at < row.fact_count()) {
                const FactRow fact = retainedFacts.at(row.fact_begin() + at);
                const ActiveFact fresh = ActiveFact(fact);
                if (!set_active_fact(at, row.fact_count(), fresh)) {
                    return false;
                }
