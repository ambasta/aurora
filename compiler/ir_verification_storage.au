        SpanPayload spanValue;
        LoanPayload loanValue;
    public:
        FactRow(FactKind kind, i64 key, i64 field, TokenRow token, SpanPayload span,
            LoanPayload loan) : kindValue(kind), keyValue(key), fieldValue(field), siteValue(0),
            dispositionValue(ByteDisposition::pristine), tokenValue(token), spanValue(span), loanValue(loan) {
        }
        auto kind() const -> FactKind {
            return kindValue;
        }
        auto set_kind(FactKind value) -> bool {
            kindValue = value;
            return true;
        }
        auto key() const -> i64 {
            return keyValue;
        }
        auto set_key(i64 value) -> bool {
            keyValue = value;
            return true;
        }
        auto field() const -> i64 {
            return fieldValue;
        }
        auto set_field(i64 value) -> bool {
            fieldValue = value;
            return true;
        }
        auto site() const -> i64 {
            return siteValue;
        }
        auto set_site(i64 value) -> bool {
            siteValue = value;
            return true;
        }
        auto disposition() const -> ByteDisposition {
            return dispositionValue;
        }
        auto set_disposition(ByteDisposition value) -> bool {
            dispositionValue = value;
            return true;
        }
        auto token() const -> TokenRow {
            return tokenValue;
        }
        auto set_token(TokenRow value) -> bool {
            tokenValue = value;
            return true;
        }
        auto span() const -> SpanPayload {
            return spanValue;
        }
        auto set_span(SpanPayload value) -> bool {
            spanValue = value;
            return true;
        }
        auto loan() const -> LoanPayload {
            return loanValue;
        }
        auto set_loan(LoanPayload value) -> bool {
            loanValue = value;
            return true;
        }
        auto same(FactRow other) const -> bool {
            return kindValue == other.kind() && keyValue == other.key() && fieldValue == other.field() && siteValue
                == other.site() && dispositionValue == other.disposition() && tokenValue.same(other.token())
                && spanValue.same(other.span()) && loanValue.same(other.loan());
        }
    };

    // Key-only probes must not materialize the fact's token, span and loan payloads.
    class FactKey {
        FactKind kindValue;
        i64 keyValue;
        i64 fieldValue;
    public:
        FactKey(FactKind kind, i64 key, i64 field) : kindValue(kind), keyValue(key), fieldValue(field) {
        }
        auto kind() const -> FactKind {
            return kindValue;
        }
        auto compare(FactKind kind, i64 key, i64 field) const -> i64 {
            return compare_fact_key(kind, key, field, kindValue, keyValue, fieldValue);
        }
    };

    class ActiveFact {
        FactRow factValue;
        i64 visitEpoch;
    public:
        ActiveFact(FactRow fact) : factValue(fact), visitEpoch(0) {
        }
        auto fact() const -> FactRow {
            return factValue;
        }
        auto key_row() const -> FactKey {
            return FactKey(factValue.kind(), factValue.key(), factValue.field());
        }
        auto kind() const -> FactKind {
            return factValue.kind();
        }
        auto matches_root(FactKind kind, i64 key) const -> bool {
            return factValue.kind() == kind && factValue.key() == key;
        }
        auto set_fact(FactRow value) -> bool {
            factValue = value;
            return true;
        }
        auto visit_epoch() const -> i64 {
            return visitEpoch;
        }
        auto set_visit_epoch(i64 value) -> bool {
            visitEpoch = value;
            return true;
        }
    };

