            i64 parent_site) : originKind(origin_kind), originValue(origin), originSite(origin_site),
            parentValue(parent), parentSite(parent_site), ownedField(-1), arrayField(-1) {
        }
        auto origin_kind() const -> SpanOrigin {
            return originKind;
        }
        auto set_origin_kind(SpanOrigin value) -> bool {
            originKind = value;
            return true;
        }
        auto origin() const -> i64 {
            return originValue;
        }
        auto set_origin(i64 value) -> bool {
            originValue = value;
            return true;
        }
        auto origin_site() const -> i64 {
            return originSite;
        }
        auto set_origin_site(i64 value) -> bool {
            originSite = value;
            return true;
        }
        auto parent() const -> i64 {
            return parentValue;
        }
        auto set_parent(i64 value) -> bool {
            parentValue = value;
            return true;
        }
        auto parent_site() const -> i64 {
            return parentSite;
        }
        auto set_parent_site(i64 value) -> bool {
            parentSite = value;
            return true;
        }
        auto owned_field() const -> i64 {
            return ownedField;
        }
        auto set_owned_field(i64 value) -> bool {
            ownedField = value;
            return true;
        }
        auto array_field() const -> i64 {
            return arrayField;
        }
        auto set_array_field(i64 value) -> bool {
            arrayField = value;
            return true;
        }
        auto same(SpanPayload other) const -> bool {
            return originKind == other.origin_kind() && originValue == other.origin() && originSite
                == other.origin_site() && parentValue == other.parent() && parentSite == other.parent_site()
                && ownedField == other.owned_field() && arrayField == other.array_field();
        }
    };

    class LoanPayload {
        i64 rootValue;
        i64 rootSite;
        TypeKey typeValue;
        bool mutableValue;
        bool calledValue;
        i64 fieldIndex;
    public:
        LoanPayload(i64 root, i64 root_site, TypeKey type, bool mutable_value, bool called,
            i64 field_index) : rootValue(root), rootSite(root_site), typeValue(type), mutableValue(mutable_value),
            calledValue(called), fieldIndex(field_index) {
        }
