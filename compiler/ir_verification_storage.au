            return kindValue;
        }
        auto set_kind(i64 value) -> bool {
            kindValue = value;
            return true;
        }
        auto nominal() const -> i64 {
            return nominalValue;
        }
        auto set_nominal(i64 value) -> bool {
            nominalValue = value;
            return true;
        }
        auto same(TypeKey other) const -> bool {
            return kindValue == other.kind() && nominalValue == other.nominal();
        }
    };

