export module aurora.compiler.ir_verification_storage;
import aurora.compiler.ir_metadata;
import aurora.compiler.ir_metadata_storage;
import aurora.compiler.ir_verification_errors;

// Private production verifier storage/ownership support.
// Typed, flat source-owned verifier state. Copied semantic rows are independent
// of allocation history; the sole owner has eleven direct pool descriptors.
export namespace compiler_ir_verification {
    enum class InitializationStatus {
        pending,
        success,
        allocation,
        invalid
    };
    enum class InitializationJoin {
        error,
        unchanged,
        changed
    };
    enum class ObjectCompletion {
        invalid,
        whole,
        physical,
        missing_nested,
        missing_empty
    };
    enum class ReceiverCompletion {
        invalid,
        complete,
        missing_physical,
        missing_logical
    };
    enum class ServiceCallState {
        invalid,
        ready,
        missing,
        provenance
    };
    class ServiceLoan {
        i64 loanId;
        i64 rootOffset;
        i64 serviceKind;
        i64 calledValue;
    public:
        ServiceLoan(i64 id, i64 root, i64 kind, i64 called) : loanId(id), rootOffset(root), serviceKind(kind),
            calledValue(called) {
        }
        auto id() const -> i64 {
            return loanId;
        }
        auto root() const -> i64 {
            return rootOffset;
        }
        auto kind() const -> i64 {
            return serviceKind;
        }
        auto called() const -> i64 {
            return calledValue;
        }
        auto same(ServiceLoan other) const -> bool {
            return loanId == other.id() && rootOffset == other.root() && serviceKind == other.kind() && calledValue
                == other.called();
        }
    };
    class WordPair {
        u64 mustBits;
        u64 mayBits;
    public:
        WordPair(u64 must, u64 may) : mustBits(must), mayBits(may) {
        }
        auto must_bits() const -> u64 {
            return mustBits;
        }
        auto may_bits() const -> u64 {
            return mayBits;
        }
    };
    class CountPair {
        i64 mustCount;
        i64 mayCount;
    public:
        CountPair(i64 must, i64 may) : mustCount(must), mayCount(may) {
        }
        auto must_count() const -> i64 {
            return mustCount;
        }
        auto may_count() const -> i64 {
            return mayCount;
        }
    };
    auto word_pool(builtin::ByteRegion region) -> builtin::OwnedValues<WordPair> {
        const WordPair fill = WordPair(0u64, 0u64);
        builtin::OwnedValues<WordPair> result = region.try_allocate(0, fill);
        return move(result);
    }
    auto count_pool(builtin::ByteRegion region) -> builtin::OwnedValues<CountPair> {
        const CountPair fill = CountPair(0, 0);
        builtin::OwnedValues<CountPair> result = region.try_allocate(0, fill);
        return move(result);
    }
    auto service_pool(builtin::ByteRegion region) -> builtin::OwnedValues<ServiceLoan> {
        const ServiceLoan fill = ServiceLoan(0, 0, 0, 0);
        builtin::OwnedValues<ServiceLoan> result = region.try_allocate(0, fill);
        return move(result);
    }
    // Iterate changed bits only. Unsigned subtraction is guarded by nonzero,
    // including the isolated high bit; no signed bit-63 conversion is needed.
    auto changed_count(u64 bits) -> i64 {
        u64 remaining = bits;
        i64 count = 0;
        while (remaining != 0u64) {
            remaining = remaining & (remaining - 1u64);
            count = count + 1;
        }
        return count;
    }
    enum class TokenKind {
        none,
        owned,
        borrowed
    };
    enum class SpanOrigin {
        local_array,
        parameter,
        owned,
        literal,
        array_field
    };
    enum class FactKind {
        none,
        object,
        array_lifetime,
        span,
        bytes,
        borrowed_owner,
        owned_object,
        owned_field,
        object_loan
    };
    enum class ByteDisposition {
        pristine,
        live,
        consumed
    };
    enum class BoundsKind {
        none,
        local_array,
        receiver_array,
        class_array
    };
    class TypeKey {
        i64 kindValue;
        i64 nominalValue;
    public:
        TypeKey(i64 kind, i64 nominal) : kindValue(kind), nominalValue(nominal) {
        }
