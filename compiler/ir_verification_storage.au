    class ControlRow {
        bool metricsStarted;
        i64 codeBegin;
        i64 codeCount;
        i64 activeFactCount;
        i64 retainedFactCount;
        i64 currentOperandCount;
        i64 retainedOperandCount;
        i64 pendingHead;
        i64 pendingCount;
        i64 pendingTail;
        i64 pendingEnqueued;
        i64 blockSnapshotCount;
        i64 currentPosition;
        i64 instructionId;
        bool currentKnown;
        ValueRow currentValue;
        i64 regionOffset;
        i64 regionSite;
        bool hasRegion;
        i64 receiverClass;
        bool hasReceiver;
        bool owningConstructor;
        bool builtinBorrowedOwner;
        i64 borrowedRootCount;
        MetricsRow metricsValue;
        i64 retainedValueFacts;
        i64 retainedInitializationPayload;
        i64 initializationPayloadPerSnapshot;
        i64 traversalEpoch;
        i64 dynamicFactLimit;
    public:
        ControlRow(ValueRow current, MetricsRow metrics) : metricsStarted(false), codeBegin(0), codeCount(0),
            activeFactCount(0), retainedFactCount(0), currentOperandCount(0), retainedOperandCount(0), pendingHead(0),
            pendingCount(0), pendingTail(0), pendingEnqueued(0), blockSnapshotCount(0), currentPosition(0),
            instructionId(0), currentKnown(false), currentValue(current), regionOffset(0), regionSite(0),
            hasRegion(false), receiverClass(-1), hasReceiver(false), owningConstructor(false),
            builtinBorrowedOwner(false), borrowedRootCount(0), metricsValue(metrics), retainedValueFacts(0),
            retainedInitializationPayload(0), initializationPayloadPerSnapshot(0), traversalEpoch(0),
            dynamicFactLimit(0) {
