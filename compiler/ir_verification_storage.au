    class VerificationReport {
        VerificationStatus statusValue;
        VerificationError errorValue;
        bool metricsStarted;
        MetricsRow metricsValue;
    public:
        VerificationReport(VerificationStatus status, VerificationError error, bool metrics_started,
            MetricsRow metrics) : statusValue(status), errorValue(error), metricsStarted(metrics_started),
            metricsValue(metrics) {
        }
        auto status() const -> VerificationStatus {
            return statusValue;
        }
        auto set_status(VerificationStatus value) -> bool {
            statusValue = value;
            return true;
        }
        auto error() const -> VerificationError {
            return errorValue;
        }
        auto set_error(VerificationError value) -> bool {
            errorValue = value;
            return true;
        }
        auto metrics_started() const -> bool {
            return metricsStarted;
        }
        auto set_metrics_started(bool value) -> bool {
            metricsStarted = value;
            return true;
        }
        auto metrics() const -> MetricsRow {
            return metricsValue;
        }
        auto set_metrics(MetricsRow value) -> bool {
            metricsValue = value;
            return true;
        }
        auto same(VerificationReport other) const -> bool {
            return statusValue == other.status() && errorValue.same(other.error()) && metricsStarted
                == other.metrics_started() && metricsValue.same(other.metrics());
        }
    };
    auto empty_token() -> TokenRow {
        return TokenRow(TokenKind::none, 0, 0, 0, -1);
    }
    auto empty_bounds() -> BoundsEvidence {
        const TypeKey element = TypeKey(0, -1);
        return BoundsEvidence(element);
    }
    auto empty_value() -> ValueRow {
        const TypeKey type = TypeKey(0, -1);
        const BoundsEvidence guard = empty_bounds();
        return ValueRow(type, guard);
    }
    auto empty_code_state() -> CodeStateRow {
        const ValueRow current = empty_value();
        return CodeStateRow(current);
    }
    auto empty_control() -> ControlRow {
        const ValueRow current = empty_value();
        const MetricsRow metrics = MetricsRow();
        return ControlRow(current, metrics);
    }
