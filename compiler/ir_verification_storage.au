    auto fact_kind_order(FactKind kind) -> i64 {
        if (kind == FactKind::none) {
            return 0;
        }
        if (kind == FactKind::object) {
            return 1;
        }
        if (kind == FactKind::array_lifetime) {
            return 2;
        }
        if (kind == FactKind::span) {
            return 3;
        }
        if (kind == FactKind::bytes) {
            return 4;
        }
        if (kind == FactKind::borrowed_owner) {
            return 5;
        }
        if (kind == FactKind::owned_object) {
            return 6;
        }
        if (kind == FactKind::owned_field) {
            return 7;
        }
        if (kind == FactKind::object_loan) {
            return 8;
        }
        return -1;
    }
    auto compare_fact_key(FactKind kind, i64 key, i64 field, FactKind other_kind, i64 other_key,
        i64 other_field) -> i64 {
        const i64 first = fact_kind_order(kind);
        const i64 second = fact_kind_order(other_kind);
        if (first < second) {
            return -1;
        }
        if (first > second) {
            return 1;
        }
        if (key < other_key) {
            return -1;
        }
        if (key > other_key) {
            return 1;
        }
        if (field < other_field) {
            return -1;
        }
        if (field > other_field) {
            return 1;
        }
        return 0;
    }
    // Capacities are checked byte extents. Semantic admission derives the grant;
    // geometric slack is included there, not an unrelated row-count ceiling.
    auto pool_capacity(i64 old, i64 required, i64 stride) -> i64 {
        if (old < 0 || required < 0 || stride <= 0 || required > 9223372036854775807 / stride) {
            return -1;
        }
        if (required <= old) {
            return old;
        }
        const i64 maximum = 9223372036854775807 / stride;
        i64 next = old;
        if (next == 0) {
            next = 1;
        }
        while (next < required) {
            if (next > maximum / 2) {
                next = maximum;
            } else {
                next = next * 2;
            }
        }
        return next;
    }
    auto active_fact_pool(builtin::ByteRegion region) -> builtin::OwnedValues<ActiveFact> {
        const ActiveFact fill = ActiveFact(empty_fact());
        builtin::OwnedValues<ActiveFact> result = region.try_allocate(0, fill);
        return move(result);
    }
    auto fact_key_pool(builtin::ByteRegion region) -> builtin::OwnedValues<FactKey> {
        const FactKey fill = FactKey(FactKind::none, 0, -1);
        builtin::OwnedValues<FactKey> result = region.try_allocate(0, fill);
        return move(result);
    }
    auto fact_pool(builtin::ByteRegion region) -> builtin::OwnedValues<FactRow> {
        const FactRow fill = empty_fact();
        builtin::OwnedValues<FactRow> result = region.try_allocate(0, fill);
        return move(result);
    }
    auto value_pool(builtin::ByteRegion region) -> builtin::OwnedValues<ValueRow> {
        const ValueRow fill = empty_value();
        builtin::OwnedValues<ValueRow> result = region.try_allocate(0, fill);
        return move(result);
    }
