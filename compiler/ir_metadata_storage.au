    class MetadataStore {
        builtin::OwnedBytes bytes;
        builtin::OwnedValues<RawTypeRow> types;
        builtin::OwnedValues<ClassRow> classes;
        builtin::OwnedValues<FieldRow> fields;
        builtin::OwnedValues<StorageRow> storage;
        builtin::OwnedValues<IndexRow> indices;
        builtin::OwnedValues<DescriptorRow> descriptors;
        builtin::OwnedValues<ViewRow> views;
        builtin::OwnedValues<EnumRow> enums;
        builtin::OwnedValues<CallableRow> callables;
        builtin::OwnedValues<SlotRow> slots;
        builtin::OwnedValues<ClassResultRow> results;
        builtin::OwnedValues<FrameRow> frames;
        // Only appendable pools need their original prefix ends retained.
        // All immutable input counts are their checked allocation lengths.
        i64 inputLeaves;
        i64 inputFields;
        i64 inputStorage;
        i64 inputIndices;
        // Declaration rows precede the occurrence-owned instruction type suffix.
        i64 instructionTypeBegin;
        i64 fieldEnd;
        i64 storageEnd;
        i64 indexEnd;
        i64 frameCount;
        MetadataStatus statusValue;
        MetadataError errorValue;
        bool started;
    public:
        // Empty owners establish region provenance once. A single borrowed
        // initialization then resizes them to exact capacities; copied counts
        // never cross an ordinary region-function boundary.
        MetadataStore(builtin::ByteRegion region) : bytes(region.try_allocate(0)), types(type_pool(region, 0)),
            classes(class_pool(region, 0)), fields(field_pool(region, 0)), storage(storage_pool(region, 0)),
            indices(index_pool(region, 0)), descriptors(descriptor_pool(region, 0)), views(view_pool(region, 0)),
            enums(enum_pool(region, 0)), callables(callable_pool(region, 0)), slots(slot_pool(region, 0)),
            results(result_pool(region, 0)), frames(frame_pool(region)), inputLeaves(0), inputFields(0),
            inputStorage(0), inputIndices(0), instructionTypeBegin(-1), fieldEnd(0), storageEnd(0), indexEnd(0),
            frameCount(0), statusValue(MetadataStatus::pending), errorValue(MetadataError::none), started(false) {
        }
        auto initialize(InputCounts counts, i64 callableCount, i64 slotCount, i64 instructionBegin) -> bool {
            if (started || statusValue != MetadataStatus::pending || instructionTypeBegin != -1) {
                return false;
            }
            if (!valid_counts(counts) || callableCount < 0 || slotCount < 0 || instructionBegin < 0 || instructionBegin
                > counts.type_count() || field_capacity(counts) > instructionBegin) {
                statusValue = MetadataStatus::invalid;
                errorValue = MetadataError::integrity;
                return false;
            }
            inputLeaves = counts.leaf_count();
            inputFields = counts.field_row_count();
            inputStorage = counts.storage_count();
            inputIndices = counts.index_count();
            instructionTypeBegin = instructionBegin;
            fieldEnd = inputFields;
            storageEnd = inputStorage;
            indexEnd = inputIndices;
            // A failed initial owner is terminal, including zero-length owners.
            // Later resize failures retain all successful siblings for cleanup.
            if (!bytes.ok() || !types.ok() || !classes.ok() || !fields.ok() || !storage.ok() || !indices.ok()
                || !descriptors.ok() || !views.ok() || !enums.ok() || !callables.ok() || !slots.ok() || !results.ok()
                || !frames.ok()) {
                statusValue = MetadataStatus::allocation;
                return false;
            }
            const RawTypeRow empty_type = invalid_type();
            const ClassRow empty_class = invalid_class();
            const FieldRow empty_field = invalid_field();
            const StorageRow empty_storage = invalid_storage();
            const IndexRow empty_index = IndexRow(-1);
            const DescriptorRow empty_descriptor = DescriptorRow(-1, -1, -1);
            const ViewRow empty_view = ViewRow(-1, IndexRange(-1, -1));
            const EnumRow empty_enum = EnumRow(ByteRange(-1, -1), -1);
            const CallableRow empty_callable = invalid_callable();
            const SlotRow empty_slot = SlotRow(-1, -1, -1, -1, -1);
            const ClassResultRow empty_result = invalid_result();
            if (!bytes.try_resize(counts.byte_count()) || !types.try_resize(counts.type_count(), empty_type)
                || !classes.try_resize(counts.class_count(), empty_class) || !fields.try_resize(field_capacity(counts),
                empty_field) || !storage.try_resize(storage_capacity(counts), empty_storage)
                || !indices.try_resize(index_capacity(counts), empty_index)
                || !descriptors.try_resize(counts.descriptor_count(), empty_descriptor)
                || !views.try_resize(counts.view_count(), empty_view) || !enums.try_resize(counts.enum_count(),
                empty_enum) || !callables.try_resize(callableCount, empty_callable) || !slots.try_resize(slotCount,
                empty_slot) || !results.try_resize(counts.class_count(), empty_result) || !allocated()) {
                statusValue = MetadataStatus::allocation;
            }
            return statusValue == MetadataStatus::pending;
        }
        auto allocated() const -> bool {
            // Failed resize keeps its old owner valid; the terminal status must
            // prevent that shorter but well-formed prefix from being published.
            if (statusValue == MetadataStatus::allocation || statusValue == MetadataStatus::invalid) {
                return false;
            }
            const i64 field_limit = count_sum(inputFields, inputLeaves);
            const i64 storage_limit = count_sum(inputStorage, classes.size());
            const i64 index_limit = count_sum(count_sum(inputIndices, inputLeaves), field_limit);
            return inputLeaves >= 0 && inputFields >= 0 && inputStorage >= 0 && inputIndices >= 0
                && instructionTypeBegin >= 0 && instructionTypeBegin <= types.size() && field_limit >= 0 && field_limit
                <= instructionTypeBegin && storage_limit >= 0 && index_limit >= 0 && bytes.ok() && types.ok()
                && classes.ok() && fields.ok() && storage.ok() && indices.ok() && descriptors.ok() && views.ok()
                && enums.ok() && callables.ok() && slots.ok() && results.ok() && frames.ok() && fields.size()
                == field_limit && storage.size() == storage_limit && indices.size() == index_limit && results.size()
                == classes.size() && frames.size() == 4;
        }
        auto status() const -> MetadataStatus {
            return statusValue;
        }
        auto error() const -> MetadataError {
            return errorValue;
        }
        // Projection writes only pending raw input prefixes. Admission owns the
        // normalization tails and becomes the sole writer as soon as begin runs.
        auto ingress_writable() const -> bool {
            return !started && statusValue == MetadataStatus::pending && instructionTypeBegin >= 0;
        }
        auto ingress_byte(i64 index, u8 value) -> bool {
            if (!ingress_writable()) {
                return false;
            }
            if (index < 0 || index >= bytes.size() || !bytes.set(index, value)) {
                return reject(MetadataError::integrity);
            }
            return true;
        }
        auto ingress_type(i64 index, RawTypeRow value) -> bool {
            if (!ingress_writable()) {
                return false;
            }
            if (index < 0 || index >= types.size() || !types.set(index, value)) {
                return reject(MetadataError::integrity);
            }
            return true;
        }
        auto ingress_class(i64 index, ClassRow value) -> bool {
            if (!ingress_writable()) {
                return false;
            }
            if (index < 0 || index >= classes.size() || !classes.set(index, value)) {
                return reject(MetadataError::integrity);
            }
            return true;
        }
        auto ingress_field(i64 index, FieldRow value) -> bool {
            if (!ingress_writable()) {
                return false;
            }
            if (index < 0 || index >= inputFields || !fields.set(index, value)) {
                return reject(MetadataError::integrity);
            }
            return true;
        }
        auto ingress_storage(i64 index, StorageRow value) -> bool {
            if (!ingress_writable()) {
                return false;
            }
            if (index < 0 || index >= inputStorage || !storage.set(index, value)) {
                return reject(MetadataError::integrity);
            }
            return true;
        }
        auto ingress_index(i64 index, IndexRow value) -> bool {
            if (!ingress_writable()) {
                return false;
            }
            if (index < 0 || index >= inputIndices || !indices.set(index, value)) {
                return reject(MetadataError::integrity);
            }
            return true;
        }
        auto ingress_descriptor(i64 index, DescriptorRow value) -> bool {
            if (!ingress_writable()) {
                return false;
            }
            if (index < 0 || index >= descriptors.size() || !descriptors.set(index, value)) {
                return reject(MetadataError::integrity);
            }
            return true;
        }
        auto ingress_view(i64 index, ViewRow value) -> bool {
            if (!ingress_writable()) {
                return false;
            }
            if (index < 0 || index >= views.size() || !views.set(index, value)) {
                return reject(MetadataError::integrity);
            }
            return true;
        }
        auto ingress_enum(i64 index, EnumRow value) -> bool {
            if (!ingress_writable()) {
                return false;
            }
            if (index < 0 || index >= enums.size() || !enums.set(index, value)) {
                return reject(MetadataError::integrity);
            }
            return true;
        }
        auto ingress_callable(i64 index, CallableRow value) -> bool {
            if (!ingress_writable()) {
                return false;
            }
            if (index < 0 || index >= callables.size() || !callables.set(index, value)) {
                return reject(MetadataError::integrity);
            }
            return true;
        }
        auto ingress_slot(i64 index, SlotRow value) -> bool {
            if (!ingress_writable()) {
                return false;
            }
            if (index < 0 || index >= slots.size() || !slots.set(index, value)) {
                return reject(MetadataError::integrity);
            }
            return true;
        }
        auto writable() const -> bool {
            return started && statusValue == MetadataStatus::pending;
        }
        auto begin() -> bool {
            if (started || statusValue != MetadataStatus::pending || !allocated()) {
                return false;
            }
            started = true;
            return true;
        }
        auto reject(MetadataError reason) -> bool {
            if (statusValue == MetadataStatus::pending) {
                statusValue = MetadataStatus::invalid;
                errorValue = reason;
                if (reason == MetadataError::none) {
                    errorValue = MetadataError::integrity;
                }
            }
            return false;
        }
        auto complete() -> bool {
            if (!writable() || frameCount != 0) {
                return reject(MetadataError::integrity);
