            return true;
        }
        auto byte_count() const -> i64 {
            return bytes.size();
        }
        auto type_count() const -> i64 {
            return types.size();
        }
        auto instruction_type_begin() const -> i64 {
            return instructionTypeBegin;
        }
        auto class_count() const -> i64 {
            return classes.size();
        }
        auto leaf_count() const -> i64 {
            return inputLeaves;
        }
        auto input_field_count() const -> i64 {
            return inputFields;
        }
        auto input_storage_count() const -> i64 {
            return inputStorage;
        }
        auto input_index_count() const -> i64 {
            return inputIndices;
        }
        auto descriptor_count() const -> i64 {
            return descriptors.size();
        }
        auto view_count() const -> i64 {
            return views.size();
        }
        auto enum_count() const -> i64 {
            return enums.size();
        }
        auto callable_count() const -> i64 {
            return callables.size();
        }
        auto slot_count() const -> i64 {
            return slots.size();
        }
        // A view of every slot row; only for an allocated (successfully begun) store.
        auto slot_rows() const -> builtin::span<const SlotRow> {
            const builtin::span<const SlotRow> all = borrow_values(slots);
            return all;
        }
        auto field_row_count() const -> i64 {
            return fieldEnd;
        }
        auto storage_count() const -> i64 {
            return storageEnd;
        }
        auto index_count() const -> i64 {
            return indexEnd;
        }
        auto frame_count() const -> i64 {
            return frameCount;
        }
        auto byte_at(i64 index) const -> i64 {
            if (index < 0 || index >= byte_count() || !bytes.ok()) {
                return -1;
            }
            return i64(bytes.at(index));
        }
        // Byte order of a sorted name (0 classes, 1 enums, 2 the callable name
        // index) against `name`; 2 when the row or its range is malformed.
        auto spelled_order(i64 category, i64 key, builtin::span<const u8> name) const -> i64 {
            i64 begin = -1;
            i64 count = 0;
            if (category == 0) {
                const ClassRow row = classes.at(key);
                const ByteRange range = row.name();
                begin = range.begin();
                count = range.count();
            }
            if (category == 1) {
                const EnumRow row = enums.at(key);
                const ByteRange range = row.name();
                begin = range.begin();
                count = range.count();
            }
            if (category == 2) {
                const IndexRow id = indices.at(inputIndices - callables.size() + key);
                if (id.value() < 0 || id.value() >= callables.size()) {
                    return 2;
                }
                const CallableRow row = callables.at(id.value());
                const ByteRange range = row.name();
                begin = range.begin();
                count = range.count();
            }
            const builtin::span<const u8> text = borrow_bytes(bytes);
            if (begin < 0 || count < 0 || begin > text.size() || count > text.size() - begin) {
                return 2;
            }
            i64 at = 0;
            while (at < count && at < name.size()) {
                const i64 left = i64(text.at(begin + at));
                const i64 right = i64(name.at(at));
                if (left != right) {
                    if (left < right) {
                        return -1;
                    }
                    return 1;
                }
                at = at + 1;
            }
            if (count < name.size()) {
                return -1;
            }
            if (count > name.size()) {
                return 1;
            }
            return 0;
        }
        // First sorted position spelled `name`, or -1 when absent or malformed.
        auto spelled_position(i64 category, builtin::span<const u8> name) const -> i64 {
            i64 size = classes.size();
            if (category == 1) {
                size = enums.size();
            }
            if (category == 2) {
                size = callables.size();
            }
            if (!bytes.ok() || !classes.ok() || !enums.ok() || !callables.ok() || !indices.ok() || (category == 2
                && inputIndices < size) || inputIndices > indices.size()) {
                return -1;
            }
            i64 low = 0;
            i64 high = size;
            while (low < high) {
                const i64 middle = low + (high - low) / 2;
                const i64 order = spelled_order(category, middle, name);
                if (order == 2) {
                    return -1;
                }
                if (order < 0) {
                    low = middle + 1;
                } else {
                    high = middle;
                }
            }
            if (low < size && spelled_order(category, low, name) == 0) {
                return low;
            }
            return -1;
        }
        // Keep byte_at's signed bounds, failed-owner sentinel and checked reads,
        // but observe immutable owner facts once for this bounded comparison.
        auto compare_bytes(i64 left, i64 right, i64 count) const -> i64 {
            if (count <= 0) {
                return 0;
            }
            const i64 limit = bytes.size();
            const bool available = bytes.ok();
            if (available && left >= 0 && left <= limit && count <= limit - left && right >= 0 && right <= limit
                && count <= limit - right) {
                // Validate the immutable owner once, then read the bounded ranges
                // through a borrow. Span access retains inline bounds checks.
                const builtin::span<const u8> checked = borrow_bytes(bytes);
                if (left == right && checked.size() == limit) {
                    return 0;
                }
                i64 compared = 0;
                while (compared < count) {
                    const i64 a = i64(checked.at(left + compared));
                    const i64 b = i64(checked.at(right + compared));
                    if (a < b) {
                        return -1;
                    }
                    if (a > b) {
                        return 1;
                    }
                    compared = compared + 1;
                }
                return 0;
            }
            i64 at = 0;
            while (at < count) {
                const i64 left_index = left + at;
                i64 a = -1;
                if (left_index >= 0 && left_index < limit && available) {
                    a = i64(bytes.at(left_index));
                }
                const i64 right_index = right + at;
                i64 b = -1;
                if (right_index >= 0 && right_index < limit && available) {
                    b = i64(bytes.at(right_index));
                }
                if (a < b) {
                    return -1;
                }
                if (a > b) {
                    return 1;
                }
                at = at + 1;
            }
            return 0;
        }
        // compare_bytes' view of one byte: -1 outside the owner or for a failed owner.
        auto compared_byte(i64 index) const -> i64 {
            if (index < 0 || index >= bytes.size() || !bytes.ok()) {
                return -1;
            }
            return i64(bytes.at(index));
        }
        // The first offset from start below count where compare_bytes would see the
        // two ranges differ, or count when they agree there.
        auto shared_bytes(i64 left, i64 right, i64 count, i64 start) const -> i64 {
            if (start < 0 || start >= count) {
                return count;
            }
            const i64 limit = bytes.size();
            if (bytes.ok() && left >= 0 && left <= limit && count <= limit - left && right >= 0 && right <= limit
                && count <= limit - right) {
                const builtin::span<const u8> checked = borrow_bytes(bytes);
                i64 at = start;
                while (at < count) {
                    if (checked.at(left + at) != checked.at(right + at)) {
                        return at;
                    }
                    at = at + 1;
                }
                return count;
            }
            i64 at = start;
            while (at < count) {
                if (compared_byte(left + at) != compared_byte(right + at)) {
                    return at;
                }
                at = at + 1;
            }
            return count;
        }
        auto type_at(i64 index) const -> RawTypeRow {
            if (index < 0 || index >= type_count() || !types.ok()) {
                const RawTypeRow invalid = invalid_type();
                return invalid;
            }
            const RawTypeRow result = types.at(index);
            return result;
        }
        auto class_at(i64 index) const -> ClassRow {
            if (index < 0 || index >= class_count() || !classes.ok()) {
                const ClassRow invalid = invalid_class();
                return invalid;
            }
            const ClassRow result = classes.at(index);
            return result;
        }
        auto field_at(i64 index) const -> FieldRow {
            if (index < 0 || index >= fieldEnd || !fields.ok()) {
                const FieldRow invalid = invalid_field();
                return invalid;
            }
            const FieldRow result = fields.at(index);
            return result;
        }
        auto storage_at(i64 index) const -> StorageRow {
            if (index < 0 || index >= storageEnd || !storage.ok()) {
                const StorageRow invalid = invalid_storage();
                return invalid;
            }
            const StorageRow result = storage.at(index);
            return result;
        }
        auto index_at(i64 index) const -> IndexRow {
            if (index < 0 || index >= indexEnd || !indices.ok()) {
                return IndexRow(-1);
            }
            const IndexRow result = indices.at(index);
            return result;
        }
        auto descriptor_at(i64 index) const -> DescriptorRow {
            if (index < 0 || index >= descriptor_count() || !descriptors.ok()) {
                return DescriptorRow(-1, -1, -1);
            }
            const DescriptorRow result = descriptors.at(index);
            return result;
        }
        auto view_at(i64 index) const -> ViewRow {
            if (index < 0 || index >= view_count() || !views.ok()) {
                return ViewRow(-1, IndexRange(-1, -1));
            }
            const ViewRow result = views.at(index);
            return result;
        }
        auto enum_at(i64 index) const -> EnumRow {
            if (index < 0 || index >= enum_count() || !enums.ok()) {
                return EnumRow(ByteRange(-1, -1), -1);
            }
            const EnumRow result = enums.at(index);
            return result;
        }
        auto callable_at(i64 index) const -> CallableRow {
            if (index < 0 || index >= callable_count() || !callables.ok()) {
                const CallableRow invalid = invalid_callable();
                return invalid;
            }
            const CallableRow result = callables.at(index);
            return result;
        }
        auto slot_at(i64 index) const -> SlotRow {
            if (index < 0 || index >= slot_count() || !slots.ok()) {
                return SlotRow(-1, -1, -1, -1, -1);
            }
            const SlotRow result = slots.at(index);
            return result;
        }
        auto result_at(i64 index) const -> ClassResultRow {
            if (index < 0 || index >= class_count() || !results.ok()) {
                const ClassResultRow invalid = invalid_result();
                return invalid;
            }
            const ClassResultRow result = results.at(index);
            return result;
        }
        auto append_field(FieldRow value) -> i64 {
            if (!writable() || fieldEnd < input_field_count() || fieldEnd >= fields.size()) {
                reject(MetadataError::integrity);
                return -1;
            }
            const i64 index = fieldEnd;
            if (!fields.set(index, value)) {
                reject(MetadataError::integrity);
                return -1;
            }
            fieldEnd = fieldEnd + 1;
            return index;
        }
        auto append_storage(StorageRow value) -> i64 {
            if (!writable() || storageEnd < input_storage_count() || storageEnd >= storage.size()) {
                reject(MetadataError::integrity);
                return -1;
            }
            const i64 index = storageEnd;
            if (!storage.set(index, value)) {
                reject(MetadataError::integrity);
                return -1;
            }
            storageEnd = storageEnd + 1;
            return index;
        }
        auto reserve_indices(i64 count) -> i64 {
            if (!writable() || count < 0 || indexEnd < input_index_count() || indexEnd > indices.size() || count
                > indices.size() - indexEnd) {
                reject(MetadataError::integrity);
                return -1;
            }
            const i64 first = indexEnd;
            indexEnd = indexEnd + count;
            return first;
        }
        auto set_index(i64 index, IndexRow value) -> bool {
            if (!writable() || index < input_index_count() || index >= indexEnd || !indices.set(index, value)) {
                return reject(MetadataError::integrity);
            }
            return true;
        }
        auto append_index(IndexRow value) -> i64 {
            const i64 index = reserve_indices(1);
            if (index < 0 || !set_index(index, value)) {
                return -1;
            }
            return index;
        }
        auto set_result(i64 index, ClassResultRow value) -> bool {
            if (!writable() || index < 0 || index >= class_count() || !results.set(index, value)) {
                return reject(MetadataError::integrity);
            }
            return true;
        }
        auto frame_at(i64 index) const -> FrameRow {
            if (index < 0 || index >= frameCount || !frames.ok()) {
                return FrameRow(-1, -1, -1);
            }
            const FrameRow result = frames.at(index);
            return result;
        }
        auto push_frame(FrameRow value) -> bool {
            if (!writable() || frameCount < 0 || frameCount >= 4 || !frames.set(frameCount, value)) {
                return reject(MetadataError::integrity);
            }
            frameCount = frameCount + 1;
            return true;
        }
        auto set_frame(i64 index, FrameRow value) -> bool {
            if (!writable() || index < 0 || index >= frameCount || !frames.set(index, value)) {
                return reject(MetadataError::integrity);
            }
            return true;
        }
        auto pop_frame() -> bool {
            if (!writable() || frameCount <= 0) {
                return reject(MetadataError::integrity);
            }
            frameCount = frameCount - 1;
            return true;
        }
    };
    auto create(builtin::ByteRegion region) -> MetadataStore {
        MetadataStore result = MetadataStore(region);
        return move(result);
    }
    auto release(builtin::ByteRegion region, MetadataStore store) -> i64 {
        return 0;
    }
}
