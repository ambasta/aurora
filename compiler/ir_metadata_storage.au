    auto count_sum(i64 left, i64 right) -> i64 {
        if (left < 0 || right < 0 || left > 9223372036854775807 - right) {
            return -1;
        }
        return left + right;
    }
    auto field_capacity(InputCounts counts) -> i64 {
        return count_sum(counts.field_row_count(), counts.leaf_count());
    }
    auto storage_capacity(InputCounts counts) -> i64 {
        return count_sum(counts.storage_count(), counts.class_count());
    }
    auto index_capacity(InputCounts counts) -> i64 {
        return count_sum(count_sum(counts.index_count(), counts.leaf_count()), field_capacity(counts));
    }
    auto valid_counts(InputCounts counts) -> bool {
        return counts.byte_count() >= 0 && counts.type_count() >= 0 && counts.class_count() >= 0
            && counts.field_row_count() >= 0 && counts.leaf_count() >= 0 && counts.storage_count() >= 0
            && counts.index_count() >= 0 && counts.descriptor_count() >= 0 && counts.view_count() >= 0
            && counts.enum_count() >= 0 && field_capacity(counts) >= 0 && field_capacity(counts) <= counts.type_count()
            && storage_capacity(counts) >= 0 && index_capacity(counts) >= 0;
    }
    auto invalid_type() -> RawTypeRow {
        return RawTypeRow(-1, ByteRange(-1, -1), RawTypeTail(-1, -1, 1u64, 1u64, 1u64));
    }
    auto invalid_callable() -> CallableRow {
        return CallableRow(ByteRange(-1, -1), IndexRange(-1, -1), -1, ReceiverShape(ByteRange(-1, -1),
            18446744073709551615u64), CallableOptions(18446744073709551615u64, -1, -1, -1, -1), IndexRange(-1, -1));
    }
    auto invalid_class() -> ClassRow {
        return ClassRow(ByteRange(-1, -1), IndexRange(-1, -1), IndexRange(-1, -1), -1, 18446744073709551615u64);
    }
    auto invalid_field() -> FieldRow {
        return FieldRow(-1, -1, -1, -1, -1);
    }
    auto invalid_storage() -> StorageRow {
        return StorageRow(IndexRange(-1, -1), IndexRange(-1, -1), PhysicalExtent(-1, -1, -1));
    }
    auto invalid_result() -> ClassResultRow {
        return ClassResultRow(IndexRange(-1, -1), -1, 0, 0);
    }
    auto type_pool(builtin::ByteRegion region, i64 count) -> builtin::OwnedValues<RawTypeRow> {
        const RawTypeRow fill = invalid_type();
        builtin::OwnedValues<RawTypeRow> result = region.try_allocate(count, fill);
        return move(result);
    }
    auto class_pool(builtin::ByteRegion region, i64 count) -> builtin::OwnedValues<ClassRow> {
        const ClassRow fill = invalid_class();
        builtin::OwnedValues<ClassRow> result = region.try_allocate(count, fill);
        return move(result);
    }
    auto field_pool(builtin::ByteRegion region, i64 count) -> builtin::OwnedValues<FieldRow> {
        const FieldRow fill = invalid_field();
        builtin::OwnedValues<FieldRow> result = region.try_allocate(count, fill);
        return move(result);
    }
    auto storage_pool(builtin::ByteRegion region, i64 count) -> builtin::OwnedValues<StorageRow> {
        const StorageRow fill = invalid_storage();
        builtin::OwnedValues<StorageRow> result = region.try_allocate(count, fill);
        return move(result);
    }
    auto index_pool(builtin::ByteRegion region, i64 count) -> builtin::OwnedValues<IndexRow> {
        const IndexRow fill = IndexRow(-1);
        builtin::OwnedValues<IndexRow> result = region.try_allocate(count, fill);
        return move(result);
    }
    auto descriptor_pool(builtin::ByteRegion region, i64 count) -> builtin::OwnedValues<DescriptorRow> {
        const DescriptorRow fill = DescriptorRow(-1, -1, -1);
        builtin::OwnedValues<DescriptorRow> result = region.try_allocate(count, fill);
        return move(result);
    }
    auto view_pool(builtin::ByteRegion region, i64 count) -> builtin::OwnedValues<ViewRow> {
        const ViewRow fill = ViewRow(-1, IndexRange(-1, -1));
        builtin::OwnedValues<ViewRow> result = region.try_allocate(count, fill);
        return move(result);
    }
    auto enum_pool(builtin::ByteRegion region, i64 count) -> builtin::OwnedValues<EnumRow> {
        const EnumRow fill = EnumRow(ByteRange(-1, -1), -1);
        builtin::OwnedValues<EnumRow> result = region.try_allocate(count, fill);
        return move(result);
    }
    auto callable_pool(builtin::ByteRegion region, i64 count) -> builtin::OwnedValues<CallableRow> {
        const CallableRow fill = invalid_callable();
        builtin::OwnedValues<CallableRow> result = region.try_allocate(count, fill);
        return move(result);
    }
    auto slot_pool(builtin::ByteRegion region, i64 count) -> builtin::OwnedValues<SlotRow> {
