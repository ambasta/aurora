        }
        auto leaves() const -> IndexRange {
            const IndexRange result = leafRange;
            return result;
        }
        auto fields() const -> IndexRange {
            const IndexRange result = fieldRange;
            return result;
        }
        auto supplied_storage() const -> i64 {
