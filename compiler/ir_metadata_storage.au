export module aurora.compiler.ir_metadata_storage;

// Durable metadata storage. Native ingress fills the exact raw prefixes once;
// independent verification only appends normalization tails and writes results.
// No source accessor exposes a descriptor, payload address or mutable raw row.
export namespace compiler_ir_metadata {
    auto maximum_class_fields() -> i64 {
        return 8192;
    }
    enum class MetadataStatus {
        pending,
        success,
        allocation,
        invalid
    };
    // Generated facts pin these ordinals to native TypeKind. Raw rows retain
    // integers, including unknown kinds, rather than accepting unchecked enums.
    enum class MetadataTypeKind {
        I64,
        Bool,
        Own,
        Ref,
        MutRef,
        Class,
        Array,
        U64,
        Parameter,
        Enum,
        U8,
        ByteSpan,
        ByteRegion,
        OwnedBytes,
        ConsoleSession,
        DisplaySession,
        IommuEventSession,
        OwnedValues,
        CallSession,
        Com1UartGrant,
        ServeSession
    };
    enum class MetadataError {
        none,
        //: invalid hosted IR metadata transport
        integrity,
        //: invalid typed IR: invalid metadata descriptor
        descriptor,
        //: invalid typed IR: missing root reflection scope
        root_scope,
        //: invalid typed IR: invalid reflection scope
        scope,
        //: invalid typed IR: reflection view references missing descriptor
        view_descriptor,
        //: invalid typed IR: too many enum declarations
        enum_count,
        //: invalid typed IR: invalid nominal enum declaration
        enum_declaration,
        //: invalid typed IR: class and enum nominal names overlap
        nominal_overlap,
        //: invalid typed IR: invalid nominal class layout
        class_layout,
        //: invalid typed IR: class exceeds 8192 direct fields
        class_field_limit,
        //: invalid typed IR: non-scalar class layout field
        class_leaf,
        //: invalid typed IR: logical fields reference unknown class layout
        unknown_fields,
        //: invalid typed IR: noncanonical class array element count
        field_element_count,
        //: invalid typed IR: class array carrier cannot be nested element type
        nested_carrier,
        //: invalid typed IR: invalid logical class field shape
        field_shape,
        //: invalid typed IR: owned storage field requires zero scalar leaves
        owner_leaves,
        //: invalid typed IR: invalid canonical owned value field type
        owner_field_type,
        //: invalid typed IR: nested owning class field is unsupported
        nested_owner,
        //: invalid typed IR: invalid nominal nested class field
        nested_type,
        //: invalid typed IR: class array element count exceeds 1..64
        class_array_count,
        //: invalid typed IR: nested class field length mismatch
        nested_length,
        //: invalid typed IR: logical class field range exceeds layout
        field_range,
        //: invalid typed IR: nested class field leaf type mismatch
        nested_leaf,
        //: invalid typed IR: logical class field leaf type mismatch
        field_leaf,
        //: invalid typed IR: logical class fields do not cover complete layout
        leaf_coverage,
        //: invalid typed IR: composed or owning class exceeds 64 scalar leaves excluding u8, 512 u8 leaves or 513 total
        //: leaves
        class_leaf_limit,
        //: invalid typed IR: unknown class array carrier
        unknown_carrier,
        //: invalid typed IR: class array carrier requires exactly one class array field
        carrier_shape,
        //: invalid typed IR: cyclic nested class layout
        cycle,
        //: invalid typed IR: nested class layout exceeds depth 4
        depth,
        //: invalid typed IR: noncanonical sealed ConsoleSample layout
        console_layout,
        //: invalid typed IR: noncanonical sealed ConsoleSample fields
        console_fields,
        //: invalid typed IR: noncanonical sealed ConsoleSample field shape
        console_field_shape,
        //: invalid typed IR: noncanonical sealed IommuEventSample layout
        event_layout,
        //: invalid typed IR: noncanonical sealed IommuEventSample fields
        event_fields,
        //: invalid typed IR: noncanonical sealed IommuEventSample field shape
        event_field_shape,
        //: invalid typed IR: noncanonical sealed event service enum
        event_enum,
        //: invalid typed IR: noncanonical sealed service enum
        service_enum,
        //: IR: storage extent exceeds 65536 bytes
        storage_extent,
        //: IR: cyclic or excessive class storage depth
        storage_depth,
        //: IR: missing logical class storage shape
        storage_shape,
        //: IR: invalid class storage alignment
        storage_alignment,
        //: IR: invalid logical field range for storage
        storage_field_range,
        //: IR: owned byte field requires one non-scalar descriptor
        storage_owner_shape,
        //: IR: nested owning class fields are unsupported
        storage_nested_owner,
        //: IR: invalid nested field storage shape
        storage_nested_shape,
        //: IR: invalid scalar field storage shape
        storage_scalar_shape,
        //: IR: class storage exceeds 65536 bytes
        storage_limit,
        //: IR: class storage does not cover logical leaves
        storage_coverage,
        //: invalid typed IR: invalid canonical owned value type
        owner_type,
        //: invalid typed IR: owned value element requires known canonical class layout
        owner_element_unknown,
        //: invalid typed IR: owned value element must be a copied class, not an owner or carrier
        owner_element_kind,
        //: invalid typed IR: owned value element exceeds copied class leaf limits
        owner_element_leaves,
        //: invalid typed IR: owned value element storage exceeds 520 bytes
        owner_element_storage,
        //: invalid typed IR: composed or owning class storage exceeds 520 bytes
        class_storage_limit,
        //: invalid typed IR: noncanonical class storage metadata
        supplied_storage,
        //: invalid typed IR: empty module
        empty_module,
        //: invalid typed IR: invalid or reserved function symbol
        function_symbol,
        //: invalid typed IR: duplicate function
        duplicate_function,
        //: invalid typed IR: unknown function module scope
        function_scope,
        //: invalid typed IR: service signature requires a leading sealed group and no receiver or region
        service_signature,
        //: invalid typed IR: service signature requires distinct capability kinds
        service_duplicates,
        //: invalid typed IR: unsupported service group
        service_group,
        //: invalid typed IR: service signature requires later scalar, enum, copied value or readonly span arguments
        service_parameters,
        //: invalid typed IR: service signature has unsupported result
        service_result,
        //: invalid typed IR: borrowed roots require a free-function signature
        borrowed_shape,
        //: invalid typed IR: borrowed formal cannot have resource or borrowed result
        borrowed_result,
        //: invalid typed IR: borrowed roots count toward six parameters
        borrowed_parameters,
        //: invalid typed IR: borrowed root requires a canonical named class type
        borrowed_root_type,
        //: invalid typed IR: borrowed root requires a complete concrete owning class
        borrowed_root_class,
        //: invalid typed IR: borrowed root count exceeds the explicit formal prefix
        borrowed_root_count,
        //: invalid typed IR: multi-root borrowed signature requires scalar or enum values
        borrowed_root_values,
        //: invalid typed IR: resource signature only supports an owning constructor receiver
        resource_receiver,
        //: invalid typed IR: resource signature requires its region parameter first
        resource_region,
        //: invalid typed IR: resource signature requires scalar, owned byte or class result
        resource_result,
        //: invalid typed IR: resource signature requires exactly one region and supported owning parameters
        resource_parameters,
        //: invalid typed IR: service capability cannot cross an ordinary boundary or return
        service_boundary,
        //: invalid typed IR: invalid canonical service boundary type
        service_type,
        //: invalid typed IR: invalid resource boundary type
        resource_boundary,
        //: invalid typed IR: readonly span boundary requires ordinary parameter or const receiver result
        span_boundary,
        //: invalid typed IR: constructor result must remain scalar
        constructor_result,
        //: invalid typed IR: invalid value boundary type
        value_type,
        //: invalid typed IR: unknown value boundary class
        value_class,
        //: invalid typed IR: class array carrier cannot cross value boundary
        value_carrier,
        //: invalid typed IR: owning class requires an ordinary resource boundary
        value_owner,
        //: invalid typed IR: only an owning constructor may take a copied class resource parameter
        value_resource,
        //: invalid typed IR: value boundary class exceeds 64 scalar fields excluding u8, 512 u8 leaves or 513 total
        //: leaves
        value_leaves,
        //: invalid typed IR: value boundary class storage exceeds 520 bytes
        value_storage,
        //: invalid typed IR: receiver span field summary requires span result
        span_result,
        //: invalid typed IR: too many parameters
        parameter_count,
        //: invalid typed IR: receiver signature requires scalar, enum or class values
        receiver_signature,
        //: invalid typed IR: invalid aggregate parameter type
        aggregate_parameter,
        //: invalid typed IR: unknown receiver class
        receiver_class,
        //: invalid typed IR: class array carrier cannot be receiver
        receiver_carrier,
        //: invalid typed IR: receiver span field summary requires exact direct byte-storage field
        receiver_span,
        //: invalid typed IR: owned value metadata requires exact owner spill
        owner_spill,
        //: invalid typed IR: service spills without a service signature
        service_spills,
        //: invalid typed IR: invalid frame size
        frame_size,
        //: invalid typed IR: invalid slot offset
        slot_offset,
        //: invalid typed IR: invalid slot payload type
        slot_type,
        //: invalid typed IR: overlapping scalar slot storage
        slot_overlap,
        //: invalid typed IR: unknown object class
        object_class,
        //: invalid typed IR: invalid object layout offset
        object_offset,
        //: invalid typed IR: overlapping object layouts
        object_overlap,
        //: invalid typed IR: object field slot type/layout mismatch
        object_leaf,
        //: invalid typed IR: scalar slot overlaps empty object or padding
        object_padding,
        //: invalid typed IR: invalid byte array origin extent
        array_extent,
        //: invalid typed IR: byte array origin requires exact u8 element slots
        array_leaf,
        //: invalid typed IR: byte array origin overlaps object storage
        array_object,
        //: invalid typed IR: overlapping byte array origins
        array_overlap,
        //: invalid typed IR: invalid span spill extent or alignment
        span_extent,
        //: invalid typed IR: span spill overlaps scalar, object or array storage
        span_overlap,
        //: invalid typed IR: overlapping span spills
        span_spills,
        //: invalid typed IR: invalid service spill extent or alignment
        service_extent,
        //: invalid typed IR: service spill overlaps scalar, object, array or span storage
        service_overlap,
        //: invalid typed IR: invalid region spill extent or alignment
        region_extent,
        //: invalid typed IR: region spill overlaps scalar, object, array or span storage
        region_overlap,
        //: invalid typed IR: invalid owned byte spill extent or alignment
        byte_extent,
        //: invalid typed IR: owned byte spill overlaps scalar, object, array or span storage
        byte_overlap,
        //: invalid typed IR: overlapping region or owned byte spills
        resource_overlap,
        //: invalid typed IR: noncanonical sealed CallResult layout
        call_layout,
        //: invalid typed IR: noncanonical sealed CallResult fields
        call_fields
    };
    class ByteRange {
        i64 firstByte;
        i64 byteCount;
    public:
        ByteRange(i64 first, i64 count) : firstByte(first), byteCount(count) {
        }
        auto begin() const -> i64 {
            return firstByte;
        }
        auto count() const -> i64 {
            return byteCount;
        }
    };
    class IndexRange {
        i64 firstIndex;
        i64 indexCount;
    public:
        IndexRange(i64 first, i64 count) : firstIndex(first), indexCount(count) {
        }
        auto begin() const -> i64 {
            return firstIndex;
        }
        auto count() const -> i64 {
            return indexCount;
        }
    };
    class RawTypeTail {
        i64 elementKind;
        i64 arrayLength;
        u64 elementParameterBytes;
        u64 lengthParameterBytes;
        u64 templateArgumentCount;
    public:
        RawTypeTail(i64 element, i64 length, u64 element_parameter, u64 length_parameter,
            u64 arguments) : elementKind(element), arrayLength(length), elementParameterBytes(element_parameter),
            lengthParameterBytes(length_parameter), templateArgumentCount(arguments) {
        }
        auto element_kind() const -> i64 {
            return elementKind;
        }
        auto length() const -> i64 {
            return arrayLength;
        }
        auto element_parameter_bytes() const -> u64 {
            return elementParameterBytes;
        }
        auto length_parameter_bytes() const -> u64 {
            return lengthParameterBytes;
        }
        auto template_argument_count() const -> u64 {
            return templateArgumentCount;
        }
    };
    class RawTypeRow {
        i64 typeKind;
        ByteRange nameRange;
        RawTypeTail rawTail;
    public:
        RawTypeRow(i64 kind, ByteRange name, RawTypeTail tail) : typeKind(kind), nameRange(name), rawTail(tail) {
        }
        auto kind() const -> i64 {
            return typeKind;
        }
        auto name() const -> ByteRange {
            const ByteRange result = nameRange;
            return result;
        }
        auto tail() const -> RawTypeTail {
            const RawTypeTail result = rawTail;
            return result;
        }
    };
    // One source definition serves source admission and the closed native
    // transport. The host reads this copied table through one generated bridge.
    class FlagMasks {
        u64 classLayout;
        u64 classFields;
        u64 classStorage;
        u64 classArrayCarrier;
        u64 callableReceiver;
        u64 callableSpanSummary;
        u64 receiverMutable;
        u64 receiverConstructor;
        u64 receiverPublic;
        u64 serviceConsole;
        u64 serviceDisplay;
        u64 serviceIommu;
        u64 flowLeader;
        u64 flowFallthrough;
        u64 flowReached;
    public:
        FlagMasks() : classLayout(1u64), classFields(2u64), classStorage(4u64), classArrayCarrier(8u64),
            callableReceiver(1u64), callableSpanSummary(8u64), receiverMutable(1u64), receiverConstructor(2u64),
            receiverPublic(4u64), serviceConsole(1u64), serviceDisplay(2u64), serviceIommu(4u64), flowLeader(1u64),
            flowFallthrough(2u64), flowReached(4u64) {
        }
        auto class_layout() const -> u64 {
            return classLayout;
        }
        auto class_fields() const -> u64 {
            return classFields;
        }
        auto class_storage() const -> u64 {
            return classStorage;
        }
        auto class_array_carrier() const -> u64 {
            return classArrayCarrier;
        }
        auto callable_receiver() const -> u64 {
            return callableReceiver;
        }
        auto callable_span_summary() const -> u64 {
            return callableSpanSummary;
        }
        auto receiver_mutable() const -> u64 {
            return receiverMutable;
        }
        auto receiver_constructor() const -> u64 {
            return receiverConstructor;
        }
        auto receiver_public() const -> u64 {
            return receiverPublic;
        }
        auto service_console() const -> u64 {
            return serviceConsole;
        }
        auto service_display() const -> u64 {
            return serviceDisplay;
        }
        auto service_call() const -> u64 {
            return 8u64;
        }
        auto service_port() const -> u64 {
            return 16u64;
        }
        auto service_serve() const -> u64 {
            return 32u64;
        }
        auto service_iommu() const -> u64 {
            return serviceIommu;
        }
        auto flow_leader() const -> u64 {
            return flowLeader;
        }
        auto flow_fallthrough() const -> u64 {
            return flowFallthrough;
        }
        auto flow_reached() const -> u64 {
            return flowReached;
        }
        auto class_allowed() const -> u64 {
            return classLayout | classFields | classStorage | classArrayCarrier;
        }
        auto callable_allowed() const -> u64 {
            return callableReceiver | callableSpanSummary;
        }
        auto receiver_allowed() const -> u64 {
            return receiverMutable | receiverConstructor | receiverPublic;
        }
    };
    auto flag_masks() -> FlagMasks {
        const FlagMasks result = FlagMasks();
        return result;
    }
    class ReceiverShape {
        // Genuine method/constructor receiver only. Borrowed free-function
        // formals live once in CallableRow's explicit-formal type prefix.
        ByteRange nameRange;
        u64 flags; // named Receiver masks
    public:
        ReceiverShape(ByteRange name, u64 attributes) : nameRange(name), flags(attributes) {
        }
        auto name() const -> ByteRange {
            const ByteRange result = nameRange;
            return result;
        }
        auto attributes() const -> u64 {
            return flags;
        }
    };
    // A copied argument keeps construction within the six-parameter boundary;
    // CallableRow stores these values directly, without another owner.
    class CallableOptions {
        u64 flags;
        i64 receiverSpanField;
        i64 frameBytes;
        i64 borrowedRootCount;
        i64 firstBorrowedMutable;
    public:
        CallableOptions(u64 attributes, i64 span, i64 frame, i64 roots, i64 first_mutable) : flags(attributes),
            receiverSpanField(span), frameBytes(frame), borrowedRootCount(roots), firstBorrowedMutable(first_mutable) {
        }
        auto attributes() const -> u64 {
            return flags;
        }
        auto receiver_span_field() const -> i64 {
            return receiverSpanField;
        }
        auto frame_bytes() const -> i64 {
            return frameBytes;
        }
        auto borrowed_root_count() const -> i64 {
            return borrowedRootCount;
        }
        auto first_borrowed_mutable() const -> i64 {
            return firstBorrowedMutable;
        }
    };
    class CallableRow {
        ByteRange nameRange;
        IndexRange typeRange; // result, then every explicit source formal in order
        i64 moduleScope;
        ReceiverShape receiver;
        i64 borrowedRootCount;
        i64 firstBorrowedMutable;
        u64 flags; // named Callable masks; all other bits are invalid
        i64 receiverSpanField;
        i64 frameBytes;
        IndexRange slotRange;
    public:
        CallableRow(ByteRange name, IndexRange types, i64 scope, ReceiverShape first, CallableOptions options,
            IndexRange slots) : nameRange(name), typeRange(types), moduleScope(scope), receiver(first),
            borrowedRootCount(options.borrowed_root_count()), firstBorrowedMutable(options.first_borrowed_mutable()),
            flags(options.attributes()), receiverSpanField(options.receiver_span_field()),
            frameBytes(options.frame_bytes()), slotRange(slots) {
        }
        auto name() const -> ByteRange {
            const ByteRange result = nameRange;
            return result;
        }
        auto types() const -> IndexRange {
            const IndexRange result = typeRange;
            return result;
        }
        auto scope() const -> i64 {
            return moduleScope;
        }
        auto first_receiver() const -> ReceiverShape {
            const ReceiverShape result = receiver;
            return result;
        }
        // Invalid raw rows never produce an index or mutable authority. The
        // owner separately checks these indices against its declared type pool.
        auto borrowed_root_count() const -> i64 {
            if (borrowedRootCount < 0 || borrowedRootCount > 3 || typeRange.begin() < 0 || typeRange.count() < 1
                || borrowedRootCount > typeRange.count() - 1 || typeRange.begin() > 9223372036854775807
                - typeRange.count() || firstBorrowedMutable < 0 || firstBorrowedMutable > 1 || (borrowedRootCount == 0
                && firstBorrowedMutable != 0)) {
                return -1;
            }
            return borrowedRootCount;
        }
        auto first_borrowed_mutable() const -> i64 {
            return firstBorrowedMutable;
        }
        auto borrowed_root_type(i64 ordinal) const -> i64 {
            const i64 roots = borrowed_root_count();
            if (ordinal < 0 || ordinal >= roots) {
                return -1;
            }
            return typeRange.begin() + 1 + ordinal;
        }
        auto borrowed_root_mutable(i64 ordinal) const -> bool {
            return ordinal == 0 && ordinal < borrowed_root_count() && firstBorrowedMutable == 1;
        }
        auto value_parameter_begin() const -> i64 {
            const i64 roots = borrowed_root_count();
            if (roots < 0) {
                return -1;
            }
            return typeRange.begin() + 1 + roots;
        }
        auto value_parameter_count() const -> i64 {
            const i64 roots = borrowed_root_count();
            if (roots < 0) {
                return -1;
            }
            return typeRange.count() - 1 - roots;
        }
        auto attributes() const -> u64 {
            return flags;
        }
        auto receiver_span_field() const -> i64 {
            return receiverSpanField;
        }
        auto frame_bytes() const -> i64 {
            return frameBytes;
        }
        auto slots() const -> IndexRange {
            const IndexRange result = slotRange;
            return result;
        }
    };
    // Raw record kinds use the existing lowering RecordKind identities 10..17,
    // pinned against its generated enum facts by the host boundary. No second
    // slot-kind enum or caller-supplied canonicality proof is retained.
    class SlotRow {
        i64 recordKind;
        i64 slotOffset;
        i64 typeIndex;
        i64 slotLength;
        i64 mutableValue;
    public:
        SlotRow(i64 kind, i64 offset, i64 type, i64 length, i64 mutable_value) : recordKind(kind), slotOffset(offset),
            typeIndex(type), slotLength(length), mutableValue(mutable_value) {
        }
        auto kind() const -> i64 {
            return recordKind;
        }
        auto offset() const -> i64 {
            return slotOffset;
        }
        auto type() const -> i64 {
            return typeIndex;
        }
        auto length() const -> i64 {
            return slotLength;
        }
        auto mutable_value() const -> i64 {
            return mutableValue;
        }
    };
