    // One source definition serves source admission and the closed native
    // transport. The host reads this copied table through one generated bridge.
    class FlagMasks {
        u64 classLayout;
        u64 classFields;
        u64 classStorage;
        u64 classArrayCarrier;
        u64 callableReceiver;
        u64 callableSpanSummary;
