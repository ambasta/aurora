export module aurora.compiler.ir_metadata_storage;

// Durable metadata storage. Pending ingress fills the exact raw prefixes once;
// independent verification only appends normalization tails and writes results.
// No source accessor exposes a descriptor, payload address or mutable raw row.
export namespace compiler_ir_metadata {
    auto maximum_class_fields() -> i64 {
        return 8192;
    }
    enum class MetadataStatus {
        pending,
        success,
        allocation,
        invalid
    };
    // The IR type kinds; append new kinds to keep ordinals stable. Raw rows retain
    // integers, including unknown kinds, rather than accepting unchecked enums.
