    class CoreCounts {
        i64 bytes;
        i64 types;
        i64 classes;
        i64 fields;
        i64 leaves;
    public:
        CoreCounts(i64 byte_count, i64 type_count, i64 class_count, i64 field_rows, i64 leaf_count) : bytes(byte_count),
            types(type_count), classes(class_count), fields(field_rows), leaves(leaf_count) {
