    // Copied transport record, not two independent failure states. Enum range
    // validity is checked by the native boundary before typed construction.
    class VerificationError {
        VerificationErrorFirst firstValue;
        VerificationErrorSecond secondValue;
    public:
        VerificationError(VerificationErrorFirst first, VerificationErrorSecond second) : firstValue(first),
            secondValue(second) {
        }
        auto first() const -> VerificationErrorFirst {
            return firstValue;
        }
        auto second() const -> VerificationErrorSecond {
            return secondValue;
        }
        auto canonical() const -> bool {
            return firstValue == VerificationErrorFirst::none || secondValue == VerificationErrorSecond::none;
        }
        auto empty() const -> bool {
            return firstValue == VerificationErrorFirst::none && secondValue == VerificationErrorSecond::none;
        }
        auto allocation() const -> bool {
            return firstValue == VerificationErrorFirst::allocation && secondValue == VerificationErrorSecond::none;
        }
        auto same(VerificationError other) const -> bool {
            return firstValue == other.first() && secondValue == other.second();
        }
    };
    auto first_error(VerificationErrorFirst value) -> VerificationError {
        return VerificationError(value, VerificationErrorSecond::none);
    }
    auto second_error(VerificationErrorSecond value) -> VerificationError {
        return VerificationError(VerificationErrorFirst::none, value);
    }
