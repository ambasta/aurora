            if (row.kind() == compiler_lowering::RecordKind::Instruction || row.kind()
                == compiler_lowering::RecordKind::DiscardedInstruction) {
                if (row.operand_begin() < 0 || row.operand_count() < 0 || row.operand_begin() > session.operand_count()
                    || row.operand_count() > session.operand_count() - row.operand_begin()) {
                    return Inspection(1, id, 0, 0, 0, 0);
