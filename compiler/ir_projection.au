                        role = compiler_lowering::OperandRole::PublicDescriptorId;
                    }
                    if (shape.mode == 28) {
                        role = compiler_lowering::OperandRole::ClassNominalId;
                    }
                    if (shape.mode == 29) {
                        role = compiler_lowering::OperandRole::Root;
                        if (index % 2 == 1) {
                            role = compiler_lowering::OperandRole::LoanId;
                        }
                    }
                    if (shape.mode == 30) {
                        role = compiler_lowering::OperandRole::ServiceLoanId;
                        if (index % 2 == 1) {
                            role = compiler_lowering::OperandRole::ServiceKindId;
                        }
                    }
                    if (item.role() != role) {
                        return plan.fail();
                    }
                    const i64 item_number = item.signed_value();
                    if (shape.mode == 20 || shape.mode == 27 || shape.mode == 29 || (shape.mode == 30 && index % 2
                        == 0)) {
                        if (item_number < -2147483648 || item_number > 2147483647 || (shape.mode == 27 && item_number
                            < 0)) {
                            return plan.fail();
                        }
                    }
                    if (shape.mode == 21 && !plan.request(3, item_number)) {
                        return false;
                    }
                    if (shape.mode == 28 && !plan.request(5, item_number)) {
                        return false;
                    }
                    if (shape.mode == 30 && index % 2 == 1 && !plan.request(7, item_number)) {
                        return false;
                    }
                    if (shape.mode == 22) {
                        compiler_lowering::RecordKind expected = shape.child;
                        if (expected == compiler_lowering::RecordKind::invalid) {
                            if (item_number < 0 || item_number >= session.output_count()) {
                                return plan.fail();
                            }
                            const compiler_lowering::OutputRow slot = session.view_output(item_number);
                            expected = slot.kind();
                            if (!slot_kind(expected)) {
                                return plan.fail();
                            }
                        }
                        if (!plan.claim_row(item_number, expected)) {
                            return false;
                        }
                    }
                    index = index + 1;
                }
            }
            at = at + 1;
        }
        return true;
    }
    auto graph(Plan& plan, const compiler_resolver::Session& session, i64 root) -> bool {
        const Inspection inspection = count_instruction_prefixes(session);
        if (inspection.status != 0 || session.output_count() < 15 || root < 15 || root >= session.output_count()
            || !plan.begin(session.output_count(), session.operand_count(), root, session.projection_stamp())) {
            return plan.fail();
        }
        const compiler_lowering::OutputRow diagnostic = session.view_output(0);
        const compiler_lowering::OutputRow configuration = session.view_output(1);
        if (diagnostic.operand_begin() != 0 || diagnostic.operand_count() != 3 || configuration.operand_begin() < 0
            || configuration.operand_count() != 8 || configuration.operand_begin() > session.operand_count() || 8
            > session.operand_count() - configuration.operand_begin()) {
            return plan.fail();
        }
        const compiler_lowering::OperandRow groups = session.view_operand(configuration.operand_begin() + 7);
        i64 layout = 14;
        if (groups.signed_value() == 318) {
            layout = 15;
        }
        if (root <= layout || !plan.claim_row(0, compiler_lowering::RecordKind::DiagnosticPayload) || !plan.claim_row(1,
            compiler_lowering::RecordKind::Configuration)) {
            return plan.fail();
        }
        i64 at = 2;
        while (at < 9) {
            if (!plan.claim_row(at, compiler_lowering::RecordKind::ScalarContract)) {
                return false;
            }
            at = at + 1;
        }
        while (at < layout) {
            if (!plan.claim_row(at, compiler_lowering::RecordKind::ServiceContract)) {
                return false;
            }
            at = at + 1;
        }
        if (!plan.claim_row(layout, compiler_lowering::RecordKind::InitialLayoutOrder) || !plan.claim_row(root,
            compiler_lowering::RecordKind::Module)) {
            return false;
        }
        at = 0;
        while (at < plan.node_count()) {
            const GraphNode node = plan.node(at);
            const compiler_lowering::OutputRow row = session.view_output(node.id);
            if (row.kind() != node.kind || !graph_record(plan, session, node.id)) {
                return plan.fail();
            }
            at = at + 1;
        }
        at = 0;
        while (at < session.output_count()) {
            if (!plan.owned(at)) {
                const compiler_lowering::OutputRow row = session.view_output(at);
                if (row.kind() != compiler_lowering::RecordKind::DiscardedInstruction || !plan.claim_row(at,
                    compiler_lowering::RecordKind::DiscardedInstruction) || !graph_record(plan, session, at)) {
                    return plan.fail();
                }
            }
            at = at + 1;
        }
        return plan.finish();
    }
    auto bind_domains(Plan& plan, const compiler_resolver::Session& session) -> bool {
        if (plan.status() != 3) {
            return plan.fail();
        }
        i64 at = 0;
        while (at < session.output_count()) {
            const compiler_lowering::OutputRow row = session.view_output(at);
            if (row.kind() == compiler_lowering::RecordKind::Carrier) {
                const compiler_lowering::OperandRow type = session.view_operand(row.operand_begin());
                if (plan.identity_value(3, type.signed_value()) != 5) {
                    return plan.fail();
                }
            }
            if (row.kind() == compiler_lowering::RecordKind::Instruction || row.kind()
                == compiler_lowering::RecordKind::DiscardedInstruction) {
                i64 field = 0;
                while (field < row.operand_count()) {
                    const Shape shape = instruction_shape(row.form(), field);
                    const compiler_lowering::OperandRow value = session.view_operand(row.operand_begin() + field);
                    if (shape.mode == 13) {
                        const compiler_lowering::OperandRow type = session.view_operand(row.operand_begin() + field
                            + 1);
                        const i64 kind = plan.identity_value(3, type.signed_value());
                        if (kind < 0 || (kind == 7 && value.role() != compiler_lowering::OperandRole::UnsignedConstant)
                            || (kind != 7 && value.role() != compiler_lowering::OperandRole::SignedConstant)) {
                            return plan.fail();
                        }
                    }
                    if (shape.mode == 12 && row.kind() == compiler_lowering::RecordKind::DiscardedInstruction) {
                        i64 byte = 0;
                        while (byte < value.count()) {
                            if (session.view_source(value.begin() + byte) < 0) {
                                return plan.fail();
                            }
                            byte = byte + 1;
                        }
                    }
                    field = field + 1;
                }
            }
            at = at + 1;
        }
        return plan.seal_domains();
    }

    auto slot_rank(compiler_lowering::RecordKind kind) -> i64 {
        if (kind == compiler_lowering::RecordKind::ScalarSlot) {
            return 10;
        }
        if (kind == compiler_lowering::RecordKind::ObjectSlot) {
            return 11;
        }
        if (kind == compiler_lowering::RecordKind::ArraySlot) {
            return 12;
        }
        if (kind == compiler_lowering::RecordKind::SpanSlot) {
            return 13;
        }
        if (kind == compiler_lowering::RecordKind::ServiceSlot) {
            return 14;
        }
        if (kind == compiler_lowering::RecordKind::RegionSlot) {
            return 15;
        }
        if (kind == compiler_lowering::RecordKind::ByteSlot) {
            return 16;
        }
        if (kind == compiler_lowering::RecordKind::OwnedValueType) {
            return 17;
        }
        return -1;
    }
    auto canonical_order(Plan& plan, const compiler_resolver::Session& session, i64 root) -> bool {
        if (root != plan.root() || !plan.begin_order()) {
            return plan.fail();
        }
        i64 at = 0;
        while (at < session.output_count()) {
            const compiler_lowering::OutputRow row = session.view_output(at);
            if (row.kind() == compiler_lowering::RecordKind::Carrier) {
                const compiler_lowering::OperandRow type = session.view_operand(row.operand_begin());
                const compiler_lowering::OperandRow count = session.view_operand(row.operand_begin() + 1);
                const TextRange name = plan.carrier_name(type.signed_value(), count.signed_value());
                if (!plan.remember_name(at, name)) {
                    return false;
                }
            }
            at = at + 1;
        }
        at = 0;
        while (at < session.output_count()) {
            const compiler_lowering::OutputRow row = session.view_output(at);
            if (row.kind() == compiler_lowering::RecordKind::Class || row.kind()
                == compiler_lowering::RecordKind::Function || row.kind() == compiler_lowering::RecordKind::EnumCases
                || row.kind() == compiler_lowering::RecordKind::Receiver) {
                const compiler_lowering::OperandRow identity = session.view_operand(row.operand_begin());
                i64 domain = 5;
                if (row.kind() == compiler_lowering::RecordKind::Function) {
                    domain = 4;
                }
                if (row.kind() == compiler_lowering::RecordKind::EnumCases) {
                    domain = 15;
                }
                if (identity.role() == compiler_lowering::OperandRole::CarrierId) {
                    const TextRange name = plan.row_name(identity.signed_value());
                    if (!plan.remember_name(at, name)) {
                        return false;
                    }
                } else {
                    const TextRange name = plan.identity_name(domain, identity.signed_value());
                    if (!plan.remember_name(at, name)) {
                        return false;
                    }
                }
            }
            at = at + 1;
        }
        const compiler_lowering::OutputRow module_row = session.view_output(root);
        const compiler_lowering::OperandRow functions = session.view_operand(module_row.operand_begin());
        const compiler_lowering::OperandRow classes = session.view_operand(module_row.operand_begin() + 1);
        const compiler_lowering::OperandRow carriers = session.view_operand(module_row.operand_begin() + 2);
        const compiler_lowering::OperandRow descriptors = session.view_operand(module_row.operand_begin() + 3);
        const compiler_lowering::OperandRow views = session.view_operand(module_row.operand_begin() + 4);
        const compiler_lowering::OperandRow enums = session.view_operand(module_row.operand_begin() + 5);
        at = 0;
        while (at < classes.count() + carriers.count()) {
            i64 id = -1;
            i64 flags = 2;
            if (at < classes.count()) {
                const compiler_lowering::OperandRow reference = session.view_operand(classes.begin() + at);
                id = reference.signed_value();
            } else {
                const compiler_lowering::OperandRow reference = session.view_operand(carriers.begin() + at
                    - classes.count());
                id = reference.signed_value();
                flags = 1;
            }
            const TextRange name = plan.row_name(id);
            if (flags == 1) {
                id = -1;
            }
            const OrderRow entry = OrderRow(id, 0, 0, name.begin, name.count, flags);
            if (!plan.put_order(plan.class_begin() + at, entry)) {
                return false;
            }
            at = at + 1;
        }
        if (!plan.sort_order(plan.class_begin(), at, true)) {
            return false;
        }
        i64 class_count = 0;
        at = 0;
        while (at < classes.count() + carriers.count()) {
            const OrderRow entry = plan.ordered(plan.class_begin() + at);
            bool merge = false;
            if (class_count > 0) {
                const OrderRow previous = plan.ordered(plan.class_begin() + class_count - 1);
                if (plan.compare_names(previous.nameBegin, previous.nameCount, entry.nameBegin, entry.nameCount) == 0) {
                    if ((previous.flags == 3 || entry.flags == 3 || previous.flags == entry.flags)) {
                        return plan.fail();
                    }
                    i64 id = previous.row;
                    if (entry.row >= 0) {
                        id = entry.row;
                    }
                    const OrderRow combined = OrderRow(id, 0, 0, previous.nameBegin, previous.nameCount, previous.flags
                        + entry.flags);
                    if (!plan.put_order(plan.class_begin() + class_count - 1, combined)) {
                        return false;
                    }
                    merge = true;
                }
            }
            if (!merge) {
                if (!plan.put_order(plan.class_begin() + class_count, entry)) {
                    return false;
                }
                class_count = class_count + 1;
            }
            at = at + 1;
        }
        // Descriptor, view and enum order is independent of producer order.
        i64 group = 3;
        while (group <= 5) {
            const compiler_lowering::OperandRow list = session.view_operand(module_row.operand_begin() + group);
            at = 0;
            while (at < list.count()) {
                const compiler_lowering::OperandRow reference = session.view_operand(list.begin() + at);
                const compiler_lowering::OutputRow row = session.view_output(reference.signed_value());
                const compiler_lowering::OperandRow key = session.view_operand(row.operand_begin());
                i64 name_begin = 0;
                i64 name_count = 0;
                if (group == 5) {
                    const TextRange name = plan.row_name(reference.signed_value());
                    name_begin = name.begin;
                    name_count = name.count;
                }
                const OrderRow entry = OrderRow(reference.signed_value(), key.signed_value(), 0, name_begin, name_count,
                    0);
                if (!plan.put_order(list.begin() + at, entry)) {
                    return false;
                }
                at = at + 1;
            }
            if (!plan.sort_order(list.begin(), list.count(), group == 5)) {
                return false;
            }
            at = 1;
            while (at < list.count()) {
                const OrderRow previous = plan.ordered(list.begin() + at - 1);
                const OrderRow entry = plan.ordered(list.begin() + at);
                if ((group != 5 && previous.key == entry.key) || (group == 5 && plan.compare_names(previous.nameBegin,
                    previous.nameCount, entry.nameBegin, entry.nameCount) == 0)) {
                    return plan.fail();
                }
                at = at + 1;
            }
            group = group + 1;
        }
        // Each reflection view is a sorted unique subset of declared IDs.
        i64 view = 0;
        while (view < views.count()) {
            const OrderRow selected = plan.ordered(views.begin() + view);
            const compiler_lowering::OutputRow row = session.view_output(selected.row);
            const compiler_lowering::OperandRow visible = session.view_operand(row.operand_begin() + 1);
            at = 0;
            while (at < visible.count()) {
                const compiler_lowering::OperandRow value = session.view_operand(visible.begin() + at);
                i64 first = 0;
                i64 last = descriptors.count();
                while (first < last) {
                    const i64 middle = first + (last - first) / 2;
                    const OrderRow candidate = plan.ordered(descriptors.begin() + middle);
                    if (candidate.key < value.signed_value()) {
                        first = middle + 1;
                    } else {
                        last = middle;
                    }
                }
                if (first >= descriptors.count()) {
                    return plan.fail();
                }
                const OrderRow found = plan.ordered(descriptors.begin() + first);
                if (found.key != value.signed_value()) {
                    return plan.fail();
                }
                const OrderRow entry = OrderRow(-1, value.signed_value(), 0, 0, 0, 0);
                if (!plan.put_order(visible.begin() + at, entry)) {
                    return false;
                }
                at = at + 1;
            }
            if (!plan.sort_order(visible.begin(), visible.count(), false)) {
                return false;
            }
            at = 1;
            while (at < visible.count()) {
                const OrderRow previous = plan.ordered(visible.begin() + at - 1);
                const OrderRow entry = plan.ordered(visible.begin() + at);
                if (previous.key == entry.key) {
                    return plan.fail();
                }
                at = at + 1;
            }
            view = view + 1;
        }
        i64 function = 0;
        while (function < functions.count()) {
            const compiler_lowering::OperandRow reference = session.view_operand(functions.begin() + function);
            const TextRange name = plan.row_name(reference.signed_value());
            const OrderRow lookup = OrderRow(reference.signed_value(), 0, function, name.begin, name.count, 0);
            if (!plan.put_order(plan.lookup_begin() + function, lookup)) {
                return false;
            }
            const compiler_lowering::OutputRow row = session.view_output(reference.signed_value());
            const compiler_lowering::OperandRow slots = session.view_operand(row.operand_begin() + 4);
            at = 0;
            while (at < slots.count()) {
                const compiler_lowering::OperandRow slot_ref = session.view_operand(slots.begin() + at);
                const compiler_lowering::OutputRow slot = session.view_output(slot_ref.signed_value());
                const compiler_lowering::OperandRow offset = session.view_operand(slot.operand_begin());
                const OrderRow entry = OrderRow(slot_ref.signed_value(), slot_rank(slot.kind()), offset.signed_value(),
                    0, 0, 0);
                if (!plan.put_order(slots.begin() + at, entry)) {
                    return false;
                }
                at = at + 1;
            }
            if (!plan.sort_order(slots.begin(), slots.count(), false)) {
                return false;
            }
            function = function + 1;
        }
        if (!plan.sort_order(plan.lookup_begin(), functions.count(), true)) {
            return false;
        }
        return plan.order_complete(class_count, functions.count());
    }
    auto scalar_at(const compiler_resolver::Session& session, i64 first, i64 offset) -> i64 {
        const compiler_lowering::OperandRow value = session.view_operand(first + offset);
        return value.signed_value();
    }
    auto emit_offsets(Plan& plan, const compiler_resolver::Session& session, i64 operand) -> bool {
        const compiler_lowering::OperandRow list = session.view_operand(operand);
        i64 at = 0;
        while (at < list.count()) {
            if (!plan.emit_index(scalar_at(session, list.begin(), at))) {
                return false;
            }
            at = at + 1;
        }
        return true;
    }
    auto emit_classes(Plan& plan, const compiler_resolver::Session& session) -> bool {
        const compiler_ir_metadata::FlagMasks masks = compiler_ir_metadata::FlagMasks();
        i64 at = 0;
        while (at < plan.class_count()) {
            const OrderRow selected = plan.ordered(plan.class_begin() + at);
            const TextRange original = TextRange(selected.nameBegin, selected.nameCount);
            const TextRange name = plan.text(original);
            const i64 index = plan.reserve(2, 1);
            const i64 leaf_begin = plan.current(4);
            const i64 field_begin = plan.current(3);
            i64 supplied = -1;
            u64 flags = 0u64;
            if (selected.flags == 1 || selected.flags == 3) {
                flags = masks.class_array_carrier();
            }
            if (selected.row >= 0) {
                flags = flags | masks.class_layout() | masks.class_fields() | masks.class_storage();
                const compiler_lowering::OutputRow row = session.view_output(selected.row);
                const compiler_lowering::OperandRow leaves = session.view_operand(row.operand_begin() + 1);
                const compiler_lowering::OperandRow fields = session.view_operand(row.operand_begin() + 2);
                i64 entry = 0;
                while (entry < leaves.count()) {
                    const i64 position = plan.reserve(4, 1);
                    if (position < 0 || plan.emit_type(scalar_at(session, leaves.begin(), entry), position) < 0) {
                        return false;
                    }
                    entry = entry + 1;
                }
                entry = 0;
                while (entry < fields.count()) {
                    const compiler_lowering::OutputRow field = session.view_output(scalar_at(session, fields.begin(),
                        entry));
                    const i64 position = plan.reserve(3, 1);
                    i64 type_position = position;
                    if (plan.status() == 7) {
                        type_position = plan.total(4) + position;
                    }
                    if (position < 0 || plan.emit_type(scalar_at(session, field.operand_begin(), 0), type_position) < 0
                        || !plan.put_integer(3, position, 0, type_position)) {
                        return false;
                    }
                    i64 word = 1;
                    while (word < 5) {
                        if (!plan.put_integer(3, position, word, scalar_at(session, field.operand_begin(), word))) {
                            return false;
                        }
                        word = word + 1;
                    }
                    entry = entry + 1;
                }
                const compiler_lowering::OutputRow storage = session.view_output(scalar_at(session, row.operand_begin(),
                    3));
                const compiler_lowering::OperandRow leaf_offsets = session.view_operand(storage.operand_begin());
                const compiler_lowering::OperandRow field_offsets = session.view_operand(storage.operand_begin() + 1);
                supplied = plan.reserve(5, 1);
                const i64 offsets_begin = plan.current(6);
                if (supplied < 0 || !emit_offsets(plan, session, storage.operand_begin()) || !emit_offsets(plan,
                    session, storage.operand_begin() + 1) || !plan.put_integer(5, supplied, 0, offsets_begin)
                    || !plan.put_integer(5, supplied, 1, leaf_offsets.count()) || !plan.put_integer(5, supplied, 2,
                    offsets_begin + leaf_offsets.count()) || !plan.put_integer(5, supplied, 3, field_offsets.count())) {
                    return false;
                }
                i64 word = 4;
                while (word < 7) {
                    if (!plan.put_integer(5, supplied, word, scalar_at(session, storage.operand_begin(), word - 2))) {
                        return false;
                    }
                    word = word + 1;
                }
            }
            if (index < 0 || name.begin < 0 || !plan.put_integer(2, index, 0, name.begin) || !plan.put_integer(2, index,
                1, name.count) || !plan.put_integer(2, index, 2, leaf_begin) || !plan.put_integer(2, index, 3,
                plan.current(4) - leaf_begin) || !plan.put_integer(2, index, 4, field_begin) || !plan.put_integer(2,
                index, 5, plan.current(3) - field_begin) || !plan.put_integer(2, index, 6, supplied)
                || !plan.put_word(2, index, 7, flags)) {
                return plan.fail();
            }
            at = at + 1;
        }
        return true;
    }
    auto emit_maps(Plan& plan, const compiler_resolver::Session& session) -> bool {
        const compiler_lowering::OutputRow module_row = session.view_output(plan.root());
        i64 group = 3;
        while (group <= 5) {
            const compiler_lowering::OperandRow list = session.view_operand(module_row.operand_begin() + group);
            i64 at = 0;
            while (at < list.count()) {
                const OrderRow selected = plan.ordered(list.begin() + at);
                const compiler_lowering::OutputRow row = session.view_output(selected.row);
                const i64 pool = group + 4;
                const i64 index = plan.reserve(pool, 1);
                if (index < 0) {
                    return false;
                }
                if (group == 3) {
                    i64 field = 0;
                    while (field < 3) {
                        if (!plan.put_integer(pool, index, field, scalar_at(session, row.operand_begin(), field))) {
                            return false;
                        }
                        field = field + 1;
                    }
                }
                if (group == 4) {
                    const compiler_lowering::OperandRow visible = session.view_operand(row.operand_begin() + 1);
                    const i64 first = plan.current(6);
                    i64 item = 0;
                    while (item < visible.count()) {
                        const OrderRow descriptor = plan.ordered(visible.begin() + item);
                        if (!plan.emit_index(descriptor.key)) {
                            return false;
                        }
                        item = item + 1;
                    }
                    if (!plan.put_integer(pool, index, 0, selected.key) || !plan.put_integer(pool, index, 1, first)
                        || !plan.put_integer(pool, index, 2, visible.count())) {
                        return false;
                    }
                }
                if (group == 5) {
                    const TextRange original = TextRange(selected.nameBegin, selected.nameCount);
                    const TextRange name = plan.text(original);
                    if (name.begin < 0 || !plan.put_integer(pool, index, 0, name.begin) || !plan.put_integer(pool,
                        index, 1, name.count) || !plan.put_integer(pool, index, 2, scalar_at(session,
                        row.operand_begin(), 1))) {
                        return false;
                    }
                }
                at = at + 1;
            }
            group = group + 1;
        }
        return true;
    }
    auto emit_slots(Plan& plan, const compiler_resolver::Session& session, i64 operand) -> bool {
        const compiler_lowering::OperandRow slots = session.view_operand(operand);
        i64 at = 0;
        while (at < slots.count()) {
            const OrderRow selected = plan.ordered(slots.begin() + at);
            const compiler_lowering::OutputRow row = session.view_output(selected.row);
            const i64 index = plan.reserve(11, 1);
            i64 type = 0;
            i64 length = 0;
            i64 mutable_value = 0;
            if (row.kind() == compiler_lowering::RecordKind::ScalarSlot) {
                type = plan.emit_type(scalar_at(session, row.operand_begin(), 1), -1);
            }
            if (row.kind() == compiler_lowering::RecordKind::ObjectSlot || row.kind()
                == compiler_lowering::RecordKind::OwnedValueType) {
                const compiler_lowering::OperandRow identity = session.view_operand(row.operand_begin() + 1);
                i64 kind = 5;
                if (row.kind() == compiler_lowering::RecordKind::OwnedValueType) {
                    kind = 17;
                }
                if (identity.role() == compiler_lowering::OperandRole::CarrierId) {
                    const TextRange name = plan.row_name(identity.signed_value());
                    type = plan.emit_named_type(kind, name);
                } else {
                    const TextRange name = plan.identity_name(5, identity.signed_value());
                    type = plan.emit_named_type(kind, name);
                }
                if (row.kind() == compiler_lowering::RecordKind::ObjectSlot) {
                    mutable_value = scalar_at(session, row.operand_begin(), 2);
                }
            }
            if (row.kind() == compiler_lowering::RecordKind::ArraySlot) {
                length = scalar_at(session, row.operand_begin(), 1);
            }
            if (row.kind() == compiler_lowering::RecordKind::ByteSlot) {
                mutable_value = scalar_at(session, row.operand_begin(), 1);
            }
            if (index < 0 || type < 0 || !plan.put_integer(11, index, 0, selected.key) || !plan.put_integer(11, index,
                1, selected.tie) || !plan.put_integer(11, index, 2, type) || !plan.put_integer(11, index, 3, length)
                || !plan.put_integer(11, index, 4, mutable_value)) {
                return plan.fail();
            }
            at = at + 1;
        }
        return true;
