    class Inspection {
    public:
        i64 status;
        i64 instructions;
        i64 prefixes;
        i64 nested;
        i64 types;
        i64 literals;
        Inspection(i64 code, i64 rows, i64 fields, i64 lists, i64 type_count, i64 bytes) : status(code),
            instructions(rows), prefixes(fields), nested(lists), types(type_count), literals(bytes) {
        }
    };
    auto valid_operator(compiler_lowering::OutputRow row) -> bool {
        if (row.form() == compiler_lowering::InstructionForm::UnaryValue) {
            return row.unary_operation() == compiler_lowering::Unary::CheckedNegate || row.unary_operation()
                == compiler_lowering::Unary::LogicalNot || row.unary_operation() == compiler_lowering::Unary::BitNot;
        }
        if (row.form() == compiler_lowering::InstructionForm::BinaryValue) {
            return row.binary_operation() == compiler_lowering::Binary::CheckedAdd || row.binary_operation()
                == compiler_lowering::Binary::CheckedSubtract || row.binary_operation()
                == compiler_lowering::Binary::CheckedMultiply || row.binary_operation()
                == compiler_lowering::Binary::CheckedDivide || row.binary_operation()
                == compiler_lowering::Binary::CheckedRemainder || row.binary_operation()
                == compiler_lowering::Binary::BitAnd || row.binary_operation() == compiler_lowering::Binary::BitOr
                || row.binary_operation() == compiler_lowering::Binary::BitXor || row.binary_operation()
                == compiler_lowering::Binary::ShiftLeft || row.binary_operation()
                == compiler_lowering::Binary::ShiftRight;
        }
        if (row.form() == compiler_lowering::InstructionForm::Compare) {
            return row.comparison_operation() == compiler_lowering::Comparison::Equal || row.comparison_operation()
                == compiler_lowering::Comparison::NotEqual || row.comparison_operation()
                == compiler_lowering::Comparison::Less || row.comparison_operation()
                == compiler_lowering::Comparison::Greater || row.comparison_operation()
                == compiler_lowering::Comparison::LessEqual || row.comparison_operation()
                == compiler_lowering::Comparison::GreaterEqual;
        }
        if (row.form() == compiler_lowering::InstructionForm::MetadataQuery) {
            return row.query() == compiler_lowering::Query::Size || row.query()
                == compiler_lowering::Query::PublicFieldCount;
        }
        return true;
    }
    auto count_instruction_prefixes(const compiler_resolver::Session& session) -> Inspection {
