        }
        return -1;
    }
    auto emit_operand(Plan& plan, i64 index, compiler_lowering::OperandRole role, i64 signed_value, u64 unsigned_value,
        TextRange slice) -> bool {
        return plan.put_integer(14, index, 0, role_number(role)) && plan.put_integer(14, index, 1, signed_value)
            && plan.put_word(14, index, 2, unsigned_value) && plan.put_integer(14, index, 3, slice.begin)
            && plan.put_integer(14, index, 4, slice.count);
    }
    auto emit_instruction(Plan& plan, const compiler_resolver::Session& session, i64 id) -> bool {
        const compiler_lowering::OutputRow row = session.view_output(id);
        const i64 instruction = plan.reserve(13, 1);
        const i64 begin = plan.reserve(14, row.operand_count());
        if (instruction < 0 || begin < 0) {
            return false;
        }
        i64 at = 0;
        while (at < row.operand_count()) {
            const Shape shape = instruction_shape(row.form(), at);
            const compiler_lowering::OperandRow value = session.view_operand(row.operand_begin() + at);
            i64 scalar = 0;
            u64 unsigned_scalar = 0u64;
            i64 slice_begin = 0;
            i64 slice_count = 0;
            compiler_lowering::OperandRole role = value.role();
            if (shape.mode == 1 || shape.mode == 2 || shape.mode == 6) {
                scalar = value.signed_value();
            }
            if (shape.mode == 3) {
                scalar = plan.emit_type(value.signed_value(), -1);
                if (scalar < 0) {
                    return false;
                }
            }
            if (shape.mode == 4 || shape.mode == 5) {
                const TextRange original = plan.identity_name(shape.mode, value.signed_value());
                const TextRange name = plan.text(original);
                if (name.begin < 0) {
                    return false;
                }
                slice_begin = name.begin;
                slice_count = name.count;
                role = compiler_lowering::OperandRole::CalleeName;
                if (shape.mode == 5) {
                    role = compiler_lowering::OperandRole::ClassName;
                }
            }
            if (shape.mode == 7 || shape.mode == 8) {
                scalar = plan.identity_value(shape.mode, value.signed_value());
            }
            if (shape.mode >= 9 && shape.mode <= 11) {
                slice_begin = plan.reserve(14, value.count());
                slice_count = value.count();
                if (slice_begin < 0) {
                    return false;
                }
                i64 nested = 0;
                while (nested < value.count()) {
                    const compiler_lowering::OperandRow item = session.view_operand(value.begin() + nested);
                    i64 payload = item.signed_value();
                    if (shape.mode == 10 && nested % 2 == 1) {
                        payload = plan.identity_value(7, payload);
                    }
                    const TextRange empty = TextRange(0, 0);
                    if (!emit_operand(plan, slice_begin + nested, item.role(), payload, 0u64, empty)) {
                        return false;
                    }
                    nested = nested + 1;
                }
            }
            if (shape.mode == 12) {
                slice_begin = plan.current(15);
                slice_count = value.count();
                i64 byte = 0;
                while (byte < value.count()) {
                    const i64 payload = session.view_source(value.begin() + byte);
                    if (payload < 0 || payload > 255 || !plan.literal_byte(u8(payload))) {
                        return plan.fail();
                    }
                    byte = byte + 1;
                }
            }
            if (shape.mode == 13) {
                if (role == compiler_lowering::OperandRole::UnsignedConstant) {
                    unsigned_scalar = value.unsigned_value();
                } else {
                    scalar = value.signed_value();
                }
            }
            const TextRange slice = TextRange(slice_begin, slice_count);
            if (!emit_operand(plan, begin + at, role, scalar, unsigned_scalar, slice)) {
                return false;
            }
            at = at + 1;
        }
        i64 unary = 0;
        i64 binary = 0;
        i64 comparison = 0;
        i64 query = 0;
        if (row.form() == compiler_lowering::InstructionForm::UnaryValue) {
            unary = unary_number(row.unary_operation());
        }
        if (row.form() == compiler_lowering::InstructionForm::BinaryValue) {
            binary = binary_number(row.binary_operation());
        }
        if (row.form() == compiler_lowering::InstructionForm::Compare) {
            comparison = comparison_number(row.comparison_operation());
        }
        if (row.form() == compiler_lowering::InstructionForm::MetadataQuery) {
            query = query_number(row.query());
        }
        return plan.put_integer(13, instruction, 0, 1) && plan.put_integer(13, instruction, 1, form_number(row.form()))
            && plan.put_integer(13, instruction, 2, unary) && plan.put_integer(13, instruction, 3, binary)
            && plan.put_integer(13, instruction, 4, comparison) && plan.put_integer(13, instruction, 5, query)
            && plan.put_integer(13, instruction, 6, begin) && plan.put_integer(13, instruction, 7, row.operand_count());
    }
    auto emit_bodies(Plan& plan, const compiler_resolver::Session& session) -> bool {
        const compiler_lowering::OutputRow module_row = session.view_output(plan.root());
        const compiler_lowering::OperandRow functions = session.view_operand(module_row.operand_begin());
        i64 at = 0;
        while (at < functions.count()) {
            const compiler_lowering::OutputRow row = session.view_output(scalar_at(session, functions.begin(), at));
            const compiler_lowering::OperandRow code = session.view_operand(row.operand_begin() + 10);
            const i64 begin = plan.current(13);
            const i64 body = plan.reserve(16, 1);
            i64 instruction = 0;
            while (instruction < code.count()) {
                if (!emit_instruction(plan, session, scalar_at(session, code.begin(), instruction))) {
                    return false;
                }
                instruction = instruction + 1;
            }
            if (body < 0 || !plan.put_integer(16, body, 0, begin) || !plan.put_integer(16, body, 1, code.count())
                || !plan.put_integer(16, body, 2, code.count()) || !plan.put_integer(16, body, 3, 0)) {
                return plan.fail();
            }
            at = at + 1;
        }
        return true;
    }
    auto emit_plan(Plan& plan, const compiler_resolver::Session& session) -> bool {
        if (!plan.begin_measure() || !emit_classes(plan, session) || !emit_maps(plan, session) || !emit_functions(plan,
            session) || !plan.mark_instructions() || !emit_bodies(plan, session) || !plan.begin_fill()
            || !emit_classes(plan, session) || !emit_maps(plan, session) || !emit_functions(plan, session)
            || !plan.mark_instructions() || !emit_bodies(plan, session)) {
            return plan.fail();
        }
        return plan.complete_fill();
    }
    auto fill_metadata(compiler_ir_metadata::MetadataStore& store, const Plan& plan) -> bool {
        if (plan.status() != 8 || store.leaf_count() != plan.total(4) || store.instruction_type_begin()
            != plan.total(12) || !store.begin_projection_fill()) {
            return store.reject(compiler_ir_metadata::MetadataError::integrity);
        }
        i64 at = 0;
        while (at < plan.total(0)) {
            if (!store.projection_byte(at, plan.output_byte(at))) {
                return false;
            }
            at = at + 1;
        }
        at = 0;
        while (at < plan.total(1)) {
            const compiler_ir_metadata::RawTypeRow row = compiler_ir_metadata::RawTypeRow(plan.integer(1, at, 0),
                compiler_ir_metadata::ByteRange(plan.integer(1, at, 1), plan.integer(1, at, 2)),
                compiler_ir_metadata::RawTypeTail(plan.integer(1, at, 3), plan.integer(1, at, 4), plan.bits(1, at, 5),
                plan.bits(1, at, 6), plan.bits(1, at, 7)));
            if (!store.projection_type(at, row)) {
                return false;
            }
            at = at + 1;
        }
        at = 0;
        while (at < plan.total(2)) {
            const compiler_ir_metadata::ClassRow row = compiler_ir_metadata::ClassRow(compiler_ir_metadata::ByteRange(
                plan.integer(2, at, 0), plan.integer(2, at, 1)), compiler_ir_metadata::IndexRange(plan.integer(2, at,
                2), plan.integer(2, at, 3)), compiler_ir_metadata::IndexRange(plan.integer(2, at, 4), plan.integer(2,
                at, 5)), plan.integer(2, at, 6), plan.bits(2, at, 7));
            if (!store.projection_class(at, row)) {
                return false;
            }
            at = at + 1;
        }
        at = 0;
        while (at < plan.total(3)) {
            const compiler_ir_metadata::FieldRow row = compiler_ir_metadata::FieldRow(plan.integer(3, at, 0),
                plan.integer(3, at, 1), plan.integer(3, at, 2), plan.integer(3, at, 3), plan.integer(3, at, 4));
            if (!store.projection_field(at, row)) {
                return false;
            }
            at = at + 1;
        }
        at = 0;
        while (at < plan.total(5)) {
            const compiler_ir_metadata::StorageRow row = compiler_ir_metadata::StorageRow(
                compiler_ir_metadata::IndexRange(plan.integer(5, at, 0), plan.integer(5, at, 1)),
                compiler_ir_metadata::IndexRange(plan.integer(5, at, 2), plan.integer(5, at, 3)),
                compiler_ir_metadata::PhysicalExtent(plan.integer(5, at, 4), plan.integer(5, at, 5), plan.integer(5, at,
                6)));
            if (!store.projection_storage(at, row)) {
                return false;
            }
            at = at + 1;
        }
        at = 0;
        while (at < plan.total(6)) {
            const compiler_ir_metadata::IndexRow row = compiler_ir_metadata::IndexRow(plan.integer(6, at, 0));
            if (!store.projection_index(at, row)) {
                return false;
            }
            at = at + 1;
        }
        at = 0;
        while (at < plan.total(7)) {
            const compiler_ir_metadata::DescriptorRow row = compiler_ir_metadata::DescriptorRow(plan.integer(7, at, 0),
                plan.integer(7, at, 1), plan.integer(7, at, 2));
            if (!store.projection_descriptor(at, row)) {
                return false;
            }
            at = at + 1;
        }
        at = 0;
        while (at < plan.total(8)) {
            const compiler_ir_metadata::ViewRow row = compiler_ir_metadata::ViewRow(plan.integer(8, at, 0),
                compiler_ir_metadata::IndexRange(plan.integer(8, at, 1), plan.integer(8, at, 2)));
            if (!store.projection_view(at, row)) {
                return false;
            }
            at = at + 1;
        }
        at = 0;
        while (at < plan.total(9)) {
            const compiler_ir_metadata::EnumRow row = compiler_ir_metadata::EnumRow(compiler_ir_metadata::ByteRange(
                plan.integer(9, at, 0), plan.integer(9, at, 1)), plan.integer(9, at, 2));
            if (!store.projection_enum(at, row)) {
                return false;
            }
            at = at + 1;
        }
        at = 0;
        while (at < plan.total(10)) {
            const compiler_ir_metadata::CallableRow row = compiler_ir_metadata::CallableRow(
                compiler_ir_metadata::ByteRange(plan.integer(10, at, 0), plan.integer(10, at, 1)),
                compiler_ir_metadata::IndexRange(plan.integer(10, at, 2), plan.integer(10, at, 3)), plan.integer(10, at,
                4), compiler_ir_metadata::ReceiverShape(compiler_ir_metadata::ByteRange(plan.integer(10, at, 5),
                plan.integer(10, at, 6)), plan.bits(10, at, 7)), compiler_ir_metadata::CallableOptions(plan.bits(10, at,
                10), plan.integer(10, at, 11), plan.integer(10, at, 12), plan.integer(10, at, 8), plan.integer(10, at,
                9)), compiler_ir_metadata::IndexRange(plan.integer(10, at, 13), plan.integer(10, at, 14)));
            if (!store.projection_callable(at, row)) {
                return false;
            }
            at = at + 1;
        }
        at = 0;
        while (at < plan.total(11)) {
            const compiler_ir_metadata::SlotRow row = compiler_ir_metadata::SlotRow(plan.integer(11, at, 0),
                plan.integer(11, at, 1), plan.integer(11, at, 2), plan.integer(11, at, 3), plan.integer(11, at, 4));
            if (!store.projection_slot(at, row)) {
                return false;
            }
            at = at + 1;
        }
        return store.complete_projection();
    }
    auto fill_instructions(compiler_ir_instructions::InstructionStore& store, const Plan& plan) -> bool {
        if (plan.status() != 8 || !store.begin_direct_projection()) {
            return store.reject(compiler_ir_instructions::InstructionError::integrity);
        }
        i64 at = 0;
        while (at < plan.total(13)) {
            compiler_ir_instructions::RawInstructionRow row = compiler_ir_instructions::RawInstructionRow(plan.integer(
                13, at, 0), plan.integer(13, at, 1), plan.integer(13, at, 6), plan.integer(13, at, 7));
            row.operators(plan.integer(13, at, 2), plan.integer(13, at, 3), plan.integer(13, at, 4), plan.integer(13,
                at, 5));
            if (!store.projection_instruction(row)) {
                return false;
            }
            at = at + 1;
        }
        at = 0;
        while (at < plan.total(14)) {
            const compiler_ir_instructions::RawOperandRow row = compiler_ir_instructions::RawOperandRow(plan.integer(14,
                at, 0), plan.integer(14, at, 1), plan.bits(14, at, 2), plan.integer(14, at, 3), plan.integer(14, at,
                4));
            if (!store.projection_operand(row)) {
                return false;
            }
            at = at + 1;
        }
        at = 0;
        while (at < plan.total(15)) {
            if (!store.projection_literal(plan.output_byte(plan.total(0) + at))) {
                return false;
            }
            at = at + 1;
        }
        at = 0;
        while (at < plan.total(16)) {
            const compiler_ir_instructions::BodyRow row = compiler_ir_instructions::BodyRow(plan.integer(16, at, 0),
                plan.integer(16, at, 1), plan.integer(16, at, 2), plan.integer(16, at, 3));
            if (!store.projection_body(row)) {
                return false;
            }
            at = at + 1;
        }
        return store.complete_projection();
    }

    auto finish_plan(Plan& plan, const compiler_resolver::Session& session) -> bool {
        if (!plan.matches_session(session.projection_stamp(), session.output_count(), session.operand_count())) {
            return plan.fail();
        }
        const i64 root = plan.root();
        return bind_domains(plan, session) && canonical_order(plan, session, root) && emit_plan(plan, session);
    }
}
