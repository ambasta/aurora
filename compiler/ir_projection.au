                return Shape(compiler_lowering::OperandRole::invalid, 14);
            }
            return Shape(compiler_lowering::OperandRole::invalid, 0);
        }
        if (form == compiler_lowering::InstructionForm::ServiceOperation) {
            if (position == 0) {
                return Shape(compiler_lowering::OperandRole::Offset, 1);
            }
            if (position == 1) {
                return Shape(compiler_lowering::OperandRole::ServiceOperationId, 8);
            }
            if (position == 2) {
                return Shape(compiler_lowering::OperandRole::ResultOffset, 1);
            }
            if (position == 3) {
                return Shape(compiler_lowering::OperandRole::ServiceKindId, 7);
            }
            if (position == 4) {
                return Shape(compiler_lowering::OperandRole::invalid, 14);
            }
            return Shape(compiler_lowering::OperandRole::invalid, 0);
        }
        if (form == compiler_lowering::InstructionForm::ServiceCall) {
            if (position == 0) {
                return Shape(compiler_lowering::OperandRole::CalleeSymbolId, 4);
            }
            if (position == 1) {
                return Shape(compiler_lowering::OperandRole::LoanId, 1);
            }
            if (position == 2) {
                return Shape(compiler_lowering::OperandRole::ResultOffset, 1);
            }
            if (position == 3) {
                return Shape(compiler_lowering::OperandRole::SpanArguments, 9);
            }
            if (position == 4) {
                return Shape(compiler_lowering::OperandRole::ServiceKindId, 7);
            }
            if (position == 5) {
                return Shape(compiler_lowering::OperandRole::AdditionalServices, 10);
            }
            if (position == 6) {
                return Shape(compiler_lowering::OperandRole::ObjectArguments, 9);
            }
            if (position == 7) {
                return Shape(compiler_lowering::OperandRole::invalid, 14);
            }
            return Shape(compiler_lowering::OperandRole::invalid, 0);
        }
        if (form == compiler_lowering::InstructionForm::Constant) {
            if (position == 0) {
                return Shape(compiler_lowering::OperandRole::SignedConstant, 13);
