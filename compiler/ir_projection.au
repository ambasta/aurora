                i64 position = 0;
                while (position < row.operand_count()) {
                    const Shape shape = instruction_shape(row.form(), position);
                    const compiler_lowering::OperandRow operand = session.view_operand(row.operand_begin() + position);
                    if (shape.mode <= 0 || shape.mode >= 14 || (operand.role() != shape.role && !(shape.mode == 13
                        && operand.role() == compiler_lowering::OperandRole::UnsignedConstant))) {
                        return Inspection(3, id, position, 0, 0, 0);
                    }
                    if (shape.mode == 1 && (operand.signed_value() < -2147483648 || operand.signed_value()
                        > 2147483647)) {
                        return Inspection(4, id, position, 0, 0, 0);
                    }
                    if (shape.mode == 2 && operand.signed_value() != 0 && operand.signed_value() != 1) {
                        return Inspection(5, id, position, 0, 0, 0);
                    }
                    if ((shape.mode >= 3 && shape.mode <= 8 && operand.signed_value() < 0) || (shape.mode == 6
                        && operand.signed_value() > 2147483647)) {
                        return Inspection(6, id, position, 0, 0, 0);
                    }
                    if (shape.mode >= 9 && shape.mode <= 11) {
                        if (operand.begin() < 0 || operand.count() < 0 || operand.begin() > session.operand_count()
                            || operand.count() > session.operand_count() - operand.begin()) {
                            return Inspection(7, id, position, 0, 0, 0);
                        }
                        if ((shape.mode == 10 || shape.mode == 11) && operand.count() % 2 != 0) {
                            return Inspection(8, id, position, 0, 0, 0);
                        }
                        if (shape.mode == 11 && (operand.count() == 0 || operand.count() > 12)) {
                            return Inspection(9, id, position, 0, 0, 0);
                        }
                        i64 at = 0;
                        while (at < operand.count()) {
                            const compiler_lowering::OperandRow item = session.view_operand(operand.begin() + at);
                            compiler_lowering::OperandRole expected = compiler_lowering::OperandRole::Offset;
                            if (shape.mode == 10) {
                                expected = compiler_lowering::OperandRole::ServiceLoanId;
                                if (at % 2 == 1) {
                                    expected = compiler_lowering::OperandRole::ServiceKindId;
                                }
                            }
                            if (shape.mode == 11) {
                                expected = compiler_lowering::OperandRole::Root;
                                if (at % 2 == 1) {
                                    expected = compiler_lowering::OperandRole::LoanId;
                                }
                            }
                            if (item.role() != expected || (expected == compiler_lowering::OperandRole::ServiceKindId
                                && item.signed_value() < 0) || (expected
                                != compiler_lowering::OperandRole::ServiceKindId && (item.signed_value() < -2147483648
                                || item.signed_value() > 2147483647))) {
                                return Inspection(10, id, position, at, 0, 0);
                            }
                            at = at + 1;
