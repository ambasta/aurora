    class Shape {
    public:
        compiler_lowering::OperandRole role;
        i64 mode;
        Shape(compiler_lowering::OperandRole value, i64 category) : role(value), mode(category) {
        }
    };
    // Closed prototype field walk. Mode zero rejects; fourteen ends a prefix.
    auto instruction_shape(compiler_lowering::InstructionForm form, i64 position) -> Shape {
        if (form == compiler_lowering::InstructionForm::BindServiceParameter) {
            if (position == 0) {
                return Shape(compiler_lowering::OperandRole::Index, 1);
            }
            if (position == 1) {
                return Shape(compiler_lowering::OperandRole::Offset, 1);
            }
            if (position == 2) {
                return Shape(compiler_lowering::OperandRole::ServiceKindId, 7);
            }
            if (position == 3) {
                return Shape(compiler_lowering::OperandRole::invalid, 14);
            }
            return Shape(compiler_lowering::OperandRole::invalid, 0);
        }
        if (form == compiler_lowering::InstructionForm::AcquireServiceLoan) {
            if (position == 0) {
                return Shape(compiler_lowering::OperandRole::LoanId, 1);
            }
            if (position == 1) {
                return Shape(compiler_lowering::OperandRole::Offset, 1);
            }
            if (position == 2) {
                return Shape(compiler_lowering::OperandRole::ServiceKindId, 7);
            }
            if (position == 3) {
                return Shape(compiler_lowering::OperandRole::invalid, 14);
            }
            return Shape(compiler_lowering::OperandRole::invalid, 0);
        }
        if (form == compiler_lowering::InstructionForm::ReleaseServiceLoan) {
            if (position == 0) {
                return Shape(compiler_lowering::OperandRole::LoanId, 1);
            }
            if (position == 1) {
                return Shape(compiler_lowering::OperandRole::ServiceKindId, 7);
            }
