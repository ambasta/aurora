                    }
                    if (shape.mode == 12) {
                        if (operand.begin() < 0 || operand.count() < 0 || operand.begin() > session.source_size()
                            || operand.count() > session.source_size() - operand.begin()) {
                            return Inspection(11, id, position, 0, 0, 0);
                        }
                        if (row.kind() == compiler_lowering::RecordKind::Instruction) {
                            if (operand.count() > 9223372036854775807 - literals) {
                                return Inspection(13, id, position, 0, 0, 0);
                            }
                            literals = literals + operand.count();
                        }
                    }
                    if (shape.mode == 3 && row.kind() == compiler_lowering::RecordKind::Instruction) {
                        if (types == 9223372036854775807) {
                            return Inspection(13, id, position, 0, 0, 0);
                        }
                        types = types + 1;
                    }
                    position = position + 1;
                }
                if (row.kind() == compiler_lowering::RecordKind::Instruction) {
                    if (rows == 9223372036854775807 || row.operand_count() > 9223372036854775807 - fields) {
                        return Inspection(13, id, 0, 0, 0, 0);
                    }
                    rows = rows + 1;
                    fields = fields + row.operand_count();
                }
            }
            id = id + 1;
        }
        return Inspection(0, rows, fields, lists, types, literals);
    }
