    auto emit_functions(Plan& plan, const compiler_resolver::Session& session) -> bool {
        const compiler_ir_metadata::FlagMasks masks = compiler_ir_metadata::FlagMasks();
        const compiler_lowering::OutputRow module_row = session.view_output(plan.root());
        const compiler_lowering::OperandRow functions = session.view_operand(module_row.operand_begin());
        i64 at = 0;
        while (at < functions.count()) {
            const i64 id = scalar_at(session, functions.begin(), at);
            const compiler_lowering::OutputRow row = session.view_output(id);
            const TextRange original = plan.row_name(id);
            const TextRange name = plan.text(original);
            const i64 index = plan.reserve(10, 1);
            const i64 type_begin = plan.current(1);
            if (plan.emit_type(scalar_at(session, row.operand_begin(), 2), -1) < 0) {
                return false;
            }
            const compiler_lowering::OperandRow parameters = session.view_operand(row.operand_begin() + 3);
            i64 parameter = 0;
            while (parameter < parameters.count()) {
                if (plan.emit_type(scalar_at(session, parameters.begin(), parameter), -1) < 0) {
                    return false;
                }
                parameter = parameter + 1;
            }
            const i64 slot_begin = plan.current(11);
            if (!emit_slots(plan, session, row.operand_begin() + 4)) {
                return false;
            }
            const compiler_lowering::OperandRow receiver = session.view_operand(row.operand_begin() + 5);
            const compiler_lowering::OperandRow span = session.view_operand(row.operand_begin() + 8);
            i64 receiver_begin = 0;
            i64 receiver_count = 0;
            u64 receiver_flags = 0u64;
            u64 flags = 0u64;
            i64 span_field = 0;
            if (receiver.role() == compiler_lowering::OperandRole::ReceiverRef) {
                flags = flags | masks.callable_receiver();
                const compiler_lowering::OutputRow receiver_row = session.view_output(receiver.signed_value());
                const TextRange receiver_original = plan.row_name(receiver.signed_value());
                const TextRange receiver_name = plan.text(receiver_original);
                if (receiver_name.begin < 0) {
                    return false;
                }
                receiver_begin = receiver_name.begin;
                receiver_count = receiver_name.count;
                if (scalar_at(session, receiver_row.operand_begin(), 1) != 0) {
                    receiver_flags = receiver_flags | masks.receiver_mutable();
                }
                if (scalar_at(session, receiver_row.operand_begin(), 2) != 0) {
                    receiver_flags = receiver_flags | masks.receiver_constructor();
                }
                if (scalar_at(session, receiver_row.operand_begin(), 3) != 0) {
                    receiver_flags = receiver_flags | masks.receiver_public();
                }
            }
            if (span.role() == compiler_lowering::OperandRole::ReceiverSpanField) {
                flags = flags | masks.callable_span_summary();
                span_field = span.signed_value();
            }
            if (index < 0 || name.begin < 0 || !plan.put_integer(10, index, 0, name.begin) || !plan.put_integer(10,
                index, 1, name.count) || !plan.put_integer(10, index, 2, type_begin) || !plan.put_integer(10, index, 3,
                parameters.count() + 1) || !plan.put_integer(10, index, 4, scalar_at(session, row.operand_begin(), 1))
                || !plan.put_integer(10, index, 5, receiver_begin) || !plan.put_integer(10, index, 6, receiver_count)
                || !plan.put_word(10, index, 7, receiver_flags) || !plan.put_integer(10, index, 8, scalar_at(session,
                row.operand_begin(), 6)) || !plan.put_integer(10, index, 9, scalar_at(session, row.operand_begin(), 7))
                || !plan.put_word(10, index, 10, flags) || !plan.put_integer(10, index, 11, span_field)
                || !plan.put_integer(10, index, 12, scalar_at(session, row.operand_begin(), 9)) || !plan.put_integer(10,
                index, 13, slot_begin) || !plan.put_integer(10, index, 14, plan.current(11) - slot_begin)) {
                return plan.fail();
            }
            at = at + 1;
        }
        at = 0;
        while (at < functions.count()) {
            const OrderRow lookup = plan.ordered(plan.lookup_begin() + at);
            if (!plan.emit_index(lookup.tie)) {
                return false;
            }
            at = at + 1;
        }
        return true;
    }
