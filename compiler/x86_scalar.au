export module aurora.compiler.x86_scalar;
import aurora.compiler.x86_storage;
import aurora.compiler.x86_object_storage;
import aurora.compiler.x86_helpers;
import aurora.compiler.ir_metadata_storage;
import aurora.compiler.ir_instruction_storage;

export namespace compiler_x86 {
    auto checked_division(EmitWorkspace& workspace, ObjectWorkspace& object, bool remainder,
        bool unsigned_value) -> bool {
        const i64 division = workspace.next_division();
        emit_mov_rr(workspace, object, Register::rax, Register::r11);
        emit_alu_rr(workspace, object, AluOp::test, Register::r11, Register::r11);
        emit_branch(workspace, object, 4, 4, 2);
        emit_mov_rr(workspace, object, Register::rcx, Register::rax);
        if (unsigned_value) {
            emit_alu_rr(workspace, object, AluOp::bit_xor, Register::rdx, Register::rdx);
            emit_unary(workspace, object, UnaryOp::unsigned_divide, Register::r11);
            if (remainder) {
                emit_mov_rr(workspace, object, Register::rdx, Register::rax);
            }
            return workspace.ok();
        }
        emit_alu_imm(workspace, object, AluOp::compare, -1, Register::r11);
        emit_branch(workspace, object, 5, 2, division);
        emit_mov_abs(workspace, object, -9223372036854775808, Register::rdx);
        emit_alu_rr(workspace, object, AluOp::compare, Register::rdx, Register::rax);
        emit_branch(workspace, object, 5, 2, division);
        if (remainder) {
            emit_alu_rr(workspace, object, AluOp::bit_xor, Register::rax, Register::rax);
            emit_branch(workspace, object, -1, 3, division);
        } else {
            emit_branch(workspace, object, -1, 4, 1);
        }
        emit_bind_label(workspace, object, 2, division);
        emit_cqto(workspace, object);
        emit_unary(workspace, object, UnaryOp::divide, Register::r11);
        if (remainder) {
            emit_mov_rr(workspace, object, Register::rdx, Register::rax);
        }
        return emit_bind_label(workspace, object, 3, division);
    }
    auto checked_shift(EmitWorkspace& workspace, ObjectWorkspace& object, bool left, bool byte_value) -> bool {
        if (byte_value) {
            emit_alu_imm(workspace, object, AluOp::compare, 7, Register::rax);
        } else {
            emit_alu_imm(workspace, object, AluOp::compare, 63, Register::rax);
        }
        emit_branch(workspace, object, 7, 4, 3);
        emit_mov_rr(workspace, object, Register::rcx, Register::rdx);
        emit_mov_rr(workspace, object, Register::rax, Register::rcx);
        emit_mov_rr(workspace, object, Register::rdx, Register::rax);
        if (!left) {
            return emit_shift(workspace, object, false, Register::rax);
        }
        emit_shift(workspace, object, true, Register::rax);
        if (byte_value) {
            emit_alu_imm(workspace, object, AluOp::compare, 255, Register::rax);
            return emit_branch(workspace, object, 7, 4, 1);
        }
        emit_mov_rr(workspace, object, Register::rax, Register::r11);
        emit_shift(workspace, object, false, Register::r11);
        emit_alu_rr(workspace, object, AluOp::compare, Register::rdx, Register::r11);
        return emit_branch(workspace, object, 5, 4, 1);
    }
    auto overflow_check(EmitWorkspace& workspace, ObjectWorkspace& object, bool unsigned_value,
        bool byte_value) -> bool {
        if (unsigned_value) {
            emit_branch(workspace, object, 2, 4, 1);
        } else {
            emit_branch(workspace, object, 0, 4, 1);
        }
        if (byte_value) {
            emit_alu_imm(workspace, object, AluOp::compare, 255, Register::rax);
            emit_branch(workspace, object, 7, 4, 1);
        }
        return workspace.ok();
    }
    // The condition code of a Compare, or of its negation.
    auto comparison_condition(EmitWorkspace& workspace, const compiler_ir_metadata::MetadataStore& metadata,
        const compiler_ir_instructions::InstructionStore& store, i64 instruction, bool inverse) -> i64 {
        const compiler_ir_instructions::RawInstructionRow row = store.instruction_at(instruction);
        const i64 kind = type_kind(metadata, operand_value(store, instruction, 0));
        const bool unsigned_value = kind == 7 || kind == 10;
        i64 operation = row.comparison_operation();
        if (operation < 0 || operation > 5) {
            workspace.fail();
            return -1;
        }
        if (inverse) {
            // Operations 0..5 are == != < > <= >=; == and !=, < and >=, > and <= negate.
            if (operation == 0 || operation == 1) {
                operation = 1 - operation;
            } else {
                operation = 7 - operation;
            }
        }
        if (operation == 0) {
            return 4;
        }
        if (operation == 1) {
            return 5;
        }
        if (operation == 2) {
            if (unsigned_value) {
                return 2;
            }
            return 12;
        }
        if (operation == 3) {
            if (unsigned_value) {
                return 7;
            }
            return 15;
        }
        if (operation == 4) {
            if (unsigned_value) {
                return 6;
            }
            return 14;
        }
        if (unsigned_value) {
            return 3;
        }
        return 13;
    }
    // The flags of a just-emitted left - right comparison become a 0/1 value.
    auto comparison_result(EmitWorkspace& workspace, ObjectWorkspace& object,
        const compiler_ir_metadata::MetadataStore& metadata, const compiler_ir_instructions::InstructionStore& store,
        i64 instruction) -> bool {
        const i64 condition = comparison_condition(workspace, metadata, store, instruction, false);
        emit_set_condition(workspace, object, condition, Register::rax);
        return emit_zero_extend_byte(workspace, object, Register::rax, Register::rax);
    }
    // BranchFalse right after a Compare: setcc and movzbq keep the flags, so the
    // branch tests them directly. The 0/1 value stays in %rax for the target.
    auto fused_branch(EmitWorkspace& workspace, ObjectWorkspace& object,
        const compiler_ir_metadata::MetadataStore& metadata, const compiler_ir_instructions::InstructionStore& store,
        i64 compare, i64 target) -> bool {
        const i64 condition = comparison_condition(workspace, metadata, store, compare, true);
        return emit_branch(workspace, object, condition, 0, target);
    }
    // A right operand that x86 can take as an immediate or a frame operand: an
    // imm32 Constant, an EnumConstant, or a 64-bit frame Load. -1 otherwise.
    auto direct_operand_kind(const compiler_ir_metadata::MetadataStore& metadata,
        const compiler_ir_instructions::InstructionStore& store, i64 instruction) -> i64 {
        const compiler_ir_instructions::RawInstructionRow row = store.instruction_at(instruction);
        const i64 form = row.form();
        if (form == 5) {
            const compiler_ir_instructions::RawOperandRow value = store.operand_at(row.operand_begin());
            if (value.role() == 11) {
                if (value.unsigned_value() <= 2147483647u64) {
                    return 0;
                }
                return -1;
            }
            if (value.signed_value() >= -2147483648 && value.signed_value() <= 2147483647) {
                return 0;
            }
            return -1;
        }
        if (form == 6) {
            return 1;
        }
        if (form == 7 && type_kind(metadata, operand_value(store, instruction, 1)) != 10) {
            return 2;
        }
        return -1;
    }
    auto direct_binary_operand(EmitWorkspace& workspace, ObjectWorkspace& object,
        const compiler_ir_instructions::InstructionStore& store, i64 instruction, i64 kind, AluOp operation) -> bool {
        if (kind == 0) {
            const compiler_ir_instructions::RawInstructionRow row = store.instruction_at(instruction);
            const compiler_ir_instructions::RawOperandRow value = store.operand_at(row.operand_begin());
            if (value.role() == 11) {
                // direct_operand_kind admits only values within signed imm32.
                return emit_alu_imm(workspace, object, operation, i64(value.unsigned_value()), Register::rax);
            }
            return emit_alu_imm(workspace, object, operation, value.signed_value(), Register::rax);
        }
        if (kind == 1) {
            return emit_alu_imm(workspace, object, operation, operand_value(store, instruction, 1), Register::rax);
        }
        const i64 address_token1 = workspace.pack_address(0, operand_value(store, instruction, 0));
        return emit_alu_load(workspace, object, operation, address_token1, Register::rax);
    }
    // Push, a direct right operand, then Compare or add/sub/and/or/xor: operate
    // on the left value in %rax directly. Flags and results match the stack form.
    auto fusable_binary(const compiler_ir_metadata::MetadataStore& metadata,
        const compiler_ir_instructions::InstructionStore& store, i64 load, i64 binary) -> bool {
        if (direct_operand_kind(metadata, store, load) < 0) {
            return false;
        }
        const compiler_ir_instructions::RawInstructionRow row = store.instruction_at(binary);
        if (row.form() == 14) {
            return true;
        }
        if (row.form() != 12) {
            return false;
        }
        const i64 operation = row.binary_operation();
        return operation == 0 || operation == 1 || operation == 5 || operation == 6 || operation == 7;
    }
    auto emit_fused_binary(EmitWorkspace& workspace, ObjectWorkspace& object,
        const compiler_ir_metadata::MetadataStore& metadata, const compiler_ir_instructions::InstructionStore& store,
        i64 load, i64 binary) -> bool {
        const compiler_ir_instructions::RawInstructionRow row = store.instruction_at(binary);
        const i64 kind = direct_operand_kind(metadata, store, load);
        if (row.form() == 14) {
            direct_binary_operand(workspace, object, store, load, kind, AluOp::compare);
            return comparison_result(workspace, object, metadata, store, binary);
        }
        const i64 type = type_kind(metadata, operand_value(store, binary, 0));
        const bool byte_value = type == 10;
        const bool unsigned_value = type == 7 || byte_value;
        const i64 operation = row.binary_operation();
        AluOp emission = AluOp::bit_xor;
        if (operation == 0) {
            emission = AluOp::add;
        } else {
            if (operation == 1) {
                emission = AluOp::subtract;
            } else {
                if (operation == 5) {
                    emission = AluOp::bit_and;
                } else {
                    if (operation == 6) {
                        emission = AluOp::bit_or;
                    }
                }
            }
        }
        direct_binary_operand(workspace, object, store, load, kind, emission);
        if (operation == 0 || operation == 1) {
            return overflow_check(workspace, object, unsigned_value, byte_value);
        }
        return workspace.ok();
    }
    auto emit_scalar(EmitWorkspace& workspace, ObjectWorkspace& object,
        const compiler_ir_metadata::MetadataStore& metadata, const compiler_ir_instructions::InstructionStore& store,
        i64 instruction, i64 control) -> bool {
        const compiler_ir_instructions::RawInstructionRow row = store.instruction_at(instruction);
        const i64 form = row.form();
        if (form == 5) {
            const compiler_ir_instructions::RawOperandRow value = store.operand_at(row.operand_begin());
            // Native Constant observes the exact 64-bit pattern through int64_t.
            // Preserve its signed decimal spelling even for a u64 high bit.
            if (value.role() == 11) {
                emit_mov_uimm(workspace, object, value.unsigned_value(), Register::rax);
            } else {
                emit_mov_abs(workspace, object, value.signed_value(), Register::rax);
            }
            return true;
        }
        if (form == 6) {
            emit_mov_imm(workspace, object, operand_value(store, instruction, 1), Register::rax);
            return true;
        }
        if (form == 7) {
            const i64 packed_address = workspace.pack_address(0, operand_value(store, instruction, 0));
            load_value(workspace, object, metadata, operand_value(store, instruction, 1), packed_address);
            return true;
        }
        if (form == 8) {
            const i64 packed_address = workspace.pack_address(0, operand_value(store, instruction, 0));
            store_value(workspace, object, metadata, operand_value(store, instruction, 1), packed_address);
            return true;
        }
        if (form == 9) {
            emit_push(workspace, object);
            return true;
        }
        if (form == 10) {
            emit_pop(workspace, object, Register::rax);
            return true;
        }
        if (form == 11) {
            const i64 operation = row.unary_operation();
            if (operation == 0) {
                emit_unary(workspace, object, UnaryOp::negate, Register::rax);
                emit_branch(workspace, object, 0, 4, 1);
            } else {
                if (operation == 1) {
                    emit_alu_imm(workspace, object, AluOp::bit_xor, 1, Register::rax);
                } else {
                    if (operation == 2) {
                        if (type_kind(metadata, operand_value(store, instruction, 0)) == 10) {
                            emit_alu_imm(workspace, object, AluOp::bit_xor, 255, Register::rax);
                        } else {
                            emit_unary(workspace, object, UnaryOp::bit_not, Register::rax);
                        }
                    } else {
                        workspace.fail();
                    }
                }
            }
            return true;
        }
        if (form == 12) {
            if (!workspace.left_in_rcx()) {
                emit_pop(workspace, object, Register::rcx);
            }
            const i64 kind = type_kind(metadata, operand_value(store, instruction, 0));
            const bool byte_value = kind == 10;
            const bool unsigned_value = kind == 7 || byte_value;
            const i64 operation = row.binary_operation();
            if (operation == 0) {
                emit_alu_rr(workspace, object, AluOp::add, Register::rcx, Register::rax);
                overflow_check(workspace, object, unsigned_value, byte_value);
            } else {
                if (operation == 1) {
                    emit_alu_rr(workspace, object, AluOp::subtract, Register::rax, Register::rcx);
                    emit_mov_rr(workspace, object, Register::rcx, Register::rax);
                    overflow_check(workspace, object, unsigned_value, byte_value);
                } else {
                    if (operation == 2) {
                        if (unsigned_value) {
                            emit_unary(workspace, object, UnaryOp::unsigned_multiply, Register::rcx);
                        } else {
                            emit_alu_rr(workspace, object, AluOp::multiply, Register::rcx, Register::rax);
                        }
                        overflow_check(workspace, object, unsigned_value, byte_value);
                    } else {
                        if (operation == 3 || operation == 4) {
                            checked_division(workspace, object, operation == 4, unsigned_value);
                        } else {
                            if (operation == 5) {
                                emit_alu_rr(workspace, object, AluOp::bit_and, Register::rcx, Register::rax);
                            } else {
                                if (operation == 6) {
                                    emit_alu_rr(workspace, object, AluOp::bit_or, Register::rcx, Register::rax);
                                } else {
                                    if (operation == 7) {
                                        emit_alu_rr(workspace, object, AluOp::bit_xor, Register::rcx, Register::rax);
                                    } else {
                                        if (operation == 8 || operation == 9) {
                                            checked_shift(workspace, object, operation == 8, byte_value);
                                        } else {
                                            workspace.fail();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            return true;
        }
        if (form == 13) {
            if (type_kind(metadata, operand_value(store, instruction, 1)) == 10) {
                emit_alu_imm(workspace, object, AluOp::compare, 255, Register::rax);
                emit_branch(workspace, object, 7, 4, 1);
            } else {
                if (type_kind(metadata, operand_value(store, instruction, 0)) != 10) {
                    emit_alu_rr(workspace, object, AluOp::test, Register::rax, Register::rax);
                    emit_branch(workspace, object, 8, 4, 1);
                }
            }
            return true;
        }
        if (form == 14) {
            if (!workspace.left_in_rcx()) {
                emit_pop(workspace, object, Register::rcx);
            }
            emit_alu_rr(workspace, object, AluOp::compare, Register::rax, Register::rcx);
            return comparison_result(workspace, object, metadata, store, instruction);
        }
        if (form == 15) {
            emit_alu_imm(workspace, object, AluOp::compare, operand_value(store, instruction, 1), Register::rax);
            emit_branch(workspace, object, 3, 4, 0);
            return true;
        }
        if (form == 16 || form == 17) {
            const i64 type = operand_value(store, instruction, 2);
            const bool narrow = type_kind(metadata, type) == 10;
            const i64 offset = operand_value(store, instruction, 0);
            if (form == 16) {
                const i64 address_token2 = workspace.pack_address(0, offset);
                emit_lea(workspace, object, address_token2, Register::rcx);
                if (narrow) {
                    emit_indexed_load(workspace, object, Register::rcx, Register::rax, indexed_address(1, 0), true);
                } else {
                    emit_indexed_load(workspace, object, Register::rcx, Register::rax, indexed_address(8, 0), false);
                }
            } else {
                emit_pop(workspace, object, Register::rcx);
                const i64 address_token3 = workspace.pack_address(0, offset);
                emit_lea(workspace, object, address_token3, Register::rdx);
                if (narrow) {
                    emit_indexed_store(workspace, object, Register::rdx, Register::rcx, indexed_address(1, 0), true);
                } else {
                    emit_indexed_store(workspace, object, Register::rdx, Register::rcx, indexed_address(8, 0), false);
                }
            }
            return true;
        }
        if (form == 18) {
            const i64 address_token4 = workspace.pack_address(0, operand_value(store, instruction, 0));
            emit_lea(workspace, object, address_token4, Register::rax);
            return true;
        }
        if (form == 39) {
            emit_mov_rr(workspace, object, Register::rax, Register::rdi);
            call_query(workspace, object, metadata, row.query(), operand_value(store, instruction, 0));
            return true;
        }
        i64 label = control;
        if (form == 40 || form == 41 || form == 42) {
            if (!object.object_mode()) {
                label = operand_value(store, instruction, 0);
            }
        }
        if (form == 40) {
            emit_bind_label(workspace, object, 0, label);
            return true;
        }
        if (form == 41 || form == 42) {
            if (form == 42) {
                emit_alu_rr(workspace, object, AluOp::test, Register::rax, Register::rax);
                emit_branch(workspace, object, 4, 0, label);
            } else {
                emit_branch(workspace, object, -1, 0, label);
            }
            return true;
        }
        if (form == 43) {
            emit_branch(workspace, object, -1, 1, 0);
            return true;
        }
        return false;
    }
}
