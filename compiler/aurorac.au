// The compiler and formatter driver: aurorac, and aurora-fmt when the program
// is run under that name. It is a hosted Aurora program on builtin::HostFiles
// and its ByteRegion, linked with ld alone: it parses the command line, opens
// the input and every imported module beneath the explicit roots, runs the
// Aurora compiler modules, renders their diagnostics and writes each artifact
// atomically. The runtime root (aurora.host, aurora.memory) is fixed when the
// build configures this file (see main) for each --target, unless --runtime-root
// names another.

// A [begin, begin + count) range of a byte pool.
class Range {
public:
    i64 begin;
    i64 count;
};
// An opened file's device and inode.
class Identity {
public:
    u64 device;
    u64 inode;
};
// One diagnostic: its code number (AU3001 is 3001), severity, whether it is a
// formatter style finding (AUF), its message and path ranges in the pool (path
// count -1 when unlocated) and its span.
class Entry {
public:
    i64 code;
    bool warning;
    bool style;
    i64 message;
    i64 length;
    i64 path;
    i64 pathLength;
    i64 begin;
    i64 beginLine;
    i64 beginColumn;
    i64 end;
    i64 endLine;
    i64 endColumn;
};

auto none_range() -> Range {
    const Range result = Range{
        .begin = 0,
        .count = 0
    };
    return result;
}
auto range_pool(builtin::ByteRegion region) -> builtin::OwnedValues<Range> {
    const Range fill = none_range();
    builtin::OwnedValues<Range> result = region.try_allocate(0, fill);
    return move(result);
}
auto identity_pool(builtin::ByteRegion region) -> builtin::OwnedValues<Identity> {
    const Identity fill = Identity{
        .device = 0u64,
        .inode = 0u64
    };
    builtin::OwnedValues<Identity> result = region.try_allocate(0, fill);
    return move(result);
}
auto blank_entry() -> Entry {
    const Entry result = Entry{
        .code = 0,
        .warning = false,
        .style = false,
        .message = 0,
        .length = 0,
        .path = 0,
        .pathLength = -1,
        .begin = 0,
        .beginLine = 0,
        .beginColumn = 0,
        .end = 0,
        .endLine = 0,
        .endColumn = 0
    };
    return result;
}
auto entry_pool(builtin::ByteRegion region) -> builtin::OwnedValues<Entry> {
    const Entry fill = blank_entry();
    builtin::OwnedValues<Entry> result = region.try_allocate(0, fill);
    return move(result);
}
// Twice the needed count, so appends grow geometrically.
auto grown(i64 needed) -> i64 {
    if (needed < 64) {
        return 64;
    }
    return 2 * needed;
}

// Growable bytes: sources, paths, names and output. A failed allocation is
// terminal and leaves the text unchanged.
class Text {
    builtin::OwnedBytes bytes;
    i64 count;
    bool failed;
    auto reserve(i64 extra) -> bool {
        if (failed || !bytes.ok()) {
            failed = true;
            return false;
        }
        if (count + extra > bytes.size() && !bytes.try_resize(grown(count + extra))) {
            failed = true;
            return false;
        }
        return true;
    }
public:
    Text(builtin::ByteRegion region) : bytes(region.try_allocate(0)), count(0), failed(false) {
    }
    auto good() const -> bool {
        return !failed;
    }
    auto size() const -> i64 {
        return count;
    }
    auto at(i64 index) const -> u8 {
        return bytes.at(index);
    }
    auto view() const -> builtin::span<const u8> {
        const builtin::span<const u8> all = borrow_bytes(bytes);
        const builtin::span<const u8> result = all.subspan(0, count);
        return result;
    }
    auto part(i64 begin, i64 length) const -> builtin::span<const u8> {
        const builtin::span<const u8> all = borrow_bytes(bytes);
        const builtin::span<const u8> result = all.subspan(begin, length);
        return result;
    }
    auto push(u8 value) -> bool {
        if (!reserve(1)) {
            return false;
        }
        bytes.set(count, value);
        count = count + 1;
        return true;
    }
    auto append(builtin::span<const u8> value) -> bool {
        if (!reserve(value.size())) {
            return false;
        }
        i64 at = 0;
        while (at < value.size()) {
            bytes.set(count + at, value.at(at));
            at = at + 1;
        }
        count = count + value.size();
        return true;
    }
    // The first count bytes of a read chunk.
    auto append_chunk(builtin::HostChunk chunk) -> bool {
        const i64 length = i64(chunk.count);
        if (length < 0 || length > 504) {
            failed = true;
            return false;
        }
        if (!reserve(length)) {
            return false;
        }
        const array<u8, 504> payload = chunk.bytes;
        i64 at = 0;
        while (at < length) {
            bytes.set(count + at, payload[at]);
            at = at + 1;
        }
        count = count + length;
        return true;
    }
    // The bytes of a name chunk; false when it is invalid.
    auto append_name(compiler_resolver::LinkageChunk chunk) -> bool {
        if (chunk.size() < 0 || !reserve(chunk.size())) {
            return false;
        }
        i64 at = 0;
        while (at < chunk.size()) {
            bytes.set(count + at, chunk.at(at));
            at = at + 1;
        }
        count = count + chunk.size();
        return true;
    }
    auto truncate(i64 length) -> bool {
        if (length < 0 || length > count) {
            return false;
        }
        count = length;
        return true;
    }
};

// Growable ranges.
class Ranges {
    builtin::OwnedValues<Range> rows;
    i64 count;
    bool failed;
public:
    Ranges(builtin::ByteRegion region) : rows(range_pool(region)), count(0), failed(false) {
    }
    auto good() const -> bool {
        return !failed;
    }
    auto size() const -> i64 {
        return count;
    }
    auto at(i64 index) const -> Range {
        const Range result = rows.at(index);
        return result;
    }
    auto add(i64 begin, i64 length) -> bool {
        const Range fill = none_range();
        if (failed || (count == rows.size() && !rows.try_resize(grown(count + 1), fill))) {
            failed = true;
            return false;
        }
        const Range row = Range{
            .begin = begin,
            .count = length
        };
        rows.set(count, row);
        count = count + 1;
        return true;
    }
};

// The identities of every opened source, which no output may replace.
class Identities {
    builtin::OwnedValues<Identity> rows;
    i64 count;
    bool failed;
public:
    Identities(builtin::ByteRegion region) : rows(identity_pool(region)), count(0), failed(false) {
    }
    auto good() const -> bool {
        return !failed;
    }
    auto add(u64 device, u64 inode) -> bool {
        const Identity fill = Identity{
            .device = 0u64,
            .inode = 0u64
        };
        if (failed || (count == rows.size() && !rows.try_resize(grown(count + 1), fill))) {
            failed = true;
            return false;
        }
        const Identity row = Identity{
            .device = device,
            .inode = inode
        };
        rows.set(count, row);
        count = count + 1;
        return true;
    }
    auto contains(u64 device, u64 inode) const -> bool {
        i64 at = 0;
        while (at < count) {
            const Identity row = rows.at(at);
            if (row.device == device && row.inode == inode) {
                return true;
            }
            at = at + 1;
        }
        return false;
    }
};

// Diagnostic families the driver itself reports.
auto unclassified() -> i64 {
    return 0;
}
auto module_family() -> i64 {
    return 4001;
}
auto command_line() -> i64 {
    return 5001;
}
auto internal() -> i64 {
    return 9001;
}

// The diagnostics of one run and their rendering. Messages and paths live in
// one byte pool; the rendered text is built in its own buffer and printed once.
class Diagnostics {
    builtin::OwnedValues<Entry> entries;
    builtin::OwnedBytes pool;
    builtin::OwnedBytes out;
    i64 entryCount;
    i64 poolBytes;
    i64 outBytes;
    i64 reportBytes;
    bool reportMore;
    bool invalid;
    bool failed;
    auto reserve_pool(i64 extra) -> bool {
        if (failed || (poolBytes + extra > pool.size() && !pool.try_resize(grown(poolBytes + extra)))) {
            failed = true;
            return false;
        }
        return true;
    }
    auto pool_byte(u8 value) -> bool {
        if (!reserve_pool(1)) {
            return false;
        }
        pool.set(poolBytes, value);
        poolBytes = poolBytes + 1;
        return true;
    }
    auto current() const -> Entry {
        const Entry result = entries.at(entryCount - 1);
        return result;
    }
    auto replace(Entry entry) -> bool {
        return entries.set(entryCount - 1, entry);
    }
    // Ends the message of the current entry at the end of the pool.
    auto close_message() -> bool {
        Entry entry = current();
        entry.length = poolBytes - entry.message;
        return replace(entry);
    }
    auto put(u8 value) -> bool {
        if (failed || (outBytes == out.size() && !out.try_resize(grown(outBytes + 1)))) {
            failed = true;
            return false;
        }
        out.set(outBytes, value);
        outBytes = outBytes + 1;
        return true;
    }
    auto put_text(builtin::span<const u8> value) -> bool {
        i64 at = 0;
        while (at < value.size()) {
            put(value.at(at));
            at = at + 1;
        }
        return !failed;
    }
    auto put_pool(i64 begin, i64 count) -> bool {
        i64 at = 0;
        while (at < count) {
            put(pool.at(begin + at));
            at = at + 1;
        }
        return !failed;
    }
    auto put_decimal(i64 value) -> bool {
        u64 scale = 1u64;
        const u64 number = u64(value);
        while (number / scale >= 10u64) {
            scale = scale * 10u64;
        }
        while (scale > 0u64) {
            put(u8(48u64 + number / scale % 10u64));
            scale = scale / 10u64;
        }
        return !failed;
    }
    // AU3001, or AUF1001 for a style finding: at least four digits.
    auto put_code(Entry entry) -> bool {
        put_text("AU");
        if (entry.style) {
            put('F');
        }
        i64 width = 1;
        i64 scale = 10;
        while (entry.code >= scale) {
            width = width + 1;
            scale = scale * 10;
        }
        while (width < 4) {
            put('0');
            width = width + 1;
        }
        return put_decimal(entry.code);
    }
    auto put_severity(Entry entry) -> bool {
        if (entry.warning) {
            return put_text("warning");
        }
        return put_text("error");
    }
    auto hex(u8 value) -> u8 {
        if (value < 10u8) {
            return u8(48u64 + u64(value));
        }
        return u8(87u64 + u64(value));
    }
    // The pool bytes as a JSON string. Valid UTF-8 is kept as it is; every
    // ill-formed byte is escaped on its own, so any path makes valid JSON.
    auto put_json(i64 begin, i64 count) -> bool {
        put('"');
        i64 index = 0;
        while (index < count) {
            const u8 byte = pool.at(begin + index);
            if (byte == '"' || byte == '\\') {
                put('\\');
                put(byte);
                index = index + 1;
            } else {
                if (byte >= 32u8 && byte < 128u8) {
                    put(byte);
                    index = index + 1;
                } else {
                    i64 width = 0;
                    u64 scalar = 0u64;
                    if (byte >= 194u8 && byte <= 223u8) {
                        width = 2;
                        scalar = u64(byte) % 32u64;
                    }
                    if (byte >= 224u8 && byte <= 239u8) {
                        width = 3;
                        scalar = u64(byte) % 16u64;
                    }
                    if (byte >= 240u8 && byte <= 244u8) {
                        width = 4;
                        scalar = u64(byte) % 8u64;
                    }
                    bool valid = width != 0 && width <= count - index;
                    i64 next = 1;
                    while (valid && next < width) {
                        const u8 continuation = pool.at(begin + index + next);
                        valid = continuation >= 128u8 && continuation <= 191u8;
                        scalar = scalar * 64u64 + u64(continuation) % 64u64;
                        next = next + 1;
                    }
                    valid = valid && scalar <= 1114111u64 && !(scalar >= 55296u64 && scalar <= 57343u64) && (width != 3
                        || scalar >= 2048u64) && (width != 4 || scalar >= 65536u64);
                    if (valid) {
                        put_pool(begin + index, width);
                        index = index + width;
                    } else {
                        put_text("\\u00");
                        put(hex(byte / 16u8));
                        put(hex(byte % 16u8));
                        index = index + 1;
                    }
                }
            }
        }
        return put('"');
    }
    auto put_position(i64 offset, i64 line, i64 column) -> bool {
        put_text("{\"offset\":");
        put_decimal(offset);
        put_text(",\"line\":");
        put_decimal(line);
        put_text(",\"column\":");
        put_decimal(column);
        return put('}');
    }
    auto put_range(Entry entry) -> bool {
        put_text("{\"start\":");
        put_position(entry.begin, entry.beginLine, entry.beginColumn);
        put_text(",\"end\":");
        put_position(entry.end, entry.endLine, entry.endColumn);
        return put('}');
    }
public:
    Diagnostics(builtin::ByteRegion region) : entries(entry_pool(region)), pool(region.try_allocate(0)),
        out(region.try_allocate(0)), entryCount(0), poolBytes(0), outBytes(0), reportBytes(0), reportMore(false),
        invalid(false), failed(false) {
    }
    auto good() const -> bool {
        return !failed && entries.ok() && pool.ok() && out.ok();
    }
    auto count() const -> i64 {
        return entryCount;
    }
    auto code(i64 index) const -> i64 {
        const Entry entry = entries.at(index);
        return entry.code;
    }
    auto errors() const -> bool {
        i64 at = 0;
        while (at < entryCount) {
            const Entry entry = entries.at(at);
            if (!entry.warning) {
                return true;
            }
            at = at + 1;
        }
        return false;
    }
    // Starts an unlocated diagnostic; its message follows.
    auto begin(i64 code, bool warning) -> bool {
        const Entry fill = blank_entry();
        if (failed || (entryCount == entries.size() && !entries.try_resize(grown(entryCount + 1), fill))) {
            failed = true;
            return false;
        }
        Entry entry = blank_entry();
        entry.code = code;
        entry.warning = warning;
        entry.message = poolBytes;
        entries.set(entryCount, entry);
        entryCount = entryCount + 1;
        return true;
    }
    // Appends to the message of the newest diagnostic.
    auto text(builtin::span<const u8> value) -> bool {
        if (entryCount == 0 || !reserve_pool(value.size())) {
            return false;
        }
        i64 at = 0;
        while (at < value.size()) {
            pool.set(poolBytes + at, value.at(at));
            at = at + 1;
        }
        poolBytes = poolBytes + value.size();
        return close_message();
    }
    // Prefixes the message of the newest diagnostic, as the loader names the
    // module whose source failed to read.
    auto prefix(builtin::span<const u8> value) -> bool {
        if (entryCount == 0) {
            return false;
        }
        Entry entry = current();
        const i64 length = entry.length;
        if (!reserve_pool(value.size() + length)) {
            return false;
        }
        i64 at = 0;
        while (at < value.size()) {
            pool.set(poolBytes + at, value.at(at));
            at = at + 1;
        }
        at = 0;
        while (at < length) {
            pool.set(poolBytes + value.size() + at, pool.at(entry.message + at));
            at = at + 1;
        }
        entry.message = poolBytes;
        entry.length = value.size() + length;
        poolBytes = poolBytes + entry.length;
        return replace(entry);
    }
    // Gives an unclassified newest diagnostic the family of its stage.
    auto default_code(i64 code) -> bool {
        if (entryCount == 0) {
            return false;
        }
        Entry entry = current();
        if (entry.code == 0) {
            entry.code = code;
        }
        return replace(entry);
    }
    // Copies a rendered Report's first chunk into a new diagnostic located in
    // path when its source is not -1; more() then asks for the next chunk.
    auto report(compiler_resolver::Report first, builtin::span<const u8> path) -> bool {
        reportMore = false;
        if (first.size() < 0 || first.size() > 384) {
            invalid = true;
            begin(internal(), false);
            return text("invalid hosted resolution result");
        }
        begin(first.code(), first.warns());
        Entry entry = current();
        if (first.source_index() >= 0) {
            entry.path = poolBytes;
            entry.pathLength = path.size();
            entry.begin = first.position(0);
            entry.beginLine = first.position(1);
            entry.beginColumn = first.position(2);
            entry.end = first.position(3);
            entry.endLine = first.position(4);
            entry.endColumn = first.position(5);
            if (!reserve_pool(path.size())) {
                return false;
            }
            i64 at = 0;
            while (at < path.size()) {
                pool.set(poolBytes + at, path.at(at));
                at = at + 1;
            }
            poolBytes = poolBytes + path.size();
        }
        entry.message = poolBytes;
        replace(entry);
        reportBytes = 0;
        return more(first);
    }
    // Appends the next chunk of the report being copied.
    auto more(compiler_resolver::Report part) -> bool {
        if (part.size() < 0 || part.size() > 384 || reportBytes > 67108864) {
            Entry entry = current();
            entry.code = internal();
            entry.warning = false;
            entry.pathLength = -1;
            entry.message = poolBytes;
            entry.length = 0;
            replace(entry);
            reportMore = false;
            invalid = true;
            return text("invalid hosted resolution result");
        }
        i64 at = 0;
        while (at < part.size()) {
            pool_byte(part.byte(at));
            at = at + 1;
        }
        reportBytes = reportBytes + part.size();
        reportMore = part.size() == 384;
        return close_message();
    }
    auto pending() const -> bool {
        return reportMore && !failed;
    }
    // Whether a copied report was malformed (and recorded as internal).
    auto malformed() const -> bool {
        return invalid;
    }
    auto offset() const -> i64 {
        return reportBytes;
    }
    // Marks the newest diagnostic as a formatter style finding (AUF).
    auto restyle() -> bool {
        Entry entry = current();
        entry.style = true;
        return replace(entry);
    }
    // Forgets every diagnostic and the rendered text.
    auto clear() -> bool {
        entryCount = 0;
        poolBytes = 0;
        outBytes = 0;
        reportMore = false;
        invalid = false;
        return true;
    }
    // One diagnostic as text: PATH:LINE:COLUMN or the tool, then the
    // severity, code and message; aurora-fmt's findings have no severity.
    auto render_text(i64 index, builtin::span<const u8> tool) -> bool {
        const Entry entry = entries.at(index);
        if (entry.pathLength >= 0) {
            if (entry.pathLength == 0) {
                put_text("<source>");
            } else {
                put_pool(entry.path, entry.pathLength);
            }
            put(':');
            put_decimal(entry.beginLine);
            put(':');
            put_decimal(entry.beginColumn);
        } else {
            put_text(tool);
        }
        put_text(": ");
        if (!entry.style) {
            put_severity(entry);
            put(' ');
        }
        put_code(entry);
        put_text(": ");
        put_pool(entry.message, entry.length);
        return put('\n');
    }
    auto render_all(builtin::span<const u8> tool) -> bool {
        i64 at = 0;
        while (at < entryCount) {
            render_text(at, tool);
            at = at + 1;
        }
        return !failed;
    }
    auto render_entry(i64 index) -> bool {
        const Entry entry = entries.at(index);
        put_text("{\"code\":\"");
        put_code(entry);
        put_text("\",\"severity\":\"");
        put_severity(entry);
        put_text("\",\"message\":");
        put_json(entry.message, entry.length);
        put_text(",\"path\":");
        if (entry.pathLength >= 0) {
            put_json(entry.path, entry.pathLength);
            put_text(",\"range\":");
            put_range(entry);
        } else {
            put_text("null,\"range\":null");
        }
        return put('}');
    }
    // The JSON document of every diagnostic, successful when none is an error.
    auto render_json() -> bool {
        put_text("{\"schemaVersion\":1,\"success\":");
        if (errors()) {
            put_text("false");
        } else {
            put_text("true");
        }
        put_text(",\"diagnostics\":[");
        i64 at = 0;
        while (at < entryCount) {
            if (at > 0) {
                put(',');
            }
            render_entry(at);
            at = at + 1;
        }
        return put_text("]}\n");
    }
    // aurora-fmt --check: the style findings from first on, as text or JSON.
    auto render_findings(i64 first, bool json, bool changed) -> bool {
        if (json) {
            put_text("{\"schemaVersion\":1,\"mode\":\"format-check\",\"success\":");
            if (!changed && entryCount == first) {
                put_text("true");
            } else {
                put_text("false");
            }
            put_text(",\"changed\":");
            if (changed) {
                put_text("true");
            } else {
                put_text("false");
            }
            put_text(",\"diagnostics\":[");
        }
        i64 at = first;
        while (at < entryCount) {
            if (json) {
                if (at > first) {
                    put(',');
                }
                render_entry(at);
            } else {
                render_text(at, "aurora-fmt");
            }
            at = at + 1;
        }
        if (json) {
            return put_text("]}\n");
        }
        if (changed) {
            return put_text("aurora-fmt: formatting differs\n");
        }
        return !failed;
    }
    auto output() const -> builtin::span<const u8> {
        const builtin::span<const u8> all = borrow_bytes(out);
        const builtin::span<const u8> result = all.subspan(0, outBytes);
        return result;
    }
};

// Byte comparison.
auto same(builtin::span<const u8> left, builtin::span<const u8> right) -> bool {
    if (left.size() != right.size()) {
        return false;
    }
    i64 at = 0;
    while (at < left.size()) {
        if (left.at(at) != right.at(at)) {
            return false;
        }
        at = at + 1;
    }
    return true;
}
auto option(builtin::span<const u8> value) -> bool {
    return value.size() > 0 && value.at(0) == '-';
}
// Whether the last component of a path is name.
auto named(builtin::span<const u8> path, builtin::span<const u8> name) -> bool {
    i64 begin = 0;
    i64 at = 0;
    while (at < path.size()) {
        if (path.at(at) == '/') {
            begin = at + 1;
        }
        at = at + 1;
    }
    return same(path.subspan(begin, path.size() - begin), name);
}

// The NUL-terminated arguments, argv[0] first.
auto split_words(Ranges& words, builtin::span<const u8> arguments) -> i64 {
    i64 begin = 0;
    i64 at = 0;
    while (at < arguments.size()) {
        if (arguments.at(at) == 0u8) {
            words.add(begin, at - begin);
            begin = at + 1;
        }
        at = at + 1;
    }
    return words.size();
}

// What the command line asks for. Paths are argument indices (0 when absent);
// a rejection names its reason and the argument it cites.
class Options {
public:
    bool json;
    bool check;
    bool lint;
    bool local;
    bool referenced;
    bool object;
    bool executable;
    bool formatSpecified;
    i64 input;
    i64 output;
    i64 stack;
    i64 abi;
    i64 runtime;
    i64 roots;
    // The --target value: 0 none given (linux), 1 linux, 2 aurora.
    i64 target;
    i64 error;
    i64 cited;
};
auto no_options() -> Options {
    const Options result = Options{
        .json = false,
        .check = false,
        .lint = false,
        .local = false,
        .referenced = false,
        .object = false,
        .executable = false,
        .formatSpecified = false,
        .input = 0,
        .output = 0,
        .stack = 0,
        .abi = 0,
        .runtime = 0,
        .roots = 0,
        .target = 0,
        .error = 0,
        .cited = 0
    };
    return result;
}
// Command-line rejections, rendered by usage_message.
auto usage_error() -> i64 {
    return 1;
}
auto unknown_argument() -> i64 {
    return 2;
}
// Whether the argument at index is the option spelled name.
auto is(const Ranges& words, builtin::span<const u8> arguments, i64 index, builtin::span<const u8> name) -> bool {
    const Range found = words.at(index);
    return same(arguments.subspan(found.begin, found.count), name);
}
auto empty_word(const Ranges& words, i64 index) -> bool {
    const Range found = words.at(index);
    return found.count == 0;
}
auto starts_option(const Ranges& words, builtin::span<const u8> arguments, i64 index) -> bool {
    const Range found = words.at(index);
    return option(arguments.subspan(found.begin, found.count));
}
// The renderer is chosen before any argument is validated: --diagnostics=json
// anywhere but as the value of a path-taking option.
auto json_requested(const Ranges& words, builtin::span<const u8> arguments, bool formatter) -> bool {
    bool json = false;
    i64 index = 1;
    while (index < words.size()) {
        if (!formatter && is(words, arguments, index, "--compose-private-object")) {
            index = index + 3;
        } else {
            if (is(words, arguments, index, "--module-root") || is(words, arguments, index, "--runtime-root")
                || (!formatter && (is(words, arguments, index, "--emit-frontend-wrapper") || is(words, arguments, index,
                "--link-object") || is(words, arguments, index, "-o") || is(words, arguments, index, "--stack-facts")
                || is(words, arguments, index, "--abi-facts") || is(words, arguments, index, "--target")))) {
                index = index + 1;
            } else {
                if (is(words, arguments, index, "--diagnostics=json")) {
                    json = true;
                }
            }
        }
        index = index + 1;
    }
    return json;
}
// A copy of options rejected with error, citing an argument. Errors 3 onward
// are named by usage_message.
auto rejected(Options options, i64 error, i64 cited) -> Options {
    Options result = options;
    result.error = error;
    result.cited = cited;
    return result;
}
// The value-less aurorac option at index: 1 --emit-object, 2 --local-symbols,
// 3 --referenced-reflection-only, 4 --check, 5 a diagnostic format,
// 6 --emit-executable, else 0.
auto flag_kind(const Ranges& words, builtin::span<const u8> arguments, i64 index) -> i64 {
    if (is(words, arguments, index, "--emit-object")) {
        return 1;
    }
    if (is(words, arguments, index, "--emit-executable")) {
        return 6;
    }
    if (is(words, arguments, index, "--local-symbols")) {
        return 2;
    }
    if (is(words, arguments, index, "--referenced-reflection-only")) {
        return 3;
    }
    if (is(words, arguments, index, "--check")) {
        return 4;
    }
    if (is(words, arguments, index, "--diagnostics=json") || is(words, arguments, index, "--diagnostics=text")) {
        return 5;
    }
    return 0;
}
// The options taking a value: 1 --module-root, 2 --runtime-root, 3 -o,
// 4 --stack-facts, 5 --abi-facts, 6 --target, else 0.
auto value_kind(const Ranges& words, builtin::span<const u8> arguments, i64 index) -> i64 {
    if (is(words, arguments, index, "--module-root")) {
        return 1;
    }
    if (is(words, arguments, index, "--runtime-root")) {
        return 2;
    }
    if (is(words, arguments, index, "-o")) {
        return 3;
    }
    if (is(words, arguments, index, "--stack-facts")) {
        return 4;
    }
    if (is(words, arguments, index, "--abi-facts")) {
        return 5;
    }
    if (is(words, arguments, index, "--target")) {
        return 6;
    }
    return 0;
}
// aurorac's command line: each option in turn, then the combinations, in the
// order the rejections are documented.
auto compiler_options(const Ranges& words, builtin::span<const u8> arguments) -> Options {
    Options result = no_options();
    result.json = json_requested(words, arguments, false);
    i64 index = 1;
    while (index < words.size() && result.error == 0) {
        const i64 valued = value_kind(words, arguments, index);
        const i64 flag = flag_kind(words, arguments, index);
        if (valued != 0) {
            index = index + 1;
        }
        const bool present = index < words.size();
        if (valued == 1) {
            if (!present) {
                result.error = 3;
            }
            result.roots = result.roots + 1;
        }
        if (valued == 2) {
            if (!present || result.runtime != 0 || empty_word(words, index)) {
                result.error = 4;
            } else {
                result.runtime = index;
            }
        }
        if (valued == 3) {
            if (!present || result.output != 0) {
                result.error = 5;
            } else {
                result.output = index;
            }
        }
        if (valued == 4) {
            if (!present || result.stack != 0) {
                result.error = 6;
            } else {
                result.stack = index;
            }
        }
        if (valued == 5) {
            if (!present || result.abi != 0) {
                result.error = 7;
            } else {
                result.abi = index;
            }
        }
        if (valued == 6) {
            if (!present || result.target != 0) {
                result.error = 26;
            } else {
                if (is(words, arguments, index, "linux")) {
                    result.target = 1;
                } else {
                    if (is(words, arguments, index, "aurora")) {
                        result.target = 2;
                    } else {
                        result.error = 26;
                    }
                }
            }
        }
        if (flag == 1) {
            if (result.object) {
                result.error = 8;
            }
            if (result.executable) {
                result.error = 27;
            }
            result.object = true;
        }
        if (flag == 6) {
            if (result.object || result.executable) {
                result.error = 27;
            }
            result.executable = true;
        }
        if (flag == 2) {
            if (result.local) {
                result.error = 9;
            }
            result.local = true;
        }
        if (flag == 3) {
            if (result.referenced) {
                result.error = 10;
            }
            result.referenced = true;
        }
        if (flag == 4) {
            if (result.check) {
                result.error = 11;
            }
            result.check = true;
        }
        if (flag == 5) {
            if (result.formatSpecified) {
                result.error = 12;
            }
            result.formatSpecified = true;
        }
        if (valued == 0 && flag == 0) {
            if (starts_option(words, arguments, index) || result.input != 0) {
                result.error = unknown_argument();
                result.cited = index;
            } else {
                result.input = index;
            }
        }
        index = index + 1;
    }
    if (result.error != 0) {
        return result;
    }
    if (result.input == 0 || empty_word(words, result.input) || (!result.check && (result.output == 0
        || empty_word(words, result.output)))) {
        return rejected(result, usage_error(), 0);
    }
    if (result.check && result.output != 0) {
        return rejected(result, 13, 0);
    }
    if (result.check && result.executable) {
        return rejected(result, 28, 0);
    }
    if (result.check && result.object) {
        return rejected(result, 14, 0);
    }
    if (result.check && result.stack != 0) {
        return rejected(result, 15, 0);
    }
    if (result.stack != 0 && empty_word(words, result.stack)) {
        return rejected(result, 16, 0);
    }
    if (result.check && result.abi != 0) {
        return rejected(result, 17, 0);
    }
    if (result.abi != 0 && empty_word(words, result.abi)) {
        return rejected(result, 18, 0);
    }
    if (result.check && result.local) {
        return rejected(result, 19, 0);
    }
    if (result.check && result.referenced) {
        return rejected(result, 20, 0);
    }
    if (result.json && !result.check) {
        return rejected(result, 21, 0);
    }
    return result;
}
// aurora-fmt's command line.
auto formatter_options(const Ranges& words, builtin::span<const u8> arguments) -> Options {
    Options result = no_options();
    result.json = json_requested(words, arguments, true);
    i64 index = 1;
    while (index < words.size() && result.error == 0) {
        const i64 valued = value_kind(words, arguments, index);
        const bool format = is(words, arguments, index, "--diagnostics=json") || is(words, arguments, index,
            "--diagnostics=text");
        if (is(words, arguments, index, "--check") && !result.check) {
            result.check = true;
        } else {
            if (is(words, arguments, index, "--lint") && !result.lint) {
                result.lint = true;
            } else {
                if (valued == 1 || valued == 2) {
                    index = index + 1;
                    const bool present = index < words.size();
                    if (valued == 1) {
                        if (!present) {
                            result.error = 3;
                        }
                        result.roots = result.roots + 1;
                    } else {
                        if (!present || result.runtime != 0 || empty_word(words, index)) {
                            result.error = 4;
                        } else {
                            result.runtime = index;
                        }
                    }
                } else {
                    if (format && !result.formatSpecified) {
                        result.formatSpecified = true;
                    } else {
                        if (!starts_option(words, arguments, index) && (result.input == 0 || empty_word(words,
                            result.input))) {
                            result.input = index;
                        } else {
                            result.error = unknown_argument();
                            result.cited = index;
                        }
                    }
                }
            }
        }
        index = index + 1;
    }
    if (result.error != 0) {
        return result;
    }
    if (result.input == 0 || empty_word(words, result.input)) {
        return rejected(result, 23, 0);
    }
    if ((result.check && result.lint) || (!result.lint && (result.roots > 0 || result.runtime != 0)) || (result.json
        && !result.check && !result.lint)) {
        return rejected(result, 22, 0);
    }
    return result;
}
auto tool_options(const Ranges& words, builtin::span<const u8> arguments, bool formatter) -> Options {
    if (formatter) {
        const Options result = formatter_options(words, arguments);
        return result;
    }
    const Options result = compiler_options(words, arguments);
    return result;
}
// The message of a command-line rejection.
auto usage_message(Diagnostics& diagnostics, i64 error, builtin::span<const u8> cited) -> bool {
    diagnostics.begin(command_line(), false);
    if (error == usage_error()) {
        diagnostics.text(
            "usage: aurorac [--emit-object|--emit-executable] [--local-symbols] [--referenced-reflection-only] ");
        diagnostics.text("[--target linux|aurora] [--module-root DIR] [--runtime-root DIR] INPUT.au -o OUTPUT ");
        diagnostics.text("[--stack-facts OUTPUT.json] [--abi-facts OUTPUT.json]\n       aurorac --check ");
        diagnostics.text("[--diagnostics=text|json] [--target linux|aurora] [--module-root DIR] ");
        return diagnostics.text("[--runtime-root DIR] INPUT.au");
    }
    if (error == unknown_argument()) {
        diagnostics.text("unknown or duplicate command-line argument: ");
        return diagnostics.text(cited);
    }
    if (error == 3) {
        return diagnostics.text("--module-root requires a directory");
    }
    if (error == 4) {
        return diagnostics.text("--runtime-root requires exactly one nonempty directory");
    }
    if (error == 5) {
        return diagnostics.text("exactly one -o OUTPUT.s is required");
    }
    if (error == 6) {
        return diagnostics.text("--stack-facts requires exactly one output path");
    }
    if (error == 7) {
        return diagnostics.text("--abi-facts requires exactly one output path");
    }
    if (error == 8) {
        return diagnostics.text("duplicate --emit-object option");
    }
    if (error == 9) {
        return diagnostics.text("duplicate --local-symbols option");
    }
    if (error == 10) {
        return diagnostics.text("duplicate --referenced-reflection-only option");
    }
    if (error == 11) {
        return diagnostics.text("duplicate --check option");
    }
    if (error == 12) {
        return diagnostics.text("exactly one diagnostic format may be specified");
    }
    if (error == 13) {
        return diagnostics.text("--check does not accept -o");
    }
    if (error == 14) {
        return diagnostics.text("--check does not accept --emit-object");
    }
    if (error == 15) {
        return diagnostics.text("--check does not accept --stack-facts");
    }
    if (error == 16) {
        return diagnostics.text("--stack-facts requires a nonempty output path");
    }
    if (error == 17) {
        return diagnostics.text("--check does not accept --abi-facts");
    }
    if (error == 18) {
        return diagnostics.text("--abi-facts requires a nonempty output path");
    }
    if (error == 19) {
        return diagnostics.text("--check does not accept --local-symbols");
    }
    if (error == 20) {
        return diagnostics.text("--check does not accept --referenced-reflection-only");
    }
    if (error == 21) {
        return diagnostics.text("--diagnostics=json requires --check");
    }
    if (error == 22) {
        diagnostics.text("--check and --lint are separate modes; --module-root and --runtime-root require --lint; ");
        return diagnostics.text("JSON requires a check mode");
    }
    if (error == 23) {
        diagnostics.text("usage: aurora-fmt [--check [--diagnostics=text|json]] INPUT.au\n       aurora-fmt --lint ");
        return diagnostics.text("[--diagnostics=text|json] [--module-root DIR] [--runtime-root DIR] INPUT.au");
    }
    if (error == 24) {
        return diagnostics.text("usage: aurorac --compose-private-object SOURCE WRAPPER SELECTED -o OUTPUT");
    }
    if (error == 26) {
        return diagnostics.text("exactly one --target linux or --target aurora may be given");
    }
    if (error == 27) {
        return diagnostics.text("exactly one --emit-object or --emit-executable may be given");
    }
    if (error == 28) {
        return diagnostics.text("--check does not accept --emit-executable");
    }
    if (error == 29) {
        return diagnostics.text("usage: aurorac --link-object INPUT.o -o OUTPUT");
    }
    return diagnostics.text("usage: aurorac --emit-frontend-wrapper RECIPE -o OUTPUT");
}

// A host status as the system names its cause.
auto status_text(Diagnostics& diagnostics, builtin::HostStatus status, bool empty) -> bool {
    if (status == builtin::HostStatus::not_found || (status == builtin::HostStatus::invalid_path && empty)) {
        return diagnostics.text("No such file or directory");
    }
    if (status == builtin::HostStatus::denied) {
        return diagnostics.text("Permission denied");
    }
    if (status == builtin::HostStatus::escape) {
        return diagnostics.text("Too many levels of symbolic links");
    }
    if (status == builtin::HostStatus::not_regular) {
        return diagnostics.text("Not a directory");
    }
    if (status == builtin::HostStatus::exhausted) {
        return diagnostics.text("Too many open files");
    }
    if (status == builtin::HostStatus::too_large) {
        return diagnostics.text("File too large");
    }
    if (status == builtin::HostStatus::invalid_path) {
        return diagnostics.text("File name too long");
    }
    if (status == builtin::HostStatus::invalid_handle) {
        return diagnostics.text("Bad file descriptor");
    }
    return diagnostics.text("Input/output error");
}
auto failure(Diagnostics& diagnostics, i64 code, builtin::span<const u8> message) -> bool {
    diagnostics.begin(code, false);
    return diagnostics.text(message);
}
// Linking errors describe unsupported or malformed input, never invoke a host tool.
auto link_failure(Diagnostics& diagnostics, compiler_static_link::Status status) -> bool {
    if (status == compiler_static_link::Status::allocation) {
        return failure(diagnostics, internal(), "static linker allocation failed");
    }
    if (status == compiler_static_link::Status::symbol) {
        return failure(diagnostics, unclassified(), "static link requires unique defined object symbols");
    }
    if (status == compiler_static_link::Status::entry) {
        return failure(diagnostics, unclassified(), "static link requires one global _start function");
    }
    if (status == compiler_static_link::Status::relocation) {
        return failure(diagnostics, unclassified(), "unsupported or malformed static-link relocation");
    }
    if (status == compiler_static_link::Status::limit) {
        return failure(diagnostics, unclassified(), "static executable exceeds 67108864 bytes");
    }
    return failure(diagnostics, unclassified(), "unsupported or malformed static-link object");
}

// A failed open of an explicitly named file.
auto open_failure(Diagnostics& diagnostics, builtin::span<const u8> message, builtin::HostStatus status,
    bool empty) -> bool {
    if (status == builtin::HostStatus::not_regular) {
        return failure(diagnostics, unclassified(), "source is not a regular file");
    }
    failure(diagnostics, unclassified(), message);
    return status_text(diagnostics, status, empty);
}
// A failed open of a module root or output directory.
auto directory_failure(Diagnostics& diagnostics, builtin::HostStatus status, bool empty) -> bool {
    failure(diagnostics, unclassified(), "module root is not an accessible no-symlink directory: ");
    return status_text(diagnostics, status, empty);
}
// A failed open beneath a root other than a missing file.
auto beneath_failure(Diagnostics& diagnostics, builtin::HostStatus status) -> bool {
    if (status == builtin::HostStatus::escape) {
        return failure(diagnostics, unclassified(), "module path is a symlink or escapes its explicit search root");
    }
    if (status == builtin::HostStatus::not_regular) {
        return failure(diagnostics, unclassified(), "source is not a regular file");
    }
    failure(diagnostics, unclassified(), "cannot open module under beneath-root source policy: ");
    return status_text(diagnostics, status, false);
}
// A failed output creation (with creating) or write. A creation that
// fails on a missing or symlinked parent names that directory.
auto output_failure(Diagnostics& diagnostics, builtin::HostStatus status, bool creating) -> bool {
    if (status == builtin::HostStatus::invalid_path) {
        return failure(diagnostics, unclassified(), "artifact output requires one filename leaf");
    }
    if (status == builtin::HostStatus::not_regular) {
        return failure(diagnostics, unclassified(),
            "artifact destination must be a regular file, not a symlink or directory");
    }
    if (status == builtin::HostStatus::too_large) {
        return failure(diagnostics, unclassified(), "artifact exceeds destination output limit");
    }
    if (creating && (status == builtin::HostStatus::not_found || status == builtin::HostStatus::escape)) {
        return directory_failure(diagnostics, status, false);
    }
    if (creating) {
        failure(diagnostics, unclassified(), "cannot create exclusive artifact temporary: ");
    } else {
        failure(diagnostics, unclassified(), "cannot write artifact temporary: ");
    }
    return status_text(diagnostics, status, false);
}

// An unconfirmed commit may already have published the destination. Never
// describe a lost commit reply as a failed temporary write or as rollback.
auto commit_failure(Diagnostics& diagnostics, builtin::HostStatus status) -> bool {
    failure(diagnostics, unclassified(), "artifact commit was not confirmed; destination may have changed: ");
    return status_text(diagnostics, status, false);
}

// Prints the run's diagnostics: JSON on stdout for aurorac (stderr for
// aurora-fmt), text on stderr.
auto print(builtin::HostFiles& files, builtin::span<const u8> rendered, bool stdout) -> builtin::HostStatus {
    if (stdout) {
        return files.print(builtin::HostStream::stdout, rendered);
    }
    return files.print(builtin::HostStream::stderr, rendered);
}
// The display path of a module beneath a root: ROOT/RELATIVE.
auto module_path(Text& paths, builtin::span<const u8> root, builtin::span<const u8> relative) -> bool {
    paths.append(root);
    if (root.size() == 0 || root.at(root.size() - 1) != '/') {
        paths.push('/');
    }
    return paths.append(relative);
}

// The ith --module-root value.
auto root_word(const Ranges& words, builtin::span<const u8> arguments, i64 ordinal) -> Range {
    i64 index = 1;
    i64 found = 0;
    while (index < words.size()) {
        if (is(words, arguments, index, "--module-root") && index + 1 < words.size()) {
            if (found == ordinal) {
                const Range result = words.at(index + 1);
                return result;
            }
            found = found + 1;
            index = index + 1;
        } else {
            if (is(words, arguments, index, "--compose-private-object")) {
                index = index + 3;
            } else {
                if (is(words, arguments, index, "--emit-frontend-wrapper") || is(words, arguments, index, "-o")
                    || is(words, arguments, index, "--stack-facts") || is(words, arguments, index, "--abi-facts")
                    || is(words, arguments, index, "--runtime-root")) {
                    index = index + 1;
                }
            }
        }
        index = index + 1;
    }
    const Range missing = Range{
        .begin = 0,
        .count = -1
    };
    return missing;
}

// What a destination is just before its output commits: its identity (0 and
// 0 when absent), so a source swapped in after the output was created is
// still refused.
auto destination_now(builtin::HostFiles& files, builtin::span<const u8> path) -> builtin::HostFileResult {
    const builtin::HostFileResult found = files.open_file(path);
    if (found.status == builtin::HostStatus::success) {
        files.close(found.id);
    }
    return found;
}
// Whether that destination may still be replaced: absent, or a regular file
// that is none of the sources read.
auto destination_unchanged(Diagnostics& diagnostics, const Identities& identities, builtin::HostStatus status,
    u64 device, u64 inode) -> bool {
    if (status == builtin::HostStatus::not_found) {
        return true;
    }
    if (status == builtin::HostStatus::escape || status == builtin::HostStatus::not_regular) {
        return !output_failure(diagnostics, builtin::HostStatus::not_regular, false);
    }
    if (status != builtin::HostStatus::success) {
        failure(diagnostics, unclassified(), "cannot inspect artifact entry: ");
        return !status_text(diagnostics, status, false);
    }
    if (identities.contains(device, inode)) {
        return !failure(diagnostics, unclassified(), "artifact destination aliases a root or imported source file");
    }
    return true;
}

// The open module roots in command-line order, with their identities, and
// the runtime root once a reserved import needs it.
class Roots {
    array<u64, 16> handles;
    array<u64, 16> devices;
    array<u64, 16> inodes;
    i64 count;
    u64 runtimeHandle;
public:
    Roots() : handles{}, devices{}, inodes{}, count(0), runtimeHandle(0u64) {
    }
    auto size() const -> i64 {
        return count;
    }
    auto handle(i64 index) const -> u64 {
        return handles[index];
    }
    auto contains(u64 device, u64 inode) const -> bool {
        i64 at = 0;
        while (at < count) {
            if (devices[at] == device && inodes[at] == inode) {
                return true;
            }
            at = at + 1;
        }
        return false;
    }
    auto add(u64 id, u64 device, u64 inode) -> bool {
        handles[count] = id;
        devices[count] = device;
        inodes[count] = inode;
        count = count + 1;
        return true;
    }
    auto runtime() const -> u64 {
        return runtimeHandle;
    }
    auto set_runtime(u64 id) -> bool {
        runtimeHandle = id;
        return true;
    }
};

// An output being written: its id, its directory's identity and the
// argument naming it, so two outputs cannot share a destination.
class Output {
public:
    u64 id;
    u64 device;
    u64 inode;
    i64 path;
};
auto no_output() -> Output {
    const Output result = Output{
        .id = 0u64,
        .device = 0u64,
        .inode = 0u64,
        .path = 0
    };
    return result;
}
// The last component of a path, where an output's leaf is.
auto leaf(builtin::span<const u8> path) -> Range {
    i64 begin = 0;
    i64 at = 0;
    while (at < path.size()) {
        if (path.at(at) == '/') {
            begin = at + 1;
        }
        at = at + 1;
    }
    const Range result = Range{
        .begin = begin,
        .count = path.size() - begin
    };
    return result;
}
auto same_destination(const Ranges& words, builtin::span<const u8> arguments, Output first, Output second) -> bool {
    if (first.id == 0u64 || second.id == 0u64 || first.device != second.device || first.inode != second.inode) {
        return false;
    }
    const Range left = words.at(first.path);
    const Range right = words.at(second.path);
    const builtin::span<const u8> left_path = arguments.subspan(left.begin, left.count);
    const builtin::span<const u8> right_path = arguments.subspan(right.begin, right.count);
    const Range left_leaf = leaf(left_path);
    const Range right_leaf = leaf(right_path);
    return same(left_path.subspan(left_leaf.begin, left_leaf.count), right_path.subspan(right_leaf.begin,
        right_leaf.count));
}

// The pipeline options word: emit 1, local symbols 2, referenced reflection
// only 4, object 8, stack facts 16, ABI facts 32.
auto pipeline_options(Options options) -> u64 {
    u64 result = 0u64;
    if (options.target == 2) {
        result = 128u64;
    }
    if (options.check || options.lint) {
        return result;
    }
    result = result + 1u64;
    if (options.local) {
        result = result + 2u64;
    }
    if (options.referenced) {
        result = result + 4u64;
    }
    if (options.object || options.executable) {
        result = result + 8u64;
    }
    if (options.stack != 0) {
        result = result + 16u64;
    }
    if (options.abi != 0) {
        result = result + 32u64;
    }
    return result;
}
// The display path of module index, or a count of -1 for an index that names
// no module.
auto module_range(const Ranges& paths, i64 index) -> Range {
    if (index < 0) {
        return none_range();
    }
    if (index >= paths.size()) {
        const Range invalid = Range{
            .begin = 0,
            .count = -1
        };
        return invalid;
    }
    const Range result = paths.at(index);
    return result;
}
// The largest source the loader captures: one byte past the per-file limit,
// so Aurora's limit check sees an oversized file.
auto capture_limit() -> i64 {
    return 1048577;
}

// Loads the graph of the input and runs the compilation the options select,
// then writes its artifacts or, for aurora-fmt --lint, prints its warnings.
// The root source and each import Aurora requests are read beneath their
// roots; Aurora renders every rejection and the host-side ones are named here.
auto compile(builtin::HostFiles& files, builtin::ByteRegion region, builtin::span<const u8> arguments,
    builtin::span<const u8> configured, Options options, bool formatter) -> builtin::HostExit {
    Ranges words = Ranges(region);
    split_words(words, arguments);
    Diagnostics diagnostics = Diagnostics(region);
    Text sources = Text(region);
    Ranges source_ranges = Ranges(region);
    Text paths = Text(region);
    Ranges path_ranges = Ranges(region);
    Text name = Text(region);
    Text relative = Text(region);
    Identities identities = Identities(region);
    Roots roots = Roots();
    Text context = Text(region);
    Range runtime_word = Range{
        .begin = 0,
        .count = -1
    };
    if (options.runtime != 0) {
        const Range named_runtime = words.at(options.runtime);
        runtime_word.begin = named_runtime.begin;
        runtime_word.count = named_runtime.count;
    }
    bool ok = true;
    if (options.roots > 16) {
        failure(diagnostics, module_family(), "at most 16 explicit module roots are supported");
        ok = false;
    }
    i64 ordinal = 0;
    while (ok && ordinal < options.roots) {
        const Range root = root_word(words, arguments, ordinal);
        const builtin::HostDirectoryResult opened = files.open_directory(arguments.subspan(root.begin, root.count));
        if (opened.status != builtin::HostStatus::success) {
            directory_failure(diagnostics, opened.status, root.count == 0);
            ok = false;
        } else {
            if (roots.contains(opened.device, opened.inode)) {
                failure(diagnostics, unclassified(), "duplicate module search root");
                ok = false;
            }
            roots.add(opened.id, opened.device, opened.inode);
        }
        ordinal = ordinal + 1;
    }
    // The root source is module 0; each requested import becomes the next.
    u64 pending = 0u64;
    if (ok) {
        const Range input = words.at(options.input);
        const builtin::span<const u8> input_path = arguments.subspan(input.begin, input.count);
        const builtin::HostFileResult file = files.open_file(input_path);
        if (file.status != builtin::HostStatus::success) {
            open_failure(diagnostics, "cannot open input under no-symlink source policy: ", file.status, input.count
                == 0);
            ok = false;
        } else {
            pending = file.id;
            identities.add(file.device, file.inode);
            path_ranges.add(paths.size(), input_path.size());
            paths.append(input_path);
        }
    }
    compiler_resolver::Session session = compiler_resolver::create(region);
    compiler_parser::AstArena arena = compiler_parser::create(region, 0);
    bool rejected_session = false;
    bool importing = false;
    while (ok && pending != 0u64) {
        const i64 begin = sources.size();
        u64 offset = 0u64;
        bool reading = true;
        while (reading) {
            const builtin::HostChunk chunk = files.read(pending, offset);
            if (chunk.status != builtin::HostStatus::success) {
                failure(diagnostics, unclassified(), "cannot read opened source: ");
                status_text(diagnostics, chunk.status, false);
                if (importing) {
                    // As the loader names the module whose source failed to read.
                    context.truncate(0);
                    context.append("module ");
                    context.append(name.view());
                    context.append(": ");
                    diagnostics.prefix(context.view());
                }
                ok = false;
                reading = false;
            } else {
                if (chunk.count == 0u64) {
                    reading = false;
                } else {
                    sources.append_chunk(chunk);
                    offset = offset + chunk.count;
                    reading = sources.size() - begin < capture_limit();
                }
            }
        }
        files.close(pending);
        pending = 0u64;
        if (sources.size() - begin > capture_limit()) {
            sources.truncate(begin + capture_limit());
        }
        source_ranges.add(begin, sources.size() - begin);
        // A truncated source is never parsed; the failure is reported below.
        ok = ok && sources.good() && source_ranges.good();
        if (ok) {
            // Aurora lexes, parses and admits the source, charges it against
            // its byte limits and ingests it as the next module.
            const builtin::span<const u8> source = sources.part(begin, sources.size() - begin);
            const compiler_resolver::SourceResult parsed = compiler_resolver::parse_source(arena, source);
            if (compiler_resolver::load_source(session, source, parsed) < 0 || compiler_resolver::ingest_source(session,
                arena) < 0) {
                rejected_session = true;
                ok = false;
            }
        }
        if (ok) {
            const compiler_resolver::WorkRow step = compiler_resolver::load_step(session, 0, roots.size());
            if (step.word(0) != 0 && step.word(0) != 1) {
                rejected_session = true;
                ok = false;
            }
            if (step.word(0) == 1 && (step.word(1) < 0 || step.word(1) >= source_ranges.size())) {
                failure(diagnostics, internal(), "invalid hosted resolution result");
                ok = false;
            }
            if (ok && step.word(0) == 1) {
                importing = true;
                const Range requester = source_ranges.at(step.word(1));
                const builtin::span<const u8> text = sources.part(requester.begin, requester.count);
                name.truncate(0);
                relative.truncate(0);
                bool more = true;
                while (ok && more) {
                    const compiler_resolver::LinkageChunk part = compiler_resolver::name_chunk(text, step.word(2),
                        step.word(3), name.size(), false);
                    ok = name.append_name(part);
                    more = part.size() == 512;
                }
                more = true;
                while (ok && more) {
                    const compiler_resolver::LinkageChunk part = compiler_resolver::name_chunk(text, step.word(2),
                        step.word(3), relative.size(), true);
                    ok = relative.append_name(part);
                    more = part.size() == 512;
                }
                if (!ok) {
                    failure(diagnostics, internal(), "invalid hosted resolution result");
                }
                const bool reserved = step.word(4) == 1;
                // The roots this import is looked for in: the runtime root
                // alone for a reserved name, which no module root may hold.
                i64 found = -1;
                u64 found_id = 0u64;
                u64 found_device = 0u64;
                u64 found_inode = 0u64;
                bool ambiguous = false;
                i64 at = 0;
                while (ok && at < roots.size()) {
                    const builtin::HostFileResult file = files.open_beneath(roots.handle(at), relative.view());
                    if (file.status == builtin::HostStatus::success) {
                        if (reserved) {
                            files.close(file.id);
                            failure(diagnostics, unclassified(), "reserved compiler module found in a module root: ");
                            diagnostics.text(name.view());
                            diagnostics.text(" (aurora.* modules load only from the compiler's runtime root)");
                            ok = false;
                        } else {
                            if (found >= 0) {
                                files.close(file.id);
                                ambiguous = true;
                            } else {
                                found = at;
                                found_id = file.id;
                                found_device = file.device;
                                found_inode = file.inode;
                            }
                        }
                    } else {
                        if (file.status != builtin::HostStatus::not_found) {
                            beneath_failure(diagnostics, file.status);
                            ok = false;
                        }
                    }
                    at = at + 1;
                }
                if (ok && reserved) {
                    if (roots.runtime() == 0u64) {
                        const builtin::HostDirectoryResult opened = open_runtime(files, arguments, configured,
                            runtime_word);
                        if (opened.status != builtin::HostStatus::success) {
                            directory_failure(diagnostics, opened.status, false);
                            ok = false;
                        } else {
                            roots.set_runtime(opened.id);
                        }
                    }
                    if (ok) {
                        const builtin::HostFileResult file = files.open_beneath(roots.runtime(), relative.view());
                        if (file.status == builtin::HostStatus::success) {
                            found = 16;
                            found_id = file.id;
                            found_device = file.device;
                            found_inode = file.inode;
                        } else {
                            if (file.status == builtin::HostStatus::not_found) {
                                failure(diagnostics, unclassified(),
                                    "module not found in the compiler's runtime root: ");
                                diagnostics.text(name.view());
                            } else {
                                beneath_failure(diagnostics, file.status);
                            }
                            ok = false;
                        }
                    }
                }
                if (ok && found < 0) {
                    failure(diagnostics, unclassified(), "module not found in explicit roots: ");
                    diagnostics.text(name.view());
                    ok = false;
                }
                if (ok && ambiguous) {
                    failure(diagnostics, unclassified(), "ambiguous module found in multiple roots: ");
                    diagnostics.text(name.view());
                    ok = false;
                }
                if (!ok && found_id != 0u64) {
                    files.close(found_id);
                }
                if (ok) {
                    pending = found_id;
                    identities.add(found_device, found_inode);
                    const i64 path_begin = paths.size();
                    if (found == 16 && runtime_word.count < 0) {
                        module_path(paths, configured, relative.view());
                    } else {
                        Range root = runtime_word;
                        if (found < 16) {
                            const Range named_root = root_word(words, arguments, found);
                            root.begin = named_root.begin;
                            root.count = named_root.count;
                        }
                        module_path(paths, arguments.subspan(root.begin, root.count), relative.view());
                    }
                    path_ranges.add(path_begin, paths.size() - path_begin);
                }
            }
        }
    }
    compiler_parser::release(region, move(arena));
    i64 root_row = -1;
    i64 diagnostic_row = -1;
    if (ok) {
        // Aurora binds any import the graph walk left unbound, resolves the
        // graph and lowers it; lowering publishes its own limits and prelude.
        i64 mode = 0;
        if (options.lint) {
            mode = 1;
        }
        if (compiler_resolver::run(session) != 0 || compiler_lowering::begin_lowering(session, mode) != 1) {
            rejected_session = true;
            ok = false;
        } else {
            const compiler_lowering::LoweringResult lowered = compiler_lowering::run_lowering(session);
            if (lowered.status() != compiler_lowering::LoweringStatus::success) {
                rejected_session = true;
                ok = false;
            }
            root_row = lowered.module_root();
            diagnostic_row = lowered.diagnostic_payload_row();
        }
    }
    if (rejected_session) {
        const compiler_resolver::Report first = compiler_resolver::report(session, 0);
        const Range where = module_range(path_ranges, first.source_index());
        if (where.count < 0) {
            failure(diagnostics, internal(), "invalid hosted resolution result");
        } else {
            diagnostics.report(first, paths.part(where.begin, where.count));
            while (diagnostics.pending()) {
                const i64 at = diagnostics.offset();
                const compiler_resolver::Report part = compiler_resolver::report(session, at);
                diagnostics.more(part);
            }
        }
    }
    if (!sources.good() || !source_ranges.good() || !paths.good() || !path_ranges.good() || !name.good()
        || !relative.good() || !identities.good()) {
        // The allocation failure is the run's only diagnostic.
        diagnostics.clear();
        failure(diagnostics, internal(), "hosted driver allocation failed");
        ok = false;
    }
    if (!ok) {
        diagnostics.default_code(module_family());
        render_failure(diagnostics, options.json, formatter);
        print(files, diagnostics.output(), options.json && !formatter);
        return exit_for(diagnostics, formatter);
    }
    // The rest of the compilation is one Aurora call that consumes the Session.
    const compiler_pipeline::Result result = compiler_pipeline::run(region, move(session), root_row, diagnostic_row,
        pipeline_options(options));
    if (!result.complete()) {
        const compiler_resolver::Report first = compiler_pipeline::diagnostic(result, 0, 0);
        const Range where = module_range(path_ranges, first.source_index());
        if (where.count < 0) {
            failure(diagnostics, internal(), "invalid hosted resolution result");
        } else {
            diagnostics.report(first, paths.part(where.begin, where.count));
            while (diagnostics.pending()) {
                const i64 at = diagnostics.offset();
                const compiler_resolver::Report part = compiler_pipeline::diagnostic(result, 0, at);
                diagnostics.more(part);
            }
        }
        diagnostics.default_code(module_family());
        render_failure(diagnostics, options.json, formatter);
        print(files, diagnostics.output(), options.json && !formatter);
        return exit_for(diagnostics, formatter);
    }
    if (options.lint) {
        // Unread-local warnings, ordered by source offset.
        i64 lint = 0;
        while (lint < result.lint_count()) {
            const compiler_resolver::Report first = compiler_pipeline::diagnostic(result, lint, 0);
            const Range where = module_range(path_ranges, first.source_index());
            if (where.count < 0) {
                diagnostics.clear();
                failure(diagnostics, internal(), "invalid hosted resolution result");
                render_failure(diagnostics, options.json, formatter);
                print(files, diagnostics.output(), options.json && !formatter);
                return exit_for(diagnostics, formatter);
            }
            diagnostics.report(first, paths.part(where.begin, where.count));
            while (diagnostics.pending()) {
                const i64 at = diagnostics.offset();
                const compiler_resolver::Report part = compiler_pipeline::diagnostic(result, lint, at);
                diagnostics.more(part);
            }
            if (diagnostics.malformed()) {
                diagnostics.clear();
                failure(diagnostics, internal(), "invalid hosted resolution result");
                render_failure(diagnostics, options.json, formatter);
                print(files, diagnostics.output(), options.json && !formatter);
                return exit_for(diagnostics, formatter);
            }
            lint = lint + 1;
        }
        if (options.json) {
            diagnostics.render_json();
        } else {
            diagnostics.render_all("aurora-fmt");
        }
        files.print(builtin::HostStream::stderr, diagnostics.output());
        return builtin::HostExit::success;
    }
    if (options.check) {
        if (options.json) {
            diagnostics.render_json();
            files.print(builtin::HostStream::stdout, diagnostics.output());
        }
        return builtin::HostExit::success;
    }
    // Artifacts are copied out whole; code and ABI facts keep the 64 MiB limit.
    const builtin::span<const u8> code = result.artifact_view(compiler_x86::Artifact::assembly);
    const builtin::span<const u8> stack = result.artifact_view(compiler_x86::Artifact::stack);
    const builtin::span<const u8> abi = result.artifact_view(compiler_x86::Artifact::abi);
    if (code.size() > 67108864 || abi.size() > 67108864) {
        failure(diagnostics, internal(), "invalid hosted x86 emission transport");
        render_failure(diagnostics, options.json, formatter);
        print(files, diagnostics.output(), options.json && !formatter);
        return exit_for(diagnostics, formatter);
    }
    compiler_static_link::Workspace linked = compiler_static_link::Workspace(region);
    if (options.executable) {
        const compiler_static_link::Status status = linked.run(code);
        if (status != compiler_static_link::Status::complete) {
            link_failure(diagnostics, status);
            render_failure(diagnostics, options.json, formatter);
            print(files, diagnostics.output(), options.json && !formatter);
            return exit_for(diagnostics, formatter);
        }
    }
    // Each output is an exclusive temporary beside its destination, renamed
    // into place on commit; one that would replace a source, or two outputs
    // naming one destination, fail. Uncommitted outputs are discarded when
    // main returns.
    Output code_output = no_output();
    Output stack_output = no_output();
    Output abi_output = no_output();
    i64 kind = 0;
    while (ok && kind < 3) {
        i64 path = options.output;
        if (kind == 1) {
            path = options.stack;
        }
        if (kind == 2) {
            path = options.abi;
        }
        if (path != 0) {
            const Range where = words.at(path);
            const builtin::HostOutputResult created = files.create_output(arguments.subspan(where.begin, where.count));
            const Output opened = Output{
                .id = created.id,
                .device = created.directory_device,
                .inode = created.directory_inode,
                .path = path
            };
            if (created.status != builtin::HostStatus::success) {
                output_failure(diagnostics, created.status, true);
                ok = false;
            } else {
                if (identities.contains(created.device, created.inode)) {
                    failure(diagnostics, unclassified(), "artifact destination aliases a root or imported source file");
                    ok = false;
                }
            }
            if (ok && kind == 1 && same_destination(words, arguments, code_output, opened)) {
                failure(diagnostics, command_line(), "assembly and stack facts require different output paths");
                ok = false;
            }
            if (ok && kind == 2 && (same_destination(words, arguments, code_output, opened) || same_destination(words,
                arguments, stack_output, opened))) {
                failure(diagnostics, command_line(),
                    "assembly, stack facts and ABI facts require different output paths");
                ok = false;
            }
            if (ok && kind == 0) {
                code_output.id = opened.id;
                code_output.device = opened.device;
                code_output.inode = opened.inode;
                code_output.path = path;
            }
            if (ok && kind == 1) {
                stack_output.id = opened.id;
                stack_output.device = opened.device;
                stack_output.inode = opened.inode;
                stack_output.path = path;
                const builtin::HostStatus written = files.write(opened.id, stack);
                if (written != builtin::HostStatus::success) {
                    output_failure(diagnostics, written, false);
                    ok = false;
                }
            }
            if (ok && kind == 2) {
                abi_output.id = opened.id;
                abi_output.device = opened.device;
                abi_output.inode = opened.inode;
                abi_output.path = path;
                const builtin::HostStatus written = files.write(opened.id, abi);
                if (written != builtin::HostStatus::success) {
                    output_failure(diagnostics, written, false);
                    ok = false;
                }
            }
        }
        kind = kind + 1;
    }
    if (ok) {
        builtin::HostStatus written = builtin::HostStatus::success;
        if (options.executable) {
            written = files.write(code_output.id, linked.bytes());
        } else {
            written = files.write(code_output.id, code);
        }
        if (written != builtin::HostStatus::success) {
            output_failure(diagnostics, written, false);
            ok = false;
        }
    }
    // ABI facts, then stack facts, then the code; each destination is checked
    // again just before its commit, as the source-alias check at creation was.
    kind = 0;
    while (ok && kind < 3) {
        u64 id = abi_output.id;
        i64 path = abi_output.path;
        if (kind == 1) {
            id = stack_output.id;
            path = stack_output.path;
        }
        if (kind == 2) {
            id = code_output.id;
            path = code_output.path;
        }
        if (id != 0u64) {
            const Range where = words.at(path);
            const builtin::HostFileResult now = destination_now(files, arguments.subspan(where.begin, where.count));
            ok = destination_unchanged(diagnostics, identities, now.status, now.device, now.inode);
        }
        if (ok && id != 0u64) {
            const builtin::HostStatus committed = files.commit(id);
            if (committed != builtin::HostStatus::success) {
                commit_failure(diagnostics, committed);
                ok = false;
            }
        }
        kind = kind + 1;
    }
    if (!ok) {
        render_failure(diagnostics, options.json, formatter);
        print(files, diagnostics.output(), options.json && !formatter);
        return exit_for(diagnostics, formatter);
    }
    return builtin::HostExit::success;
}

// The runtime root --runtime-root names (word count >= 0), or the configured one.
auto open_runtime(builtin::HostFiles& files, builtin::span<const u8> arguments, builtin::span<const u8> configured,
    Range named) -> builtin::HostDirectoryResult {
    if (named.count >= 0) {
        const builtin::HostDirectoryResult result = files.open_directory(arguments.subspan(named.begin, named.count));
        return result;
    }
    const builtin::HostDirectoryResult result = files.open_directory(configured);
    return result;
}
// Renders a failed run's diagnostics for its tool.
auto render_failure(Diagnostics& diagnostics, bool json, bool formatter) -> bool {
    if (json) {
        return diagnostics.render_json();
    }
    if (formatter) {
        return diagnostics.render_all("aurora-fmt");
    }
    return diagnostics.render_all("aurorac");
}
// The exit status of a failed run: aurora-fmt's is always usage, aurorac's
// only for a command-line rejection.
auto exit_for(const Diagnostics& diagnostics, bool formatter) -> builtin::HostExit {
    if (formatter || (diagnostics.count() > 0 && diagnostics.code(diagnostics.count() - 1) == command_line())) {
        return builtin::HostExit::usage;
    }
    return builtin::HostExit::failure;
}

// aurora-fmt: formats one file to stdout, or with --check reports whether it
// is formatted and its style findings. The source is read whole (1 MiB at
// most) and one Aurora call parses, lays out and verifies the output.
auto format(builtin::HostFiles& files, builtin::ByteRegion region, builtin::span<const u8> arguments,
    Options options) -> builtin::HostExit {
    Ranges words = Ranges(region);
    split_words(words, arguments);
    Diagnostics diagnostics = Diagnostics(region);
    Text source = Text(region);
    const Range input = words.at(options.input);
    const builtin::span<const u8> path = arguments.subspan(input.begin, input.count);
    bool ok = true;
    const builtin::HostFileResult file = files.open_file(path);
    if (file.status != builtin::HostStatus::success) {
        open_failure(diagnostics, "cannot open input under no-symlink source policy: ", file.status, input.count == 0);
        ok = false;
    }
    u64 offset = 0u64;
    bool reading = ok;
    while (reading) {
        const builtin::HostChunk chunk = files.read(file.id, offset);
        if (chunk.status != builtin::HostStatus::success) {
            failure(diagnostics, unclassified(), "cannot read opened source: ");
            status_text(diagnostics, chunk.status, false);
            ok = false;
            reading = false;
        } else {
            if (chunk.count == 0u64) {
                reading = false;
            } else {
                source.append_chunk(chunk);
                offset = offset + chunk.count;
                if (source.size() > 1048576) {
                    failure(diagnostics, unclassified(), "bounded source read limit exceeded");
                    ok = false;
                    reading = false;
                }
            }
        }
    }
    if (!source.good()) {
        failure(diagnostics, internal(), "hosted driver allocation failed");
        ok = false;
    }
    compiler_formatter::Workspace workspace = compiler_formatter::create(region);
    if (ok && !workspace.begin(source.view())) {
        const compiler_resolver::Report first = compiler_formatter::diagnostic(workspace, -1, 0);
        diagnostics.report(first, path);
        while (diagnostics.pending()) {
            const i64 at = diagnostics.offset();
            const compiler_resolver::Report part = compiler_formatter::diagnostic(workspace, -1, at);
            diagnostics.more(part);
        }
        ok = false;
    }
    if (!ok) {
        diagnostics.default_code(module_family());
        render_failure(diagnostics, options.json, true);
        files.print(builtin::HostStream::stderr, diagnostics.output());
        return builtin::HostExit::usage;
    }
    const compiler_formatter::Workspace done = compiler_formatter::run(region, move(workspace), true);
    // Status 4 completes; 7 rejects the output, whose text stays readable and
    // is the failure's source 1.
    const compiler_formatter::Row summary = done.read_finding(-1);
    if (summary.a != 4) {
        const compiler_resolver::Report report = compiler_formatter::diagnostic(done, -1, 0);
        if (report.source_index() > 1 || (report.source_index() == 1 && summary.a != 7)) {
            failure(diagnostics, internal(), "invalid hosted formatter result");
        } else {
            diagnostics.report(report, path);
            while (diagnostics.pending()) {
                const i64 at = diagnostics.offset();
                const compiler_resolver::Report part = compiler_formatter::diagnostic(done, -1, at);
                diagnostics.more(part);
            }
        }
        render_failure(diagnostics, options.json, true);
        files.print(builtin::HostStream::stderr, diagnostics.output());
        return builtin::HostExit::usage;
    }
    // The source's findings for --check, else those of the output.
    i64 index = 0;
    i64 last = summary.c;
    if (!options.check) {
        index = summary.c;
        last = summary.c + summary.d;
    }
    while (index < last) {
        const compiler_resolver::Report report = compiler_formatter::diagnostic(done, index, 0);
        if (report.source_index() > 1) {
            diagnostics.clear();
            failure(diagnostics, internal(), "invalid hosted formatter result");
            render_failure(diagnostics, options.json, true);
            files.print(builtin::HostStream::stderr, diagnostics.output());
            return builtin::HostExit::usage;
        }
        diagnostics.report(report, path);
        while (diagnostics.pending()) {
            const i64 at = diagnostics.offset();
            const compiler_resolver::Report part = compiler_formatter::diagnostic(done, index, at);
            diagnostics.more(part);
        }
        if (diagnostics.malformed()) {
            diagnostics.clear();
            failure(diagnostics, internal(), "invalid hosted resolution result");
            render_failure(diagnostics, options.json, true);
            files.print(builtin::HostStream::stderr, diagnostics.output());
            return builtin::HostExit::usage;
        }
        diagnostics.restyle();
        index = index + 1;
    }
    const bool changed = !same(source.view(), done.formatted());
    if (options.check) {
        diagnostics.render_findings(0, options.json, changed);
        files.print(builtin::HostStream::stderr, diagnostics.output());
        if (changed || summary.c > 0) {
            return builtin::HostExit::failure;
        }
        return builtin::HostExit::success;
    }
    if (summary.d > 0) {
        diagnostics.render_findings(0, false, false);
        files.print(builtin::HostStream::stderr, diagnostics.output());
    }
    if (files.print(builtin::HostStream::stdout, done.formatted()) != builtin::HostStatus::success) {
        diagnostics.clear();
        failure(diagnostics, internal(), "cannot write formatted output");
        render_failure(diagnostics, options.json, true);
        files.print(builtin::HostStream::stderr, diagnostics.output());
        return builtin::HostExit::usage;
    }
    return builtin::HostExit::success;
}

// An artifact input of the object tools: at most 64 MiB of a regular file.
auto artifact_limit() -> i64 {
    return 67108864;
}

// aurorac --compose-private-object SOURCE WRAPPER SELECTED -o OUTPUT and
// --emit-frontend-wrapper RECIPE -o OUTPUT or --link-object INPUT -o OUTPUT:
// Aurora admits the inputs and
// composes or emits the object; the host only reads and writes the bytes.
auto objects(builtin::HostFiles& files, builtin::ByteRegion region,
    builtin::span<const u8> arguments) -> builtin::HostExit {
    Ranges words = Ranges(region);
    split_words(words, arguments);
    Diagnostics diagnostics = Diagnostics(region);
    Identities identities = Identities(region);
    const bool json = json_requested(words, arguments, false);
    const bool compose = is(words, arguments, 1, "--compose-private-object");
    const bool link = is(words, arguments, 1, "--link-object");
    bool ok = true;
    if (compose && (words.size() != 7 || !is(words, arguments, 5, "-o"))) {
        usage_message(diagnostics, 24, "");
        ok = false;
    }
    if (!compose && (words.size() != 5 || !is(words, arguments, 3, "-o"))) {
        i64 message = 25;
        if (link) {
            message = 29;
        }
        usage_message(diagnostics, message, "");
        ok = false;
    }
    i64 inputs = 1;
    i64 destination = 4;
    if (compose) {
        inputs = 3;
        destination = 6;
    }
    // Every input is opened before any is read, as the paths are given.
    Text first = Text(region);
    Text second = Text(region);
    Text third = Text(region);
    u64 first_id = 0u64;
    u64 second_id = 0u64;
    u64 third_id = 0u64;
    i64 input = 0;
    while (ok && input < inputs) {
        const Range named = words.at(2 + input);
        const builtin::HostFileResult file = files.open_file(arguments.subspan(named.begin, named.count));
        if (file.status != builtin::HostStatus::success) {
            open_failure(diagnostics, "cannot open artifact input under no-symlink policy: ", file.status, named.count
                == 0);
            ok = false;
        } else {
            identities.add(file.device, file.inode);
            if (file.size > u64(artifact_limit())) {
                failure(diagnostics, unclassified(), "bounded artifact read limit exceeded");
                ok = false;
            }
            if (input == 0) {
                first_id = file.id;
            }
            if (input == 1) {
                second_id = file.id;
            }
            if (input == 2) {
                third_id = file.id;
            }
        }
        input = input + 1;
    }
    input = 0;
    while (ok && input < inputs) {
        u64 id = first_id;
        if (input == 1) {
            id = second_id;
        }
        if (input == 2) {
            id = third_id;
        }
        u64 offset = 0u64;
        bool reading = true;
        while (reading) {
            const builtin::HostChunk chunk = files.read(id, offset);
            if (chunk.status != builtin::HostStatus::success) {
                failure(diagnostics, unclassified(), "cannot read opened source: ");
                status_text(diagnostics, chunk.status, false);
                ok = false;
                reading = false;
            } else {
                if (chunk.count == 0u64) {
                    reading = false;
                } else {
                    offset = offset + chunk.count;
                    if (input == 0) {
                        first.append_chunk(chunk);
                    }
                    if (input == 1) {
                        second.append_chunk(chunk);
                    }
                    if (input == 2) {
                        third.append_chunk(chunk);
                    }
                    if (offset > u64(artifact_limit())) {
                        failure(diagnostics, unclassified(), "bounded artifact read limit exceeded");
                        ok = false;
                        reading = false;
                    }
                }
            }
        }
        input = input + 1;
    }
    if (!first.good() || !second.good() || !third.good() || !identities.good()) {
        failure(diagnostics, internal(), "hosted driver allocation failed");
        ok = false;
    }
    if (!ok) {
        render_failure(diagnostics, json, false);
        print(files, diagnostics.output(), json);
        return exit_for(diagnostics, false);
    }
    compiler_static_link::Workspace linked = compiler_static_link::Workspace(region);
    compiler_private_object::Workspace composed = compiler_private_object::create(region);
    compiler_x86::ObjectWorkspace wrapper = compiler_x86::object_create(region);
    compiler_x86::EmitStatus status = compiler_x86::EmitStatus::complete;
    i64 size = 0;
    if (compose) {
        status = compiler_private_object::run(composed, first.view(), second.view(), third.view());
        size = composed.size();
    } else {
        if (link) {
            const compiler_static_link::Status linked_status = linked.run(first.view());
            if (linked_status != compiler_static_link::Status::complete) {
                link_failure(diagnostics, linked_status);
                ok = false;
            } else {
                const builtin::span<const u8> bytes = linked.bytes();
                size = bytes.size();
            }
        } else {
            status = compiler_frontend_wrapper::run(wrapper, first.view());
            size = wrapper.size();
        }
    }
    if (status != compiler_x86::EmitStatus::complete) {
        const compiler_resolver::Report report = compiler_resolver::object_report(status, !compose, 0);
        if (report.source_index() >= 0) {
            failure(diagnostics, internal(), "invalid hosted resolution result");
        } else {
            diagnostics.report(report, "");
            while (diagnostics.pending()) {
                const i64 at = diagnostics.offset();
                const compiler_resolver::Report part = compiler_resolver::object_report(status, !compose, at);
                diagnostics.more(part);
            }
        }
        ok = false;
    }
    if (ok && (size < 0 || size > artifact_limit())) {
        failure(diagnostics, internal(), "invalid private object composition transport");
        ok = false;
    }
    u64 output = 0u64;
    if (ok) {
        const Range named = words.at(destination);
        const builtin::HostOutputResult created = files.create_output(arguments.subspan(named.begin, named.count));
        output = created.id;
        if (created.status != builtin::HostStatus::success) {
            output_failure(diagnostics, created.status, true);
            ok = false;
        } else {
            if (identities.contains(created.device, created.inode)) {
                failure(diagnostics, unclassified(), "artifact destination aliases a root or imported source file");
                ok = false;
            }
        }
    }
    if (ok) {
        builtin::HostStatus written = builtin::HostStatus::success;
        if (compose) {
            written = files.write(output, composed.bytes());
        } else {
            if (link) {
                written = files.write(output, linked.bytes());
            } else {
                written = files.write(output, wrapper.bytes());
            }
        }
        if (written != builtin::HostStatus::success) {
            output_failure(diagnostics, written, false);
            ok = false;
        }
    }
    if (ok) {
        const Range named = words.at(destination);
        const builtin::HostFileResult now = destination_now(files, arguments.subspan(named.begin, named.count));
        ok = destination_unchanged(diagnostics, identities, now.status, now.device, now.inode);
    }
    if (ok) {
        const builtin::HostStatus committed = files.commit(output);
        if (committed != builtin::HostStatus::success) {
            commit_failure(diagnostics, committed);
            ok = false;
        }
    }
    if (!ok) {
        render_failure(diagnostics, json, false);
        print(files, diagnostics.output(), json);
        return exit_for(diagnostics, false);
    }
    return builtin::HostExit::success;
}

// The runtime roots the build configured: runtime/linux and runtime/aurora
// of its source tree, for --target linux (the default) and --target aurora.
auto main(builtin::HostFiles& files, builtin::ByteRegion region,
    builtin::span<const u8> arguments) -> builtin::HostExit {
    Ranges words = Ranges(region);
    split_words(words, arguments);
    Diagnostics diagnostics = Diagnostics(region);
    if (!words.good() || words.size() == 0 || !diagnostics.good()) {
        return builtin::HostExit::failure;
    }
    const Range program = words.at(0);
    const bool formatter = named(arguments.subspan(program.begin, program.count), "aurora-fmt");
    if (!formatter && words.size() > 1 && (is(words, arguments, 1, "--compose-private-object") || is(words, arguments,
        1, "--emit-frontend-wrapper") || is(words, arguments, 1, "--link-object"))) {
        return objects(files, region, arguments);
    }
    const Options options = tool_options(words, arguments, formatter);
    if (options.error != 0) {
        const Range cited = words.at(options.cited);
        usage_message(diagnostics, options.error, arguments.subspan(cited.begin, cited.count));
        render_failure(diagnostics, options.json, formatter);
        print(files, diagnostics.output(), options.json && !formatter);
        return exit_for(diagnostics, formatter);
    }
    if (formatter && !options.lint) {
        return format(files, region, arguments, options);
    }
    if (options.target == 2) {
        return compile(files, region, arguments, "@AURORA_KERNEL_RUNTIME_ROOT@", options, formatter);
    }
    return compile(files, region, arguments, "@AURORA_RUNTIME_ROOT@", options, formatter);
}
