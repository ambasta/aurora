+/* Ordinary untranslated memory fault, without PASID or guest translation.
+ * Only the caller's architecturally defined PR/PE/RW/RZ bits are supplied.
+ */
+static void amdvi_memory_page_fault(AMDVIState *s, uint16_t devid,
+                                   uint16_t domid, hwaddr addr, uint16_t info)
+{
+    uint64_t evt[2];
+
+    /* No caller can set I, TR, GN or unrelated event fields. */
+    assert(!(info & ~AMDVI_EVENT_IOPF_MEMORY_FLAGS));
+    amdvi_encode_event(evt, devid, addr, AMDVI_EVENT_IOPF | info);
+    amdvi_setevent_bits(evt, domid, 32, 16);
+    amdvi_log_event(s, evt);
+    pci_word_test_and_set_mask(s->pci.dev.config + PCI_STATUS,
+                              PCI_STATUS_SIG_TARGET_ABORT);
+}
