+{
+    AMDVIState *s = as->iommu_state;
+    uint16_t devid = PCI_BUILD_BDF(as->bus_num, as->devfn);
+    uint16_t domid = dte[1] & AMDVI_DEV_DOMID_ID_MASK;
+    unsigned rights = amdvi_get_perms(dte[0]);
+    uint16_t rw = (perms & AMDVI_PERM_WRITE) ? AMDVI_EVENT_IOPF_RW : 0;
+    uint64_t pte, pte_addr;
+
+    if (addr >= (1ULL << 21)) {
+        amdvi_memory_page_fault(s, devid, domid, addr,
+            AMDVI_EVENT_IOPF_PR | rw |
+            ((perms & rights) != perms ? AMDVI_EVENT_IOPF_PE : 0));
+        return AMDVI_BOUNDED_FAULT;
+    }
+    /* Early parent denial is permitted; no multifault priority is imposed. */
+    if ((perms & rights) != perms) {
+        amdvi_memory_page_fault(s, devid, domid, addr,
+                               AMDVI_EVENT_IOPF_PR | AMDVI_EVENT_IOPF_PE | rw);
+        return AMDVI_BOUNDED_FAULT;
+    }
+    pte_addr = (dte[0] & AMDVI_DEV_PT_ROOT_MASK) + ((addr >> 12) * 8);
+    if (dma_memory_read(&address_space_memory, pte_addr, &pte, sizeof(pte),
+                        MEMTXATTRS_UNSPECIFIED)) {
+        amdvi_log_pagetab_error(s, devid, pte_addr, 0);
+        return AMDVI_BOUNDED_FAULT;
+    }
+    pte = le64_to_cpu(pte);
+    if (!(pte & 1)) {
+        /* Other PR-clear payload is ignored; PR=0 has no PE/RW/RZ claim. */
+        amdvi_memory_page_fault(s, devid, domid, addr, 0);
+        return AMDVI_BOUNDED_FAULT;
+    }
+    if (get_pte_translation_mode(pte) != 0 ||
+        (pte & (3ULL << 59)) ||
+        !amdvi_bounded_memory((pte & AMDVI_DEV_PT_ROOT_MASK) |
+                              (addr & ~AMDVI_PAGE_MASK_4K))) {
+        *legacy_leaf = pte;
+        return AMDVI_BOUNDED_LEGACY_LEAF;
+    }
+    rights &= amdvi_get_perms(pte);
+    if (pte & GENMASK64(58, 52)) {
+        amdvi_memory_page_fault(s, devid, domid, addr,
+            AMDVI_EVENT_IOPF_PR | AMDVI_EVENT_IOPF_RZ | rw |
+            ((perms & rights) != perms ? AMDVI_EVENT_IOPF_PE : 0));
+        return AMDVI_BOUNDED_FAULT;
+    }
+    if ((perms & rights) != perms) {
+        amdvi_memory_page_fault(s, devid, domid, addr,
+                               AMDVI_EVENT_IOPF_PR | AMDVI_EVENT_IOPF_PE | rw);
+        return AMDVI_BOUNDED_FAULT;
+    }
+    ret->iova = addr & AMDVI_PAGE_MASK_4K;
+    ret->translated_addr = pte & AMDVI_DEV_PT_ROOT_MASK;
+    ret->addr_mask = ~AMDVI_PAGE_MASK_4K;
+    ret->perm = rights;
+    return AMDVI_BOUNDED_SUCCESS;
+}
