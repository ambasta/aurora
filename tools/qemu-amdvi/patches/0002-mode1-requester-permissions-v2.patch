+/* This is a profile predicate, not an architectural reserved-bit mask. */
+static bool amdvi_bounded_dte(AMDVIState *s, const uint64_t *dte)
+{
+    return !(dte[0] & ~0x600ffffffffffe03ULL) &&
+           !(dte[1] & ~0xffffULL) && !dte[2] && !dte[3] &&
+           !(amdvi_readq(s, AMDVI_MMIO_EXCL_BASE) &
+             AMDVI_MMIO_EXCL_ENABLED_MASK);
+}
