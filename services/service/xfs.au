export namespace service {
    auto xfs_private_name(builtin::span<const u8> name) -> bool {
        const builtin::array<u8, 13> reserved = {
            46u8,
            97u8,
            117u8,
            114u8,
            111u8,
            114u8,
            97u8,
            45u8,
            115u8,
            116u8,
            97u8,
            103u8,
            101u8
        };
        if (name.size() != 13) {
            return false;
        }
        i64 at = 0;
        while (at < 13) {
            if (name.at(at) != reserved[at]) {
                return false;
            }
            at = at + 1;
        }
        return true;
    }

    class XfsPath {
    public:
        u64 kind;
        i64 start;
        i64 length;
    };

    // 0 outside /disk, 1 mounted root, 2 mounted descendant, 3 refused mounted path.
    // Lexical normalization is for routing only. Any '..' touching this mount
    // is refused, never resolved into the mutable boot/overlay namespace.
    auto xfs_path_volume(builtin::span<const u8> path, u64 volume) -> XfsPath {
        i64 at = 0;
        i64 depth = 0;
        i64 first = -1;
        i64 first_length = 0;
        i64 leaf = 0;
        bool parent = false;
        bool touched = false;
        bool invalid = path.size() > 4095;
        while (at < path.size()) {
            while (at < path.size() && path.at(at) == 47u8) {
                at = at + 1;
            }
            const i64 begin = at;
            while (at < path.size() && path.at(at) != 47u8) {
                if (path.at(at) == 0u8) {
                    invalid = true;
                }
                at = at + 1;
            }
            const i64 length = at - begin;
            if (length > 255) {
                invalid = true;
            }
            bool skip = length == 0;
            if (length == 1 && path.at(begin) == 46u8) {
                skip = true;
            }
            if (length == 2 && path.at(begin) == 46u8 && path.at(begin + 1) == 46u8) {
                parent = true;
                if (depth > 0) {
                    depth = depth - 1;
                }
                if (depth == 0) {
                    first = -1;
                    first_length = 0;
                }
                skip = true;
            }
            if (!skip) {
                if (depth == 0) {
                    first = begin;
                    first_length = length;
                    if (((volume == 0u64 && length == 4) || (volume == 1u64 && length == 5 && path.at(begin + 4)
                        == 50u8)) && path.at(begin) == 100u8 && path.at(begin + 1) == 105u8 && path.at(begin + 2)
                        == 115u8 && path.at(begin + 3) == 107u8) {
                        touched = true;
                    }
                }
                if (depth == 1) {
                    leaf = begin;
                }
                depth = depth + 1;
            }
        }
        bool disk = false;
        if (first >= 0 && ((volume == 0u64 && first_length == 4) || (volume == 1u64 && first_length == 5
            && path.at(first + 4) == 50u8))) {
            disk = path.at(first) == 100u8 && path.at(first + 1) == 105u8 && path.at(first + 2) == 115u8
                && path.at(first + 3) == 107u8;
        }
        u64 kind = 0u64;
        if (disk) {
            kind = 3u64;
            if (!parent && !invalid) {
                if (depth == 1) {
                    kind = 1u64;
                }
                if (depth >= 2) {
                    kind = 2u64;
                }
            }
        } else {
            if (touched) {
                kind = 3u64;
            }
        }
        const XfsPath result = XfsPath{
            .kind = kind,
            .start = leaf,
            .length = path.size() - leaf
        };
        return result;
    }

    auto xfs_path(builtin::span<const u8> path) -> XfsPath {
        return xfs_path_volume(path, 0u64);
    }

    auto xfs_handle(u64 id) -> bool {
        if (id == 0u64) {
            return false;
        }
        const u64 slot = (id - 1u64) % 64u64;
        return slot >= 40u64 && slot < 56u64;
    }

    // Zero routes to Store; otherwise the returned operation belongs to XFS.
    // A relative disk path beneath the live boot root is the only cross-owner
    // traversal. Arbitrary boot subdirectories and stale handles cannot use it.
    auto xfs_operation_for(Store& store, u64 source, builtin::span<const u8> path, u64 operation, u64 id) -> u64 {
        if (!store.contains(source)) {
            return 0u64;
        }
        if (operation == 16u64 || operation == 18u64 || operation == 21u64) {
            const XfsPath parsed = xfs_path(path);
            if (parsed.kind != 0u64) {
                return operation;
            }
        }
        if (operation == 17u64) {
            if (xfs_handle(id)) {
                return operation;
            }
            const XfsPath parsed = xfs_path(path);
            if (store.is_root_directory_for(source, id) && parsed.kind != 0u64 && kernel::valid_path(path)
                && !kernel::escapes(path)) {
                return 18u64;
            }
        }
        if ((operation == 19u64 || operation == 20u64 || operation == 22u64 || operation == 23u64 || operation == 24u64
            || operation == 25u64) && xfs_handle(id)) {
            return operation;
        }
        return 0u64;
    }

    auto xfs_operation(Store& store, builtin::span<const u8> path, u64 operation, u64 id) -> u64 {
        const u64 source = store.singleton_source();
        if (source == 0u64) {
            return 0u64;
        }
        return xfs_operation_for(store, source, path, operation, id);
    }

    // The mount and this table are sibling linear owners: nested owning fields
    // are not a language feature. No device capability is stored in either.
    class XfsFiles {
        builtin::OwnedBytes table;
        builtin::array<u64, 16> cursors;
        builtin::OwnedBytes owners;
        builtin::OwnedBytes payload;
        builtin::OwnedBytes path_bytes;
        i64 path_length;
        u64 directory;
        u64 parent;
        bool directory_open;
        u64 generation;
        u64 handle_base;
        u64 handle_count;
        u64 device;
        u64 client;
        u64 second_client;
        // A surviving pair member never acquires singleton disk-write rights.
        bool paired;
        u64 request_source;
        u64 root_inode;
        u64 slot;
        u64 pending;
        u64 offset;
        u64 desired;
        u64 copied;
        bool usable;
        bool mounted;
        kernel::FileStatus result_status;
        u64 result_count;
        u64 result_id;
        u64 result_size;
        u64 result_inode;
        auto set_result(kernel::FileStatus status) -> bool {
            result_status = status;
            result_count = 0u64;
            result_id = 0u64;
            result_size = 0u64;
            result_inode = 0u64;
            return true;
        }

        auto word(u64 row, u64 field) const -> u64 {
            const builtin::span<const u8> bytes = borrow_bytes(table);
            const std::ByteReadResult read = std::read_le64(bytes, i64(row * 320u64 + field * 8u64));
            return read.value_or(0u64);
        }
        auto set_word(u64 row, u64 field, u64 value) -> bool {
            i64 at = 0;
            while (at < 8) {
                if (!table.set(i64(row * 320u64 + field * 8u64) + at, u8((value >> (at * 8)) & 255u64))) {
                    usable = false;
                }
                at = at + 1;
            }
            return usable;
        }
        auto owner(u64 row) const -> u64 {
            const builtin::span<const u8> bytes = borrow_bytes(owners);
            const std::ByteReadResult read = std::read_le64(bytes, i64(row * 8u64));
            return read.value_or(0u64);
        }
        auto set_owner(u64 row, u64 source) -> bool {
            i64 at = 0;
            while (at < 8) {
                if (!owners.set(i64(row * 8u64) + at, u8((source >> (at * 8)) & 255u64))) {
                    usable = false;
                }
                at = at + 1;
            }
            return usable;
        }
        auto find(u64 source, u64 id, u64 kind) const -> i64 {
            if (id == 0u64 || (id - 1u64) % 64u64 < handle_base || (id - 1u64) % 64u64 >= handle_base + handle_count
                || !mounted || !contains(source) || !ok()) {
                return -1;
            }
            const u64 row = (id - 1u64) % 64u64 - handle_base;
            const u64 state = word(row, 0u64);
            if (owner(row) != source || state == 0u64 || (kind != 0u64 && state != kind)) {
                return -1;
            }
            if (word(row, 1u64) != (id - 1u64) / 64u64) {
                return -1;
            }
            return i64(row);
        }
        auto claim(u64 kind, u64 size, u64 inode) -> bool {
            if (!contains(request_source)) {
                return fail(kernel::FileStatus::failed);
            }
            const u64 next = word(slot, 1u64) + 1u64;
            if (next >= 288230376151711744u64) {
                set_result(kernel::FileStatus::exhausted);
                pending = 0u64;
                return false;
            }
            cursors[i64(slot)] = 0u64;
            set_owner(slot, request_source);
            set_word(slot, 0u64, kind);
            set_word(slot, 1u64, next);
            set_word(slot, 2u64, inode);
            set_word(slot, 3u64, size);
            set_result(kernel::FileStatus::success);
            result_id = next * 64u64 + slot + handle_base + 1u64;
            result_size = size;
            result_inode = inode;
            pending = 0u64;
            return ok();
        }
    public:
        XfsFiles(builtin::ByteRegion region, u64 volume_generation, u64 sectors) : table(region.try_allocate(5120)),
            cursors{}, owners(region.try_allocate(128)), payload(region.try_allocate(504)),
            path_bytes(region.try_allocate(4095)), path_length(0), directory(0u64), parent(0u64), directory_open(false),
            generation(volume_generation), handle_base(40u64), handle_count(16u64), device(3u64), client(0u64),
            second_client(0u64), paired(false), request_source(0u64), root_inode(0u64), slot(0u64), pending(0u64),
            offset(0u64), desired(0u64), copied(0u64), usable(volume_generation != 0u64 && sectors != 0u64),
            mounted(false), result_status(kernel::FileStatus::failed), result_count(0u64), result_id(0u64),
            result_size(0u64), result_inode(0u64) {
        }
        auto configure_volume(u64 volume) -> bool {
            if (mounted || !clients_idle() || pending != 0u64 || volume > 1u64 || handle_count != 16u64) {
                return false;
            }
            handle_base = 40u64 + volume * 8u64;
            handle_count = 8u64;
            device = 3u64 + volume;
            return true;
        }
        // Observation only: rejection and known EOF remain usable with no I/O.
        auto required_commands_for(u64 source, u64 operation, u64 id, u64 position,
            builtin::span<const u8> path) const -> u64 {
            if (!ready() || !contains(source) || pending != 0u64) {
                return 0u64;
            }
            if (operation == 19u64) {
                const i64 found = find(source, id, 2u64);
                if (found < 0 || position > 9223372036854775807u64 || position >= word(u64(found), 3u64)) {
                    return 0u64;
                }
                return 6u64;
            }
            if (operation == 25u64) {
                const i64 found = find(source, id, 1u64);
                if (position != 0u64 || path.size() != 0 || found < 0 || cursors[found] == 17u64) {
                    return 0u64;
                }
                return 1u64;
            }
            if (operation != 16u64 && operation != 17u64 && operation != 18u64) {
                return 0u64;
            }
            if (path.size() == 0 || path.size() > 4095 || !kernel::valid_path(path)) {
                return 0u64;
            }
            if (operation == 17u64) {
                if (find(source, id, 1u64) < 0 || kernel::escapes(path)) {
                    return 0u64;
                }
            } else {
                const XfsPath parsed = xfs_path_volume(path, device - 3u64);
                if (parsed.kind == 0u64 || parsed.kind == 3u64 || parsed.kind == 1u64) {
                    return 0u64;
                }
            }
            i64 at = 0;
            bool trailing = true;
            while (at < path.size()) {
                while (at < path.size() && path.at(at) == 47u8) {
                    trailing = true;
                    at = at + 1;
                }
                const i64 begin = at;
                while (at < path.size() && path.at(at) != 47u8) {
                    at = at + 1;
                }
                if (at - begin > 255 || xfs_private_name(path.subspan(begin, at - begin))) {
                    return 0u64;
                }
                if (at > begin) {
                    trailing = at - begin == 1 && path.at(begin) == 46u8;
                }
            }
            if (operation != 16u64 && trailing) {
                return 0u64;
            }
            u64 row = 0u64;
            while (row < handle_count) {
                if (word(row, 0u64) == 0u64 && word(row, 1u64) + 1u64 < 288230376151711744u64) {
                    return 2049u64;
                }
                row = row + 1u64;
            }
            return 0u64;
        }
        auto admit_commands_for(u64 source, u64 operation, u64 id, u64 position, builtin::span<const u8> path,
            u64 remaining) -> bool {
            if (!contains(source) || pending != 0u64) {
                return false;
            }
            if (required_commands_for(source, operation, id, position, path) > remaining) {
                set_result(kernel::FileStatus::failed);
                return false;
            }
            return true;
        }
        auto required_commands(u64 operation, u64 id, u64 position, builtin::span<const u8> path) const -> u64 {
            return required_commands_for(singleton_source(), operation, id, position, path);
        }
        auto admit_commands(u64 operation, u64 id, u64 position, builtin::span<const u8> path, u64 remaining) -> bool {
            return admit_commands_for(singleton_source(), operation, id, position, path, remaining);
        }
        auto read_byte(u64 at) const -> u8 {
            return read_byte_for(singleton_source(), at);
        }
        auto output_valid(u64 id) const -> bool {
            return output_valid_for(singleton_source(), id);
        }
        auto create_output(builtin::span<const u8> path, u64 inode) -> bool {
            return create_output_for(singleton_source(), path, inode);
        }
        auto release_output(u64 id, kernel::FileStatus status) -> bool {
            return release_output_for(singleton_source(), id, status);
        }
        auto prepare(u64 operation, u64 id, u64 position, builtin::span<const u8> path) -> bool {
            return prepare_for(singleton_source(), operation, id, position, path);
        }
        auto resources_ok() const -> bool {
            return table.ok() && owners.ok() && payload.ok() && path_bytes.ok();
        }
        auto ok() const -> bool {
            return usable && resources_ok();
        }
        auto ready() const -> bool {
            return ok() && mounted;
        }
        auto continuity_idle() const -> bool {
            if (!ready() || !clients_idle() || pending != 0u64) {
                return false;
