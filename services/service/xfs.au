                slot = u64(found);
                if (operation == 20u64) {
                    set_word(slot, 0u64, 0u64);
                    set_owner(slot, 0u64);
                    cursors[i64(slot)] = 0u64;
                    set_result(kernel::FileStatus::success);
                    return true;
                }
                if (position > 9223372036854775807u64) {
                    return fail(kernel::FileStatus::failed);
                }
                const u64 size = word(slot, 3u64);
                set_result(kernel::FileStatus::success);
                if (position >= size) {
                    return true;
                }
                offset = position;
                desired = size - position;
                if (desired > 504u64) {
                    desired = 504u64;
                }
                pending = 2u64;
                return true;
            }
            if (operation != 16u64 && operation != 17u64 && operation != 18u64) {
                return fail(kernel::FileStatus::failed);
            }
            i64 first = 0;
            directory = root_inode;
            parent = root_inode;
            directory_open = operation == 16u64;
            if (operation == 17u64) {
                const i64 found = find(source, id, 1u64);
                if (found < 0) {
                    return fail(kernel::FileStatus::invalid_handle);
                }
                directory = word(u64(found), 2u64);
                parent = word(u64(found), 5u64);
                if (path.size() > 0 && path.at(0) == 47u8) {
                    return fail(kernel::FileStatus::escape);
                }
            } else {
                const XfsPath parsed = xfs_path_volume(path, device - 3u64);
                if (parsed.kind == 0u64) {
                    return fail(kernel::FileStatus::not_found);
                }
                if (parsed.kind == 3u64) {
                    return fail(kernel::FileStatus::escape);
                }
                first = parsed.start;
                if (parsed.kind == 1u64) {
                    first = path.size();
                }
            }
            if (path.size() == 0 || path.size() > 4095) {
                return fail(kernel::FileStatus::invalid_path);
            }
            path_length = 0;
            i64 at = first;
            bool trailing = at == path.size();
            while (at < path.size()) {
                while (at < path.size() && path.at(at) == 47u8) {
                    at = at + 1;
                    trailing = true;
                }
                const i64 begin = at;
                while (at < path.size() && path.at(at) != 47u8) {
                    if (path.at(at) == 0u8) {
                        return fail(kernel::FileStatus::invalid_path);
                    }
                    at = at + 1;
                }
                const i64 length = at - begin;
                if (length > 255) {
                    return fail(kernel::FileStatus::invalid_path);
                }
                const bool dot = length == 1 && path.at(begin) == 46u8;
                if (length == 2 && path.at(begin) == 46u8 && path.at(begin + 1) == 46u8) {
                    return fail(kernel::FileStatus::escape);
                }
                if (length > 0 && !dot) {
                    if (xfs_private_name(path.subspan(begin, length))) {
                        return fail(kernel::FileStatus::denied);
                    }
                    if (path_length > 0) {
                        path_bytes.set(path_length, 47u8);
                        path_length = path_length + 1;
                    }
                    i64 byte = 0;
                    while (byte < length) {
                        path_bytes.set(path_length, path.at(begin + byte));
                        path_length = path_length + 1;
                        byte = byte + 1;
                    }
                    trailing = false;
                } else {
                    trailing = true;
                }
            }
            if (!directory_open && trailing) {
                if (path_length == 0) {
                    return fail(kernel::FileStatus::not_regular);
                }
                return fail(kernel::FileStatus::escape);
            }
            slot = 0u64;
            while (slot < handle_count && (word(slot, 0u64) != 0u64 || word(slot, 1u64) + 1u64
                >= 288230376151711744u64)) {
                slot = slot + 1u64;
            }
            if (slot == handle_count) {
                return fail(kernel::FileStatus::exhausted);
            }
            if (directory_open && path_length == 0 && directory == root_inode && parent == root_inode) {
                set_word(slot, 4u64, root_inode);
                set_word(slot, 5u64, root_inode);
                return claim(1u64, 0u64, root_inode);
            }
            pending = 1u64;
            return true;
        }
        auto opened(u64 size, u64 inode, u64 containing, u64 expected_parent) -> bool {
            if (!opening() || inode == 0u64 || containing == 0u64 || expected_parent == 0u64) {
                return poison();
            }
            // Only completed rooted walks populate these private handle tuples.
            set_word(slot, 4u64, containing);
            set_word(slot, 5u64, expected_parent);
            u64 kind = 2u64;
            if (directory_open) {
                kind = 1u64;
            }
            return claim(kind, size, inode);
        }
        auto entry_index() const -> u64 {
            if (!enumerating()) {
                return 17u64;
            }
            return cursors[i64(slot)];
        }
        auto entry_byte(u64 at, u8 byte) -> bool {
            if (!enumerating() || at >= 255u64) {
                return poison();
            }
            return payload.set(i64(at), byte);
        }
        auto next_directory_index() -> bool {
            if (!enumerating() || cursors[i64(slot)] >= 16u64) {
                return poison();
            }
            cursors[i64(slot)] = cursors[i64(slot)] + 1u64;
            return true;
        }
        auto entry_hidden(u64 length) const -> bool {
            if (!enumerating() || length == 0u64 || length > 255u64) {
                return true;
            }
            const builtin::span<const u8> all = borrow_bytes(payload);
            return kernel::private_entry(all.subspan(0, i64(length)));
        }
        auto complete_entry(u64 length, u64 kind) -> bool {
            if (!enumerating() || length > 255u64 || (length == 0u64 && kind != 0u64) || (length != 0u64 && kind != 1u64
                && kind != 2u64)) {
                return poison();
            }
            if (length == 0u64) {
                cursors[i64(slot)] = 17u64;
            }
            pending = 0u64;
            set_result(kernel::FileStatus::success);
            result_count = length;
            result_size = kind;
            copied = length;
            return true;
        }
        auto append_sector(storage::Sector512 sector, u64 valid_bytes) -> bool {
            if (!reading() || copied >= desired || valid_bytes > 512u64) {
                return poison();
            }
            const u64 start = (offset + copied) % 512u64;
            if (start >= valid_bytes) {
                return poison();
            }
            u64 count = valid_bytes - start;
            if (count > desired - copied) {
                count = desired - copied;
            }
            u64 at = 0u64;
            while (at < count) {
                const std::ByteReadResult byte = sector.read_byte(i64(start + at));
                payload.set(i64(copied + at), u8(byte.value_or(0u64)));
                at = at + 1u64;
            }
            copied = copied + count;
            if (copied == desired) {
                pending = 0u64;
                set_result(kernel::FileStatus::success);
                result_count = copied;
            }
            return true;
        }
    };
}

export namespace service {
    // Atomic source-resource and initial command admission for the real pump.
    auto admit_dual_mounts(XfsFiles& first, XfsFiles& second, fs::XfsReadonlyMount& first_mount,
        fs::XfsReadonlyMount& second_mount, u64 volumes, u64 remaining) -> bool {
        if (!first.resources_ok() || !second.resources_ok() || first_mount.status()
            == fs::XfsMountStatus::invalid_request || second_mount.status() == fs::XfsMountStatus::invalid_request
            || volumes == 0u64 || volumes > 2u64 || remaining < volumes * 18458u64) {
            first.poison();
            second.poison();
            return false;
        }
        return true;
    }
    // Shortform directories contain at most sixteen entries. The normal mount
    // walk revalidates the retained inode/parent tuple before any name is copied.
    auto enumerate_xfs(XfsFiles& files, fs::XfsReadonlyMount& mount) -> bool {
        if (!files.enumerating() || mount.status() != fs::XfsMountStatus::directory_ready || mount.directory_inode()
            != files.directory_inode() || mount.directory_parent() != files.directory_parent()) {
            return files.poison();
        }
        while (files.entry_index() <= 16u64) {
            const fs::XfsDirectoryEntry item = mount.directory_entry(i64(files.entry_index()));
            if (item.at_end()) {
                return files.complete_entry(0u64, 0u64);
            }
            if (!item.valid()) {
                return files.poison();
            }
            const u64 length = item.name_length_bytes();
            const u64 begin = item.name_offset_bytes();
            if (length == 0u64 || length > 255u64 || begin > 512u64 || length > 512u64 - begin || (item.file_type()
                != 1u64 && item.file_type() != 2u64)) {
                return files.poison();
            }
            u64 at = 0u64;
            while (at < length) {
                if (!files.entry_byte(at, mount.directory_byte(i64(begin + at)))) {
                    return false;
                }
                at = at + 1u64;
            }
            if (!files.next_directory_index()) {
                return false;
            }
            if (!files.entry_hidden(length)) {
                return files.complete_entry(length, item.file_type());
            }
        }
        return files.poison();
    }
    auto advance_xfs(XfsFiles& files, fs::XfsReadonlyMount& mount) -> bool {
        if (!files.ok()) {
            return false;
        }
        if (!files.ready()) {
            if (mount.status() == fs::XfsMountStatus::ready) {
                return files.admit(mount.root_inode());
            }
            if (!mount.needs_read()) {
                return files.poison();
            }
            return true;
        }
        if (mount.needs_read()) {
            return true;
        }
        if (files.enumerating()) {
            return enumerate_xfs(files, mount);
        }
        if (files.opening()) {
            if (mount.status() == fs::XfsMountStatus::directory_ready) {
                return files.opened(0u64, mount.directory_inode(), mount.directory_inode(), mount.directory_parent());
            }
            if (mount.status() == fs::XfsMountStatus::not_regular) {
                return files.fail(kernel::FileStatus::not_regular);
            }
            if (mount.status() == fs::XfsMountStatus::file_metadata_ready) {
                return files.opened(mount.file_size(), mount.file_inode(), mount.directory_inode(),
                    mount.directory_parent());
            }
            if (mount.status() == fs::XfsMountStatus::not_found) {
                return files.fail(kernel::FileStatus::not_found);
            }
            if (mount.status() == fs::XfsMountStatus::invalid_request) {
                return files.fail(kernel::FileStatus::invalid_path);
            }
            return files.poison();
        }
        if (files.reading()) {
            if (mount.status() != fs::XfsMountStatus::file_sector_ready) {
                return files.poison();
            }
            files.append_sector(mount.sector_or_zero(), mount.valid_bytes());
            if (files.reading()) {
                return start_xfs(files, mount);
            }
        }
        return files.ok();
    }
    auto start_xfs(XfsFiles& files, fs::XfsReadonlyMount& mount) -> bool {
        if (files.opening() || files.reading() || files.enumerating()) {
            bool started = false;
            if (files.enumerating()) {
                started = mount.open_directory_in(files.directory_inode(), files.directory_parent(), "");
            } else {
                if (files.opening()) {
                    i64 at = 0;
                    while (at < files.name_length()) {
                        if (!mount.set_path_byte(at, files.name_byte(at))) {
                            return files.poison();
                        }
                        at = at + 1;
                    }
                    started = mount.open_prepared_in(files.directory_inode(), files.directory_parent(),
                        files.name_length(), files.opening_directory());
                } else {
                    started = mount.read_inode_in(files.directory_inode(), files.directory_parent(), files.inode(),
                        files.sector_index());
                }
            }
            if (!started) {
                if (mount.status() == fs::XfsMountStatus::not_regular) {
                    return files.fail(kernel::FileStatus::not_regular);
                }
                if (mount.status() == fs::XfsMountStatus::not_found) {
                    return files.fail(kernel::FileStatus::not_found);
                }
                if (mount.status() == fs::XfsMountStatus::invalid_request) {
                    return files.fail(kernel::FileStatus::invalid_path);
                }
                return files.poison();
            }
            if (files.enumerating() && !mount.needs_read()) {
                return enumerate_xfs(files, mount);
            }
        }
        return files.ok();
    }
}
