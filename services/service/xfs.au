            u64 row = 0u64;
            while (row < handle_count) {
                if (word(row, 0u64) != 0u64) {
                    return false;
                }
                row = row + 1u64;
            }
            return true;
        }
        auto opening() const -> bool {
            return pending == 1u64;
        }
        auto reading() const -> bool {
            return pending == 2u64;
        }
        auto enumerating() const -> bool {
            return pending == 3u64;
        }
        auto active() const -> u64 {
            if (client != 0u64) {
                return client;
            }
            return second_client;
        }
        auto contains(u64 source) const -> bool {
            return source != 0u64 && (client == source || second_client == source);
        }
        auto clients_idle() const -> bool {
            return client == 0u64 && second_client == 0u64;
        }
        auto singleton(u64 source) const -> bool {
            return !paired && contains(source);
