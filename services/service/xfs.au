        auto can_admit(u64 first, u64 second) const -> bool {
            return first != 0u64 && first != second && clients_idle() && pending == 0u64;
        }
        auto can_finish(u64 source) const -> bool {
            return contains(source) && pending == 0u64;
        }
        auto response() const -> Reply {
            Reply result = reply(result_status);
            result.count = result_count;
            result.id = result_id;
            result.size = result_size;
            result.inode = result_inode;
