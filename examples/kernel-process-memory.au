module kernel_process_memory;
import kernel.frames;
import kernel.process_memory;

// Hosted golden-policy queries. Production mapping and allocation decisions
// run inside the retained MemoryManager, without these copied-state entries.
// Operation 1 initialize free, 2 initialize kernel, 3 allocate, 4 release.
auto aurora_kernel_frame_transition(u64 operation, u64 record, u64 owner, u64 generation, u64 link) -> u64 {
    kernel::FrameOperation selected = kernel::FrameOperation::none;
    if (operation == 1u64) {
        selected = kernel::FrameOperation::initialize_free;
    }
    if (operation == 2u64) {
        selected = kernel::FrameOperation::initialize_kernel;
    }
    if (operation == 3u64) {
        selected = kernel::FrameOperation::allocate;
    }
    if (operation == 4u64) {
        selected = kernel::FrameOperation::release;
    }
    return kernel::frame_transition(selected, record, owner, generation, link);
}

// The memory service (kernel/uefi/process.md#memory): map, remap and unmap
// decisions over the copied state and record, the record of a base or of a
// committed fault in the supervisor's sorted records, and a loaded process's
// quota.
auto process_memory_map(kernel::MemoryState state, u64 bytes) -> kernel::MemoryDecision {
    const kernel::MemoryDecision decision = kernel::memory_map(state, bytes);
    return decision;
}

auto process_memory_remap(kernel::MemoryState state, kernel::MemoryRecord record, u64 bytes,
    u64 target) -> kernel::MemoryDecision {
    const kernel::MemoryDecision decision = kernel::memory_remap(state, record, bytes, target);
    return decision;
}

auto process_memory_unmap(kernel::MemoryState state, kernel::MemoryRecord record, u64 bytes) -> kernel::MemoryDecision {
    const kernel::MemoryDecision decision = kernel::memory_unmap(state, record, bytes);
    return decision;
}

auto process_memory_find(builtin::span<const u8> records, u64 count, u64 base) -> u64 {
    return kernel::memory_find(records, count, base);
}

auto process_memory_fault(builtin::span<const u8> records, u64 count, u64 address, u64 error) -> u64 {
    return kernel::memory_fault(records, count, address, error);
}

auto process_memory_budget(builtin::span<const u8> image, u64 arguments, u64 slots, u64 requested,
    u64 free) -> kernel::MemoryBudget {
    const kernel::MemoryBudget budget = kernel::memory_budget(image, arguments, slots, requested, free);
    return budget;
}
