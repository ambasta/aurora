module kernel_console;
import console.io;
import console.line;
import kernel.terminal_event;

auto console_text(builtin::ConsoleSession& session, builtin::span<const u8> text) -> bool {
    const console::WriteResult result = console::write_bytes(session, text);
    return result.complete();
}

// One source invocation owns every editor byte across IRQ-woken input waits.
// The sealed session carries transport authority only; IRQ code cannot reenter it.
auto console_service(builtin::ConsoleSession& session) -> builtin::ConsoleCompletion {
    console::Line64 line = console::Line64(false);
    if (!console_text(session, "AURORA_CONSOLE_READY: BIOS, ASCII, 64-byte lines\r\naurora> ")) {
        return builtin::ConsoleCompletion::output_failure;
    }
    while (true) {
        const builtin::ConsoleSample sample = session.next();
        if (sample.damaged) {
            line.reject();
        }
        if (sample.byte_present) {
            const console::ConsoleEvent event = line.consume(sample.byte);
            bool okay = true;
            if (event == console::ConsoleEvent::echo) {
                okay = session.put(sample.byte) == builtin::ConsolePutResult::success;
            } else {
                if (event == console::ConsoleEvent::erased) {
                    okay = console_text(session, "\b \b");
                } else {
                    if (event != console::ConsoleEvent::ignored) {
                        okay = console_text(session, "\r\n");
                        if (okay) {
                            if (event == console::ConsoleEvent::help) {
                                okay = console_text(session,
                                    "help    Show commands\r\nstatus  Show boot state\r\nexit    Close this QEMU session\r\n");
                            } else {
                                if (event == console::ConsoleEvent::status) {
                                    okay = console_text(session,
                                        "status: boot self-tests passed; BIOS serial console; line capacity=64\r\n");
                                } else {
                                    if (event == console::ConsoleEvent::unknown) {
                                        okay = console_text(session, "Unknown command. Type help.\r\n");
                                    } else {
                                        if (event == console::ConsoleEvent::rejected) {
                                            okay = console_text(session,
                                                "Line rejected: too long, non-ASCII/control byte, or UART error.\r\n");
                                        } else {
                                            if (event == console::ConsoleEvent::exit) {
                                                if (!console_text(session, "AURORA_CONSOLE_EXIT\r\n")) {
                                                    return builtin::ConsoleCompletion::output_failure;
                                                }
                                                return builtin::ConsoleCompletion::requested_exit;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if (okay) {
                            okay = console_text(session, "aurora> ");
                        }
                    }
                }
            }
            if (!okay) {
                return builtin::ConsoleCompletion::output_failure;
            }
        }
    }
    return builtin::ConsoleCompletion::output_failure;
}

// Same bounded language-value self-test as the ordinary BIOS entry. The bootstrap
// compiler emits shared reflection helpers, so this profile is one Aurora object.
auto aurora_kernel_value() -> i64 {
    static_assert(size_of(i64) == 8);
    own<i64> seed = own(40);
    {
        mutref<i64> edit = borrow_mut(seed);
        write(edit, read(edit) + 2);
    }
    own<i64> answer = move(seed);
    return read(answer);
}

// Private bootstrap transport of copied facts; enum ordinals are not the wire.
auto aurora_kernel_terminal_event(u64 vector, u64 matched_sites, u64 stack_top) -> u64 {
    const kernel::TerminalEvent event = kernel::terminal_event(vector, matched_sites, stack_top);
    if (event == kernel::TerminalEvent::returned) {
        return 1u64;
    }
    if (event == kernel::TerminalEvent::bounds) {
        return 2u64;
    }
    if (event == kernel::TerminalEvent::overflow) {
        return 3u64;
    }
    if (event == kernel::TerminalEvent::division_zero) {
        return 4u64;
    }
    if (event == kernel::TerminalEvent::shift_count) {
        return 5u64;
    }
    return 0u64;
}
