module examples.class_values;

class Sample {
public:
    i64 value;
    bool ready;
};

auto sample_size(i64 type) -> i64 {
    return reflect_size(type);
}

auto class_demo() -> i64 {
    static_assert(size_of(Sample) == 16);
    static_assert(field_count(Sample) == 2);

    Sample current = Sample{.value = 40, .ready = false};
    const Sample snapshot = current;
    current.value = current.value + 2;
    current.ready = true;

    if (current.ready) {
        // Copying the class copied its scalar fields into independent storage.
        return current.value + snapshot.value - 40;
    }
    return sample_size(type_id(Sample));
}
