module examples.loops_arrays;

auto array_sum() -> i64 {
    const array<i64, 4> values = {10, 20, 5, 7};
    i64 index = 0;
    i64 total = 0;
    while (index < len(values)) {
        total = total + values[index];
        index = index + 1;
    }
    return total;
}

auto independent_snapshot() -> i64 {
    array<i64, 2> current = {20, 22};
    const array<i64, 2> snapshot = current;
    current[0] = 100;
    static_assert(size_of(array<i64, 2>) == 16);
    return snapshot[0] + snapshot[1];
}
