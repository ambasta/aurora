module kernel_console_service;

// The editor, command policy and presentation live for one Aurora invocation.
// Only the leading sealed borrow can perform console transport operations.
enum class ConsoleEvent {
    ignored,
    echo,
    erased,
    empty,
    unknown,
    help,
    status,
    exit,
    rejected
};

class Line64 {
    array<u8, 64> bytes;
    i64 length;
    bool rejected;
    bool after_cr;

    auto finish() -> ConsoleEvent {
        ConsoleEvent event = ConsoleEvent::unknown;
        if (rejected) {
            event = ConsoleEvent::rejected;
        } else {
            if (length == 0) {
                event = ConsoleEvent::empty;
            } else {
                if (length == 4) {
                    if (bytes[0] == 'h' && bytes[1] == 'e' && bytes[2] == 'l' && bytes[3] == 'p') {
                        event = ConsoleEvent::help;
                    } else {
                        if (bytes[0] == 'e' && bytes[1] == 'x' && bytes[2] == 'i' && bytes[3] == 't') {
                            event = ConsoleEvent::exit;
                        }
                    }
                } else {
                    if (length == 6) {
                        if (bytes[0] == 's' && bytes[1] == 't' && bytes[2] == 'a' && bytes[3] == 't' && bytes[4] == 'u'
                            && bytes[5] == 's') {
                            event = ConsoleEvent::status;
                        }
                    }
                }
            }
        }
        i64 index = 0;
        while (index < 64) {
            bytes[index] = '\0';
            index = index + 1;
        }
        length = 0;
        rejected = false;
        return event;
    }
public:
    Line64() : bytes{}, length(0), rejected(false), after_cr(false) {
    }

    auto reject() -> bool {
        rejected = true;
        return true;
    }
    auto consume(u8 byte) -> ConsoleEvent {
        const bool suppressed_lf = after_cr && byte == '\n';
        after_cr = byte == '\r';
        if (suppressed_lf) {
            return ConsoleEvent::ignored;
        }
        if (byte == '\n' || byte == '\r') {
            return finish();
        }
        if (rejected) {
            return ConsoleEvent::ignored;
        }
        if (byte == '\b' || byte == '\x7f') {
            if (length == 0) {
                return ConsoleEvent::ignored;
            }
            length = length - 1;
            bytes[length] = '\0';
            return ConsoleEvent::erased;
        }
        if (byte < ' ' || byte > '~' || length == 64) {
            rejected = true;
            return ConsoleEvent::ignored;
        }
        bytes[length] = byte;
        length = length + 1;
        return ConsoleEvent::echo;
    }
};

auto emit_text(builtin::ConsoleSession& session, builtin::span<const u8> text) -> bool {
    i64 index = 0;
    while (index < text.size()) {
        if (session.put(text.at(index)) == builtin::ConsolePutResult::timeout) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

auto show_ready(builtin::ConsoleSession& session) -> bool {
    array<u8, 58> text = "AURORA_CONSOLE_READY: UEFI, ASCII, 64-byte lines\r\naurora> ";
    return emit_text(session, borrow_bytes(text));
}

auto show_prompt(builtin::ConsoleSession& session) -> bool {
    array<u8, 8> text = "aurora> ";
    return emit_text(session, borrow_bytes(text));
}

auto show_newline(builtin::ConsoleSession& session) -> bool {
    array<u8, 2> text = "\r\n";
    return emit_text(session, borrow_bytes(text));
}

auto show_erased(builtin::ConsoleSession& session) -> bool {
    array<u8, 3> text = "\b \b";
    return emit_text(session, borrow_bytes(text));
}

auto show_help(builtin::ConsoleSession& session) -> bool {
    array<u8, 81> text = "help    Show commands\r\nstatus  Show boot state\r\nexit    Close this QEMU session\r\n";
    return emit_text(session, borrow_bytes(text));
}

auto show_status(builtin::ConsoleSession& session) -> bool {
    array<u8, 92> text = "status: boot self-tests passed; UEFI serial console; timer-woken polling; line capacity=64\r\n";
    return emit_text(session, borrow_bytes(text));
}

auto show_unknown(builtin::ConsoleSession& session) -> bool {
    array<u8, 29> text = "Unknown command. Type help.\r\n";
    return emit_text(session, borrow_bytes(text));
}

auto show_rejected(builtin::ConsoleSession& session) -> bool {
    array<u8, 65> text = "Line rejected: too long, non-ASCII/control byte, or UART error.\r\n";
    return emit_text(session, borrow_bytes(text));
}

auto show_exit(builtin::ConsoleSession& session) -> bool {
    array<u8, 21> text = "AURORA_CONSOLE_EXIT\r\n";
    return emit_text(session, borrow_bytes(text));
}

auto console_service(builtin::ConsoleSession& session) -> builtin::ConsoleCompletion {
    Line64 line = Line64();
    if (!show_ready(session)) {
        return builtin::ConsoleCompletion::output_failure;
    }
    while (true) {
        const builtin::ConsoleSample sample = session.next();
        if (sample.damaged) {
            line.reject();
        }
        if (sample.byte_present) {
            const ConsoleEvent event = line.consume(sample.byte);
            bool okay = true;
            if (event == ConsoleEvent::echo) {
                okay = session.put(sample.byte) == builtin::ConsolePutResult::success;
            } else {
                if (event == ConsoleEvent::erased) {
                    okay = show_erased(session);
                } else {
                    if (event != ConsoleEvent::ignored) {
                        okay = show_newline(session);
                        if (okay) {
                            if (event == ConsoleEvent::help) {
                                okay = show_help(session);
                            } else {
                                if (event == ConsoleEvent::status) {
                                    okay = show_status(session);
                                } else {
                                    if (event == ConsoleEvent::unknown) {
                                        okay = show_unknown(session);
                                    } else {
                                        if (event == ConsoleEvent::rejected) {
                                            okay = show_rejected(session);
                                        } else {
                                            if (event == ConsoleEvent::exit) {
                                                if (!show_exit(session)) {
                                                    return builtin::ConsoleCompletion::output_failure;
                                                }
                                                return builtin::ConsoleCompletion::requested_exit;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if (okay) {
                            okay = show_prompt(session);
                        }
                    }
                }
            }
            if (!okay) {
                return builtin::ConsoleCompletion::output_failure;
            }
        }
    }
    return builtin::ConsoleCompletion::output_failure;
}

// Existing copied bootstrap self-test, independently callable by the host.
auto aurora_kernel_value() -> i64 {
    own<i64> seed = own(40);
    {
        mutref<i64> edit = borrow_mut(seed);
        write(edit, read(edit) + 2);
    }
    own<i64> answer = move(seed);
    return read(answer);
}
