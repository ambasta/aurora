auto console_service(builtin::ConsoleSession& session) -> builtin::ConsoleCompletion {
    Line64 line = Line64();
    if (!show_ready(session)) {
        return builtin::ConsoleCompletion::output_failure;
    }
    while (true) {
        const builtin::ConsoleSample sample = session.next();
        if (sample.damaged) {
            line.reject();
        }
        if (sample.byte_present) {
            const ConsoleEvent event = line.consume(sample.byte);
            bool okay = true;
            if (event == ConsoleEvent::echo) {
                okay = session.put(sample.byte) == builtin::ConsolePutResult::success;
            } else {
                if (event == ConsoleEvent::erased) {
                    okay = show_erased(session);
                } else {
                    if (event != ConsoleEvent::ignored) {
                        okay = show_newline(session);
                        if (okay) {
                            if (event == ConsoleEvent::help) {
                                okay = show_help(session);
                            } else {
                                if (event == ConsoleEvent::status) {
                                    okay = show_status(session);
                                } else {
                                    if (event == ConsoleEvent::unknown) {
                                        okay = show_unknown(session);
                                    } else {
                                        if (event == ConsoleEvent::rejected) {
                                            okay = show_rejected(session);
                                        } else {
                                            if (event == ConsoleEvent::exit) {
                                                if (!show_exit(session)) {
                                                    return builtin::ConsoleCompletion::output_failure;
                                                }
                                                return builtin::ConsoleCompletion::requested_exit;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if (okay) {
                            okay = show_prompt(session);
                        }
                    }
                }
            }
            if (!okay) {
                return builtin::ConsoleCompletion::output_failure;
            }
        }
    }
    return builtin::ConsoleCompletion::output_failure;
}

// Existing copied bootstrap self-test, independently callable by the host.
auto aurora_kernel_value() -> i64 {
    own<i64> seed = own(40);
    {
        mutref<i64> edit = borrow_mut(seed);
        write(edit, read(edit) + 2);
    }
    own<i64> answer = move(seed);
    return read(answer);
}
