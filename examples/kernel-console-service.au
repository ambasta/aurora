module kernel_console_service;
import std.binary_buffer;
import std.binary;

// The editor, command policy and presentation live for one Aurora invocation.
// Only the leading sealed borrow can perform console transport operations.
enum class ConsoleEvent {
    ignored,
    echo,
    erased,
    empty,
    unknown,
    help,
    status,
    exit,
    rejected
};

class Line64 {
    array<u8, 64> bytes;
    i64 length;
    bool rejected;
    bool after_cr;
    bool submitted;

    auto finish() -> ConsoleEvent {
        ConsoleEvent event = ConsoleEvent::unknown;
        if (rejected) {
            event = ConsoleEvent::rejected;
        } else {
            if (length == 0) {
                event = ConsoleEvent::empty;
            } else {
                if (length == 4) {
                    if (bytes[0] == 'h' && bytes[1] == 'e' && bytes[2] == 'l' && bytes[3] == 'p') {
                        event = ConsoleEvent::help;
                    } else {
                        if (bytes[0] == 'e' && bytes[1] == 'x' && bytes[2] == 'i' && bytes[3] == 't') {
                            event = ConsoleEvent::exit;
                        }
                    }
                } else {
                    if (length == 6) {
                        if (bytes[0] == 's' && bytes[1] == 't' && bytes[2] == 'a' && bytes[3] == 't' && bytes[4] == 'u'
                            && bytes[5] == 's') {
                            event = ConsoleEvent::status;
                        }
                    }
                }
            }
        }
        submitted = true;
        return event;
    }

    auto clear_submission() -> bool {
        if (submitted) {
            i64 index = 0;
            while (index < 64) {
                bytes[index] = '\0';
                index = index + 1;
            }
            length = 0;
            rejected = false;
            submitted = false;
        }
        return true;
    }
public:
    Line64() : bytes{}, length(0), rejected(false), after_cr(false), submitted(false) {
    }

    // A completed line is readable only until the next byte or damage sample.
    // Copies own their bytes; no view of the editor's fields can escape.
    auto submission_size() const -> i64 {
        if (!submitted || rejected) {
            return -1;
        }
        return length;
    }
    auto submission_byte(i64 index) const -> u8 {
        if (!submitted || rejected || index < 0 || index >= length) {
            return '\0';
        }
        return bytes[index];
    }
    auto reject() -> bool {
        clear_submission();
        rejected = true;
        return true;
    }
    auto consume(u8 byte) -> ConsoleEvent {
        clear_submission();
        const bool suppressed_lf = after_cr && byte == '\n';
        after_cr = byte == '\r';
        if (suppressed_lf) {
            return ConsoleEvent::ignored;
        }
        if (byte == '\n' || byte == '\r') {
            return finish();
        }
        if (rejected) {
            return ConsoleEvent::ignored;
        }
        if (byte == '\b' || byte == '\x7f') {
            if (length == 0) {
                return ConsoleEvent::ignored;
            }
            length = length - 1;
            bytes[length] = '\0';
            return ConsoleEvent::erased;
        }
        if (byte < ' ' || byte > '~' || length == 64) {
            rejected = true;
            return ConsoleEvent::ignored;
        }
        bytes[length] = byte;
        length = length + 1;
        return ConsoleEvent::echo;
    }
};

// One file, owned by this invocation only. No device, disk or allocator access.
enum class NoteEvent { unknown, written, read, missing };

class SessionNote {
    std::BinaryBuffer64 bytes;
    i64 length;
public:
    SessionNote(std::BinaryBuffer64 empty) : bytes(empty), length(-1) {
    }

    auto size() const -> i64 {
        return length;
    }
    auto at(i64 index) const -> u8 {
        return bytes.at(index);
    }
    auto submit(std::BinaryBuffer64 command, i64 count) -> NoteEvent {
        if (count == 8) {
            if (command.at(0) == 'c' && command.at(1) == 'a' && command.at(2) == 't'
                && command.at(3) == ' ' && command.at(4) == 'n' && command.at(5) == 'o'
                && command.at(6) == 't' && command.at(7) == 'e') {
                if (length < 0) {
                    return NoteEvent::missing;
                }
                return NoteEvent::read;
            }
        }
        if (count < 11 || count > 64) {
            return NoteEvent::unknown;
        }
        if (command.at(0) != 'w' || command.at(1) != 'r' || command.at(2) != 'i'
            || command.at(3) != 't' || command.at(4) != 'e' || command.at(5) != ' '
            || command.at(6) != 'n' || command.at(7) != 'o' || command.at(8) != 't'
            || command.at(9) != 'e' || command.at(10) != ' ') {
            return NoteEvent::unknown;
        }
        // Rejected input never reaches here. Replace all bytes, including the
        // unused suffix, only after the complete command has been accepted.
        const i64 content_size = count - 11;
        i64 index = 0;
        while (index < 64) {
            u8 byte = '\0';
            if (index < content_size) {
                byte = command.at(index + 11);
            }
            bytes.write_u8(index, byte);
            index = index + 1;
        }
        length = content_size;
        return NoteEvent::written;
    }
};

auto emit_text(builtin::ConsoleSession& session, builtin::span<const u8> text) -> bool {
    i64 index = 0;
    while (index < text.size()) {
        if (session.put(text.at(index)) == builtin::ConsolePutResult::timeout) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

auto show_ready(builtin::ConsoleSession& session) -> bool {
    array<u8, 58> text = "AURORA_CONSOLE_READY: UEFI, ASCII, 64-byte lines\r\naurora> ";
    return emit_text(session, borrow_bytes(text));
}

auto show_prompt(builtin::ConsoleSession& session) -> bool {
    array<u8, 8> text = "aurora> ";
    return emit_text(session, borrow_bytes(text));
}

auto show_newline(builtin::ConsoleSession& session) -> bool {
    array<u8, 2> text = "\r\n";
    return emit_text(session, borrow_bytes(text));
}

auto show_erased(builtin::ConsoleSession& session) -> bool {
    array<u8, 3> text = "\b \b";
    return emit_text(session, borrow_bytes(text));
}

auto show_help(builtin::ConsoleSession& session) -> bool {
    array<u8, 190> text = "help    Show commands\r\nstatus  Show boot state\r\nwrite note <text>  Replace RAM-only note (max 53 bytes)\r\ncat note          Read RAM-only note\r\nexit    Close this QEMU session; note is lost\r\n";
    return emit_text(session, borrow_bytes(text));
}

auto show_status(builtin::ConsoleSession& session) -> bool {
    array<u8, 92> text = "status: boot self-tests passed; UEFI serial console; timer-woken polling; line capacity=64\r\n";
    return emit_text(session, borrow_bytes(text));
}

auto show_unknown(builtin::ConsoleSession& session) -> bool {
    array<u8, 29> text = "Unknown command. Type help.\r\n";
    return emit_text(session, borrow_bytes(text));
}

auto show_rejected(builtin::ConsoleSession& session) -> bool {
    array<u8, 65> text = "Line rejected: too long, non-ASCII/control byte, or UART error.\r\n";
    return emit_text(session, borrow_bytes(text));
}

auto show_note_written(builtin::ConsoleSession& session) -> bool {
    array<u8, 42> text = "note: RAM-only; lost when session exits.\r\n";
    return emit_text(session, borrow_bytes(text));
}

auto show_note_missing(builtin::ConsoleSession& session) -> bool {
    array<u8, 29> text = "note: not found (RAM-only).\r\n";
    return emit_text(session, borrow_bytes(text));
}

auto show_exit(builtin::ConsoleSession& session) -> bool {
    array<u8, 21> text = "AURORA_CONSOLE_EXIT\r\n";
    return emit_text(session, borrow_bytes(text));
}

auto console_service(builtin::ConsoleSession& session) -> builtin::ConsoleCompletion {
    Line64 line = Line64();
    const std::BinaryBuffer64 empty = std::BinaryBuffer64();
    SessionNote note = SessionNote(empty);
    if (!show_ready(session)) {
        return builtin::ConsoleCompletion::output_failure;
    }
    while (true) {
        const builtin::ConsoleSample sample = session.next();
        if (sample.damaged) {
            line.reject();
        }
        if (sample.byte_present) {
            const ConsoleEvent event = line.consume(sample.byte);
            bool okay = true;
            if (event == ConsoleEvent::echo) {
                okay = session.put(sample.byte) == builtin::ConsolePutResult::success;
            } else {
                if (event == ConsoleEvent::erased) {
                    okay = show_erased(session);
                } else {
                    if (event != ConsoleEvent::ignored) {
                        okay = show_newline(session);
                        if (okay) {
                            if (event == ConsoleEvent::help) {
                                okay = show_help(session);
                            } else {
                                if (event == ConsoleEvent::status) {
                                    okay = show_status(session);
                                } else {
                                    if (event == ConsoleEvent::unknown) {
                                        std::BinaryBuffer64 command = std::BinaryBuffer64();
                                        const i64 count = line.submission_size();
                                        i64 copied = 0;
                                        while (copied < count) {
                                            command.write_u8(copied, line.submission_byte(copied));
                                            copied = copied + 1;
                                        }
                                        const NoteEvent action = note.submit(command, count);
                                        if (action == NoteEvent::written) {
                                            okay = show_note_written(session);
                                        } else {
                                            if (action == NoteEvent::missing) {
                                                okay = show_note_missing(session);
                                            } else {
                                                if (action == NoteEvent::read) {
                                                    i64 index = 0;
                                                    while (okay && index < note.size()) {
                                                        const u8 byte = note.at(index);
                                                        okay = session.put(byte) == builtin::ConsolePutResult::success;
                                                        index = index + 1;
                                                    }
                                                    if (okay) {
                                                        okay = show_newline(session);
                                                    }
                                                } else {
                                                    okay = show_unknown(session);
                                                }
                                            }
                                        }
                                    } else {
                                        if (event == ConsoleEvent::rejected) {
                                            okay = show_rejected(session);
                                        } else {
                                            if (event == ConsoleEvent::exit) {
                                                if (!show_exit(session)) {
                                                    return builtin::ConsoleCompletion::output_failure;
                                                }
                                                return builtin::ConsoleCompletion::requested_exit;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if (okay) {
                            okay = show_prompt(session);
                        }
                    }
                }
            }
            if (!okay) {
                return builtin::ConsoleCompletion::output_failure;
            }
        }
    }
    return builtin::ConsoleCompletion::output_failure;
}

// Existing copied bootstrap self-test, independently callable by the host.
auto aurora_kernel_value() -> i64 {
    own<i64> seed = own(40);
    {
        mutref<i64> edit = borrow_mut(seed);
        write(edit, read(edit) + 2);
    }
    own<i64> answer = move(seed);
    return read(answer);
}
