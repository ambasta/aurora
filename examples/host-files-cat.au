module host_files_cat;
import aurora.host;

// host-files-cat DIRECTORY OUTPUT FILE...
//
// Concatenates each FILE, read beneath DIRECTORY, into OUTPUT, which is
// replaced atomically only when every file was read. Each file's byte count is
// reported on stdout and each failure on stderr. Exits success (0), failure (1)
// or usage (2).

// A [begin, begin + count) range of the arguments block.
class Word {
    i64 first;
    i64 length;
public:
    Word(i64 begin, i64 count) : first(begin), length(count) {
    }
    auto begin() const -> i64 {
        return first;
    }
    auto count() const -> i64 {
        return length;
    }
};

// The NUL-terminated argument at ordinal `index`, or an empty range at -1.
auto argument(builtin::span<const u8> arguments, i64 index) -> Word {
    i64 at = 0;
    i64 begin = 0;
    i64 ordinal = 0;
    while (at < arguments.size()) {
        if (arguments.at(at) == 0u8) {
            if (ordinal == index) {
                const Word result = Word(begin, at - begin);
                return result;
            }
            ordinal = ordinal + 1;
            begin = at + 1;
        }
        at = at + 1;
    }
    const Word missing = Word(-1, 0);
    return missing;
}

auto decimal(builtin::HostFiles& files, builtin::HostStream stream, u64 value) -> builtin::HostStatus {
    array<u8, 20> digits = "00000000000000000000";
    i64 at = 20;
    u64 rest = value;
    while (at == 20 || rest > 0u64) {
        at = at - 1;
        digits[at] = u8(48u64 + rest % 10u64);
        rest = rest / 10u64;
    }
    const builtin::span<const u8> all = borrow_bytes(digits);
    const builtin::span<const u8> text = all.subspan(at, 20 - at);
    return files.print(stream, text);
}

// Appends one file to the output and reports its size; false on failure.
auto append(builtin::HostFiles& files, u64 directory, u64 output, builtin::span<const u8> name) -> bool {
    const builtin::HostFileResult file = files.open_beneath(directory, name);
    if (file.status != builtin::HostStatus::success) {
        files.print(builtin::HostStream::stderr, "cannot open ");
        files.print(builtin::HostStream::stderr, name);
        files.print(builtin::HostStream::stderr, "\n");
        return false;
    }
    u64 offset = 0u64;
    bool reading = true;
    while (reading) {
        const builtin::HostChunk chunk = files.read(file.id, offset);
        if (chunk.status != builtin::HostStatus::success) {
            files.print(builtin::HostStream::stderr, "cannot read ");
            files.print(builtin::HostStream::stderr, name);
            files.print(builtin::HostStream::stderr, "\n");
            return false;
        }
        if (chunk.count == 0u64) {
            reading = false;
        } else {
            const array<u8, 504> bytes = chunk.bytes;
            const builtin::span<const u8> all = borrow_bytes(bytes);
            const builtin::span<const u8> part = all.subspan(0, i64(chunk.count));
            if (files.write(output, part) != builtin::HostStatus::success) {
                files.print(builtin::HostStream::stderr, "cannot write output\n");
                return false;
            }
            offset = offset + chunk.count;
        }
    }
    files.print(builtin::HostStream::stdout, name);
    files.print(builtin::HostStream::stdout, " ");
    decimal(files, builtin::HostStream::stdout, offset);
    files.print(builtin::HostStream::stdout, "\n");
    return true;
}

auto main(builtin::HostFiles& files, builtin::span<const u8> arguments) -> builtin::HostExit {
    const Word directory_word = argument(arguments, 1);
    const Word output_word = argument(arguments, 2);
    const Word first_word = argument(arguments, 3);
    if (first_word.begin() < 0) {
        files.print(builtin::HostStream::stderr, "usage: host-files-cat DIRECTORY OUTPUT FILE...\n");
        return builtin::HostExit::usage;
    }
    const builtin::span<const u8> directory_path = arguments.subspan(directory_word.begin(), directory_word.count());
    const builtin::HostDirectoryResult directory = files.open_directory(directory_path);
    if (directory.status != builtin::HostStatus::success) {
        files.print(builtin::HostStream::stderr, "cannot open directory\n");
        return builtin::HostExit::failure;
    }
    const builtin::span<const u8> output_path = arguments.subspan(output_word.begin(), output_word.count());
    const builtin::HostOutputResult output = files.create_output(output_path);
    if (output.status != builtin::HostStatus::success) {
        files.print(builtin::HostStream::stderr, "cannot create output\n");
        return builtin::HostExit::failure;
    }
    i64 index = 3;
    bool complete = true;
    i64 begin = first_word.begin();
    i64 count = first_word.count();
    while (complete && begin >= 0) {
        const builtin::span<const u8> name = arguments.subspan(begin, count);
        complete = append(files, directory.id, output.id, name);
        index = index + 1;
        const Word next = argument(arguments, index);
        begin = next.begin();
        count = next.count();
    }
    if (!complete) {
        files.discard(output.id);
        return builtin::HostExit::failure;
    }
    if (files.commit(output.id) != builtin::HostStatus::success) {
        files.print(builtin::HostStream::stderr, "cannot commit output\n");
        return builtin::HostExit::failure;
    }
    return builtin::HostExit::success;
}
