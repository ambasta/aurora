module kernel_ap_helper;
import std.checksum;

// Invocation-only readonly view of the immutable boot-owned page. The closed
// imported checksum graph has no callbacks, allocators or retained state.
// Every range is rejected before subtraction or checksum access.
auto ap_worker_crc32c(builtin::span<const u8> bytes, i64 offset, i64 count) -> std::ChecksumResult {
    if (bytes.size() != 4096 || offset < 0 || offset > 4096 || count < 0 || count > 1024 || count > 4096 - offset) {
        const std::ChecksumResult failure = std::ChecksumResult(std::ChecksumStatus::out_of_range, 0u64);
        return failure;
    }
    const std::ChecksumResult result = std::crc32c(bytes, offset, count);
    return result;
}
