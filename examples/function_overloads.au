module function_overloads;

class Count {
    i64 value;
public:
    Count(i64 initial) : value(initial) {
    }
    auto get() const -> i64 {
        return value;
    }
};

namespace api {
    auto measure(i64 value) -> i64 {
        return value;
    }
    auto measure(u8 value) -> i64 {
        return i64(value);
    }
    auto measure(Count value) -> i64 {
        return value.get();
    }
}

auto answer() -> i64 {
    const Count value = Count(40);
    return api::measure(value) + api::measure(2u8);
}
