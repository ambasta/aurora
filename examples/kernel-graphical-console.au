module kernel_graphical_console;
import graphics.text_cells;
import std.binary_buffer;
import std.binary;
import console.line;
import console.session_note;
import console.file_namespace;
import console.session_files;

// Desired and committed cells are ordinary private byte storage, never authority.
// Two fixed rows: editable prompt and latest response. There is no scrolling.
class TextCells {
    array<u8, 136> desired;
    array<u8, 136> committed;
    i64 cursor;
    i64 previous_cursor;
    bool painted;
public:
    TextCells() : desired{}, committed{}, cursor(2), previous_cursor(-1), painted(false) {
    }
    auto initialize() -> bool {
        i64 index = 0;
        while (index < 136) {
            desired[index] = ' ';
            index = index + 1;
        }
        desired[0] = '>';
        return true;
    }
    auto append(u8 byte) -> bool {
        if (cursor < 2 || cursor >= 66 || byte < ' ' || byte > '~') {
            return false;
        }
        desired[cursor] = byte;
        cursor = cursor + 1;
        return true;
    }
    auto erase() -> bool {
        if (cursor <= 2 || cursor > 66) {
            return false;
        }
        cursor = cursor - 1;
        desired[cursor] = ' ';
        return true;
    }
    auto response(builtin::span<const u8> text) -> bool {
        if (text.size() > 68) {
            return false;
        }
        i64 index = 2;
        while (index < 136) {
            desired[index] = ' ';
            index = index + 1;
        }
        index = 0;
        while (index < text.size()) {
            desired[68 + index] = text.at(index);
            index = index + 1;
        }
        cursor = 2;
        return true;
    }
    auto hide_cursor() -> bool {
        cursor = -1;
        return true;
    }
    auto at(i64 index) const -> u8 {
        return desired[index];
    }
    auto cursor_at(i64 index) const -> bool {
        return cursor == index;
    }
    auto dirty(i64 index) const -> bool {
        return !painted || desired[index] != committed[index] || (cursor != previous_cursor && (index == cursor || index
            == previous_cursor));
    }
    auto commit(i64 index) -> bool {
        committed[index] = desired[index];
        return true;
    }
    auto finish_paint() -> bool {
        previous_cursor = cursor;
        painted = true;
        return true;
    }
    auto show_ready() -> bool {
        array<u8, 43> text = "AURORA graphical console: help for commands";
        return response(borrow_bytes(text));
    }
    auto show_help() -> bool {
        array<u8, 57> text = "copy S D; write N TEXT; cat N; ls; rm N; help status exit";
        return response(borrow_bytes(text));
    }
    auto show_status() -> bool {
        array<u8, 61> text = {
            'B',
            'o',
            'o',
            't',
            ' ',
            's',
            'e',
            'l',
            'f',
            '-',
            't',
            'e',
            's',
            't',
            's',
            ' ',
            'p',
            'a',
            's',
            's',
            'e',
            'd',
            ';',
            ' ',
            'U',
            'E',
            'F',
            'I',
            ';',
            ' ',
            't',
            'i',
            'm',
            'e',
            'r',
            ' ',
            'p',
            'o',
            'l',
            'l',
            'i',
            'n',
            'g',
            ';',
            ' ',
            'l',
            'i',
            'n',
            'e',
            ' ',
            'c',
            'a',
            'p',
            'a',
            'c',
            'i',
            't',
            'y',
            '=',
            '6',
            '4'
        };
        return response(borrow_bytes(text));
    }
    auto show_unknown() -> bool {
        array<u8, 27> text = {
            'U',
            'n',
            'k',
            'n',
            'o',
            'w',
            'n',
            ' ',
            'c',
            'o',
            'm',
            'm',
            'a',
            'n',
            'd',
            '.',
            ' ',
            'T',
            'y',
            'p',
            'e',
            ' ',
            'h',
            'e',
            'l',
            'p',
            '.'
        };
        return response(borrow_bytes(text));
    }
    auto show_rejected() -> bool {
        array<u8, 63> text = {
            'L',
            'i',
            'n',
            'e',
            ' ',
            'r',
            'e',
            'j',
            'e',
            'c',
            't',
            'e',
            'd',
            ':',
            ' ',
            't',
            'o',
            'o',
            ' ',
            'l',
            'o',
            'n',
            'g',
            ',',
            ' ',
            'n',
            'o',
            'n',
            '-',
            'A',
            'S',
            'C',
            'I',
            'I',
            '/',
            'c',
            'o',
            'n',
            't',
            'r',
            'o',
            'l',
            ' ',
            'b',
            'y',
            't',
            'e',
            ',',
            ' ',
            'o',
            'r',
            ' ',
            'U',
            'A',
            'R',
            'T',
            ' ',
            'e',
            'r',
            'r',
            'o',
            'r',
            '.'
        };
        return response(borrow_bytes(text));
    }
    auto show_note(console::NoteEvent action, console::SessionNote note) -> bool {
        if (action == console::NoteEvent::written) {
            array<u8, 40> text = "note: RAM-only; lost when session exits.";
            return response(borrow_bytes(text));
        }
        if (action == console::NoteEvent::missing) {
            array<u8, 27> text = "note: not found (RAM-only).";
            return response(borrow_bytes(text));
        }
        if (action == console::NoteEvent::read) {
            array<u8, 53> text = "                                                     ";
            i64 index = 0;
            while (index < note.size()) {
                text[index] = note.at(index);
                index = index + 1;
            }
            return response(borrow_bytes(text));
        }
        return show_unknown();
    }
    auto show_files(console::FileReply reply) -> bool {
        if (reply.status() == console::FileEvent::unknown) {
            return show_unknown();
        }
        array<u8, 64> text = "                                                                ";
        i64 index = 0;
        while (index < reply.size()) {
            text[index] = reply.at(index);
            index = index + 1;
        }
        return response(borrow_bytes(text));
    }
    auto show_exit() -> bool {
        array<u8, 19> text = {
            'A',
            'U',
            'R',
            'O',
            'R',
            'A',
            '_',
            'C',
            'O',
            'N',
            'S',
            'O',
            'L',
            'E',
            '_',
            'E',
            'X',
            'I',
            'T'
        };
        return response(borrow_bytes(text));
    }
    auto show_empty() -> bool {
        array<u8, 1> blank = {
            ' '
        };
        return response(borrow_bytes(blank));
    }
    auto show_bounded() -> bool {
        array<u8, 22> text = {
            'I',
            'N',
            'P',
            'U',
            'T',
            ' ',
            'B',
            'U',
            'D',
            'G',
            'E',
            'T',
            ' ',
            'E',
            'X',
            'H',
            'A',
            'U',
            'S',
            'T',
            'E',
            'D'
        };
        return response(borrow_bytes(text));
    }
};

// 54 clear stores + at most 35 glyph stores + at most five cursor stores.
// Each pass has only one cursor, so 136*89+5 bounds a complete dirty pass.
auto draw_cell(builtin::DisplaySession& display, u64 width, u64 height, i64 index, u8 byte, bool cursor) -> bool {
    if (index < 0 || index >= 136) {
        return false;
    }
    const u64 x = 32u64 + u64(index % 68) * 6u64;
    const u64 y = 128u64 + u64(index / 68) * 9u64;
    u64 glyph = u64(byte);
    if (cursor) {
        glyph = glyph + 256u64;
    }
    return graphics::draw_text_cell(display, width, height, x, y, glyph);
}

enum class GraphicalCompletion {
    requested_exit,
    bounded_end,
    output_failure,
    invalid_geometry,
    state_failure
};

// Private entry record: Console +0/+8; Display +16/+24; width +32; height +40.
// The native caller MUST preflight both exact grants before this entry. This
// source function cannot authenticate opaque grants without causing operations.
auto graphical_console(builtin::ConsoleSession& input, builtin::DisplaySession& display, u64 width,
    u64 height) -> GraphicalCompletion {
    if (width < 440u64 || width > 1024u64 || height < 146u64 || height > 768u64) {
        return GraphicalCompletion::invalid_geometry;
    }
    console::Line64 line = console::Line64(false);
    const std::BinaryBuffer64 empty = std::BinaryBuffer64();
    console::SessionNote note = console::SessionNote(empty);
    console::SessionFiles files = console::SessionFiles(console::FileNamespace(empty));
    TextCells cells = TextCells();
    cells.initialize();
    if (!cells.show_ready()) {
        return GraphicalCompletion::state_failure;
    }
    u64 events = 0u64;
    u64 samples = 0u64;
    bool stopped = false;
    GraphicalCompletion completion = GraphicalCompletion::bounded_end;
    while (true) {
        i64 index = 0;
        while (index < 136) {
            if (cells.dirty(index)) {
                const u8 byte = cells.at(index);
                const bool cursor = cells.cursor_at(index);
                if (!draw_cell(display, width, height, index, byte, cursor)) {
                    return GraphicalCompletion::output_failure;
                }
                cells.commit(index);
            }
            index = index + 1;
        }
        cells.finish_paint();
        if (stopped) {
            return completion;
        }
        if (events == 80u64 || samples == 96u64) {
            if (!cells.show_bounded()) {
                return GraphicalCompletion::state_failure;
            }
            cells.hide_cursor();
            stopped = true;
        } else {
            const builtin::ConsoleSample sample = input.next();
            samples = samples + 1u64;
            if (sample.damaged) {
                line.reject();
            }
            if (sample.byte_present) {
                events = events + 1u64;
                const console::ConsoleEvent event = line.consume(sample.byte);
                bool okay = true;
                if (event == console::ConsoleEvent::echo) {
                    okay = cells.append(sample.byte);
                } else {
                    if (event == console::ConsoleEvent::erased) {
                        okay = cells.erase();
                    } else {
                        if (event == console::ConsoleEvent::empty) {
                            okay = cells.show_empty();
                        } else {
                            if (event == console::ConsoleEvent::help) {
                                okay = cells.show_help();
                            } else {
                                if (event == console::ConsoleEvent::status) {
                                    okay = cells.show_status();
                                } else {
                                    if (event == console::ConsoleEvent::unknown) {
                                        std::BinaryBuffer64 command = std::BinaryBuffer64();
                                        const i64 count = line.submission_size();
                                        i64 copied = 0;
                                        while (copied < count) {
                                            command.write_u8(copied, line.submission_byte(copied));
                                            copied = copied + 1;
                                        }
                                        const console::NoteEvent action = note.submit(command, count);
                                        if (action == console::NoteEvent::unknown) {
                                            const console::FileReply reply = files.submit(command, count);
                                            okay = cells.show_files(reply);
                                        } else {
                                            okay = cells.show_note(action, note);
                                        }
                                    } else {
                                        if (event == console::ConsoleEvent::rejected) {
                                            okay = cells.show_rejected();
                                        } else {
                                            if (event == console::ConsoleEvent::exit) {
                                                okay = cells.show_exit();
                                                cells.hide_cursor();
                                                stopped = true;
                                                completion = GraphicalCompletion::requested_exit;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                if (!okay) {
                    return GraphicalCompletion::state_failure;
                }
            }
        }
    }
    return GraphicalCompletion::state_failure;
}

auto aurora_kernel_value() -> i64 {
    return 42;
}
