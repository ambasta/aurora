module kernel_graphical_console;
import graphics.font5x7;
import std.binary_buffer;
import std.binary;
import console.session_note;
import console.session_files;

// The exact accepted Line64 policy is reused below; a source gate must keep it
// identical to kernel-console-service.au until shared-module extraction is reviewed.
enum class ConsoleEvent {
    ignored,
    echo,
    erased,
    empty,
    unknown,
    help,
    status,
    exit,
    rejected
};

class Line64 {
    array<u8, 64> bytes;
    i64 length;
    bool rejected;
    bool after_cr;
    bool submitted;

    auto finish() -> ConsoleEvent {
        ConsoleEvent event = ConsoleEvent::unknown;
        if (rejected) {
            event = ConsoleEvent::rejected;
        } else {
            if (length == 0) {
                event = ConsoleEvent::empty;
            } else {
                if (length == 4) {
                    if (bytes[0] == 'h' && bytes[1] == 'e' && bytes[2] == 'l' && bytes[3] == 'p') {
                        event = ConsoleEvent::help;
                    } else {
                        if (bytes[0] == 'e' && bytes[1] == 'x' && bytes[2] == 'i' && bytes[3] == 't') {
                            event = ConsoleEvent::exit;
                        }
                    }
                } else {
                    if (length == 6) {
                        if (bytes[0] == 's' && bytes[1] == 't' && bytes[2] == 'a' && bytes[3] == 't' && bytes[4] == 'u'
                            && bytes[5] == 's') {
                            event = ConsoleEvent::status;
                        }
                    }
                }
            }
        }
        submitted = true;
        return event;
    }

    auto clear_submission() -> bool {
        if (submitted) {
            i64 index = 0;
            while (index < 64) {
                bytes[index] = '\0';
                index = index + 1;
            }
            length = 0;
            rejected = false;
            submitted = false;
        }
        return true;
    }
public:
    Line64() : bytes{}, length(0), rejected(false), after_cr(false), submitted(false) {
    }

    // A completed line is readable only until the next byte or damage sample.
    // Copies own their bytes; no view of the editor's fields can escape.
    auto submission_size() const -> i64 {
        if (!submitted || rejected) {
            return -1;
        }
        return length;
    }
    auto submission_byte(i64 index) const -> u8 {
        if (!submitted || rejected || index < 0 || index >= length) {
            return '\0';
        }
        return bytes[index];
    }
    auto reject() -> bool {
        clear_submission();
        rejected = true;
        return true;
    }
    auto consume(u8 byte) -> ConsoleEvent {
        clear_submission();
        const bool suppressed_lf = after_cr && byte == '\n';
        after_cr = byte == '\r';
        if (suppressed_lf) {
            return ConsoleEvent::ignored;
        }
        if (byte == '\n' || byte == '\r') {
            return finish();
        }
        if (rejected) {
            return ConsoleEvent::ignored;
        }
        if (byte == '\b' || byte == '\x7f') {
            if (length == 0) {
                return ConsoleEvent::ignored;
            }
            length = length - 1;
            bytes[length] = '\0';
            return ConsoleEvent::erased;
        }
        if (byte < ' ' || byte > '~' || length == 64) {
            rejected = true;
            return ConsoleEvent::ignored;
        }
        bytes[length] = byte;
        length = length + 1;
        return ConsoleEvent::echo;
    }
};


auto graphical_glyph_bits(u8 byte) -> u64 {
    if (byte == 'a') { return 0b11110'10001'11110'10000'01110'00000'00000u64; }
    if (byte == 'b') { return 0b01111'10001'10001'10001'01111'00001'00001u64; }
    if (byte == 'c') { return 0b11110'00001'00001'00001'11110'00000'00000u64; }
    if (byte == 'd') { return 0b11110'10001'10001'10001'11110'10000'10000u64; }
    if (byte == 'e') { return 0b11110'00001'11111'10001'01110'00000'00000u64; }
    if (byte == 'f') { return 0b00010'00010'00010'00111'00010'00010'01100u64; }
    if (byte == 'g') { return 0b01110'10000'11110'10001'10001'11110'00000u64; }
    if (byte == 'h') { return 0b10001'10001'10001'10001'01111'00001'00001u64; }
    if (byte == 'i') { return 0b01110'00100'00100'00100'00110'00000'00100u64; }
    if (byte == 'j') { return 0b00110'01001'01000'01000'01100'00000'01000u64; }
    if (byte == 'k') { return 0b10001'01001'00111'01001'10001'00001'00001u64; }
    if (byte == 'l') { return 0b01110'00100'00100'00100'00100'00100'00110u64; }
    if (byte == 'm') { return 0b10001'10001'10101'10101'01011'00000'00000u64; }
    if (byte == 'n') { return 0b10001'10001'10001'10001'01111'00000'00000u64; }
    if (byte == 'o') { return 0b01110'10001'10001'10001'01110'00000'00000u64; }
    if (byte == 'p') { return 0b00001'00001'01111'10001'01111'00000'00000u64; }
    if (byte == 'q') { return 0b10000'10000'11110'10001'11110'00000'00000u64; }
    if (byte == 'r') { return 0b00001'00001'00001'10011'01101'00000'00000u64; }
    if (byte == 's') { return 0b01111'10000'01110'00001'11110'00000'00000u64; }
    if (byte == 't') { return 0b01100'10010'00010'00010'00111'00010'00010u64; }
    if (byte == 'u') { return 0b10110'11001'10001'10001'10001'00000'00000u64; }
    if (byte == 'v') { return 0b00100'01010'10001'10001'10001'00000'00000u64; }
    if (byte == 'w') { return 0b01010'10101'10101'10001'10001'00000'00000u64; }
    if (byte == 'x') { return 0b10001'01010'00100'01010'10001'00000'00000u64; }
    if (byte == 'y') { return 0b01110'10000'11110'10001'10001'00000'00000u64; }
    if (byte == 'z') { return 0b11111'00010'00100'01000'11111'00000'00000u64; }
    if (byte == '!') { return 0b00100'00000'00100'00100'00100'00100'00100u64; }
    if (byte == '"') { return 0b00000'00000'00000'00000'01010'01010'01010u64; }
    if (byte == '#') { return 0b00000'01010'11111'01010'01010'11111'01010u64; }
    if (byte == '$') { return 0b00100'01111'10100'01110'00101'11110'00100u64; }
    if (byte == '%') { return 0b11000'11001'00010'00100'01000'10011'00011u64; }
    if (byte == '&') { return 0b10110'01001'01001'10101'00110'01001'00110u64; }
    if (byte == '\'') { return 0b00000'00000'00000'00000'00010'00100'00100u64; }
    if (byte == '(') { return 0b01000'00100'00010'00010'00010'00100'01000u64; }
    if (byte == ')') { return 0b00010'00100'01000'01000'01000'00100'00010u64; }
    if (byte == '*') { return 0b00000'10101'01110'11111'01110'10101'00000u64; }
    if (byte == '+') { return 0b00000'00100'00100'11111'00100'00100'00000u64; }
    if (byte == ',') { return 0b00010'00100'00000'00000'00000'00000'00000u64; }
    if (byte == '.') { return 0b00100'00000'00000'00000'00000'00000'00000u64; }
    if (byte == '/') { return 0b00001'00001'00010'00100'01000'10000'10000u64; }
    if (byte == ';') { return 0b00010'00100'00100'00000'00000'00100'00000u64; }
    if (byte == '<') { return 0b10000'01000'00100'00010'00100'01000'10000u64; }
    if (byte == '=') { return 0b00000'00000'11111'00000'11111'00000'00000u64; }
    if (byte == '>') { return 0b00001'00010'00100'01000'00100'00010'00001u64; }
    if (byte == '?') { return 0b00100'00000'00100'01000'10000'10001'01110u64; }
    if (byte == '@') { return 0b11110'00001'11101'10101'11101'10001'01110u64; }
    if (byte == '[') { return 0b01110'00010'00010'00010'00010'00010'01110u64; }
    if (byte == '\\') { return 0b10000'10000'01000'00100'00010'00001'00001u64; }
    if (byte == ']') { return 0b01110'01000'01000'01000'01000'01000'01110u64; }
    if (byte == '^') { return 0b00000'00000'00000'00000'10001'01010'00100u64; }
    if (byte == '_') { return 0b11111'00000'00000'00000'00000'00000'00000u64; }
    if (byte == '`') { return 0b00000'00000'00000'00000'00000'00100'00010u64; }
    if (byte == '{') { return 0b01000'00100'00100'00010'00100'00100'01000u64; }
    if (byte == '|') { return 0b00100'00100'00100'00100'00100'00100'00100u64; }
    if (byte == '}') { return 0b00010'00100'00100'01000'00100'00100'00010u64; }
    if (byte == '~') { return 0b00000'00000'00000'01101'10010'00000'00000u64; }
    return graphics::glyph_bits(byte);
}

// Desired and committed cells are ordinary private byte storage, never authority.
// Two fixed rows: editable prompt and latest response. There is no scrolling.
class TextCells {
    array<u8, 136> desired;
    array<u8, 136> committed;
    i64 cursor;
    i64 previous_cursor;
    bool painted;
public:
    TextCells() : desired{}, committed{}, cursor(2), previous_cursor(-1), painted(false) {}
    auto initialize() -> bool {
        i64 index = 0;
        while (index < 136) {
            desired[index] = ' ';
            index = index + 1;
        }
        desired[0] = '>';
        return true;
    }
    auto append(u8 byte) -> bool {
        if (cursor < 2 || cursor >= 66 || byte < ' ' || byte > '~') { return false; }
        desired[cursor] = byte;
        cursor = cursor + 1;
        return true;
    }
    auto erase() -> bool {
        if (cursor <= 2 || cursor > 66) { return false; }
        cursor = cursor - 1;
        desired[cursor] = ' ';
        return true;
    }
    auto response(builtin::span<const u8> text) -> bool {
        if (text.size() > 68) { return false; }
        i64 index = 2;
        while (index < 136) {
            desired[index] = ' ';
            index = index + 1;
        }
        index = 0;
        while (index < text.size()) {
            desired[68 + index] = text.at(index);
            index = index + 1;
        }
        cursor = 2;
        return true;
    }
    auto hide_cursor() -> bool { cursor = -1; return true; }
    auto at(i64 index) const -> u8 { return desired[index]; }
    auto cursor_at(i64 index) const -> bool { return cursor == index; }
    auto dirty(i64 index) const -> bool {
        return !painted || desired[index] != committed[index] ||
            (cursor != previous_cursor && (index == cursor || index == previous_cursor));
    }
    auto commit(i64 index) -> bool { committed[index] = desired[index]; return true; }
    auto finish_paint() -> bool { previous_cursor = cursor; painted = true; return true; }
    auto show_ready() -> bool {
        array<u8, 43> text = "AURORA graphical console: help for commands";
        return response(borrow_bytes(text));
    }
    auto show_help() -> bool {
        array<u8, 67> text = "write N TEXT; cat N; ls; rm N; help status exit; RAM; note separate";
        return response(borrow_bytes(text));
    }
    auto show_status() -> bool {
        array<u8, 61> text = {'B', 'o', 'o', 't', ' ', 's', 'e', 'l', 'f', '-', 't', 'e', 's', 't', 's', ' ', 'p', 'a', 's', 's', 'e', 'd', ';', ' ', 'U', 'E', 'F', 'I', ';', ' ', 't', 'i', 'm', 'e', 'r', ' ', 'p', 'o', 'l', 'l', 'i', 'n', 'g', ';', ' ', 'l', 'i', 'n', 'e', ' ', 'c', 'a', 'p', 'a', 'c', 'i', 't', 'y', '=', '6', '4'};
        return response(borrow_bytes(text));
    }
    auto show_unknown() -> bool {
        array<u8, 27> text = {'U', 'n', 'k', 'n', 'o', 'w', 'n', ' ', 'c', 'o', 'm', 'm', 'a', 'n', 'd', '.', ' ', 'T', 'y', 'p', 'e', ' ', 'h', 'e', 'l', 'p', '.'};
        return response(borrow_bytes(text));
    }
    auto show_rejected() -> bool {
        array<u8, 63> text = {'L', 'i', 'n', 'e', ' ', 'r', 'e', 'j', 'e', 'c', 't', 'e', 'd', ':', ' ', 't', 'o', 'o', ' ', 'l', 'o', 'n', 'g', ',', ' ', 'n', 'o', 'n', '-', 'A', 'S', 'C', 'I', 'I', '/', 'c', 'o', 'n', 't', 'r', 'o', 'l', ' ', 'b', 'y', 't', 'e', ',', ' ', 'o', 'r', ' ', 'U', 'A', 'R', 'T', ' ', 'e', 'r', 'r', 'o', 'r', '.'};
        return response(borrow_bytes(text));
    }
    auto show_note(console::NoteEvent action, console::SessionNote note) -> bool {
        if (action == console::NoteEvent::written) {
            array<u8, 40> text = "note: RAM-only; lost when session exits.";
            return response(borrow_bytes(text));
        }
        if (action == console::NoteEvent::missing) {
            array<u8, 27> text = "note: not found (RAM-only).";
            return response(borrow_bytes(text));
        }
        if (action == console::NoteEvent::read) {
            array<u8, 53> text = "                                                     ";
            i64 index = 0;
            while (index < note.size()) {
                text[index] = note.at(index);
                index = index + 1;
            }
            return response(borrow_bytes(text));
        }
        return show_unknown();
    }
    auto show_files(console::FileReply reply) -> bool {
        if (reply.status() == console::FileEvent::unknown) { return show_unknown(); }
        array<u8, 64> text = "                                                                ";
        i64 index = 0;
        while (index < reply.size()) {
            text[index] = reply.at(index);
            index = index + 1;
        }
        return response(borrow_bytes(text));
    }
    auto show_exit() -> bool {
        array<u8, 19> text = {'A', 'U', 'R', 'O', 'R', 'A', '_', 'C', 'O', 'N', 'S', 'O', 'L', 'E', '_', 'E', 'X', 'I', 'T'};
        return response(borrow_bytes(text));
    }
    auto show_empty() -> bool {
        array<u8, 1> blank = {' '};
        return response(borrow_bytes(blank));
    }
    auto show_bounded() -> bool {
        array<u8, 22> text = {'I', 'N', 'P', 'U', 'T', ' ', 'B', 'U', 'D', 'G', 'E', 'T', ' ', 'E', 'X', 'H', 'A', 'U', 'S', 'T', 'E', 'D'};
        return response(borrow_bytes(text));
    }
};

// This view draws the shared 5x7 font at one pixel per glyph bit.
auto draw_glyph(builtin::DisplaySession& session, u64 width, u64 height, u64 x, u64 y, u8 byte) -> bool {
    if (x >= width || y >= height) {
        return true;
    }
    const u64 bits = graphical_glyph_bits(byte);
    u8 red = 204u8;
    u8 green = 226u8;
    u8 blue = 235u8;
    if (y < 96u64) {
        red = 222u8;
        green = 237u8;
        blue = 247u8;
    }
    if (y >= 520u64) {
        red = 52u8;
        green = 188u8;
        blue = 220u8;
    }
    u64 row = 0u64;
    while (row < 7u64) {
        u64 column = 0u64;
        while (column < 5u64) {
            if (((bits >> i64(row * 5u64 + column)) & 1u64) != 0u64) {
                const u64 target_x = x + column;
                const u64 target_y = y + row;
                if (target_x < width && target_y < height) {
                    if (session.pixel(target_x, target_y, red, green, blue)
                        != builtin::DisplayPutResult::success) {
                        return false;
                    }
                }
            }
            column = column + 1u64;
        }
        row = row + 1u64;
    }
    return true;
}

// 54 clear stores + at most 35 glyph stores + at most five cursor stores.
// Each pass has only one cursor, so 136*89+5 bounds a complete dirty pass.
auto draw_cell(builtin::DisplaySession& display, u64 width, u64 height,
               i64 index, u8 byte, bool cursor) -> bool {
    if (index < 0 || index >= 136) { return false; }
    const u64 x = 32u64 + u64(index % 68) * 6u64;
    const u64 y = 128u64 + u64(index / 68) * 9u64;
    u64 dy = 0u64;
    while (dy < 9u64) {
        u64 dx = 0u64;
        while (dx < 6u64) {
            const u64 target_x = x + dx;
            const u64 target_y = y + dy;
            if (target_x < width && target_y < height) {
                if (display.pixel(target_x, target_y, 13u8, 20u8, 32u8) != builtin::DisplayPutResult::success) {
                    return false;
                }
            }
            dx = dx + 1u64;
        }
        dy = dy + 1u64;
    }
    if (!draw_glyph(display, width, height, x, y, byte)) { return false; }
    if (cursor) {
        u64 dx = 0u64;
        while (dx < 5u64) {
            if (x + dx < width && y + 7u64 < height) {
                if (display.pixel(x + dx, y + 7u64, 52u8, 188u8, 220u8) != builtin::DisplayPutResult::success) {
                    return false;
                }
            }
            dx = dx + 1u64;
        }
    }
    return true;
}

enum class GraphicalCompletion { requested_exit, bounded_end, output_failure, invalid_geometry, state_failure };

// Private entry record: Console +0/+8; Display +16/+24; width +32; height +40.
// The native caller MUST preflight both exact grants before this entry. This
// source function cannot authenticate opaque grants without causing operations.
auto graphical_console(builtin::ConsoleSession& input, builtin::DisplaySession& display,
                       u64 width, u64 height) -> GraphicalCompletion {
    if (width < 440u64 || width > 1024u64 || height < 146u64 || height > 768u64) {
        return GraphicalCompletion::invalid_geometry;
    }
    Line64 line = Line64();
    const std::BinaryBuffer64 empty = std::BinaryBuffer64();
    console::SessionNote note = console::SessionNote(empty);
    console::SessionFiles files = console::SessionFiles(empty);
    TextCells cells = TextCells();
    cells.initialize();
    if (!cells.show_ready()) { return GraphicalCompletion::state_failure; }
    u64 events = 0u64;
    u64 samples = 0u64;
    bool stopped = false;
    GraphicalCompletion completion = GraphicalCompletion::bounded_end;
    while (true) {
        i64 index = 0;
        while (index < 136) {
            if (cells.dirty(index)) {
                const u8 byte = cells.at(index);
                const bool cursor = cells.cursor_at(index);
                if (!draw_cell(display, width, height, index, byte, cursor)) {
                    return GraphicalCompletion::output_failure;
                }
                cells.commit(index);
            }
            index = index + 1;
        }
        cells.finish_paint();
        if (stopped) { return completion; }
        if (events == 80u64 || samples == 96u64) {
            if (!cells.show_bounded()) { return GraphicalCompletion::state_failure; }
            cells.hide_cursor();
            stopped = true;
        } else {
            const builtin::ConsoleSample sample = input.next();
            samples = samples + 1u64;
            if (sample.damaged) { line.reject(); }
            if (sample.byte_present) {
                events = events + 1u64;
                const ConsoleEvent event = line.consume(sample.byte);
                bool okay = true;
                if (event == ConsoleEvent::echo) { okay = cells.append(sample.byte); }
                else {
                    if (event == ConsoleEvent::erased) { okay = cells.erase(); }
                    else {
                        if (event == ConsoleEvent::empty) { okay = cells.show_empty(); }
                        else {
                            if (event == ConsoleEvent::help) { okay = cells.show_help(); }
                            else {
                                if (event == ConsoleEvent::status) { okay = cells.show_status(); }
                                else {
                                    if (event == ConsoleEvent::unknown) {
                                        std::BinaryBuffer64 command = std::BinaryBuffer64();
                                        const i64 count = line.submission_size();
                                        i64 copied = 0;
                                        while (copied < count) {
                                            command.write_u8(copied, line.submission_byte(copied));
                                            copied = copied + 1;
                                        }
                                        const console::NoteEvent action = note.submit(command, count);
                                        if (action == console::NoteEvent::unknown) {
                                            const console::FileReply reply = files.submit(command, count);
                                            okay = cells.show_files(reply);
                                        } else {
                                            okay = cells.show_note(action, note);
                                        }
                                    }
                                    else {
                                        if (event == ConsoleEvent::rejected) { okay = cells.show_rejected(); }
                                        else {
                                            if (event == ConsoleEvent::exit) {
                                                okay = cells.show_exit();
                                                cells.hide_cursor();
                                                stopped = true;
                                                completion = GraphicalCompletion::requested_exit;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                if (!okay) { return GraphicalCompletion::state_failure; }
            }
        }
    }
    return GraphicalCompletion::state_failure;
}

auto aurora_kernel_value() -> i64 { return 42; }
